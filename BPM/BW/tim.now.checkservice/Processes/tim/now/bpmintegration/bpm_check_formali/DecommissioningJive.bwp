                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliFormali/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns5="http://www.tim.com/NOW/xsd/VerificaDecomissioning_Jive" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="TransactionId"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="InsertStag-input" match="/"&gt;&lt;tns3:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Start/tns:Lavorazione='ATTIVAZIONE' and ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or &amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA')) or ($Start/tns:Lavorazione = 'VARIAZIONE' and&amp;#xD;&amp;#xA;        ($Start/tns:TipologiaSottoLav = 'TRASLOCOWLR12' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR13' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR14' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR15' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR16') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVANP')&amp;#xD;&amp;#xA;    )"&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;xsl:if test="$Mapper/tns5:Richiesta"&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="$Mapper/tns5:Richiesta"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;/xsl:if&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="181"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$Start/tns:IDRichiestaOLO"&gt;&lt;tns4:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;&lt;/tns4:ID_RICH_OLO&gt;&lt;/xsl:if&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;tns4:ID_RICH_JIVE&gt;&lt;xsl:value-of select="$TransactionId"/&gt;&lt;/tns4:ID_RICH_JIVE&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:codiceToponomastica"&gt;&lt;tns4:CODICE_TOPONOMASTICO&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:codiceToponomastica"/&gt;&lt;/tns4:CODICE_TOPONOMASTICO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:particellaToponomastica"&gt;&lt;tns4:PARTICELLA_TOPONOMASTICA&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:particellaToponomastica"/&gt;&lt;/tns4:PARTICELLA_TOPONOMASTICA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:via"&gt;&lt;tns4:STRADA&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:via"/&gt;&lt;/tns4:STRADA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:localita"&gt;&lt;tns4:LOCALITA&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:localita"/&gt;&lt;/tns4:LOCALITA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:CAP"&gt;&lt;tns4:CAP&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:CAP"/&gt;&lt;/tns4:CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:provincia"&gt;&lt;tns4:PROVINCIA&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:provincia"/&gt;&lt;/tns4:PROVINCIA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:civico"&gt;&lt;tns4:CIVICO&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:civico"/&gt;&lt;/tns4:CIVICO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:SEDECLIENTE/tns:IstatComune"&gt;&lt;tns4:ISTAT_COMUNE&gt;&lt;xsl:value-of select="$Start/tns:SEDECLIENTE/tns:IstatComune"/&gt;&lt;/tns4:ISTAT_COMUNE&gt;&lt;/xsl:if&gt;&lt;/tns4:StagingIn&gt;&lt;xsl:if test="$Start/tns:IDRichiestaOLO"&gt;&lt;tns4:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;&lt;/tns4:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_VER_CENTRALE_DECO'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="181"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;xsl:if test="$Start/tns:Clli4Jive"&gt;&lt;tns4:CLLI&gt;&lt;xsl:value-of select="$Start/tns:Clli4Jive"/&gt;&lt;/tns4:CLLI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns5:Richiesta"&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="$Mapper/tns5:Richiesta"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;/xsl:if&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="181"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$Start/tns:IDRichiestaOLO"&gt;&lt;tns4:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;&lt;/tns4:ID_RICH_OLO&gt;&lt;/xsl:if&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;tns4:ID_RICH_JIVE&gt;&lt;xsl:value-of select="$TransactionId"/&gt;&lt;/tns4:ID_RICH_JIVE&gt;&lt;/tns4:StagingIn&gt;&lt;xsl:if test="$Start/tns:IDRichiestaOLO"&gt;&lt;tns4:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;&lt;/tns4:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_VER_CENTRALE_DECO'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="181"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/REQUEST&gt;&lt;/tns3:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/VerificaDecomissioning_Jive&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;($Start/tns:Lavorazione='ATTIVAZIONE' and ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or &amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA')) or ($Start/tns:Lavorazione = 'VARIAZIONE' and&amp;#xD;&amp;#xA;        ($Start/tns:TipologiaSottoLav = 'TRASLOCOWLR12' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR13' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR14' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR15' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR16') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVANP')&amp;#xD;&amp;#xA;    )&quot;>&#xa;                &lt;tns4:StagingRequest>&#xa;                    &lt;tns4:StagingIn>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns5:Richiesta&quot;>&#xa;                            &lt;tns4:CONTENUTO_REQUEST>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns5:Richiesta&quot;/>&#xa;                            &lt;/tns4:CONTENUTO_REQUEST>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;181&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                            &lt;tns4:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns4:ID_RICH_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                        &lt;tns4:ID_RICH_JIVE>&#xa;                            &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                        &lt;/tns4:ID_RICH_JIVE>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:codiceToponomastica&quot;>&#xa;                            &lt;tns4:CODICE_TOPONOMASTICO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:codiceToponomastica&quot;/>&#xa;                            &lt;/tns4:CODICE_TOPONOMASTICO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:particellaToponomastica&quot;>&#xa;                            &lt;tns4:PARTICELLA_TOPONOMASTICA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:particellaToponomastica&quot;/>&#xa;                            &lt;/tns4:PARTICELLA_TOPONOMASTICA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:via&quot;>&#xa;                            &lt;tns4:STRADA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:via&quot;/>&#xa;                            &lt;/tns4:STRADA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:localita&quot;>&#xa;                            &lt;tns4:LOCALITA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:localita&quot;/>&#xa;                            &lt;/tns4:LOCALITA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:CAP&quot;>&#xa;                            &lt;tns4:CAP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:CAP&quot;/>&#xa;                            &lt;/tns4:CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:provincia&quot;>&#xa;                            &lt;tns4:PROVINCIA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:provincia&quot;/>&#xa;                            &lt;/tns4:PROVINCIA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:civico&quot;>&#xa;                            &lt;tns4:CIVICO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:civico&quot;/>&#xa;                            &lt;/tns4:CIVICO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:SEDECLIENTE/tns:IstatComune&quot;>&#xa;                            &lt;tns4:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:SEDECLIENTE/tns:IstatComune&quot;/>&#xa;                            &lt;/tns4:ISTAT_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:StagingIn>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns4:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns4:IdRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns4:StagingType>&#xa;                        &lt;xsl:value-of select=&quot;'ANALITICO_VER_CENTRALE_DECO'&quot;/>&#xa;                    &lt;/tns4:StagingType>&#xa;                    &lt;tns4:LoggerIn>&#xa;                        &lt;ns:TipologiaProcesso>&#xa;                            &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                        &lt;/ns:TipologiaProcesso>&#xa;                        &lt;ns:TipologiaOperazione>&#xa;                            &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                        &lt;/ns:TipologiaOperazione>&#xa;                        &lt;ns:EsecuzioneNOFileProcessato>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;181&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                            &lt;/ns:STATO_ESEC>&#xa;                            &lt;ns:TMSP_INIZIO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                        &lt;ns:LogFileProcessato>&#xa;                            &lt;ns:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                            &lt;/ns:LOG_LEVEL>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                            &lt;ns:TIMSTP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TIMSTP_INSMTO>&#xa;                        &lt;/ns:LogFileProcessato>&#xa;                    &lt;/tns4:LoggerIn>&#xa;                &lt;/tns4:StagingRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:StagingRequest>&#xa;                    &lt;tns4:StagingIn>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Clli4Jive&quot;>&#xa;                            &lt;tns4:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Clli4Jive&quot;/>&#xa;                            &lt;/tns4:CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns5:Richiesta&quot;>&#xa;                            &lt;tns4:CONTENUTO_REQUEST>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns5:Richiesta&quot;/>&#xa;                            &lt;/tns4:CONTENUTO_REQUEST>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;181&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                            &lt;tns4:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns4:ID_RICH_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                        &lt;tns4:ID_RICH_JIVE>&#xa;                            &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                        &lt;/tns4:ID_RICH_JIVE>&#xa;                    &lt;/tns4:StagingIn>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns4:IdRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns4:IdRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns4:StagingType>&#xa;                        &lt;xsl:value-of select=&quot;'ANALITICO_VER_CENTRALE_DECO'&quot;/>&#xa;                    &lt;/tns4:StagingType>&#xa;                    &lt;tns4:LoggerIn>&#xa;                        &lt;ns:TipologiaProcesso>&#xa;                            &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                        &lt;/ns:TipologiaProcesso>&#xa;                        &lt;ns:TipologiaOperazione>&#xa;                            &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                        &lt;/ns:TipologiaOperazione>&#xa;                        &lt;ns:EsecuzioneNOFileProcessato>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;181&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;