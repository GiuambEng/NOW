                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns=&quot;http://www.example.org/RemoveCodiceMigrazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns2:RemoveCodiceMigrazioneCP_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseJSON/tns:reason_code='F003'&quot;>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:RemoveCodiceMigrazioneCP_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
