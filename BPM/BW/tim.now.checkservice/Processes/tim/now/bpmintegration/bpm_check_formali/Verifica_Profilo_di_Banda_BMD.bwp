                <bpws:sources>
                    <bpws:source linkName="EmptyToWhile1_VARIAZIONE">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToEnd_ATTIVAZIONEoMIGRAZIONE">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Verifica_Profilo_di_Banda_BMD/parameters/tns:Verifica_Profilo_di_Banda_BMD_Request/tns:Lavorazione = (&quot;ATTIVAZIONE&quot;,&quot;MIGRAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Verifica_Profilo_di_Banda_BMD.parameters/tns:Lavorazione = ("ATTIVAZIONE","MIGRAZIONE")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Verifica_Profilo_di_Banda_BMD/parameters/tns:Verifica_Profilo_di_Banda_BMD_Request/tns:UserVlan[1]/tns:IdUserVlan) = 0 and $Verifica_Profilo_di_Banda_BMD/parameters/tns:Verifica_Profilo_di_Banda_BMD_Request/tns:Lavorazione = &quot;VARIAZIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($Verifica_Profilo_di_Banda_BMD.parameters/tns:UserVlan[1]/tns:IdUserVlan) = 0 and $Verifica_Profilo_di_Banda_BMD.parameters/tns:Lavorazione = "VARIAZIONE"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d5c4a4f1-43fd-44f8-9dd9-720e0c866af8+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Verifica_Profilo_di_Banda_BMD&quot;/>&lt;xsl:template name=&quot;JDBC_SVLANCODE-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Verifica_Profilo_di_Banda_BMD/parameters/tns1:Verifica_Profilo_di_Banda_BMD_Request/tns1:IDRisorsa&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:value-of select=&quot;$Verifica_Profilo_di_Banda_BMD/parameters/tns1:Verifica_Profilo_di_Banda_BMD_Request/tns1:IDRisorsa&amp;#xD;&amp;#xA;&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
