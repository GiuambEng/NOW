                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ass.BDS_ID,ass.IDASSET,dett.NOMECOMPONENTE,dett.IDDETTAGLIOASSET,att.NOMEATTRIBUTO,att.VALOREATTRIBUTO &#xa;FROM BDS_1_CASEDATA_ASSET ass,BDS_1_CASEDATA_DETTAGLIOASSET dett,BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;WHERE ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID and&#xa;dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xa;ass.IDRISORSA= ? and &#xa;dett.NOMECOMPONENTE='USERVLAN' and&#xa;att.NOMEATTRIBUTO IN ('SVLANCODE')&#xa;and ass.STATOASSET in ('ATTIVO','INLAVORAZIONE') &#xa;and dett.STATODETTAGLIOASSET = 'ATTIVO'&#xa;and dett.IDDETTAGLIOASSET = (SELECT dett.IDDETTAGLIOASSET&#xa;FROM BDS_1_CASEDATA_ASSET ass,BDS_1_CASEDATA_DETTAGLIOASSET dett,BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;WHERE ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID and&#xa;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xa;ass.IDRISORSA = ? and &#xa;dett.NOMECOMPONENTE = 'USERVLAN' and&#xa;att.NOMEATTRIBUTO IN ('USERVLANID') &#xa;and att.VALOREATTRIBUTO = ?&#xa;and ass.STATOASSET in ('ATTIVO','INLAVORAZIONE'))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

