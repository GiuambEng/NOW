                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;'VerificaIncompatibilitaServiziOpzionali'&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;'VerificaIncompatibilitaServiziOpzionali'&quot;/>&lt;/tns1:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiesta&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiesta&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat('Input VerificaIncompatibilitaServiziOpzionali :', tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
