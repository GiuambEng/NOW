            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogDelete-input"
                    name="LogDelete"
                    tibex:xpdlId="8a431d65-c33c-460f-937a-900ab5b7618e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RimuoviRemoteIDToLogDelete"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDelete-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCompatibilitaIntermediateAgent'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Eliminato attributo REMOTEID per idrichiesta: ',$Start/tns:IdRichiesta)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttributiAsset-input"
                    name="AttributiAsset"
                    outputVariable="AttributiAsset"
                    tibex:xpdlId="b55eaf5f-350a-40d2-835c-ef89c3c1570f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery_Variazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaEncapsulationToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b55eaf5f-350a-40d2-835c-ef89c3c1570f+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaEncapsulation-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IdAsset>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:IdAsset)&quot;/>&#xa;            &lt;/IdAsset>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att , APPUSER.bds_1_casedata_asset ass&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id and ass.idasset = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdAsset"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAttributiAsset-input"
                    name="LogAttributiAsset"
                    tibex:xpdlId="807af6cc-c6aa-4408-86ed-e11c1e1cde9a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaEncapsulationToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToResponse"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AttributiAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAttributiAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCompatibilitaIntermediateAgent'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperati dalla consistenza i seguenti attributi: &amp;quot;, tib:render-xml($AttributiAsset))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperaBDSID-input"
                    name="RecuperaBDSID" outputVariable="RecuperaBDSID"
                    tibex:xpdlId="3fa6e98b-f7f9-46dc-9d06-3b2ef6326b7d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaBDSIDToLodBDSID"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3fa6e98b-f7f9-46dc-9d06-3b2ef6326b7d+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IdAsset>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:IdAsset)&quot;/>&#xa;            &lt;/IdAsset>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ATT.BDS_ID&#xa;          from BDS_1_CASEDATA_ASSET ASSET&#xa;        join BDS_1_CASEDATA_DETTAGLIOASSET DETT  ON ASSET.BDS_ID=DETT.ASSET_DETTAGLIOASSET_BDSID&#xa;        JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ATT ON dett.BDS_ID=ATT.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;        where 1=1  &#xa;       and DETT.NOMECOMPONENTE='USERVLAN' &#xa;        AND ATT.NOMEATTRIBUTO ='REMOTEID'&#xa;        and ASSET.IDASSET=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdAsset"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RimuoviRemoteID-input"
                    name="RimuoviRemoteID"
                    outputVariable="RimuoviRemoteID"
                    tibex:xpdlId="5141fa13-fa62-45f9-9dca-825fd779e6a1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LodBDSIDToRimuoviRemoteID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RimuoviRemoteIDToLogDelete"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5141fa13-fa62-45f9-9dca-825fd779e6a1+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaBDSID&quot;/>&#xa;    &lt;xsl:template name=&quot;RimuoviRemoteID-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;ATTRIBUTE_BDS_ID>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RecuperaBDSID/Record[1]/BDS_ID)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaBDSID/Record[1]/BDS_ID&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ATTRIBUTE_BDS_ID>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns1:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCCallProcedure"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCCallProcedureActivity"/>
                                    <value
                                    catalogOrPackage="PKG_ASSET_UTILITIES"
                                    procedureOrFunctionName="ELIMINA_ATTRIBUTO"
                                    schema="APPUSER"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:JDBCCallProcedureActivity">
                                    <preparedParamters DataType="2"
                                    DataTypeDisplayValue="NUMBER"
                                    ParameterName="ATTRIBUTE_BDS_ID" ProcedureParamterType="1"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LodBDSID-input"
                    name="LodBDSID"
                    tibex:xpdlId="5060d2bc-5b98-4e08-b871-eb84a9b0a4ba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaBDSIDToLodBDSID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LodBDSIDToRimuoviRemoteID"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaBDSID&quot;/>&#xa;    &lt;xsl:template name=&quot;LodBDSID-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCompatibilitaIntermediateAgent'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperato BDS_ID da cancellare: &amp;quot;, tib:render-xml($RecuperaBDSID))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
