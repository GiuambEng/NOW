                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AreaCantiereFromCodTop&quot;/>&#xa;    &lt;xsl:param name=&quot;AreaCantiereFromIdsluco&quot;/>&#xa;    &lt;xsl:param name=&quot;AreaCantiereFromIdullco&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DeterminaAreaDiCantiere_Response>&#xa;            &lt;tns1:Esito>&#xa;                &lt;tns1:Codice>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:Codice>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($AreaCantiereFromIdullco/Record)>0 or count($AreaCantiereFromIdsluco/Record)>0 or count($AreaCantiereFromCodTop/Record)>0&quot;>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Recuperata AreaDiCantiere con i dati forniti in input'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Nessuna AreaDiCantiere recuperata con i dati forniti in input'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:Esito>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($AreaCantiereFromIdullco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$AreaCantiereFromIdullco/Record[1]/AREA_DI_CANT&quot;>&#xa;                        &lt;tns1:AreaDiCantiere>&#xa;                            &lt;xsl:value-of select=&quot;$AreaCantiereFromIdullco/Record[1]/AREA_DI_CANT&quot;/>&#xa;                        &lt;/tns1:AreaDiCantiere>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($AreaCantiereFromIdsluco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$AreaCantiereFromIdsluco/Record[1]/AREA_DI_CANT&quot;>&#xa;                        &lt;tns1:AreaDiCantiere>&#xa;                            &lt;xsl:value-of select=&quot;$AreaCantiereFromIdsluco/Record[1]/AREA_DI_CANT&quot;/>&#xa;                        &lt;/tns1:AreaDiCantiere>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($AreaCantiereFromCodTop/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$AreaCantiereFromCodTop/Record[1]/AREA_DI_CANT&quot;>&#xa;                        &lt;tns1:AreaDiCantiere>&#xa;                            &lt;xsl:value-of select=&quot;$AreaCantiereFromCodTop/Record[1]/AREA_DI_CANT&quot;/>&#xa;                        &lt;/tns1:AreaDiCantiere>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:DeterminaAreaDiCantiere_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
