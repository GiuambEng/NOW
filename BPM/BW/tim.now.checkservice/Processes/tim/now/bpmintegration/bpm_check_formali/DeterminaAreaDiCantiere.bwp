            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AreaCantiereFromIdullco-input"
                    name="AreaCantiereFromIdullco"
                    outputVariable="AreaCantiereFromIdullco"
                    tibex:xpdlId="82001699-561d-4a3c-b078-83723abae97a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery_Idullco"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AreaCantiereFromIdullcoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+82001699-561d-4a3c-b078-83723abae97a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AreaCantiereFromIdullco-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;datainviorich>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/datainviorich>&lt;datainviorich1>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/datainviorich1>&lt;idullco>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDULLCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDULLCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idullco>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select area_di_cant &#xa;from del321_area_di_cant &#xa;where to_date(?, 'YYYY-MM-DD') between data_iniz_valid and data_fine_valid and id_area_di_cant in &#xa;(select id_area_di_cant from del321_area_di_centr where id_area_di_centr in &#xa;(select id_area_di_centr from del321_clli where to_date(?, 'YYYY-MM-DD') between data_iniz_valid and data_fine_valid and clli in &#xa;(select clli from clc_idullco where idullco=?)))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="datainviorich"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="datainviorich1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idullco"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="AREA_DI_CANT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AreaCantiereFromIdsluco-input"
                    name="AreaCantiereFromIdsluco"
                    outputVariable="AreaCantiereFromIdsluco"
                    tibex:xpdlId="81150ea7-5719-4ed0-b93e-194d4a7f9866" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
