                        <bpws:target linkName="CodImpresaFromIdslucoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCodImpresaToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:IDULLCO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:IDULLCO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogCodImpresaToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:IDSLUCO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:IDSLUCO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdsluco&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdullco&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCodImpresa-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($CodImpresaFromIdullco/Record)>0&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato recuperato per IDULLCO', tib:render-xml($CodImpresaFromIdullco, true(), true()))&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($CodImpresaFromIdsluco/Record)>0&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato recuperato per IDSLUCO', tib:render-xml($CodImpresaFromIdsluco, true(), true()))&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun Codice Impresa recuperato'&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="DisaggAppuntULL-input"
                    name="DisaggAppuntULL"
                    outputVariable="DisaggAppuntULL"
                    tibex:xpdlId="ad440d68-8c69-4fb0-a811-53c024446576" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCodImpresaToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DisaggAppuntToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ad440d68-8c69-4fb0-a811-53c024446576+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindImpresaFromIDULLCO&quot;/>&lt;xsl:template name=&quot;DisaggAppuntULL-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;ID_IMPRESA>&lt;xsl:value-of select=&quot;xsd:int($FindImpresaFromIDULLCO/Record[1]/ID_IMPRESA)&quot;/>&lt;/ID_IMPRESA>&lt;COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLOAgcom&quot;/>&lt;/COD_OLO_AGCOM>&lt;DATAINVIORICH>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH>&lt;IDULLCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDULLCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDULLCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDULLCO>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select DISAGZ_APPUNTAMENTO from DEL321_ASS_OLO_IMP_AREADICANT where ID_IMPRESA=? and COD_OLO_AGCOM=? AND &#xd;&#xa;TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND&#xd;&#xa;ID_AREA_DI_CANT IN &#xd;&#xa;(select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE ID_AREA_DI_CENTR in&#xd;&#xa;(select ID_AREA_DI_CENTR from DEL321_CLLI WHERE CLLI IN  (SELECT CLLI FROM CLC_IDULLCO WHERE IDULLCO=?)))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_IMPRESA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDULLCO"/>
                                    <columnMetadata
                                    columnName="DISAGZ_APPUNTAMENTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogDisaggAppunt-input"
                    name="LogDisaggAppunt"
                    tibex:xpdlId="ab1a56f2-a92f-41c4-8d27-7a7df0f0476e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DisaggAppuntToGenericLogger"/>
                        <bpws:target linkName="DisaggAppuntSLUToLogDisaggAppunt"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDisaggAppuntToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;DisaggAppuntULL&quot;/>&#xa;    &lt;xsl:param name=&quot;DisaggAppuntSLU&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDisaggAppunt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:IDULLCO)>0&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperata DisaggregazioneAppuntamento&amp;quot;, tib:render-xml($DisaggAppuntULL, true(), true()))&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperata DisaggregazioneAppuntamento&amp;quot;, tib:render-xml($DisaggAppuntSLU, true(), true()))&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="Response2" outputVariable="Response"
                    tibex:xpdlId="f0a28437-92ec-4816-9eb4-7efa6da90b3e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDisaggAppuntToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Response2ToDatiVerificaControlli"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdsluco&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdullco&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaEsistenzaImpresa_Response>&#xa;            &lt;xsl:copy-of select=&quot;$Response/tns1:Esito&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($CodImpresaFromIdullco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodImpresaFromIdullco/Record[1]/COD_IMPRESA&quot;>&#xa;                        &lt;tns1:ImpresaAdCentrale>&#xa;                            &lt;xsl:value-of select=&quot;$CodImpresaFromIdullco/Record[1]/COD_IMPRESA&quot;/>&#xa;                        &lt;/tns1:ImpresaAdCentrale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($CodImpresaFromIdsluco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA&quot;>&#xa;                        &lt;tns1:ImpresaAdCentrale>&#xa;                            &lt;xsl:value-of select=&quot;$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA&quot;/>&#xa;                        &lt;/tns1:ImpresaAdCentrale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:SystemUnico&quot;>&#xa;                        &lt;tns1:ImpresaAdCentrale>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:SystemUnico&quot;/>&#xa;                        &lt;/tns1:ImpresaAdCentrale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($CodImpresaFromIdullco/Record)>0 or count($CodImpresaFromIdsluco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:SystemUnico&quot;>&#xa;                        &lt;tns1:Ati>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:SystemUnico&quot;/>&#xa;                        &lt;/tns1:Ati>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:VerificaEsistenzaImpresa_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DatiVerificaControlli-input"
                name="DatiVerificaControlli"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlli"
                partnerLink="DatiVerificaControlli"
                portType="ns14:DatiVerificaControlliPortType" tibex:xpdlId="3a21276e-0fd1-46af-9cdb-6d2bbd7c9e90">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliFormali/" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns8="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="DisaggAppuntULL"/&gt;
    &lt;xsl:param name="CodImpresaFromIdsluco"/&gt;
    &lt;xsl:param name="CodImpresaFromIdullco"/&gt;
    &lt;xsl:param name="DisaggAppuntSLU"/&gt;
    &lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;
        &lt;tns7:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns8:DatiVerificaControlliInput&gt;
                    &lt;tns8:Operatore&gt;
                        &lt;xsl:value-of select="'BPM'"/&gt;
                    &lt;/tns8:Operatore&gt;
                    &lt;tns8:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/tns1:IDRichiestaOLO"/&gt;
                    &lt;/tns8:IDRichiestaOLO&gt;
                    &lt;tns8:Azione&gt;
                        &lt;xsl:value-of select="'INSERT'"/&gt;
                    &lt;/tns8:Azione&gt;
                    &lt;tns8:Disaggregazione&gt;
                        &lt;xsl:if test="count($CodImpresaFromIdullco/Record)&gt;0 or count($CodImpresaFromIdsluco/Record)&gt;0"&gt;
                            &lt;xsl:if test="$Start/tns1:SystemUnico"&gt;
                                &lt;tns8:Ati&gt;
                                    &lt;xsl:value-of select="$Start/tns1:SystemUnico"/&gt;
                                &lt;/tns8:Ati&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="count($CodImpresaFromIdullco/Record)&gt;0"&gt;
                                &lt;xsl:if test="$CodImpresaFromIdullco/Record[1]/COD_IMPRESA"&gt;
                                    &lt;tns8:ImpresaAdCentrale&gt;
                                        &lt;xsl:value-of select="$CodImpresaFromIdullco/Record[1]/COD_IMPRESA"/&gt;
                                    &lt;/tns8:ImpresaAdCentrale&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="count($CodImpresaFromIdsluco/Record)&gt;0"&gt;
                                &lt;xsl:if test="$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA"&gt;
                                    &lt;tns8:ImpresaAdCentrale&gt;
                                        &lt;xsl:value-of select="$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA"/&gt;
                                    &lt;/tns8:ImpresaAdCentrale&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$Start/tns1:SystemUnico"&gt;
                                    &lt;tns8:ImpresaAdCentrale&gt;
                                        &lt;xsl:value-of select="$Start/tns1:SystemUnico"/&gt;
                                    &lt;/tns8:ImpresaAdCentrale&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($Start/tns1:IDULLCO)&gt;0"&gt;
                                &lt;xsl:if test="$DisaggAppuntULL/Record[1]/DISAGZ_APPUNTAMENTO"&gt;
                                    &lt;tns8:DisaggrAppuntamento&gt;
                                        &lt;xsl:value-of select="$DisaggAppuntULL/Record[1]/DISAGZ_APPUNTAMENTO"/&gt;
                                    &lt;/tns8:DisaggrAppuntamento&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$DisaggAppuntSLU/Record[1]/DISAGZ_APPUNTAMENTO"&gt;
                                    &lt;tns8:DisaggrAppuntamento&gt;
                                        &lt;xsl:value-of select="$DisaggAppuntSLU/Record[1]/DISAGZ_APPUNTAMENTO"/&gt;
                                    &lt;/tns8:DisaggrAppuntamento&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns8:Disaggregazione&gt;
                &lt;/tns8:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns7:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;DisaggAppuntULL&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdsluco&quot;/>&#xa;    &lt;xsl:param name=&quot;CodImpresaFromIdullco&quot;/>&#xa;    &lt;xsl:param name=&quot;DisaggAppuntSLU&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:DatiVerificaControlliInput>&#xa;            &lt;tns8:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns8:Operatore>&#xa;            &lt;tns8:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns8:IDRichiestaOLO>&#xa;            &lt;tns8:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns8:Azione>&#xa;            &lt;tns8:Disaggregazione>&#xa;                &lt;xsl:if test=&quot;count($CodImpresaFromIdullco/Record)>0 or count($CodImpresaFromIdsluco/Record)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:SystemUnico&quot;>&#xa;                        &lt;tns8:Ati>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:SystemUnico&quot;/>&#xa;                        &lt;/tns8:Ati>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($CodImpresaFromIdullco/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CodImpresaFromIdullco/Record[1]/COD_IMPRESA&quot;>&#xa;                            &lt;tns8:ImpresaAdCentrale>&#xa;                                &lt;xsl:value-of select=&quot;$CodImpresaFromIdullco/Record[1]/COD_IMPRESA&quot;/>&#xa;                            &lt;/tns8:ImpresaAdCentrale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($CodImpresaFromIdsluco/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA&quot;>&#xa;                            &lt;tns8:ImpresaAdCentrale>&#xa;                                &lt;xsl:value-of select=&quot;$CodImpresaFromIdsluco/Record[1]/COD_IMPRESA&quot;/>&#xa;                            &lt;/tns8:ImpresaAdCentrale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:SystemUnico&quot;>&#xa;                            &lt;tns8:ImpresaAdCentrale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:SystemUnico&quot;/>&#xa;                            &lt;/tns8:ImpresaAdCentrale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:IDULLCO)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$DisaggAppuntULL/Record[1]/DISAGZ_APPUNTAMENTO&quot;>&#xa;                            &lt;tns8:DisaggrAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;$DisaggAppuntULL/Record[1]/DISAGZ_APPUNTAMENTO&quot;/>&#xa;                            &lt;/tns8:DisaggrAppuntamento>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DisaggAppuntSLU/Record[1]/DISAGZ_APPUNTAMENTO&quot;>&#xa;                            &lt;tns8:DisaggrAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;$DisaggAppuntSLU/Record[1]/DISAGZ_APPUNTAMENTO&quot;/>&#xa;                            &lt;/tns8:DisaggrAppuntamento>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns8:Disaggregazione>&#xa;        &lt;/tns8:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Response2ToDatiVerificaControlli"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="DisaggAppuntSLU-input"
                    name="DisaggAppuntSLU"
                    outputVariable="DisaggAppuntSLU"
                    tibex:xpdlId="35258961-9156-4360-bb80-8a688adf6e6d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCodImpresaToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DisaggAppuntSLUToLogDisaggAppunt"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+35258961-9156-4360-bb80-8a688adf6e6d+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindImpresaFromIDSLUCO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DisaggAppuntSLU-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;ID_IMPRESA>&lt;xsl:value-of select=&quot;xsd:int($FindImpresaFromIDSLUCO/Record[1]/ID_IMPRESA)&quot;/>&lt;/ID_IMPRESA>&lt;COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLOAgcom&quot;/>&lt;/COD_OLO_AGCOM>&lt;DATAINVIORICH>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH>&lt;IDSLUCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDSLUCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDSLUCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDSLUCO>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select DISAGZ_APPUNTAMENTO from DEL321_ASS_OLO_IMP_AREADICANT where ID_IMPRESA=? and COD_OLO_AGCOM=? AND &#xa;TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND&#xa;ID_AREA_DI_CANT IN &#xa;(select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE ID_AREA_DI_CENTR in&#xa;(select ID_AREA_DI_CENTR from DEL321_CLLI WHERE CLLI IN  (select COD_CLLI_CENTRALE from CLC_IDSLUCO WHERE IDSLUCO=?)))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_IMPRESA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDSLUCO"/>
                                    <columnMetadata
                                    columnName="DISAGZ_APPUNTAMENTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="82ae6f17-f6db-4641-8693-9a683ea9dd77" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogResultToOscuramento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+82ae6f17-f6db-4641-8693-9a683ea9dd77+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO from OSCURAMENTO_AGESP WHERE COD_AGESP='R1I-19-0350' AND FLAG_OSCURMENTO='1'"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscur-input"
                    name="LogOscur"
                    tibex:xpdlId="3fcace77-13ce-4b3f-a612-8bc5a771767c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToResponse"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscur-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaImpresa'&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-19-0350 risulta oscurato'&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-19-0350 non risulta oscurato'&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
