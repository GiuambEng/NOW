                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_IMPRESA FROM DEL321_IMPRESA where TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_IMPRESA IN ( SELECT ID_IMPRESA FROM DEL321_ASS_OLO_IMP_AREADICANT WHERE COD_OLO_AGCOM=? AND &#xa;TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND&#xa;ID_AREA_DI_CANT IN &#xa;(select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_AREA_DI_CENTR in&#xa;(select ID_AREA_DI_CENTR from DEL321_CLLI WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND CLLI IN  (select COD_CLLI_CENTRALE from CLC_IDSLUCO WHERE IDSLUCO=?))))&#xa;AND COD_IMPRESA=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
