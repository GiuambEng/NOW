                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+61394948-0439-4a71-ac53-af25c49050d0+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindImpresaFromIDULLCO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DATAINVIORICH1>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH1>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLOAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;DATAINVIORICH>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH>&lt;DATAINVIORICH2>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH2>&lt;DATAINVIORICH3>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH3>&lt;IDULLCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDULLCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDULLCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDULLCO>&lt;COD_IMPRESA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:SystemUnico)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:SystemUnico&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_IMPRESA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_IMPRESA FROM DEL321_IMPRESA where TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_IMPRESA IN ( SELECT ID_IMPRESA FROM DEL321_ASS_OLO_IMP_AREADICANT WHERE COD_OLO_AGCOM=? AND &#xd;&#xa;TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND&#xd;&#xa;ID_AREA_DI_CANT IN &#xd;&#xa;(select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_AREA_DI_CENTR in&#xd;&#xa;(select ID_AREA_DI_CENTR from DEL321_CLLI WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND CLLI IN  (SELECT CLLI FROM CLC_IDULLCO WHERE IDULLCO=?))))&#xd;&#xa;AND COD_IMPRESA=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH3"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDULLCO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_IMPRESA"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_IMPRESA"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
