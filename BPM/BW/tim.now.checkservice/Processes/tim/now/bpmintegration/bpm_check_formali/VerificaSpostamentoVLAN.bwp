                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO from OSCURAMENTO_AGESP WHERE COD_AGESP='R1I-23-0284' AND FLAG_OSCURMENTO='1'&#xd;&#xa;&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
