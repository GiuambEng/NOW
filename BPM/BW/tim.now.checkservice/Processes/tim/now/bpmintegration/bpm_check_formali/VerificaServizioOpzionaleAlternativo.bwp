                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ID_ANAG_SERVZ_OPZ&#xa;from anag_servz_opzionali_auto&#xa;where CODIFICA_OLO_AGCOM=?&#xa;and COD_PROGETTO=?&#xa;and ID_ANAG_SERVZ_OPZ in (select ID_ANAG_SERVZ_OPZ from anag_servz_opzionale where COD_ANAG_SERVZ_OPZ=?)&#xa;and ID_OFFERTA in (select ID_OFFERTA from TRASCODFC_OFFERTA where PROVENIENZA='BPM' and NOME_OFFERTA_ESTERNA=?)&#xa;and to_date(?, 'YYYY-MM-DD') BETWEEN DATA_INIZIO_VAL AND DATA_FINE_VAL" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROGETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ANAG_SERVZ_OPZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="ID_ANAG_SERVZ_OPZ"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
