                                    <element maxOccurs="1" minOccurs="1"
                                    name="ID_CLUSTER" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DATA_FINE_VALIDITA" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
