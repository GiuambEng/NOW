                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;PRGT&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:DatiVerificaControlliInput>&#xa;            &lt;tns6:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns6:Operatore>&#xa;            &lt;tns6:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns6:IDRichiestaOLO>&#xa;            &lt;tns6:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns6:Azione>&#xa;            &lt;tns6:LavorazioneRichiesta>&#xa;                &lt;xsl:if test=&quot;$PRGT/Record[1]/ONESTEP='SI'&quot;>&#xa;                    &lt;xsl:if test=&quot;$PRGT/Record[1]/PROPRIETAMATERIALEOAO&quot;>&#xa;                        &lt;tns6:ProprietaMateriale>&#xa;                            &lt;xsl:value-of select=&quot;$PRGT/Record[1]/PROPRIETAMATERIALEOAO&quot;/>&#xa;                        &lt;/tns6:ProprietaMateriale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$PRGT/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;>&#xa;                    &lt;tns6:FlagEquivalenzaProdotti>&#xa;                        &lt;xsl:value-of select=&quot;$PRGT/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;/>&#xa;                    &lt;/tns6:FlagEquivalenzaProdotti>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$PRGT/Record[1]/ONESTEP='SI'&quot;>&#xa;                        &lt;tns6:oneStep>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns6:oneStep>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:oneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns6:oneStep>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:LavorazioneRichiesta>&#xa;        &lt;/tns6:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
