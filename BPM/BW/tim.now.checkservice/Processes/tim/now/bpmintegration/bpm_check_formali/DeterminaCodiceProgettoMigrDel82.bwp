                                    <columnMetadata columnIndex="1"
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="ONESTEP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="FLAGEQUIVALENZAPRODOTTI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="PROPRIETAMATERIALEOAO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
