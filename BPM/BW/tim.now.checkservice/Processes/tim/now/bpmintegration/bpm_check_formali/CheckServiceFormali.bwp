    &lt;xsl:template name="ReplyControlloCoerenzaRichiestaFault-input" match="/"&gt;
        &lt;tns2:ControlloCoerenzaRichiestaFault&gt;
            &lt;Fault&gt;
                &lt;tns1:ControlloCoerenzaRichiesta_Fault&gt;
                    &lt;tns1:Fault&gt;
