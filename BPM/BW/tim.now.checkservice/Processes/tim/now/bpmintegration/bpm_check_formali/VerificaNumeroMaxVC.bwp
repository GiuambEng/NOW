                                    sqlStatement="select NOMECOMPONENTE&#xa;from BDS_1_CASEDATA_DETTAGLIOASSET&#xa;where NOMECOMPONENTE = 'ATMVC' and STATODETTAGLIOASSET = 'ATTIVO' and IDASSET = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
