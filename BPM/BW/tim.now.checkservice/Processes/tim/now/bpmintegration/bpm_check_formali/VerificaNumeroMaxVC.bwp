                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select MAX_VC_X_CF &#xa;from PROFILO_TCNC_LINEA P, TRASCODFC_OFFERTA T&#xa;where &#xa;P.ID_OFFERTA=T.ID_OFFERTA and&#xa;T.PROVENIENZA='BPM' and &#xa;T.NOME_OFFERTA_ESTERNA = ? and P.PROFILO_TCNC_LINEA = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
