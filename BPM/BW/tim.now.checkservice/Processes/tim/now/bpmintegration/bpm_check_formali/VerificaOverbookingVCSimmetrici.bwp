lt;/xsl:choose>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($MapperOverbookingVC/tns1:VC[tns1:ProfiloVC='ABR']/tns1:PCR)&quot;>&lt;xsl:for-each select=&quot;$MapperOverbookingVC/tns1:VC[tns1:ProfiloVC='ABR']/tns1:PCR&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(.,&amp;quot;,&amp;quot;)&quot;>&lt;tns:PCRabr>&lt;xsl:value-of select=&quot;xsd:decimal(translate(.  , &amp;quot;,&amp;quot; , &amp;quot;.&amp;quot;))&quot;/>&lt;/tns:PCRabr>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(.,&amp;quot;.&amp;quot;)&quot;>&lt;tns:PCRabr>&lt;xsl:value-of select=&quot;xsd:decimal(.)&quot;/>&lt;/tns:PCRabr>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PCRabr>&lt;xsl:value-of select=&quot;xsd:integer(.)&quot;/>&lt;/tns:PCRabr>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($MapperOverbookingVC/tns1:VCConsistenza[tns1:ProfiloVC='ABR' ]/tns1:PCR)&quot;>&lt;xsl:for-each select=&quot;$MapperOverbookingVC/tns1:VCConsistenza[tns1:ProfiloVC='ABR' ]/tns1:PCR&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(.,&amp;quot;,&amp;quot;)&quot;>&lt;tns:PRCabrCONS>&lt;xsl:value-of select=&quot;xsd:decimal(translate(.  , &amp;quot;,&amp;quot; , &amp;quot;.&amp;quot;))&quot;/>&lt;/tns:PRCabrCONS>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(.,&amp;quot;.&amp;quot;)&quot;>&lt;tns:PRCabrCONS>&lt;xsl:value-of select=&quot;xsd:decimal(.)&quot;/>&lt;/tns:PRCabrCONS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PRCabrCONS>&lt;xsl:value-of select=&quot;xsd:integer(.)&quot;/>&lt;/tns:PRCabrCONS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:Sommatoria>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
