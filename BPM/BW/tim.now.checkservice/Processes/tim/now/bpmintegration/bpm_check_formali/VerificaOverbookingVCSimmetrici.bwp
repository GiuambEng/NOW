                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="sum($Sommatoria/ns15:MCR) + sum($Sommatoria/ns15:MCRcons)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
