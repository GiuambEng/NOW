                                    name="Copy_1_LogCheckAmmissibilitaToAssign2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="7550accb-0409-4b1a-a67c-28d581b76d26">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
