                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns5:CONSISTENZADATIVC) and $Variable/ns5:Esito/ns5:Codice = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns5:CONSISTENZADATIVC) and $Variable/ns5:Esito/ns5:Codice = true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CheckAmmissibilitaToCopy_1_LogCheckAmmissibilita" tibex:linkType="SUCCESS"/>
