                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta = (&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;) and $Start/tns:ServizioNonValido='SI' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0&quot;>&lt;tns:DeterminaONTOperatore_Response>&lt;tns:OntOperatore>&lt;xsl:value-of select=&quot;'NO'&quot;/>&lt;/tns:OntOperatore>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:DeterminaONTOperatore_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryOscuramento/Record/FLAG_OSCURMENTO) != 0&quot;>&lt;tns:DeterminaONTOperatore_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:DeterminaONTOperatore_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DeterminaONTOperatore_Response>&lt;tns:OntOperatore>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns:OntOperatore>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:DeterminaONTOperatore_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
