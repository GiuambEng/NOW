                partnerLink="DatiVerificaControlli"
                portType="ns1:DatiVerificaControlliPortType" tibex:xpdlId="f8eecde4-579b-408a-86f2-a014ffb55677">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliFormali/" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;
        &lt;tns3:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:DatiVerificaControlliInput&gt;
                    &lt;tns1:Operatore&gt;
                        &lt;xsl:value-of select="'BPM'"/&gt;
                    &lt;/tns1:Operatore&gt;
                    &lt;tns1:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;
                    &lt;/tns1:IDRichiestaOLO&gt;
                    &lt;tns1:Azione&gt;
                        &lt;xsl:value-of select="'INSERT'"/&gt;
                    &lt;/tns1:Azione&gt;
                    &lt;tns1:LavorazioneRichiesta&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Start/tns:Offerta = (&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;) and $Start/tns:ServizioNonValido='SI'"&gt;
                                &lt;tns1:ontOperatore&gt;
                                    &lt;xsl:value-of select="'NO'"/&gt;
                                &lt;/tns1:ontOperatore&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns1:ontOperatore&gt;
                                    &lt;xsl:value-of select="'SI'"/&gt;
                                &lt;/tns1:ontOperatore&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns1:LavorazioneRichiesta&gt;
                &lt;/tns1:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns3:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:LavorazioneRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Offerta = (&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;) and $Start/tns:ServizioNonValido='SI'&quot;>&#xa;                        &lt;tns1:ontOperatore>&#xa;                            &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                        &lt;/tns1:ontOperatore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:ontOperatore>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/tns1:ontOperatore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:LavorazioneRichiesta>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToDatiVerificaControlli"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="f0e9dfa8-d6a6-4d72-88c8-8e50229dd6ba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToDatiVerificaControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToDatiVerificaControlli">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:Offerta = (&quot;BITSTREAMNGAFTTH&quot;,&quot;VULAFTTH&quot;,&quot;SEMIVULAFTTH&quot;,&quot;EASYIPNGAFTTH&quot;) and $Start/tns:ServizioNonValido='SI' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:Offerta = ("BITSTREAMNGAFTTH","VULAFTTH","SEMIVULAFTTH","EASYIPNGAFTTH") and $Start/tns:ServizioNonValido='SI' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcess1ToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;'DeterminaONTOperatore'&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('Output query oscuramento ',tib:render-xml($QueryOscuramento))&quot;/>&lt;/tns8:Message>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
