                    <bpws:forEach counterName="index" name="forEach"
                        parallel="no" tibex:group="foreach">
                        <tibex:DesignExpression name="final">
                            <tibex:expression
                                expression="count($Start/tns:CodiceServizio)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/tns:CodiceServizio)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToAnag_Serv_Opz_Alternativi" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Anag_Serv_Opz_AlternativiToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogAnag_Serv_Opz_AlternativiToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="DescrToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:empty name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="b0b6bd67-7981-496c-aa2f-f519b1db6bdf">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToAnag_Serv_Opz_Alternativi"/>
                                    </bpws:sources>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="ff0353f0-e5c0-4062-8d51-d36af8ec1439" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
