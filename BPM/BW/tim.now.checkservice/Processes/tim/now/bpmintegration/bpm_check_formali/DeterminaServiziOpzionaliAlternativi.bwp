            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Progetto_JDBC-input"
                    name="Progetto_JDBC" outputVariable="Progetto_JDBC"
                    tibex:xpdlId="46ab250f-6ebf-40d3-9f3e-9e3aeb040827" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Progetto_JDBCToLog_JDBC_Progetto">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Progetto_JDBCToForEach">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Progetto_JDBC/Record) > 0 and count($Start/tns:CodiceServizio) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Progetto_JDBC/Record) > 0 and count($Start/tns:CodiceServizio) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+46ab250f-6ebf-40d3-9f3e-9e3aeb040827+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Progetto_JDBC-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_PRGT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceProgetto)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceProgetto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_PRGT>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;DRO>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DRO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DRO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_PRGT&#xd;&#xa;FROM PRGT &#xd;&#xa;WHERE COD_PRGT = ? AND CODFC_OLO_AGCOM = ? &#xd;&#xa;and ONESTEP= 'SI' and PRODOTTI_A_CATALOGO='SI' &#xd;&#xa;and to_date(?, 'YYYY-MM-DD') BETWEEN DATAINZ_VALID AND DATAFI_VALID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PRGT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_PRGT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Log_JDBC_Progetto-input"
