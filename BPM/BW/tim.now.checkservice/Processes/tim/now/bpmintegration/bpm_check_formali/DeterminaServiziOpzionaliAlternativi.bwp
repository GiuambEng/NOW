                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:DatiVerificaControlliInput>&#xa;            &lt;tns6:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns6:Operatore>&#xa;            &lt;tns6:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns6:IDRichiestaOLO>&#xa;            &lt;tns6:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns6:Azione>&#xa;            &lt;xsl:for-each select=&quot;$Variable/tns1:ServiziOpzAlternativi&quot;>&#xa;                &lt;tns6:ServiziOpzionali>&#xa;                    &lt;xsl:if test=&quot;tns1:CodiceServizio&quot;>&#xa;                        &lt;tns6:CodiceServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns1:CodiceServizio&quot;/>&#xa;                        &lt;/tns6:CodiceServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:DescrizioneServizio&quot;>&#xa;                        &lt;tns6:DescrizioneServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns1:DescrizioneServizio&quot;/>&#xa;                        &lt;/tns6:DescrizioneServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:DatiTecnici&quot;>&#xa;                        &lt;tns6:DatiTecnici>&#xa;                            &lt;xsl:value-of select=&quot;tns1:DatiTecnici&quot;/>&#xa;                        &lt;/tns6:DatiTecnici>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:VincolantePerEspletamento&quot;>&#xa;                        &lt;tns6:VincolantePerEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;tns1:VincolantePerEspletamento&quot;/>&#xa;                        &lt;/tns6:VincolantePerEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:ProdottoCatalogo&quot;>&#xa;                        &lt;tns6:ProdottoCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;tns1:ProdottoCatalogo&quot;/>&#xa;                        &lt;/tns6:ProdottoCatalogo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:CodiceServizioPadre&quot;>&#xa;                        &lt;tns6:CodiceServizioPadre>&#xa;                            &lt;xsl:value-of select=&quot;tns1:CodiceServizioPadre&quot;/>&#xa;                        &lt;/tns6:CodiceServizioPadre>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns6:ServiziOpzionali>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns6:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
