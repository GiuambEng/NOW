                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Anag_Serv_Opz_Alternativi-input"
                                    name="Anag_Serv_Opz_Alternativi"
                                    outputVariable="Anag_Serv_Opz_Alternativi"
                                    tibex:xpdlId="6419eca3-4a8d-49f0-b6bf-05bf32e2aafb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAnag_Serv_Opz_Alternativi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Anag_Serv_Opz_AlternativiToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6419eca3-4a8d-49f0-b6bf-05bf32e2aafb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Anag_Serv_Opz_Alternativi-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;COD_PROGETTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceProgetto)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceProgetto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_PROGETTO>&lt;SERVIZIO_OPZIONALE_ALTERNATIVO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceServizio[$index])&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceServizio[$index]&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SERVIZIO_OPZIONALE_ALTERNATIVO>&lt;DRO>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DRO), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DRO>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATI_TECNICI, VINCOLANTE_ESPLETAMENTO , SERVZ_OPZ_PADRE&#xa;FROM anag_servz_opz_alternativo&#xa;WHERE COD_PROGETTO=? and SERVZ_OPZ_ALTERNATIVO=? &#xa;AND to_date(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VAL AND DATA_FINE_VAL" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROGETTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SERVIZIO_OPZIONALE_ALTERNATIVO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="DATI_TECNICI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="VINCOLANTE_ESPLETAMENTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="SERVZ_OPZ_PADRE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogAnag_Serv_Opz_Alternativi-input"
                                    name="LogAnag_Serv_Opz_Alternativi"
                                    tibex:xpdlId="8f6d1501-f6ba-48cf-9f63-dc64f80d293d"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Anag_Serv_Opz_AlternativiToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogAnag_Serv_Opz_AlternativiToJDBCQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
