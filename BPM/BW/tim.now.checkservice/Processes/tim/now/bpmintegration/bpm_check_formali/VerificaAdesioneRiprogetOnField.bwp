                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODIFICA_OLO_AGCOM&#xd;&#xa;FROM OLO_PROG_ONFIELD&#xd;&#xa;WHERE CODIFICA_OLO_AGCOM = ?&#xd;&#xa;&#x9;AND ? BETWEEN DATA_INIZIO_VAL AND DATA_FINE_VAL" xsi:type="jdbcPalette:JDBCQueryActivity">
