                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_SVlanCode-input"
                    name="JDBC_SVlanCode"
                    outputVariable="JDBC_SVlanCode"
                    tibex:xpdlId="957f2691-131b-4306-9846-c869dc939726" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
