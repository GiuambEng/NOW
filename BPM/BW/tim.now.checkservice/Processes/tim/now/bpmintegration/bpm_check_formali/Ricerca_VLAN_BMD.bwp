                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_SVlanCode/Record) and $Ricerca_VLAN_BMDIn/tns:Esito/tns:Codice = true()]]></bpws:condition>
