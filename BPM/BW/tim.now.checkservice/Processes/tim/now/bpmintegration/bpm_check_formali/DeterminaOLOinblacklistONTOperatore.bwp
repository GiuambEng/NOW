            <bpws:invoke inputVariable="DatiVerificaControlli-input"
                name="DatiVerificaControlli"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlli"
                partnerLink="DatiVerificaControlli"
                portType="ns5:DatiVerificaControlliPortType" tibex:xpdlId="b130a46c-8c69-49ac-a968-a82cca0dd714">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns4="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliFormali/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;&lt;tns5:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns4:DatiVerificaControlliInput&gt;&lt;tns4:Operatore&gt;&lt;xsl:value-of select="'BPM'"/&gt;&lt;/tns4:Operatore&gt;&lt;tns4:IDRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns1:IDRichiestaOLO"/&gt;&lt;/tns4:IDRichiestaOLO&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/tns4:Azione&gt;&lt;tns4:ServiziOpzionali&gt;&lt;tns4:ServizioNonValido&gt;&lt;xsl:value-of select="'SI'"/&gt;&lt;/tns4:ServizioNonValido&gt;&lt;/tns4:ServiziOpzionali&gt;&lt;/tns4:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns5:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DatiVerificaControlliInput>&#xa;            &lt;tns4:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns4:Operatore>&#xa;            &lt;tns4:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns4:IDRichiestaOLO>&#xa;            &lt;tns4:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns4:Azione>&#xa;            &lt;tns4:ServiziOpzionali>&#xa;                &lt;tns4:ServizioNonValido>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns4:ServizioNonValido>&#xa;            &lt;/tns4:ServiziOpzionali>&#xa;        &lt;/tns4:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
