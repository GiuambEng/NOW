                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;QueryOloInBlack&quot;/>&lt;xsl:template name=&quot;LogQueryOloInBlack-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaOLOinblacklistONTOperatore&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaOLOinblacklistONTOperatore&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns3:BusinessID>&lt;/xsl:if>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryOloInBlack: &amp;quot;, tib:render-xml($QueryOloInBlack/Record[1]/VERIF_OLO_IN_BLIST, true(), true()))&quot;/>&lt;/tns3:Message>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns3:LogLevel>&lt;tns3:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns3:LogJMS>&lt;/tns3:GenericLogger>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogQueryServizio-input"
                    name="LogQueryServizio"
                    tibex:xpdlId="6142afa4-963b-44e0-a20d-9ce57aaa97cd"
