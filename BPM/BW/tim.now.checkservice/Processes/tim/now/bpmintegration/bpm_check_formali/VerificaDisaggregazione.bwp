                <bpws:link name="FindImpresaFromIDSLUCOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="081fcf28-2a36-447d-be28-4ff5666296bd"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogInput"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="1b2c9dcf-39da-4c91-aed6-f0eb505e880d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindImpresaFromIDULLCO&quot;/>&#xa;    &lt;xsl:param name=&quot;FindImpresaFromIDSLUCO&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaDisaggregazione_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($FindImpresaFromIDULLCO/Record)>0 or count($FindImpresaFromIDSLUCO/Record)>0&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Controllo Fallito - Recuperata ID IMPRESA con i Dati in input'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun ID IMPRESA Recuperato'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:VerificaDisaggregazione_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="4a581c8e-f472-4782-b89f-c69871bb4e68"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToFindImpresaFromIDULLCO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:IDULLCO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:IDULLCO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToFindImpresaFromIDSLUCO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:IDSLUCO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:IDSLUCO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToLogOuput">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaDisaggregazione'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaDisaggregazione'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input Ricevuto Verifica Disaggregazione :', tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
