            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogInput" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOuputToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToFindImpresaFromIDULLCO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogInputToFindImpresaFromIDSLUCO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogInputToLogOuput" tibex:linkType="SUCCESSWITHNOCONDITION"/>
