            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FindImpresaFromIDULLCO-input"
                    name="FindImpresaFromIDULLCO"
                    outputVariable="FindImpresaFromIDULLCO"
                    tibex:xpdlId="61394948-0439-4a71-ac53-af25c49050d0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToFindImpresaFromIDULLCO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindImpresaFromIDULLCOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+61394948-0439-4a71-ac53-af25c49050d0+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindImpresaFromIDULLCO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DATAINVIORICH1>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH1>&lt;DATAINVIORICH2>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH2>&lt;DATAINVIORICH3>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH3>&lt;IDULLCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDULLCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDULLCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDULLCO>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLOAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;DATAINVIORICH>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_IMPRESA FROM DEL321_ASS_OLO_IMP_AREADICANT WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND ID_AREA_DI_CANT IN (&#xd;&#xa;select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_AREA_DI_CENTR in(&#xd;&#xa;select ID_AREA_DI_CENTR from DEL321_CLLI WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND CLLI IN &#xd;&#xa;  (SELECT CLLI FROM CLC_IDULLCO WHERE IDULLCO=?)))&#xd;&#xa;  AND COD_OLO_AGCOM=? AND TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH3"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDULLCO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_IMPRESA"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FindImpresaFromIDSLUCO-input"
                    name="FindImpresaFromIDSLUCO"
                    outputVariable="FindImpresaFromIDSLUCO"
                    tibex:xpdlId="bda2a365-1685-4580-9443-b8feb39d4a00" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToFindImpresaFromIDSLUCO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindImpresaFromIDSLUCOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bda2a365-1685-4580-9443-b8feb39d4a00+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindImpresaFromIDSLUCO-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;DATAINVIORICH1>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH1>&lt;DATAINVIORICH2>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH2>&lt;DATAINVIORICH3>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH3>&lt;IDSLUCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IDSLUCO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IDSLUCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDSLUCO>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLOAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;DATAINVIORICH>&lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:DataInvioRichiesta), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/DATAINVIORICH>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_IMPRESA FROM DEL321_ASS_OLO_IMP_AREADICANT WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV AND ID_AREA_DI_CANT IN (&#xa;select ID_AREA_DI_CANT from DEL321_AREA_DI_CENTR WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND ID_AREA_DI_CENTR in(&#xa;select ID_AREA_DI_CENTR from DEL321_CLLI WHERE TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID AND DATA_FINE_VALID AND CLLI IN &#xa;  (select COD_CLLI_CENTRALE from CLC_IDSLUCO WHERE IDSLUCO=?)))&#xa;  AND COD_OLO_AGCOM=? AND TO_DATE(?, 'YYYY-MM-DD') BETWEEN DATA_INIZ_VALID_PRV AND DATA_FINE_VALID_PRV " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH3"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDSLUCO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATAINVIORICH"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_IMPRESA"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogResult-input"
                    name="LogResult"
                    tibex:xpdlId="a2d1233c-4a64-4f2c-8e78-0e08a8640b89"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindImpresaFromIDSLUCOToCallProcess"/>
                        <bpws:target linkName="FindImpresaFromIDULLCOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FindImpresaFromIDULLCO&quot;/>&#xa;    &lt;xsl:param name=&quot;FindImpresaFromIDSLUCO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogResult-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaDisaggregazione'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaDisaggregazione'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($FindImpresaFromIDULLCO/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato recuperato per IDULLCO', tib:render-xml($FindImpresaFromIDULLCO, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($FindImpresaFromIDSLUCO/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato recuperato per IDULLCO', tib:render-xml($FindImpresaFromIDSLUCO, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun ID IMPRESA recuperato'&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns6:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="37ffff21-0f4f-4148-9533-99fe10182202">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;'PARAMETRO IDULLCO or IDSLUCO IN INPUT MANCANTE'&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;'FAULT - MISSING INPUT PARAMETERS'&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns3:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOuputToEnd"/>
                </bpws:targets>
            </bpws:throw>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
