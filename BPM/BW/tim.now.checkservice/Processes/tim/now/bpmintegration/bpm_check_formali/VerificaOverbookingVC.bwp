                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+181a4b6d-d1a8-426b-8380-a60957b3add6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VerificaOverbookingVCIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input1&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_PRFL_VC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaOverbookingVCIn/parameters/tns1:VerificaOverbookingVC_Request/tns1:ConsistenzaDatiVc[number($index)]/tns1:IdProfiloVC)&quot;>&lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns1:VerificaOverbookingVC_Request/tns1:ConsistenzaDatiVc[number($index)]/tns1:IdProfiloVC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PRFL_VC>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectprofiloVC-input"
