                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaOverbookingVCIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectprofiloVC&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaOverbookingVC_Request>&#xa;            &lt;tns:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns:IDRichiestaOLO>&#xa;            &lt;tns:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:Offerta&quot;/>&#xa;            &lt;/tns:Offerta>&#xa;            &lt;tns:ProfiloTecnicoLinea>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ProfiloTecnicoLinea&quot;/>&#xa;            &lt;/tns:ProfiloTecnicoLinea>&#xa;            &lt;xsl:copy-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:DatiVc&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$SelectprofiloVC/Record&quot;>&#xa;                &lt;tns:ConsistenzaDatiVc>&#xa;                    &lt;tns:IdProfiloVC>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:DatiVc[number($index)]/tns:IdProfiloVC&quot;/>&#xa;                    &lt;/tns:IdProfiloVC>&#xa;                    &lt;xsl:if test=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:ProfiloVC&quot;>&#xa;                        &lt;tns:ProfiloVC>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:ProfiloVC&quot;/>&#xa;                        &lt;/tns:ProfiloVC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:TipologiaProfilo&quot;>&#xa;                        &lt;tns:TipologiaProfilo>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:TipologiaProfilo&quot;/>&#xa;                        &lt;/tns:TipologiaProfilo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:Azione&quot;>&#xa;                        &lt;tns:Azione>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:Azione&quot;/>&#xa;                        &lt;/tns:Azione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;MCR_DOWN&quot;>&#xa;                        &lt;tns:MCRDown>&#xa;                            &lt;xsl:value-of select=&quot;MCR_DOWN&quot;/>&#xa;                        &lt;/tns:MCRDown>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;MCR_UP&quot;>&#xa;                        &lt;tns:MCRUp>&#xa;                            &lt;xsl:value-of select=&quot;MCR_UP&quot;/>&#xa;                        &lt;/tns:MCRUp>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;SCR_DOWN&quot;>&#xa;                        &lt;tns:SCRDown>&#xa;                            &lt;xsl:value-of select=&quot;SCR_DOWN&quot;/>&#xa;                        &lt;/tns:SCRDown>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;SCR_UP&quot;>&#xa;                        &lt;tns:SCRUp>&#xa;                            &lt;xsl:value-of select=&quot;SCR_UP&quot;/>&#xa;                        &lt;/tns:SCRUp>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;PCR_DOWN&quot;>&#xa;                        &lt;tns:PCRDown>&#xa;                            &lt;xsl:value-of select=&quot;PCR_DOWN&quot;/>&#xa;                        &lt;/tns:PCRDown>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;PCR_UP&quot;>&#xa;                        &lt;tns:PCRUp>&#xa;                            &lt;xsl:value-of select=&quot;PCR_UP&quot;/>&#xa;                        &lt;/tns:PCRUp>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:VPI&quot;>&#xa;                        &lt;tns:VPI>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:VPI&quot;/>&#xa;                        &lt;/tns:VPI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:VCI&quot;>&#xa;                        &lt;tns:VCI>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaOverbookingVCIn/parameters/tns:VerificaOverbookingVC_Request/tns:ConsistenzaDatiVc[number($index)]/tns:VCI&quot;/>&#xa;                        &lt;/tns:VCI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:ConsistenzaDatiVc>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:VerificaOverbookingVC_Request>&#xa;    &lt;/xsl:template>