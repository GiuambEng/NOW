            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SumVc&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaOverbookingVC_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$SumVc/tns:SumUp&amp;lt;(10*$JDBCQuery/Record[1]/VELOCITA_AGGANCIO_UP_MIN) and $SumVc/tns:SumDown&amp;lt;(10*$JDBCQuery/Record[1]/VELOCITA_AGGANCIO_DOWN_MIN)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaOverbookingVC_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
