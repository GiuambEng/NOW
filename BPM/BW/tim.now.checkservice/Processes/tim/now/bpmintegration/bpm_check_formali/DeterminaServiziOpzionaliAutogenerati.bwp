                portType="ns2:DatiVerificaControlliPortType" tibex:xpdlId="5d17e8f8-f9ed-4db2-b3c1-5f6c57375a54">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliFormali/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/BPM_CheckUtil" version="2.0"&gt;&lt;xsl:param name="Set_Response"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="RecuperaServizioOpzionale"/&gt;&lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;&lt;tns3:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns1:DatiVerificaControlliInput&gt;&lt;tns1:Operatore&gt;&lt;xsl:value-of select="'BPM'"/&gt;&lt;/tns1:Operatore&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:IdRichiesta"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/tns1:Azione&gt;&lt;xsl:for-each select="$RecuperaServizioOpzionale/tns4:RecuperaServizioOpzionale"&gt;&lt;tns1:ServiziOpzionali&gt;&lt;xsl:if test="tns4:CodiceServizio"&gt;&lt;tns1:CodiceServizio&gt;&lt;xsl:value-of select="tns4:CodiceServizio"/&gt;&lt;/tns1:CodiceServizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:DescrizioneServizio"&gt;&lt;tns1:DescrizioneServizio&gt;&lt;xsl:value-of select="tns4:DescrizioneServizio"/&gt;&lt;/tns1:DescrizioneServizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:DatiTecnici"&gt;&lt;tns1:DatiTecnici&gt;&lt;xsl:value-of select="tns4:DatiTecnici"/&gt;&lt;/tns1:DatiTecnici&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:VincolantePerEspletamento"&gt;&lt;tns1:VincolantePerEspletamento&gt;&lt;xsl:value-of select="tns4:VincolantePerEspletamento"/&gt;&lt;/tns1:VincolantePerEspletamento&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:ProdottoCatalogo"&gt;&lt;tns1:ProdottoCatalogo&gt;&lt;xsl:value-of select="tns4:ProdottoCatalogo"/&gt;&lt;/tns1:ProdottoCatalogo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:CodiceServizioPadre"&gt;&lt;tns1:CodiceServizioPadre&gt;&lt;xsl:value-of select="tns4:CodiceServizioPadre"/&gt;&lt;/tns1:CodiceServizioPadre&gt;&lt;/xsl:if&gt;&lt;/tns1:ServiziOpzionali&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$Set_Response/tns:ServiziOpz"&gt;&lt;tns1:ServiziOpzionali&gt;&lt;xsl:if test="tns:CodiceServizio"&gt;&lt;tns1:CodiceServizio&gt;&lt;xsl:value-of select="tns:CodiceServizio"/&gt;&lt;/tns1:CodiceServizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:DescrizioneServizio"&gt;&lt;tns1:DescrizioneServizio&gt;&lt;xsl:value-of select="tns:DescrizioneServizio"/&gt;&lt;/tns1:DescrizioneServizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:DatiTecnici"&gt;&lt;tns1:DatiTecnici&gt;&lt;xsl:value-of select="tns:DatiTecnici"/&gt;&lt;/tns1:DatiTecnici&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:VincolantePerEspletamento"&gt;&lt;tns1:VincolantePerEspletamento&gt;&lt;xsl:value-of select="tns:VincolantePerEspletamento"/&gt;&lt;/tns1:VincolantePerEspletamento&gt;&lt;/xsl:if&gt;&lt;/tns1:ServiziOpzionali&gt;&lt;/xsl:for-each&gt;&lt;/tns1:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns3:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Set_Response&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaServizioOpzionale&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;xsl:for-each select=&quot;$RecuperaServizioOpzionale/tns4:RecuperaServizioOpzionale&quot;>&#xa;                &lt;tns1:ServiziOpzionali>&#xa;                    &lt;xsl:if test=&quot;tns4:CodiceServizio&quot;>&#xa;                        &lt;tns1:CodiceServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:CodiceServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DescrizioneServizio&quot;>&#xa;                        &lt;tns1:DescrizioneServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DescrizioneServizio&quot;/>&#xa;                        &lt;/tns1:DescrizioneServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DatiTecnici&quot;>&#xa;                        &lt;tns1:DatiTecnici>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DatiTecnici&quot;/>&#xa;                        &lt;/tns1:DatiTecnici>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:VincolantePerEspletamento&quot;>&#xa;                        &lt;tns1:VincolantePerEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;tns4:VincolantePerEspletamento&quot;/>&#xa;                        &lt;/tns1:VincolantePerEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:ProdottoCatalogo&quot;>&#xa;                        &lt;tns1:ProdottoCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ProdottoCatalogo&quot;/>&#xa;                        &lt;/tns1:ProdottoCatalogo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:CodiceServizioPadre&quot;>&#xa;                        &lt;tns1:CodiceServizioPadre>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CodiceServizioPadre&quot;/>&#xa;                        &lt;/tns1:CodiceServizioPadre>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:ServiziOpzionali>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Set_Response/tns:ServiziOpz&quot;>&#xa;                &lt;tns1:ServiziOpzionali>&#xa;                    &lt;xsl:if test=&quot;tns:CodiceServizio&quot;>&#xa;                        &lt;tns1:CodiceServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:CodiceServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DescrizioneServizio&quot;>&#xa;                        &lt;tns1:DescrizioneServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns:DescrizioneServizio&quot;/>&#xa;                        &lt;/tns1:DescrizioneServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DatiTecnici&quot;>&#xa;                        &lt;tns1:DatiTecnici>&#xa;                            &lt;xsl:value-of select=&quot;tns:DatiTecnici&quot;/>&#xa;                        &lt;/tns1:DatiTecnici>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:VincolantePerEspletamento&quot;>&#xa;                        &lt;tns1:VincolantePerEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;tns:VincolantePerEspletamento&quot;/>&#xa;                        &lt;/tns1:VincolantePerEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:ServiziOpzionali>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
