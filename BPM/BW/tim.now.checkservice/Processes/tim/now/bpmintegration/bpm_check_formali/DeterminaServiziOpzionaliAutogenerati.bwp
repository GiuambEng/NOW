                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e7ca3ea9-790f-4fa3-8a7e-d8ca22535854+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperaServzOpz-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:IdRichiesta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME, PROGRS_TIPOLG_DATO, VALORE&#xa;  FROM DATI_VERIFICA_CTRLI&#xa;  WHERE ID_RICH_OLO=? AND TIPOLG_DATO='43'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="PROGRS_TIPOLG_DATO"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="VALORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperaServizioOpzionale"
                    name="RecuperaServOpz"
                    outputVariable="RecuperaServizioOpzionale"
                    tibex:xpdlId="6be062ac-f894-4651-bbbd-a1622ba7fda6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaServzOpzToAssign3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaServOpzToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaServzOpz&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaServizioOpzionale&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:RecuperaServizioOpzionale>&#xa;            &lt;xsl:for-each-group select=&quot;$RecuperaServzOpz/Record&quot; group-by=&quot;PROGRS_TIPOLG_DATO&quot;>&#xa;                &lt;xsl:variable name=&quot;var&quot; select=&quot;PROGRS_TIPOLG_DATO&quot;/>&#xa;                &lt;tns4:RecuperaServizioOpzionale>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='CODICESERVIZIO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:CodiceServizio>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='CODICESERVIZIO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:CodiceServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='DESCRIZIONESERVIZIO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:DescrizioneServizio>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='DESCRIZIONESERVIZIO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:DescrizioneServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='DATITECNICI' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:DatiTecnici>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='DATITECNICI' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:DatiTecnici>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='VINCOLANTEPERESPLETAMENTO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:VincolantePerEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='VINCOLANTEPERESPLETAMENTO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:VincolantePerEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='PRODOTTOCATALOGO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:ProdottoCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='PRODOTTOCATALOGO' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:ProdottoCatalogo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecuperaServzOpz/Record[NOME='CODICESERVIZIOPADRE' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;>&#xa;                        &lt;tns4:CodiceServizioPadre>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaServzOpz/Record[NOME='CODICESERVIZIOPADRE' and PROGRS_TIPOLG_DATO=$var]/VALORE&quot;/>&#xa;                        &lt;/tns4:CodiceServizioPadre>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:RecuperaServizioOpzionale>&#xa;            &lt;/xsl:for-each-group>&#xa;        &lt;/tns4:RecuperaServizioOpzionale>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="RecuperaServizioOpzionale" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogRecuperaServOpz-input"
                    name="LogRecuperaServOpz"
                    tibex:xpdlId="a0b954eb-59d6-436c-ba6d-ed8d59518cea"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaServOpzToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToDatiVerificaControlli"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaServizioOpzionale&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRecuperaServOpz-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'DeterminaServiziOpzionaliAutogenerati'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Recuperati seguenti servizi opzionali dalla dati verifica controlli: ',tib:render-xml($RecuperaServizioOpzionale))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="4980390c-ff43-4d3f-94f3-d529b92bc0b0">
                <bpws:targets>
                    <bpws:target linkName="AssignToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToGenericLogger"/>
                </bpws:sources>
                <bpws:forEach counterName="index" name="iterate"
                    parallel="no" tibex:group="iterate">
                    <tibex:DesignExpression name="variableList">
                        <tibex:expression
                            expression="$Start/ns0:CodiciServizio" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns0:CodiciServizio)]]></bpws:finalCounterValue>
                    <bpws:scope name="innerScope">
                        <bpws:variables>
                            <bpws:variable
                                element="ns0:Iterate_Current_Element_CodiciServizio"
                                name="currentElement" sca-bpel:internal="true"/>
                        </bpws:variables>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign3ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:assign name="GroupStart"
                                tibex:group="groupStart"
                                tibex:xpdlId="9811a105-423f-4911-8bcb-e76d94f04afc" validate="no">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign3"/>
                                </bpws:sources>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:CodiciServizio)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="5d2f380e-50c9-408c-bec8-43fde15aa483">
                                <bpws:targets>
                                    <bpws:target linkName="Assign3ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Set_Response"
                                    name="EliminaCodSrvzPadre"
                                    outputVariable="Set_Response"
                                    tibex:xpdlId="d3a542a2-232f-4292-b9c2-78cd04f3fad6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign3ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;Set_Response&quot;/>&lt;xsl:template name=&quot;Set_Response&quot; match=&quot;/&quot;>&lt;tns:DeterminaServiziOpzionaliAutogenerati_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:for-each select=&quot;$Set_Response/tns:ServiziOpz[not(tns:CodiceServizio=$currentElement/tns:CodiceServizioPadre)]&quot;>&lt;tns:ServiziOpz>&lt;xsl:if test=&quot;tns:CodiceServizio&quot;>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&lt;/tns:CodiceServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DescrizioneServizio&quot;>&lt;tns:DescrizioneServizio>&lt;xsl:value-of select=&quot;tns:DescrizioneServizio&quot;/>&lt;/tns:DescrizioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DatiTecnici&quot;>&lt;tns:DatiTecnici>&lt;xsl:value-of select=&quot;tns:DatiTecnici&quot;/>&lt;/tns:DatiTecnici>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:VincolantePerEspletamento&quot;>&lt;tns:VincolantePerEspletamento>&lt;xsl:value-of select=&quot;tns:VincolantePerEspletamento&quot;/>&lt;/tns:VincolantePerEspletamento>&lt;/xsl:if>&lt;/tns:ServiziOpz>&lt;/xsl:for-each>&lt;/tns:DeterminaServiziOpzionaliAutogenerati_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Set_Response" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Set_Response"
                    name="InizCodiciSrvz" outputVariable="Set_Response"
                    tibex:xpdlId="4fa82ac6-0760-442e-bbb7-ad8718cc2fbd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAnagServzOpzAutoToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AnagServzOpzAuto&quot;/>&lt;xsl:template name=&quot;Set_Response&quot; match=&quot;/&quot;>&lt;tns:DeterminaServiziOpzionaliAutogenerati_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:for-each select=&quot;$AnagServzOpzAuto/Record&quot;>&lt;tns:ServiziOpz>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;COD_ANAG_SERVZ_OPZ&quot;/>&lt;/tns:CodiceServizio>&lt;tns:DescrizioneServizio>&lt;xsl:value-of select=&quot;DESCR_ANAG_SERVZ_OPZ&quot;/>&lt;/tns:DescrizioneServizio>&lt;xsl:if test=&quot;DATI_TECNICI&quot;>&lt;tns:DatiTecnici>&lt;xsl:value-of select=&quot;DATI_TECNICI&quot;/>&lt;/tns:DatiTecnici>&lt;/xsl:if>&lt;xsl:if test=&quot;VINCOLANTE_ESPL&quot;>&lt;tns:VincolantePerEspletamento>&lt;xsl:value-of select=&quot;VINCOLANTE_ESPL&quot;/>&lt;/tns:VincolantePerEspletamento>&lt;/xsl:if>&lt;/tns:ServiziOpz>&lt;/xsl:for-each>&lt;/tns:DeterminaServiziOpzionaliAutogenerati_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Set_Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCodSrvz-input"
                    name="LogCodSrvz"
                    tibex:xpdlId="0e88beee-bb70-473f-ae43-5947ebdeda77"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToRecuperaServzOpz"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Set_Response&quot;/>&lt;xsl:template name=&quot;LogCodSrvz-input&quot; match=&quot;/&quot;>&lt;tns5:CW_BUS_MESSAGE>&lt;tns5:GenericLogger>&lt;tns5:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns5:Application>&lt;tns5:Process>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns5:Process>&lt;tns5:Service>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns5:Service>&lt;tns5:Operation>&lt;xsl:value-of select=&quot;'DeterminaServiziOpzionaliAutogenerati'&quot;/>&lt;/tns5:Operation>&lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&lt;tns5:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns5:BusinessID>&lt;/xsl:if>&lt;tns5:Message>&lt;xsl:value-of select=&quot;concat('Servizi opzionali in output dopo filtro per codici servizio padre: ',tib:render-xml($Set_Response))&quot;/>&lt;/tns5:Message>&lt;tns5:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns5:LoggerName>&lt;tns5:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns5:LogLevel>&lt;tns5:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns5:LogJMS>&lt;/tns5:GenericLogger>&lt;/tns5:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
