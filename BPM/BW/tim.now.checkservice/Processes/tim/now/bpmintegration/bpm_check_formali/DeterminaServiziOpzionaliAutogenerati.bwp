                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OPZ.COD_ANAG_SERVZ_OPZ, OPZ.DESCR_ANAG_SERVZ_OPZ, AUT.DATI_TECNICI, AUT.VINCOLANTE_ESPL&#xa;FROM ANAG_SERVZ_OPZIONALI_AUTO AUT, ANAG_SERVZ_OPZIONALE OPZ&#xa;WHERE AUT.ID_ANAG_SERVZ_OPZ=OPZ.ID_ANAG_SERVZ_OPZ &#xa;AND AUT.ID_OFFERTA=(SELECT ID_OFFERTA FROM TRASCODFC_OFFERTA WHERE NOME_OFFERTA_ESTERNA=? AND PROVENIENZA='BPM')&#xa;AND (AUT.CODIFICA_OLO_AGCOM=? OR AUT.CODIFICA_OLO_AGCOM='*')&#xa;AND (AUT.COD_PROGETTO=? OR AUT.COD_PROGETTO='*')&#xa;AND SYSDATE BETWEEN AUT.DATA_INIZIO_VAL AND AUT.DATA_FINE_VAL" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROGETTO"/>
                                    <columnMetadata
                                    columnName="COD_ANAG_SERVZ_OPZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_ANAG_SERVZ_OPZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATI_TECNICI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VINCOLANTE_ESPL"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAnagServzOpzAuto-input"
                    name="LogAnagServzOpzAuto"
                    tibex:xpdlId="a5e165c2-7f6f-4ca5-959f-50a0e622b469"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AnagServzOpzAutoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogAnagServzOpzAutoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Lavorazione = &quot;ATTIVAZIONE&quot; and ($Start/ns0:Offerta = &quot;VULAFTTH&quot; or $Start/ns0:Offerta = &quot;BITSTREAMNGAFTTH&quot; or $Start/ns0:Offerta = &quot;EASYIPNGAFTTH&quot; or $Start/ns0:Offerta = &quot;SEMIVULAFTTH&quot; or $Start/ns0:Offerta = &quot;SEMIBITSTREAMNGAFTTH&quot; or $Start/ns0:Offerta = &quot;SEMIEASYIPNGAFTTH&quot; or $Start/ns0:Offerta = &quot;UBBSEMIGPON&quot; or $Start/ns0:Offerta = &quot;UBBFULLGPON&quot; or $Start/ns0:Offerta = &quot;FULLGPONPLUS&quot; or $Start/ns0:Offerta = &quot;FULLGPONPLUSNGA&quot; or $Start/ns0:Offerta = &quot;SEMIGPON1BPNRR&quot; or $Start/ns0:Offerta = &quot;FULLGPON1BPNRR&quot;) and $Start/ns0:ProdottoCatalogo='SI' and count($Start/ns0:CodiciServizio)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Lavorazione = "ATTIVAZIONE" and ($Start/ns0:Offerta = "VULAFTTH" or $Start/ns0:Offerta = "BITSTREAMNGAFTTH" or $Start/ns0:Offerta = "EASYIPNGAFTTH" or $Start/ns0:Offerta = "SEMIVULAFTTH" or $Start/ns0:Offerta = "SEMIBITSTREAMNGAFTTH" or $Start/ns0:Offerta = "SEMIEASYIPNGAFTTH" or $Start/ns0:Offerta = "UBBSEMIGPON" or $Start/ns0:Offerta = "UBBFULLGPON" or $Start/ns0:Offerta = "FULLGPONPLUS" or $Start/ns0:Offerta = "FULLGPONPLUSNGA" or $Start/ns0:Offerta = "SEMIGPON1BPNRR" or $Start/ns0:Offerta = "FULLGPON1BPNRR") and $Start/ns0:ProdottoCatalogo='SI' and count($Start/ns0:CodiciServizio)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogAnagServzOpzAutoToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagServzOpzAuto&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAnagServzOpzAuto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'DeterminaServiziOpzionaliAutogenerati'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Output query AnagServzOpzAuto: ',tib:render-xml($AnagServzOpzAuto))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
