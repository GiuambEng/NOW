    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToOscuramento" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToDatiVerificaControlli" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DatiVerificaControlliToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Assign1ToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
