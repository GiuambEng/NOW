t;/tns3:descOperatoreSecondario&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$QueryOlo/Record[1]/NOME"&gt;&lt;tns3:descOperatoreSecondario&gt;&lt;xsl:value-of select="$QueryOlo/Record[1]/NOME"/&gt;&lt;/tns3:descOperatoreSecondario&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns3:LavorazioneRichiesta&gt;&lt;/tns3:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns4:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryCosSI&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryCosNO&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DatiVerificaControlliInput>&#xa;            &lt;tns3:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns3:Operatore>&#xa;            &lt;tns3:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns3:IDRichiestaOLO>&#xa;            &lt;tns3:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns3:Azione>&#xa;            &lt;tns3:LavorazioneRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($QueryCosSI/Record[1]/OPERATORE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:CodiceOperatoreSecondario&quot;>&#xa;                            &lt;tns3:codOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOperatoreSecondario&quot;/>&#xa;                            &lt;/tns3:codOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:codOloAgcom&quot;>&#xa;                            &lt;tns3:codOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&#xa;                            &lt;/tns3:codOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($QueryCosSI/Record[1]/OPERATORE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCosSI/Record[1]/OPERATORE&quot;>&#xa;                            &lt;tns3:descOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCosSI/Record[1]/OPERATORE&quot;/>&#xa;                            &lt;/tns3:descOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($QueryCosNO/Record[1]/OPERATORE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCosNO/Record[1]/OPERATORE&quot;>&#xa;                            &lt;tns3:descOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCosNO/Record[1]/OPERATORE&quot;/>&#xa;                            &lt;/tns3:descOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$QueryOlo/Record[1]/NOME&quot;>&#xa;                            &lt;tns3:descOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$QueryOlo/Record[1]/NOME&quot;/>&#xa;                            &lt;/tns3:descOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns3:LavorazioneRichiesta>&#xa;        &lt;/tns3:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToDatiVerificaControlli"/>
                    <bpws:target linkName="CallProcessToDatiVerificaControlli1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQueryCosSI-input"
                    name="LogQueryCosSI"
                    tibex:xpdlId="b75cb57f-2be6-43aa-a696-748a755ecf33"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryCosSIToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToDatiVerificaControlli">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryCosSI/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($QueryCosSI/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryCosSI&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogQueryCosSI-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCongruenzaCodiceOperatoreSecondario&amp;quot;&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;'VerificaCongruenzaCodiceOperatoreSecondario'&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('Output QueryCosSI:  ',tib:render-xml($QueryCosSI))&quot;/>&lt;/tns8:Message>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQueryCosNO-input"
                    name="LogQueryCosNO"
                    tibex:xpdlId="0fb0e460-d51d-4651-89b8-2bcb020bf7e4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToLogQueryCosNO"/>
                        <bpws:target linkName="QueryCosNOToLogQueryCosNO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd2"
                            tibex:faultDetailsVar="QueryCosNO" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToDatiVerificaControlli1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryCosNO/Record)>0 or count($QueryOlo/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($QueryCosNO/Record)>0 or count($QueryOlo/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryCosNO&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;QueryOlo&quot;/>&lt;xsl:template name=&quot;LogQueryCosNO-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCongruenzaCodiceOperatoreSecondario&amp;quot;&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;'VerificaCongruenzaCodiceOperatoreSecondario'&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($QueryCosNO/Record[1]/OPERATORE)>0&quot;>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('Output QueryCosNO: ',tib:render-xml($QueryCosNO))&quot;/>&lt;/tns8:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('Output QueryOlo: ',tib:render-xml($QueryOlo))&quot;/>&lt;/tns8:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="QueryOlo-input"
                    name="QueryOlo" outputVariable="QueryOlo"
                    tibex:xpdlId="18c36841-0382-4ec9-b7bf-cda387bf4050" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryCosNOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLogQueryCosNO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+18c36841-0382-4ec9-b7bf-cda387bf4050+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryOlo-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME&#xa;FROM OLO&#xa;WHERE codfc_olo_agcom=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
