                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryCosNO&quot;/>&lt;xsl:param name=&quot;QueryCosSI&quot;/>&lt;xsl:param name=&quot;QueryOlo&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryOscuramento/Record/FLAG_OSCURMENTO) !=0&quot;>&lt;tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($Start/tns1:CodiceOperatoreSecondario)>0 and count($QueryCosSI/Record)>0) or (string-length($Start/tns1:CodiceOperatoreSecondario)=0 and count($QueryCosNO/Record)>0)&quot;>&lt;tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryCosSI/Record)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:CodiceOperatoreSecondario&quot;>&lt;tns1:codOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOperatoreSecondario&quot;/>&lt;/tns1:codOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:codOloAgcom&quot;>&lt;tns1:codOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&lt;/tns1:codOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($QueryCosSI/Record[1]/OPERATORE)>0&quot;>&lt;xsl:if test=&quot;$QueryCosSI/Record[1]/OPERATORE&quot;>&lt;tns1:descOperatoreSecondario>&lt;xsl:value-of select=&quot;$QueryCosSI/Record[1]/OPERATORE&quot;/>&lt;/tns1:descOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($QueryCosNO/Record[1]/OPERATORE)>0&quot;>&lt;xsl:if test=&quot;$QueryCosNO/Record[1]/OPERATORE&quot;>&lt;tns1:descOperatoreSecondario>&lt;xsl:value-of select=&quot;$QueryCosNO/Record[1]/OPERATORE&quot;/>&lt;/tns1:descOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$QueryOlo/Record[1]/NOME&quot;>&lt;tns1:descOperatoreSecondario>&lt;xsl:value-of select=&quot;$QueryOlo/Record[1]/NOME&quot;/>&lt;/tns1:descOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:CodiceOperatoreSecondario)=0 and count($QueryCosNO/Record)=0 and count($QueryOlo/Record)>0&quot;>&lt;tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;xsl:if test=&quot;$Start/tns1:codOloAgcom&quot;>&lt;tns1:codOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&lt;/tns1:codOperatoreSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;$QueryOlo/Record[1]/NOME&quot;>&lt;tns1:descOperatoreSecondario>&lt;xsl:value-of select=&quot;$QueryOlo/Record[1]/NOME&quot;/>&lt;/tns1:descOperatoreSecondario>&lt;/xsl:if>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:VerificaCongruenzaCodiceOperatoreSecondario_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
