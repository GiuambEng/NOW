            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="20cf993f-dec9-4482-99f4-e69f03a51275"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery_BPM">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:IDRichiestaOLO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:IDRichiestaOLO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToJDBCQuery1_GUI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCoppiaIDVLANOLOCVLAN'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaCoppiaIDVLANOLOCVLAN: ',tib:render-xml($Start))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="74fdc2fa-4304-44fb-8183-184f97989df0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery_BPM"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToJDBCQuery2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+74fdc2fa-4304-44fb-8183-184f97989df0+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRICHIESTAOLO>&lt;CODOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODOLOAGCOM>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;IDVLANOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:idVlanOlo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:idVlanOlo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDVLANOLO>&lt;CVLANID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:cvlanId)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:cvlanId&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CVLANID>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT count (*)&#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA R,&#xa;     APPUSER.BDS_1_CASEDATA_ORDINE O,&#xa;     APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DETTAGLIOORDINE,&#xa;     APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE,&#xa;     APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE2&#xa;WHERE R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;AND R.IDRICHIESTAOLO != ?&#xa;AND R.CODIFICAOLOAGCOM = ?&#xa;AND O.BDS_ID = DETTAGLIOORDINE.ORDINE_DETTAGLIOORDINE_BDSID&#xa;AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE2.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;AND R.STATORICHIESTANOW NOT IN ('SCARTATO','ESPLETAMENTOTECNICOKO','ANNULLATO','CHIUSO','FATTURAZIONEKO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE')&#xa;AND O.OFFERTA = ?&#xa;AND R.LAVORAZIONE = 'ATTIVAZIONE'&#xa;AND DETTAGLIOORDINE.NOMECOMPONENTE = 'ACCESSOFWAITALIA1GIGA'&#xa;AND ATTRIBUTOORDINE.NOMEATTRIBUTO = 'IDVLANOLO'&#xa;AND ATTRIBUTOORDINE2.NOMEATTRIBUTO = 'CVLANID'&#xa;AND ATTRIBUTOORDINE.VALOREATTRIBUTO = ? &#xa;AND ATTRIBUTOORDINE2.VALOREATTRIBUTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDVLANOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CVLANID"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COUNT(*)"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="5a5d848a-919e-4ab7-b0e8-846c1d3891fc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToLogOutput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaCoppiaIDVLANOLOCVLAN'&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output VerificaCoppiaIDVLANOLOCVLAN: ',tib:render-xml($Variable))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="Assign" outputVariable="Variable"
                    tibex:xpdlId="f0769997-3a65-4491-84f4-644498689a81" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogOutput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery1/Record[1]/COUNT=0 and $JDBCQuery2/Record[1]/COUNT=0&quot;>&lt;tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COUNT=0 and $JDBCQuery2/Record[1]/COUNT=0&quot;>&lt;tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaCoppiaIDVLANOLOCVLAN_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Query-input"
                    name="LOG_Query"
                    tibex:xpdlId="893f5161-8fb6-4850-9baa-15463e46dca4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery2ToLOG_Query"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:template name=&quot;LOG_Query-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaIDVLANOLOCVLAN&amp;quot;&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaIDVLANOLOCVLAN&amp;quot;&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record/COUNT!=0 or $JDBCQuery2/Record[1]/COUNT!=0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_Ordini_Output: &amp;quot;, xsd:string($JDBCQuery/Record[1]/COUNT), &amp;quot; and JDBC_Asset_Output:&amp;quot;,xsd:string($JDBCQuery2/Record[1]/COUNT))&quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery1/Record/COUNT!=0 or $JDBCQuery2/Record[1]/COUNT!=0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_Ordini_Output: &amp;quot;, xsd:string($JDBCQuery1/Record[1]/COUNT), &amp;quot; and JDBC_Asset_Output:&amp;quot;,xsd:string($JDBCQuery2/Record[1]/COUNT))&quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Message>&lt;xsl:value-of select=&quot;&amp;quot;JDBC_Count non ha trovato record.&amp;quot;&quot;/>&lt;/tns2:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;tns2:ActiveLoggerServices>&lt;tns2:Envelope>&lt;tns2:Identifier>&lt;tns2:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&lt;/tns2:ServiceName>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaCoppiaIDVLANOLOCVLAN'&quot;/>&lt;/tns2:Operation>&lt;tns2:Source>&lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&lt;/tns2:Source>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;tns2:EventType>&lt;xsl:value-of select=&quot;'VerificaCoppiaIDVLANOLOCVLAN_SUB-PROCESS'&quot;/>&lt;/tns2:EventType>&lt;tns2:trackID>&lt;xsl:value-of select=&quot;concat('VerificaCoppiaIDVLANOLOCVLAN_', $Start/tns:IDRichiestaOLO )&quot;/>&lt;/tns2:trackID>&lt;/tns2:Identifier>&lt;tns2:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns2:track_position>&lt;tns2:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:Timestamp>&lt;/tns2:Envelope>&lt;/tns2:ActiveLoggerServices>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQuery1-input" name="JDBCQuery1"
                    outputVariable="JDBCQuery1"
                    tibex:xpdlId="c9198957-7db9-4960-ac30-cd483df3ce78" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery1_GUI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToLOG_Query"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c9198957-7db9-4960-ac30-cd483df3ce78+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns4:jdbcQueryActivityInput>&lt;CODOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODOLOAGCOM>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;IDVLANOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:idVlanOlo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:idVlanOlo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDVLANOLO>&lt;CVLANID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:cvlanId)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:cvlanId&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CVLANID>&lt;/tns4:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT count (*)&#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA R,&#xa;     APPUSER.BDS_1_CASEDATA_ORDINE O,&#xa;     APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DETTAGLIOORDINE,&#xa;     APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE,&#xa;     APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE2&#xa;WHERE R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;AND R.CODIFICAOLOAGCOM = ?&#xa;AND O.BDS_ID = DETTAGLIOORDINE.ORDINE_DETTAGLIOORDINE_BDSID&#xa;AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE2.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;AND R.STATORICHIESTANOW NOT IN ('SCARTATO','ESPLETAMENTOTECNICOKO','ANNULLATO','CHIUSO','FATTURAZIONEKO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE')&#xa;AND O.OFFERTA = ?&#xa;AND R.LAVORAZIONE = 'ATTIVAZIONE'&#xa;AND DETTAGLIOORDINE.NOMECOMPONENTE = 'ACCESSOFWAITALIA1GIGA'&#xa;AND ATTRIBUTOORDINE.NOMEATTRIBUTO = 'IDVLANOLO'&#xa;AND ATTRIBUTOORDINE2.NOMEATTRIBUTO = 'CVLANID'&#xa;AND ATTRIBUTOORDINE.VALOREATTRIBUTO = ? &#xa;AND ATTRIBUTOORDINE2.VALOREATTRIBUTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDVLANOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CVLANID"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COUNT(*)"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQuery2-input" name="JDBCQuery2"
                    outputVariable="JDBCQuery2"
                    tibex:xpdlId="92bbe5c8-d3f6-4039-bffa-513f7e454937" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToLOG_Query"/>
                        <bpws:target linkName="JDBCQueryToJDBCQuery2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery2ToLOG_Query"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+92bbe5c8-d3f6-4039-bffa-513f7e454937+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;CODOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODOLOAGCOM>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;IDVLANOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:idVlanOlo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:idVlanOlo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDVLANOLO>&lt;CVLANID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:cvlanId)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:cvlanId&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CVLANID>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT count(*)&#xa;FROM BDS_1_CASEDATA_ASSET ass,BDS_1_CASEDATA_DETTAGLIOASSET dett,BDS_1_CASEDATA_ATTRIBTDTTGLSST att, BDS_1_CASEDATA_ATTRIBTDTTGLSST att2&#xa;WHERE ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID &#xa;and dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID &#xa;and dett.BDS_ID=att2.DTTGLSST_TTRBTIDTTGLISST_BDSID &#xa;and ass.CODIFICAOLOAGCOM = ?&#xa;and ass.OFFERTA = ? &#xa;and ass.STATOASSET = 'ATTIVO' &#xa;and dett.nomecomponente= 'ACCESSOFWAITALIA1GIGA'&#xa;and att.NOMEATTRIBUTO = 'IDVLANOLO' &#xa;and att.VALOREATTRIBUTO= ?&#xa;and att2.NOMEATTRIBUTO = 'CVLANID' &#xa;and att2.VALOREATTRIBUTO= ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDVLANOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CVLANID"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COUNT(*)"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
