                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Esito1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DatiVerificaControlliInput>&#xa;            &lt;tns4:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns4:Operatore>&#xa;            &lt;tns4:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;            &lt;/tns4:IDRichiestaOLO>&#xa;            &lt;tns4:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns4:Azione>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:ServiziOpzionali&quot;>&#xa;                &lt;tns4:ServiziOpzionali>&#xa;                    &lt;xsl:if test=&quot;tns:CodiceServizio&quot;>&#xa;                        &lt;tns4:CodiceServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns4:CodiceServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82&quot;>&#xa;                            &lt;tns4:AmbitoDel82>&#xa;                                &lt;xsl:value-of select=&quot;$Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82&quot;/>&#xa;                            &lt;/tns4:AmbitoDel82>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist&quot;>&#xa;                            &lt;tns4:VerificaOloInBlacklist>&#xa;                                &lt;xsl:value-of select=&quot;$Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist&quot;/>&#xa;                            &lt;/tns4:VerificaOloInBlacklist>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:ServiziOpzionali>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns4:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns4="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliFormali/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Esito1"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:template name="Copy_1_DatiVerificaControlli-input" match="/"&gt;&lt;tns3:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns4:DatiVerificaControlliInput&gt;&lt;tns4:Operatore&gt;&lt;xsl:value-of select="'BPM'"/&gt;&lt;/tns4:Operatore&gt;&lt;tns4:IDRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:IdRichiesta"/&gt;&lt;/tns4:IDRichiestaOLO&gt;&lt;tns4:Azione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/tns4:Azione&gt;&lt;xsl:for-each select="$Start/tns:ServiziOpzionali"&gt;&lt;tns4:ServiziOpzionali&gt;&lt;xsl:if test="tns:CodiceServizio"&gt;&lt;tns4:CodiceServizio&gt;&lt;xsl:value-of select="tns:CodiceServizio"/&gt;&lt;/tns4:CodiceServizio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82)&gt;0"&gt;&lt;xsl:if test="$Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82"&gt;&lt;tns4:AmbitoDel82&gt;&lt;xsl:value-of select="$Esito1/tns:ServiziOpzionali[number($index)]/tns:ambitoDel82"/&gt;&lt;/tns4:AmbitoDel82&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist)&gt;0"&gt;&lt;xsl:if test="$Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist"&gt;&lt;tns4:VerificaOloInBlacklist&gt;&lt;xsl:value-of select="$Esito1/tns:ServiziOpzionali[number($index)]/tns:verificaOLOInBlacklist"/&gt;&lt;/tns4:VerificaOloInBlacklist&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/tns4:ServiziOpzionali&gt;&lt;/xsl:for-each&gt;&lt;/tns4:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns3:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="EsitoToCopy_1_DatiVerificaControlli"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Copy_1_DatiVerificaControlliToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="24f3925b-d6b3-4d26-bab4-bcb5798b84de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger_Oscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OscuramentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+24f3925b-d6b3-4d26-bab4-bcb5798b84de+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP from OSCURAMENTO_AGESP WHERE COD_AGESP IN ('R1I-19-0350','R1I-25-0151') AND FLAG_OSCURMENTO='1'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="72526960-8c91-4cf1-b15a-a63422efda46"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger_Oscurato"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('L agesp R1I-19-0350 risulta oscurato :', tib:render-xml($Oscuramento, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Esito1"
                    name="EsitoIn" outputVariable="Esito1"
                    tibex:xpdlId="4fecb1f1-b626-4e0b-9099-92af8e61988d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogInput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Esito1&quot; match=&quot;/&quot;>&lt;tns:VerificaServiziOpzionali_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaServiziOpzionali_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito1" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
