                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="03ebe1f6-95a5-42a2-bbf8-df711657a0c2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToLogInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaServiziOpzionali :', tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a8128ff4-f63f-41a7-b042-23709ab44c1f">
                <bpws:targets>
                    <bpws:target linkName="LogInputToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Start/ns0:ServiziOpzionali) and $Esito1/ns0:Esito/ns0:Codice=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Start/ns0:ServiziOpzionali) and $Esito1/ns0:Esito/ns0:Codice=true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="VerificaCodiceServizioToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogVerificaToEsito" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="GroupStartToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="EmptyToVerificaCodiceServizio" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStartToEsito" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Verifica_Id_AnagToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToEsito" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="EsitoToCopy_1_DatiVerificaControlli" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Copy_1_DatiVerificaControlliToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="6616cb16-ed94-413d-a6d4-846d595106a1">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEsito">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/ns0:ServiziOpzionali[number($index)]/ns0:CodiceServizio = 'DA DEFINIRE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:ServiziOpzionali[number($index)]/ns0:CodiceServizio = 'DA DEFINIRE']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="77255acf-7bd0-4041-8f8c-013c2b152198">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    <bpws:target linkName="Copy_1_DatiVerificaControlliToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="VerificaCodiceServizio-input"
                                    name="VerificaCodiceServizio"
                                    outputVariable="VerificaCodiceServizio"
                                    tibex:xpdlId="8d2683c6-d298-4891-abb2-8f763cba5eda" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToVerificaCodiceServizio"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaCodiceServizioToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8d2683c6-d298-4891-abb2-8f763cba5eda+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceServizio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;cod_anag_servz_opz>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/cod_anag_servz_opz>&#xa;            &lt;codfc_olo_agcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodificaOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodificaOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codfc_olo_agcom>&#xa;            &lt;nome_offerta_esterna>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/nome_offerta_esterna>&#xa;            &lt;area_di_cant>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:AreaDiCantiere)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:AreaDiCantiere&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/area_di_cant>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ass.id_servz_opz, opz.data_iniz_val, opz.data_fine_val, opz.flag_tracking, opz.AMBITO_DEL82, opz.VERIF_OLO_IN_BLIST from ass_servz_offolo_ardica ass, anag_servz_opzionale opz where ass.id_servz_opz=opz.id_anag_servz_opz &#xa;and opz.cod_anag_servz_opz=? &#xa;and ass.codfc_olo_agcom=? and ass.id_offerta in (select id_offerta&#xa;  from trascodfc_offerta where nome_offerta_esterna=? and provenienza='BPM') &#xa;and ass.id_area_di_cant in (select id_area_di_cant from del321_area_di_cant where area_di_cant=?)&#xa;and sysdate BETWEEN ass.data_iniz_val AND ass.data_fine_val" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_anag_servz_opz"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codfc_olo_agcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="nome_offerta_esterna"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="area_di_cant"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="ID_SERVZ_OPZ"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="DATA_INIZ_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="DATA_FINE_VAL"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="FLAG_TRACKING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="AMBITO_DEL82"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="VERIF_OLO_IN_BLIST"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogVerifica-input"
                                    name="LogVerifica"
                                    tibex:xpdlId="42b00efa-9f07-4ab4-9341-ce7bdc9a4c22"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaCodiceServizioToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogVerificaToEsito"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VerificaCodiceServizio&quot;/>&lt;xsl:template name=&quot;LogVerifica-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaServiziOpzionali'&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IdRichiesta&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($VerificaCodiceServizio/Record)>0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Il codice servizio : ', $Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio,' è presente in tabella')&quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Il codice servizio : ', $Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio,' non è presente in tabella')&quot;/>&lt;/tns2:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($VerificaCodiceServizio)&quot;/>&lt;/tns2:Payload>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Esito1" name="Esito"
                                    outputVariable="Esito1"
                                    tibex:xpdlId="0d33f647-6593-4059-a636-e26538c13f2e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogVerificaToEsito"/>
                                    <bpws:target linkName="GroupStartToEsito"/>
                                    <bpws:target linkName="CallProcessToEsito"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EsitoToCopy_1_DatiVerificaControlli">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Esito1/ns0:Esito/ns0:Codice=true() and count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Esito1/ns0:Esito/ns0:Codice=true() and count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 ]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;VerificaCodiceServizio&quot;/>&lt;xsl:param name=&quot;Verifica_Id_Anag&quot;/>&lt;xsl:param name=&quot;Esito1&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Esito1&quot; match=&quot;/&quot;>&lt;tns:VerificaServiziOpzionali_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio = 'DA DEFINIRE')&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;(count($VerificaCodiceServizio/Record)>0)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaCodiceServizio/Record[1]/FLAG_TRACKING='S'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date($Start/tns:DRO, xsd:date($VerificaCodiceServizio/Record[1]/DATA_INIZ_VAL))>-1 and tib:compare-date($Start/tns:DRO, xsd:date($VerificaCodiceServizio/Record[1]/DATA_FINE_VAL))&amp;lt;1&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(count($Verifica_Id_Anag/Record) > 0)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$Esito1/tns:ServiziOpzionali&quot;/>&lt;tns:ServiziOpzionali>&lt;xsl:if test=&quot;$Start/tns:ServiziOpzionali[number($index)]/tns:IdDettaglioOrdine&quot;>&lt;tns:IdDettaglioOrdine>&lt;xsl:value-of select=&quot;$Start/tns:ServiziOpzionali[number($index)]/tns:IdDettaglioOrdine&quot;/>&lt;/tns:IdDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio&quot;>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;$Start/tns:ServiziOpzionali[number($index)]/tns:CodiceServizio&quot;/>&lt;/tns:CodiceServizio>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 and string-length($VerificaCodiceServizio/Record[1]/AMBITO_DEL82)>0&quot;>&lt;xsl:if test=&quot;$VerificaCodiceServizio/Record[1]/AMBITO_DEL82&quot;>&lt;tns:ambitoDel82>&lt;xsl:value-of select=&quot;$VerificaCodiceServizio/Record[1]/AMBITO_DEL82&quot;/>&lt;/tns:ambitoDel82>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 and string-length($Verifica_Id_Anag/Record[1]/AMBITO_DEL82)>0&quot;>&lt;xsl:if test=&quot;$Verifica_Id_Anag/Record[1]/AMBITO_DEL82&quot;>&lt;tns:ambitoDel82>&lt;xsl:value-of select=&quot;$Verifica_Id_Anag/Record[1]/AMBITO_DEL82&quot;/>&lt;/tns:ambitoDel82>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 and string-length($VerificaCodiceServizio/Record[1]/VERIF_OLO_IN_BLIST)>0&quot;>&lt;xsl:if test=&quot;$VerificaCodiceServizio/Record[1]/VERIF_OLO_IN_BLIST&quot;>&lt;tns:verificaOLOInBlacklist>&lt;xsl:value-of select=&quot;$VerificaCodiceServizio/Record[1]/VERIF_OLO_IN_BLIST&quot;/>&lt;/tns:verificaOLOInBlacklist>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])=0 and string-length($Verifica_Id_Anag/Record[1]/VERIF_OLO_IN_BLIST)>0&quot;>&lt;xsl:if test=&quot;$Verifica_Id_Anag/Record[1]/VERIF_OLO_IN_BLIST&quot;>&lt;tns:verificaOLOInBlacklist>&lt;xsl:value-of select=&quot;$Verifica_Id_Anag/Record[1]/VERIF_OLO_IN_BLIST&quot;/>&lt;/tns:verificaOLOInBlacklist>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:ServiziOpzionali>&lt;/tns:VerificaServiziOpzionali_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
