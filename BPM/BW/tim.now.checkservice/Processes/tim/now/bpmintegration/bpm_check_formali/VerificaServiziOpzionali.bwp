                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:ProdottoCatalogo= "NO" or string-length($Start/ns0:ProdottoCatalogo)=0) and ($Start/ns0:ServiziOpzionali[number($index)]/ns0:CodiceServizio != 'TLC8' and $Start/ns0:ServiziOpzionali[number($index)]/ns0:CodiceServizio != 'TLC9')]]></bpws:transitionCondition>
