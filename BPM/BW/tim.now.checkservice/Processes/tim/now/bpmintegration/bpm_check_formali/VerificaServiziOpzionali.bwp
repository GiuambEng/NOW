                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAG_SERVZ_OPZ, AMBITO_DEL82, VERIF_OLO_IN_BLIST&#xa;FROM ANAG_SERVZ_OPZIONALE WHERE COD_ANAG_SERVZ_OPZ = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

