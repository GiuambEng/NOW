                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns3=&quot;http://www.example.org/SecurityCodeCalculator&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;cow&quot;/>&lt;xsl:param name=&quot;cos&quot;/>&lt;xsl:param name=&quot;codMigrazione&quot;/>&lt;xsl:param name=&quot;CalcolaCodiceSicurezza&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns1:DeterminaCodiceMigrazione_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceMigrazione_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($cow)>0 and string-length($Start/tns1:IdRisorsa)>0 and string-length($cos)>0 and string-length($CalcolaCodiceSicurezza/tns3:codSicurezza)>0&quot;>&lt;tns1:DeterminaCodiceMigrazione_Response>&lt;tns1:CodiceMigrazione>&lt;xsl:value-of select=&quot;$codMigrazione&quot;/>&lt;/tns1:CodiceMigrazione>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceMigrazione_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DeterminaCodiceMigrazione_Response>&lt;tns1:CodiceMigrazione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:CodiceMigrazione>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceMigrazione_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
