                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/SecurityCodeCalculator&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;cow&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CalcolaCodiceSicurezza-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputString>&#xa;            &lt;tns3:cow>&#xa;                &lt;xsl:value-of select=&quot;$cow&quot;/>&#xa;            &lt;/tns3:cow>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:IdRisorsa&quot;>&#xa;                &lt;tns3:cor>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsa&quot;/>&#xa;                &lt;/tns3:cor>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:InputString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
