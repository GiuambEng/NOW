                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:Lavorazione='VARIAZIONE' and $Start/tns:Offerta='BITSTREAMNGAFTTH']]></bpws:transitionCondition>
