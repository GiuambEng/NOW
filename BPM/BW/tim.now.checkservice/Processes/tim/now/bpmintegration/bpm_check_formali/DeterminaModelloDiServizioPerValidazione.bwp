                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;JDBCQueryAsset&quot;/>&lt;xsl:template name=&quot;LogQueryAsset-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaModelloDiServizioPerValidazione&amp;quot;&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaModelloDiServizioPerValidazione&amp;quot;&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQueryAsset/Record)>0&quot;>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryBitAsset: &amp;quot;, tib:render-xml($JDBCQueryAsset, true(), true()))&quot;/>&lt;/tns8:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:Message>&lt;xsl:value-of select=&quot;'QueryBitAsset record non trovato'&quot;/>&lt;/tns8:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCANAG_VLAN-input"
                    name="JDBCANAG_VLAN" outputVariable="JDBCANAG_VLAN"
                    tibex:xpdlId="c97eb627-7bc6-4ae5-91fc-5e1d1de9c66c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryAssetToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCopy_1_LogQueryAsset"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c97eb627-7bc6-4ae5-91fc-5e1d1de9c66c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryAsset&quot;/>&lt;xsl:template name=&quot;JDBCANAG_VLAN-input&quot; match=&quot;/&quot;>&lt;tns10:jdbcQueryActivityInput>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryAsset/Record[NOMEATTRIBUTO = 'SVLANCODE'][1]/VALOREATTRIBUTO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryAsset/Record[NOMEATTRIBUTO = 'SVLANCODE'][1]/VALOREATTRIBUTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/tns10:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPO_BANDA,TIPO_COS,BMC_LIGHT&#xd;&#xa;FROM ANAG_VLAN &#xd;&#xa;WHERE&#xd;&#xa;COD_VLAN=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_VLAN"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="TIPO_BANDA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="TIPO_COS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="BMC_LIGHT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogQueryANAG_VLAN-input"
                    name="LogQueryANAG_VLAN"
                    tibex:xpdlId="63a6a6d7-d59c-4acf-9f93-2a9c8457144a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
