                                    expression="exists($Start/tns:UserVlan[tns:flagMulticast='SI'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($Start/tns:UserVlan[tns:flagMulticast='SI'])]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogQueryANAG_VLANToQueryBitNO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
