                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="066b092a-4381-4e5f-99c4-bdcd1579fcfa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DatiVerificaControlliToEnd"/>
                        <bpws:target linkName="Copy_1_AssignToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Variable&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="65cf4c03-9e2a-4418-b894-4d1d2619d082"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaModelloDiServizioPerValidazione&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaModelloDiServizioPerValidazione&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns8:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns8:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;DeterminaModelloDiServizioPerValidazione Input: &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryOscuramento-input"
                    name="QueryOscuramento"
                    outputVariable="QueryOscuramento"
                    tibex:xpdlId="c355e12b-9e2a-47ec-bff4-8db1a3fdd11d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c355e12b-9e2a-47ec-bff4-8db1a3fdd11d+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  SELECT FLAG_OSCURMENTO FROM OSCURAMENTO_AGESP WHERE COD_AGESP='R1I-25-0151' AND FLAG_OSCURMENTO in ('Y','1')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="90884f22-9593-41e7-9d11-c77cd3ead29f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:codOloAgcom='TLC' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:codOloAgcom='TLC' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 ]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta='EASYIPNGAFTTH' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta='EASYIPNGAFTTH' and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 ]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta=('VULAFTTH','SEMIVULAFTTH') and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta=('VULAFTTH','SEMIVULAFTTH') and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 ]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta=('BITSTREAMNGAFTTH') and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:codOloAgcom!='TLC' and $Start/tns:Offerta=('BITSTREAMNGAFTTH') and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0 ]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToCopy_1_Assign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;'DeterminaModelloDiServizioPerValidazione'&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('Output query oscuramento ',tib:render-xml($QueryOscuramento))&quot;/>&lt;/tns8:Message>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DatiVerificaControlli-input"
                name="DatiVerificaControlli"
