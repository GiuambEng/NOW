            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryAsset-input"
                    name="JDBCQueryAsset"
                    outputVariable="JDBCQueryAsset"
                    tibex:xpdlId="de50eb94-de7a-493c-a10c-0efc37c5136e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToJDBCQuery"/>
                        <bpws:target linkName="Empty3ToJDBCQueryAsset_Nouservlan"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery_AssetToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+de50eb94-de7a-493c-a10c-0efc37c5136e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns9:jdbcQueryActivityInput>&lt;idAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:idAsset)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:idAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idAsset>&lt;idAsset2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:idAsset)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:idAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idAsset2>&lt;/tns9:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select att.NOMEATTRIBUTO, VALOREATTRIBUTO, att.iddettaglioasset&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att &#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID  and ATT.IDASSET=? AND att.iddettaglioasset not in (select DISTINCT att.iddettaglioasset&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and ATT.IDASSET=? AND att.nomeattributo='FLAGMULTICAST') AND att.iddettaglioasset>1&#xa;ORDER BY att.iddettaglioasset asc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset2"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="IDDETTAGLIOASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
