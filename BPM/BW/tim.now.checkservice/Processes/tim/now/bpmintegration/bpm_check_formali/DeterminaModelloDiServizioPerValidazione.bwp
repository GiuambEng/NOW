                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT cod_mod_servizio&#xa;FROM modello_serv_validazioni&#xa;WHERE offerta=(SELECT distinct OFF.OFFERTA&#xa;FROM OFFERTA OFF inner join trascodfc_offerta tof on off.id_offerta=tof.id_offerta&#xa;WHERE tof.nome_offerta_esterna=?) and tagging=? and encapsulation=? and flag_multicast= 'SI' and (tipo_banda=? or tipo_banda is null ) and (tipo_cos=? or tipo_cos is null) and (bmc_light=? or bmc_light is null)" xsi:type="jdbcPalette:JDBCQueryActivity">
