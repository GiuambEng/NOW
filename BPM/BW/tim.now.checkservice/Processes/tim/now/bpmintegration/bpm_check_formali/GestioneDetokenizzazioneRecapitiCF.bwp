            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ResultDetoken&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GestioneDetokenizzazioneRecapitiCF_Response>&lt;tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$ResultDetoken/tns1:Esito='OK'&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:Esito&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:if test=&quot;$ResultDetoken/tns1:Esito='OK'&quot;>&lt;xsl:for-each select=&quot;$Start/tns:referente&quot;>&lt;tns:referente>&lt;xsl:variable name=&quot;var&quot; select=&quot;position()&quot;/>&lt;xsl:if test=&quot;tns:IDRichiestaOLO&quot;>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;tns:IDRichiestaOLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&lt;tns:progressivoReferente>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/tns:progressivoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipoReferenteOrdine&quot;>&lt;tns:tipoReferenteOrdine>&lt;xsl:value-of select=&quot;tns:tipoReferenteOrdine&quot;/>&lt;/tns:tipoReferenteOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:qualificaReferente&quot;>&lt;tns:qualificaReferente>&lt;xsl:value-of select=&quot;tns:qualificaReferente&quot;/>&lt;/tns:qualificaReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoFissoReferente]/tns1:TelefonoFisso&quot;>&lt;tns:telefonoFissoReferente>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoFissoReferente]/tns1:TelefonoFisso&quot;/>&lt;/tns:telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoMobileReferente]/tns1:TelefonoMobile&quot;>&lt;tns:telefonoMobileReferente>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoMobileReferente]/tns1:TelefonoMobile&quot;/>&lt;/tns:telefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:flag_Token&quot;>&lt;tns:flag_Token>&lt;xsl:value-of select=&quot;tns:flag_Token&quot;/>&lt;/tns:flag_Token>&lt;/xsl:if>&lt;/tns:referente>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:GestioneDetokenizzazioneRecapitiCF_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="b03caa17-7150-44ef-90e2-983aa3426013" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ResultDetoken&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GestioneDetokenizzazioneRecapitiCF_Response>&lt;tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$ResultDetoken/tns1:Esito='OK'&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:Esito&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:if test=&quot;$ResultDetoken/tns1:Esito='OK'&quot;>&lt;xsl:for-each select=&quot;$Start/tns:referente&quot;>&lt;tns:referente>&lt;xsl:variable name=&quot;var&quot; select=&quot;position()&quot;/>&lt;xsl:if test=&quot;tns:IDRichiestaOLO&quot;>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;tns:IDRichiestaOLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&lt;tns:progressivoReferente>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/tns:progressivoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipoReferenteOrdine&quot;>&lt;tns:tipoReferenteOrdine>&lt;xsl:value-of select=&quot;tns:tipoReferenteOrdine&quot;/>&lt;/tns:tipoReferenteOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:qualificaReferente&quot;>&lt;tns:qualificaReferente>&lt;xsl:value-of select=&quot;tns:qualificaReferente&quot;/>&lt;/tns:qualificaReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoFissoReferente]/tns1:TelefonoFisso&quot;>&lt;tns:telefonoFissoReferente>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoFissoReferente]/tns1:TelefonoFisso&quot;/>&lt;/tns:telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoMobileReferente]/tns1:TelefonoMobile&quot;>&lt;tns:telefonoMobileReferente>&lt;xsl:value-of select=&quot;$ResultDetoken/tns1:ResultDetokenizzazione[tns1:Token=$Start/tns:referente[$var]/tns:telefonoMobileReferente]/tns1:TelefonoMobile&quot;/>&lt;/tns:telefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:flag_Token&quot;>&lt;tns:flag_Token>&lt;xsl:value-of select=&quot;tns:flag_Token&quot;/>&lt;/tns:flag_Token>&lt;/xsl:if>&lt;/tns:referente>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:GestioneDetokenizzazioneRecapitiCF_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'GestioneDetokenizzazioneRecapitiCF'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$Start/tns2:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Input GestioneDetokenizzazioneRecapitiCF : ',tib:render-xml($Start))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInput-input" name="LogInput"
                    tibex:xpdlId="711a9d7d-f32c-48ee-9725-5ba821f1e305"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToGetLocalIP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'GestioneDetokenizzazioneRecapitiCF'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$Start/tns2:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Input GestioneDetokenizzazioneRecapitiCF : ',tib:render-xml($Start))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="7dfa148b-4397-4142-b95b-354e67446e3b">
                <bpws:targets>
                    <bpws:target linkName="Assign1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToGenericLogger"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Start/ns0:referente) and $ResultDetoken/tns:Esito = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Start/ns0:referente) and $ResultDetoken/tns:Esito = 'OK']]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogSecoloInputToCallSecolo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallSecoloToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GenericLoggerToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallSecoloToGenericLogger1" tibex:linkType="ERROR"/>
                                <bpws:link name="LogSecoloErrorToThrow" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="890c6878-3f6b-4d55-925a-74801c007d1c">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToGenericLogger"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="1276c421-6b4a-47b5-ae1b-aaff07a9eb4b">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ResultDetoken&quot;/>&lt;xsl:param name=&quot;CallSecolo&quot;/>&lt;xsl:template name=&quot;ResultDetoken&quot; match=&quot;/&quot;>&lt;tns1:ResultDetokenizzazione>&lt;tns1:Esito>&lt;xsl:value-of select=&quot;$CallSecolo/tns2:ESITO&quot;/>&lt;/tns1:Esito>&lt;xsl:copy-of select=&quot;$ResultDetoken/tns1:ResultDetokenizzazione&quot;/>&lt;tns1:ResultDetokenizzazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:referente[number($index)]/tns:telefonoFissoReferente) and string-length($Start/tns:referente[number($index)]/tns:telefonoFissoReferente)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:referente[number($index)]/tns:telefonoFissoReferente&quot;>&lt;tns1:Token>&lt;xsl:value-of select=&quot;$Start/tns:referente[number($index)]/tns:telefonoFissoReferente&quot;/>&lt;/tns1:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:referente[number($index)]/tns:telefonoMobileReferente&quot;>&lt;tns1:Token>&lt;xsl:value-of select=&quot;$Start/tns:referente[number($index)]/tns:telefonoMobileReferente&quot;/>&lt;/tns1:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$CallSecolo/tns2:N_Recap_Cliente&quot;>&lt;tns1:TelefonoFisso>&lt;xsl:value-of select=&quot;$CallSecolo/tns2:N_Recap_Cliente&quot;/>&lt;/tns1:TelefonoFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;$CallSecolo/tns2:N_Recap_Cliente_ALT&quot;>&lt;tns1:TelefonoMobile>&lt;xsl:value-of select=&quot;$CallSecolo/tns2:N_Recap_Cliente_ALT&quot;/>&lt;/tns1:TelefonoMobile>&lt;/xsl:if>&lt;/tns1:ResultDetokenizzazione>&lt;/tns1:ResultDetokenizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ResultDetoken"
                                    name="Response"
                                    outputVariable="ResultDetoken"
                                    tibex:xpdlId="6004a09e-8ac2-4bbf-8ddf-cb033c34cd83" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
