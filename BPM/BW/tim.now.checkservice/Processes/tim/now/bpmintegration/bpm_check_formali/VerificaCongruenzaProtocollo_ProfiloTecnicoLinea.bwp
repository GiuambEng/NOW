                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select PROTOCOLLO&#xd;&#xa;from PROFILO_TCNC_LINEA P,TRASCODFC_OFFERTA O&#xd;&#xa;where&#xd;&#xa;P.ID_OFFERTA=O.ID_OFFERTA and O.PROVENIENZA='BPM' and&#xd;&#xa;P.PROFILO_TCNC_LINEA=? and &#xd;&#xa;O.NOME_OFFERTA_ESTERNA=? " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
