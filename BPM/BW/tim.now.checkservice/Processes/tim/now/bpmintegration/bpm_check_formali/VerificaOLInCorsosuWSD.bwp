            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Update_ANA_LAVORAZ_INCORSO_WSD-input"
                    name="Update_ANA_LAVORAZ_INCORSO_WSD"
                    outputVariable="Update_ANA_LAVORAZ_INCORSO_WSD"
                    tibex:xpdlId="4754f312-f1e8-42d9-9b7b-a637ad37297c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_ParseJSONToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Update_ANA_LAVORAZ_INCORSO_WSDToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4754f312-f1e8-42d9-9b7b-a637ad37297c+input&quot; xmlns:tns3=&quot;http://www.example.org/VerificaOLInCorsosuWSD&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Update_ANA_LAVORAZ_INCORSO_WSD-input&quot; match=&quot;/&quot;>&lt;tns7:jdbcUpdateActivityInput>&lt;response>&lt;xsl:value-of select=&quot;$ParseJSON&quot;/>&lt;/response>&lt;esito>&lt;xsl:value-of select=&quot;xsd:int($ParseJSON/tns3:codiceEsito)&quot;/>&lt;/esito>&lt;descrEsito>&lt;xsl:value-of select=&quot;$ParseJSON/tns3:descrizioneEsito&quot;/>&lt;/descrEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseJSON/tns3:codiceEsito='0'&quot;>&lt;idStatoInterOut>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/idStatoInterOut>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idStatoInterOut>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/idStatoInterOut>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;idRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idRichiesta>&lt;/tns7:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE ANA_LAVORAZ_INCORSO_WSD&#xd;&#xa;SET CONTENUTO_RESPONSE=?,&#xd;&#xa;ESITO=?,&#xd;&#xa;DESCR_ESITO=?,&#xd;&#xa;ID_STATO_INTER_OUT=?,&#xd;&#xa;TIMSTP_RISPOSTA=sysdate&#xd;&#xa;WHERE ID_RICHIESTA=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="response"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="descrEsito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idStatoInterOut"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiesta"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogError_InvokeRESTAPI-input"
                    name="LogError_InvokeRESTAPI"
                    tibex:xpdlId="dca45aec-e061-4ea3-8211-787fcda6ee0c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tns9=&quot;http://schemas.tibco.com/bw/plugins/http/5.0/httpExceptions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;_error_InvokeRESTAPI&quot;/>&lt;xsl:template name=&quot;LogError_InvokeRESTAPI-input&quot; match=&quot;/&quot;>&lt;tns8:CW_BUS_MESSAGE>&lt;tns8:GenericLogger>&lt;tns8:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns8:Application>&lt;tns8:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaOLInCorsosuWSD&amp;quot;&quot;/>&lt;/tns8:Process>&lt;tns8:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns8:Service>&lt;tns8:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaOLInCorsosuWSD&amp;quot;&quot;/>&lt;/tns8:Operation>&lt;xsl:if test=&quot;$Start/tns2:IDRichiestaOLO&quot;>&lt;tns8:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&lt;/tns8:BusinessID>&lt;/xsl:if>&lt;tns8:Message>&lt;xsl:value-of select=&quot;concat('ERROR InvokeRESTAPI ricevuto da WSD+.', 'Codice: ',$_error_InvokeRESTAPI/tns9:HttpServerException/msgCode,'Descrizione Errore:  ',$_error_InvokeRESTAPI/tns9:HttpServerException/msg )&quot;/>&lt;/tns8:Message>&lt;tns8:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns8:LoggerName>&lt;tns8:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns8:LogLevel>&lt;tns8:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns8:LogJMS>&lt;/tns8:GenericLogger>&lt;/tns8:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
