                                    sqlStatement="&#xa;SELECT MODEM&#xa;FROM PROFILO_TCNC_LINEA&#xa;WHERE ID_OFFERTA = ? AND PROFILO_TCNC_LINEA = ? " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
