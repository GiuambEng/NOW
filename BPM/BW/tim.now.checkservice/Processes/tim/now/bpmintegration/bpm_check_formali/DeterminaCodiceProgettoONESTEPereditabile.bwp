            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="a76236ce-d469-4346-ac01-d0240b9c668f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='T1PRJ0050368'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='T1PRJ0050368'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToQueryPROGETTO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaCodiceProgettoONESTEPereditabile&amp;quot;&quot;/>&lt;/tns4:Process>&lt;tns4:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&lt;/tns4:Service>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DeterminaCodiceProgettoONESTEPereditabile&amp;quot;&quot;/>&lt;/tns4:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns4:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per oscuramento&amp;quot;, tib:render-xml($Oscuramento, true(), true()))&quot;/>&lt;/tns4:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Message>&lt;xsl:value-of select=&quot;'Record non recuperato per oscuramento'&quot;/>&lt;/tns4:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryPROGETTO-input"
                    name="QueryPROGETTO" outputVariable="QueryPROGETTO"
                    tibex:xpdlId="25e3a7bd-d9fd-41c3-90b5-7ebdbe3736e3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscuramentoToQueryPROGETTO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryPROGETTOToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+25e3a7bd-d9fd-41c3-90b5-7ebdbe3736e3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryPROGETTO-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;cod_prgt>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceProgetto)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceProgetto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_prgt>&lt;cod_olo_agcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodificaOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_olo_agcom>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select COD_PRGT&#xd;&#xa;FROM PRGT&#xd;&#xa;WHERE COD_PRGT=? AND&#xd;&#xa;CODFC_OLO_AGCOM=? AND&#xd;&#xa;ONESTEP='SI' AND&#xd;&#xa;FLAG_EREDITA_CODICE_PROGETTO ='SI'"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_prgt"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo_agcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_PRGT"
                                    dataType="12" typeName="varchar2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="Assign" outputVariable="Response"
                    tibex:xpdlId="8501cc3c-7117-4130-bfdf-260147d21cda" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
