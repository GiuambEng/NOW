                <tibex:extActivity
                    inputVariable="Log_PROGETTOEREDITABILE-input"
                    name="Log_PROGETTOEREDITABILE"
                    tibex:xpdlId="bef6db4b-a238-40ac-95f0-d9365fdd89c9"
