                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;QueryPROGETTO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryProgetto2&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0050368'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0050368']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryPROGETTO/Record)>0&quot;>&lt;tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;xsl:if test=&quot;$Start/tns1:CodiceProgetto&quot;>&lt;tns1:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceProgetto&quot;/>&lt;/tns1:CodiceProgetto>&lt;/xsl:if>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryProgetto2/Record)>0&quot;>&lt;tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;xsl:if test=&quot;$Start/tns1:CodiceProgettoOld&quot;>&lt;tns1:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceProgettoOld&quot;/>&lt;/tns1:CodiceProgetto>&lt;/xsl:if>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:DeterminaCodiceProgettoONESTEPereditabile_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
