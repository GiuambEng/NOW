        <bpws:variable element="ns12:ActivityErrorData"
            name="_error_Check2" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogCheck2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogEsito2-input" sca-bpel:internal="true"/>
