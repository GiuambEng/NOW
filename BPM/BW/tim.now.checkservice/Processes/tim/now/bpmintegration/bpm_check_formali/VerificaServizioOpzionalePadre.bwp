            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEsito1-input"
                    name="LogEsito1"
                    tibex:xpdlId="c2aac72f-aaf5-4a94-93e2-884e034b8d12"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEsito1ToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Esito/ns0:Esito/ns0:Codice=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Esito/ns0:Esito/ns0:Codice=false()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogEsito1ToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:template name=&quot;LogEsito1-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaServizioOpzionalePadre'&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaServizioOpzionalePadre'&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Esito dopo Check1 :', tib:render-xml($Esito, true(), true()))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Vettore"
                    name="Vettore" outputVariable="Vettore"
                    tibex:xpdlId="4646a05e-bdab-4333-b292-8a3c6e3d2ed5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
