                    <bpws:targets>
                        <bpws:target linkName="StartToOscuramento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToLogOscuramento"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a0724f95-d30f-4293-9b40-1521795a7d0a+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP &#xa;WHERE COD_AGESP IN ('R1I-25-0151')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="12" typeName="VARCHAR"/>
                                    <columnMetadata
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="be06c861-b345-4f3e-9515-416200250a05"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToLogOscuramento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToAssign_Oscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
