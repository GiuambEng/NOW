                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT pvc.ID_PRFL_VC&#xa;FROM PROFILO_VC pvc, PROFILO_VC pvc2, TRASCODFC_OFFERTA tra &#xa;WHERE pvc.ID_PRFL_VC = ? AND  tra.NOME_OFFERTA_ESTERNA = 'BITSTREAMATMSIMMETRICOFLAT' &#xa;&#x9;AND tra.PROVENIENZA = 'BPM' AND pvc2.ID_OFFERTA = tra.ID_OFFERTA&#xa;&#x9;AND pvc.MCR_DOWN = pvc2.MCR_DOWN AND pvc.MCR_UP = pvc2.MCR_UP &#xa;&#x9;AND pvc.PCR_DOWN = pvc2.PCR_DOWN AND pvc.PCR_UP = pvc2.PCR_UP&#xa;&#x9;AND pvc2.FLAG_VENDIBILITA = 'Y' AND pvc2.TIPOLG_PROFILO = 'ABR'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_PRFL_VC"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
