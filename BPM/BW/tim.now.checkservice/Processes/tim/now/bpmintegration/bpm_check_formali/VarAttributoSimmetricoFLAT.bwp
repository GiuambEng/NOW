                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign2ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Check_MCR_PCR&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns2:Verifica_Var_Attributo_Caratt_SIM_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Check_MCR_PCR/Record) > 0&quot;>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Check_MCR_PCR/Record) > 0&quot;>&lt;tns2:Ordinativo>&lt;tns1:OLAutoespletante>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:OLAutoespletante>&lt;/tns2:Ordinativo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Ordinativo/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:Verifica_Var_Attributo_Caratt_SIM_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
