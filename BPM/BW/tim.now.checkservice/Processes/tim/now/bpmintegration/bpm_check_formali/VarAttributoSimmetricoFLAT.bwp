            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="fd3d9758-502e-4f20-b658-b3bb5d127315">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Start/ns3:CONSISTENZADATIVC) and $Variable/ns3:Esito/ns3:Codice = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Start/ns3:CONSISTENZADATIVC) and $Variable/ns3:Esito/ns3:Codice = true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="Assign2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToCheck_MCR_PCR" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Check_MCR_PCRToLogQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogQueryToAssign2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="d6db2c3e-4120-4c77-9bf2-4837ac3d231b">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCheck_MCR_PCR"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="7dd6e9ca-bb48-4319-bed7-1f7212576f76">
                                <bpws:targets>
                                    <bpws:target linkName="Assign2ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Check_MCR_PCR&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns2:Verifica_Var_Attributo_Caratt_SIM_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Check_MCR_PCR/Record) > 0&quot;>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Check_MCR_PCR/Record) > 0&quot;>&lt;tns2:Ordinativo>&lt;tns1:OLAutoespletante>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:OLAutoespletante>&lt;/tns2:Ordinativo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Ordinativo/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:Verifica_Var_Attributo_Caratt_SIM_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="Assign2"
                                    outputVariable="Variable"
                                    tibex:xpdlId="bc833a06-5f1a-43c3-b977-e3ccdae80269" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
