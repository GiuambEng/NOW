                    <bpws:targets>
                        <bpws:target linkName="QueryONESTEPToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryCluster1ToDatiVerificaControlli">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7fadf5c6-d1a4-4ec3-b1d7-42c38aca6b7c+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryCluster1-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;codOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='VARIAZIONE' and $Start/tns2:sottoLavorazione='RICONFIGURAZIONEIP'&quot;>&lt;Lavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE IP'&quot;/>&lt;/Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='VARIAZIONE' and $Start/tns2:sottoLavorazione='VARIAZIONEPARENTALCONTROL'&quot;>&lt;Lavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE PC'&quot;/>&lt;/Lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Lavorazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Lavorazione)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/offerta>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select cluster_radius,REALM,PIATTAFORMA_O2O,FORNITORE_RADIUS&#xa;from ANAGRAFICA_RADIUS&#xa;where &#xa;ANAGRAFICA_RADIUS.CODICE_OLO=? AND&#xa;(ANAGRAFICA_RADIUS.ONE_STEP='NO' or ANAGRAFICA_RADIUS.ONE_STEP='*') AND&#xa;UPPER(ANAGRAFICA_RADIUS.LAVORAZIONE)=? AND&#xa;(ANAGRAFICA_RADIUS.TECNOLOGIA in (SELECT DESCR FROM SOTTO_FAMIG_OFFERTA SFO, OFFERTA O WHERE sfo.id_sottofamig_offerta=o.id_sottofamig_offerta AND UPPER(REPLACE(O.OFFERTA,' ', ''))=?) or ANAGRAFICA_RADIUS.TECNOLOGIA='*')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOlo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="offerta"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CLUSTER_RADIUS"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="REALM"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="PIATTAFORMA_O2O"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="FORNITORE_RADIUS"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
