            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="475a70d0-6b49-4909-a0a4-6a799a0db9b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscuramentoToEnd_OSCURATO"/>
                        <bpws:target linkName="DatiVerificaControlliToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;QueryCluster&quot;/>&lt;xsl:param name=&quot;QueryCluster1&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R1I-25-0147'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns2:DeterminaClusterRadius_Response>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/tns2:DeterminaClusterRadius_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryCluster/Record)>0&quot;>&lt;tns2:DeterminaClusterRadius_Response>&lt;xsl:if test=&quot;$QueryCluster/Record[1]/CLUSTER_RADIUS&quot;>&lt;tns2:Cluster>&lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/CLUSTER_RADIUS&quot;/>&lt;/tns2:Cluster>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster/Record[1]/REALM&quot;>&lt;tns2:realm>&lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/REALM&quot;/>&lt;/tns2:realm>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster/Record[1]/PIATTAFORMA_O2O&quot;>&lt;tns2:piattaformaO2O>&lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/PIATTAFORMA_O2O&quot;/>&lt;/tns2:piattaformaO2O>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster/Record[1]/FORNITORE_RADIUS&quot;>&lt;tns2:fornitoreRadius>&lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/FORNITORE_RADIUS&quot;/>&lt;/tns2:fornitoreRadius>&lt;/xsl:if>&lt;/xsl:if>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/tns2:DeterminaClusterRadius_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryCluster1/Record)>0&quot;>&lt;tns2:DeterminaClusterRadius_Response>&lt;xsl:if test=&quot;$QueryCluster1/Record[1]/CLUSTER_RADIUS&quot;>&lt;tns2:Cluster>&lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/CLUSTER_RADIUS&quot;/>&lt;/tns2:Cluster>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster1/Record[1]/REALM&quot;>&lt;tns2:realm>&lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/REALM&quot;/>&lt;/tns2:realm>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster1/Record[1]/PIATTAFORMA_O2O&quot;>&lt;tns2:piattaformaO2O>&lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/PIATTAFORMA_O2O&quot;/>&lt;/tns2:piattaformaO2O>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' ))&quot;>&lt;xsl:if test=&quot;$QueryCluster1/Record[1]/FORNITORE_RADIUS&quot;>&lt;tns2:fornitoreRadius>&lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/FORNITORE_RADIUS&quot;/>&lt;/tns2:fornitoreRadius>&lt;/xsl:if>&lt;/xsl:if>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/tns2:DeterminaClusterRadius_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryCluster/Record)=0 and count($QueryCluster1/Record)=0&quot;>&lt;tns2:DeterminaClusterRadius_Response>&lt;tns2:Cluster>&lt;xsl:value-of select=&quot;'Cluster 1'&quot;/>&lt;/tns2:Cluster>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/tns2:DeterminaClusterRadius_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:DeterminaClusterRadius_Response>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;/tns2:DeterminaClusterRadius_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="213db458-4067-4421-8875-938a86c13fff"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaClusterRadius&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaClusterRadius&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:IDRichiestaOLO&quot;>&#xa;                    &lt;tns8:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns8:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;DeterminaClusterRadius Input: &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="6adfe51c-c130-4eb1-a974-ea20f1c70b29" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6adfe51c-c130-4eb1-a974-ea20f1c70b29+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP &#xd;&#xa;WHERE COD_AGESP IN ('R1I-25-0147','T1PRJ0002889','T1PRJ0031945')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="char"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="varchar2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="afbacaf9-2932-4ed9-8af1-a5460cc04347"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToEnd_OSCURATO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='R1I-25-0147'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='R1I-25-0147'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0147']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToQueryONESTEP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaClusterRadius&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceFormali&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeterminaClusterRadius&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:IDRichiestaOLO&quot;>&#xa;                    &lt;tns8:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns8:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per oscuramento&amp;quot;, tib:render-xml($Oscuramento, true(), true()))&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record non recuperato per oscuramento'&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryCluster-input"
                    name="QueryCluster" outputVariable="QueryCluster"
                    tibex:xpdlId="38949ebb-7c82-43d2-8b8d-65fde3cb545f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryONESTEPToQueryCluster"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryClusterToDatiVerificaControlli">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+38949ebb-7c82-43d2-8b8d-65fde3cb545f+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryCluster-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;codOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOlo>&lt;cod_progetto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceProgetto)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceProgetto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_progetto>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='VARIAZIONE' and $Start/tns2:sottoLavorazione='RICONFIGURAZIONEIP'&quot;>&lt;Lavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE IP'&quot;/>&lt;/Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='VARIAZIONE' and $Start/tns2:sottoLavorazione='VARIAZIONEPARENTALCONTROL'&quot;>&lt;Lavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE PC'&quot;/>&lt;/Lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Lavorazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Lavorazione)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/offerta>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select cluster_radius,REALM,PIATTAFORMA_O2O,FORNITORE_RADIUS&#xd;&#xa;from ANAGRAFICA_RADIUS&#xd;&#xa;where &#xd;&#xa;ANAGRAFICA_RADIUS.CODICE_OLO=? AND&#xd;&#xa;(ANAGRAFICA_RADIUS.ONE_STEP in (select onestep from prgt where cod_prgt=?) or ANAGRAFICA_RADIUS.ONE_STEP='*') AND&#xd;&#xa;UPPER(ANAGRAFICA_RADIUS.LAVORAZIONE)=? AND&#xd;&#xa;(ANAGRAFICA_RADIUS.TECNOLOGIA in (SELECT DESCR FROM SOTTO_FAMIG_OFFERTA SFO, OFFERTA O WHERE sfo.id_sottofamig_offerta=o.id_sottofamig_offerta AND UPPER(REPLACE(O.OFFERTA,' ', ''))=?) or ANAGRAFICA_RADIUS.TECNOLOGIA='*')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOlo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_progetto"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="offerta"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CLUSTER_RADIUS"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="REALM"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="PIATTAFORMA_O2O"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="FORNITORE_RADIUS"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DatiVerificaControlli-input"
                name="DatiVerificaControlli"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlli"
                partnerLink="DatiVerificaControlli"
                portType="ns7:DatiVerificaControlliPortType" tibex:xpdlId="7aa8b64a-4f71-446a-9802-31ad07ad0f12">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliFormali/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="QueryCluster"/&gt;&lt;xsl:param name="QueryCluster1"/&gt;&lt;xsl:param name="Oscuramento"/&gt;&lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;&lt;tns:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns1:DatiVerificaControlliInput&gt;&lt;tns1:Operatore&gt;&lt;xsl:value-of select="'BPM'"/&gt;&lt;/tns1:Operatore&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns2:IDRichiestaOLO"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:LavorazioneRichiesta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($QueryCluster/Record)&gt;0"&gt;&lt;xsl:if test="$QueryCluster/Record[1]/CLUSTER_RADIUS"&gt;&lt;tns1:Cluster&gt;&lt;xsl:value-of select="$QueryCluster/Record[1]/CLUSTER_RADIUS"/&gt;&lt;/tns1:Cluster&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($QueryCluster1/Record)&gt;0"&gt;&lt;xsl:if test="$QueryCluster1/Record[1]/CLUSTER_RADIUS"&gt;&lt;tns1:Cluster&gt;&lt;xsl:value-of select="$QueryCluster1/Record[1]/CLUSTER_RADIUS"/&gt;&lt;/tns1:Cluster&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:Cluster&gt;&lt;xsl:value-of select="'Cluster 1'"/&gt;&lt;/tns1:Cluster&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($QueryCluster/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster/Record[1]/REALM"&gt;&lt;tns1:realm&gt;&lt;xsl:value-of select="$QueryCluster/Record[1]/REALM"/&gt;&lt;/tns1:realm&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($QueryCluster1/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster1/Record[1]/REALM"&gt;&lt;tns1:realm&gt;&lt;xsl:value-of select="$QueryCluster1/Record[1]/REALM"/&gt;&lt;/tns1:realm&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($QueryCluster/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster/Record[1]/PIATTAFORMA_O2O"&gt;&lt;tns1:piattaformaO2O&gt;&lt;xsl:value-of select="$QueryCluster/Record[1]/PIATTAFORMA_O2O"/&gt;&lt;/tns1:piattaformaO2O&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($QueryCluster1/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster1/Record[1]/PIATTAFORMA_O2O"&gt;&lt;tns1:piattaformaO2O&gt;&lt;xsl:value-of select="$QueryCluster1/Record[1]/PIATTAFORMA_O2O"/&gt;&lt;/tns1:piattaformaO2O&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($QueryCluster/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster/Record[1]/FORNITORE_RADIUS"&gt;&lt;tns1:fornitoreRadius&gt;&lt;xsl:value-of select="$QueryCluster/Record[1]/FORNITORE_RADIUS"/&gt;&lt;/tns1:fornitoreRadius&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($QueryCluster1/Record)&gt;0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])&gt;0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))"&gt;&lt;xsl:if test="$QueryCluster1/Record[1]/FORNITORE_RADIUS"&gt;&lt;tns1:fornitoreRadius&gt;&lt;xsl:value-of select="$QueryCluster1/Record[1]/FORNITORE_RADIUS"/&gt;&lt;/tns1:fornitoreRadius&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/tns1:LavorazioneRichiesta&gt;&lt;/tns1:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryCluster&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryCluster1&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:LavorazioneRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster/Record[1]/CLUSTER_RADIUS&quot;>&#xa;                            &lt;tns1:Cluster>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/CLUSTER_RADIUS&quot;/>&#xa;                            &lt;/tns1:Cluster>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster1/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster1/Record[1]/CLUSTER_RADIUS&quot;>&#xa;                            &lt;tns1:Cluster>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/CLUSTER_RADIUS&quot;/>&#xa;                            &lt;/tns1:Cluster>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Cluster>&#xa;                            &lt;xsl:value-of select=&quot;'Cluster 1'&quot;/>&#xa;                        &lt;/tns1:Cluster>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster/Record)>0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' )))&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster/Record[1]/REALM&quot;>&#xa;                            &lt;tns1:realm>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/REALM&quot;/>&#xa;                            &lt;/tns1:realm>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster1/Record)>0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0002889'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0002889']/FLAG_OSCURMENTO='N' )))&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster1/Record[1]/REALM&quot;>&#xa;                            &lt;tns1:realm>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/REALM&quot;/>&#xa;                            &lt;/tns1:realm>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster/Record)>0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster/Record[1]/PIATTAFORMA_O2O&quot;>&#xa;                            &lt;tns1:piattaformaO2O>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster/Record[1]/PIATTAFORMA_O2O&quot;/>&#xa;                            &lt;/tns1:piattaformaO2O>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster1/Record)>0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N' )))&quot;>&#xa;                        &lt;xsl:if test=&quot;$QueryCluster1/Record[1]/PIATTAFORMA_O2O&quot;>&#xa;                            &lt;tns1:piattaformaO2O>&#xa;                                &lt;xsl:value-of select=&quot;$QueryCluster1/Record[1]/PIATTAFORMA_O2O&quot;/>&#xa;                            &lt;/tns1:piattaformaO2O>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($QueryCluster/Record)>0 and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945'