                    <bpws:sources>
                        <bpws:source linkName="QueryONESTEPToQueryCluster">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryONESTEP/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($QueryONESTEP/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="QueryONESTEPToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
