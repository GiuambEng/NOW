                                    expression="$VerificaOLOWholesalerResponse/tns:Esito/tns:Codice = true() and $Verifica_OLO_WholesalerIn/parameters/tns:Verifica_OLO_Wholesaler_Request/tns:Flag_GUI = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
