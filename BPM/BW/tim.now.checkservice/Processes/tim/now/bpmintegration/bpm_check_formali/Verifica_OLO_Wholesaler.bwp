                        <bpws:source linkName="Esito2AssignToVerifica_OLO_EsitoKOorGUI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OLO_WholesalerIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectDistretto_Arco1&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaOLOWholesalerResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($SelectDistretto_Arco1/Record[1]/CODFC_OLO_AGCOM) = 0&quot;>&#xa;                &lt;tns:Verifica_OLO_Wholesaler_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Verifica_OLO_Wholesaler_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains(upper-case(tib:trim($Verifica_OLO_WholesalerIn.parameters/tns:TipoLinea)),&amp;quot;POTS&amp;quot;) or contains(upper-case(tib:trim($Verifica_OLO_WholesalerIn.parameters/tns:TipoLinea)), &amp;quot;ISDN&amp;quot;)) and ($Verifica_OLO_WholesalerIn.parameters/tns:Offerta = &amp;quot;SHASENZAMANODOPERA&amp;quot; or $Verifica_OLO_WholesalerIn.parameters/tns:Offerta = &amp;quot;SHACONMANODOPERA&amp;quot;) and $SelectDistretto_Arco1/Record[1]/CODFC_OLO_AGCOM != $Verifica_OLO_WholesalerIn.parameters/tns:CodiceOLOAGCOMRecipient&quot;>&#xa;                &lt;tns:Verifica_OLO_Wholesaler_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Verifica_OLO_Wholesaler_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Verifica_OLO_Wholesaler_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Verifica_OLO_Wholesaler_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
