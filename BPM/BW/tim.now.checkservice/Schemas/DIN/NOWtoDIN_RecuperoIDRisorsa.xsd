<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoDIN_RecuperoIDRisorsa/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://www.tim.com/NOW/xsd/CommonSchema/"
	xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoDIN_RecuperoIDRisorsa/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" >
    <import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1" />
	
	<element name="RecuperoIDRisorsa_Request">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string" />
				<element name="NumeroTelefonico" type="string" />
            </sequence>
		</complexType>
	</element>
	<element name="RecuperoIDRisorsa_Response">
		<complexType>
			<sequence>
				<element name="Distretto" type="string" minOccurs="0" />
				<element name="TGU" type="string" minOccurs="0" />
				<element name="ID_risorsa" type="string" minOccurs="0" />
				<element name="Esito" type="tns:Esito" />			
			</sequence>
		</complexType>
	</element>
	<complexType name="Esito">
		<sequence>
			<element name="Esito" type="string" />
			<element name="Descrizione" type="string" />
		</sequence>
	</complexType>

	<element name="RecuperoIDRisorsa_Fault">
		<complexType>
			<sequence>
				<element name="Fault" type="tns:Fault" />
			</sequence>
		</complexType>
	</element>	
	<complexType name="Fault">
		<sequence>
			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0" />
			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0" />
		</sequence>
	</complexType>
</schema>