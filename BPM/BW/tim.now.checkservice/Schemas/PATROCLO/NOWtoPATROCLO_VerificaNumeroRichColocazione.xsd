<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoPATROCLO_VerificaNumeroRichColocazione" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoPATROCLO_VerificaNumeroRichColocazione">

    <element
    	name="NOWtoPATROCLO_VerificaNumeroRichColocazioneRequest">
    	<complexType>
    		<sequence>
    			<element name="Codice_Ordine_OLO" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
                <element name="CodiceOLOAGCOM" type="string" maxOccurs="1" minOccurs="1"></element>
                <element name="Numero_Rich_Colocaz" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="Data_Richiesta_Verifica" type="dateTime"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="Identificativo_Richiesta_OLO"
    				type="string" maxOccurs="1" minOccurs="1">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element
    	name="NOWtoPATROCLO_VerificaNumeroRichColocazioneResponse">
    	<complexType>
    		<sequence>
    			<element name="Codice_Ordine_OLO" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="Numero_Rich_Colocaz" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="Data_Verifca_Rich" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
                <element name="Code_Ord_TI" type="string" maxOccurs="1" minOccurs="1"></element>
                <element name="CLLI" type="string" maxOccurs="1" minOccurs="1">
    			</element>
                <element name="Data_Accetazione_OLO_OC" type="date"
    				maxOccurs="1" minOccurs="0">
    			</element>
                <element name="Code_Esito" maxOccurs="1"
                	minOccurs="1">
                	<simpleType>
                		<restriction base="string">
                			<enumeration value="00"></enumeration>
                			<enumeration value="01"></enumeration>
                			<enumeration value="02"></enumeration>
                			<enumeration value="03"></enumeration>
                			<enumeration value="05"></enumeration>
                		</restriction>
                	</simpleType>
                </element>
                <element name="Desc_Esito" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="Data_Invio_Esito" type="string" maxOccurs="1" minOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NOWtoPATROCLO_VerificaNumeroRichColocazioneFault">
    	<complexType>
    		<sequence>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>