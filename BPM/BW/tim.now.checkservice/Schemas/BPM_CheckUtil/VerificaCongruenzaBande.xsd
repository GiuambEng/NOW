<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaCongruenzaBande" xmlns:tns="http://www.example.org/VerificaCongruenzaBande" elementFormDefault="qualified">

    <element name="TipoBanda">
    	<complexType>
    		<sequence>
    			<element name="TipoBanda" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Banda" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <element name="UserVlan">
    	<complexType>
    		<sequence>

    			<element name="TipoCos" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="TipoCos" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="BMC" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="BMC" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

</schema>