<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NP_sincronizzata" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q3="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/NP_sincronizzata">
<import namespace="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" schemaLocation="../../../../tim.now.integration_library/Schemas/Management/DatiVerificaControlli.xsd"/>
  	<element name="Lista_NP">
		<complexType>
			<sequence>
			<element name="NumberPortability"
					type="Q3:NumberPortabilityType" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	
		<element name="Lista_aggiuntivi">
		<complexType>
			<sequence>
				<element name="Aggiuntivo" type="Q3:AggiuntivoType"
					minOccurs="0" maxOccurs="unbounded" />
			</sequence>
		</complexType>
	</element>

		<complexType name="ListaDNType">
			<sequence>
				<element name="DN_flag" type="tns:DnAggType" minOccurs="0" maxOccurs="unbounded"></element>
			</sequence>
		</complexType>

    <element name="Lista_DN" type="tns:ListaDNType"></element>

    <complexType name="DnAggType">
    	<sequence>
    		<element name="DN" type="string"></element>
    		<element name="FlagAggiuntivo" type="string"
    			minOccurs="0">
    		</element>
    		<element name="CasoNP" type="int" minOccurs="0"></element>
    		<element name="DonorDIOGENE" type="string" minOccurs="0"></element>
    		<element name="AttributoAsset" type="tns:AttributiAssetType" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>

    <element name="DN_flag" type="tns:DnAggType"></element>

    <complexType name="AttributiAssetType">
    	<sequence>
    		<element name="IdAsset" type="integer" minOccurs="0"></element>
    		<element name="IdRisorsa" type="string" minOccurs="0"></element>
    		<element name="IdDettaglioAsset" type="int" minOccurs="0"></element>
    		<element name="NomeAttributo" type="string" minOccurs="0"></element>
    		<element name="ValoreAttributo" type="string" minOccurs="0"></element>
    		<element name="CodificaOLOAGCOM" type="string" minOccurs="0"></element>
    		<element name="NumeroTelefonico" type="string" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>