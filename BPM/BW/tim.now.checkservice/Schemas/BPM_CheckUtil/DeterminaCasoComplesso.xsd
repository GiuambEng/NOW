<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:cd1="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:em="http://www.tim.com/NOW/xsd/DeterminaCasoComplesso/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/DeterminaCasoComplesso/">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<element name="DETERMINACASOCOMPLESSO_Request">
		<complexType>
			<sequence>
				<element name="TIPO_NUMERO" type="string">
				</element>
				<element name="TIPO_SERVIZIO" type="string">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="DETERMINACASOCOMPLESSO_Response">
		<complexType>
			<sequence>
                <element name="IsComplex" type="boolean"/>
            </sequence>
		</complexType>
	</element>
	<element name="CasoComplesso">
		<complexType>
			<sequence>
                <element name="CasoComplessoTipoNumero" type="string" maxOccurs = "unbounded" minOccurs="0"/>
                <element name="CasoComplessoTipoServizio" type="string" maxOccurs = "unbounded" minOccurs="0"/>
            </sequence>
		</complexType>
	</element>
	<element name="DETERMINACASOCOMPLESSO_Fault">
		<complexType>
			<sequence>
				<element minOccurs="0" name="Codice_Errore" type="string"/>
				<element minOccurs="0" name="Messaggio_Errore" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>
