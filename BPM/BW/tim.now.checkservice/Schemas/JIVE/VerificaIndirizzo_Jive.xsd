<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive">
	<complexType name="Codice">
		<sequence>
			<element name="CODICE_TOPONOMASTICA" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	<complexType name="Indirizzo">
		<sequence>
			<element name="DESC_PART_TOPON" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element name="DESC_VIA" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="80"/>
					</restriction>
				</simpleType>
			</element>
			<element name="DESC_LOCALITA" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="80"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CAP" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="13"/>
					</restriction>
				</simpleType>
			</element>
			<element name="PROVINCIA" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="80"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CIVICO" minOccurs="0" maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<maxLength value="70"/>
					</restriction>
				</simpleType>
			</element>
			<element name="ISTAT_COMUNE" minOccurs="0" maxOccurs="1" type="string"/>
		</sequence>
	</complexType>
	<element name="Request" type="tns:Request_type"/>
	<complexType name="Request_type">
		<sequence>
			<element name="CodificaOLOAgcom" type="string" minOccurs="0"/>
			<element name="CodiceOrdineOLO" type="string" minOccurs="0"/>
			<element name="IDRichiestaNOW" type="string" minOccurs="0"/>
			<element name="Codice" type="tns:Codice"/>
			<element name="Indirizzo" type="tns:Indirizzo"/>
		</sequence>
	</complexType>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="ESITO" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="cod_Err" maxOccurs="1" minOccurs="0" type="string">
				</element>
				<element name="desc_Err" maxOccurs="1" minOccurs="0" type="string">
				</element>
				<element name="INSTAT_PROV" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="SIGLA_PROV" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="PROVINCIA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element name="INSTAT_COMUNE" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="6"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DISTRETTO" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESC_LOCALITA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element name="COD_VIA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="9"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESC_PART_TOPON" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESC_VIA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="80"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CIVICO" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="70"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ADC" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="6"/>
						</restriction>
					</simpleType>
				</element>
				<element name="GAT" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="6"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CCLI" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="11"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CAP" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="13"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FLAG_OPA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="LATITUDINE" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="LONGITUDINE" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TIPO_FONTE" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TIPO_CATEGORIA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="PRECISIONE" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="20"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DR" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_TOPONOMATICA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Descrizione_errore">
		<simpleType>
			<restriction base="string">
				<maxLength value="150"/>
			</restriction>
		</simpleType>
	</element>
	<element name="ID_ORDINE">
		<simpleType>
			<restriction base="string">
				<maxLength value="50"/>
			</restriction>
		</simpleType>
	</element>
	<element name="Messaggio_Errore" type="string"/>
	<element name="Codice_Errore" type="string"/>
	<element name="Fault">
		<complexType>
			<sequence>
				<element ref="tns:Messaggio_Errore"/>
				<element ref="tns:Codice_Errore"/>
			</sequence>
		</complexType>
	</element>
	<element name="CODICE_OLO">
		<simpleType>
			<restriction base="string">
				<maxLength value="3"/>
			</restriction>
		</simpleType>
	</element>
	<element name="CODICE_OLO_CRMWS">
		<simpleType>
			<restriction base="string">
				<maxLength value="3"/>
			</restriction>
		</simpleType>
	</element>
	<element name="ID_UNIVOCO_NOW" type="int"/>
	<element name="SERVIZIO">
		<simpleType>
			<restriction base="string">
				<maxLength value="100"/>
			</restriction>
		</simpleType>
	</element>
</schema>