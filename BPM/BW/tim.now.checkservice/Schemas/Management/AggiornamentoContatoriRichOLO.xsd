<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO" 
		   targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO"
		   elementFormDefault="qualified" attributeFormDefault="unqualified" >
    
    <element name="AggiornamentoContatoriRichOLORequest" type="tns:Aggiornamento_Contatori_RichOLO_Request" />
    <element name="AggiornamentoContatoriRichOLOResponse" type="tns:Aggiornamento_Contatori_RichOLO_Response" />
    <element name="AggiornamentoContatoriRichOLOFault" type="tns:Aggiornamento_Contatori_RichOLO_Fault" />
    <element name="UpdateFILE_PROCSTO_INPUT_Root">
    	<complexType>
			<sequence>
				<element minOccurs="1" ref="tns:Update_FILE_PROCSTO_INPUT"/>
			</sequence>
		</complexType>
    </element>
    <complexType name="Aggiornamento_Contatori_RichOLO_Request">
    	<sequence>
    		<element name="Id_Rich_Olo" type="string" minOccurs="1" maxOccurs="1" />
    		<element name="Id_File_Procsto_Input" type="int" minOccurs="1" maxOccurs="1" />
    		<element name="Stato_Case_Richiesta" type="string" minOccurs="1" maxOccurs="1" />
    	</sequence>
    </complexType>
    <complexType name="Aggiornamento_Contatori_RichOLO_Response">
    	<sequence>
    		<element name="Esito" type="string" maxOccurs="1" minOccurs="0" />
    	</sequence>
    </complexType>
    <complexType name="Aggiornamento_Contatori_RichOLO_Fault">
   		<sequence>
   			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0" />
			<element name="Msg_Errore" type="string" maxOccurs="1" minOccurs="0" />
   		</sequence>
   	</complexType>
   	<element name="Update_FILE_PROCSTO_INPUT">
	   	<complexType>
	   		<sequence>
	   			<element name="QT_RECD_KO" type="decimal" minOccurs="1" />
				<element name="QT_RECD_OK" type="decimal" minOccurs="1" />
	   		</sequence>
	   	</complexType>
   	</element>
</schema>