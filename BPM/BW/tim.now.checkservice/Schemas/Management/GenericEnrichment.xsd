<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/GenericEnrichment" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/GenericEnrichment">
    <import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
    <element name="GenericEnrichment_Response">
	    <complexType>
	    	<sequence>
	    		<element maxOccurs="unbounded" name="GenericEnrichmentResponse" type="tns:GenericEnrichmentResponse"/>
	    	</sequence>
	    </complexType>
    </element>
    <complexType name="GenericEnrichmentResponse">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="Key" type="Q1:DizionarioAttributiEnumeration"/>
    		<element maxOccurs="1" minOccurs="0" name="Value" type="string"/>
    	</sequence>
   	</complexType>

    <element name="GenericEnrichmentRequest" type="tns:Request">
    </element>
    

    <complexType name="Request">
    	<sequence>
    		<element name="Richiesta" type="Q1:Richiesta"/>
    	</sequence>
    </complexType>

    <element name="GenericEnrichmentFault">
    	<complexType>
    		<sequence>
    			<element name="ErrorMessage" type="string"/>
    			<element name="ErrorCode" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
