<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/BPMEnrichment"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/BPMEnrichment" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="TipologiaAccessoRequest">
		<complexType>
			<sequence>
				<element name="Offerta"
					type="pref:OffertaEnumeration">
				</element>
			</sequence>
		</complexType>
	</element>


	<element name="TipologiaAccessoResponse">
		<complexType>
			<sequence>
				<element name="TipologiaAccesso"
					type="pref:TipologiaAccessoEnumeration">
				</element>
			</sequence>
		</complexType>
	</element>

    <element name="BPMEnrichmentFault" type="tns:Fault"></element>

    <complexType name="Fault">
    	<sequence>
    		<element name="ErrorCode" type="string"></element>
    		<element name="ErrorMessage" type="string"></element>
    	</sequence>
    </complexType>
</schema>