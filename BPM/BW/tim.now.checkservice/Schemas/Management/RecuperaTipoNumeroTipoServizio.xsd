<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio">

    <element name="RecuperaTipoNumTipoServIn">
    	<complexType>
    		<sequence>
                <element name="IdRichiestaOLO" type="string"/>
                <element maxOccurs="unbounded" minOccurs="1" name="NumeroTelefonicoNP">
                	<complexType>
                		<sequence>
                			<element maxOccurs="1" minOccurs="1" name="NumeroTelefonico" type="string"/>
                		</sequence>
                	</complexType>
                </element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RecuperaTipoNumTipoServOut">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="RecuperaTipoNumOutput">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="TipoNumero" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="TipoServizio" type="string">
    						</element>
                            <element minOccurs="0" name="Flag_Attivo" type="string"/>
                            <element minOccurs="0" name="Tipo_Portabilita" type="string"/>
                        </sequence>
    				</complexType>
    			</element>
    			<element name="Oscurato" type="boolean"/>
            </sequence>
    	</complexType>
    </element>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"/>
    			<element name="Messaggio" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
