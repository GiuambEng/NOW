<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:cs="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ErrorCodeManagement/">
    <import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
    <import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../../tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
	<element name="VerificaCongruenzaCausali" type="ecm:verificaCongruenzaCausaliInput"/>
	<element name="VerificaCongruenzaCausaliResponse" type="ecm:verificaCongruenzaCausaliOutput"/>
	<element name="RecuperaCausaliValide" type="ecm:recuperaCausaliValideInput"/>
	<element name="RecuperaCausaliValideResponse" type="ecm:recuperaCausaliValideOutput"/>
	<element name="TrascodificaCausale" type="ecm:trascodificaCausaleInput"/>
	<element name="TrascodificaCausaleResponse" type="ecm:trascodificaCausaleOutput"/>
	<element name="TrascodificaCodiceCausale" type="ecm:trascodificaCodiceCausaleInput"/>
	<element name="TrascodificaCodiceCausaleResponse" type="ecm:trascodificaCodiceCausaleOutput"/>
	<element name="Fault" type="ecm:fault"/>
	<complexType name="verificaCongruenzaCausaliInput">
		<sequence>
			<element name="IdRichiestaNOW" type="string"/>
			<element minOccurs="0" name="Servizio" type="Q1:OffertaEnumeration"/>
			<element name="Lavorazione" type="Q1:LavorazioneEnumeration"/>
			<element name="CodificaOLO_AGCOM" type="cs:CodificaOLOAGCOM"/>
			<element minOccurs="0" name="FlagNPD" type="string"/>
			<element minOccurs="0" name="TipoLinea" type="cs:TipoLinea"/>
			<element name="IDAnagraficaCausale" type="int"/>
			<element name="Fase" type="cs:Fase"/>
		</sequence>
	</complexType>
	<complexType name="verificaCongruenzaCausaliOutput">
		<sequence>
			<element name="Esito" type="ecm:esito"/>
		</sequence>
	</complexType>
	<complexType name="recuperaCausaliValideInput">
		<sequence>
			<element name="IdRichiestaNOW" type="string"/>
			<element minOccurs="0" name="Servizio" type="Q1:OffertaEnumeration"/>
			<element name="Lavorazione" type="Q1:LavorazioneEnumeration"/>
			<element name="CodificaOLO_AGCOM" type="cs:CodificaOLOAGCOM"/>
			<element minOccurs="0" name="FlagNPD" type="string"/>
			<element minOccurs="0" name="TipoLinea" type="cs:TipoLinea"/>
			<element name="Fase" type="cs:Fase"/>
		</sequence>
	</complexType>
	<complexType name="recuperaCausaliValideOutput">
		<sequence>
			<element maxOccurs="unbounded" name="ListaCausaliValide" type="ecm:listaCausali"/>
		</sequence>
	</complexType>
	<complexType name="listaCausali">
		<sequence>
			<element name="IdAnagraficaCausale" type="int" />
			<element name="CodiceCausaleInterna" type="string" />
			<element minOccurs="0" name="DescrizioneCausaleInterna"
				type="string" />
			<element minOccurs="0" name="CodiceCausaleDG" type="string" />
			<element minOccurs="0" name="DescrizioneCausaleDG"
				type="string" />
			<element minOccurs="0" name="CodiceCausaleOLO"
				type="string" />
			<element minOccurs="0" name="DescrizioneCausaleOLO"
				type="string" />
			<element name="Offerta" type="string"></element>
			<element name="TipologiaLavorazione" type="string"></element>
		</sequence>
	</complexType>
	<complexType name="trascodificaCausaleInput">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCausaleOutput">
		<sequence>
			<element name="CodiceCausaleNowDG" type="string"/>
			<element name="CodiceCausaleOLO" type="string"/>
			<element name="DescrizioneCausaleInterna" type="string"/>
			<element name="DescrizioneCausaleNowDG" type="string"/>
			<element name="DescrizioneCausaleOLO" type="string"/>
			<element name="IdAnagraficaCausale" type="string"/>
			<element name="IdCausaleInterno" type="string"/>
			<element minOccurs="0" name="IdFamigliaCausale" type="string"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCodiceCausaleInput">
		<sequence>
			<element name="codiceCausale" type="string"/>
		</sequence>
	</complexType>
	<complexType name="trascodificaCodiceCausaleOutput">
		<sequence>
			<element name="IdAnagraficaCausale" type="int"/>
		</sequence>
	</complexType>
	<complexType name="fault">
		<sequence>
			<element name="CodiceErrore" type="string"/>
			<element name="MessaggioErrore" type="string"/>
		</sequence>
	</complexType>
	<simpleType name="esito">
		<restriction base="string">
			<enumeration value="SCARTO"/>
			<enumeration value="IMPROPRIO"/>
			<enumeration value="ERRATO"/>
			<enumeration value=""/>
		</restriction>
	</simpleType>

    <element name="MonitoraggioCautelare" type="ecm:monitoraggioCautelareInput"/>

    <complexType name="monitoraggioCautelareInput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="1" name="IDRichiestaOLO" type="string" />
    		<element maxOccurs="1" minOccurs="1" name="TipoOperazione">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="INSERT" />
    					<enumeration value="UPDATE" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element maxOccurs="1" minOccurs="1" name="idAnagCaus" type="int" />
    		<element maxOccurs="1" minOccurs="0" name="codCausInternoNew" type="string" />
			<element maxOccurs="1" minOccurs="0" name="descrCausInternoNew" type="string" />
    		<element maxOccurs="1" minOccurs="1" name="TMSTP_AggRichOLO" type="dateTime" />
    		<element maxOccurs="1" minOccurs="0" name="TipologiaLavorazione" type="string" />
    		<element maxOccurs="1" minOccurs="0" name="Offerta" type="string" />
    		<element name="EsitoVerifica" type="string" maxOccurs="1" minOccurs="1" />
    	</sequence>
    </complexType>
    <element name="MonitoraggioCautelareResponse" type="ecm:monitoraggioCautelareOutput" />
    <complexType name="monitoraggioCautelareOutput">
    	<sequence>
    		<element name="Esito" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="Codice" type="string" maxOccurs="1" minOccurs="0" />
    					<element name="DescrizioneErrore" type="string" maxOccurs="1" minOccurs="0" />
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    <complexType name="storicizzaLavorazioneManualeInput">
    	<sequence>
	    	<element name="ID_RchiestaOLO" type="string" maxOccurs="1" minOccurs="1"> </element>
	    	<element name="TipoOperazione" maxOccurs="1" minOccurs="1">
	    		<simpleType>
	    			<restriction base="string">
	    				<enumeration value="INSERT"></enumeration>
	    				<enumeration value="UPDATE"></enumeration>
	    			</restriction>
	    		</simpleType>
	    	</element>
	    	<element name="IDAnagCaus" type="int" maxOccurs="1" minOccurs="1" />
	    	<element name="Lavorazione" type="string" maxOccurs="1" minOccurs="1" />
	    	<element name="CodOLO" type="string" maxOccurs="1" minOccurs="1" />
	    	<element name="EsitoVerifica" type="string" maxOccurs="1" minOccurs="1" />
	    	<element name="CausaleErrore" maxOccurs="1" minOccurs="0" type="string" />
	    	<element name="TipoAzione" maxOccurs="1" minOccurs="0" type="string" />
	    	<element name="Operatore" type="string" maxOccurs="1" minOccurs="0" />
	    	<element name="IDRisorsa" type="string" maxOccurs="1" minOccurs="0" />
	    	<element name="CodificaOLONow" type="string" maxOccurs="1" minOccurs="0" />
	    	<element name="IDOfferta" type="int" maxOccurs="1" minOccurs="0" />
	    	<element name="NoteElaborazione" maxOccurs="1" minOccurs="0">
	    		<simpleType>
	    			<restriction base="string">
	    				<maxLength value="150"></maxLength>
	    			</restriction>
	    		</simpleType>
	    	</element>
    		<element name="Offerta" type="string" maxOccurs="1" minOccurs="0" />
    	</sequence>
    </complexType>
    <complexType name="storicizzaLavorazioneManualeOutput">
    	<sequence>
    		<element name="Codice" type="string" maxOccurs="1" minOccurs="0" />
    		<element name="DescrizioneErrore" type="string" maxOccurs="1" minOccurs="0" />
    	</sequence>
    </complexType>
    <element name="StoricizzaLavorazioneManuale" type="ecm:storicizzaLavorazioneManualeInput"></element>
    <element name="StoricizzaLavorazioneManualeResponse" type="ecm:storicizzaLavorazioneManualeOutput"></element>
</schema>