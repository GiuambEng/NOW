<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
		   xmlns:tns="http://www.tim.com/NOW/xsd/AggiornamentoGiacenza"
		   targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoGiacenza"
		   elementFormDefault="qualified" attributeFormDefault="unqualified" >
    
    <!-- AggiornamentoGiacenzaRequest = RichiestaElemnt -->
    <element name="AggiornamentoGiacenzaResponse" type="tns:Aggiornamento_Giacenza_Response" />
    <element name="AggiornamentoGiacenzaFault" type="tns:Aggiornamento_Giacenza_Fault" />
    <element name="UpdatePPSORDNCHIUSI_Root">
    	<complexType>
			<sequence>
				<element minOccurs="1" ref="tns:Update_PPS_ORDN_CHIUSI"/>
			</sequence>
		</complexType>
    </element>
    
    <complexType name="Aggiornamento_Giacenza_Response">
    	<sequence>
    		<element name="Esito" type="string" maxOccurs="1" minOccurs="0" />
    	</sequence>
    </complexType>
    <complexType name="Aggiornamento_Giacenza_Fault">
   		<sequence>
   			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0" />
			<element name="Msg_Errore" type="string" maxOccurs="1" minOccurs="0" />
   		</sequence>
   	</complexType>
   	<element name="Update_PPS_ORDN_CHIUSI">
	   	<complexType>
	   		<sequence>
	   			<element name="ID_AGCOM_AGGRO" type="int" minOccurs="1" />
	   			<element name="ID_RICH_OLO" type="string" minOccurs="1" />
				<element name="CODFC_OLO_AGCOM" type="string" minOccurs="0" />
				<element name="DATA_CHIUSURA" type="date" minOccurs="0" />
				<element name="FLAG_RIMODULAZIONE_DAC" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="STATO_RICH_OLO" type="string" minOccurs="0" />
				<element name="ID_OFFERTA" type="int" minOccurs="0" />
				<element name="IDTPLG_LAVRZ" type="int" minOccurs="0" />
				<element name="IN_SLA" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="STATO_RICH_NOW" type="string" minOccurs="0" />
				<element name="COD_ORDN_OLO" type="string" minOccurs="0" />
				<element name="CATEGORIA_REPORT_AGCOM" type="string" minOccurs="0" />
				<element name="ID_ANAG_CAUS" type="int" minOccurs="0" />
	   		</sequence>
	   	</complexType>
   	</element>
</schema>