<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:cd1="http://NOW.it.telecomitalia.it/casedata_v1" targetNamespace="http://www.tim.com/NOW/xsd/EsitiMultipli/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" elementFormDefault="qualified">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<element name="EsitiMultipliRequest">
		<complexType>
			<sequence>
				<element name="IdRichiesta" type="string"/>
				<element name="CodiceControllo" type="string"/>
				<element name="EsitoControllo" type="string"/>
				<element name="Offerta" type="cd1:OffertaEnumeration"/>
				<element name="Lavorazione" type="cd1:LavorazioneEnumeration"/>
				<element name="Scenario" type="cd1:TipologiaScenarioEnumeration" minOccurs="0"/>
				<element name="IsPacchetto" type="boolean"/>
			</sequence>
		</complexType>
	</element>
	<element name="EsitiMultipliResponse">
		<complexType>
			<sequence>
				<element name="IdAnagraficaCausale" type="integer" minOccurs="0"/>
				<element name="Esito" type="string"/>
				<element name="DescrizioneErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="EsitiMultipliFault">
		<complexType>
			<sequence>
				<element name="CodiceErrore" type="string" minOccurs="0"/>
				<element name="MessaggioErrore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>