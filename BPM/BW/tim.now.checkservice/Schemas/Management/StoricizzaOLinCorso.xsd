<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/" elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/" >
	
	<xs:element name="StoricizzaOLinCorsoRequest" type="tns:RequestType" />
	<xs:complexType name="RequestType">
		<xs:sequence>
                <xs:element minOccurs="1" type="xs:string" name="IdRisorsaBloccata" />
                <xs:element minOccurs="1" type="xs:string" name="IdOlBloccante" />
				<xs:element minOccurs="1" type="xs:string" name="SistemaCoinvolto" />
				<xs:element minOccurs="0" type="xs:string" name="StatoOlBloccante" />
				<xs:element minOccurs="0" type="xs:string" name="DtEmisOlBloccante" />
				<xs:element minOccurs="0" type="xs:string" name="IdAsset" />
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="StoricizzaOLinCorsoResponse" type="tns:ResponseType" />
	<xs:complexType name="ResponseType">
		<xs:sequence>
				<xs:element minOccurs="1" type="xs:boolean" name="Codice" />
                <xs:element minOccurs="1" type="xs:string" name="Esito" />
		</xs:sequence>
	</xs:complexType>
    
    <xs:element name="StoricizzaOLinCorsoFault" type="tns:FaultType" />
    <xs:complexType name="FaultType">
		<xs:sequence>
		    <xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="CodeMsg" />
			<xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="ErrorMsg" />         
		</xs:sequence>
	</xs:complexType>

</xs:schema>