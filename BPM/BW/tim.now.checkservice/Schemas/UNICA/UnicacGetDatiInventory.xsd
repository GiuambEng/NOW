<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.now/xsd/UnicacGetDatiInventory" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.now/xsd/UnicacGetDatiInventory">
	<element name="REQUEST">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"
					minOccurs="0" />
				<element name="DN" type="string" />
				<element name="distretto" type="string" />
                <element name="Id_Task" type="string" minOccurs="0" maxOccurs="1"></element>
            </sequence>
		</complexType>
	</element>
	<element name="RESPONSE">
		<complexType>
			<sequence>
				<element name="ReperimentoServizioReturn">
					<complexType>
						<sequence>
							<element name="body" maxOccurs="1" minOccurs="0">
								<complexType>
									<sequence>
										<element name="donating" type="string" maxOccurs="1" minOccurs="0"/>
										<element name="flag_Attivo" type="string"/>
										<element name="tipo_linea" maxOccurs="1" minOccurs="0">
											<complexType>
												<sequence>
													<element name="aggiuntivi" maxOccurs="1" minOccurs="0">
														<complexType>
															<sequence>
																<element name="linee" maxOccurs="unbounded" minOccurs="1">
																	<complexType>
																		<sequence>
																			<element name="DN" type="string"/>
																			<element name="stato" type="string"/>
																		</sequence>
																	</complexType>
																</element>
																<element name="qta_aggiuntivi" type="string"/>
															</sequence>
														</complexType>
													</element>
													<element name="caposerie" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="codice_RO" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="flag_TP" type="string"/>
													<element name="flg_num_servizio" type="string"/>
													<element name="BANDA_SERVIZIO" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="TIPO_PORTABILITA" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="principale" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="qta_linee" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="radicale" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="tipo_numero" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="tipo_servizio" type="string" maxOccurs="1" minOccurs="0"/>
													<element name="piattaforma" type="string" maxOccurs="1" minOccurs="0"/>
												</sequence>
											</complexType>
										</element>
										<element name="STS" maxOccurs="1" minOccurs="0">
											<complexType>
												<sequence>
													<element name="Codice_STS" type="string" maxOccurs="unbounded" minOccurs="1"/>
												</sequence>
											</complexType>
										</element>
										<element maxOccurs="1" minOccurs="0" name="CODOLO_CPS" nillable="true" type="string"/>
									</sequence>
								</complexType>
							</element>
							<element name="header">
								<complexType>
									<sequence>
										<element name="desc_esito" type="string" maxOccurs="1" minOccurs="0"/>
										<element name="esito" type="string"/>
										<element name="response_date" type="dateTime"/>
										<element name="transaction_id" type="string"/>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="FAULT">
		<complexType>
			<sequence>
				<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>
