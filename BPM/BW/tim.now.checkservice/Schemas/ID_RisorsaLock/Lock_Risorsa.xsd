<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Lock_Risorsa/" xmlns:Q1="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:Q2="http://NOW.it.telecomitalia.it/casedata_v1" targetNamespace="http://www.tim.com/NOW/xsd/Lock_Risorsa/" elementFormDefault="qualified">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../../tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100"/>
		</restriction>
	</simpleType>
	<element name="Input">
		<complexType>
			<sequence>
				<element name="ID_Risorsa">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>
				<element name="Azione">
					<simpleType>
						<restriction base="string">
							<enumeration value="LOCK" />
							<enumeration value="UNLOCK" />
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_OLO" type="Q1:CodiceOLO"
					minOccurs="0" />
				<element name="CODIFICA_OLO_AGICOM"
					type="Q1:CodificaOLOAGCOM" minOccurs="0" />
				<element name="SERVIZIO" type="Q2:OffertaEnumeration" />
				<element name="ID_RICH_OLO" type="string" minOccurs="0" />
				<element name="Lavorazione" type="string" minOccurs="0" />
				<element name="CodiceOrdineOLO" type="string"
					minOccurs="0" />
				<element name="IdAsset" type="string" minOccurs="0" />
				<element name="NumeroTelefonico" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="IdDettaglioAsset" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
	<element name="Output">
		<complexType>
			<sequence>
				<element name="Esito">
					<complexType>
						<sequence>
							<element name="Codice" type="string"/>
							<element name="Descrizione" type="string"/>
							<element name="Esito" type="boolean"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Messaggio_Errore" type="tns:String100"/>
				<element name="Codice_Errore" type="tns:String100"/>
			</sequence>
		</complexType>
	</element>
	<simpleType name="string150">
		<restriction base="string">
			<maxLength value="50"/>
		</restriction>
	</simpleType>
</schema>
