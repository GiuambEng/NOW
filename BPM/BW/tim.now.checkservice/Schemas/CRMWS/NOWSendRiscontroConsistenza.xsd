<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWSendRiscontroConsistenza/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWSendRiscontroConsistenza/" xmlns:pref="http://www.tim.com/NOW/xsd/CommonSchema/">




	<element name="INPUT">
		<complexType>
			<sequence>
				<element name="Transaction_ID"
					type="tns:transactionType" maxOccurs="1" minOccurs="1">
				</element>
				<element name="Transaction_Date" type="dateTime" maxOccurs="1" minOccurs="1"></element>
				<element name="Return_Code" maxOccurs="1"
					minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="00"></enumeration>
							<enumeration value="01"></enumeration>
							<enumeration value="02"></enumeration>
							<enumeration value="03"></enumeration>
							<enumeration value="04"></enumeration>
							<enumeration value="05"></enumeration>
							<enumeration value="06"></enumeration>
							<enumeration value="07"></enumeration>
							<enumeration value="99"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="Descrizione_Errore"
					type="tns:descrizioneType" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>




	<element name="OUTPUT">
		<complexType>
			<sequence>
				<element name="Transaction_ID" type="tns:transactionType" maxOccurs="1" minOccurs="1"></element>
				<element name="Response_Date" type="dateTime" maxOccurs="1" minOccurs="1"></element>
                <element name="Return_Code" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="OK"></enumeration>
							<enumeration value="KO"></enumeration>
						</restriction>
					</simpleType>
				</element>
                <element name="Descrizione_Errore" type="tns:descrizioneType" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="FAULT">
		<complexType>
			<sequence>
				<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0">
				</element>
				<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>

	<simpleType name="transactionType">
		<restriction base="string">
			<maxLength value="50"></maxLength>
		</restriction>
	</simpleType>

	<simpleType name="descrizioneType">
		<restriction base="string">
			<maxLength value="150"></maxLength>
		</restriction>
	</simpleType>
</schema>