<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/">

    <element name="NOWtoCRMWS_CheckVPKITRequest"
    	type="tns:NOWtoCRMWS_CheckVPKITRequest">
    </element>
    
    <complexType name="NOWtoCRMWS_CheckVPKITRequest">
    	<sequence>
    		<element name="CODICE_OLO" maxOccurs="1" minOccurs="1"
    			type="tns:CODICE_OLO">
    		</element>
    		<element name="CODICE_OLO_AGCOM" maxOccurs="1" minOccurs="1"
    			type="tns:CODICE_OLO_AGCOM">
    		</element>
    		<element name="INFO_VP_KIT" type="tns:INFO_VP_KIT_REQUEST"
    			minOccurs="1" maxOccurs="unbounded">
    		</element>
    		<element name="ID_RICH_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
	<element name="MapperVPKIT">
		<complexType>
			<sequence>
				<element name="INFO_VP_KIT" type="tns:INFO_VP_KIT_REQUEST"/>
				<element name="DatiOut" type="tns:DatiOut" minOccurs="0"/>
			</sequence>
		</complexType>
    </element>
	<complexType name="DatiOut">
		<sequence>
			<element name="ModalitaFatturazione" type="string"
				minOccurs="0" />
			<element name="Tipo" type="string" minOccurs="0" />
			<element name="BandaMCR" type="string" minOccurs="0" />
			<element name="BandaPCR" type="string" minOccurs="0" />
			<element name="Tipo_Trasporto" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="CLLI" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
    <simpleType name="CODICE_OLO">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="CODICE_OLO_AGCOM">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>

    <complexType name="INFO_VP_KIT_REQUEST">
    	<sequence>
            <element name="IdDetOrdine" type="int" maxOccurs="1" minOccurs="0"></element>
            <element name="NUM_VC" type="tns:NUM_VC" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="ID_RISORSA" type="tns:ID_RISORSA"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="TIPO_CONSEGNA" type="tns:TIPO_CONSEGNA"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="FLAG_PRESENZA_NOW"
    			type="tns:FLAG_PESENZA_NOW" maxOccurs="1" minOccurs="1">
    		</element>
    	</sequence>
    </complexType>

    <simpleType name="NUM_VC">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="ID_RISORSA">
    	<restriction base="string">
    		<maxLength value="100"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="TIPO_CONSEGNA">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    		<enumeration value="BandaCondivisa"></enumeration>
    		<enumeration value="BandaDedicata"></enumeration>
    	</restriction>
    </simpleType>

    <simpleType name="FLAG_PESENZA_NOW">
    	<restriction base="string">
    		<maxLength value="1"></maxLength>
    		<enumeration value="Y"></enumeration>
    		<enumeration value="N"></enumeration>
    	</restriction>
    </simpleType>

    <element name="NOWtoCRMWS_CheckVPKITResponse"
    	type="tns:NOWtoCRMWS_CheckVPKITResponse">
    </element>
    
    <complexType name="NOWtoCRMWS_CheckVPKITResponse">
    	<sequence>
    		<element name="ESITO" type="tns:ESITO" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="CODICE_CAUSALE" type="tns:CODICE_CAUSALE"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="DESCRIZIONE_CAUSALE"
    			type="tns:DESCRIZIONE_CAUSALE" maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="INFO_VP_KIT" type="tns:INFO_VP_KIT_RESPONSE"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    		<element name="INFO_VP_KIT_VP" type="tns:INFO_VP_KIT_VP"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    		<element name="INFO_VP_KIT_KIT" type="tns:INFO_VP_KIT_KIT"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    		<element name="TRANSACTION_ID" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="RESPONSE_DATE" type="date" maxOccurs="1" minOccurs="1"></element>
    	</sequence>
    </complexType>

    <simpleType name="ESITO">
    	<restriction base="string">
    		<maxLength value="2"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="CODICE_CAUSALE">
    	<restriction base="string">
    		<maxLength value="2"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="DESCRIZIONE_CAUSALE">
    	<restriction base="string">
    		<maxLength value="150"></maxLength>
    	</restriction>
    </simpleType>

    <complexType name="INFO_VP_KIT_RESPONSE">
    	<sequence>
    		<element name="ID_RISORSA" type="tns:ID_RISORSA_RESPONSE"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="CODICE_CAUSALE"
    			type="tns:CODICE_CAUSALE_RESPONSE" maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="DESCRIZIONE_CAUSALE"
    			type="tns:DESCRIZIONE_CAUSALE_RESPONSE" maxOccurs="1"
    			minOccurs="0">
    		</element>
    	</sequence>
    </complexType>
    <simpleType name="ID_RISORSA_RESPONSE">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>
    <simpleType name="CODICE_CAUSALE_RESPONSE">
    	<restriction base="string">
    		<maxLength value="2"></maxLength>
    	</restriction>
    </simpleType>
    <simpleType name="DESCRIZIONE_CAUSALE_RESPONSE">
    	<restriction base="string">
    		<maxLength value="150"></maxLength>
    	</restriction>
    </simpleType>
    <complexType name="INFO_VP_KIT_VP">
    	<sequence>
    		<element name="ID_RISORSA" type="tns:ID_RISORSA_VP"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="STATO" type="tns:STATO" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="MOD_FATT" type="tns:MOD_FATT" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="TIPO" type="tns:TIPO" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="BANDA_MCR" type="tns:BANDA_MCR" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="BANDA_PCR" type="tns:BANDA_PCR" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="NR_MAX_VC" type="tns:NR_MAX_VC" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="ADR_CODE" type="tns:ADR_CODE" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="DESC_ADR" type="tns:DESC_ADR" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="TD_KIT" type="tns:TD_KIT" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="VPI_RETE" type="tns:VPI_RETE" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="VPI" type="tns:VPI" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="OLO_CODING" type="tns:OLO_CODING"
    			maxOccurs="1" minOccurs="1">
    		</element>
    		<element name="OLO_CODE" type="tns:OLO_CODE" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="TIPO_TRASPORTO" maxOccurs="1"
    			minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="Assente"></enumeration>
    					<enumeration value="Presente"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CLLI" type="tns:CLLI" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="NOME_CENTRALE" type="tns:NOME_CENTRALE"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="DEC_ATT" type="tns:DEC_ATT" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="DEC" type="tns:DEC" maxOccurs="1"
    			minOccurs="1">
    		</element>
    	</sequence>
    </complexType>

    <simpleType name="ID_RISORSA_VP">
    	<restriction base="string">
    		<maxLength value="100"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="STATO">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    		<enumeration value="Active"></enumeration>
    		<enumeration value="Inactive"></enumeration>
    	</restriction>
    </simpleType>


    <simpleType name="TIPO">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    		<enumeration value="Standard"></enumeration>
    		<enumeration value="Special"></enumeration>
    		<enumeration value="Lite"></enumeration>
    	</restriction>
    </simpleType>

    <simpleType name="MOD_FATT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    		<enumeration value="Flat"></enumeration>
    		<enumeration value="Lite"></enumeration>
    		<enumeration value="HL"></enumeration>
    	</restriction>
    </simpleType>

    <simpleType name="BANDA_MCR">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="BANDA_PCR">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="NR_MAX_VC">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="ADR_CODE">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="DESC_ADR">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="TD_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="VPI_RETE">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="VPI">
    	<restriction base="int"></restriction>
    </simpleType>

    <simpleType name="OLO_CODING">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="OLO_CODE">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="TIPO_TRASPORTO">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="CLLI">
    	<restriction base="string">
    		<maxLength value="10"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="NOME_CENTRALE">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="DEC_ATT">
    	<restriction base="date"></restriction>
    </simpleType>

    <simpleType name="DEC">
    	<restriction base="date"></restriction>
    </simpleType>

    <complexType name="INFO_VP_KIT_KIT">
    	<sequence>
    		<element name="TD_KIT" type="tns:TD_KIT_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="STATO" type="tns:STATO_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="DEC_ATT" type="tns:DEC_ATT_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="DEC" type="tns:DEC_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="CLLI_SEDE" type="tns:CLLI_SEDE_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="ADR_CODE" type="tns:ADR_CODE_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="ADR_DESC" type="tns:ADR_DESC_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="OLO_CODING" type="tns:OLO_CODING_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="OLO_CODE" type="tns:OLO_CODE_KIT" maxOccurs="1" minOccurs="1"></element>
    		<element name="TD_KIT_PRIME_CONTRACTOR"
    			type="tns:TD_KIT_PRIME_CONTRACTOR_KIT">
    		</element>
    	</sequence>
    </complexType>

    <simpleType name="TD_KIT_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="STATO_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    		<enumeration value="Active"></enumeration>
    		<enumeration value="Inactive"></enumeration>
    		<enumeration value="Temporary"></enumeration>
    	</restriction>
    </simpleType>

    <simpleType name="DEC_ATT_KIT">
    	<restriction base="date"></restriction>
    </simpleType>

    <simpleType name="DEC_KIT">
    	<restriction base="date"></restriction>
    </simpleType>

    <simpleType name="CLLI_SEDE_KIT">
    	<restriction base="string">
    		<maxLength value="10"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="ADR_CODE_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="ADR_DESC_KIT">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="OLO_CODING_KIT">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="OLO_CODE_KIT">
    	<restriction base="string">
    		<maxLength value="3"></maxLength>
    	</restriction>
    </simpleType>
    
    <simpleType name="TD_KIT_PRIME_CONTRACTOR_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <element name="NOWtoCRMWS_CheckVPKITFault">
    	<complexType>
    		<sequence>
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>