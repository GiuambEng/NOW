<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckLavorabilitaDN/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckLavorabilitaDN/">

    <element name="REQUEST">
    	<complexType>
    		<sequence>
    			<element name="NUMERAZIONE_TELEFONICA"
    				maxOccurs="unbounded" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="15"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_RICH_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RESPONSE">
    	<complexType>
    		<sequence>
    			<element name="TRANSACTION_ID" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="RESPONSE_DATE" type="dateTime"></element>
    			<element name="RETURN_CODE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DESCRIZIONE_ERRORE" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="150"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DN" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="15"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_ORDINE" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="15"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="FAULT">
    	<complexType>
    		<sequence>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>