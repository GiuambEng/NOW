<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract" 
	xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract" 
	xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" />
    <element name="REQUEST">
    	<complexType>
    		<sequence>
    			<element name="CODICE_OLO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_OLO_CRMWS" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="SERVIZIO" maxOccurs="1" minOccurs="1" type="Q1:OffertaEnumeration" />
    			<element name="ID_RICH_OLO" type="string" maxOccurs="1" minOccurs="0" />
    		</sequence>
    	</complexType>
    </element>
    <element name="RESPONSE">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="TRANSACTION_ID">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="RESPONSE_DATE" type="dateTime" />
    			<element maxOccurs="1" minOccurs="1" name="RETURN_CODE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DESCRIZIONE_ERRORE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="150" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CONTRATTO" type="tns:ContractResponseType" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <complexType name="ContractResponseType">
    	<sequence>
    		<element name="AGREE_NUMBER" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="9"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="AGREE_ID_CRMWS" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="15" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="AGREE_NAME" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CODICE_OLO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CODICE_OLO_CRMWS" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="STATO_CONTRATTO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DATA_INIZIO_VALIDITA" type="date" maxOccurs="1" minOccurs="1" />
    		<element name="DATA_FINE_VALIDITA" type="date" maxOccurs="1" minOccurs="0" />
    		<element name="VALID_FLG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    					<enumeration value="Y"></enumeration>
    					<enumeration value="N"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="NPD_FLG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    					<enumeration value="Y"></enumeration>
    					<enumeration value="N"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DIFFIDATO_FLG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="AMBITO">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="ANFIBIO_FLG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="STANDARD_FLG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="STATO_STANDARD" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="NOME_STANDARD" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="FILE_NOTIFY_FLAG" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1"></maxLength>
    					<enumeration value="Y"></enumeration>
    					<enumeration value="N"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CODE_TIPO_CONTRATTO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="TIPO_CONTRATTO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="SERVIZIO" maxOccurs="1" minOccurs="1" type="Q1:OffertaEnumeration"/>
    		<element name="ID_CONTRATTO_PADRE" type="string" maxOccurs="1" minOccurs="0" />
    		<element name="FLAG_ABILITATO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="1" />
    					<enumeration value="Y" />
    					<enumeration value="N" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="TIPO" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="30"></maxLength>
    					<enumeration value="Service Level Agreement" />
    					<enumeration value="Contract" />
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CUSTOMER" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="4"/>
					</restriction>
				</simpleType>
			</element>
    	</sequence>
    </complexType>
    <simpleType name="dateType">
    	<restriction base="date">
    		<pattern value="\d\d\d\d\d\d\d\d"></pattern>
    	</restriction>
    </simpleType>
    <element name="FAULT">
    	<complexType>
    		<sequence>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0" />
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0" />
    		</sequence>
    	</complexType>
    </element>
    <simpleType name="dateTimeType">
    	<restriction base="dateTime">
    		<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"></pattern>
    	</restriction>
    </simpleType> 
    <element name="TrascodificaOfferta">
	    <complexType>
		    <sequence>
		    	<element name="OffertaCRMWS" minOccurs="1" maxOccurs="1" type="string"/>
		    	<element name="OffertaBPM" minOccurs="1" maxOccurs="1" type="string"/>
		    </sequence>
	    </complexType>
    </element>
</schema>