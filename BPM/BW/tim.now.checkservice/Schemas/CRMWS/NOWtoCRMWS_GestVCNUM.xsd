<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GestVCNUM/" targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GestVCNUM/" elementFormDefault="qualified">
	<element name="NOWtoCRMWS_GestVCNUMRequest" type="tns:NOWtoCRMWS_GestVCNUMRequest"/>
	<complexType name="NOWtoCRMWS_GestVCNUMRequest">
		<sequence>
			<element name="COD_OLO" type="tns:CODICEOLO"/>
			<element name="COD_OLOAGCOM" type="tns:CODICEOLOAGCOM"/>
			<element name="MODALITA" type="tns:STATO"/>
			<element name="REQUEST_VPKIT" maxOccurs="unbounded">
				<complexType>
					<complexContent>
						<extension base="tns:REQUEST_VPKIT"/>
					</complexContent>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<simpleType name="VP_CODE">
		<restriction base="string"/>
	</simpleType>
	<simpleType name="TD_CODE">
		<restriction base="string"/>
	</simpleType>
	<simpleType name="CODICEOLO">
		<restriction base="int"/>
	</simpleType>
	<simpleType name="CODICEOLOAGCOM">
		<restriction base="string">
			<maxLength value="3"/>
		</restriction>
	</simpleType>
	<complexType name="REQUEST_VPKIT">
		<sequence>
			<element name="NUM_VC" type="tns:NUM_VC"/>
			<choice>
				<element name="VP_CODE" type="tns:VP_CODE" minOccurs="0"/>
				<element name="TD_CODE" type="tns:TD_CODE" minOccurs="0"/>
			</choice>
			<element name="TIPO_CONSEGNA" type="tns:TIPO_CONSEGNA"/>
		</sequence>
	</complexType>
	<simpleType name="NUM_VC">
		<restriction base="int"/>
	</simpleType>
	<simpleType name="ID_RISORSA">
		<restriction base="string">
			<maxLength value="100"/>
		</restriction>
	</simpleType>
	<simpleType name="TIPO_CONSEGNA">
		<restriction base="string">
			<maxLength value="30"/>
			<enumeration value="BandaCondivisa"/>
			<enumeration value="BandaDedicata"/>
		</restriction>
	</simpleType>
	<simpleType name="STATO">
		<restriction base="string">
			<maxLength value="30"/>
			<enumeration value="ATTIVATO"/>
			<enumeration value="ANNULLATO"/>
			<enumeration value="SCARTATO"/>
			<enumeration value="CESSATO"/>
		</restriction>
	</simpleType>
	<element name="NOWtoCRMWS_GestVCNUMResponse" type="tns:NOWtoCRMWS_GestVCNUMResponse"/>
	<complexType name="NOWtoCRMWS_GestVCNUMResponse">
		<sequence>
			<element name="ESITO" type="tns:ESITO"/>
			<element name="CODICE_CAUSALE" type="tns:CODICE_CAUSALE"/>
			<element name="DESCRIZIONE_CAUSALE" type="tns:DESCRIZIONE_CAUSALE"/>
			<element name="RESPONSE_INFOVPKIT" type="tns:RESPONSE_INFOVPKIT" maxOccurs="unbounded"/>
			<element name="TRANSACTION_ID">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element name="RESPONSE_DATE" type="date"/>
		</sequence>
	</complexType>
	<simpleType name="ESITO">
		<restriction base="string">
			<maxLength value="2"/>
			<enumeration value="OK"/>
			<enumeration value="KO"/>
		</restriction>
	</simpleType>
	<simpleType name="CODICE_CAUSALE">
		<restriction base="string">
			<maxLength value="2"/>
			<enumeration value="00"/>
			<enumeration value="99"/>
		</restriction>
	</simpleType>
	<simpleType name="DESCRIZIONE_CAUSALE">
		<restriction base="string">
			<maxLength value="150"/>
		</restriction>
	</simpleType>
	<complexType name="RESPONSE_INFOVPKIT">
		<sequence>
			<element name="ID_RISORSA" type="tns:ID_RISORSA"/>
			<element name="CODICE_CAUSALE" type="tns:CODICE_CAUSALE"/>
			<element name="DESCRIZIONE_CAUSALE" type="tns:DESCRIZIONE_CAUSALE" minOccurs="0"/>
		</sequence>
	</complexType>
	<element name="NOWtoCRMWS_GestVCNUMFault">
		<complexType>
			<sequence>
				<element name="Messaggio_Errore" type="string" minOccurs="0"/>
				<element name="Codice_Errore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>
