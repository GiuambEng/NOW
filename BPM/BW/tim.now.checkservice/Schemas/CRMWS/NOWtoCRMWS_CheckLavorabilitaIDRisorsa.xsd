<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckLavorabilitaIDRisorsa/"
	elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckLavorabilitaIDRisorsa/"
	xmlns:Q1="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:Q2="http://NOW.it.telecomitalia.it/casedata_v1">

    <import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
    <import schemaLocation="../../../tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd" namespace="http://www.tim.com/NOW/xsd/CommonSchema/"></import>
	<element name="REQUEST">
		<complexType mixed="false">
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="CODICE_OLO"
					type="Q1:CodiceOLO">

				</element>
				<element maxOccurs="1" minOccurs="1"
					name="CODIFICA_OLO_AGICOM" type="Q1:CodificaOLOAGCOM">

				</element>
				<element maxOccurs="1" minOccurs="1"
					name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="ID_UNIVOCO_NOW" type="int" />
				<element maxOccurs="1" minOccurs="1" name="SERVIZIO"
					type="Q2:OffertaEnumeration">

				</element>

				<element name="ID_RICHIESTA_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
	<element name="RESPONSE">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1"
					name="TRANSACTION_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>
				<element name="RESPONSE_DATE" type="dateTime" />
				<element maxOccurs="1" minOccurs="1"
					name="RETURN_CODE">
					<simpleType>
						<restriction base="string">
							<maxLength value="2" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0"
					name="DESCRIZIONE_ERRORE">
					<simpleType>
						<restriction base="string">
							<maxLength value="150" />
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="ID_ORDINE">
					<simpleType>
						<restriction base="string">
							<maxLength value="50" />
						</restriction>
					</simpleType>
				</element>

			</sequence>
		</complexType>
	</element>
	<element name="FAULT">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0"
					name="Codice_Errore" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0"
					name="Messaggio_Errore" type="string">
				</element>
			</sequence>
		</complexType>
	</element>




	<simpleType name="dateType">
		<restriction base="dateTime">
			<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d" />
		</restriction>
	</simpleType>
</schema>
