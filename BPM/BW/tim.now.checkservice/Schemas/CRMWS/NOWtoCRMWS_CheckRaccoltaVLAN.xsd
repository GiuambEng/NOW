<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/">
    <element name="NOWtoCRMWS_CheckRaccoltaVLANRequest" type="tns:NOWtoCRMWS_CheckRaccoltaVLANRequest"/>
    <complexType name="NOWtoCRMWS_CheckRaccoltaVLANRequest">
    	<sequence>
    		<element maxOccurs="1" minOccurs="1" name="CODICE_OLO"
    			type="tns:CODICEOLO" />
    		<element maxOccurs="1" minOccurs="1" name="CODICE_OLOAGCOM"
    			type="tns:CODIFICAOLOAGCOM">
    		</element>
    		<element maxOccurs="4" minOccurs="1" name="INFO_VLAN"
    			type="tns:INFO_VLAN" />
    		<element name="ID_RICH_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <simpleType name="CODICEOLO">
    	<restriction base="string">
    		<maxLength value="3"/>
    	</restriction>
    </simpleType>
    <simpleType name="CODIFICAOLOAGCOM">
    	<restriction base="string">
    		<maxLength value="3"/>
    	</restriction>
    </simpleType>
    <complexType name="INFO_VLAN">
    	<sequence>
    		<element maxOccurs="1" minOccurs="1" name="CVLAN_ID" type="tns:CVLAN_ID"/>
    		<element maxOccurs="1" minOccurs="1" name="SVLAN_COD" type="tns:SVLAN_CODE"/>
    		<element maxOccurs="1" minOccurs="0" name="ID_RISORSA" type="tns:ID_RISORSA"/>
    		<element maxOccurs="1" minOccurs="1" name="VERIFICA_SUB_CONTRACTOR" type="tns:VERIFICA_SUB_CONTRACTOR">
    		</element>
    	</sequence>
    </complexType>
    <simpleType name="CVLAN_ID">
    	<restriction base="int"/>
    </simpleType>
    <simpleType name="SVLAN_CODE">
    	<restriction base="string">
    		<maxLength value="16"/>
    	</restriction>
    </simpleType>
    <simpleType name="ID_RISORSA">
    	<restriction base="string">
    		<maxLength value="16"/>
    	</restriction>
    </simpleType>
    <simpleType name="VERIFICA_SUB_CONTRACTOR">
    	<restriction base="string">
    		<maxLength value="1"/>
    		<enumeration value="Y"/>
    		<enumeration value="N"/>
    	</restriction>
    </simpleType>
    <element name="NOWtoCRMWS_CheckRaccoltaVLANResponse" type="tns:NOWtoCRMWS_CheckRaccoltaVLANResponse"/>
    <complexType name="NOWtoCRMWS_CheckRaccoltaVLANResponse">
    	<sequence>
    		<element name="ESITO" type="tns:ESITO" maxOccurs="1"
    			minOccurs="1">
    		</element>
    		<element name="CODICE_CAUSALE" type="tns:CODICE_CAUSALE" maxOccurs="1" minOccurs="1"/>
    		<element name="DESCRIZIONE_CAUSALE" type="tns:DESCRIZIONE_CAUSALE" maxOccurs="1" minOccurs="0"/>
    		<element name="RESPONSE_INFO_VLAN" type="tns:RESPONSE_INFO_VLAN" maxOccurs="4" minOccurs="0"/>
    		
    	</sequence>
    </complexType>
        <simpleType name="ESITO"> 		
	    	<restriction base="string">
		    	<maxLength value="2"/>
		    	<enumeration value="OK"/>
		    	<enumeration value="KO"/>
		    </restriction>
    	</simpleType>
        <simpleType name="CODICE_CAUSALE">
        	<restriction base="string">
        	</restriction>
        </simpleType>
        <simpleType name="DESCRIZIONE_CAUSALE">
        	<restriction base="string">
        		<maxLength value="150"/>
        	</restriction>
        </simpleType>
        <complexType name="RESPONSE_INFO_VLAN">
        	<sequence>
        		<element name="CVLAN_ID" type="tns:CVLAN_ID" maxOccurs="1" minOccurs="1"/>
        		<element name="SVLAN_CODE" type="tns:SVLAN_CODE" maxOccurs="1" minOccurs="1"/>
        		<element name="CODICE_CAUSALE" type="tns:COD_CAUSALE" maxOccurs="1" minOccurs="1"/>
        		<element name="DESCRIZIONE_CAUSALE" type="tns:DESCRIZIONE_CAUSALE" minOccurs="0"/>
        		<element name="INFO_VLAN" type="tns:INF_VLAN" maxOccurs="1" minOccurs="0"/>
        	</sequence>
        </complexType>
        <simpleType name="COD_CAUSALE">
        	<restriction base="string">
        		<maxLength value="2"></maxLength>
        	</restriction>
        </simpleType>
        <simpleType name="DESCR_CAUSALE">
        	<restriction base="string">
        		<maxLength value="150"></maxLength>
        	</restriction>
        </simpleType>

        <complexType name="INF_VLAN">
        	<sequence>
        		<element name="IDVLAN" type="tns:IDVLAN" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="TIPO_BANDA" type="tns:TIPO_BANDA"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="TIPO_COS" type="tns:TIPO_COS"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="CODIFICAOLOAGCOM"
        			type="tns:CODIFICAOLOAGCOM" maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="COD_OLO" type="tns:CODICEOLO"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="OLO_CODING_SUB" type="tns:OLO_CODING_SUB"
        			minOccurs="0">
        		</element>
        		<element name="OLO_CODE_SUB" type="tns:OLO_CODE_SUB"
        			minOccurs="0">
        		</element>
        		<element name="STATO_SUB" minOccurs="0">
        			<simpleType>
        				<restriction base="tns:STATO_SUB">
        					<enumeration value="ACTIVE"></enumeration>
        					<enumeration value="INACTIVE"></enumeration>
        				</restriction>
        			</simpleType>
        		</element>
        		<element name="DATA_ATTIVAZIEONE_SUB"
        			type="tns:DATA_ATTIVAZIEONE_SUB" minOccurs="0">
        		</element>
        		<element name="DATA_CESSAZIONE_SUB"
        			type="tns:DATA_CESSAZIONE_SUB" minOccurs="0">
        		</element>
        		<element name="ENCAPSULATION" type="tns:ENCAPSULATION"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="TIPOLOGIA " type="tns:TIPOLOGIA"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="STATO" type="tns:STATO" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="NOME" type="tns:NOME" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="CLLI" type="tns:CLLI" maxOccurs="1"
        			minOccurs="1">

        		</element>
        		<element name="NOME_CENTRALE" type="tns:NOME_CENTRALE"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="TD_KIT" type="tns:TD_KIT" maxOccurs="1"
        			minOccurs="1">

        		</element>
        		<element name="DEC_ATT" type="tns:DEC_ATT" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="DEC" type="tns:DEC" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="ADR_CODE" type="tns:ADR_CODE"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="ADR_DESC" type="tns:ADR_DESC"
        			maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="MACRO_AREA_CODE"
        			type="tns:MACRO_AREA_CODE" maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="MACRO_AREA_DESC"
        			type="tns:MACRO_AREA_DESC" maxOccurs="1" minOccurs="1">
        		</element>
        		<element name="SUPER_MACRO_AREA_CODE"
        			type="tns:SUPER_MACRO_AREA_CODE" minOccurs="0">
        		</element>
        		<element name="SUPER_MACRO_AREA_DESC"
        			type="tns:SUPER_MACRO_AREA_DESC" minOccurs="0">
        		</element>
        		<element name="TIPO_TRASPORTO" type="tns:TIPO_TRASPORTO"
        			minOccurs="0">

        		</element>
        		<element name="IDVLANOLO" type="tns:IDVLANOLO"
        			minOccurs="0">
        		</element>
        		<element name="FLAG_VLAN_TRANSLATION"
        			type="tns:FLAG_VLAN_TRANSLATION" maxOccurs="1"
        			minOccurs="1">
        		</element>
        		<element name="DSLAM_TYPE" type="tns:DSLAM_TYPE"
        			minOccurs="0">
        		</element>
        		<element name="CUSTOMER" type="string" maxOccurs="1" minOccurs="0"></element>
        		<element name="BMC_LIGHT" type="string" maxOccurs="1" minOccurs="0"></element>
        		<element name="INTERMEDIATE_AGENT" type="string" maxOccurs="1" minOccurs="0"></element>
        		<element name="TIPOLOGIA_CLUSTER_VLAN" type="string" maxOccurs="1" minOccurs="0"></element>
        		<element name="TIPOLOGIA_CLUSTER_VLAN_OLD" type="string" maxOccurs="1" minOccurs="0"></element>
        		<element name="FLAG_FTTH_ONLY" type="string" maxOccurs="1" minOccurs="0"></element>
        	</sequence>
        </complexType>

        <simpleType name="IDVLAN">
        	<restriction base="string">
        		<maxLength value="100"></maxLength>
        	</restriction>
        </simpleType>

        <simpleType name="TIPO_BANDA">
        	<restriction base="string">
        		<enumeration value="MULTICOS"></enumeration>
        		<enumeration value="MONOCOS"></enumeration>
        		<maxLength value="30"></maxLength>
        	</restriction>
        </simpleType>


        <simpleType name="TIPO_COS">
        	<restriction base="string">
        		<maxLength value="5"></maxLength>
        		<enumeration value="BMD"></enumeration>
        		<enumeration value="BMC"></enumeration>
        		<enumeration value="0"></enumeration>
        		<enumeration value="1"></enumeration>
        		<enumeration value="2"></enumeration>
        		<enumeration value="3"></enumeration>
        		<enumeration value="5"></enumeration>
        	</restriction>
        </simpleType>

        <simpleType name="OLO_CODING_SUB">
        	<restriction base="string">
        		<maxLength value="3"></maxLength>
        	</restriction>
        </simpleType>

        <simpleType name="OLO_CODE_SUB">
        	<restriction base="string">
        		<maxLength value="3"></maxLength>
        	</restriction>
        </simpleType>


        <simpleType name="STATO_SUB">
        	<restriction base="string">
        		<maxLength value="30"></maxLength>
        	</restriction>
        </simpleType>

        <simpleType name="DATA_ATTIVAZIEONE_SUB">
        	<restriction base="date"></restriction>
        </simpleType>

        <simpleType name="DATA_CESSAZIONE_SUB">
        	<restriction base="date"></restriction>
        </simpleType>


        <simpleType name="ENCAPSULATION">
        	<restriction base="string">
        		<maxLength value="1"></maxLength>
        	</restriction>
        </simpleType>

        <simpleType name="TIPOLOGIA ">
        	<restriction base="string">
        		<enumeration value="NGA"></enumeration>
        		<enumeration value="GBE"></enumeration>
        		<enumeration value="VULA"></enumeration>
        	</restriction>
        </simpleType>

        <simpleType name="STATO">
        	<restriction base="string">
        		<maxLength value="30"></maxLength>
        		<enumeration value="ACTIVE"></enumeration>
        		<enumeration value="INACTIVE"></enumeration>
        	</restriction>
        </simpleType>

        <simpleType name="NOME">
        	<restriction base="string">
        		<maxLength value="300"></maxLength>
        	</restriction>
        </simpleType>


    <simpleType name="NOME_CENTRALE">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="TD_KIT">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="DEC_ATT">
    	<restriction base="date"></restriction>
    </simpleType>

    <simpleType name="DEC">
    	<restriction base="date"></restriction>
    </simpleType>

    <simpleType name="ADR_CODE">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>


    <simpleType name="CLLI">
    	<restriction base="string">
    		<maxLength value="10"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="ADR_DESC">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="MACRO_AREA_CODE">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="MACRO_AREA_DESC">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>


    <simpleType name="SUPER_MACRO_AREA_CODE">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="SUPER_MACRO_AREA_DESC">
    	<restriction base="string">
    		<maxLength value="255"></maxLength>
    	</restriction>
    </simpleType>


    <simpleType name="TIPO_TRASPORTO">
    	<restriction base="string">
    		<maxLength value="5"></maxLength>
    		<enumeration value="L1"></enumeration>
    		<enumeration value="L2"></enumeration>
    		<enumeration value="LD"></enumeration>
    	</restriction>
    </simpleType>

    <simpleType name="IDVLANOLO">
    	<restriction base="string">
    		<maxLength value="30"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="FLAG_VLAN_TRANSLATION">
    	<restriction base="string">
    		<enumeration value="Y"></enumeration>
    		<enumeration value="N"></enumeration>
    		<maxLength value="1"></maxLength>
    	</restriction>
    </simpleType>

    <simpleType name="DSLAM_TYPE">
    	<restriction base="string">
    		<maxLength value="2"></maxLength>
    		<enumeration value="01"></enumeration>
    		<enumeration value="02"></enumeration>
    		<enumeration value="03"></enumeration>
    		<enumeration value="04"></enumeration>
    		<enumeration value="05"></enumeration>
    		<enumeration value="06"></enumeration>
    		<enumeration value="07"></enumeration>
    		<enumeration value="08"></enumeration>
    	</restriction>
    </simpleType>

    <element name="NOWtoCRMWS_CheckRaccoltaVLANFault">
    	<complexType>
    		<sequence>
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>