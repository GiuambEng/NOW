<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/" targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/" elementFormDefault="qualified">
	<element name="REQUEST">
		<complexType>
			<sequence>
				<element name="TRANSACTION_DATE">
					<simpleType>
						<restriction base="dateTime"/>
					</simpleType>
				</element>
				<element name="TRANSACTION_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CODICE_ORDINE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element ref="tns:RISORSE" maxOccurs="unbounded"/>
				<element name="ID_RICH_OLO" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="RISORSE">
		<complexType>
			<sequence>
				<element name="ID_RISORSA" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="DN" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="ID_CRMWS" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="ID_NOW" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
				<element name="LAVORAZIONE" minOccurs="0">
					<simpleType>
						<restriction base="string"/>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="RESPONSE">
		<complexType>
			<sequence>
				<element name="TRANSACTION_ID">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="RESPONSE_DATE" type="dateTime"/>
				<element name="CODICE_ORDINE_OLO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="RETURN_CODE">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE_ERRORE" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="150"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_RISORSA">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DN" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="15"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_ORDINE" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="15"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="FAULT">
		<complexType>
			<sequence>
				<element name="Codice_Errore" type="string" minOccurs="0"/>
				<element name="Messaggio_Errore" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>
