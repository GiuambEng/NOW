<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:tibex="http://www.tibco.com/bpel/2007/extensions" xmlns:tns="http://www.example.com/namespaces/tns/1631545004377" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://www.example.com/namespaces/tns/1631545004377">
  <xsd:element name="DataOrdine">
    <xsd:simpleType>
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="(0[1-9]|1[0-9]|2[0-9]|3[0-1])[/](0[1-9]|1[1-2])[/]((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))"></xsd:pattern>
        </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="OraCutOver">
    <xsd:simpleType>
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="(0[0-9]|1[0-9]|2[0-3])[:]([0-5])([0-9])"></xsd:pattern>
        </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
</xsd:schema>