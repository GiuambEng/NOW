<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/JiveVerificaIndirizzo" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/JiveVerificaIndirizzo">
    	<complexType name="Testata">
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_id">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"/>
    						<minLength value="1"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="Transaction_date" type="tns:dateTimeType2"/>
    			<element maxOccurs="1" minOccurs="1" name="Sistema_origine">
    				<simpleType>
    					<restriction base="string">
    						<minLength value="1" />
    						<maxLength value="50" />
    						<enumeration value="NOW"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    	<complexType name="Codice">
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				name="CODICE_TOPONOMASTICA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    	<complexType name="Indirizzo">
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				name="DESC_PART_TOPON">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DESC_VIA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="DESC_LOCALITA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="CAP">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="13"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="PROVINCIA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="CIVICO">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="70"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="ISTAT_COMUNE">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    <element name="Request" type="tns:Request_type"/>
   	<complexType name="Request_type">
   		<sequence>
   			<element name="Testata" type="tns:Testata"/>
   			<element name="Codice" type="tns:Codice"/>
   			<element name="Indirizzo" type="tns:Indirizzo"/>
        </sequence>
   	</complexType>


    <element name="Response">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="Request" type="tns:Request_type"/>
    			<element minOccurs="1" name="ESITO" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="cod_Err">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="C0001"/>
    						<enumeration value="C0002"/>
    						<enumeration value="C0003"/>
    						<enumeration value="00003"/>
    						<enumeration value="30765"/>
    						<enumeration value="30761"/>
    						<enumeration value="C9999"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="desc_Err">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value=" Indirizzo non attestato a centrale GAT"/>
    						<enumeration value="Indirizzo con civico non censito"/>
    						<enumeration value="Indirizzo attestato a più una centrale GAT"/>
    						<enumeration value="Campo obbligatorio mancante"/>
    						<enumeration value="Indirizzo Errato - Via sconosciuta"/>
    						<enumeration value="Indirizzo Errato - Comune sconosciuto"/>
    						<enumeration value="ERRORE GENERICO"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="INSTAT_PROV">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="SIGLA_PROV">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="PROVINCIA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="INSTAT_COMUNE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DISTRETTO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DESC_LOCALITA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="COD_VIA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="9"/>
    					</restriction>
    				</simpleType>
    			</element>
                <element maxOccurs="1" minOccurs="0" name="DESC_PART_TOPON">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"/>
    					</restriction>
    				</simpleType>
    			</element>
                <element maxOccurs="1" minOccurs="0" name="DESC_VIA">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="CIVICO">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="70"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="ADC">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="GAT">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="CCLI">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="CAP">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="13"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FLAG_OPA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="LATITUDINE">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="LONGITUDINE">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="TIPO_FONTE">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="TIPO_CATEGORIA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="PRECISIONE">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="20"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DR">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="CODICE_TOPONOMATICA">

    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Descrizione_errore">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="150"/>
    		</restriction>
    	</simpleType>
  </element>

    <element name="ID_ORDINE">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="50"/>
    		</restriction>
    	</simpleType>
  </element>
    <element name="Messaggio_Errore" type="string"/>

    <element name="Codice_Errore" type="string"/>
    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element ref="tns:Messaggio_Errore"/>
    			<element ref="tns:Codice_Errore"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="CODICE_OLO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"/>
    		</restriction>
    	</simpleType>
    </element>

    <element name="CODICE_OLO_CRMWS">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="3"/>
    		</restriction>
    	</simpleType>
    </element>

    <element name="ID_UNIVOCO_NOW" type="int"/>

    <element name="SERVIZIO">
    	<simpleType>
    		<restriction base="string">
    			<maxLength value="100"/>
    		</restriction>
    	</simpleType>
  </element>

    <simpleType name="dateTimeType2">
    	<restriction base="string">
    		<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"></pattern>
    	</restriction>
    </simpleType>
</schema>
