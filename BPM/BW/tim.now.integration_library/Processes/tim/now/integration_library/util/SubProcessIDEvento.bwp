                    &lt;/ID_SISTEMA_MITTENTE>&#xa;                &lt;/tns1:StoricizzaEventoOrdnNowWhlsRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:StoricizzaEventoOrdnNowWhlsRequest>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;'FATTURAZIONE EMISSIONE'&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ID_Evento_Ordn_NowIn.INPUT/tns:IDRichOLO&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;ID_SISTEMA_DESTNRIO>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/ID_SISTEMA_DESTNRIO>&#xa;                    &lt;ID_SISTEMA_MITTENTE>&#xa;                        &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                    &lt;/ID_SISTEMA_MITTENTE>&#xa;                &lt;/tns1:StoricizzaEventoOrdnNowWhlsRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
