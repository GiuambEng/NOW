                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE PREVENTIVO&#xa;  SET TIMSTP_AGGTO = ?, STATO_PREVENTIVO = 'INACCETTAZIONE', IMPORTO_TOT = ?&#xa;  WHERE (ID_RICH_OLO = ? and STATO_PREVENTIVO = 'INELABORAZIONE') or (ID_PREVENTIVO = ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
