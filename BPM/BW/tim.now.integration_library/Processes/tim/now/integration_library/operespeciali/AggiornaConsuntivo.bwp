                                    sqlStatement="UPDATE DETT_CONSUNTIVO&#xa;&#x9;SET IMPORTO_ARTICOLO = ? &#xa;&#x9;WHERE ID_CONSUNTIVO = ? AND ID_DETT_CONSUNTIVO = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
