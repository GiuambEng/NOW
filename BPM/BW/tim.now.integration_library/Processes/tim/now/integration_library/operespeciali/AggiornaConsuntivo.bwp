                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c1244c48-79e1-4ee7-a105-f57d24b8a5c7+input&quot; xmlns:tns1=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdateStatoCons-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;IMPORTO_TOT>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:ImportoTotale)&quot;/>&lt;/IMPORTO_TOT>&lt;ID_CONSUNTIVO>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:idConsuntivo)&quot;/>&lt;/ID_CONSUNTIVO>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CONSUNTIVO&#xa;  SET IMPORTO_TOT = ?&#xa;  WHERE ID_CONSUNTIVO = ? AND ID_RICH_OLO = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
