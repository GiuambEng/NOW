                        <bpws:sources>
                            <bpws:source linkName="UpdateDettaglioConsuntivoToGroupEnd"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+530c88fa-3111-4e9d-90af-1780eb40b4c6+input&quot; xmlns:tns1=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateDettaglioConsuntivo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Start/tns1:DettagliJPUB&quot;>&lt;Record>&lt;IMPORTO_ARTICOLO>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ImportoArticolo)&quot;/>&lt;/IMPORTO_ARTICOLO>&lt;ID_CONSUNTIVO>&lt;xsl:value-of select=&quot;xsd:int(../tns1:idConsuntivo)&quot;/>&lt;/ID_CONSUNTIVO>&lt;ID_DETT_CONSUNTIVO>&lt;xsl:value-of select=&quot;xsd:int(tns1:IdDettaglio)&quot;/>&lt;/ID_DETT_CONSUNTIVO>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
