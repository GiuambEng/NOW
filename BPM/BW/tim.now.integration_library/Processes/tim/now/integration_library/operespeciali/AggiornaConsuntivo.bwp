                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_CONSUNTIVO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_DETT_CONSUNTIVO"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
            </bpws:flow>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogIn-input"
