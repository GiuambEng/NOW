                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EVENTO_ORDN_NOW_WHLS (ID_EVENTO_ORDN_NOW_WHLS,&#xa;  ID_LAVRZ_APPLBLE_ORDN, ID_RICH_DTU, ID_RICH_OLO, ID_SISTEMA_DESTNRIO,&#xa;  ID_SISTEMA_MITTENTE, IDTPLG_EVENTO, TIMSTP_AGGTO, TIMSTP_INSMTO_EVENTO)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_LAVRZ_APPLBLE_ORDN"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_DTU"/>
                                    <PreparedParameters
                                    DataType="-9"
                                    DataTypeDisplayValue="NVARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_SISTEMA_DESTNRIO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_SISTEMA_MITTENTE"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDTPLG_EVENTO"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO_EVENTO"/>
                                    </value>
