n>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:CODICESPLITTERSECONDARIO) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;>&#xa;                            &lt;CODICE_SPLITTER_SECONDARIO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;/>&#xa;                            &lt;/CODICE_SPLITTER_SECONDARIO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ROE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ROE&quot;>&#xa;                            &lt;CODICE_ROE>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ROE&quot;/>&#xa;                            &lt;/CODICE_ROE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONESPLITTER) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONESPLITTER&quot;>&#xa;                            &lt;POSIZIONE_SPLITTER>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONESPLITTER&quot;/>&#xa;                            &lt;/POSIZIONE_SPLITTER>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONEMORSETTIERAROE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONEMORSETTIERAROE&quot;>&#xa;                            &lt;POSIZIONE_MORSETTIERA_ROE>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:POSIZIONEMORSETTIERAROE&quot;/>&#xa;                            &lt;/POSIZIONE_MORSETTIERA_ROE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:RADICALE)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;>&#xa;                            &lt;RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;/>&#xa;                            &lt;/RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;>&#xa;                            &lt;CODICE_PIATTAFORMA>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;/>&#xa;                            &lt;/CODICE_PIATTAFORMA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM&quot;>&#xa;                            &lt;CODICE_OL_CRM>&#xa;  