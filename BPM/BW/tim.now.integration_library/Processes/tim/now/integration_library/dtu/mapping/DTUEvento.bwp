;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;>&#xa;                        &lt;CCLI_CENTRALE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;/>&#xa;                        &lt;/CCLI_CENTRALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;>&#xa;                        &lt;COD_ARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;/>&#xa;                        &lt;/COD_ARMADIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;>&#xa;                        &lt;NOTE_PER_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;/>&#xa;                        &lt;/NOTE_PER_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI)&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RI