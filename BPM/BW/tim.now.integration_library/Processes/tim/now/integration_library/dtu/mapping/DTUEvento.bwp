                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioDTUEventoIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_ContattoRefte-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:Root_ContattoRefte>&#xa;            &lt;xsl:for-each select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO&quot;>&#xa;                &lt;Q1:Contatto_Refte>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:PROGRESSIVO) > 0&quot;>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ns:PROGRESSIVO)&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;ID_CONTATTO_REFTE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/ID_CONTATTO_REFTE_DTU>&#xa;                    &lt;xsl:if test=&quot;ns:RF_FISSO&quot;>&#xa;                        &lt;TELF_FISSO_REFTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:RF_FISSO&quot;/>&#xa;                        &lt;/TELF_FISSO_REFTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:RF_MOBILE&quot;>&#xa;                        &lt;TELF_MOBL_REFTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:RF_MOBILE&quot;/>&#xa;                        &lt;/TELF_MOBL_REFTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ORA_VISITA&quot;>&#xa;                        &lt;ORA_VISITA_CONTATTO>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ORA_VISITA&quot;/>&#xa;                        &lt;/ORA_VISITA_CONTATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:TELEFONATA_ORA&quot;>&#xa;                        &lt;ORA_TELEFONATA>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELEFONATA_ORA&quot;/>&#xa;                        &lt;/ORA_TELEFONATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ESITO_CH&quot;>&#xa;                        &lt;ESITO_CHIAMATA_CONTATTO>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ESITO_CH&quot;/>&#xa;                        &lt;/ESITO_CHIAMATA_CONTATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:CONTATTO_DT_VISITA) > 0&quot;>&#xa;                            &lt;DATA_VISITA_CONTATTO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(ns:CONTATTO_DT_VISITA)&quot;/>&#xa;                            &lt;/DATA_VISITA_CONTATTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ULTERIORE&quot;>&#xa;                        &lt;CONTATTO_ULTERIORE>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ULTERIORE&quot;/>&#xa;                        &lt;/CONTATTO_ULTERIORE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:TELEFONATA_DT) > 0&quot;>&#xa;                            &lt;DATA_TELEFONATA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(ns:TELEFONATA_DT)&quot;/>&#xa;                            &lt;/DATA_TELEFONATA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Q1:Contatto_Refte>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO)&quot;>&#xa;                &lt;Q1:Contatto_Refte>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:PROGRESSIVO) > 0&quot;>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:PROGRESSIVO)&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;ID_CONTATTO_REFTE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/ID_CONTATTO_REFTE_DTU>&#xa;                    &lt;TELF_FISSO_REFTE>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/TELF_FISSO_REFTE>&#xa;                    &lt;TELF_MOBL_REFTE>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/TELF_MOBL_REFTE>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_ORA&quot;>&#xa;                        &lt;ORA_TELEFONATA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_ORA&quot;/>&#xa;                        &lt;/ORA_TELEFONATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ESITO_CHIAMATA_CONTATTO>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/ESITO_CHIAMATA_CONTATTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_DT) > 0&quot;>&#xa;                            &lt;DATA_TELEFONATA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_DT)&quot;/>&#xa;                            &lt;/DATA_TELEFONATA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Q1:Contatto_Refte>&#xa;            &lt;/xsl:if>&#xa;        &lt;/Q1:Root_ContattoRefte>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:DTUEventoOrdine="http://www.tim.com/NOW/xsd/DTUEventoOrdine/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="DTUEventoOrdine:Root_ContattoRefte" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioDTUEventoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_Int_DatiVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:Root_EventoOrdineDTU>&#xa;            &lt;xsl:for-each select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_VC&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(../../ns:TESTATA/ns:DATA_ESITO) > 0&quot;>&#xa;                            &lt;DATA_ESITO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(../../ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                            &lt;/DATA_ESITO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_ESITO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(../../ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                            &lt;/DATA_ESITO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;../../ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_SOSPENSIONE'&quot;>&#xa;                            &lt;DATA_CHIUSURA>&#xa;                                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                            &lt;/DATA_CHIUSURA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns:DLCI_UTENTE&quot;>&#xa;                        &lt;DLCI_UTENTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:DLCI_UTENTE&quot;/>&#xa;                        &lt;/DLCI_UTENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:CODICE_ESITO&quot;/>&#xa;                    &lt;/ESITO>&#xa;                    &lt;TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_AGGTO>&#xa;                    &lt;xsl:if test=&quot;ns:USERVLAN&quot;>&#xa;                        &lt;USERVLAN>&#xa;                            &lt;xsl:value-of select=&quot;ns:USERVLAN&quot;/>&#xa;                        &lt;/USERVLAN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:VCI_SP&quot;>&#xa;                        &lt;VCI_SP>&#xa;                            &lt;xsl:value-of select=&quot;ns:VCI_SP&quot;/>&#xa;                        &lt;/VCI_SP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:VCI_UTENTE&quot;>&#xa;                        &lt;VCI_UTENTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:VCI_UTENTE&quot;/>&#xa;                        &lt;/VCI_UTENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:VPI_SP&quot;>&#xa;                        &lt;VPI_SP>&#xa;                            &lt;xsl:value-of select=&quot;ns:VPI_SP&quot;/>&#xa;                        &lt;/VPI_SP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:VPI_UTENTE&quot;>&#xa;                        &lt;VPI_UTENTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:VPI_UTENTE&quot;/>&#xa;                        &lt;/VPI_UTENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;/>&#xa;                    &lt;/DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                    &lt;xsl:if test=&quot;../../ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;../../ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:ID_GPON&quot;>&#xa;                                &lt;IDENTIFICATIVO_GPON>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:ID_GPON&quot;/>&#xa;                                &lt;/IDENTIFICATIVO_GPON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:ID_GPON&quot;>&#xa;                                &lt;IDENTIFICATIVO_GPON>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_OPERATORE_RETE/ns:ID_GPON&quot;/>&#xa;                                &lt;/IDENTIFICATIVO_GPON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:ID_EGON&quot;>&#xa;                                &lt;IDENTIFICATIVO_EGON>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:ID_EGON&quot;/>&#xa;                                &lt;/IDENTIFICATIVO_EGON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:ID_EGON&quot;>&#xa;                                &lt;IDENTIFICATIVO_EGON>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_OPERATORE_RETE/ns:ID_EGON&quot;/>&#xa;                                &lt;/IDENTIFICATIVO_EGON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:CODICESPLITTERPRIMARIO&quot;>&#xa;                                &lt;CODICE_SPLITTER_PRIMARIO>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:CODICESPLITTERPRIMARIO&quot;/>&#xa;                                &lt;/CODICE_SPLITTER_PRIMARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:CODICESPLITTERPRIMARIO&quot;>&#xa;                                &lt;CODICE_SPLITTER_PRIMARIO>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_OPERATORE_RETE/ns:CODICESPLITTERPRIMARIO&quot;/>&#xa;                                &lt;/CODICE_SPLITTER_PRIMARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;>&#xa;                                &lt;CODICE_SPLITTER_SECONDARIO>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;/>&#xa;                                &lt;/CODICE_SPLITTER_SECONDARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:CODICESPLITTERSECONDARIO&quot;>&#xa;                                &lt;CODICE_SPLITTER_SECONDARIO>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_OPERATORE_RETE/ns:CODICESPLITTERSECONDARIO&quot;/>&#xa;                                &lt;/CODICE_SPLITTER_SECONDARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:ROE&quot;>&#xa;                                &lt;CODICE_ROE>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:ROE&quot;/>&#xa;                                &lt;/CODICE_ROE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:ROE&quot;>&#xa;                                &lt;CODICE_ROE>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_OPERATORE_RETE/ns:ROE&quot;/>&#xa;                                &lt;/CODICE_ROE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(../ns:DATI_FF)&quot;>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_FF/ns:POSIZIONESPLITTER&quot;>&#xa;                                &lt;POSIZIONE_SPLITTER>&#xa;                                    &lt;xsl:value-of select=&quot;../ns:DATI_FF/ns:POSIZIONESPLITTER&quot;/>&#xa;                                &lt;/POSIZIONE_SPLITTER>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;../ns:DATI_OPERATORE_RETE/ns:POSIZIONESPLITTER&quot;>&