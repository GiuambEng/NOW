Evento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;descrEvento>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TIPOLOGIA_EVENTO)&quot;>&lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TIPOLOGIA_EVENTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/descrEvento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
