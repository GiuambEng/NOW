ICA/ns:INTERMEDIA/ns:PIC/ns:DATA_ORA_PIC) > 0&quot;>&#xa;                        &lt;DATA_PRESA_IN_CARICO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date(substring($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PIC/ns:DATA_ORA_PIC, 1, 10))&quot;/>&#xa;                        &lt;/DATA_PRESA_IN_CARICO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                    &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                    &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ID_GPON) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ID_GPON&quot;>&#xa;                            &lt;IDENTIFICATIVO_GPON>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ID_GPON&quot;/>&#xa;                            &lt;/IDENTIFICATIVO_GPON>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and string-length($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF/ns:ID_EGON) > 0&quot;>&#xa;                        &lt;xsl: