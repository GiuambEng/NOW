;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;>&#xa;                                &lt;NOTE_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;/>&#xa;                                &lt;/NOTE_PREVENTIVO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;>&#xa;                                &lt;QTA_POSA_PALO_ROCCIA>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;/>&#xa;                                &lt;/QTA_POSA_PALO_ROCCIA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;>&#xa;                                &lt;QTA_POSA_PALO_TERRENO_STANDARD>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;/>&#xa;                                &lt;/QTA_POSA_PALO_TERRENO_STANDARD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;>&#xa;                                &lt;QTA_POZZETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;/>&#xa;                                &lt;/QTA_POZZETTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;>&#xa;                                &lt;QTA_RIPRISTINI>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;/>&#xa;                                &lt;/QTA_RIPRISTINI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;>&#xa;                                &lt;QTA_SCAVO_PAVIMENTAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;/>&#xa;                                &lt;/QTA_SCAVO_PAVIMENTAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;>&#xa;                                &lt;QTA_SCAVO_ROCCIA>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;/>&#xa;                                &lt;/QTA_SCAVO_ROCCIA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;>&#xa;                                &lt;QTA_SCAVO_TERRENO>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;/>&#xa;                                &lt;/QTA_SCAVO_TERRENO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;>&#xa;                                &lt;QTA_TUBAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;/>&#xa;                                &lt;/QTA_TUBAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA))&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;>&#xa;                        &lt;CCLI_CENTRALE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;/>&#xa;                        &lt;/CCLI_CENTRALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;>&#xa;                        &lt;COD_ARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;/>&#xa;                        &lt;/COD_ARMADIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;>&#xa;                        &lt;NOTE_PER_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;/>&#xa;                        &lt;/NOTE_PER_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI)&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) or exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) + count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)+1)&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) or exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) + count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)+2)&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:TIPO_OPA&quot;>&#xa;                        &lt;FLAG_OPA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:TIPO_OPA&quot;/>&#xa;                        &lt;/FLAG_OPA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:CONTRIBUTO_CLIENTE&quot;>&#xa;                        &lt;FLAG_CONTRIBUTO_CLIENTE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:CONTRIBUTO_CLIENTE&quot;/>&#xa;                        &lt;/FLAG_CONTRIBUTO_CLIENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:LunghezzaTotaleLinea&quot;>&#xa;                        &lt;LUNGHEZZA_TOTALE_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:LunghezzaTotaleLinea&quot;/>&#xa;                        &lt;/LUNGHEZZA_TOTALE_LINEA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:GIORNI_PREVISTI) > 0 and string(number($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:GIORNI_PREVISTI)) !=&amp;quot;NaN&amp;quot;&quot;>&#xa;                            &lt;NUM_GIORNI_PREVISTO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:GIORNI_PREVISTI)&quot;/>&#xa;                            &lt;/NUM_GIORNI_PREVISTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;>&#xa;                        &lt;NOTE_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;/>&#xa;                        &lt;/NOTE_PREVENTIVO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;>&#xa;                        &lt;QTA_POSA_PALO_ROCCIA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;/>&#xa;                        &lt;/QTA_POSA_PALO_ROCCIA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;>&#xa;                        &lt;QTA_POSA_PALO_TERRENO_STANDARD>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;/>&#xa;                        &lt;/QTA_POSA_PALO_TERRENO_STANDARD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;>&#xa;                        &lt;QTA_POZZETTO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;/>&#xa;                        &lt;/QTA_POZZETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;>&#xa;                        &lt;QTA_RIPRISTINI>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;/>&#xa;                        &lt;/QTA_RIPRISTINI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;>&#xa;                        &lt;QTA_SCAVO_PAVIMENTAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;/>&#xa;                        &lt;/QTA_SCAVO_PAVIMENTAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;>&#xa;                        &lt;QTA_SCAVO_ROCCIA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;/>&#xa;                        &lt;/QTA_SCAVO_ROCCIA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;>&#xa;                        &lt;QTA_SCAVO_TERRENO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;/>&#xa;                        &lt;/QTA_SCAVO_TERRENO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;>&#xa;                        &lt;QTA_TUBAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;/>&#xa;                        &lt;/QTA_TUBAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO)&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and &amp;#xD;&amp;#xA;not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)) and&amp;#xD;&amp;#xA;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) or exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)) and&amp;#xD;&amp;#xA;not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) + count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)+1)&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;((exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) or exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;((exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) or exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)) and &amp;#xD;&amp;#xA;not (exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)) and &amp;#xD;&amp;#xA;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC) + count($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO)+2)&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:ID_RISORSA_BLOCCATA&quot;>&#xa;                        &lt;IDENTIFICATIVO_RISORSA_BLOCCATA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:ID_RISORSA_BLOCCATA&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_RISORSA_BLOCCATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:ID_OL_BLOCCANTE&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_BLOCCANTE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:ID_OL_BLOCCANTE&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_BLOCCANTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:SISTEMA_COINVOLTO&quot;>&#xa;                        &lt;SISTEMA_BLOCCANTE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO/ns:SISTEMA_COINVOLTO&quot;/>&#xa;                        &lt;/SISTEMA_BLOCCANTE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO)&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;not(exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI&quot;>&#xa;                            &lt;NUMERI_AGGIUNTIVI>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI&quot;/>&#xa;                            &lt;/NUMERI_AGGIUNTIVI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO&quot;>&#xa;                            &lt;NUMERO_PRENOTATO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO&quot;/>&#xa;                            &lt;/NUMERO_PRENOTATO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;>&#xa;                            &lt;RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;/>&#xa;                            &lt;/RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;>&#xa;                            &lt;CODICE_PIATTAFORMA>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;/>&#xa;                            &lt;/CODICE_PIATTAFORMA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM&quot;>&#xa;                            &lt;CODICE_OL_CRM>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM&quot;/>&#xa;                            &lt;/CODICE_OL_CRM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;        &lt;/Q1:Root_EventoOrdineDTU>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
