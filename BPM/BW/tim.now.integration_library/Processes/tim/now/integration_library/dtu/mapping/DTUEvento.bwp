                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2e0801df-56dd-4a2d-b67b-804051b8c828+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper_ConfAnn&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_NextVal&quot;/>&#xa;    &lt;xsl:template name=&quot;INS_DTUEvento_ConfAnn-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$Mapper_ConfAnn/Q1:Evento_Ordine_DTU&quot;>&#xa;            &lt;tns1:jdbcUpdateActivityInput>&#xa;                &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_NextVal/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;ID_RICH_DTU&quot;/>&#xa;                &lt;/ID_RICH_DTU>&#xa;                &lt;TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;TRANSACTION_ID&quot;/>&#xa;                &lt;/TRANSACTION_ID>&#xa;                &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;IDTPLG_STATO_EVENTO_DTU&quot;/>&#xa;                &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                &lt;ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&#xa;                &lt;/ID_RICH_OLO>&#xa;                &lt;PROGRS_EVENTO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;PROGRS_EVENTO_DTU&quot;/>&#xa;                &lt;/PROGRS_EVENTO_DTU>&#xa;                &lt;DATA_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;DATA_ESITO&quot;/>&#xa;                &lt;/DATA_ES