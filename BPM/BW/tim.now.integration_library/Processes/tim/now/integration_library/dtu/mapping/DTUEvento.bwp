                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b3e92e5c-c446-4397-9263-b250c3f1bee3+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper_EvOrdNowWhls&quot;/>&#xa;    &lt;xsl:template name=&quot;INS_EvOrdNowWhls-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;ID_LAVRZ_APPLBLE_ORDN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_LAVRZ_APPLBLE_ORDN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_LAVRZ_APPLBLE_ORDN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_LAVRZ_APPLBLE_ORDN>&#xa;            &lt;ID_RICH_DTU>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_RICH_DTU)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_RICH_DTU&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_DTU>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_RICH_OLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_SISTEMA_DESTNRIO>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_SISTEMA_DESTNRIO&quot;/>&#xa;            &lt;/ID_SISTEMA_DESTNRIO>&#xa;            &lt;ID_SISTEMA_MITTENTE>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/ID_SISTEMA_MITTENTE&quot;/>&#xa;            &lt;/ID_SISTEMA_MITTENTE>&#xa;            &lt;IDTPLG_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/IDTPLG_EVENTO&quot;/>&#xa;            &lt;/IDTPLG_EVENTO>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/TIMSTP_AGGTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/TIMSTP_AGGTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;TIMSTP_INSMTO_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;$Mapper_EvOrdNowWhls/Q1:Ordine_Now_Whls/TIMSTP_INSMTO_EVENTO&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_EVENTO>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
