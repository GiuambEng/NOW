ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/TRANSACTION_ID>&#xa;                    &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;not(exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO))&quot;>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_EVENTO_DTU>&#xa;                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                            &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                    &lt;/DATA_ESITO>&#xa;                    &lt;TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI&quot;>&#xa;                            &lt;NUMERI_AGGIUNTIVI>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMAGGIUNTIVI&quot;/>&#xa;                            &lt;/NUMERI_AGGIUNTIVI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO&quot;>&#xa;                            &lt;NUMERO_PRENOTATO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:NUMPRENOTATO&quot;/>&#xa;                            &lt;/NUMERO_PRENOTATO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;>&#xa;                            &lt;RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:RADICALE&quot;/>&#xa;                            &lt;/RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;>&#xa;                            &lt;CODICE_PIATTAFORMA>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_PIATTAFORMA&quot;/>&#xa;                            &lt;/CODICE_PIATTAFORMA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:CODICE_OL_CRM&quot;>&#xa;                            &lt;CODICE_OL_CRM>&#xa;                                &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVEN