                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO CONTATTO_REFTE_DTU (CONTATTO_ULTERIORE, DATA_TELEFONATA, DATA_VISITA_CONTATTO,&#xd;&#xa;ESITO_CHIAMATA_CONTATTO, ID_CONTATTO_REFTE_DTU, ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_OLO,&#xd;&#xa;ORA_TELEFONATA, ORA_VISITA_CONTATTO, PROGRS_EVENTO_DTU, PROGRS_REFTE,&#xd;&#xa;TELF_FISSO_REFTE, TELF_MOBL_REFTE, TIMSTP_INSMTO, NOMINATIVO_CONTATTO) &#xd;&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, (&#xd;&#xa;    SELECT COGNOMEREFERENTE || ' ' || NOMEREFERENTE AS NOMINATIVO&#xd;&#xa;      FROM BDS_1_CASEDATA_REFERENTE&#xd;&#xa;      WHERE IDRICHIESTAOLO = ? AND PROGRESSIVOREFERENTE = ? &#xd;&#xa;      &#x9;AND TIPOREFERENTEORDINE = 'REFERENTE'&#xd;&#xa;    )&#xd;&#xa;  )" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTATTO_ULTERIORE"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_TELEFONATA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_VISITA_CONTATTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO_CHIAMATA_CONTATTO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_CONTATTO_REFTE_DTU"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ORA_TELEFONATA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ORA_VISITA_CONTATTO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="PROGRS_EVENTO_DTU"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="PROGRS_REFTE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TELF_FISSO_REFTE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TELF_MOBL_REFTE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="PROGRESSIVOREFERENTE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
