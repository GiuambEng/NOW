            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioDTUEventoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_ConfAnn-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:Root_EventoOrdineDTU>&#xa;            &lt;Q1:Evento_Ordine_DTU>&#xa;                &lt;ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/ID_RICH_DTU>&#xa;                &lt;TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/TRANSACTION_ID>&#xa;                &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                &lt;ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/ID_RICH_OLO>&#xa;                &lt;PROGRS_EVENTO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/PROGRS_EVENTO_DTU>&#xa;                &lt;DATA_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                &lt;/DATA_ESITO>&#xa;                &lt;TIMSTP_INSMTO_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CAUSALE_ESITO&quot;>&#xa;                    &lt;CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CAUSALE_ESITO&quot;/>&#xa;                    &lt;/CAUS_ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:DATA_ANNULLAMENTO)&quot;>&#xa;                        &lt;DATA_CHIUSURA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:DATA_ANNULLAMENTO)&quot;/>&#xa;                        &lt;/DATA_CHIUSURA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CODICE_ESITO&quot;>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CODICE_ESITO&quot;/>&#xa;                    &lt;/ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TIMSTP_AGGTO>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;>&#xa;                    &lt;DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns: