                  &lt;xsl:when test=&quot;exists(ATTESTAZIONE_CENTRALE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;ATTESTAZIONE_CENTRALE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ATTESTAZIONE_CENTRALE>&#xa;                &lt;ATTR_MODEM_SEDE_CLIENTE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(ATTR_MODEM_SEDE_CLIENTE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;ATTR_MODEM_SEDE_CLIENTE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ATTR_MODEM_SEDE_CLIENTE>&#xa;                &lt;BITRATE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(BITRATE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;BITRATE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/BITRATE>&#xa;                &lt;BITRATE_TI>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(BITRATE_TI)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;BITRATE_TI&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xs