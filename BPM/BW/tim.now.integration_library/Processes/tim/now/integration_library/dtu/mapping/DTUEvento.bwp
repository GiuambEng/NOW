            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioDTUEventoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_Finale-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:Root_EventoOrdineDTU>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC&quot;>&#xa;                    &lt;Q1:Evento_Ordine_DTU>&#xa;                        &lt;ID_RICH_DTU>&#xa;                            &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/ID_RICH_DTU>&#xa;                        &lt;TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/TRANSACTION_ID>&#xa;                        &lt;IDTPLG_STATO_EVENTO_DTU>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDTPLG_STATO_EVENTO_DTU>&#xa;                        &lt;ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                        &lt;/ID_RICH_OLO>&#xa;                        &lt;PROGRS_EVENTO_DTU>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/PROGRS_EVENTO_DTU>&#xa;                        &lt;DATA_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date(../../../ns:TESTATA/ns:DATA_ESITO)&quot;/>&#xa;                        &lt;/DATA_ESITO>&#xa;                        &lt;TIMSTP_INSMTO_EVENTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/TIMSTP_INSMTO_EVENTO>&#xa;                        &lt;CAUS_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:CAUSALE_ESITO&quot;/>&#xa;                        &lt;/CAUS_ESITO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE)&quot;>&#xa;                                &lt;xsl:if test=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;>&#xa;                                    &lt;CCLI_CENTRALE>&#xa;                                        &lt;xsl:value-of select=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CCLI_CENTRALE&quot;/>&#xa;                                    &lt;/CCLI_CENTRALE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE)&quot;>&#xa;                                &lt;xsl:if test=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;>&#xa;                                    &lt;COD_ARMADIO>&#xa;                                        &lt;xsl:value-of select=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:MULTI_CENTRALE[1]/ns:CODICE_ARMADIO&quot;/>&#xa;                                    &lt;/COD_ARMADIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;ns:DLCI_UTENTE&quot;>&#xa;                            &lt;DLCI_UTENTE>&#xa;                                &lt;xsl:value-of select=&quot;ns:DLCI_UTENTE&quot;/>&#xa;                            &lt;/DLCI_UTENTE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ESITO>&#xa;                            &lt;xsl:value-of select=&quot;ns:ESITO&quot;/>&#xa;                        &lt;/ESITO>&#xa;                        &lt;xsl:if test=&quot;ns:ID_VLAN&quot;>&#xa;                            &lt;ID_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;ns:ID_VLAN&quot;/>&#xa;                            &lt;/ID_VLAN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../../ns:NOTIFICHE_VERSO_OLO)&quot;>&#xa;                                &lt;xsl:if test=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;>&#xa;                                    &lt;NOTE_PER_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;../../ns:NOTIFICHE_VERSO_OLO/ns:NOTE_PER_OLO&quot;/>&#xa;                                    &lt;/NOTE_PER_OLO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/TIMSTP_AGGTO>&#xa;                        &lt;xsl:if test=&quot;ns:USERVLAN&quot;>&#xa;                            &lt;USERVLAN>&#xa;                                &lt;xsl:value-of select=&quot;ns:USERVLAN&quot;/>&#xa;                            &lt;/USERVLAN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ns:VCI_RETE&quot;>&#xa;                            &lt;VCI_RETE>&#xa;                                &lt;xsl:value-of select=&quot;ns:VCI_RETE&quot;/>&#xa;                            &lt;/VCI_RETE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;VCI_SP>&#xa;                            &lt;xsl:value-of select=&quot;ns:VCI_SP&quot;/>&#xa;                        &lt;/VCI_SP>&#xa;                        &lt;xsl:if test=&quot;ns:VCI_UTENTE&quot;>&#xa;                            &lt;VCI_UTENTE>&#xa;                                &lt;xsl:value-of select=&quot;ns:VCI_UTENTE&quot;/>&#xa;                            &lt;/VCI_UTENTE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ns:VPI_RETE&quot;>&#xa;                            &lt;VPI_RETE>&#xa;                                &lt;xsl:value-of select=&quot;ns:VPI_RETE&quot;/>&#xa;                            &lt;/VPI_RETE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;VPI_SP>&#xa;                            &lt;xsl:value-of select=&quot;ns:VPI_SP&quot;/>&#xa;                        &lt;/VPI_SP>&#xa;                        &lt;xsl:if test=&quot;ns:VPI_UTENTE&quot;>&#xa;                            &lt;VPI_UTENTE>&#xa;                                &lt;xsl:value-of select=&quot;ns:VPI_UTENTE&quot;/>&#xa;                            &lt;/VPI_UTENTE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                            &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;/>&#xa;                        &lt;/DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                        &lt;xsl:if test=&quot;../../../ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                            &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                                &lt;xsl:value-of select=&quot;../../../ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                 