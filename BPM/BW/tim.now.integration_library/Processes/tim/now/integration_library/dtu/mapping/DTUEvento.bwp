EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:MAX_VEL_UP&quot;/>&#xa;                        &lt;/MAX_VEL_UP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:BIT_RATE_DOWN&quot;>&#xa;                        &lt;BIT_RATE_DOWN>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:BIT_RATE_DOWN&quot;/>&#xa;                        &lt;/BIT_RATE_DOWN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:BIT_RATE_UP&quot;>&#xa;                        &lt;BIT_RATE_UP>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:BIT_RATE_UP&quot;/>&#xa;                        &lt;/BIT_RATE_UP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:IP_DNS&quot;>&#xa;                        &lt;IP_DNS>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO/ns:IP_DNS&quot;/>&#xa;                        &lt;/IP_DNS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Q1:Evento_Ordine_DTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)&quot;>&#xa;                &lt;Q1:Evento_Ordine_DTU>&#xa;                    &lt;ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ID_RICH_DTU>&#xa;                    &lt;TRANSACTION_ID>&#xa;                        &lt;xsl:value-of