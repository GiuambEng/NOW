og aggregato confAnn: &amp;quot;, tib:render-xml($Mapper_ConfAnn/Q1:Evento_Ordine_DTU[1], true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
