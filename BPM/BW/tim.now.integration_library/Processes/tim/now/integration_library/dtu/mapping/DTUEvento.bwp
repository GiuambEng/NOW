                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioDTUEventoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_ContattoRefte-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:Root_ContattoRefte>&#xa;            &lt;xsl:for-each select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO&quot;>&#xa;                &lt;Q1:Contatto_Refte>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;../../ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:PROGRESSIVO) > 0&quot;>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ns:PROGRESSIVO)&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;ID_CONTATTO_REFTE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/ID_CONTATTO_REFTE_DTU>&#xa;                    &lt;xsl:if test=&quot;ns:RF_FISSO&quot;>&#xa;                        &lt;TELF_FISSO_REFTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:RF_FISSO&quot;/>&#xa;                        &lt;/TELF_FISSO_REFTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:RF_MOBILE&quot;>&#xa;                        &lt;TELF_MOBL_REFTE>&#xa;                            &lt;xsl:value-of select=&quot;ns:RF_MOBILE&quot;/>&#xa;                        &lt;/TELF_MOBL_REFTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ORA_VISITA&quot;>&#xa;                        &lt;ORA_VISITA_CONTATTO>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ORA_VISITA&quot;/>&#xa;                        &lt;/ORA_VISITA_CONTATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:TELEFONATA_ORA&quot;>&#xa;                        &lt;ORA_TELEFONATA>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELEFONATA_ORA&quot;/>&#xa;                        &lt;/ORA_TELEFONATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ESITO_CH&quot;>&#xa;                        &lt;ESITO_CHIAMATA_CONTATTO>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ESITO_CH&quot;/>&#xa;                        &lt;/ESITO_CHIAMATA_CONTATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:CONTATTO_DT_VISITA) > 0&quot;>&#xa;                            &lt;DATA_VISITA_CONTATTO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(ns:CONTATTO_DT_VISITA)&quot;/>&#xa;                            &lt;/DATA_VISITA_CONTATTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns:CONTATTO_ULTERIORE&quot;>&#xa;                        &lt;CONTATTO_ULTERIORE>&#xa;                            &lt;xsl:value-of select=&quot;ns:CONTATTO_ULTERIORE&quot;/>&#xa;                        &lt;/CONTATTO_ULTERIORE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns:TELEFONATA_DT) > 0&quot;>&#xa;                            &lt;DATA_TELEFONATA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(ns:TELEFONATA_DT)&quot;/>&#xa;                            &lt;/DATA_TELEFONATA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Q1:Contatto_Refte>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO)&quot;>&#xa;                &lt;Q1:Contatto_Refte>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:PROGRESSIVO) > 0&quot;>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:PROGRESSIVO)&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PROGRS_REFTE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/PROGRS_REFTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;PROGRS_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/PROGRS_EVENTO_DTU>&#xa;                    &lt;ID_CONTATTO_REFTE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/ID_CONTATTO_REFTE_DTU>&#xa;                    &lt;TELF_FISSO_REFTE>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/TELF_FISSO_REFTE>&#xa;                    &lt;TELF_MOBL_REFTE>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/TELF_MOBL_REFTE>&#xa;                    &lt;xsl:if test=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_ORA&quot;>&#xa;                        &lt;ORA_TELEFONATA>&#xa;                            &lt;xsl:value-of select=&quot;$InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_ORA&quot;/>&#xa;                        &lt;/ORA_TELEFONATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ESITO_CHIAMATA_CONTATTO>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/ESITO_CHIAMATA_CONTATTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_DT) > 0&quot;>&#xa;                            &lt;DATA_TELEFONATA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO/ns:TELEFONATA_DT)&quot;/>&#xa;                            &lt;/DATA_TELEFONATA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Q1:Contatto_Refte>&#xa;            &lt;/xsl:if>&#xa;        &lt;/Q1:Root_ContattoRefte>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
