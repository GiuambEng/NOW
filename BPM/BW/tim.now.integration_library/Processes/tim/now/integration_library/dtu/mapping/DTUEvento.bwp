est=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CAUSALE_ESITO&quot;>&#xa;                    &lt;CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CAUSALE_ESITO&quot;/>&#xa;                    &lt;/CAUS_ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:DATA_ANNULLAMENTO)&quot;>&#xa;                        &lt;DATA_CHIUSURA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date($InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:DATA_ANNULLAMENTO)&quot;/>&#xa;                        &lt;/DATA_CHIUSURA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CODICE_ESITO&quot;>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO/ns:CODICE_ESITO&quot;/>&#xa;                    &lt;/ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TIMSTP_AGGTO>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;>&#xa;                    &lt;DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;/>&#xa;                    &lt;/DATA_INVIO_NOTF_XML_DA_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                    &lt;STATO_DISAGGREGAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                    &lt;/STATO_DISAGGREGAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                    &lt;IDENTIFICATIVO_ORDINE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$InvioDTUEventoIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                    &lt;/IDENTIFICATIVO_ORDINE_DTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/Q1:Evento_Ordine_DTU>&#xa;        &lt;/Q1:Root_EventoOrdineDTU>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
