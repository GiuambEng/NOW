/ns:EVENTO_NOTIFICA)) then $InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA else if (exists($InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_RICHIESTA)) then $InvioDTUEventoIn/input/Q1:DTUEventoRequest/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:ID_RICHIESTA else ''&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Log Input DTUEvento: &amp;quot;, tib:render-xml($InvioDTUEventoIn/input/Q1:DTUEventoRequest, true(), true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
