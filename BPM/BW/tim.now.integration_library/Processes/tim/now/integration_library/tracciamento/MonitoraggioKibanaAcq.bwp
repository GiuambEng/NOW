                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AcquisizioneRic-input"
                    name="AcquisizioneRic"
                    outputVariable="AcquisizioneRic"
