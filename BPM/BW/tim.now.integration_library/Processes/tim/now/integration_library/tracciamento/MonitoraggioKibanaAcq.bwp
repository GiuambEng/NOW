                    outputVariable="Renderdata"
                    tibex:xpdlId="8ad3ff17-441f-422c-901a-460a02bb73f1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToRenderdata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderdataToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/MonitoraggioKibana&quot; xmlns:ns0=&quot;http://tns.tibco.com/bw/activity/render/xsd/+8ad3ff17-441f-422c-901a-460a02bb73f1+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AcquisizioneRic&quot;/>&lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&lt;ns0:Rows>&lt;tns1:MonitoraggioKibanaAcq>&lt;tns1:DataEstrazione>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:DataEstrazione>&lt;xsl:if test=&quot;$AcquisizioneRic/Record[1]/CODICE_OLO&quot;>&lt;tns1:CodiceOlo>&lt;xsl:value-of select=&quot;$AcquisizioneRic/Record[1]/CODICE_OLO&quot;/>&lt;/tns1:CodiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$AcquisizioneRic/Record[1]/TIMESTAMP_CREAZIONE&quot;>&lt;tns1:DataAcquisizione>&lt;xsl:value-of select=&quot;$AcquisizioneRic/Record[1]/TIMESTAMP_CREAZIONE&quot;/>&lt;/tns1:DataAcquisizione>&lt;/xsl:if>&lt;xsl:if test=&quot;$AcquisizioneRic/Record[1]/NOME_FILE&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$AcquisizioneRic/Record[1]/NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AcquisizioneRic/Record[1]/DATA_DEPOSITO_OLO)&quot;>&lt;xsl:if test=&quot;$AcquisizioneRic/Record[1]/DATA_DEPOSITO_OLO&quot;>&lt;tns1:DataFileOloPortale>&lt;xsl:value-of select=&quot;$AcquisizioneRic/Record[1]/DATA_DEPOSITO_OLO&quot;/>&lt;/tns1:DataFileOloPortale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$AcquisizioneRic/Record[1]/TIMSTP_APERTURA_FILE&quot;>&lt;tns1:DataFileOloPortale>&lt;xsl:value-of select=&quot;$AcquisizioneRic/Record[1]/TIMSTP_APERTURA_FILE&quot;/>&lt;/tns1:DataFileOloPortale>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quo