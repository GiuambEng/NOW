                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S_RICH_ORDN_COMUNIC_TRACC.NEXTVAL FROM DUAL" xsi:type="jdbcPalette:JDBCQueryActivity">
