                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCInsertRichOrdComTrac&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCUPDATERichOrdComTrac&quot;/>&#xa;    &lt;xsl:param name=&quot;Seque_RICH_ORDN_COMUNIC_TRACC&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuerySequnceTracciamento&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCInsertRichOrdComTracFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Tracciamento_SubPro'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CasedataTrackingPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'RichOrdComTracking'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:strutturaRichiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:strutturaRichiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JDBCInsertRichOrdComTrac/noOfUpdates>0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Tracciamento_SubPro Successfully Inserted. NoOfUpdate = &amp;quot;, xsd:string($JDBCInsertRichOrdComTrac/noOfUpdates), &amp;quot;ID_RICHIESTA_OLO: &amp;quot; , $Start/tns:strutturaRichiesta/IDRichiestaOLO, &amp;quot;ID_TRACCIAMENTO: &amp;quot;, xsd:string($Seque_RICH_ORDN_COMUNIC_TRACC/Record[1]/NEXTVAL ))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$JDBCUPDATERichOrdComTrac/noOfUpdates>0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Tracciamento_SubPro Successfully Inserted. NoOfUpdate = &amp;quot;, xsd:string($JDBCUPDATERichOrdComTrac/noOfUpdates), &amp;quot;ID_RICHIESTA_OLO: &amp;quot;, $Start/tns:strutturaRichiesta/IDRichiestaOLO, &amp;quot;AGGIORNATA COLONNA CON ID_TRACCIAMENTO: &amp;quot;, xsd:string($Start/tns:ID_TRACCIAMENTO))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Tracciamento_SubPro Successfully INSERT per FATTURAZIONE. NoOfUpdate = &amp;quot;, xsd:string($JDBCInsertRichOrdComTracFatturazione/noOfUpdates), &amp;quot;ID_RICHIESTA_OLO: &amp;quot; , $Start/tns:strutturaRichiesta/IDRichiestaOLO, &amp;quot;INSERITA COLANNA CON ID_TRACCIAMENTO: &amp;quot;, xsd:string($JDBCQuerySequnceTracciamento/Record[1]/NEXTVAL))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;      