                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/NowToRacService" xmlns:tns3="http://wsracweb/RACSendOLOFromNOW" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns4="http://www.tim.com/NOW/xsd/NowToRacServiceFWA/" version="2.0"&gt;&lt;xsl:param name="IDPROCSO_NOFILE"/&gt;&lt;xsl:param name="Esito"/&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="InvokeRacIn"/&gt;&lt;xsl:param name="RACSendOLOFromNOW"/&gt;&lt;xsl:param name="InvokeRAC"/&gt;&lt;xsl:param name="ID_PROCSO_NO_FILE_FWA"/&gt;&lt;xsl:param name="Fault"/&gt;&lt;xsl:param name="RacRequestFWA"/&gt;&lt;xsl:template name="UpdateStaging-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Esito=true()"&gt;&lt;tns1:StagingOut&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RACSendOLOFromNOW/RACResponse/tns3:RACResponse)"&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($RACSendOLOFromNOW/RACResponse, true(), true())"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($InvokeRAC/RACResponse/tns3:RACResponse, true(), true())"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RISPOSTA&gt;&lt;/tns1:StagingOut&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:StagingOut&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns4:NOWRequest)"&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="concat(&amp;quot;Errore nella chiamata al sistema esterno RAC_&amp;quot;,string(current-dateTime()),'Errore:',$Fault)"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="concat(&amp;quot;Errore nella chiamata al sistema esterno RAC_&amp;quot;,string(current-dateTime()))"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RISPOSTA&gt;&lt;/tns1:StagingOut&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_RAC_PORTABILITA_OUT'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$InvokeRacIn/parameters/tns2:NowToRacRequest/tns2:FlagScheduler=true()"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns4:NOWRequest)"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="'RAC_OAO_SIM_FWA'"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="'RAC_NP_OL'"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$InvokeRacIn/parameters/tns2:NowToRacRequest/tns2:FlagScheduler=true()"&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InvokeRacIn/parameters/tns2:NowToRacRequest/tns2:IDEsecProcsoNoFile))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns4:NOWRequest)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_NO_FILE_FWA"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$IDPROCSO_NOFILE"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Esito=true()"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Esito=true()"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Info'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Error'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Esito=true()"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns3=&quot;http://wsracweb/RACSendOLOFromNOW&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRAC.RACResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RACSendOLOFromNOW.RACResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeRacIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IDPROCSO_NOFILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Esito&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NO_FILE_FWA&quot;/>&#xa;    &lt;xsl:param name=&quot;Fault&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequestFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Esito=true()&quot;>&#xa;                    &lt;tns1:StagingOut>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RACSendOLOFromNOW.RACResponse)&quot;>&#xa;                                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($RACSendOLOFromNOW.RACResponse, true(), true())&quot;/>&#xa;                                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeRAC.RACResponse, true(), true())&quot;/>&#xa;                                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                        &lt;tns1:TIMSTP_RISPOSTA>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;/tns1:StagingOut>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:StagingOut>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RacRequestFWA/tns4:NOWRequest)&quot;>&#xa;                                &lt;tns1:DESCR_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella chiamata al sistema esterno RAC_&amp;quot;,string(current-dateTime()),'Errore:',$Fault)&quot;/>&#xa;                                &lt;/tns1:DESCR_ERRORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:DESCR_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella chiamata al sistema esterno RAC_&amp;quot;,string(current-dateTime()))&quot;/>&#xa;                                &lt;/tns1:DESCR_ERRORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                        &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                        &lt;tns1:TIMSTP_RISPOSTA>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;/tns1:StagingOut>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RAC_PORTABILITA_OUT'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvokeRacIn.parameters/tns2:FlagScheduler=true()&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($RacRequestFWA/tns4:NOWRequest)&quot;>&#xa;                                    &lt;ns:COD_PROCSO_FILE>&#xa;                                        &lt;xsl:value-of select=&quot;'RAC_OAO_SIM_FWA'&quot;/>&#xa;                                    &lt;/ns:COD_PROCSO_FILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:COD_PROCSO_FILE>&#xa;                                        &lt;xsl:value-of select=&quot;'RAC_NP_OL'&quot;/>&#xa;                                    &lt;/ns:COD_PROCSO_FILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvokeRacIn.parameters/tns2:FlagScheduler=true()&quot;>&#xa;                            &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InvokeRacIn.parameters/tns2:IDEsecProcsoNoFile))&quot;/>&#xa;                            &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RacRequestFWA/tns4:NOWRequest)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ID_PROCSO_NO_FILE_FWA&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$IDPROCSO_NOFILE&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Esito=true()&quot;>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                            &lt;/ns:STATO_ESEC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/ns:STATO_ESEC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Esito=true()&quot;>&#xa;                            &lt;ns:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'Info'&quot;/>&#xa;                            &lt;/ns:LOG_LEVEL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                            &lt;/ns:LOG_LEVEL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Esito=true()&quot;>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOutRacCallToInsertUpdateStaging"/>
                    <bpws:target linkName="GenericLogger1ToUpdateStaging"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertUpdateStagingToLogOutUpdateStaging"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeRacIn&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;RacRequest&quot;/>&lt;xsl:param name=&quot;RacRequestFWA&quot;/>&lt;xsl:template name=&quot;LogRacRequest-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.BPMIntegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SharedNowToRac&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;SharedNowToRacPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InvokeRac&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns1:NowToRacRequest/tns1:IdRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RacRequestFWA/tns2:NOWRequest)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Invio richiesta verso RacFWA:&amp;quot;,tib:render-xml($RacRequestFWA, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Invio richiesta verso Rac: &amp;quot;,tib:render-xml($RacRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogRacRequest-input"
                    name="LogRacRequest"
                    tibex:xpdlId="194c5630-32d1-4163-932e-136497650264"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignRacRequestToCallProcess"/>
                        <bpws:target linkName="Assign2ToLogRacRequest"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToCheckCall">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InvokeRacIn/parameters/tns:NowToRacRequest/tns:FlagScheduler=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InvokeRacIn.parameters/tns:FlagScheduler=true()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToInsertStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRacIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequestFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRacRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.BPMIntegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SharedNowToRac&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SharedNowToRacPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvokeRac&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns1:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns2:NOWRequest)&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Invio richiesta verso RacFWA:&amp;quot;,tib:render-xml($RacRequestFWA, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Invio richiesta verso Rac: &amp;quot;,tib:render-xml($RacRequest, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:RAC=&quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;InvokeRacIn&quot;/>&lt;xsl:template name=&quot;Transaction_Info&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:FlagScheduler=true()&quot;>&lt;tns:Transaction_Info>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:TransactionInfo/tns:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:TransactionInfo/tns:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;/tns:Transaction_Info>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Transaction_Info>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:Transaction_date>&lt;/tns:Transaction_Info>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
