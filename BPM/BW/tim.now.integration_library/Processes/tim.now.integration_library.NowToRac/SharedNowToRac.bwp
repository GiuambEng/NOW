                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRacIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Transaction_Info&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCGetOLOInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;RacRequest&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RacRequest>&#xa;            &lt;tns:TransactionInfo>&#xa;                &lt;tns:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_id&quot;/>&#xa;                &lt;/tns:Transaction_id>&#xa;                &lt;tns:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_date&quot;/>&#xa;                &lt;/tns:Transaction_date>&#xa;            &lt;/tns:TransactionInfo>&#xa;            &lt;tns:NOWRequest>&#xa;                &lt;tns:NUMERO_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:NUMERO_LINEA&quot;/>&#xa;                &lt;/tns:NUMERO_LINEA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='WLRLINEAATTIVA'&quot;>&#xa;                        &lt;tns:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;'WLR'&quot;/>&#xa;                        &lt;/tns:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='VULL'&quot;>&#xa;                        &lt;tns:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;'VULL'&quot;/>&#xa;                        &lt;/tns:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='NP' or $InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='ULLLINEAATTIVANP' or $InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='SLULINEAATTIVANP' or $InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='ULLDATILINEAATTIVANP'&quot;>&#xa;                        &lt;tns:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                        &lt;/tns:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO&quot;/>&#xa;                        &lt;/tns:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/tns:CODICE_OLO>&#xa;                &lt;tns:SIGLA_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SIGLA_OLO&quot;/>&#xa;                &lt;/tns:SIGLA_OLO>&#xa;                &lt;tns:DESCRIZIONE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/NOME&quot;/>&#xa;                &lt;/tns:DESCRIZIONE_OLO>&#xa;                &lt;tns:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:DATA_ESPLETAMENTO&quot;/>&#xa;                &lt;/tns:DATA_ESPLETAMENTO>&#xa;            &lt;/tns:NOWRequest>&#xa;        &lt;/tns:RacRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
