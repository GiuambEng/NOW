                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/SharedNowToRac/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns2=&quot;http://wsracweb/RACSendOLOFromNOW&quot; xmlns:tns3=&quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRAC.RACResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;RACSendOLOFromNOW.RACResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Esito&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeRacOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Esito=true()&quot;>&#xa;                &lt;tns1:NowToRACResponse>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($InvokeRAC.RACResponse/tns3:Transaction_id)>0&quot;>&#xa;                            &lt;tns1:Transaction_id>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeRAC.RACResponse/tns3:Transaction_id&quot;/>&#xa;                            &lt;/tns1:Transaction_id>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Transaction_id>&#xa;                                &lt;xsl:value-of select=&quot;$RACSendOLOFromNOW.RACResponse/tns3:Transaction_id&quot;/>&#xa;                            &lt;/tns1:Transaction_id>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InvokeRAC.RACResponse/tns3:Response_date)&quot;>&#xa;                            &lt;tns1:Response_date>&#xa;                                &lt;xsl:value-of select=&quot;$Invoke