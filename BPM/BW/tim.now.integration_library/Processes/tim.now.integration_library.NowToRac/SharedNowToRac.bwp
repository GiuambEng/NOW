                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns=&quot;http://wsracweb/RACSendOLOFromNOW&quot; xmlns:tns2=&quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RacRequestFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeRAC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RACSendFWAFromNOW>&#xa;            &lt;tns2:NOWRequestFWA>&#xa;                &lt;tns2:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:ID_RISORSA&quot;/>&#xa;                &lt;/tns2:ID_RISORSA>&#xa;                &lt;tns2:MSISDN>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:MSISDN&quot;/>&#xa;                &lt;/tns2:MSISDN>&#xa;                &lt;tns2:IMSI>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:IMSI&quot;/>&#xa;                &lt;/tns2:IMSI>&#xa;                &lt;tns2:TIPO_SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:TIPO_SERVIZIO&quot;/>&#xa;                &lt;/tns2:TIPO_SERVIZIO>&#xa;                &lt;tns2:CODICE_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:CODICE_OAO&quot;/>&#xa;                &lt;/tns2:CODICE_OAO>&#xa;                &lt;tns2:SIGLA_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:SIGLA_OAO&quot;/>&#xa;                &lt;/tns2:SIGLA_OAO>&#xa;                &lt;tns2:DESCRIZIONE_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:DESCRIZIONE_OAO&quot;/>&#xa;                &lt;/tns2:DESCRIZIONE_OAO>&#xa;                &lt;tns2:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:DATA_ESPLETAMENTO&quot;/>&#xa;                &lt;/tns2:DATA_ESPLETAMENTO>&#xa;                &lt;tns2:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:TIPO_OPERAZIONE&quot;/>&#xa;                &lt;/tns2:TIPO_OPERAZIONE>&#xa;            &lt;/tns2:NOWRequestFWA>&#xa;        &lt;/tns:RACSendFWAFromNOW>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
