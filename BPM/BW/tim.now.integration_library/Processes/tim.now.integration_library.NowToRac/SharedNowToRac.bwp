            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="InsertUpdateStaging"
                outputVariable="InsertStaging"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns11:InsertUpdateStagingPortType" tibex:xpdlId="b01344b9-8507-40b5-8c1a-bdad877a517c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns="http://www.tim.com/NOW/xsd/NowToRacService" xmlns:tns3="http://www.tim.com/NOW/xsd/NowToRacServiceFWA/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="IDPROCSO_NOFILE"/&gt;&lt;xsl:param name="InvokeRacIn"/&gt;&lt;xsl:param name="RacRequest"/&gt;&lt;xsl:param name="ID_PROCSO_NO_FILE_FWA"/&gt;&lt;xsl:param name="RacRequestFWA"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:COD_OLO&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:NOWRequest/tns3:CODICE_OAO"/&gt;&lt;/tns1:COD_OLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:COD_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:CODICE_OLO"/&gt;&lt;/tns1:COD_OLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($RacRequestFWA,true(), true())"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="concat(&amp;#xD;&amp;#xA;'&amp;lt;soapenv:Envelope xmlns:soapenv=&amp;quot;http://schemas.xmlsoap.org/soap/envelope/&amp;quot; xmlns:tns=&amp;quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&amp;quot; xmlns:rac1=&amp;quot;http://wsracweb/RACSendOLOFromNOW&amp;quot;&gt;&amp;#xD;&amp;#xA;   &amp;#xD;&amp;#xA;&amp;lt;soapenv:Header&gt;',&amp;#xD;&amp;#xA;tib:render-xml($RacRequest/tns:TransactionInfo, true(), true()) , &amp;#xD;&amp;#xA;'&amp;lt;/soapenv:Header&gt;&amp;#xD;&amp;#xA;&amp;#x9;   &amp;#xD;&amp;#xA;&amp;lt;soapenv:Body&gt;&amp;lt;rac1:RACSendOLOFromNOW&gt;', &amp;#xD;&amp;#xA;tib:render-xml($RacRequest/tns:NOWRequest, true(), true()),'   &amp;#xD;&amp;#xA; &amp;lt;/rac1:RACSendOLOFromNOW&gt;&amp;lt;/soapenv:Body&gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;/soapenv:Envelope&gt;')"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$InvokeRacIn/parameters/tns:NowToRacRequest/tns:IdRichiestaOLO"/&gt;&lt;/tns1:ID_RICH&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id)&gt;0"&gt;&lt;xsl:if test="$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id"&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$RacRequest/tns:TransactionInfo/tns:Transaction_id"&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$RacRequest/tns:TransactionInfo/tns:Transaction_id"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date)"&gt;&lt;xsl:if test="$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date"&gt;&lt;tns1:TRANSACTION_DATE&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date"/&gt;&lt;/tns1:TRANSACTION_DATE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$RacRequest/tns:TransactionInfo/tns:Transaction_date"&gt;&lt;tns1:TRANSACTION_DATE&gt;&lt;xsl:value-of select="$RacRequest/tns:TransactionInfo/tns:Transaction_date"/&gt;&lt;/tns1:TRANSACTION_DATE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($RacRequestFWA/tns3:NOWRequest/tns3:ID_RISORSA)&gt;0"&gt;&lt;tns1:NUMERO_LINEA&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:NOWRequest/tns3:ID_RISORSA"/&gt;&lt;/tns1:NUMERO_LINEA&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:NUMERO_LINEA&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:NUMERO_LINEA"/&gt;&lt;/tns1:NUMERO_LINEA&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:NOWRequest/tns3:TIPO_SERVIZIO"/&gt;&lt;/tns1:TIPO_SERVIZIO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:TIPO_SERVIZIO"/&gt;&lt;/tns1:TIPO_SERVIZIO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:SIGLA_OLO&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:NOWRequest/tns3:SIGLA_OAO"/&gt;&lt;/tns1:SIGLA_OLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:SIGLA_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:SIGLA_OLO"/&gt;&lt;/tns1:SIGLA_OLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:DESCRIZIONE_OLO&gt;&lt;xsl:value-of select="$RacRequestFWA/tns3:NOWRequest/tns3:DESCRIZIONE_OAO"/&gt;&lt;/tns1:DESCRIZIONE_OLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCRIZIONE_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:DESCRIZIONE_OLO"/&gt;&lt;/tns1:DESCRIZIONE_OLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;tns1:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="xsd:date($RacRequestFWA/tns3:NOWRequest/tns3:DATA_ESPLETAMENTO)"/&gt;&lt;/tns1:DATA_ESPLETAMENTO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="$RacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTO"/&gt;&lt;/tns1:DATA_ESPLETAMENTO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_RAC_PORTABILITA_OUT'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RacRequestFWA/tns3:NOWRequest)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_NO_FILE_FWA"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$IDPROCSO_NOFILE"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Info'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns2:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRacIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IDPROCSO_NOFILE&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NO_FILE_FWA&quot;/>&#xa;    &lt;xsl:param name=&quot;RacRequestFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:COD_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:CODICE_OAO&quot;/>&#xa;                        &lt;/tns1:COD_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:COD_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:CODICE_OLO&quot;/>&#xa;                        &lt;/tns1:COD_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($RacRequestFWA,true(), true())&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;'&amp;lt;soapenv:Envelope xmlns:soapenv=&amp;quot;http://schemas.xmlsoap.org/soap/envelope/&amp;quot; xmlns:tns=&amp;quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&amp;quot; xmlns:rac1=&amp;quot;http://wsracweb/RACSendOLOFromNOW&amp;quot;>&amp;#xD;&amp;#xA;   &amp;#xD;&amp;#xA;&amp;lt;soapenv:Header>',&amp;#xD;&amp;#xA;tib:render-xml($RacRequest/tns:TransactionInfo, true(), true()) , &amp;#xD;&amp;#xA;'&amp;lt;/soapenv:Header>&amp;#xD;&amp;#xA;&amp;#x9;   &amp;#xD;&amp;#xA;&amp;lt;soapenv:Body>&amp;lt;rac1:RACSendOLOFromNOW>', &amp;#xD;&amp;#xA;tib:render-xml($RacRequest/tns:NOWRequest, true(), true()),'   &amp;#xD;&amp;#xA; &amp;lt;/rac1:RACSendOLOFromNOW>&amp;lt;/soapenv:Body>&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;/soapenv:Envelope>')&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id&quot;>&#xa;                            &lt;tns1:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_id&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$RacRequest/tns:TransactionInfo/tns:Transaction_id&quot;>&#xa;                            &lt;tns1:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$RacRequest/tns:TransactionInfo/tns:Transaction_id&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date)&quot;>&#xa;                        &lt;xsl:if test=&quot;$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date&quot;>&#xa;                            &lt;tns1:TRANSACTION_DATE>&#xa;                                &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:TransactionInfo/tns3:Transaction_date&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_DATE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$RacRequest/tns:TransactionInfo/tns:Transaction_date&quot;>&#xa;                            &lt;tns1:TRANSACTION_DATE>&#xa;                                &lt;xsl:value-of select=&quot;$RacRequest/tns:TransactionInfo/tns:Transaction_date&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_DATE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RacRequestFWA/tns3:NOWRequest/tns3:ID_RISORSA)>0&quot;>&#xa;                        &lt;tns1:NUMERO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:ID_RISORSA&quot;/>&#xa;                        &lt;/tns1:NUMERO_LINEA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:NUMERO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:NUMERO_LINEA&quot;/>&#xa;                        &lt;/tns1:NUMERO_LINEA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/tns1:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:TIPO_SERVIZIO&quot;/>&#xa;                        &lt;/tns1:TIPO_SERVIZIO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:SIGLA_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:SIGLA_OAO&quot;/>&#xa;                        &lt;/tns1:SIGLA_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:SIGLA_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:SIGLA_OLO&quot;/>&#xa;                        &lt;/tns1:SIGLA_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:DESCRIZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequestFWA/tns3:NOWRequest/tns3:DESCRIZIONE_OAO&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:DESCRIZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:DESCRIZIONE_OLO&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                        &lt;tns1:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date($RacRequestFWA/tns3:NOWRequest/tns3:DATA_ESPLETAMENTO)&quot;/>&#xa;                        &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$RacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTO&quot;/>&#xa;                        &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RAC_PORTABILITA_OUT'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RacRequestFWA/tns3:NOWRequest)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ID_PROCSO_NO_FILE_FWA&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$IDPROCSO_NOFILE&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'Info'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
