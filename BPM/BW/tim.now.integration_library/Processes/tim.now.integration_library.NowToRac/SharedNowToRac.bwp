            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Transaction_Info&quot;/>&lt;xsl:param name=&quot;InvokeRacIn&quot;/>&lt;xsl:param name=&quot;JDBCGetOLOInfo&quot;/>&lt;xsl:template name=&quot;RacRequestFWA&quot; match=&quot;/&quot;>&lt;tns1:RacRequest>&lt;tns1:TransactionInfo>&lt;tns1:Transaction_id>&lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_id&quot;/>&lt;/tns1:Transaction_id>&lt;tns1:Transaction_date>&lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_date&quot;/>&lt;/tns1:Transaction_date>&lt;/tns1:TransactionInfo>&lt;tns1:NOWRequest>&lt;tns1:ID_RISORSA>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:NUMERO_LINEA&quot;/>&lt;/tns1:ID_RISORSA>&lt;xsl:if test=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:MSISDN&quot;>&lt;tns1:MSISDN>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:MSISDN&quot;/>&lt;/tns1:MSISDN>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:IMSI&quot;>&lt;tns1:IMSI>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:IMSI&quot;/>&lt;/tns1:IMSI>&lt;/xsl:if>&lt;tns1:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'WILL-FWA'&quot;/>&lt;/tns1:TIPO_SERVIZIO>&lt;tns1:CODICE_OAO>&lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/COD_OLO&quot;/>&lt;/tns1:CODICE_OAO>&lt;tns1:SIGLA_OAO>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:SIGLA_OLO&quot;/>&lt;/tns1:SIGLA_OAO>&lt;tns1:DESCRIZIONE_OAO>&lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/NOME&quot;/>&lt;/tns1:DESCRIZIONE_OAO>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string($InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA),'.')&quot;>&lt;tns1:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before(string($InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA),'.'))&quot;/>&lt;/tns1:DATA_ESPLETAMENTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA&quot;>&lt;tns1:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA&quot;/>&lt;/tns1:DATA_ESPLETAMENTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:LAVORAZIONE&quot;>&lt;tns1:TIPO_OPERAZIONE>&lt;xsl:value-of select=&quot;$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:LAVORAZIONE&quot;/>&lt;/tns1:TIPO_OPERAZIONE>&lt;/xsl:if>&lt;/tns1:NOWRequest>&lt;/tns1:RacRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RacRequestFWA" name="Assign2"
                    outputVariable="RacRequestFWA"
                    tibex:xpdlId="87ad6f76-ec1c-46c9-9648-3c3f08d8d0e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign2ToLogRacRequest"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeRacIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Transaction_Info&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCGetOLOInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;RacRequestFWA&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RacRequest>&#xa;            &lt;tns1:TransactionInfo>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_id&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$Transaction_Info/tns:Transaction_date&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;            &lt;/tns1:TransactionInfo>&#xa;            &lt;tns1:NOWRequest>&#xa;                &lt;tns1:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:NUMERO_LINEA&quot;/>&#xa;                &lt;/tns1:ID_RISORSA>&#xa;                &lt;xsl:if test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:MSISDN&quot;>&#xa;                    &lt;tns1:MSISDN>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:MSISDN&quot;/>&#xa;                    &lt;/tns1:MSISDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:IMSI&quot;>&#xa;                    &lt;tns1:IMSI>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:IMSI&quot;/>&#xa;                    &lt;/tns1:IMSI>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:TIPO_SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;'WILL-FWA'&quot;/>&#xa;                &lt;/tns1:TIPO_SERVIZIO>&#xa;                &lt;tns1:CODICE_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/tns1:CODICE_OAO>&#xa;                &lt;tns1:SIGLA_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:SIGLA_OLO&quot;/>&#xa;                &lt;/tns1:SIGLA_OAO>&#xa;                &lt;tns1:DESCRIZIONE_OAO>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCGetOLOInfo/Record[1]/NOME&quot;/>&#xa;                &lt;/tns1:DESCRIZIONE_OAO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains(string($InvokeRacIn.parameters/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA),'.')&quot;>&#xa;                        &lt;tns1:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before(string($InvokeRacIn.parameters/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA),'.'))&quot;/>&#xa;                        &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA&quot;>&#xa;                            &lt;tns1:DATA_ESPLETAMENTO>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:DATA_ESPLETAMENTOFWA&quot;/>&#xa;                            &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:LAVORAZIONE&quot;>&#xa;                    &lt;tns1:TIPO_OPERAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeRacIn.parameters/tns:NOWRequest/tns:LAVORAZIONE&quot;/>&#xa;                    &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:NOWRequest>&#xa;        &lt;/tns1:RacRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="RacRequestFWA" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="9a240b1f-c3dc-47a4-8c8f-3172247b3717">
                <bpws:targets>
                    <bpws:target linkName="JDBCGetOLOInfoToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToAssignRacRequest">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:SERVIZIO='FWA' or $InvokeRacIn/parameters/tns:NowToRacRequest/tns:NOWRequest/tns:SERVIZIO='FIXEDWIRELESSACCESS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='FWA' or $InvokeRacIn.parameters/tns:NOWRequest/tns:SERVIZIO='FIXEDWIRELESSACCESS']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
