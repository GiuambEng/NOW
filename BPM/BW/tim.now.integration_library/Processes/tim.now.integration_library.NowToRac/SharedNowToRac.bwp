            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="337a5df7-1426-4f8c-ad66-5757f4a9628c">
                <bpws:targets>
                    <bpws:target linkName="CheckCallToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToGenericLogger1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$NumeroTentativi and $Esito=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$NumeroTentativi and $Esito=false()]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="InvokeToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart1ToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToGenericLogger" tibex:linkType="ERROR"/>
                                <bpws:link name="GenericLoggerToSleep1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Sleep1ToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
