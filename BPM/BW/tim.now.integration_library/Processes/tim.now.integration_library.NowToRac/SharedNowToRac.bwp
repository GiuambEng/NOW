&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://wsracweb/RACSendOLOFromNOW" xmlns:tns1="http://www.tim.com/NOW/xsd/NowToRacService" xmlns:tns2="http://wsracweb/type-definitions/RACSendOLOFromNOW" version="2.0"&gt;&lt;xsl:param name="RacRequest"/&gt;&lt;xsl:template name="RACSendOLOFromNOW-input" match="/"&gt;&lt;tns:RACSendOLOFromNOW&gt;&lt;parameters&gt;&lt;tns:RACSendOLOFromNOW&gt;&lt;tns2:NOWRequest&gt;&lt;tns2:NUMERO_LINEA&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:NUMERO_LINEA"/&gt;&lt;/tns2:NUMERO_LINEA&gt;&lt;tns2:TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:TIPO_SERVIZIO"/&gt;&lt;/tns2:TIPO_SERVIZIO&gt;&lt;tns2:CODICE_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:CODICE_OLO"/&gt;&lt;/tns2:CODICE_OLO&gt;&lt;tns2:SIGLA_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:SIGLA_OLO"/&gt;&lt;/tns2:SIGLA_OLO&gt;&lt;tns2:DESCRIZIONE_OLO&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:DESCRIZIONE_OLO"/&gt;&lt;/tns2:DESCRIZIONE_OLO&gt;&lt;tns2:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="$RacRequest/tns1:NOWRequest/tns1:DATA_ESPLETAMENTO"/&gt;&lt;/tns2:DATA_ESPLETAMENTO&gt;&lt;/tns2:NOWRequest&gt;&lt;/tns:RACSendOLOFromNOW&gt;&lt;/parameters&gt;&lt;TransactionInfo&gt;&lt;tns2:TransactionInfo&gt;&lt;tns2:Transaction_id&gt;&lt;xsl:value-of select="$RacRequest/tns1:TransactionInfo/tns1:Transaction_id"/&gt;&lt;/tns2:Transaction_id&gt;&lt;tns2:Transaction_date&gt;&lt;xsl:value-of select="$RacRequest/tns1:TransactionInfo/tns1:Transaction_date"/&gt;&lt;/tns2:Transaction_date&gt;&lt;/tns2:TransactionInfo&gt;&lt;/TransactionInfo&gt;&lt;/tns:RACSendOLOFromNOW&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
