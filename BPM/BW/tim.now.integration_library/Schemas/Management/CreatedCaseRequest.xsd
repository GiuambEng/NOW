<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/CreatedCaseRequest" elementFormDefault="qualified"
	xmlns:tns="http://www.tim.com/NOW/xsd/CreatedCaseRequest" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">
	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"
		namespace="http://NOW.it.telecomitalia.it/casedata_v1" />
	<element name="CreatedCaseRequestInput">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string" maxOccurs="1" minOccurs="1" />
				<element name="Note" type="string" maxOccurs="1" minOccurs="0" />
				<element name="Operatore" type="string" maxOccurs="1" minOccurs="1" />
				<element name="ContenutoXML" type="string" maxOccurs="1" minOccurs="1" />
				<element name="StrutturaRichiesta" type="pref:TipoStrutturaRichiestaEnumeration" maxOccurs="1" minOccurs="1" />
				<element name="Lavorazione" type="pref:LavorazioneEnumeration" maxOccurs="1" minOccurs="0" />
				<element name="TipoRichiesta" type="string" maxOccurs="1" minOccurs="0" />
				<element name="NumeroRecordCSV" type="string" maxOccurs="1" minOccurs="0" />
				<element name="FlagDelibera103" type="string" maxOccurs="1" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
	<element name="CreatedCaseRequestOutput">
		<complexType>
			<sequence>
				<element name="Response" type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="CreatedCaseRequestFault">
		<complexType>
			<sequence>
				<element name="MSGErrore" type="string" />
				<element name="CODError" type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="RichOloStoricoOpResponse">
		<complexType>
			<sequence>
				<element name="Response" type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="RichOrdComTrackingOpResponse">
		<complexType>
			<sequence>
				<element name="Response" type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="RichOloStoricoOpFault">
		<complexType>
			<sequence>
				<element name="RichOloStoricoOpFault" type="string" />
			</sequence>
		</complexType>
	</element>
	<complexType name="RichOloStoricoFault">
		<sequence>
			<element name="ErrorCode" type="string" />
			<element name="ErrorMessage" type="string" />
		</sequence>
	</complexType>
	<element name="RichOrdComTrackingOpFault">
		<complexType>
			<sequence>
				<element name="RichOrdComTrackingOpFault" type="string" />
			</sequence>
		</complexType>
	</element>
	<complexType name="RichOrdComTrackFault">
		<sequence>
			<element name="ErrorCode" type="string" />
			<element name="ErrorMessage" type="string" />
		</sequence>
	</complexType>
    <element name="RichOrdComTrackingOpRequest">
  	<complexType>
   		<sequence>
    		<element maxOccurs="1" minOccurs="1" name="strutturaRichiesta" type="pref:Richiesta"/>
    		<element name="ID_EVENTO_ORDN_NOW_WHLS" type="int"  minOccurs="0" />
   		</sequence>
  	</complexType>
 	</element>
 	<element name="Tracciamento_Request">
		<complexType>
			<sequence>
				<element name="TIPO_OP" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="INSERT" />
							<enumeration value="UPDATE" />
							<enumeration value="FATTURAZIONE" />
						</restriction>
					</simpleType>
				</element>
				<element name="ID_EVENTO_ORDN_NOW_WHLS" minOccurs="0" type="int" />
				<element name="ID_ANAG_CAUS" type="int" minOccurs="0" />
				<element name="ID_NOTF_DONATING" type="int" minOccurs="0" />
				<element name="ID_NOTF_DONOR" type="int" minOccurs="0" />
				<element name="ID_NOTF" type="int" minOccurs="0" />
				<element name="ID_TRACCIAMENTO" type="int" minOccurs="0" />
				<element minOccurs="0" name="strutturaRichiesta" type="pref:Richiesta" />
				<element name="RiemissioneFatturazione" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="ID_EVENTO_ORDN_NOW_WHLS_Old" type="int" maxOccurs="1" minOccurs="0" />
							<element name="FlagRiemissione" type="boolean" maxOccurs="1" minOccurs="0" />
							<element name="FlagRicezione" type="boolean" maxOccurs="1" minOccurs="0" />
						</sequence>
					</complexType>
				</element>
				<element type="boolean" maxOccurs="1" minOccurs="0" name="FlagEspletamentoTecnico"  />
				<element type="string" maxOccurs="1" minOccurs="0" name="AcquisitionID"  />
			</sequence>
		</complexType>
	</element>
 	<element name="Tracciamento_Response">
		<complexType>
			<sequence>
				<element name="Tracciamento_Response" type="string" />
				<element name="ID_TRACCIAMENTO" type="int" minOccurs="0" />
			</sequence>
		</complexType>
	</element>
 	
	<element name="Tracciamento_Fault">
		<complexType>
			<sequence>
				<element name="ErrorCode" type="string" />
				<element name="ErrorMessage" type="string" />
			</sequence>
		</complexType>
	</element>
 	
</schema>