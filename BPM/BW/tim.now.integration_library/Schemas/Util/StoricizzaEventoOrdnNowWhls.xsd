<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/StoricizzaEventoOrdnNowWhls/"
	elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/StoricizzaEventoOrdnNowWhls/" >
	<xs:import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1" />
	
	<xs:element name="StoricizzaEventoOrdnNowWhlsRequest" type="tns:Request" />
	<xs:complexType name="Request">
		<xs:sequence>
                <xs:element minOccurs="1" name="DESCR_EVENTO" type="xs:string"  />
                <xs:element minOccurs="1" name="ID_RICH_OLO" type="xs:string"/>
				<xs:element minOccurs="1" name="ID_SISTEMA_DESTNRIO" type="xs:int" />
				<xs:element minOccurs="1" name="ID_SISTEMA_MITTENTE" type="xs:int" />
				<xs:element minOccurs="0" name="ID_RICH_DTU" type="xs:string"/>
				<xs:element minOccurs="0" name="ID_LAVRZ_APPLBLE_ORDN" type="xs:int"/>
				<xs:element minOccurs="0" name="COD_ANAG_CAUS_NOW" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="StoricizzaEventoOrdnNowWhlsResponse" type="tns:Response"/>
	<xs:complexType name="Response">
    	<xs:sequence>
    		<xs:element name="Esito" type="tns:Esito" maxOccurs="1" minOccurs="1" />
    	</xs:sequence>
    </xs:complexType>
    <xs:complexType name="Esito">
		<xs:sequence>
			<xs:element name="Codice" type="xs:boolean" />
			<xs:element name="Descrizione" type="xs:string" />
		</xs:sequence>
	</xs:complexType>
    
    <xs:element name="StoricizzaEventoOrdnNowWhlsFault" type="tns:Fault" />
    <xs:complexType name="Fault">
    	<xs:sequence>
    		<xs:element name="ErrorCode" type="xs:string" />
    		<xs:element name="ErrorMessage" type="xs:string" />
    	</xs:sequence>
    </xs:complexType>
    
    <xs:element name="ReturnEventoOrdnNowWhlsResponse" type="tns:ResponseSubProcess"/>
    <xs:complexType name="ResponseSubProcess">
    	<xs:sequence>
    		<xs:element minOccurs="0" maxOccurs="1" name="IDEventoOrdnNowWhls" type="xs:int"  />
    		<xs:element minOccurs="1" maxOccurs="1" name="Esito" type="tns:Esito"/>
    	</xs:sequence>
    </xs:complexType>
</xs:schema>