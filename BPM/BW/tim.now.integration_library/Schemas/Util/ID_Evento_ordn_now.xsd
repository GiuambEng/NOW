<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="ID_EVENTO_NOW_ORDN_WHLS" type="int"></element>
    			<element name="IDRichOLO" type="string"></element>
    			<element name="FlagConsuntivo" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FlagRiemissione" type="boolean"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ID_ORDN_CRMWS" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="IDRisorsa" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="ID_EVENTO_ORDN_NOW_WHLS" type="int"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="MsgCode" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodeError" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>