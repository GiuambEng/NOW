<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/OpereSpeciali" xmlns:dtu="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" targetNamespace="http://www.example.org/OpereSpeciali" elementFormDefault="qualified">
	<import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" schemaLocation="../../Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd"/>
	<complexType name="Fault">
		<sequence>
			<element name="Codice_Errore" type="string" minOccurs="0"/>
			<element name="Messaggio_Errore" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="Esito">
		<sequence>
			<element name="Codice" type="boolean"/>
			<element name="Descrizione" type="string"/>
		</sequence>
	</complexType>
	<element name="AggiornaStatoPreventivo_Request">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"/>
				<element name="idPreventivo" type="decimal" minOccurs="0"/>
				<element name="NuovoStatoPreventivo">
					<simpleType>
						<restriction base="string">
							<enumeration value="INACCETTAZIONE"/>
							<enumeration value="ACCETTATO"/>
							<enumeration value="ANNULLATO"/>
							<enumeration value="CHIUSO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="FlagTimeOutAccettazione" type="boolean" minOccurs="0"/>
				<element name="IdRichiestaOLO_Accettazione" type="string" minOccurs="0"/>
				<element name="DRO_Accettazione" type="date" minOccurs="0"/>
				<element name="ImportoTotale" type="double" minOccurs="0"/>
				<element name="DettagliJPUB" type="tns:DettaglioPreventivoJpubType" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaStatoPreventivo_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:Esito"/>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaStatoPreventivo_Fault">
		<complexType>
			<sequence>
				<element name="Fault" type="tns:Fault"/>
			</sequence>
		</complexType>
	</element>
	<element name="ValorizzaPreventivo_Request">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"/>
				<element name="IdEventoDTU" type="integer"/>
				<element name="ProgEventoDtu" type="integer"/>
				<element name="Offerta" type="string"/>
				<element name="DtuOpereSpeciali" type="tns:OPERE_SPECIALI"/>
				<element name="DtuSospensioneOpereSpeciali" type="tns:DTUSOSPENSIONEOPERESPECIALI"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="DTUSOSPENSIONEOPERESPECIALI">
		<sequence>
			<element name="DATASOSPENSIONE" type="date"/>
		</sequence>
	</complexType>
	<element name="ValorizzaPreventivo_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:Esito"/>
				<element name="IdPreventivo" type="integer"/>
			</sequence>
		</complexType>
	</element>
	<element name="ValorizzaPreventivo_Fault">
		<complexType>
			<sequence>
				<element name="Fault" type="tns:Fault"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="OPERE_SPECIALI">
		<sequence>
			<element name="TIPO_OPA">
				<annotation>
					<documentation>SI = OPA NO =EPA</documentation>
				</annotation>
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
						<enumeration value="SI"/>
						<enumeration value="NO"/>
					</restriction>
				</simpleType>
			</element>
			<element name="CONTRIBUTO_CLIENTE">
				<simpleType>
					<restriction base="string">
						<enumeration value="SI"/>
						<enumeration value="NO"/>
					</restriction>
				</simpleType>
			</element>
			<element name="GIORNI_PREVISTI">
				<simpleType>
					<restriction base="string">
						<maxLength value="4"/>
					</restriction>
				</simpleType>
			</element>
			<element name="FLAG_PERMESSI" type="dtu:Flag" minOccurs="0"/>
			<element name="NOTE_PREVENTIVO" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="255"/>
					</restriction>
				</simpleType>
			</element>
			<element name="DESCRIZIONE_OPERE" type="dtu:DescOpereSpeciali_Type"/>
		</sequence>
	</complexType>
	<element name="ValorizzaConsuntivo_Request">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"/>
				<element name="IdEventoDTU" type="integer"/>
				<element name="ProgEventoDtu" type="integer"/>
				<element name="IdPreventivo" type="integer"/>
				<element name="DtuOpereSpeciali" type="tns:OPERE_SPECIALI"/>
			</sequence>
		</complexType>
	</element>
	<element name="ValorizzaConsuntivo_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:Esito"/>
				<element name="IdConsuntivo" type="integer"/>
			</sequence>
		</complexType>
	</element>
	<element name="ValorizzaConsuntivo_Fault">
		<complexType>
			<sequence>
				<element name="Fault" type="tns:Fault"/>
			</sequence>
		</complexType>
	</element>
	<element name="CallRichiestaPreventivo_Request">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"/>
				<element name="requestType" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="CallRichiestaPreventivo_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:Esito"/>
			</sequence>
		</complexType>
	</element>
	<element name="CallRichiestaPreventivo_Fault">
		<complexType>
			<sequence>
				<element name="Fault" type="tns:Fault"/>
			</sequence>
		</complexType>
	</element>
	<element name="DettagliPreventivo">
		<complexType>
			<sequence>
				<element name="DettaglioPreventivo" type="tns:DettaglioPreventivoType" minOccurs="1" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="DettaglioPreventivoType">
		<sequence>
			<element name="IdDettaglioPreventivo" type="integer"/>
			<element name="CodArticoloJPUB" type="string"/>
			<element name="QuantitaArticolo" type="integer"/>
		</sequence>
	</complexType>	
	<complexType name="DettaglioPreventivoJpubType">
		<sequence>
			<element name="IdDettaglio" type="integer"/>
			<element name="ImportoArticolo" type="double"/>
		</sequence>
	</complexType>
	<element name="AggiornaConsuntivo_Request">
		<complexType>
			<sequence>
				<element name="IdRichiestaOLO" type="string"/>
				<element name="idConsuntivo" type="decimal" minOccurs="0"/>
				<element name="ImportoTotale" type="double" minOccurs="0"/>
				<element name="DettagliJPUB" type="tns:DettaglioPreventivoJpubType" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="AggiornaConsuntivo_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:Esito"/>
			</sequence>
		</complexType>
	</element>
</schema>
