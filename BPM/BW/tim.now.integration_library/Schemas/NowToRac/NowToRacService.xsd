<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NowToRacService" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NowToRacService">

	<element name="NowToRacRequest">
		<complexType>
			<sequence>
				<element minOccurs="0" name="TransactionInfo" type="tns:TransactionInfoType"/>
				<element name="NOWRequest" type="tns:NowToRacServiceRequestType"/>
				<element name="IdRichiestaOLO" type="string"/>
				<element minOccurs="0" name="FlagScheduler" type="boolean"/>
				<element minOccurs="0" name="IDEsecProcsoNoFile" type="integer"/>
			</sequence>
		</complexType>
	</element>


	<element name="NowToRACResponse">
		<complexType>
			<sequence>
				<element name="Transaction_id" type="string"/>
				<element name="Response_date" type="dateTime"/>
				<element name="Esito" type="string"/>
			</sequence>
		</complexType>
	</element>

	<complexType name="NowToRacServiceRequestType">
		<sequence>
			<element name="NUMERO_LINEA" type="string" />
			<element name="SERVIZIO" type="string" />
			<element name="SIGLA_OLO" type="string" />
			<element name="DATA_ESPLETAMENTO" type="date" />
			<element name="MSISDN" type="string" maxOccurs="1"
				minOccurs="0" />
			<element name="IMSI" type="string" maxOccurs="1"
				minOccurs="0" />
			<element name="LAVORAZIONE" type="string" maxOccurs="1"
				minOccurs="0" />
			<element name="DATA_ESPLETAMENTOFWA" type="dateTime" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

	<element name="NowToRacFault">
		<complexType>
			<sequence>
				<element minOccurs="0" name="Codice_Errore" type="string"/>
				<element minOccurs="0" name="Messaggio_Errore" type="string"/>
			</sequence>
		</complexType>
	</element>


	<complexType name="TransactionInfoType">
		<sequence>
			<element name="Transaction_id" type="string"/>
			<element name="Transaction_date" type="dateTime"/>
		</sequence>
	</complexType>
	
	<complexType name="RacRequestType">
		<sequence>
			<element name="NUMERO_LINEA" type="string"/>
			<element name="TIPO_SERVIZIO" type="string"/>
			<element name="CODICE_OLO" type="string"/>
			<element name="SIGLA_OLO" type="string"/>
			<element name="DESCRIZIONE_OLO" type="string"/>
			<element name="DATA_ESPLETAMENTO" type="date"/>
			<element name="MSISDN" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="IMSI" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="LAVORAZIONE" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="DATA_ESPLETAMENTOFWA" type="dateTime" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

   
   <element name="Transaction_Info" type="tns:TransactionInfoType"/>
   
   <element name="RacRequest">
		<complexType>
			<sequence>
				<element minOccurs="0" name="TransactionInfo" type="tns:TransactionInfoType"/>
				<element name="NOWRequest" type="tns:RacRequestType"/>
			</sequence>
		</complexType>
	</element>
	
	

</schema>
