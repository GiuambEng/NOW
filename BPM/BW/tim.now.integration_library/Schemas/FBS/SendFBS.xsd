<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:cd="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/SendFBS/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SendFBS/">
  	
  <xsd:import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
  	
  <xsd:element name="SendFBSRequest">
    		
    <xsd:complexType>
      			
      <xsd:sequence>
        				
        <xsd:element name="Testata" type="tns:Testata"/>
        				
        <xsd:element name="Richiesta" type="xsd:string"/>
        			
      </xsd:sequence>
      		
    </xsd:complexType>
    	
  </xsd:element>
    <xsd:element name="SendFBS">
    		
    <xsd:complexType>
      			
      <xsd:sequence>
        				
        <xsd:element name="Testata" type="tns:Testata"/>
        				
        <xsd:element name="RichiestaElement" type="cd:Richiesta"/>
        			
      </xsd:sequence>
      		
    </xsd:complexType>
    	
  </xsd:element>
  	
  <xsd:element name="SendFBSResponse">
    		
    <xsd:complexType>
      			
      <xsd:sequence>
        				
        <xsd:element maxOccurs="1" minOccurs="1" name="IdEventoOrdnNowWhls" type="xsd:integer"/>
        <xsd:element maxOccurs="1" minOccurs="1" name="ID_NOTIFICA" type="xsd:string"/>
        <xsd:element maxOccurs="1" minOccurs="1" name="ESITO" type="xsd:string"/>
        <xsd:element maxOccurs="1" minOccurs="0" name="CODICE_MOTIVAZIONE" type="xsd:string"/>
        <xsd:element maxOccurs="1" minOccurs="0" name="MOTIVAZIONE" type="xsd:string"/>
        			
      </xsd:sequence>
      		
    </xsd:complexType>
    	
  </xsd:element>
  	
  <xsd:element name="SendFBSFault">
    		
    <xsd:complexType>
      			
      <xsd:sequence>
        				
        <xsd:element maxOccurs="1" minOccurs="1" name="Codice" type="xsd:string"/>
        				
        <xsd:element maxOccurs="1" minOccurs="0" name="Descrizione" type="xsd:string"/>
        			
      </xsd:sequence>
      		
    </xsd:complexType>
    	
  </xsd:element>
  	
  <xsd:complexType name="Testata">
    		
    <xsd:sequence>
      			
      <xsd:element name="RequestType" type="xsd:string"/>
      		
    </xsd:sequence>
    	
  </xsd:complexType>
  <xsd:element name="strutturaRichiesta" type="cd:Richiesta" />
  
</xsd:schema>
