<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:tns="http://www.tim.com/NOW/xsd/ConfigOscura/" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/OscuraFunzione/" elementFormDefault="qualified">
	<xs:element name="ConfigOscuraFunzione_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdRichiestaOlo" type="xs:string"/>
				<xs:element name="NomeFunzione" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ConfigOscura_Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Abilitato" type="xs:boolean"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ConfigTrasformIndotte_Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdRichiestaOlo" type="xs:string"/>
				<xs:element name="CodTrasformazione" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ConfigOscura_Fault">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Codice_Errore" type="xs:string"/>
				<xs:element name="Msg_Errore" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
