<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SendDtu/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xdtu="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="SendDtu" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/SendDtu/">
	<wsdl:import namespace="http://www.tim.com/NOW/xsd/SendDTU/" location="../../Schemas/DTU/SendDTU.xsd"/>
	<wsdl:message name="SendDTURequest">
		<wsdl:part element="xdtu:SendDTURequest" name="parameters"/>
	</wsdl:message>
	<wsdl:message name="AckComunicazioneRequest">
		<wsdl:part name="parameters" element="xdtu:ACK_COMUNICAZIONE"/>
	</wsdl:message>
	<wsdl:message name="SendDTUResponse">
		<wsdl:part element="xdtu:SendDTUResponse" name="parameters"/>
	</wsdl:message>
	<wsdl:message name="SendDTUFault">
		<wsdl:part element="xdtu:SendDTUFault" name="parameters"/>
	</wsdl:message>
	<wsdl:portType name="SendDTUPortType">
		<wsdl:operation name="SendDTU">
			<wsdl:input message="tns:SendDTURequest"/>
