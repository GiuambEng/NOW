<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" 
	xmlns:jndi="http://www.tibco.com/namespaces/ws/2004/soap/apis/jndi" xmlns:ns2="http://telecomitalia.it/SOA/SOAP/SOAPHeader" 
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" name="Untitled" targetNamespace="http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete"
	xmlns:xs="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns="http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete">
	<wsdl:import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" location="../../Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd"/>
	<wsdl:import namespace="http://telecomitalia.it/SOA/SOAP/SOAPHeader" location="../../../tim.now.shared_library/Schemas/CommonSchema/SOAPHeader_v1.1.xsd"/>
	<wsdl:message name="Richiesta_ACK">
		<wsdl:part name="richiesta" element="xs:ACK_COMUNICAZIONE"/>
		<wsdl:part name="header" element="ns2:Header"/>
	</wsdl:message>
	<wsdl:message name="Richiesta_Evento">
		<wsdl:part name="richiesta" element="xs:EVENTO_RICHIESTA"/>
		<wsdl:part name="header" element="ns2:Header"/>
	</wsdl:message>
	<wsdl:portType name="PortType">
		<wsdl:operation name="Richiesta_Evento">
			<wsdl:input name="Richiesta_Evento" message="tns:Richiesta_Evento"/>
		</wsdl:operation>
		<wsdl:operation name="Richiesta_ACK">
			<wsdl:input name="Richiesta_ACK" message="tns:Richiesta_ACK"/>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="RichiestaNOW_PortTypeEndpoint1Binding" type="tns:PortType">
		<soap:binding style="document" transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"/>
		<jms:binding messageFormat="Text"/>
		<wsdl:operation name="Richiesta_Evento">
			<soap:operation soapAction="Richiesta_Evento" style="document"/>
			<wsdl:input>
				<soap:body parts="richiesta" use="literal"/>
				<soap:header message="tns:Richiesta_Evento" part="header" use="literal"/>
			</wsdl:input>
		</wsdl:operation>
		<wsdl:operation name="Richiesta_ACK">
			<soap:operation soapAction="Richiesta_ACK" style="document"/>
			<wsdl:input>
				<soap:body parts="richiesta" use="literal"/>
				<soap:header message="tns:Richiesta_ACK" part="header" use="literal"/>
			</wsdl:input>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="RichiestaNOW">
		<wsdl:port name="RichiestaNOW_PortTypeEndpoint1" binding="tns:RichiestaNOW_PortTypeEndpoint1Binding">
			<soap:address location="jms:jndi:queue.sample?targetService=PortType"/>
			<jms:connectionFactory>DTU_BWINT-QueueConnFactory</jms:connectionFactory>
			<jms:targetAddress destination="queue">TIM.OP.DEV.DTU.DTU.REQ_NOW</jms:targetAddress>
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
