                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE, ID_ESEC_PROCSO_FILE, NOME_FILE, TIMSTP_APERTURA_FILE&#xa;FROM FILE_PROCSTO&#xa;WHERE NOME_FILE=? AND VERSO_DEL_FILE='OUTPUT' AND ID_INTRFC=? ORDER BY TIMSTP_APERTURA_FILE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

