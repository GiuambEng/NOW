                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+df5fee3b-6ffa-4574-b249-8fc86f65f114+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SIS_INT.CODFC_OLO_AGCOM, SIS_INT.IP, SIS_INT.LOCAL_PATH,&#xd;&#xa;  SIS_INT.NOME_HOST, SIS_INT.PORT, SIS_INT.REMOTE_PATH, SIS_INT.UTENZA, INTFC.VERSO, INTFC.ID_INTRFC, INTFC.COD_INTRFC, OL.COD_OLO, SIS_INT.STORAGE_PATH&#xd;&#xa;  FROM SISTEMA SIS, SISTEMA_IP_INTRFC SIS_INT, INTRFC INTFC, OLO OL&#xd;&#xa;  WHERE SIS.ID_SISTEMA = SIS_INT.ID_SISTEMA AND SIS_INT.ID_INTRFC = INTFC.ID_INTRFC&#xd;&#xa;     AND INTFC.VERSO = 'OUTPUT' AND SIS.DESCR_SISTEMA_NOME_SISTEMA IN ('OLO') &#xd;&#xa;     AND INTFC.COD_INTRFC IN ('FILE_OLO_BAD_BATCH_REG', 'FILE_OLO_BAD_BATCH_NGA', 'FILE_OLO_BAD_BATCH_XDSL','FILE_OLO_BAD_BATCH_NP','FILE_OLO_BAD_BATCH_REG_CPS')&#xd;&#xa;     AND OL.CODFC_OLO_AGCOM = SIS_INT.CODFC_OLO_AGCOM AND SIS_INT.FLAG_ENABLED='Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="IP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VERSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_INTRFC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STORAGE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
