                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SIS_INT.CODFC_OLO_AGCOM, SIS_INT.IP, SIS_INT.LOCAL_PATH,&#xd;&#xa;  SIS_INT.NOME_HOST, SIS_INT.PORT, SIS_INT.REMOTE_PATH, SIS_INT.UTENZA, INTFC.VERSO, INTFC.ID_INTRFC, INTFC.COD_INTRFC, OL.COD_OLO&#xd;&#xa;  FROM SISTEMA SIS, SISTEMA_IP_INTRFC SIS_INT, INTRFC INTFC, OLO OL&#xd;&#xa;  WHERE SIS.ID_SISTEMA = SIS_INT.ID_SISTEMA AND SIS_INT.ID_INTRFC = INTFC.ID_INTRFC&#xd;&#xa;     AND INTFC.VERSO = 'OUTPUT' AND SIS.DESCR_SISTEMA_NOME_SISTEMA IN ('FENP') &#xd;&#xa;     AND INTFC.COD_INTRFC IN ('FILE_RICH_DBCFX_NP_BATCH')&#xd;&#xa;     AND OL.CODFC_OLO_AGCOM = SIS_INT.CODFC_OLO_AGCOM AND SIS_INT.FLAG_ENABLED='Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="IP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VERSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_INTRFC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
