                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0ec198e9-a3ed-42fd-a2f3-ead1268500c5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;EsitoInvio>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/EsitoInvio>&lt;TimestampInvio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TimestampInvio>&lt;IDfile>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/ID_FILE)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDfile>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
