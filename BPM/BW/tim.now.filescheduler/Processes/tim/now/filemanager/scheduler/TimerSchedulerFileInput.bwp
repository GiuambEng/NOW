                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileProcstoUpdate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DateExtractionOutput&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_DIR.SftpDirOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;SFTP_GET.SftpGetOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperTmstp&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceIDFile&quot;/>&#xa;    &lt;xsl:param name=&quot;SisIDQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;indexDIR&quot;/>&#xa;    &lt;xsl:param name=&quot;Sequence_EsecProc&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameSenzaTappo&quot;/>&#xa;    &lt;xsl:param name=&quot;DateExtraction&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperInsertGet-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Insert>&#xa;            &lt;tns:TMSP_INIZIO_ELAB>&#xa;                &lt;xsl:value-of select=&quot;$MapperTmstp/tns:TMSP_INIZIO_ELAB&quot;/>&#xa;            &lt;/tns:TMSP_INIZIO_ELAB>&#xa;            &lt;tns:EsecuzioneProcessoFile>&#xa;                &lt;tns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ALIMENTATORE_NOW&amp;quot;&quot;/>&#xa;                &lt;/tns:COD_PROCSO_FILE>&#xa;                &lt;tns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Sequence_EsecProc/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/tns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;tns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tns:STATO_ESEC>&#xa;                &lt;tns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TMSP_FINE_ELAB>&#xa;            &lt;/tns:EsecuzioneProcessoFile>&#xa;            &lt;tns:FileProcstoInput>&#xa;                &lt;xsl:if test=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_OLO&quot;>&#xa;                    &lt;tns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_OLO&quot;/>&#xa;                    &lt;/tns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/tns:CODFC_OLO_AGCOM>&#xa;                &lt;xsl:if test=&quot;$DateExtraction/tns1:DateFromFilename&quot;>&#xa;                    &lt;tns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$DateExtraction/tns1:DateFromFilename&quot;/>&#xa;                    &lt;/tns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TRASFERITO&amp;quot;&quot;/>&#xa;                &lt;/tns:DESCR_STATO_FILE>&#xa;                &lt;tns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERITO&amp;quot;&quot;/>&#xa;                &lt;/tns:ESITO>&#xa;                &lt;tns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SequenceIDFile/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/tns:ID_FILE>&#xa;                &lt;tns:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_INTRFC&quot;/>&#xa;                &lt;/tns:COD_INTRFC>&#xa;                &lt;tns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_APERTURA_FILE>&#xa;                &lt;tns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/VERSO&quot;/>&#xa;                &lt;/tns:VERSO_DEL_FILE>&#xa;                &lt;tns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameSenzaTappo&quot;/>&#xa;                &lt;/tns:NOME_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case(tib:substring-after-last($FileNameSenzaTappo, &amp;quot;.&amp;quot;))='ZIP'&quot;>&#xa;                        &lt;tns:IDTPLG_FILE>&#xa;                            &lt;xsl:value-of select=&quot;'CSV'&quot;/>&#xa;                        &lt;/tns:IDTPLG_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:IDTPLG_FILE>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(tib:substring-after-last($FileNameSenzaTappo, &amp;quot;.&amp;quot;))&quot;/>&#xa;                        &lt;/tns:IDTPLG_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;>&#xa;                    &lt;tns:DATA_DEPOSITO_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;/>&#xa;                    &lt;/tns:DATA_DEPOSITO_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;starts-with($FileNameSenzaTappo, '103')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SFTP_DIR.SftpDirOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))])&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(substring-after(substring-before($SFTP_DIR.SftpDirOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_')))=14 and string(number(substring-after(substring-before($SFTP_DIR.SftpDirOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))))!='NaN'&quot;>&#xa;                                    &lt;tns:TIMSTP_NP>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyyMMddHHmmss&amp;quot;,substring-after(substring-before($SFTP_DIR.SftpDirOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_')))&quot;/>&#xa;                                    &lt;/tns:TIMSTP_NP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;>&#xa;                                        &lt;tns:TIMSTP_NP>&#xa;                                            &lt;xsl:value-of select=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;/>&#xa;                                        &lt;/tns:TIMSTP_NP>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;>&#xa;                                &lt;tns:TIMSTP_NP>&#xa;                                    &lt;xsl:value-of select=&quot;$SFTP_GET.SftpGetOutput/tns2:lastModify&quot;/>&#xa;                                &lt;/tns:TIMSTP_NP>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:FileProcstoInput>&#xa;        &lt;/tns:Insert>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:FileProcstoUpdate="http://www.example.org/FileProcstoUpdate"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
