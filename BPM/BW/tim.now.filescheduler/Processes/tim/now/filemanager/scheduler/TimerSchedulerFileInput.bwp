                                    <bpws:source linkName="MapperInsertGetToInvoke">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
