                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns=&quot;http://www.example.org/FileProcstoUpdate&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateDir&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPreInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Dati da inserire nelle tabelle.&amp;quot;, &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco COD_PROCSO_FILE: &amp;quot;,tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:EsecuzioneProcessoFile/tns:COD_PROCSO_FILE, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco ID_ESEC_PROCSO_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:EsecuzioneProcessoFile/tns:ID_ESEC_PROCSO_FILE, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco STATO_ESEC: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:EsecuzioneProcessoFile/tns:STATO_ESEC, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco TMSP_INIZIO_ELAB: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:TMSP_INIZIO_ELAB, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco TMSP_FINE_ELAB: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:EsecuzioneProcessoFile/tns:TMSP_FINE_ELAB, &amp;quot;, &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco NOME_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:NOME_FILE, &amp;quot; , &amp;quot;),  &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco COD_OLO: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:COD_OLO, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco CODFC_OLO_AGCOM: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:CODFC_OLO_AGCOM, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco DATA_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:DATA_FILE, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;,&amp;quot;Elenco DESCR_STATO_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:DESCR_STATO_FILE, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco ESITO: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:ESITO, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco ID_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:ID_FILE, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco COD_INTRFC: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:COD_INTRFC, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco TIMSTP_APERTURA_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:TIMSTP_APERTURA_FILE, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco VERSO_DEL_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:VERSO_DEL_FILE, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco IDTPLG_FILE: &amp;quot;, tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:IDTPLG_FILE, &amp;quot; , &amp;quot;),&amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;Elenco DATA_DEPOSITO_OLO: &amp;quot;,tib:concat-sequence-format($AccumulateDir/tns:InsertDir/tns:Insert/tns:FileProcstoInput/tns:DATA_DEPOSITO_OLO, &amp;quot; , &amp;quot;))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns4:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
