            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="0ca1658d-8bd6-4793-968d-b8659ba012b6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
