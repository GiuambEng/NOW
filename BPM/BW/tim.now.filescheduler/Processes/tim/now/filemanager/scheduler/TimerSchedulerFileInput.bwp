                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="FileName"
                                    name="NomeFileEnd"
                                    outputVariable="FileName"
                                    tibex:xpdlId="efbde85e-cc12-4ab4-abe5-fafeb37c216e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="EmptyToNomeFileEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="NomeFileEndToAssignMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/SchedulerUtility/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileName&quot;/>&#xa;    &lt;xsl:param name=&quot;ENDSuf&quot;/>&#xa;    &lt;xsl:param name=&quot;FolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;indexDIR&quot;/>&#xa;    &lt;xsl:param name=&quot;SisIDQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameSenzaTappo&quot;/>&#xa;    &lt;xsl:template name=&quot;FileName&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:FileName>&#xa;            &lt;xsl:for-each select=&quot;$FileName/tns5:File&quot;>&#xa;                &lt;tns5:File>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns5:File>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FolderDelimiter)&quot;>&#xa;                    &lt;tns5:File>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH,$FileNameSenzaTappo, $ENDSuf)&quot;/>&#xa;                    &lt;/tns5:File>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:File>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FolderDelimiter, $FileNameSenzaTappo, $ENDSuf)&quot;/>&#xa;                    &lt;/tns5:File>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:FileName>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

                                    <value
                                    processVariable="FileName" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="if ($TipoFile='FWA') then&#xd;&#xa;&#x9;concat(substring-before($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)],&quot;f.xml&quot;),&quot;.xml&quot;)&#xd;&#xa;else(&#xd;&#xa;&#x9;if ($TipoFile='NGA' or $TipoFile='ADSL' or $TipoFile='GPON') then&#xd;&#xa;&#x9;&#x9;concat(substring-before($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)],&quot;f.xml&quot;),&quot;.xml&quot;)&#xd;&#xa;&#x9;else (&#xd;&#xa;&#x9;&#x9;if (($TipoFile='REG' or $TipoFile='SDT' or $TipoFile='CPS') and ends-with($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)], &quot;_f.xml&quot;)) then&#xd;&#xa;&#x9;&#x9;&#x9;concat(substring-before($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)],&quot;_f.xml&quot;),&quot;.xml&quot;)&#x9;else (if (($TipoFile='NP') and ends-with($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)], &quot;.ctr&quot;)) then  &#x9;&#x9;&#x9;&#x9;concat(substring-before($SFTP_DIR/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[number($indexGETC)],&quot;.ctr&quot;),&quot;.xml&quot;) &#xd;&#xa;&#x9;&#x9;&#x9;&#xd;&#xa;&#x9;&#x9;&#x9;else &quot;File bad: Naming not in convention&quot;)&#xd;&#xa;&#x9;&#x9;&#xd;&#xa;&#x9;)&#xd;&#xa;)"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="FileNameSenzaTappo"
                                    name="AssignNomeSenzaTappo"
                                    outputVariable="FileNameSenzaTappo"
