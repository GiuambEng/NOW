                                    expression="if ($TipoFile='FWA') then&#xd;&#xa;&#x9;concat(substring-before($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)],&quot;f.xml&quot;),&quot;.xml&quot;)&#xd;&#xa;else(&#xd;&#xa;&#x9;if ($TipoFile='NGA' or $TipoFile='ADSL' or $TipoFile='GPON') then&#xd;&#xa;&#x9;&#x9;concat(substring-before($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)],&quot;f.xml&quot;),&quot;.xml&quot;)&#xd;&#xa;&#x9;else (&#xd;&#xa;&#x9;&#x9;if (($TipoFile='REG' or $TipoFile='SDT' or $TipoFile='CPS') and ends-with($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)], &quot;_f.xml&quot;)) then&#xd;&#xa;&#x9;&#x9;&#x9;concat(substring-before($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)],&quot;_f.xml&quot;),&quot;.xml&quot;)&#x9;else (if (($TipoFile='NP') and ends-with($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)], &quot;.ctr&quot;)) then  &#x9;&#x9;&#x9;&#x9;concat(substring-before($SFTP_DIR.SftpDirOutput/tns:File[number($indexGETC)],&quot;.ctr&quot;),&quot;.xml&quot;) &#xd;&#xa;&#x9;&#x9;&#x9;&#xd;&#xa;&#x9;&#x9;&#x9;else &quot;File bad: Naming not in convention&quot;)&#xd;&#xa;&#x9;&#x9;&#xd;&#xa;&#x9;)&#xd;&#xa;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
