select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns2:LocalFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:LocalFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FolderDelimiter, $FileNameSenzaTappo)&quot;/>&#xa;                    &lt;/tns2:LocalFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:credenziali>&#xa;                &lt;tns2:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/NOME_HOST&quot;/>&#xa;                &lt;/tns2:Host>&#xa;                &lt;tns2:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SisIDQuery/Record[number($indexDIR)]/PORT)&quot;/>&#xa;                &lt;/tns2:Port>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SisIDQuery/Record[number($indexDIR)]/SISTEMA='FENP'&quot;>&#xa;                        &lt;tns2:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerFENP&quot;/>&#xa;                        &lt;/tns2:Password>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerOLO&quot;/>&#xa;                        &lt;/tns2:Password>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:User>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/UTENZA&quot;/>&#xa;                &lt;/tns2:User>&#xa;            &lt;/tns2:credenziali>&#xa;        &lt;/tns2:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
