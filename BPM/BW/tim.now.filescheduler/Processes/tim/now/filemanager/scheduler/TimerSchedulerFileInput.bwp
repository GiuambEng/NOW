                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileProcstoUpdate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DateExtractionOutput&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperTmstp&quot;/>&lt;xsl:param name=&quot;SequenceIDFile&quot;/>&lt;xsl:param name=&quot;SisIDQuery&quot;/>&lt;xsl:param name=&quot;indexDIR&quot;/>&lt;xsl:param name=&quot;Sequence_EsecProc&quot;/>&lt;xsl:param name=&quot;FileNameSenzaTappo&quot;/>&lt;xsl:param name=&quot;DateExtraction&quot;/>&lt;xsl:param name=&quot;SFTP_GET&quot;/>&lt;xsl:param name=&quot;SFTP_DIR&quot;/>&lt;xsl:template name=&quot;MapperInsertGet-input&quot; match=&quot;/&quot;>&lt;tns:Insert>&lt;tns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;$MapperTmstp/tns:TMSP_INIZIO_ELAB&quot;/>&lt;/tns:TMSP_INIZIO_ELAB>&lt;tns:EsecuzioneProcessoFile>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;ALIMENTATORE_NOW&amp;quot;&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int($Sequence_EsecProc/Record[1]/NEXTVAL)&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_FINE_ELAB>&lt;/tns:EsecuzioneProcessoFile>&lt;tns:FileProcstoInput>&lt;xsl:if test=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_OLO&quot;>&lt;tns:COD_OLO>&lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_OLO&quot;/>&lt;/tns:COD_OLO>&lt;/xsl:if>&lt;tns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CODFC_OLO_AGCOM>&lt;xsl:if test=&quot;$DateExtraction/tns1:DateFromFilename&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$DateExtraction/tns1:DateFromFilename&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;TRASFERITO&amp;quot;&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;&amp;quot;INSERITO&amp;quot;&quot;/>&lt;/tns:ESITO>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($SequenceIDFile/Record[1]/NEXTVAL)&quot;/>&lt;/tns:ID_FILE>&lt;tns:COD_INTRFC>&lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/COD_INTRFC&quot;/>&lt;/tns:COD_INTRFC>&lt;tns:TIMSTP_APERTURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_APERTURA_FILE>&lt;tns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/VERSO&quot;/>&lt;/tns:VERSO_DEL_FILE>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$FileNameSenzaTappo&quot;/>&lt;/tns:NOME_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tib:substring-after-last($FileNameSenzaTappo, &amp;quot;.&amp;quot;))='ZIP'&quot;>&lt;tns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;'CSV'&quot;/>&lt;/tns:IDTPLG_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;upper-case(tib:substring-after-last($FileNameSenzaTappo, &amp;quot;.&amp;quot;))&quot;/>&lt;/tns:IDTPLG_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;>&lt;tns:DATA_DEPOSITO_OLO>&lt;xsl:value-of select=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;/>&lt;/tns:DATA_DEPOSITO_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;starts-with($FileNameSenzaTappo, '103')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-after(substring-before($SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_')))=14 and string(number(substring-after(substring-before($SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))))!='NaN'&quot;>&lt;tns:TIMSTP_NP>&lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyyMMddHHmmss&amp;quot;,substring-after(substring-before($SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[starts-with(., concat(substring-before($FileNameSenzaTappo, '.xml'),'_'))], '.xml'), concat(substring-before($FileNameSenzaTappo, '.xml'),'_')))&quot;/>&lt;/tns:TIMSTP_NP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;>&lt;tns:TIMSTP_NP>&lt;xsl:value-of select=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;/>&lt;/tns:TIMSTP_NP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;>&lt;tns:TIMSTP_NP>&lt;xsl:value-of select=&quot;$SFTP_GET/SftpGetOutput/tns2:SFTP_GetJavaCodeOutput/tns2:lastModify&quot;/>&lt;/tns:TIMSTP_NP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/tns:FileProcstoInput>&lt;/tns:Insert>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperInsertGet-input"
