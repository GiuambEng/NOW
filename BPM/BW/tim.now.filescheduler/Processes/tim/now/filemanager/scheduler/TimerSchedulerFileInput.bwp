:when test=&quot;ends-with($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FolderDelimiter)&quot;>&#xa;                        &lt;tns5:fullName>&#xa;                            &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $MapperInsertGet/tns:FileProcstoInput/tns:NOME_FILE)&quot;/>&#xa;                        &lt;/tns5:fullName>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:fullName>&#xa;                            &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/LOCAL_PATH, $FolderDelimiter, $MapperInsertGet/tns:FileProcstoInput/tns:NOME_FILE)&quot;/>&#xa;                        &lt;/tns5:fullName>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length(string($MapperInsertGet/tns:FileProcstoInput/tns:DATA_FILE))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MapperInsertGet/tns:FileProcstoInput/tns:DATA_FILE&quot;>&#xa;                        &lt;tns5:DataFile>&#xa;                            &lt;xsl:value-of select=&quot;$MapperInsertGet/tns:FileProcstoInput/tns:DATA_FILE&quot;/>&#xa;                        &lt;/tns5:DataFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns5:File>&#xa;        &lt;/tns5:FileInfo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
