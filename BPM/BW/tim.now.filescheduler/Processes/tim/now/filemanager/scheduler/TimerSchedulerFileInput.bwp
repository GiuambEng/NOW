                        tibex:faultNameVar="FaultName3" tibex:xpdlId="0a554924-3dce-4089-b877-befdc57aecaa">
                        <bpws:scope name="scope2">
                            <bpws:flow name="flow6">
                                <bpws:links>
                                    <bpws:link name="Confirm1ToRethrow" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Confirm1"
                                    tibex:xpdlId="01fb663a-8590-41d3-9352-1fb3808b02e8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="Confirm1ToRethrow"/>
                                    </bpws:sources>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.confirm"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="JMSReceiveMessage" xsi:type="generalactivities:Confirm"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:rethrow name="Rethrow" tibex:xpdlId="d8b48f72-5ad7-4a86-b531-19a965e502e1">
                                    <bpws:targets>
                                    <bpws:target linkName="Confirm1ToRethrow"/>
                                    </bpws:targets>
                                </bpws:rethrow>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:catchAll>
                </bpws:faultHandlers>
                <bpws:flow name="flow5">
                    <bpws:links>
                        <bpws:link name="JMSReceiveMessageToWhile" tibex:linkType="SUCCESS"/>
                        <bpws:link name="GroupStart4ToJMSReceiveMessage" tibex:linkType="SUCCESS"/>
                        <bpws:link name="Log6ToGroupEnd3" tibex:linkType="SUCCESS"/>
                    </bpws:links>
                    <bpws:empty name="GroupStart4"
                        tibex:group="groupStart" tibex:xpdlId="e1c23e05-9a8f-41c3-adf7-ed7799a0b612">
                        <bpws:sources>
                            <bpws:source linkName="GroupStart4ToJMSReceiveMessage"/>
                        </bpws:sources>
                    </bpws:empty>
                    <bpws:empty name="GroupEnd3" tibex:group="groupEnd" tibex:xpdlId="e27cee6b-b6a6-4e34-9e15-4b9fd0db41d5">
                        <bpws:targets>
                            <bpws:target linkName="Log6ToGroupEnd3"/>
                        </bpws:targets>
                    </bpws:empty>
                    <bpws:extensionActivity>
                        <tibex:receiveEvent createInstance="yes"
                            eventTimeout="60" name="JMSReceiveMessage"
                            tibex:xpdlId="e0998708-b1bb-4583-9bdf-b8da811b42b2"
                            variable="JMSReceiveMessage" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="GroupStart4ToJMSReceiveMessage"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="JMSReceiveMessageToWhile">
                                    <tibex:DesignExpression/>
                                </bpws:source>
                            </bpws:sources>
                            <sequenceKey
                                expression="string(&quot;JMS_INPUT&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            <sequenceKeyDesign
                                expression="string(&quot;JMS_INPUT&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            <tibex:eventSource>
                                <bwext:BWActivity
                                    activityTypeID="bw.jms.receive"
                                    version="6.0.0.20132205"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jms="http://ns.tibco.com/bw/palette/jms" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="destinationName" processProperty="JMSqueueName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiverEventSource"/>
                                    <value
                                    connectionReference="jmsConnection"
                                    maxSessions="1"
                                    messagingStyle="Queue"
                                    receiveTimeout="2" xsi:type="jms:JMSReceiverEventSource"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:eventSource>
                        </tibex:receiveEvent>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            inputVariable="Log6-input" name="Log6"
                            tibex:xpdlId="09956bea-3168-42ea-b06a-d800eec0888a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="JMSReceiveMessageToWhile"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Log6ToGroupEnd3"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Log6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Ricevuto messaggio di start su coda: &amp;quot;,$JMSReceiveMessage/Body)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns4:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                </bpws:flow>
            </bpws:scope>
            <bpws:empty name="ExistRecords" tibex:xpdlId="6cf62a23-1b17-4b2b-ae98-6b6c0241790d">
                <bpws:targets>
                    <bpws:target linkName="ForEach1ToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToLogPreInsert_Y">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($AccumulateDir/ns15:InsertDir/ns15:Insert) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($AccumulateDir/ns15:InsertDir/ns15:Insert) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToLogNoFile_N">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UnzipperFile-input"
                    name="UnzipperFile"
                    tibex:xpdlId="68fa54c8-c4a6-4975-8bb6-f4254726355c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInfoFileInseritiToUnzipperFile_NPNG"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UnzipperFileToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FileNameZip&quot;/>&lt;xsl:template name=&quot;UnzipperFile-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$FileNameZip&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="tim.now.filescheduler.UnzipperFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
