                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="while">
                    <bpws:empty name="GroupInit2" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression expression="$index&lt;=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=2]]></bpws:condition>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart3ToSisIDQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SisIDQueryToGroupEnd2" tibex:linkType="SUCCESS"/>
