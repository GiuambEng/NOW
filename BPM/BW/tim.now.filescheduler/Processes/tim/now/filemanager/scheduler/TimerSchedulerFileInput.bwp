                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="Insert_EsecFileToLogInsertEsecFile"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fa5be4c0-1597-46b2-bd6a-93bd22487a9d+input&quot; xmlns:tns=&quot;http://www.example.org/FileProcstoUpdate&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AccumulateDir&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_EsecFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateDir/tns:InsertDir/tns:Insert&quot;>&#xa;                &lt;Record>&#xa;                    &lt;COD_PROCSO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:COD_PROCSO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:COD_PROCSO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_PROCSO_FILE>&#xa;                    &lt;ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:ID_ESEC_PROCSO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ESEC_PROCSO_FILE>&#xa;                    &lt;STATO_ESEC>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:STATO_ESEC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:STATO_ESEC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_ESEC>&#xa;                    &lt;TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;tns:TMSP_INIZIO_ELAB&quot;/>&#xa;                    &lt;/TMSP_INIZIO_ELAB>&#xa;                    &lt;TMSP_FINE_ELAB>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:TMSP_FINE_ELAB)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:TMSP_FINE_ELAB&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TMSP_FINE_ELAB>&#xa;                    &lt;COD_PROCSO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:COD_PROCSO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:COD_PROCSO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_PROCSO_FILE>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns5:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ESEC_PROCSO_FILE (COD_PROCSO_FILE, ID_ESEC_PROCSO_FILE,&#xa;  STATO_ESEC, TMSP_INIZIO_ELAB, TMSP_FINE_ELAB, ID_PROCSO_FILE)&#xa;  VALUES (?, ?, ?, ?, ?, (SELECT ID_PROCSO_FILE FROM PROCSO_FILE &#xa;  WHERE COD_PROCSO_FILE = ?))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROCSO_FILE"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_ESEC"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_INIZIO_ELAB"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_FINE_ELAB"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="Insert_FileProcessato-input"
                        name="Insert_FileProcessato"
                        outputVariable="Insert_FileProcessato"
                        tibex:xpdlId="072e8869-41a3-419a-972f-6a5e6181c1a2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="LogInsertEsecFileToInsert_FileProcessato"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="Insert_FileProcessatoToLogInsertFileProcsto"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+072e8869-41a3-419a-972f-6a5e6181c1a2+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/FileProcstoUpdate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AccumulateDir&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_FileProcessato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateDir/tns:InsertDir/tns:Insert&quot;>&#xa;                &lt;Record>&#xa;                    &lt;COD_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:COD_OLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:COD_OLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_OLO>&#xa;                    &lt;CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:CODFC_OLO_AGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string(tns:FileProcstoInput/tns:DATA_FILE))>0&quot;>&#xa;                            &lt;DATA_FILE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:DATA_FILE)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:DATA_FILE&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/DATA_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_FILE xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DESCR_STATO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:DESCR_STATO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:DESCR_STATO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DESCR_STATO_FILE>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:ESITO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:ESITO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ESITO>&#xa;                    &lt;ID_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:ID_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:ID_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_FILE>&#xa;                    &lt;COD_INTRFC>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:COD_INTRFC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:COD_INTRFC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_INTRFC>&#xa;                    &lt;TIMSTP_APERTURA_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:TIMSTP_APERTURA_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:TIMSTP_APERTURA_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIMSTP_APERTURA_FILE>&#xa;                    &lt;VERSO_DEL_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:VERSO_DEL_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:VERSO_DEL_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/VERSO_DEL_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns:FileProcstoInput/tns:COD_INTRFC='FILE_NPNG_OLO_BATCH' and ends-with(tns:FileProcstoInput/tns:NOME_FILE, '.CSV')&quot;>&#xa;                            &lt;NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(tns:FileProcstoInput/tns:NOME_FILE, '.CSV'), '.csv')&quot;/>&#xa;                            &lt;/NOME_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;NOME_FILE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:NOME_FILE)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:NOME_FILE&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/NOME_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:EsecuzioneProcessoFile/tns:ID_ESEC_PROCSO_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:EsecuzioneProcessoFile/tns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ESEC_PROCSO_FILE>&#xa;                    &lt;IDTPLG_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:IDTPLG_FILE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:IDTPLG_FILE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDTPLG_FILE>&#xa;                    &lt;DATA_DEPOSITO_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:DATA_DEPOSITO_OLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:DATA_DEPOSITO_OLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATA_DEPOSITO_OLO>&#xa;                    &lt;TIMSTP_NP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:FileProcstoInput/tns:TIMSTP_NP)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:FileProcstoInput/tns:TIMSTP_NP&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIMSTP_NP>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns5:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO FILE_PROCSTO (COD_OLO,CODFC_OLO_AGCOM,DATA_FILE, DESCR_STATO_FILE, ESITO, ID_FILE, &#xd;&#xa;ID_INTRFC, TIMSTP_APERTURA_FILE, VERSO_DEL_FILE, NOME_FILE, ID_ESEC_PROCSO_FILE, IDTPLG_FILE, DATA_DEPOSITO_OLO, TIMSTP_NP)&#xd;&#xa;  VALUES (?,?,?, ?, ?, ?, (SELECT INTRFC.ID_INTRFC FROM INTRFC WHERE INTRFC.COD_INTRFC=?), ?, ?, ?, ?,&#xd;&#xa;  (SELECT TIPOLG_FILE.IDTPLG_FILE FROM TIPOLG_FILE WHERE TIPOLG_FILE.DESCR = ?),?,?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_INTRFC"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_APERTURA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VERSO_DEL_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_FILE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="DATA_DEPOSITO_OLO"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_NP"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
