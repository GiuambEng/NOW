        &lt;tns6:SftRenameJavaCodeOperationRequest&gt;
            &lt;SftpRenameInput&gt;
                &lt;tns5:SFTP_RenameJavaCodeInput&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:source&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $FileNameSenzaTappo)"/&gt;
                            &lt;/tns5:source&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:source&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)"/&gt;
                            &lt;/tns5:source&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:dest&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $FileNameSenzaTappo, string(current-dateTime()))"/&gt;
                            &lt;/tns5:dest&gt;
