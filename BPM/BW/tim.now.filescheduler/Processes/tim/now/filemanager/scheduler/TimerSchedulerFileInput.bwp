                                    portType="ns41:SFTPRenameJavaCode" tibex:xpdlId="0fe942b8-89dd-4413-bec6-32d8f2f57069">

                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/SFTPRenameJavaCode/" xmlns:tns5="http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="RemoteFolderDelimiter"/&gt;
    &lt;xsl:param name="indexDIR"/&gt;
    &lt;xsl:param name="SisIDQuery"/&gt;
    &lt;xsl:param name="FileNameTimstpNP103"/&gt;
    &lt;xsl:param name="PasswordServerOLO"/&gt;
    &lt;xsl:param name="PasswordServerFENP"/&gt;
    &lt;xsl:template name="MoveTmstp-input" match="/"&gt;
        &lt;tns6:SftRenameJavaCodeOperationRequest&gt;
            &lt;SftpRenameInput&gt;
                &lt;tns5:SFTP_RenameJavaCodeInput&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:source&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $FileNameTimstpNP103)"/&gt;
                            &lt;/tns5:source&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:source&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter, $FileNameTimstpNP103)"/&gt;
                            &lt;/tns5:source&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:dest&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $FileNameTimstpNP103)"/&gt;
                            &lt;/tns5:dest&gt;
                        &lt;/xsl:when&gt;
