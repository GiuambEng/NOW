                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPRenameJavaCode/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/SFTP_RenameJavaCode&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_DIR.SftpDirOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;indexDIR&quot;/>&#xa;    &lt;xsl:param name=&quot;SisIDQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoteFolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;PasswordServerOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;indexGETC&quot;/>&#xa;    &lt;xsl:param name=&quot;PasswordServerFENP&quot;/>&#xa;    &lt;xsl:template name=&quot;MoveTappoTimestamp-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:SFTP_RenameJavaCodeInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)&quot;>&#xa;                    &lt;tns5:source>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)])&quot;/>&#xa;                    &lt;/tns5:source>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:source>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter,  $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)])&quot;/>&#xa;                    &lt;/tns5:source>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $RemoteFolderDelimiter)&quot;>&#xa;                    &lt;tns5:dest>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)], string(current-dateTime()))&quot;/>&#xa;                    &lt;/tns5:dest>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:dest>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/STORAGE_PATH, $RemoteFolderDelimiter,  $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)], string(current-dateTime()))&quot;/>&#xa;                    &lt;/tns5:dest>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:credenziali>&#xa;                &lt;tns5:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/NOME_HOST&quot;/>&#xa;                &lt;/tns5:Host>&#xa;                &lt;tns5:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SisIDQuery/Record[number($indexDIR)]/PORT)&quot;/>&#xa;                &lt;/tns5:Port>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SisIDQuery/Record[number($indexDIR)]/SISTEMA='FENP'&quot;>&#xa;                        &lt;tns5:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerFENP&quot;/>&#xa;                        &lt;/tns5:Password>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerOLO&quot;/>&#xa;                        &lt;/tns5:Password>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:User>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/UTENZA&quot;/>&#xa;                &lt;/tns5:User>&#xa;            &lt;/tns5:credenziali>&#xa;        &lt;/tns5:SFTP_RenameJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
