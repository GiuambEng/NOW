                                    <bpws:invoke
                                    inputVariable="SFTP_RemoveTappo-input"
                                    name="SFTP_RemoveTappo"
                                    operation="SftRemoveJavaCodeOperation"
                                    outputVariable="SFTP_RemoveTappo"
                                    partnerLink="SFTP_Remove"
                                    portType="ns20:SFTPRemoveJavaCode" tibex:xpdlId="2a120b8f-cd78-4e9e-a2ea-4d849be0e097">

                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/SFTPRemoveJavaCode/" xmlns:tns5="http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/SFTP_DirJavaCode" version="2.0"&gt;
    &lt;xsl:param name="indexGETC"/&gt;
    &lt;xsl:param name="SisIDQuery"/&gt;
    &lt;xsl:param name="indexDIR"/&gt;
    &lt;xsl:param name="SFTP_DIR"/&gt;
    &lt;xsl:param name="RemoteFolderDelimiter"/&gt;
    &lt;xsl:param name="PasswordServerOLO"/&gt;
    &lt;xsl:param name="PasswordServerFENP"/&gt;
    &lt;xsl:template name="SFTP_RemoveTappo-input" match="/"&gt;
        &lt;tns6:SftRemoveJavaCodeOperationRequest&gt;
            &lt;SftpRemoveInput&gt;
                &lt;tns5:SFTP_RemoveJavaCodeInput&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:RemoteFile&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[number($indexGETC)])"/&gt;
                            &lt;/tns5:RemoteFile&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:RemoteFile&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter,  $SFTP_DIR/SftpDirOutput/tns3:SFTP_DirJavaCodeOutput/tns3:File[number($indexGETC)])"/&gt;
                            &lt;/tns5:RemoteFile&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns5:credenziali&gt;
                        &lt;tns5:Host&gt;
                            &lt;xsl:value-of select="$SisIDQuery/Record[number($indexDIR)]/NOME_HOST"/&gt;
                        &lt;/tns5:Host&gt;
                        &lt;tns5:Port&gt;
                            &lt;xsl:value-of select="xsd:int($SisIDQuery/Record[number($indexDIR)]/PORT)"/&gt;
                        &lt;/tns5:Port&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$SisIDQuery/Record[number($indexDIR)]/SISTEMA='FENP'"&gt;
                                &lt;tns5:Password&gt;
                                    &lt;xsl:value-of select="$PasswordServerFENP"/&gt;
                                &lt;/tns5:Password&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:Password&gt;
                                    &lt;xsl:value-of select="$PasswordServerOLO"/&gt;
                                &lt;/tns5:Password&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:User&gt;
                            &lt;xsl:value-of select="$SisIDQuery/Record[number($indexDIR)]/UTENZA"/&gt;
                        &lt;/tns5:User&gt;
                    &lt;/tns5:credenziali&gt;
                &lt;/tns5:SFTP_RemoveJavaCodeInput&gt;
            &lt;/SftpRemoveInput&gt;
        &lt;/tns6:SftRemoveJavaCodeOperationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPRemoveJavaCode/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SFTP_DIR.SftpDirOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;indexGETC&quot;/>&#xa;    &lt;xsl:param name=&quot;SisIDQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;indexDIR&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoteFolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;PasswordServerOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;PasswordServerFENP&quot;/>&#xa;    &lt;xsl:template name=&quot;SFTP_RemoveTappo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:SFTP_RemoveJavaCodeInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)&quot;>&#xa;                    &lt;tns5:RemoteFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)])&quot;/>&#xa;                    &lt;/tns5:RemoteFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:RemoteFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter,  $SFTP_DIR.SftpDirOutput/tns3:File[number($indexGETC)])&quot;/>&#xa;                    &lt;/tns5:RemoteFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:credenziali>&#xa;                &lt;tns5:Host>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/NOME_HOST&quot;/>&#xa;                &lt;/tns5:Host>&#xa;                &lt;tns5:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SisIDQuery/Record[number($indexDIR)]/PORT)&quot;/>&#xa;                &lt;/tns5:Port>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SisIDQuery/Record[number($indexDIR)]/SISTEMA='FENP'&quot;>&#xa;                        &lt;tns5:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerFENP&quot;/>&#xa;                        &lt;/tns5:Password>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Password>&#xa;                            &lt;xsl:value-of select=&quot;$PasswordServerOLO&quot;/>&#xa;                        &lt;/tns5:Password>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:User>&#xa;                    &lt;xsl:value-of select=&quot;$SisIDQuery/Record[number($indexDIR)]/UTENZA&quot;/>&#xa;                &lt;/tns5:User>&#xa;            &lt;/tns5:credenziali>&#xa;        &lt;/tns5:SFTP_RemoveJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
