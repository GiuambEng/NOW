                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/SFTPRemoveJavaCode/" xmlns:tns5="http://www.tim.com/NOW/xsd/SFTP_RemoveJavaCode" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="indexDIR"/&gt;
    &lt;xsl:param name="SisIDQuery"/&gt;
    &lt;xsl:param name="RemoteFolderDelimiter"/&gt;
    &lt;xsl:param name="FileNameSenzaTappo"/&gt;
    &lt;xsl:param name="PasswordServerOLO"/&gt;
    &lt;xsl:param name="PasswordServerFENP"/&gt;
    &lt;xsl:template name="SFTP_Remove-input" match="/"&gt;
        &lt;tns6:SftRemoveJavaCodeOperationRequest&gt;
            &lt;SftpRemoveInput&gt;
                &lt;tns5:SFTP_RemoveJavaCodeInput&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="ends-with($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter)"&gt;
                            &lt;tns5:RemoteFile&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $FileNameSenzaTappo)"/&gt;
                            &lt;/tns5:RemoteFile&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:RemoteFile&gt;
                                &lt;xsl:value-of select="concat($SisIDQuery/Record[number($indexDIR)]/REMOTE_PATH, $RemoteFolderDelimiter, $FileNameSenzaTappo)"/&gt;
                            &lt;/tns5:RemoteFile&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns5:credenziali&gt;
                        &lt;tns5:Host&gt;
                            &lt;xsl:value-of select="$SisIDQuery/Record[number($indexDIR)]/NOME_HOST"/&gt;
                        &lt;/tns5:Host&gt;
                        &lt;tns5:Port&gt;
                            &lt;xsl:value-of select="xsd:int($SisIDQuery/Record[number($indexDIR)]/PORT)"/&gt;
                        &lt;/tns5:Port&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$SisIDQuery/Record[number($indexDIR)]/SISTEMA='FENP'"&gt;
                                &lt;tns5:Password&gt;
                                    &lt;xsl:value-of select="$PasswordServerFENP"/&gt;
                                &lt;/tns5:Password&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:Password&gt;
                                    &lt;xsl:value-of select="$PasswordServerOLO"/&gt;
                                &lt;/tns5:Password&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:User&gt;
                            &lt;xsl:value-of select="$SisIDQuery/Record[number($indexDIR)]/UTENZA"/&gt;
                        &lt;/tns5:User&gt;
                    &lt;/tns5:credenziali&gt;
                &lt;/tns5:SFTP_RemoveJavaCodeInput&gt;
            &lt;/SftpRemoveInput&gt;
