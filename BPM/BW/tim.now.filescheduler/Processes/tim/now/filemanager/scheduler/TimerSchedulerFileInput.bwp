            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogInfoFileInseriti-input"
                    name="LogInfoFileInseriti"
                    tibex:xpdlId="96684140-c2a3-438c-a475-8b824d7e5245" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LocalTransactionToLog11"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log1ToCreaFileTappo">
                            <tibex:DesignExpression/>
                        </bpws:source>
                        <bpws:source linkName="LogInfoFileInseritiToUnzipperFile_NPNG">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($FileNameZip/ns51:File)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($FileNameZip/ns51:File)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/SchedulerUtility/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/FileZipList&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileName&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameZip&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInfoFileInseriti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Schedulatore - Nomi dei File trovati:&amp;quot;, tib:concat-sequence-format($FileName/tns6:File, &amp;quot; , &amp;quot;), &amp;quot;&amp;#xD;&amp;#xA; Schedulatore - Nomi dei File NPNG trovati:  &amp;quot;, tib:concat-sequence-format($FileNameZip/tns5:File/tns5:FileName, &amp;quot; , &amp;quot;))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns4:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
