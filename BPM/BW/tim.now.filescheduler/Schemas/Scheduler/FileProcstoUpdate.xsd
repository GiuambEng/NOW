<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/FileProcstoUpdate" elementFormDefault="qualified" targetNamespace="http://www.example.org/FileProcstoUpdate">
	<element name="InsertDir">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:Insert"/>
    		</sequence>
    	</complexType>
    </element>
	<element name="Insert">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="TMSP_INIZIO_ELAB" type="dateTime"/>
    			<element maxOccurs="1" minOccurs="0" ref="tns:EsecuzioneProcessoFile"/>
    			<element maxOccurs="1" minOccurs="0" ref="tns:FileProcstoInput"/>
    		</sequence>
    	</complexType>
    </element>
	<element name="EsecuzioneProcessoFile">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="COD_PROCSO_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="ID_ESEC_PROCSO_FILE" type="int"/>
    			<element maxOccurs="1" minOccurs="1" name="STATO_ESEC">
					<simpleType>
						<restriction base="string">
							<enumeration value="IN ELABORAZIONE"/>
							<enumeration value="CHIUSO"/>
						</restriction>
					</simpleType>
				</element>
    			<element maxOccurs="1" minOccurs="1" name="TMSP_FINE_ELAB" type="dateTime"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="FileProcstoInput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="COD_OLO" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="CODFC_OLO_AGCOM" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DATA_FILE" type="date"/>
    			<element maxOccurs="1" minOccurs="1" name="DESCR_STATO_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="ESITO" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="ID_FILE" type="int"/>
    			<element maxOccurs="1" minOccurs="1" name="COD_INTRFC" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="TIMSTP_APERTURA_FILE" type="dateTime"/>
    			<element maxOccurs="1" minOccurs="1" name="VERSO_DEL_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="NOME_FILE" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="IDTPLG_FILE" type="string"/>
    				<element maxOccurs="1" minOccurs="0" name="DATA_DEPOSITO_OLO" type="dateTime"/>
    				<element maxOccurs="1" minOccurs="0" name="TIMSTP_NP" type="dateTime"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
