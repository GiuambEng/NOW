<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckConsistenza/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckConsistenza/">
	<element name="REQUEST">
    	<complexType>
    		<sequence>
    			<element name="REQUEST" type="tns:requestType"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="RESPONSE">
    	<complexType>
    		<sequence>
    			<element name="HEADER" type="tns:headerType"></element>
    			<element name="RESPONSE" type="tns:responseType"></element>
    		</sequence>
    	</complexType>
    </element>
    <complexType name="headerType">
    	<sequence>
    		<element name="TRANSACTION_ID">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="TRANSACTION_DATE" type="dateTime"></element>
    		<element name="SISTEMA_ORIGINE">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"></maxLength>
    					<enumeration value="NOW"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>
    <complexType name="requestType">
    	<sequence>
    		<element name="DATA_RICHIESTA" type="dateTime"></element>
    		<element name="CODICE_OLO">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="ID_RISORSA" type="string"></element>
    	</sequence>
    </complexType>
    <complexType name="responseType">
    	<sequence>
    		<element name="STATO_RISORSA" maxOccurs="1" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="11"></enumeration>
    					<enumeration value="12"></enumeration>
    					<enumeration value="13"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DATA_ATTIVAZIONE" type="dateTime"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="DATA_CESSAZIONE" type="dateTime" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="DATA_VARIAZIONE" type="dateTime" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="COIDCE_OLO_RIS" maxOccurs="1"
    			minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		
    		<element name="RETURN_CODE">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="00"></enumeration>
    					<enumeration value="01"></enumeration>
    					<enumeration value="99"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DESCRIZIONE_ERRORE" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>
    <element name="FAULT">
    	<complexType>
    		<sequence>
    			<element name="Codice_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Messaggio_Errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>