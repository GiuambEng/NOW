<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Blacklist" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Blacklist">

    <complexType name="InputType">
    	<sequence>
    		<element name="IdRisorsa" type="string" minOccurs="0"></element>
    		<element name="IdRisorsa2" type="string" minOccurs="0"></element>
    		<element name="Telefonico" type="string" minOccurs="0"></element>
    		<element name="DN" type="string" minOccurs="0" maxOccurs="10"></element>
    	</sequence>
    </complexType>
    <complexType name="OutputType">
    	<sequence>
    		<element name="Esito">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="KO"></enumeration>
    					<enumeration value="OK"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="ListaType">
    	<sequence>
    		<element name="Risorsa" type="string" minOccurs="0" maxOccurs="13"></element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:InputType"></element>

    <element name="Output" type="tns:OutputType"></element>
    
    <element name="Lista" type="tns:ListaType"></element>
</schema>