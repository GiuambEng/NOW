<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/StagingInput" xmlns:tns="http://www.example.org/StagingInput" elementFormDefault="qualified" xmlns:Q1="http://www.tim.now.sharedlibrary.logprocess.telecom">

    <import namespace="http://www.tim.now.sharedlibrary.logprocess.telecom"></import>
    <complexType name="StagingLocalizzatore_type">
    	<sequence>
    		<element name="ID_ESEC_PROCSO_NO_FILE" type="int" minOccurs="1"
    			maxOccurs="1">
    		</element>
    		<element name="TIMESTAMP_REQUEST" type="dateTime"
    			minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="XML_REQUEST" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="TIMESTAMP_RESPONSE" type="dateTime" minOccurs="0" maxOccurs="1"></element>
    		<element name="XML_RESPONSE" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="ESITO" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="ID_STATO_ELAB" type="int" minOccurs="1" maxOccurs="1"></element>
    		<element name="AmbitoXDSL" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="CodOLO" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="CodComune" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="CodISP" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="CodOrdRifOLO" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="CodOrdRifTI" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="DescrizioneErr" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="ErrMsg" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="FlagNaked" type="string" minOccurs="0" maxOccurs="1">
    		</element>
    		<element name="HTTPResponse" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="IdCorrelazione" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="IdRIchiestaLoczre" type="int" minOccurs="1" maxOccurs="1"></element>
    		<element name="IdRisorsa" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="Operatore" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="RC" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="Richiesta" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="Servizio" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="SistemaOrigine" type="string" minOccurs="1" maxOccurs="1"></element>
    		<element name="SistemaCompetenza" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    


    <element name="StagingLocalizzatore" type="tns:StagingLoczreInput_type"></element>

    <complexType name="StagingLoczreInput_type">
    	<sequence>
    		<element name="OPERATION" minOccurs="1" maxOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="INSERT"></enumeration>
    					<enumeration value="UPDATE"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="STAGING_LCZRE"
    			type="tns:StagingLocalizzatore_type" minOccurs="0" maxOccurs="1">
    		</element>
    	</sequence>
    </complexType>

</schema>