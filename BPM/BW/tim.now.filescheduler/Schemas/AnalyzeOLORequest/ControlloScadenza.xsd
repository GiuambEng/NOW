<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/ControlloScadenza" xmlns:tns="http://www.example.org/ControlloScadenza" elementFormDefault="qualified">

    <element name="Input">
    <complexType>
    <sequence>
    	<element name="NomeFile" type="string"></element>
    	<element name="DataFile" type="date"></element>
    	<element name="IDFile" type="int"></element>
    	<element name="IDEsecProcsoFile" type="int"></element>
    	<element name="Size" type="int"></element>
    </sequence>
    </complexType>
    </element>
    <element name="Output">
    	<simpleType>
    		<restriction base="string">
    			<enumeration value="OK"></enumeration>
    			<enumeration value="SCADUTO"></enumeration>
    		</restriction>
    	</simpleType>
    </element>
</schema>