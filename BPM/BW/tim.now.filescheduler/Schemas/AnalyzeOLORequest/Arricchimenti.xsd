<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Arricchimenti" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Arricchimenti">

    <complexType name="ListaOfferteType">
    	<sequence>
    		<element name="Offerta" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="ListaIdOffertaType">
    	<sequence>
    		<element name="Offerta" type="tns:TrascodificaOffertaType" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="TrascodificaOffertaType">
    	<sequence>
    		<element name="Nome_Offerta" type="string"></element>
    		<element name="ID_Offerta" type="int"></element>
    	</sequence>
    </complexType>
    
        <complexType name="ListaComuniType">
    	<sequence>
    		<element name="CodiceIstatComune" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="ListaDescrComuneType">
    	<sequence>
    		<element name="Comune" type="tns:TrascodificaComuneType" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="TrascodificaComuneType">
    	<sequence>
    		<element name="CodiceComune" type="string"></element>
    		<element name="DescrComune" type="string"></element>
    	</sequence>
    </complexType>


    <element name="ListaOfferte" type="tns:ListaOfferteType"></element>
    <element name="ListaIdOfferta" type="tns:ListaIdOffertaType"></element>
    <element name="ListaCodiciComune" type="tns:ListaComuniType"></element>
    <element name="ListaDescrComune" type="tns:ListaDescrComuneType"></element>
</schema>