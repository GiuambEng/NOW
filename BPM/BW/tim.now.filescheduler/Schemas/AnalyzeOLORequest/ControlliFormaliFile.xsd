<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/xsd/ControlliFormaliFile"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ControlliFormaliFile" xmlns:pref="http://www.tim.com/NOW/xsd/ReadFileInfo">
	<import schemaLocation="ReadFileInfo.xsd" namespace="http://www.tim.com/NOW/xsd/ReadFileInfo"></import>

	<element name="Input" type="tns:InputType"></element>

    <complexType name="InputType">
    	<sequence>
    	    <element name="DatiFile" type="pref:OutputType"></element>
    		<element name="LocalPath" type="string"></element>
    	</sequence>
    </complexType>
    <complexType name="OutputType">
    	<sequence>
    		<element name="Output" type="string"></element>
    		<element name="CodOLOAGCOM" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<length value="3"></length>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CodOLOISP" minOccurs="0">
    	    	<simpleType>
    	    		<restriction base="string">
    	    			<length value="3"></length>
    	    		</restriction>
    	    	</simpleType>
    	    </element>
    	    <element name="CodOLOaccorpante" maxOccurs="1" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<length value="3"></length>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Output" type="tns:OutputType"></element>
</schema>