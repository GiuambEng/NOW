                <bpws:link name="Log2ToJDBCUpdate" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertLogFileProcstoToJDBCUpdate" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdateToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
