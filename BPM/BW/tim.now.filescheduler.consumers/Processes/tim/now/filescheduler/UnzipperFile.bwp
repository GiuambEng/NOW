                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select * from appuser.LOCZRE_CRITR_ROLLT where cod_olo = ?&#xa;and id_sistema =15&#xa;and (idtplg_lavrz = 1 or idtplg_lavrz = 2)&#xa;and id_trascodfc_offerta IN (&#xa;    select id_trascodfc_offerta    &#xa;    from appuser.TRASCODFC_OFFERTA where nome_offerta_esterna ='NPNG' and provenienza='XML')" xsi:type="jdbcPalette:JDBCQueryActivity">

