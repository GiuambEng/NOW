        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput"
            name="ErrorLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns15:ErrorLinkHandlerFaultData"
            name="_error_RemoveDir" sca-bpel:internal="true"/>
        <bpws:variable element="ns17:FileInfo" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="FolderDelimiter" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerSchedulerFileInput/FolderDelimiter" type="xsd:string"/>
        <bpws:variable name="AcquisitionFolder"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/NPNG/AcquisitionFolder" type="xsd:string"/>
        <bpws:variable name="NPNGFolder" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/NPNG/NPNGFolder" type="xsd:string"/>
