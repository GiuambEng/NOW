        <bpws:variable element="ns14:ActivityInput" name="Log2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log3-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log4-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log5-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log6-input" sca-bpel:internal="true"/>
