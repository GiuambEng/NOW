        <bpws:variable element="ns2:ReadActivityOutputTextClass"
            name="ReadFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log9-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns19:resultSet" name="JDBCQuery" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log10-input" sca-bpel:internal="true"/>
        <bpws:variable name="dataFormatResource"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
