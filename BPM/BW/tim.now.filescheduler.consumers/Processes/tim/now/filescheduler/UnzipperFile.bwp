                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToCreateFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/NewXMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;Mappercsv2xml-input&quot; match=&quot;/&quot;>&lt;RichiestaOloRegolatorio>&lt;xsl:for-each select=&quot;$ParseData/Rows/tns:FileNPNG&quot;>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;translate(tns:OPERATORE_REC_CPS, '&amp;quot;', '')&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;translate(tns:CODICE_ORDINE_OLO, '&amp;quot;', '')&quot;/>&lt;/CodiceOrdineOlo>&lt;/Testata>&lt;Ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:CAUSALE_ORDINE='0'&quot;>&lt;Attivazione>&lt;NPnonGeografica>&lt;DN>&lt;xsl:value-of select=&quot;translate(tns:DN_CDS_SAC, '&amp;quot;', '')&quot;/>&lt;/DN>&lt;RoutingNumber>&lt;xsl:value-of select=&quot;translate(tns:RN_TRANSCODIFICA, '&amp;quot;', '')&quot;/>&lt;/RoutingNumber>&lt;CodiceDonor>&lt;xsl:value-of select=&quot;translate(tns:OPERATORE_DONOR, '&amp;quot;', '')&quot;/>&lt;/CodiceDonor>&lt;NoteAggiuntive>&lt;xsl:value-of select=&quot;translate(tns:TEXT_NOTE, '&amp;quot;', '')&quot;/>&lt;/NoteAggiuntive>&lt;xsl:if test=&quot;string-length(tns:OPERATORE_DONATING)>0 and tns:OPERATORE_DONATING !='&amp;quot;'&quot;>&lt;CodiceDonating>&lt;xsl:value-of select=&quot;translate(tns:OPERATORE_DONATING, '&amp;quot;', '')&quot;/>&lt;/CodiceDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns:DATA_CONTR)>0 and not(contains(tns:DATA_CONTR,'&amp;quot;'))&quot;>&lt;xsl:if test=&quot;tib:validate-dateTime('dd/MM/yyyy', tns:DATA_CONTR)&quot;>&lt;DataSottoscrizioneContratto>&lt;xsl:value-of select=&quot;translate(tns:DATA_CONTR, '&amp;quot;', '')&quot;/>&lt;/DataSottoscrizioneContratto>&lt;/xsl:if>&lt;/xsl:if>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;translate(tns:COGNOME_RAGIONE_SOCIALE_CLIENTE, '&amp;quot;', '')&quot;/>&lt;/CognomeRagSoc>&lt;Nome>&lt;xsl:value-of select=&quot;translate(tns:NOME_CLIENTE, '&amp;quot;', '')&quot;/>&lt;/Nome>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:CF_PIVA_CLIENTE)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;matches(tns:CF_PIVA_CLIENTE, '[A-Z]{6}[0-9A-Z][0-9LMNPQRSTUV][ABCDEHLMPRST][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z]') and string-length(tns:CF_PIVA_CLIENTE)=16&quot;>&lt;xsl:if test=&quot;tns:CF_PIVA_CLIENTE&quot;>&lt;CF>&lt;xsl:value-of select=&quot;tns:CF_PIVA_CLIENTE&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;matches(tns:CF_PIVA_CLIENTE, '[0-9]{11}') and string-length(tns:CF_PIVA_CLIENTE)=11&quot;>&lt;xsl:if test=&quot;tns:CF_PIVA_CLIENTE&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;tns:CF_PIVA_CLIENTE&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/DatiCliente>&lt;OpzioneTraffico>&lt;xsl:value-of select=&quot;translate(tns:OPZIONE_TRAFFICO, '&amp;quot;', '')&quot;/>&lt;/OpzioneTraffico>&lt;DataDAC>&lt;xsl:value-of select=&quot;translate(tns:DATA_INIZIO_RANGE, '&amp;quot;', '')&quot;/>&lt;/DataDAC>&lt;OraCutOver>&lt;xsl:value-of select=&quot;translate(tns:ORARIO_CUT_OVER, '&amp;quot;', '')&quot;/>&lt;/OraCutOver>&lt;DataCutOver>&lt;xsl:value-of select=&quot;translate(tns:DATA_INIZIO_RANGE, '&amp;quot;', '')&quot;/>&lt;/DataCutOver>&lt;NumeroBolletta>&lt;xsl:value-of select=&quot;translate(tns:NUMERO_FATTURA_1, '&amp;quot;', '')&quot;/>&lt;/NumeroBolletta>&lt;BimestreRiferimento>&lt;xsl:value-of select=&quot;translate(tns:BIMESTRE_FATTURA_1, '&amp;quot;', '')&quot;/>&lt;/BimestreRiferimento>&lt;TipoDocumento>&lt;xsl:value-of select=&quot;translate(tns:TIPO_DOCUMENTO, '&amp;quot;', '')&quot;/>&lt;/TipoDocumento>&lt;NumeroDocumento>&lt;xsl:value-of select=&quot;translate(tns:NUMERO_DOCUMENTO, '&amp;quot;', '')&quot;/>&lt;/NumeroDocumento>&lt;xsl:if test=&quot;string-length(tns:DATA_EMISSIONE_DOCUMENTO)>0 and tns:DATA_EMISSIONE_DOCUMENTO !='&amp;quot;'&quot;>&lt;DataEmissione>&lt;xsl:value-of select=&quot;translate(tns:DATA_EMISSIONE_DOCUMENTO, '&amp;quot;', '')&quot;/>&lt;/DataEmissione>&lt;/xsl:if>&lt;AutoritaEmittente>&lt;xsl:value-of select=&quot;translate(tns:AUTORITA_EMITTENTE, '&amp;quot;', '')&quot;/>&lt;/AutoritaEmittente>&lt;CodiceProvisioning>&lt;xsl:value-of select=&quot;translate(tib:trim(tns:CODICE_TIPO_PROVISIONING), '&amp;quot;', '')&quot;/>&lt;/CodiceProvisioning>&lt;Sede>&lt;Via>&lt;xsl:value-of select=&quot;translate(tns:INDR_CLIENTE, '&amp;quot;', '')&quot;/>&lt;/Via>&lt;CodiceComune>&lt;xsl:value-of select=&quot;translate(tns:CODICE_COMUNE_CLIENTE, '&amp;quot;', '')&quot;/>&lt;/CodiceComune>&lt;CAP>&lt;xsl:value-of select=&quot;translate(tns:CAP_CLIENTE, '&amp;quot;', '')&quot;/>&lt;/CAP>&lt;/Sede>&lt;xsl:if test=&quot;string-length(tns:CODICE_REFERENTE_OLO)>0 &quot;>&lt;Referente>&lt;CodiceReferente>&lt;xsl:value-of select=&quot;translate(tns:CODICE_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/CodiceReferente>&lt;NomeReferente>&lt;xsl:value-of select=&quot;translate(tns:NOME_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/NomeReferente>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;translate(tns:COGNOME_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/CognomeReferente>&lt;IndirizzoReferente>&lt;xsl:value-of select=&quot;translate(tns:INDR_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/IndirizzoReferente>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;translate(tns:TEL_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/TelefonoFissoReferente>&lt;FaxReferente>&lt;xsl:value-of select=&quot;translate(tns:FAX_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/FaxReferente>&lt;EmailReferente>&lt;xsl:value-of select=&quot;translate(tns:EMAIL_REFERENTE_OLO, '&amp;quot;', '')&quot;/>&lt;/EmailReferente>&lt;CapReferente>&lt;xsl