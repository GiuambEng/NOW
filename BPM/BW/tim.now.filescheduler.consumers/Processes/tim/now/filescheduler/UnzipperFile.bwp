                                    columnName="DATAFI"
                                    dataType="93" typeName="DATE"/>

                                    <columnMetadata
                                    columnName="DATAINZ"
                                    dataType="93" typeName="DATE"/>

                                    <columnMetadata
                                    columnName="ID_SISTEMA"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="IDTPLG_LAVRZ"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="ID_TRASCODFC_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="CONTA_ORDN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="VOLUMI_IN_NOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
