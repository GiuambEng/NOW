            sca-bpel:sharedResourceType="{http://ns.tibco.com/bw/palette/dataformat}DataFormat" type="xsd:string">
            <bpws:from>
                <bpws:literal>tim.now.filescheduler.DataFormatCSVNPNG</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns21:Input" name="ParseData-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns22:Output" name="ParseData" sca-bpel:internal="true"/>
        <bpws:variable element="RichiestaOloRegolatorio"
            name="Mappercsv2xml-input" sca-bpel:internal="true"/>
        <bpws:variable element="RichiestaOloRegolatorio"
            name="Mappercsv2xml" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CreateActivityInputClass"
            name="CreateFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CreateActivityOutputClass"
            name="CreateFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:WriteActivityInputTextClass"
            name="WriteFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:WriteActivityOutputClass"
            name="WriteFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CreateActivityInputClass"
            name="CreateFile1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CreateActivityOutputClass"
            name="CreateFile1" sca-bpel:internal="true"/>
        <bpws:variable name="ENDSuf" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/ENDSuf" type="xsd:string"/>
        <bpws:variable element="ns14:ActivityInput" name="Log11-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log12-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log13-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log14-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log15-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log16-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:ActivityInput" name="Log17-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns25:Input" name="ScartoFile-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToIterate" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="6a51019e-323e-4ea4-8253-0f88c6e0a5c3"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToIterate"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="0e1e9e02-b4f6-484b-bf0c-bd5dbe622284" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="eeb957f8-0b9e-4ba7-af16-248b5b623bc4">
                <bpws:targets>
                    <bpws:target linkName="Log1ToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable element="ns16:fileInfo" name="RenameFileOutput"/>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:faultHandlers>
                    <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                        tibex:faultNameVar="FaultName1" tibex:xpdlId="6e3af888-31f1-435a-8bac-2910af62eb2e">
                        <bpws:scope name="scope1">
                            <bpws:flow name="flow2">
                                <bpws:links/>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ErrorLog-input"
                                    name="ErrorLog"
                                    tibex:xpdlId="5a1409a0-df37-4c83-b5ae-eee7fb1cf9ed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value
                                    role="Error"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:catchAll>
                </bpws:faultHandlers>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns17:File" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns17:File)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns17:Iterate_Current_Element_File"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="JavaInvokeToListFiles" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="InvokeToJDBCUpdate1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ListFilesToRenameFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToJavaInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="RemoveDirToEmpty1" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="RemoveFileToLog" tibex:linkType="ERROR"/>
                                    <bpws:link name="LogToEmpty1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="RenameFileToUpdateFileProcsto" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log2ToJavaUnzipper_ZIP"
                                    tibex:label="ZIP" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link name="Log2ToRenameFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link name="Log3ToEmpty" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Log4ToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Log4ToRemoveDir_ZIP"
                                    tibex:label="ZIP" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="UpdateFileProcstoToLog5" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Log5ToQueryIntrfc" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="QueryIntrfcToLog6" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log6ToQueryTipolg_File" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="QueryTipolg_FileToLog7" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log7ToTracciaOutput" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Log8ToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdateEsecProcsoFileToLog8" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="EmptyToRenameFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCQueryToRenameFile_Name"
                                    tibex:label="" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Empty1ToUpdateFileProcsto_AMBITOCRMWS"
                                    tibex:label="AMBITOCRMWS" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link name="Empty1ToScope"
                                    tibex:label="AMBITONOW" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link name="Log9ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Log10ToRenameFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="ScopeToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="10b6c357-978f-4694-8f40-51fbf81b3447" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJavaInvoke">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns17:File)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="bdfd8256-2892-4f63-9be4-d76cac6f3006">
                                    <bpws:targets>
                                    <bpws:target linkName="Log8ToGroupEnd"/>
                                    <bpws:target linkName="ScopeToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:invoke
                                    inputVariable="TracciaOutput-input"
                                    name="TracciaOutput"
                                    operation="Insert"
                                    outputVariable="TracciaOutput"
                                    partnerLink="ProcessLog"
                                    portType="ns9:ProcessLog" tibex:xpdlId="926a27af-16c6-4d96-8565-441abbbb2ea1">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns17="http://www.tim.com/NOW/xsd/FileZipList" version="2.0"&gt;
    &lt;xsl:param name="RenameFile"/&gt;
    &lt;xsl:param name="QueryIntrfc"/&gt;
    &lt;xsl:param name="QueryTipolg_File"/&gt;
    &lt;xsl:param name="currentElement"/&gt;
    &lt;xsl:template name="TracciaOutput-input" match="/"&gt;
        &lt;tns1:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:ProcFile&gt;
                        &lt;ns:ID_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:int($QueryIntrfc/Record[1]/ID_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_PROCSO_FILE&gt;
                    &lt;/ns:ProcFile&gt;
                    &lt;ns:FileProcessato&gt;
                        &lt;ns:COD_OLO&gt;
                            &lt;xsl:value-of select="$currentElement/tns17:COD_OLO"/&gt;
                        &lt;/ns:COD_OLO&gt;
                        &lt;ns:CODFC_OLO_AGCOM&gt;
                            &lt;xsl:value-of select="$currentElement/tns17:CODFC_OLO_AGCOM"/&gt;
                        &lt;/ns:CODFC_OLO_AGCOM&gt;
                        &lt;ns:DATA_FILE&gt;
                            &lt;xsl:value-of select="string(current-date())"/&gt;
                        &lt;/ns:DATA_FILE&gt;
                        &lt;ns:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;
                        &lt;/ns:DESCR_STATO_FILE&gt;
                        &lt;ns:ESITO&gt;
                            &lt;xsl:value-of select="&amp;quot;CRMWS&amp;quot;"/&gt;
                        &lt;/ns:ESITO&gt;
                        &lt;ns:ID_INTRFC&gt;
                            &lt;xsl:value-of select="xsd:int($QueryIntrfc/Record[1]/ID_INTRFC)"/&gt;
                        &lt;/ns:ID_INTRFC&gt;
                        &lt;ns:IDTPLG_FILE&gt;
                            &lt;xsl:value-of select="xsd:int($QueryTipolg_File/Record[1]/IDTPLG_FILE)"/&gt;
                        &lt;/ns:IDTPLG_FILE&gt;
                        &lt;ns:NOME_FILE&gt;
                            &lt;xsl:value-of select="$RenameFile/fileInfo/fileName"/&gt;
                        &lt;/ns:NOME_FILE&gt;
                        &lt;ns:TIMSTP_APERTURA_FILE&gt;
                            &lt;xsl:value-of select="string(current-dateTime())"/&gt;
                        &lt;/ns:TIMSTP_APERTURA_FILE&gt;
                        &lt;ns:TIMSTP_CHIUSURA_FILE&gt;
                            &lt;xsl:value-of select="string(current-dateTime())"/&gt;
                        &lt;/ns:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;ns:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;
                        &lt;/ns:VERSO_DEL_FILE&gt;
                    &lt;/ns:FileProcessato&gt;
                    &lt;ns:EsecuzioneFile&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="string(current-dateTime())"/&gt;
                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns:EsecuzioneFile&gt;
                    &lt;ns:FileProcessatoOutput&gt;
                        &lt;ns:DIMENSIONE_FILE&gt;
                            &lt;xsl:value-of select="$RenameFile/fileInfo/size"/&gt;
                        &lt;/ns:DIMENSIONE_FILE&gt;
                        &lt;ns:TIMSTP_CREZIONE_FILE&gt;
                            &lt;xsl:value-of select="string(current-dateTime())"/&gt;
                        &lt;/ns:TIMSTP_CREZIONE_FILE&gt;
                    &lt;/ns:FileProcessatoOutput&gt;
                    &lt;ns:ContenutoFile&gt;
                        &lt;ns:FullName&gt;
                            &lt;xsl:value-of select="$RenameFile/fileInfo/fullName"/&gt;
                        &lt;/ns:FullName&gt;
                        &lt;ns:Size&gt;
                            &lt;xsl:value-of select="xsd:int($RenameFile/fileInfo/size)"/&gt;
                        &lt;/ns:Size&gt;
                    &lt;/ns:ContenutoFile&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns1:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns17=&quot;http://www.tim.com/NOW/xsd/FileZipList&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenameFile&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryIntrfc&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryTipolg_File&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciaOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($QueryIntrfc/Record[1]/ID_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns17:COD_OLO&quot;/>&#xa;                &lt;/ns:COD_OLO>&#xa;                &lt;ns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/tns17:CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-date())&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;ns:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($QueryIntrfc/Record[1]/ID_INTRFC)&quot;/>&#xa;                &lt;/ns:ID_INTRFC>&#xa;                &lt;ns:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($QueryTipolg_File/Record[1]/IDTPLG_FILE)&quot;/>&#xa;                &lt;/ns:IDTPLG_FILE>&#xa;                &lt;ns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fileName&quot;/>&#xa;                &lt;/ns:NOME_FILE>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;ns:DIMENSIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/size&quot;/>&#xa;                &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;ns:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fullName&quot;/>&#xa;                &lt;/ns:FullName>&#xa;                &lt;ns:Size>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($RenameFile/fileInfo/size)&quot;/>&#xa;                &lt;/ns:Size>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="Log7ToTracciaOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToJDBCUpdate1"/>
                                    </bpws:sources>
                                </bpws:invoke>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="RenameFile-input"
                                    name="RenameFile"
                                    outputVariable="RenameFile"
                                    tibex:xpdlId="3a49d5c1-142c-49ca-95da-9f5fdce55c04" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log10ToRenameFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenameFileToUpdateFileProcsto">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns17=&quot;http://www.tim.com/NOW/xsd/FileZipList&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListFiles&quot;/>&#xa;    &lt;xsl:param name=&quot;PathCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;AcquisitionFolder&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNGFolder&quot;/>&#xa;    &lt;xsl:param name=&quot;PathNOW&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;RenameFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RenameActivityConfig>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($currentElement/tns17:FileName, &amp;quot;.zip&amp;quot;) or ends-with($currentElement/tns17:FileName, &amp;quot;.ZIP&amp;quot;)&quot;>&#xa;                    &lt;xsl:if test=&quot;$ListFiles/files/fileInfo[ends-with(fileName, '.csv') or ends-with(fileName, '.CSV')][1]/fullName&quot;>&#xa;                        &lt;fromFileName>&#xa;                            &lt;xsl:value-of select=&quot;$ListFiles/files/fileInfo[ends-with(fileName, '.csv') or ends-with(fileName, '.CSV')][1]/fullName&quot;/>&#xa;                        &lt;/fromFileName>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;fromFileName>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/tns17:fullName&quot;/>&#xa;                    &lt;/fromFileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery/Record) > 0&quot;>&#xa;                    &lt;toFileName>&#xa;                        &lt;xsl:value-of select=&quot;concat( $AcquisitionFolder, $currentElement/tns17:CODFC_OLO_AGCOM, $NPNGFolder, $PathNOW, substring-before($currentElement/tns17:FileName, &amp;quot;.&amp;quot;), '.csv')&quot;/>&#xa;                    &lt;/toFileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;toFileName>&#xa;                        &lt;xsl:value-of select=&quot;concat( $AcquisitionFolder, $currentElement/tns17:CODFC_OLO_AGCOM, $NPNGFolder, $PathCRMWS, substring-before($currentElement/tns17:FileName, &amp;quot;.&amp;quot;), '.csv')&quot;/>&#xa;                    &lt;/toFileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--C10->il fle viene sostato sotto FileNOW per entrare su NOW se dalla query del localizzatore esce almeno un record (localizzazione su base olo)-->&#xa;        &lt;/tns1:RenameActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.rename"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true"
                                    overwrite="true" xsi:type="file:RenameFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JavaUnzipper-input"
                                    name="JavaUnzipper"
                                    outputVariable="JavaUnzipper"
                                    tibex:xpdlId="3d20bcea-5827-4712-8a6f-43962e85c993" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
