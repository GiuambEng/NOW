                                    <tibex:activityExtension
                                    inputVariable="Mappercsv2xml-input"
                                    name="Mappercsv2xml"
                                    outputVariable="Mappercsv2xml"
                                    tibex:xpdlId="0638bd4b-1ca8-4170-86ff-1772a270fffb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
