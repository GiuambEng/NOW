<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns="http://www.tim.com/NOW/xsd/N_NP_start" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/N_NP_start" xmlns:Q1="http://www.tim.com/NOW/xsd/Lavorate">

    <xsd:import namespace="http://www.tim.com/NOW/xsd/Lavorate"></xsd:import>
