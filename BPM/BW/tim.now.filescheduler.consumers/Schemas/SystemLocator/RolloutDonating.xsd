<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RolloutDonating"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/RolloutDonating" xmlns:pref="http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS">

	<import schemaLocation="VerificaAllineamentoCRMWS.xsd" namespace="http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS"></import>
	<complexType name="InputType">
		<sequence>
			<element name="TransactionId" type="string" minOccurs="0"></element>
			<element name="SistemaOrigine" type="string" minOccurs="0"></element>
			<element name="CodOLO">
				<simpleType>
					<restriction base="string">
						<length value="3"></length>
					</restriction>
				</simpleType>
			</element>
			<element name="Servizio" type="string"></element>
			<element name="CodiceComune" type="string" minOccurs="0"></element>
			<element name="Risorsa" type="string" minOccurs="0"></element>
			<element name="DataRichiesta" type="dateTime"></element>
			<element name="Richiesta" type="string"></element>
			<element name="IdEsecProcsoNoFile" type="int"
				minOccurs="0">
			</element>
			<element name="DNAggiuntivi" type="string" minOccurs="0"
				maxOccurs="10">
			</element>
			<element ref="pref:Esiti"></element>
		</sequence>
	</complexType>

	<complexType name="OutputType">
		<sequence>
			<element name="SistemaDiCompetenza" type="string"></element>
		</sequence>
	</complexType>
	<element name="Input" type="tns:InputType"></element>
	<element name="Output" type="tns:OutputType"></element>
</schema>