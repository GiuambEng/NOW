<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/">
	<element name="RequestGet_Multiple_Hash_Secolo">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="CodificaOLOAGCOM" type="string"/>																
				<element maxOccurs="1" minOccurs="0" name="CodiceOrdineOLO" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Funzione" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ChiaveRiferimento" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Operatore" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="IPClient" type="string"/>
				<element maxOccurs="20" minOccurs="0" name="HashIN">
					<complexType>
						<sequence>
							<element maxOccurs="1" minOccurs="0" name="key" type="string"/>
							<element maxOccurs="1" minOccurs="0" name="value" type="string"/>
						</sequence>
					</complexType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Bonifica">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
							<enumeration value="Y"/>
							<enumeration value="N"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="IdRichOLO" type="string"/>														 
			</sequence>
		</complexType>
	</element>
	<element name="ResponseGet_Multiple_Hash_Secolo">
		<complexType>
			<sequence>
				<element maxOccurs="20" minOccurs="0" name="HashOUT">
					<complexType>
						<sequence>
							<element maxOccurs="1" minOccurs="0" name="key" type="string"/>
							<element maxOccurs="1" minOccurs="0" name="value" type="string"/>
						</sequence>
					</complexType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="RETURN_CODE" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>
