<?xml version="1.0" encoding="UTF-8"?>

<schema targetNamespace="http://www.tim.com/NOW/xsd/ErrorSchema/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ErrorSchema/"
	xmlns:gre="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetConsistenzaREG/Schema.xsd2">
	<element name="ErrorInput">
		<complexType>
			<sequence>
				<element name="TRANSACTION_DATE" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="TRANSACTION_ID" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="RETURN_CODE" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="DESCRIZIONE_ERRORE" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="TIPO_LAVORAZIONE" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="STRUTTURA" type="anyType" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="ORDINE" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<any />
						</sequence>
					</complexType>
				</element>
				<element name="ID_RICH_OLO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="COD_PROCSO_NOFILE" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="ID_ESEC_PROCSO_NOFILE" type="integer"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="STATO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="AGGIUNTIVI" type="string"
					maxOccurs="unbounded" minOccurs="0">
				</element>
				<element name="NP" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ID_RISORSA" type="string" maxOccurs="1" minOccurs="0"></element>
							<element name="ID_EVENTO_ORDN_NOW_WHLS"
								type="int">
							</element>
							<element name="IDDETTAGLIOORDINE" type="int" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
				<element name="ORDINEAGGIUNTIVI" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<any />
						</sequence>
					</complexType>
				</element>



				<element name="STATO_NP" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="StatoNumeriAggiuntivi" type="string"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ErrorOutput">
		<complexType>
			<sequence>
				<element name="ErrorO">
					<complexType>
						<sequence>
							<element name="TRANSACTION_DATE"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="TRANSACTION_ID" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="RETURN_CODE" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="DESCRIZIONE_ERRORE"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="TIPO_LAVORAZIONE"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>

					</complexType>
				</element>
				<element name="NumeriAggiuntivi" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="code" type="string"></element>
							<element name="msg" type="string"></element>
							<element name="identificativo" type="string"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>

		</complexType>
	</element>
</schema>