<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified"
	targetNamespace="http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/" elementFormDefault="unqualified"
	xmlns:Q1="http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/" xmlns:Q2="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"
	xmlns:Q4="http://NOW.it.telecomitalia.it/casedata_v1" >
	<xs:import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" />
	<xs:import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" schemaLocation="../../../tim.now.integration_library/Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd" />
	<xs:element name="manageNotificationRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_RICHIESTA">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="31" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:choice>
					<xs:element ref="Q2:EVENTO_NOTIFICA" />
					<xs:element ref="Q2:ACK_COMUNICAZIONE" />
				</xs:choice>
				<xs:element name="ID_ANAGRAFICA_CAUSALE" type="xs:int" />
				<xs:element name="STATO_SUCCESSIVO" type="xs:string"
					minOccurs="0" />
				<xs:element name="ID_NOTIFICA_RECIPIENT" type="xs:string"
					minOccurs="0" maxOccurs="unbounded" />
				<xs:element name="ID_NOTIFICA_DONATING" type="xs:string"
					minOccurs="0" maxOccurs="unbounded" />
				<xs:element name="ID_NOTIFICA_DONOR" type="xs:string"
					minOccurs="0" maxOccurs="unbounded" />
				<!-- <xs:element name="ARRICCHIMENTI" type="Q1:Arricchimenti_Type" minOccurs="0" 
					maxOccurs="unbounded" /> -->
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Arricchimenti_Type">
	<xs:complexType>
		<xs:sequence>
			<xs:element name="Arricchimento" type="Q1:ArricchimentoType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Operation">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="CREATE" />
						<xs:enumeration value="UPDATE" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ArricchimentoType">
		<xs:choice>
			<xs:element ref="Q4:DettaglioOrdineElement" maxOccurs="unbounded" />
			<xs:element ref="Q4:SedeElement" />
			<xs:element ref="Q4:ReferenteElement" />
			<xs:element ref="Q4:DettaglioAssetElement" />
		</xs:choice>
	</xs:complexType>
	<xs:element name="Componenti">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Componente" type="Q1:ComponenteType" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ComponenteType">
		<xs:sequence>
			<xs:element name="NomeComponente" type="xs:string" minOccurs="1"/>
			<xs:element name="Attributo" type="Q1:AttributoType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AttributoType">
		<xs:sequence>
			<xs:element name="NomeAttributoStart" type="xs:string" minOccurs="0"/>
			<xs:element name="NomeAttributoEnd" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>