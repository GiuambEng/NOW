<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:dtunm="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/" xmlns:dtu="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns="http://www.tim.com/NOW/xsd/MappingDTUNotification/" targetNamespace="http://www.tim.com/NOW/xsd/MappingDTUNotification/" elementFormDefault="qualified">
	<import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" schemaLocation="../../../tim.now.integration_library/Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd"/>
	<import namespace="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/" schemaLocation="../../../tim.now.integration_library/Schemas/BPM_DTU/BPM_DTUNotificationManagement_v1.xsd"/>
	<element name="Arricchimenti" type="dtunm:Arricchimenti_Type"/>
	<element name="MappingDTUNotificationInput">
		<complexType>
			<sequence>
				<element ref="dtu:EVENTO_NOTIFICA"/>
				<element name="Offerta" type="string"/>
				<element name="OffertaDonating" type="string"/>
				<element name="Lavorazione" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="MappingDTUNotificationOutput">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:outputType"/>
				<element ref="tns:Arricchimenti" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault" type="tns:outputType"/>
	<complexType name="outputType">
		<sequence>
			<element name="Codice" type="string"/>
			<element name="Descrizione" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>