<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/CalcoloOLOAccorpante" xmlns:ns1="http://www.tim.com/NOW/xsd/CaclcoloOLOAccorpante" targetNamespace="http://www.tim.com/NOW/xsd/CaclcoloOLOAccorpante" elementFormDefault="qualified">
