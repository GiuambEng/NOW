		<sequence>
			<element name="COD_OLO_AGCOM" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="COD_OLO_ACCORPANTE" type="string" maxOccurs="1" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>
