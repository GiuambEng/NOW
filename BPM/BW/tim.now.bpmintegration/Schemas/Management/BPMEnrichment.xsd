<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/BPMEnrichment" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/BPMEnrichment" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">
	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
	<element name="TipologiaAccessoRequest">
		<complexType>
			<sequence>
				<element name="Offerta" type="pref:OffertaEnumeration" />
			</sequence>
		</complexType>
	</element>
	<element name="TipologiaAccessoResponse">
		<complexType>
			<sequence>
				<element name="TipologiaAccesso" type="pref:TipologiaAccessoEnumeration" />
			</sequence>
		</complexType>
	</element>
	<element name="BPMEnrichmentFault" type="tns:Fault"/>
	<complexType name="Fault">
		<sequence>
			<element type="string" name="ErrorCode" />
			<element type="string" name="ErrorMessage" />
		</sequence>
	</complexType>
	<element name="VerificaNumerazioneDonorOLORequest">
		<complexType>
			<sequence>
				<element type="string" name="DN" />
				<element name="DATA_INVIO_RICH" type="date" minOccurs="0" maxOccurs="1"></element>
			</sequence>
		</complexType>
	</element>
	<element name="VerificaNumerazioneDonorOLOResponse">
		<complexType>
			<sequence>
				<element name="FlagDonorOLO">
					<simpleType>
						<restriction base="string">
							<enumeration value="N"/>
							<enumeration value="Y"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CodificaOLOAgcomDonor" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="TrascodificaOffertaRequest">
		<complexType>
			<sequence>
				<element minOccurs="0" type="string" name="IdRichiestaOlo" />
				<element type="pref:OffertaEnumeration" name="Offerta" />
			</sequence>
		</complexType>
	</element>
	<element name="TrascodificaOffertaResponse">
		<complexType>
			<sequence>
				<element minOccurs="0" type="int" name="IdOfferta" />
				<element minOccurs="0" type="pref:OffertaCatalogoEnumeration" name="OffertaCatalogo" />
				<element minOccurs="0" maxOccurs="1" type="string" name="LnaLa"  />
			</sequence>
		</complexType>
	</element>
	<element name="CodFatturazione_Request">
		<complexType>
			<sequence>
				<element minOccurs="1" type="string"
					name="IdRichiestaOlo" />
				<choice minOccurs="0" maxOccurs="1">
					<element minOccurs="1" type="string"
						name="CodiceFiscale" maxOccurs="1" />
					<element minOccurs="1" type="string"
						name="PartitaIVA" maxOccurs="1" />
				</choice>
				<element minOccurs="1" type="string" name="TipoLinea" />
				<element minOccurs="1" type="string"
					name="StrutturaLinea" />
				<element minOccurs="0" type="string"
					name="Direzionalita" />
				<element minOccurs="0" type="string"
					name="SelezionePassante" />
				<element minOccurs="0" type="string"
					name="AccessoNumerico" />
				<element minOccurs="0" type="string"
					name="NumAggiuntivi" />
				<element minOccurs="0" type="string"
					name="QuantitaCanali" />
				<element name="BandaServizio" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="CanaliBidirezionali" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="CanaliEntranti" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="CanaliTotali" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>	
	</element>
	<element name="CodFatturazione_Response">
		<complexType>
			<sequence>
				<element minOccurs="0" maxOccurs="1" type="string" name="CodFatturazionePrincipale" />
				<element minOccurs="0" maxOccurs="1" type="string" name="CodFatturazioneAggiuntivi" />
			</sequence>
		</complexType>	
	</element>
	<element name="RecuperaInfoNotf_Request">
		<complexType>
			<sequence>
				<element minOccurs="1" maxOccurs="1" type="string" name="IdRichiestaOLO" />
			</sequence>
		</complexType>	
	</element>
	<element name="RecuperaInfoNotf_Response">
		<complexType>
			<sequence>
				<element minOccurs="0" maxOccurs="unbounded" type="tns:RecuperaInfoNotf_Output" name="RecuperaInfoNotf_Output"/>
			</sequence>
		</complexType>	
	</element>
	<complexType name="RecuperaInfoNotf_Output">
		<sequence>
			<element minOccurs="0" maxOccurs="1" type="string" name="IDNotifica" />
			<element minOccurs="0" maxOccurs="1" type="string" name="TipologiaNotifica" />
			<element minOccurs="0" maxOccurs="1" type="string" name="TipologiaDestinatario" />
			<element minOccurs="0" maxOccurs="1" type="string" name="CodificaOloAgcom" />
			<element minOccurs="0" maxOccurs="1" type="string" name="CodificaOLONOW" />
			<element minOccurs="0" maxOccurs="1" type="string" name="StrutturaRichiesta" />
			<element minOccurs="0" maxOccurs="1" type="string" name="Lavorazione" />
		</sequence>
	</complexType>
	
	
	<element name="RecuperaContrattoAttivoRequest">
		<complexType>
			<sequence>
			<element name="CODICE_OLO" type="string" />
			<element name="CodiceOLOAGCOM" type="string" />
			<element name="Offerta" type="pref:OffertaEnumeration" />
			<element name="DRO" type="date" />
			<element name="IDRichiesta" type="string" minOccurs="0" />
			<element name="CodiceOperatoreRete" type="string" maxOccurs="1" minOccurs="0" />
		</sequence>
		</complexType>	
	</element>
	<element name="RecuperaContrattoAttivoResponse">
	 <complexType>
			<sequence>
			 <element minOccurs="0" maxOccurs="1" type="int" name="Id_Contratto"/>
	 		</sequence>
	  </complexType>
	</element>
	
	<element name="RecuperaContrattoAttivoFault">
		<complexType>
		<sequence>
			<element type="string" name="ErrorCode" />
			<element type="string" name="ErrorMessage" />
		</sequence>
	</complexType>
	</element>
	
		<element name="CheckNotificaTemporizzataRequest">
		<complexType>
			<sequence>
			<element name="IDRichiestaOLO" type="string"/>
			<element name="DAC" type="date" />
			<element name="numGiorni" type="int"/>
		</sequence>
		</complexType>	
	</element>
	<element name="CheckNotificaTemporizzataResponse">
	 <complexType>
			<sequence>
			 <element type="boolean" name="Esito"/>
			 <element type="date" name="nuovaDAC-5" minOccurs="0"/>	
			</sequence>
	  </complexType>
	</element>
			<element name="CheckOscuramentoRequest">
		<complexType>
			<sequence>
			<element name="CodiceAgesp" type="string"/>
		</sequence>
		</complexType>	
	</element>
	<element name="CheckOscuramentoResponse">
	 <complexType>
			<sequence>
			 <element name="CodiceAgesp" type="string"/>
			 <element name="FlagOscuramento" type="string"/>
			</sequence>
	  </complexType>
	</element>
		<element name="CheckOscuramentoFault">
		<complexType>
		<sequence>
			<element type="string" name="ErrorCode" />
			<element type="string" name="ErrorMessage" />
		</sequence>
	</complexType>
	</element>
	
	
	
</schema>