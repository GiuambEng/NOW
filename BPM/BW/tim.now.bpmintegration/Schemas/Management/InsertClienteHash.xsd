<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/InsertClienteHash/"
	elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/InsertClienteHash/" >
	
	<xs:element name="InsertClienteHashRequest" type="tns:RequestType" />
	<xs:complexType name="RequestType">
		<xs:sequence>
                <xs:element minOccurs="0" maxOccurs="1" type="xs:string" name="IDRichiestaOLO" />
				<xs:element minOccurs="0" maxOccurs="unbounded" type="xs:string" name="IDAssetAttivati" />
				<xs:element minOccurs="0" maxOccurs="unbounded" type="xs:string" name="IDAssetCessati" />
				<xs:element minOccurs="0" maxOccurs="unbounded" type="xs:string" name="IDAssetVariati" />
				<xs:element minOccurs="0" maxOccurs="1" type="xs:string" name="Lavorazione" />
				<xs:element minOccurs="0" maxOccurs="1" type="xs:string" name="CanaleRichiesta" />
				<xs:element minOccurs="0" maxOccurs="unbounded" type="xs:string" name="GenericParam" />
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="InsertClienteHashResponse" type="tns:ResponseType" />
	<xs:complexType name="ResponseType">
		<xs:sequence>
				<xs:element minOccurs="1" type="xs:boolean" name="Codice" />
                <xs:element minOccurs="1" type="xs:string" name="Esito" />
		</xs:sequence>
	</xs:complexType>
    
    
    <xs:element name="InsertClienteHashFault" type="tns:FaultType" />
    <xs:complexType name="FaultType">
		<xs:sequence>
		    <xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="CodeMsg" />
			<xs:element maxOccurs="1" minOccurs="1" type="xs:string" name="ErrorMsg" />         
		</xs:sequence>
	</xs:complexType>

</xs:schema>