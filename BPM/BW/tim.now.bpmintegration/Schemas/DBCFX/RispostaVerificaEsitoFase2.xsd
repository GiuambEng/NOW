<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:rf2="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" targetNamespace="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" elementFormDefault="qualified" version="1.0">
	<xs:element name="RispostaVerificaEsitoFase2_Request">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdentificativoRichiestaOLO" type="rf2:IdRichiestaType" minOccurs="1"/>
				<xs:element name="CodiceOrdineTI" type="rf2:IdRichiestaType" minOccurs="1"/>
				<xs:element name="IdLinea" type="rf2:IdLineaType" minOccurs="1"/>
				<xs:element name="VerificaFase2" type="rf2:VerificaFase2Type" minOccurs="0" maxOccurs="50"/>
				<xs:element name="NumerazioniAccesso" type="rf2:NumerazioniAccessoType" minOccurs="0" maxOccurs="10"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RispostaVerificaEsitoFase2_Ack">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Codice" type="rf2:codiceAckType" minOccurs="1"/>
				<xs:element name="Descrizione" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- ComplexTypes START -->
	<xs:complexType name="VerificaFase2Type">
		<xs:sequence>
			<xs:element name="CodiceOLO" type="rf2:CodiceOLOType" minOccurs="1"/>
			<xs:element name="DataPic" type="xs:date" minOccurs="1"/>
			<xs:element name="Esito" type="rf2:EsitoType" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NumerazioniAccessoType">
		<xs:sequence>
			<xs:element name="DN" type="rf2:IdLineaType" minOccurs="1"/>
			<xs:element name="Direzionalita" type="rf2:DirezionalitaType" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ComplexTypes END -->
	<!-- SimpleTypes START -->
	<xs:simpleType name="IdRichiestaType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="31"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DirezionalitaType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="30" />
			<xs:enumeration value="ENTRANTE"></xs:enumeration>
			<xs:enumeration value="USCENTE"></xs:enumeration>
			<xs:enumeration value="BIDIREZIONALE"></xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IdLineaType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="12"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CodiceOLOType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="3"/>
		</xs:restriction>
	</xs:simpleType>
		<xs:simpleType name="codiceAckType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EsitoType">
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:enumeration value="0"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- SimpleTypes END -->
</xs:schema>