								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="TipoRichiesta">
					<xs:complexType>
						<xs:choice>
							<xs:element name="Attivazione">
								<xs:complexType>
									<xs:choice>
										<xs:element name="PrimoFeeder">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="NOMEMacroArea">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CLLIPrimoFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CodiceTDKIT">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:minLength value="1"/>
																<xs:maxLength value="9"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDVLANOLO">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="2"/>
																<xs:maxInclusive value="4000"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="ASNumber">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IPSessione">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="FeederSuccessivo" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="NOMEMacroArea">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CLLIPrimoFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CLLIFeederSuccessivo">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="SedeOLT">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="CanaleFeeder">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda" minOccurs="0"/>
													<xs:element name="IPSorgente" minOccurs="0"/>
													<xs:element name="IPMulticast" minOccurs="0"/>
													<xs:element name="IDCanale" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="CanaleSediOLT">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDCanale" minOccurs="0"/>
													<xs:element name="IDCanaleOLD" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
							<xs:element name="Cessazione">
								<xs:complexType>
									<xs:choice>
										<xs:element name="PrimoFeeder">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="NOMEMacroArea">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CLLIPrimoFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CodiceTDKIT">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:minLength value="1"/>
																<xs:maxLength value="9"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDVLANOLO" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="2"/>
																<xs:maxInclusive value="4000"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="BandaFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="SedeOLT">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale">
														<!-- OAO compila CLLI SEDE OLT da disabilitare al Multicast in caso di Cessazione -->
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="CanaleSediOLT">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale">
														<!-- OAO compila CLLI SEDE OLT abilitata al MC e ID CANALE da disabilitare sulla sede -->
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDCanale" minOccurs="0"/>
													<xs:element name="IDCanaleOLD" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
							<xs:element name="Variazione">
								<xs:complexType>
									<xs:choice>
										<xs:element name="PrimoFeeder">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="NOMEMacroArea">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CLLIPrimoFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="CodiceTDKIT">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:minLength value="1"/>
																<xs:maxLength value="9"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDVLANOLO" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="2"/>
																<xs:maxInclusive value="4000"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="BandaFeeder">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="30"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="CanaleFeeder">
											<xs:complexType>
												<xs:sequence>
													<!-- OAO compila CLLI FEEDER, IP MULTICAST del nuovo canale, ID CANALE per sostituire un canale multicast esistente sul feeder 
																con un nuovo canale multicast (a parità di IP sorgente)
                                                                oppure OAO compila IP SORGENTE nuovo, ID CANALE di cui vuole variare l'IP sorgente per cambiare l'IP sorgente del canale (su tutti i feeder sui quali è abilitato il canale)  oppure OAO compila CLLI FEEDER, ID CANALE, BANDA NOMINALE per modificare la banda nominale del canale -->
													<xs:element name="CLLICentrale">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Banda" minOccurs="0"/>
													<xs:element name="IPSorgente" minOccurs="0"/>
													<xs:element name="IPMulticast" minOccurs="0"/>
													<xs:element name="IDCanale"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="CanaleSediOLT">
											<!-- OAO compila CLLI SEDE OLT abilitato al MC, ID CANALE da attivare e ID CANALE OLD da cessare sulla sede -->
											<xs:complexType>
												<xs:sequence>
													<xs:element name="CLLICentrale">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="8"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="IDCanale" minOccurs="0"/>
													<xs:element name="IDCanaleOLD" minOccurs="0"/>
													<xs:element name="CodiceDelivery" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
