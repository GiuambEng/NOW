<?xml version="1.0" encoding="utf-8"?>
<!-- -->
<!--Versione 1.1-->
<xs:schema xmlns:ns0="http://fwa.telecomitalia.it/crm/fwa/order" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://fwa.telecomitalia.it/crm/fwa/order" elementFormDefault="qualified">
	<xs:element name="TracciatoOLOFWA">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ns0:Richiesta"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="NotificaOLOFWA">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Intestazione">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CodiceFornitore">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="3"/>
										<xs:minLength value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CodiceOrdineFornitore" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="31"/>
										<xs:minLength value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CodiceOrdineRichiedente">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="11"/>
										<xs:minLength value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DataNotifica" type="ns0:DataType"/>
							<xs:element name="StatoOrdine">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="1"/>
										<xs:minLength value="1"/>
										<xs:enumeration value="0"/>
										<xs:enumeration value="1"/>
										<xs:enumeration value="2"/>
										<xs:enumeration value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DataDRO" type="ns0:DataType" minOccurs="0"/>
							<xs:element name="OrarioDataDRO" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="1"/>
										<xs:maxLength value="5"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:sequence maxOccurs="unbounded">
					<xs:element name="Richiesta">
						<xs:complexType>
							<xs:choice>
								<xs:element name="Acquisizione">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="IdRisorsa">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:minLength value="1"/>
														<xs:maxLength value="16"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="Rifiuto" type="ns0:Rifiuto"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="Espletamento">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="IdRisorsa">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:maxLength value="16"/>
														<xs:minLength value="1"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="IMSI">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:minLength value="1"/>
														<xs:maxLength value="15"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="MSISDN">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:minLength value="1"/>
														<xs:maxLength value="15"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="IMEI">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:minLength value="1"/>
														<xs:maxLength value="15"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="DataEspletamento" type="ns0:DataType"/>
											<xs:element name="OrarioDataEspletamento" minOccurs="0">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:minLength value="1"/>
														<xs:maxLength value="5"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:element>
											<xs:element name="Rifiuto" type="ns0:Rifiuto"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:choice>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="SedeUtente">
		<xs:sequence>
			<xs:element name="ParticellaToponomastica">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Via">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="70"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Civico">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Localita">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="60"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CodiceComune">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CAP" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="5"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Complesso" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Scala" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Piano" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Interno" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CodiceIndirizzo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="28"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ClienteFinale">
		<xs:sequence>
			<xs:element name="CognomeRagSoc">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="60"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Nome" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:choice>
				<xs:element name="CF">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="16"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PIVA">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="11"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReferenteEQ">
		<xs:sequence>
			<xs:element name="Progressivo">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
						<xs:enumeration value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Qualifica">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2"/>
						<xs:enumeration value="O"/>
						<xs:enumeration value="CF"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Nome">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Cognome">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Telefono" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Mobile" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IDRiferimento">
		<xs:choice>
			<xs:element name="TI">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="23"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ISP">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="Rifiuto">
		<xs:sequence>
			<xs:element name="TipoCausaleRifiuto">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2"/>
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
						<xs:enumeration value="3"/>
						<xs:enumeration value="4"/>
						<xs:enumeration value="5"/>
						<xs:enumeration value="8"/>
						<xs:enumeration value="9"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CodiceMotivoRifiuto">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MotivoRifiuto">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="DataType">
		<xs:restriction base="xs:string">
			<xs:minLength value="10"/>
			<xs:maxLength value="10"/>
			<xs:pattern value="\d{2}/\d{2}/\d{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Richiesta">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Testata">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CodiceOloAgcom">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="3"/>
										<xs:minLength value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CodiceOrdineOlo">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="30"/>
										<xs:minLength value="1"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Note" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="255"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="CodiceProgetto" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="15"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="TipoRichiesta">
					<xs:complexType>
						<xs:choice>
							<xs:element name="Attivazione">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="FixedWirelessAccess">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="DatiSede" type="ns0:SedeUtente"/>
													<xs:element name="ClienteFinale" type="ns0:ClienteFinale"/>
													<xs:element name="Referente" type="ns0:ReferenteEQ" minOccurs="0" maxOccurs="3"/>
													<xs:element name="TipologiaCPE">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="INDOOR"/>
																<xs:enumeration value="OUTDOOR"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="FlagIntervento">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="Y"/>
																<xs:enumeration value="N"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="Profilo">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="A"/>
																<xs:enumeration value="B"/>
																<xs:enumeration value="C"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Cessazione">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="FixedWirelessAccess">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="IDENTIFICATIVO_RISORSA">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="10"/>
																<xs:minLength value="1"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
