<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Coppia" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="NodeName" type="xs:string" minOccurs="0"/>
							<xs:element name="NodeValue" type="xs:string" minOccurs="0"/>
							<xs:element name="NodeCount" type="xs:int" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
