                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b1ed4c68-5e75-4b22-9a4f-ae767094c010+input&quot; xmlns:tns1=&quot;http://www.example.org/OpereSpeciali&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Get_FlagPermessi-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IdPreventivo>&lt;xsl:value-of select=&quot;$Start/tns1:IdPreventivo&quot;/>&lt;/IdPreventivo>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.FLAG_PERMESSI, D.QT_ARTICOLO&#xa;  FROM PREVENTIVO P, DETT_PREVENTIVO D, TRASCODFC_ARTICOLI_DTU_JPUB T&#xa;  WHERE P.ID_PREVENTIVO = D.ID_PREVENTIVO AND D.COD_ARTICOLO_JPUB = T.COD_ARTICOLO_JPUB AND P.ID_PREVENTIVO = ? &#xa;  AND T.DESCR_ARTICOLO_NOW = 'QUOTAFISSA'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdPreventivo"/>
                                    <columnMetadata
                                    columnName="FLAG_PERMESSI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QT_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
