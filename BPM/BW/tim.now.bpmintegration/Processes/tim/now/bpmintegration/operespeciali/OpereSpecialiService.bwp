Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($RichiestaPreventivo/tns3:Esito)))&quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($RichiestaPreventivo/tns3:Esito, true(), true())&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
