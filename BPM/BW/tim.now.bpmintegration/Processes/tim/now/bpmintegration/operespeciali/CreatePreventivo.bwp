                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0c555be9-0690-48ae-852d-ba32994af9e1+input&quot; xmlns:tns1=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetIdPreventivo&quot;/>&lt;xsl:template name=&quot;InsertPREVENTIVO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:integer($GetIdPreventivo/Record[1]/NEXTVAL)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;STATO_PREVENTIVO>&lt;xsl:value-of select=&quot;'INLAVORAZIONE'&quot;/>&lt;/STATO_PREVENTIVO>&lt;FLAG_OLTRE_PERIMETRO_ABITATO>&lt;xsl:value-of select=&quot;$Start/tns1:DtuOpereSpeciali/tns1:TIPO_OPA&quot;/>&lt;/FLAG_OLTRE_PERIMETRO_ABITATO>&lt;FLAG_CONTRIBUTO_CLIENTE>&lt;xsl:value-of select=&quot;$Start/tns1:DtuOpereSpeciali/tns1:CONTRIBUTO_CLIENTE&quot;/>&lt;/FLAG_CONTRIBUTO_CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/tns1:DtuOpereSpeciali/tns1:GIORNI_PREVISTI)) > 0&quot;>&lt;NUMERO_GIORNI_PREVISTO>&lt;xsl:value-of select=&quot;xsd:integer($Start/tns1:DtuOpereSpeciali/tns1:GIORNI_PREVISTI)&quot;/>&lt;/NUMERO_GIORNI_PREVISTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMERO_GIORNI_PREVISTO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/NUMERO_GIORNI_PREVISTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:DtuOpereSpeciali/tns1:FLAG_PERMESSI)>0 and number($Start/tns1:DtuOpereSpeciali/tns1:FLAG_PERMESSI)=1&quot;>&lt;FLAG_PERMESSI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAG_PERMESSI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMESSI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_PERMESSI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:DtuOpereSpeciali/tns1:NOTE_PREVENTIVO)>0&quot;>&lt;NOTE_PREVENTIVO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:DtuOpereSpeciali/tns1:NOTE_PREVENTIVO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:DtuOpereSpeciali/tns1:NOTE_PREVENTIVO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOTE_PREVENTIVO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOTE_PREVENTIVO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;$Start/tns1:IdEventoDTU&quot;/>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;DATA_PREVENTIVO_FORNITA_DA_DTU>&lt;xsl:value-of select=&quot;$Start/tns1:DtuSospensioneOpereSpeciali/tns1:DATASOSPENSIONE&quot;/>&lt;/DATA_PREVENTIVO_FORNITA_DA_DTU>&lt;PROGRS_EVENTO_DTU>&lt;xsl:value-of select=&quot;$Start/tns1:ProgEventoDtu&quot;/>&lt;/PROGRS_EVENTO_DTU>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
