                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_OLTRE_PERIMETRO_ABITATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_CONTRIBUTO_CLIENTE"/>
                                    <PreparedParameters
