                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="InsertDETTAGLIO-input"
                        name="InsertDETTAGLIO"
                        outputVariable="InsertDETTAGLIO"
                        tibex:xpdlId="47dd3fad-611b-4261-9eb9-2497095f675c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="LogInsertPREVENTIVOToJDBCUpdate"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InsertDETTAGLIOToCallProcess1"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+47dd3fad-611b-4261-9eb9-2497095f675c+input&quot; xmlns:tns1=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettagliPreventivo&quot;/>&lt;xsl:param name=&quot;GetIdPreventivo&quot;/>&lt;xsl:param name=&quot;GetTrascodificaArticoli&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;InsertDETTAGLIO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$DettagliPreventivo/tns1:DettaglioPreventivo&quot;>&lt;Record>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:integer($GetIdPreventivo/Record[1]/NEXTVAL)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_DETT_PREVENTIVO>&lt;xsl:value-of select=&quot;tns1:IdDettaglioPreventivo&quot;/>&lt;/ID_DETT_PREVENTIVO>&lt;COD_ARTICOLO_JPUB>&lt;xsl:value-of select=&quot;tns1:CodArticoloJPUB&quot;/>&lt;/COD_ARTICOLO_JPUB>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;xsd:date('2050-03-07+01:00')&quot;/>&lt;/DATAFI_VALID>&lt;QT_ARTICOLO>&lt;xsl:value-of select=&quot;tns1:QuantitaArticolo&quot;/>&lt;/QT_ARTICOLO>&lt;/Record>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:DtuOpereSpeciali/tns1:TIPO_OPA) = &amp;quot;NO&amp;quot; and (starts-with($Start/tns1:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($Start/tns1:Offerta, &amp;quot;SLU&amp;quot;) or starts-with($Start/tns1:Offerta, &amp;quot;WLR&amp;quot;) or starts-with($Start/tns1:Offerta, &amp;quot;VULL&amp;quot;)) and not(exists($Start/tns1:DtuOpereSpeciali/tns1:DESCRIZIONE_OPERE/node()[xsd:integer(.)>0]))&quot;>&lt;Record>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:integer($GetIdPreventivo/Record[1]/NEXTVAL)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_DETT_PREVENTIVO>&lt;xsl:value-of select=&quot;max($DettagliPreventivo/tns1:DettaglioPreventivo/tns1:IdDettaglioPreventivo)+1&quot;/>&lt;/ID_DETT_PREVENTIVO>&lt;COD_ARTICOLO_JPUB>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetTrascodificaArticoli/Record[DESCR_ARTICOLO_DTU='QUOTAFISSA']/COD_ARTICOLO_JPUB)&quot;>&lt;xsl:value-of select=&quot;$GetTrascodificaArticoli/Record[DESCR_ARTICOLO_DTU='QUOTAFISSA']/COD_ARTICOLO_JPUB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ARTICOLO_JPUB>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;xsd:date('2050-03-07+01:00')&quot;/>&lt;/DATAFI_VALID>&lt;QT_ARTICOLO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QT_ARTICOLO>&lt;/Record>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Record>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:integer($GetIdPreventivo/Record[1]/NEXTVAL)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_DETT_PREVENTIVO>&lt;xsl:value-of select=&quot;max($DettagliPreventivo/tns1:DettaglioPreventivo/tns1:IdDettaglioPreventivo)+1&quot;/>&lt;/ID_DETT_PREVENTIVO>&lt;COD_ARTICOLO_JPUB>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetTrascodificaArticoli/Record[DESCR_ARTICOLO_DTU='QUOTAFISSA']/COD_ARTICOLO_JPUB)&quot;>&lt;xsl:value-of select=&quot;$GetTrascodificaArticoli/Record[DESCR_ARTICOLO_DTU='QUOTAFISSA']/COD_ARTICOLO_JPUB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ARTICOLO_JPUB>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;xsd:date('2050-03-07+01:00')&quot;/>&lt;/DATAFI_VALID>&lt;QT_ARTICOLO>&lt;xsl:value-of select=&quot;100&quot;/>&lt;/QT_ARTICOLO>&lt;/Record>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="insert into DETT_PREVENTIVO (ID_PREVENTIVO,ID_DETT_PREVENTIVO,&#xa;COD_ARTICOLO_JPUB,DATAFI_VALID,QT_ARTICOLO,IMPORTO_ARTICOLO)&#xa;values (?,?,?,?,?,'0')" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PREVENTIVO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_DETT_PREVENTIVO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ARTICOLO_JPUB"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_ARTICOLO"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
