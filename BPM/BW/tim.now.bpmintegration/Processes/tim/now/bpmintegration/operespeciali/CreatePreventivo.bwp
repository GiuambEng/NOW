                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_PREVENTIVO_FORNITA_DA_DTU"/>
                                    <PreparedParameters
