                                    sqlStatement="insert into PREVENTIVO (ID_PREVENTIVO,ID_RICH_OLO,STATO_PREVENTIVO,&#xd;&#xa;FLAG_OLTRE_PERIMETRO_ABITATO,FLAG_CONTRIBUTO_CLIENTE,&#xd;&#xa;NUMERO_GIORNI_PREVISTO,FLAG_PERMESSI,NOTE_PREVENTIVO,&#xd;&#xa;TIMSTP_INSMTO,ID_EVENTO_ORDN_NOW_WHLS,DATA_PREVENTIVO_FORNITA_DA_DTU,FLAG_TIMEOUT_ACCETTAZIONE,IMPORTO_TOT,OPERATORE,PROGRS_EVENTO_DTU)&#xd;&#xa;values (?,?,?,?,?,?,?,?,?,?,?,'N','0','AUTOMATICO',?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PREVENTIVO"/>
