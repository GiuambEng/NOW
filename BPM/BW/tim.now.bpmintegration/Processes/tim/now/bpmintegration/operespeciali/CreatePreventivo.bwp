        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogFault-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:DettagliPreventivo" name="DettagliPreventivo"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogDettagliPrev-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:jdbcUpdateActivityInput"
