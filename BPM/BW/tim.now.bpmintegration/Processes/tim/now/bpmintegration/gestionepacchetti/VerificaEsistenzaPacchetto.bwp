            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GestionePacchetti/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_VerificaEsistenzaPacchetto&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogJDBC_VerificaEsistenzaPacchetto-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaEsistenzaPacchetto&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaEsistenzaPacchetto&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;concat($Start/tns:IDRichiestaOLO,' ', $_processContext/ProcessInstanceId)&quot;/>&lt;/tns1:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_VerificaEsistenzaPacchetto/Record)&quot;>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;LogJDBC_VerificaEsistenzaPacchetto: la query ha restituito il record con IDPacchettoNOW = &amp;quot;, string($JDBC_VerificaEsistenzaPacchetto/Record[1]/ID_PACTO_NOW), &amp;quot;.&amp;quot;)&quot;/>&lt;/tns1:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Message>&lt;xsl:value-of select=&quot;&amp;quot;LogJDBC_VerificaEsistenzaPacchetto: la query non ha restituito record.&amp;quot;&quot;/>&lt;/tns1:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogJDBC_VerificaEsistenzaPacchetto-input"
                    name="LogJDBC_VerificaEsistenzaPacchetto"
                    tibex:xpdlId="7096640d-96b7-4235-9167-72206e95e87a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToLogJDBC_VerificaEsistenzaPacchetto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogJDBC_RichiestaNP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipoPacchetto='1'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:TipoPacchetto='1']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogJDBC_VerificaEsistenzaPacchettoToLogInsertPactoRichSingle">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
