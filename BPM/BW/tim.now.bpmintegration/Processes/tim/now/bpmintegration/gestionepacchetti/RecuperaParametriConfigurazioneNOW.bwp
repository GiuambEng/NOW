            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GestionePacchetti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_RecuperaParametri&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RecuperaParametriConfigurazioneNOWOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBC_RecuperaParametri/Record[1]/VALORE_STRINGA) > 0&quot;>&#xa;                    &lt;tns:ValoreStringa>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaParametri/Record[1]/VALORE_STRINGA&quot;/>&#xa;                    &lt;/tns:ValoreStringa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ValoreNumerico>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_RecuperaParametri/Record[1]/VALORE_NUMERICO)&quot;/>&#xa;                    &lt;/tns:ValoreNumerico>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RecuperaParametriConfigurazioneNOWOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="f063b650-f87a-4f74-beef-7902a1ac8d9c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd_RECORDSI"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GestionePacchetti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_RecuperaParametri&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RecuperaParametriConfigurazioneNOWOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBC_RecuperaParametri/Record[1]/VALORE_STRINGA) > 0&quot;>&#xa;                    &lt;tns:ValoreStringa>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaParametri/Record[1]/VALORE_STRINGA&quot;/>&#xa;                    &lt;/tns:ValoreStringa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ValoreNumerico>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_RecuperaParametri/Record[1]/VALORE_NUMERICO)&quot;/>&#xa;                    &lt;/tns:ValoreNumerico>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RecuperaParametriConfigurazioneNOWOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
