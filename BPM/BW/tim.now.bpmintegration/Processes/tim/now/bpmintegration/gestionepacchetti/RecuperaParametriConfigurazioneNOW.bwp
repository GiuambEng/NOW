                    outputVariable="JDBC_RecuperaParametri"
                    tibex:xpdlId="b0a5e546-4e4f-41f3-9163-69f4e937ad73" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
