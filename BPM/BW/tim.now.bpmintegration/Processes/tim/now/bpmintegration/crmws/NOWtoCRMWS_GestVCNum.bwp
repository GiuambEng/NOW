                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_GestVCNUM/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessoInsertStagingGestVCNUM.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_GestVCNUMIn.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSGestVCNum.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;VCNumIdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessoUpdateStagingGestVCNUM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:GenericStaging>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($CRMWSGestVCNum.RESPONSE, true(), true())&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;            &lt;/tns1:GenericStaging>&#xa;            &lt;tns1:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_GestVCNUMIn.REQUEST/tns2:ID_RICHIESTA_OLO&quot;/>&#xa;            &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_GEST_NUM_VC_NOFOUT'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#