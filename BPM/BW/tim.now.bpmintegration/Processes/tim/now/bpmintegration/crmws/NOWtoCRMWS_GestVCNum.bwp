                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GestVCNUM/" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NOWtoCRMWS_GestVCNUMIn"/&gt;&lt;xsl:param name="VCNumIdProcsoNoFile"/&gt;&lt;xsl:param name="MapperCRMWSGestVCNum"/&gt;&lt;xsl:template name="ProcessoInsertStagingGestVCNUM-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:GenericStaging&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($NOWtoCRMWS_GestVCNUMIn/REQUEST/tns2:NOWtoCRMWS_GestVCNUMRequest)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$NOWtoCRMWS_GestVCNUMIn/REQUEST/tns2:NOWtoCRMWS_GestVCNUMRequest/tns2:ID_RICHIESTA_OLO"/&gt;&lt;/tns1:ID_RICH&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$MapperCRMWSGestVCNum/ns:TRANSACTION_ID"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;tns1:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$NOWtoCRMWS_GestVCNUMIn/REQUEST/tns2:NOWtoCRMWS_GestVCNUMRequest/tns2:COD_OLOAGCOM"/&gt;&lt;/tns1:CODFC_OLO_AGCOM&gt;&lt;/tns1:GenericStaging&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$NOWtoCRMWS_GestVCNUMIn/REQUEST/tns2:NOWtoCRMWS_GestVCNUMRequest/tns2:ID_RICHIESTA_OLO"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_GEST_NUM_VC_NOFOUT'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt