                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd&quot; xmlns:tns1=&quot;http://www.example.org/Identificativi_Processi&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_GestVCNUM/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_GestVCNUMIn.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperCRMWSGestVCNum-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REQUEST>&#xa;            &lt;tns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns:TRANSACTION_ID>&#xa;            &lt;tns:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;            &lt;/tns:TRANSACTION_DATE>&#xa;            &lt;tns:OLO_CODING>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_GestVCNUMIn.REQUEST/tns2:COD_OLOAGCOM&quot;/>&#xa;            &lt;/tns:OLO_CODING>&#xa;            &lt;tns:OLO_CODE>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_GestVCNUMIn.REQUEST/tns2:COD_OLO&quot;/>&#xa;            &lt;/tns:OLO_CODE>&#xa;            &lt;xsl:for-each select=&quot;$NOWtoCRMWS_GestVCNUMIn.REQUEST/tns2:REQUEST_VPKIT&quot;>&#xa;                &lt;tns:VP_KIT>&#xa;                    &lt;tns:NUM_VC>&#xa;                        &lt;xsl:value-of select=&quot;tns2:NUM_VC&quot;/>&#xa;                    &lt;/tns:NUM_VC>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(tns2:VP_CODE)>0&quot;>&#xa;                            &lt;tns:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;tns2:VP_CODE&quot;/>&#xa;                            &lt;/tns:ID_RISORSA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;tns2:TD_CODE&quot;/>&#xa;                            &lt;/tns:ID_RISORSA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(tns2:VP_CODE)>0&quot;>&#xa;                            &lt;tns:TIPO_CONSEGNA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&#xa;                            &lt;/tns:TIPO_CONSEGNA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TIPO_CONSEGNA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BandaDedicata&amp;quot;&quot;/>&#xa;                            &lt;/tns:TIPO_CONSEGNA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:STATO>&#xa;                        &lt;xsl:value-of select=&quot;../tns2:MODALITA&quot;/>&#xa;                    &lt;/tns:STATO>&#xa;                &lt;/tns:VP_KIT>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
