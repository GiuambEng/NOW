                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length(string($Start/tns:Update/tns:ID_ESEC_PROCSO_NO_FILE))>0 and 1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToInsert">
                            <tibex:DesignExpression>
