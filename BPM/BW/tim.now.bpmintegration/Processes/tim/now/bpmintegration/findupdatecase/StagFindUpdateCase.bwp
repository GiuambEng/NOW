            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+dccb50d0-7af4-4bc3-8932-df8a90b2db3b+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="CONTENUTO_REQUEST" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
