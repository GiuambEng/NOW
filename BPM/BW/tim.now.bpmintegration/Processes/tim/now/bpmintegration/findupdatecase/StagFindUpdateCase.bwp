                    <bpws:sources>
                        <bpws:source linkName="CallProcessToUpdateOnError">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($Start/tns:UpdateOnError/tns:DESCR_ERRORE))>0 and 1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length(string($Start/tns:UpdateOnError/tns:DESCR_ERRORE))>0 and 1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
