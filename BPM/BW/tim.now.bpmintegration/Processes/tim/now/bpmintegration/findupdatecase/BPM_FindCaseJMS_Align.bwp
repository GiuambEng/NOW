    xmlns:ns2="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns20="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+2999051a-43d9-4e53-aae0-67bd64f77fa1"
    xmlns:ns21="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+7c095a89-2ae9-4425-910d-b533d7d03c57"
    xmlns:ns22="http://tns.tibco.com/bw/palette/internal/accumulateoutput+aaa64996-91c3-4d53-b9cf-aaa5e3678dbe"
