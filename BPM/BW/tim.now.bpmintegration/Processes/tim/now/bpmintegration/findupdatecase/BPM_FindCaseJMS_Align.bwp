                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:FindUpdateCase="http://www.tim.com/NOW/xsd/FindUpdateCase/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="FindUpdateCase:FindCaseJMS_Align" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="06c88198-8281-4421-8042-6a22cc6f0074">
                                <bpws:targets>
                                    <bpws:target linkName="indexToWhile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="WhileToStoricizzazione"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence" tibex:group="while">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+aaa64996-91c3-4d53-b9cf-aaa5e3678dbe" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate1"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$indice&lt;=$countAsset" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$indice<=$countAsset]]></bpws:condition>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="LOG_ReadToParseXml" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ParseXmlToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AccumulateToindex" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToLOG_index" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="indexToAccumulate1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="a275cebd-c8c7-4000-a827-b7ba653f0b3a">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToLOG_index"/>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="aaa64996-91c3-4d53-b9cf-aaa5e3678dbe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="indexToAccumulate1"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Accumulate</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;readCase&quot;/>&lt;xsl:param name=&quot;indice&quot;/>&lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;$readCase/readCaseResponse/ns:ReadCaseResponse/caseData[number($indice)]/casePayload&quot;/>&lt;/tns:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ParseXml-input"
                                    name="ParseXml"
