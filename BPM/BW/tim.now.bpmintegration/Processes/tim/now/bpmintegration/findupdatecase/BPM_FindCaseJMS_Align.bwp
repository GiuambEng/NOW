                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;indice&quot;/>&lt;xsl:template name=&quot;LOG_index-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'FindUpdateCase'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Iterazione numero: ',xsd:string($indice))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LOG_index-input"
                                    name="LOG_index"
                                    tibex:xpdlId="bdcfb9fe-a84b-4439-ad6c-1572efb6afd7"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLOG_index"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_ReadToParseXml"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;indice&quot;/>&lt;xsl:template name=&quot;LOG_index-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'FindUpdateCase'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Iterazione numero: ',xsd:string($indice))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;indice&quot;/>&lt;xsl:param name=&quot;readCase&quot;/>&lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:Find>&lt;xsl:if test=&quot;$readCase/readCaseResponse/ns:ReadCaseResponse/caseData[number($indice)]/caseReference&quot;>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;$readCase/readCaseResponse/ns:ReadCaseResponse/caseData[number($indice)]/caseReference&quot;/>&lt;/tns:CaseReference>&lt;/xsl:if>&lt;tns:Asset>&lt;xsl:if test=&quot;$ParseXml/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$ParseXml/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseXml/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$ParseXml/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$ParseXml/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$ParseXml/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$ParseXml/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$ParseXml/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$ParseXml/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$ParseXml/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$ParseXml/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;$ParseXml/IDContratto&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$ParseXml/DEC&quot;>&lt;DEC>&lt;xsl:value-of select=&quot;$ParseXml/DEC&quot;/>&lt;/DEC>&lt;/xsl:if>&lt;statoAsset>&lt;xsl:value-of select=&quot;$ParseXml/statoAsset&quot;/>&lt;/statoAsset>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$ParseXml/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;xsl:if test=&quot;$ParseXml/numeroTelefonico&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$ParseXml/numeroTelefonico&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/IDAssetCRMWS&quot;>&lt;IDAssetCRMWS>&lt;xsl:value-of select=&quot;$ParseXml/IDAssetCRMWS&quot;/>&lt;/IDAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/IDAssetDa&quot;>&lt;IDAssetDa>&lt;xsl:value-of select=&quot;$ParseXml/IDAssetDa&quot;/>&lt;/IDAssetDa>&lt;/xsl:if>&lt;DES>&lt;xsl:value-of select=&quot;$ParseXml/DES&quot;/>&lt;/DES>&lt;xsl:if test=&quot;$ParseXml/ORA_DES&quot;>&lt;ORA_DES>&lt;xsl:value-of select=&quot;$ParseXml/ORA_DES&quot;/>&lt;/ORA_DES>&lt;/xsl:if>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;$ParseXml/tipologiaAccesso&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$ParseXml/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;$ParseXml/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;$ParseXml/offerta&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$ParseXml/lineaRiferimento&quot;>&lt;lineaRiferimento>&lt;xsl:value-of select=&quot;$ParseXml/lineaRiferimento&quot;/>&lt;/lineaRiferimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$ParseXml/complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/interno&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$ParseXml/interno&quot;/>&lt;/interno>&lt;/xsl:i