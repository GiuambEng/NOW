                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseRead&quot;/>&#xa;    &lt;xsl:template name=&quot;RendeDettAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AssetElement>&#xa;            &lt;xsl:if test=&quot;$ParseRead/IDAsset&quot;>&#xa;                &lt;IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$ParseRead/IDAsset&quot;/>&#xa;                &lt;/IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$ParseRead/codiceOrdineOLO&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$ParseRead/codiceOrdineTI&quot;>&#xa;                &lt;codiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$ParseRead/codiceOrdineTI&quot;/>&#xa;                &lt;/codiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$ParseRead/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$ParseRead/invariante&quot;>&#xa;                &lt;invariante>&#xa;                    &lt;xsl:value-of select=&quot;$ParseRead/invariante&quot;/>&#xa;                &lt;/invariante>&#xa;            &lt;/xsl:if>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$ParseRead/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;xsl:if test=&quot;$ParseRead/lastUpdate&quot;>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;$