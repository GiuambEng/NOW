                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:AssetElement>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAsset&quot;>&#xa;                &lt;IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAsset&quot;/>&#xa;                &lt;/IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineOLO&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;>&#xa;                &lt;codiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;/>&#xa;                &lt;/codiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/invariante&quot;>&#xa;                &lt;invariante>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/invariante&quot;/>&#xa;                &lt;/invariante>&#xa;            &lt;/xsl:if>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime($Invoke.part1/tns:Update/tns:Input/tns:Asset/created,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime($Invoke.part1/tns:Update/tns:Input/tns:Asset/lastUpdate,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRichiestaOLO&quot;>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDPrimoOrdine&quot;>&#xa;                &lt;IDPrimoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                &lt;/IDPrimoOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDContratto&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DEC&quot;>&#xa;                &lt;DEC>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DEC&quot;/>&#xa;                &lt;/DEC>&#xa;            &lt;/xsl:if>&#xa;            &lt;statoAsset>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/statoAsset&quot;/>&#xa;            &lt;/statoAsset>&#xa;            &lt;IDRisorsa>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRisorsa&quot;/>&#xa;            &lt;/IDRisorsa>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/numeroTelefonico&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/numeroTelefonico&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetCRMWS&quot;>&#xa;                &lt;IDAssetCRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                &lt;/IDAssetCRMWS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetDa&quot;>&#xa;                &lt;IDAssetDa>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetDa&quot;/>&#xa;                &lt;/IDAssetDa>&#xa;            &lt;/xsl:if>&#xa;            &lt;DES>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DES&quot;/>&#xa;            &lt;/DES>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/ORA_DES&quot;>&#xa;                &lt;ORA_DES>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/ORA_DES&quot;/>&#xa;                &lt;/ORA_DES>&#xa;            &lt;/xsl:if>&#xa;            &lt;tipologiaAccesso>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/tipologiaAccesso&quot;/>&#xa;            &lt;/tipologiaAccesso>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/RO&quot;>&#xa;                &lt;RO>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/RO&quot;/>&#xa;                &lt;/RO>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/offerta&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lineaRiferimento&quot;>&#xa;                &lt;lineaRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lineaRiferimento&quot;/>&#xa;                &lt;/lineaRiferimento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/complesso&quot;>&#xa;                &lt;complesso>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/complesso&quot;/>&#xa;                &lt;/complesso>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/interno&quot;>&#xa;                &lt;interno>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/interno&quot;/>&#xa;                &lt;/interno>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/piano&quot;>&#xa;                &lt;piano>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/piano&quot;/>&#xa;                &lt;/piano>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/scala&quot;>&#xa;                &lt;scala>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/scala&quot;/>&#xa;                &lt;/scala>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/dettaglioasset&quot;>&#xa;                &lt;dettaglioasset>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                        &lt;IDDettaglioAssetParent>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                        &lt;/IDDettaglioAssetParent>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                        &lt;IDDettaglioAssetRoot>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                        &lt;/IDDettaglioAssetRoot>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(created,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(lastUpdate,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                        &lt;attributidettaglioasset>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(created,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(lastUpdate,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01].[f001]&amp;quot;))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                            &lt;IDDettaglioAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                            &lt;/IDDettaglioAsset>&#xa;                        &lt;/attributidettaglioasset>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                    &lt;IDDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                    &lt;/IDDettaglioAsset>&#xa;                    &lt;statoDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                    &lt;/statoDettaglioAsset>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioasset>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DESPrimoOrdine&quot;>&#xa;                &lt;DESPrimoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                &lt;/DESPrimoOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/CAP&quot;>&#xa;                &lt;CAP>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/CAP&quot;/>&#xa;                &lt;/CAP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceISTATComune&quot;>&#xa;                &lt;codiceISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceISTATComune&quot;/>&#xa;                &lt;/codiceISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceISTATProvincia&quot;>&#xa;                &lt;codiceISTATProvincia>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceISTATProvincia&quot;/>&#xa;                &lt;/codiceISTATProvincia>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/