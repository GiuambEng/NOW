                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;indice&quot;/>&lt;xsl:param name=&quot;readCase&quot;/>&lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:Find>&lt;xsl:if test=&quot;$readCase/readCaseResponse/ns:ReadCaseResponse/caseData[number($indice)]/caseReference&quot;>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;$readCase/readCaseResponse/ns:ReadCaseResponse/caseData[number($indice)]/caseReference&quot;/>&lt;/tns:CaseReference>&lt;/xsl:if>&lt;tns:Asset>&lt;xsl:copy-of select=&quot;$ParseXml/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/@*&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/node()&quot;/>&lt;/tns:Asset>&lt;tns:Response>&lt;tns:Esito>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Esito>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:DescrizioneEsito>&lt;/tns:Response>&lt;/tns:Find>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Accumulate-input"
                                    name="Accumulate"
                                    outputVariable="Accumulate"
