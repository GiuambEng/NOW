                                    <bpws:while name="while" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$indice&lt;=$countAsset" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
