set/cliente/created"/&gt;&lt;/created&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/codiceFiscale"&gt;&lt;codiceFiscale&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/codiceFiscale"/&gt;&lt;/codiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/cognomeRagioneSociale"&gt;&lt;cognomeRagioneSociale&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/cognomeRagioneSociale"/&gt;&lt;/cognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/nome"&gt;&lt;nome&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/nome"/&gt;&lt;/nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/partitaIVA"&gt;&lt;partitaIVA&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/cliente/partitaIVA"/&gt;&lt;/partitaIVA&gt;&lt;/xsl:if&gt;&lt;/cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/opzioneDinamica"&gt;&lt;opzioneDinamica&gt;&lt;xsl:value-of select="$Invoke/part1/tns:Input/tns:Create/tns:Input/tns:Asset/opzioneDinamica"/&gt;&lt;/opzioneDinamica&gt;&lt;/xsl:if&gt;&lt;/ns0:AssetElement&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns1:AssettizzazioneRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/AssettizzazioneConsistenza/&quot; xmlns:ns0=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseRead&quot;/>&#xa;    &lt;xsl:template name=&quot;Storicizzazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($Invoke.part1/tns:Update/tns:Input/tns:CaseReference)>0&quot;>&#xa;                &lt;ns0:AssetElement>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/invariante&quot;>&#xa;                        &lt;invariante>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/invariante&quot;/>&#xa;                        &lt;/invariante>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRichiestaOLO&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDPrimoOrdine&quot;>&#xa;                        &lt;IDPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                        &lt;/IDPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDContratto&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DEC&quot;>&#xa;                        &lt;DEC>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DEC&quot;/>&#xa;                        &lt;/DEC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;statoAsset>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/statoAsset&quot;/>&#xa;                    &lt;/statoAsset>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/numeroTelefonico&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/numeroTelefonico&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetCRMWS&quot;>&#xa;                        &lt;IDAssetCRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                        &lt;/IDAssetCRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetDa&quot;>&#xa;                        &lt;IDAssetDa>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/IDAssetDa&quot;/>&#xa;                        &lt;/IDAssetDa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;DES>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/DES&quot;/>&#xa;                    &lt;/DES>&#xa;                    &lt;tipologiaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/tipologiaAccesso&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/RO&quot;>&#xa;                        &lt;RO>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/RO&quot;/>&#xa;                        &lt;/RO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/offerta&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lineaRiferimento&quot;>&#xa;                        &lt;lineaRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/lineaRiferimento&quot;/>&#xa;                        &lt;/lineaRiferimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/complesso&quot;>&#xa;                        &lt;complesso>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/complesso&quot;/>&#xa;                        &lt;/complesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/interno&quot;>&#xa;                        &lt;interno>&#xa;                            &lt;xsl:value-of select=&quot;$Invoke.part1/tns:Update/tns:Input/tns:Asset/interno&quot;/>&#xa;                        &lt;/interno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Invoke.part1/tns:Update/tns:Input/tns:As