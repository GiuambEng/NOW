                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;readCase.readCaseResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;indice&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Find>&#xa;                &lt;xsl:if test=&quot;$readCase.readCaseResponse/caseData[number($indice)]/caseReference&quot;>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$readCase.readCaseResponse/caseData[number($indice)]/caseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Asset>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/node()&quot;/>&#xa;                &lt;/tns:Asset>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;tns:DescrizioneEsito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns:DescrizioneEsito>&#xa;                &lt;/tns:Response>&#xa;            &lt;/tns:Find>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
