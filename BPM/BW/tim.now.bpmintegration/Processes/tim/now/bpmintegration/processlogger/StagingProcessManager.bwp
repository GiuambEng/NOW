                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertUpdateStagingIn.REQUEST&quot;/>&#xa;    &lt;xsl:template name=&quot;Logger_NO_File-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Input>&#xa;            &lt;ns1:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:TipologiaProcesso&quot;/>&#xa;            &lt;/ns1:TipologiaProcesso>&#xa;            &lt;ns1:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:TipologiaOperazione&quot;/>&#xa;            &lt;/ns1:TipologiaOperazione>&#xa;            &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:EsecuzioneNOFileProcessato/ns1:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns1:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:EsecuzioneNOFileProcessato/ns1:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns1:COD_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:EsecuzioneNOFileProcessato/ns1:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:LoggerIn/ns1:EsecuzioneNOFileProcessato/ns1:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;            