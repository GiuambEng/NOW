    &lt;xsl:param name="InsertUpdateStagingIn"/&gt;
    &lt;xsl:param name="Logger_NO_File"/&gt;
    &lt;xsl:template name="Log_File_Processato-input" match="/"&gt;
        &lt;tns2:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns1:Input&gt;
                    &lt;ns1:TipologiaProcesso&gt;
