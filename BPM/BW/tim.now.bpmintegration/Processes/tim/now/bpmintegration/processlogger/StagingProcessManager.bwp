                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_NO_File.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertUpdateStagingIn.REQUEST&quot;/>&#xa;    &lt;xsl:template name=&quot;CallDynamicStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InsertUpdateStagingIn.REQUEST/tns:GenericStaging)&quot;>&#xa;                    &lt;tns:GenericStaging>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CAP&quot;>&#xa;                            &lt;tns:CAP>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CAP&quot;/>&#xa;                            &lt;/tns:CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_VIA&quot;>&#xa;                            &lt;tns:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_VIA&quot;/>&#xa;                            &lt;/tns:COD_VIA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_COMUNE&quot;>&#xa;                            &lt;tns:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_COMUNE&quot;/>&#xa;                            &lt;/tns:COD_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_DISTR&quot;>&#xa;                            &lt;tns:COD_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_DISTR&quot;/>&#xa;                            &lt;/tns:COD_DISTR>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_PARTICELLA_TOPON&quot;>&#xa;                            &lt;tns:COD_PARTICELLA_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_PARTICELLA_TOPON&quot;/>&#xa;                            &lt;/tns:COD_PARTICELLA_TOPON>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_STRADA&quot;>&#xa;                            &lt;tns:COD_STRADA>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_STRADA&quot;/>&#xa;                            &lt;/tns:COD_STRADA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_RECD&quot;>&#xa;                            &lt;tns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_RECD&quot;/>&#xa;                            &lt;/tns:CONTENUTO_RECD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR_ERRORE&quot;>&#xa;                            &lt;tns:DESCR_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCR_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR_VIA&quot;>&#xa;                            &lt;tns:DESCR_VIA>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR_VIA&quot;/>&#xa;                            &lt;/tns:DESCR_VIA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_MULTICAP&quot;>&#xa;                            &lt;tns:FLAG_MULTICAP>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_MULTICAP&quot;/>&#xa;                            &lt;/tns:FLAG_MULTICAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_OPERAZIONE&quot;>&#xa;                            &lt;tns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_OPERAZIONE&quot;/>&#xa;                            &lt;/tns:FLAG_OPERAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_UFF&quot;>&#xa;                            &lt;tns:FLAG_UFF>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:FLAG_UFF&quot;/>&#xa;                            &lt;/tns:FLAG_UFF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_FILE_PROCSTO_INPUT&quot;>&#xa;                            &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_FILE_PROCSTO_INPUT&quot;/>&#xa;                            &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_STATO_ELAB_STAG&quot;>&#xa;                            &lt;tns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_STATO_ELAB_STAG&quot;/>&#xa;                            &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ISTAT_COMUNE&quot;>&#xa;                            &lt;tns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ISTAT_COMUNE&quot;/>&#xa;                            &lt;/tns:ISTAT_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ISTAT_PROV&quot;>&#xa;                            &lt;tns:ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ISTAT_PROV&quot;/>&#xa;                            &lt;/tns:ISTAT_PROV>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:NUMERO_RECD&quot;>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:NUMERO_RECD&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TMSP_INSMTO&quot;>&#xa;                            &lt;tns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TMSP_INSMTO&quot;/>&#xa;                            &lt;/tns:TMSP_INSMTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_REQUEST&quot;>&#xa;                            &lt;tns:CONTENUTO_REQUEST>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_REQUEST&quot;/>&#xa;                            &lt;/tns:CONTENUTO_REQUEST>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_RESPONSE&quot;>&#xa;                            &lt;tns:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CONTENUTO_RESPONSE&quot;/>&#xa;                            &lt;/tns:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ESITO&quot;>&#xa;                            &lt;tns:ESITO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ESITO&quot;/>&#xa;                            &lt;/tns:ESITO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:HTTP_RESPONSE&quot;>&#xa;                            &lt;tns:HTTP_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:HTTP_RESPONSE&quot;/>&#xa;                            &lt;/tns:HTTP_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_RISORSA&quot;>&#xa;                            &lt;tns:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_RISORSA&quot;/>&#xa;                            &lt;/tns:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Logger_NO_File.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                        &lt;/tns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:RETURN_CODE&quot;>&#xa;                            &lt;tns:RETURN_CODE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:RETURN_CODE&quot;/>&#xa;                            &lt;/tns:RETURN_CODE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:SRVZ&quot;>&#xa;                            &lt;tns:SRVZ>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:SRVZ&quot;/>&#xa;                            &lt;/tns:SRVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIMSTP_RICH&quot;>&#xa;                            &lt;tns:TIMSTP_RICH>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIMSTP_RICH&quot;/>&#xa;                            &lt;/tns:TIMSTP_RICH>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_OLO&quot;>&#xa;                            &lt;tns:COD_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_OLO&quot;/>&#xa;                            &lt;/tns:COD_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_OLO_RIS&quot;>&#xa;                            &lt;tns:COD_OLO_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_OLO_RIS&quot;/>&#xa;                            &lt;/tns:COD_OLO_RIS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR&quot;>&#xa;                            &lt;tns:DESCR>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DESCR&quot;/>&#xa;                            &lt;/tns:DESCR>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_RICH&quot;>&#xa;                            &lt;tns:ID_RICH>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_RICH&quot;/>&#xa;                            &lt;/tns:ID_RICH>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                            &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                            &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TRANSACTION_ID&quot;>&#xa;                            &lt;tns:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns:CODFC_OLO_AGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:CODFC_OLO_AGCOM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Logger_NO_File.part1/ns1:Esito/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                            &lt;tns:COD_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$Logger_NO_File.part1/ns1:Esito/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                            &lt;/tns:COD_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:OPERATORE&quot;>&#xa;                            &lt;tns:OPERATORE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:OPERATORE&quot;/>&#xa;                            &lt;/tns:OPERATORE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_TRANSAZIONE&quot;>&#xa;                            &lt;tns:ID_TRANSAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:ID_TRANSAZIONE&quot;/>&#xa;                            &lt;/tns:ID_TRANSAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:PRINCIPALE&quot;>&#xa;                            &lt;tns:PRINCIPALE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:PRINCIPALE&quot;/>&#xa;                            &lt;/tns:PRINCIPALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIPO_NUMERO&quot;>&#xa;                            &lt;tns:TIPO_NUMERO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIPO_NUMERO&quot;/>&#xa;                            &lt;/tns:TIPO_NUMERO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIPO_SRVZ&quot;>&#xa;                            &lt;tns:TIPO_SRVZ>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:TIPO_SRVZ&quot;/>&#xa;                            &lt;/tns:TIPO_SRVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:RADICALE&quot;>&#xa;                            &lt;tns:RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:RADICALE&quot;/>&#xa;                            &lt;/tns:RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CAPOSERIE&quot;>&#xa;                            &lt;tns:CAPOSERIE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:CAPOSERIE&quot;/>&#xa;                            &lt;/tns:CAPOSERIE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_RO&quot;>&#xa;                            &lt;tns:COD_RO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:COD_RO&quot;/>&#xa;                            &lt;/tns:COD_RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:QTA_LINEE&quot;>&#xa;                            &lt;tns:QTA_LINEE>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:QTA_LINEE&quot;/>&#xa;                            &lt;/tns:QTA_LINEE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:QT_AGGIUNTIVI&quot;>&#xa;                            &lt;tns:QT_AGGIUNTIVI>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:QT_AGGIUNTIVI&quot;/>&#xa;                            &lt;/tns:QT_AGGIUNTIVI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DN&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:DN&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:STATO_AGGIUNTIVO&quot;>&#xa;                            &lt;tns:STATO_AGGIUNTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$InsertUpdateStagingIn.REQUEST/tns:GenericStaging/tns:STATO_AGGIUNTIVO&quot;/>&#xa;                            &lt;/tns:STATO_AGGIUNTIVO>&#xa;        