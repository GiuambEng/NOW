                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsertUpdateStagingIn&quot;/>&lt;xsl:param name=&quot;Logger_NO_File&quot;/>&lt;xsl:template name=&quot;CallDynamicStaging-input&quot; match=&quot;/&quot;>&lt;tns:StagingRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging)&quot;>&lt;tns:GenericStaging>&lt;xsl:if test=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_VIA&quot;>&lt;tns:COD_VIA>&lt;xsl:value-of select=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_VIA&quot;/>&lt;/tns:COD_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_COMUNE&quot;>&lt;tns:COD_COMUNE>&lt;xsl:value-of select=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_COMUNE&quot;/>&lt;/tns:COD_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_DISTR&quot;>&lt;tns:COD_DISTR>&lt;xsl:value-of select=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_DISTR&quot;/>&lt;/tns:COD_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$InsertUpdateStagingIn/REQUEST/tns:StagingRequest/tns:GenericStaging/tns:COD_PARTICELLA_TOPON&quot;>&lt;tns:COD_PARTICELLA_TOPON>&lt;xsl:va