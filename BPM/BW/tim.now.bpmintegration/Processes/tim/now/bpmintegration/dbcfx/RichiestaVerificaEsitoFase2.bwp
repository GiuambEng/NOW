                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tibco.com/InterfacciaRichiestoVerificaEsitoFase2/" xmlns:sm="http://dbcfx/SOA/RichiestaVerificaEsitoFase2/2016-09-15" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Header"/&gt;&lt;xsl:param name="VerificaEsitoFase2"/&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="ID_ProcessoNoFile"/&gt;&lt;xsl:template name="StagingError-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;xsl:if test="$FaultDetails/ProcessStack"&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($Header/h:transactionID)&gt;0"&gt;&lt;xsl:if test="$Header/h:transactionID"&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$Header/h:transactionID"/&gt;&lt;/tns1:ID_RICH&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;xsl:if test="string-length($Header/h:transactionID)&gt;0"&gt;&lt;xsl:if test="$Header/h:transactionID"&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Header/h:transactionID"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;tns1:OPERATORE&gt;&lt;xsl:value-of select="&amp;quot;AUTOMATICO&amp;quot;"/&gt;&lt;/tns1:OPERATORE&gt;&lt;tns1:ID_LINEA&gt;&lt;xsl:value-of select="$VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request/sm:Request/sm:VerificaNumerazione/sm:IdLinea"/&gt;&lt;/tns1:ID_LINEA&gt;&lt;tns1:CODICE_ORDINE_TI&gt;&lt;xsl:value-of select="$VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request/sm:Request/sm:VerificaNumerazione/sm:CodiceOrdineTI"/&gt;&lt;/tns1:CODICE_ORDINE_TI&gt;&lt;tns1:RICHIESTA_AGGIUNTIVI&gt;&lt;xsl:value-of select="$VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request/sm:Request/sm:VerificaNumerazione/sm:Richiesta_Aggiuntivi"/&gt;&lt;/tns1:RICHIESTA_AGGIUNTIVI&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$VerificaEsitoFase2/parameters/tns2:VerificaEsitoFase2Request/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="&amp;quot;STAG_RICHVRF_FASE2_NOFOUT&amp;quot;"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_ProcessoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Header/h:interactionDate/h:Date)&gt;0 and string-length($Header/h:interactionDate/h:Time)&gt;0"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$Header/h:interactionDate/h:Time))"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tibco.com/InterfacciaRichiestoVerificaEsitoFase2/&quot; xmlns:sm=&quot;http://dbcfx/SOA/RichiestaVerificaEsitoFase2/2016-09-15&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsitoFase2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Header&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ProcessoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($VerificaEsitoFase2.parameters)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/ProcessStack&quot;>&#xa;                    &lt;tns1:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                    &lt;/tns1:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Header/h:transactionID)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Header/h:transactionID&quot;>&#xa;                        &lt;tns1:ID_RICH>&#xa;                            &lt;xsl:value-of select=&quot;$Header/h:transactionID&quot;/>&#xa;                        &lt;/tns1:ID_RICH>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;string-length($Header/h:transactionID)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Header/h:transactionID&quot;>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Header/h:transactionID&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH_OLO>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;                &lt;tns1:ID_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdLinea&quot;/>&#xa;                &lt;/tns1:ID_LINEA>&#xa;                &lt;tns1:CODICE_ORDINE_TI>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:CodiceOrdineTI&quot;/>&#xa;                &lt;/tns1:CODICE_ORDINE_TI>&#xa;                &lt;tns1:RICHIESTA_AGGIUNTIVI>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:Richiesta_Aggiuntivi&quot;/>&#xa;                &lt;/tns1:RICHIESTA_AGGIUNTIVI>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_RICHVRF_FASE2_NOFOUT&amp;quot;&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ProcessoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Header/h:interactionDate/h:Date)>0 and string-length($Header/h:interactionDate/h:Time)>0&quot;>&#xa;                            &lt;ns:TMSP_INIZIO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$Header/h:interactionDate/h:Time))&quot;/>&#xa;                            &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                       