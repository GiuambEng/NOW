=&quot;$FaultDetails/Msg&quot;/>&lt;/tns:Msg>&lt;/xsl:if>&lt;xsl:if test=&quot;$FaultDetails/ProcessStack&quot;>&lt;tns:ProcessStack>&lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&lt;/tns:ProcessStack>&lt;/xsl:if>&lt;xsl:if test=&quot;$FaultDetails/MsgCode&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:MsgCode>&lt;/xsl:if>&lt;tns:Data/>&lt;/tns:ErrorReport>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
