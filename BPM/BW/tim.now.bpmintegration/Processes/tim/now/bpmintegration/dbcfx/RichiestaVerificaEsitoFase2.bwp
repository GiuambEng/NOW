                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
