                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://dbcfx/SOA/RichiestaVerificaEsitoFase2/2016-09-15&quot; xmlns:tns1=&quot;http://www.tibco.com/InterfacciaRichiestoVerificaEsitoFase2/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsitoFase2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RichiestaVerificaEsitoFase2&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InterfacciaRichiestaVerificaEsitoFase2PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaEsitoFase2&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Errore nella Richiesta Verifica Esito Fase 2&amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/StackTrace&quot;>&#xa;                    &lt;tns:Payload>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                    &lt;/tns:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.dbcfx&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaEsitoFase2&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaEsitoFase2_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaEsitoFase2_&amp;quot;,$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                    &lt;tns:ErrorLog>&#xa;                        &lt;tns:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TimeStamp>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Errore su RichiestaVerificaEsistoFase2&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;xsl:if test=&quot;$FaultDetails/MsgCode&quot;>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns:track_position>&#xa;                        &lt;tns:ErrorReport>&#xa;                            &lt;xsl:if test=&quot;$FaultDetails/StackTrace&quot;>&#xa;                                &lt;tns:StackTrace>&#xa;                                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                                &lt;/tns:StackTrace>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FaultDetails/Msg&quot;>&#xa;                                &lt;tns:Msg>&#xa;                                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                                &lt;/tns:Msg>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FaultDetails/ProcessStack&quot;>&#xa;                                &lt;tns:ProcessStack>&#xa;                                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                                &lt;/tns:ProcessStack>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FaultDetails/MsgCode&quot;>&#xa;                                &lt;tns:MsgCode>&#xa;                                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                                &lt;/tns:MsgCode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:Data/>&#xa;                        &lt;/tns:ErrorReport>&#xa;                    &lt;/tns:ErrorLog>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload/>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
