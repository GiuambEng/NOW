                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:sm=&quot;http://dbcfx/SOA/RichiestaVerificaEsitoFase2/2016-09-15&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tibco.com/InterfacciaRichiestoVerificaEsitoFase2/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeDBCFX.body&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaEsitoFase2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeDBCFX.Header&quot;/>&#xa;    &lt;xsl:param name=&quot;SetRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;Header&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ProcessoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($SetRequest/sm:VerificaNumerazione)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($InvokeDBCFX.Header, true(), true()), &amp;quot; --- &amp;quot;, tib:render-xml($InvokeDBCFX.body, true(), true()))&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;tns1:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeDBCFX.body/sm:Descrizione&quot;/>&#xa;                &lt;/tns1:DESCR_ERRORE>&#xa;                &lt;xsl:if test=&quot;$Header/h:transactionID&quot;>&#xa;                    &lt;tns1:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$Header/h:transactionID&quot;/>&#xa;                    &lt;/tns1:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeDBCFX.Header/h:interactionDate/h:Date)>0 and string-length($InvokeDBCFX.Header/h:interactionDate/h:Time)>0  &quot;>&#xa;                        &lt;tns1:TIMSTP_RICH>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$Header/h:interactionDate/h:Time))&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RICH>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:TIMSTP_RICH>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RICH>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$Header/h:transactionID&quot;>&#xa;                    &lt;tns1:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Header/h:transactionID&quot;/>&#xa;                    &lt;/tns1:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$SetRequest/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH_OLO>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;                &lt;tns1:ID_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$SetRequest/sm:VerificaNumerazione/sm:IdLinea&quot;/>&#xa;                &lt;/tns1:ID_LINEA>&#xa;                &lt;tns1:CODICE_ORDINE_TI>&#xa;                    &lt;xsl:value-of select=&quot;$SetRequest/sm:VerificaNumerazione/sm:CodiceOrdineTI&quot;/>&#xa;                &lt;/tns1:CODICE_ORDINE_TI>&#xa;                &lt;tns1:RC>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeDBCFX.body/sm:Codice&quot;/>&#xa;                &lt;/tns1:RC>&#xa;                &lt;tns1:RICHIESTA_AGGIUNTIVI>&#xa;                    &lt;xsl:value-of select=&quot;$SetRequest/sm:VerificaNumerazione/sm:Richiesta_Aggiuntivi&quot;/>&#xa;                &lt;/tns1:RICHIESTA_AGGIUNTIVI>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaEsitoFase2.parameters/sm:Request/sm:VerificaNumerazione/sm:IdentificativoRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_RICHVRF_FASE2_NOFOUT&amp;quot;&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ProcessoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE