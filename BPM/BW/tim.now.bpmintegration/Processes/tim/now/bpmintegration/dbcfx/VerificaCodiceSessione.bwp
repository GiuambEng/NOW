            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="5e82662b-6343-4c97-a64a-ff6715a8be98" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
