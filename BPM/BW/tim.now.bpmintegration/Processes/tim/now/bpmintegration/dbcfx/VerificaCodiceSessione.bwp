                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeDBCFX.body&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCodiceSessione'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Risposta da DBCFX con codice : ',$InvokeDBCFX.body/tns3:Codice,' e descrizione ',$InvokeDBCFX.body/tns3:Descrizione)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdateStag-input"
                name="UpdateStag" operation="InsertUpdateStaging"
                outputVariable="UpdateStag"
                partnerLink="StagingProcessManager"
                portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="5aaa08f8-0bbb-478b-a1d6-36d9a0628010">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns5="http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns3="http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="InsertStag"/&gt;&lt;xsl:param name="InvokeDBCFX"/&gt;&lt;xsl:template name="UpdateStag-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;tns4:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_ORDINE_WHS"/&gt;&lt;/tns4:COD_ORDN_OLO&gt;&lt;tns4:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($InvokeDBCFX/body/tns3:Ack)"/&gt;&lt;/tns4:CONTENUTO_RESPONSE&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="175"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;/tns4:StagingIn&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'TRACC_FL_N8_N10_VS_DBCFX'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="175"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStag/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeDBCFX.body&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns4:COD_ORDN_OLO>&#xa;                &lt;tns4:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeDBCFX.body)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;175&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'TRACC_FL_N8_N10_VS_DBCFX'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStag.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStag.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStag.RESPONSE/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;175&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStag.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStag.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStag.RESPONSE/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogDBCFXToStagingProcessManager"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateStagToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="b98b9ba9-3615-4fa4-a80b-82a45858147a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateStagToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaCodiceSessione'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;'Terminato processo VerificaCodiceSessione'&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
