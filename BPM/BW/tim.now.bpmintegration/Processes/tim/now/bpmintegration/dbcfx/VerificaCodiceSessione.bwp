                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns3:Request>&lt;tns3:VerificaCodiceSessione>&lt;tns3:CODICE_OPERATORE_RECIPIENT>&lt;xsl:value-of select=&quot;$Request/Record[1]/CODICEOPERATOREREC&quot;/>&lt;/tns3:CODICE_OPERATORE_RECIPIENT>&lt;tns3:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;$Request/Record[1]/CODICEOPERATOREWHS&quot;/>&lt;/tns3:CODICE_OPERATORE_WHS>&lt;tns3:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOlo&quot;/>&lt;/tns3:CODICE_ORDINE_WHS>&lt;tns3:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Request/Record[1]/IDNOTIFICA&quot;/>&lt;/tns3:ID_NOTIFICA>&lt;tns3:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;concat(substring($Request/Record[1]/DATANOTIFICA, 1, 10), ' ',substring($Request/Record[1]/DATANOTIFICA, 12, 8))&quot;/>&lt;/tns3:DATA_NOTIFICA>&lt;tns3:CODICE_SESSIONE>&lt;xsl:value-of select=&quot;$Request/Record[1]/CODICESESSIONE&quot;/>&lt;/tns3:CODICE_SESSIONE>&lt;tns3:COR>&lt;xsl:value-of select=&quot;$Request/Record[1]/COR&quot;/>&lt;/tns3:COR>&lt;xsl:if test=&quot;$Request/Record[1]/DN1&quot;>&lt;tns3:DN1>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN1&quot;/>&lt;/tns3:DN1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN2&quot;>&lt;tns3:DN2>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN2&quot;/>&lt;/tns3:DN2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN3&quot;>&lt;tns3:DN3>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN3&quot;/>&lt;/tns3:DN3>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN4&quot;>&lt;tns3:DN4>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN4&quot;/>&lt;/tns3:DN4>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN5&quot;>&lt;tns3:DN5>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN5&quot;/>&lt;/tns3:DN5>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN6&quot;>&lt;tns3:DN6>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN6&quot;/>&lt;/tns3:DN6>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN7&quot;>&lt;tns3:DN7>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN7&quot;/>&lt;/tns3:DN7>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN8&quot;>&lt;tns3:DN8>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN8&quot;/>&lt;/tns3:DN8>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN9&quot;>&lt;tns3:DN9>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN9&quot;/>&lt;/tns3:DN9>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/Record[1]/DN10&quot;>&lt;tns3:DN10>&lt;xsl:value-of select=&quot;$Request/Record[1]/DN10&quot;/>&lt;/tns3:DN10>&lt;/xsl:if>&lt;/tns3:VerificaCodiceSessione>&lt;/tns3:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RichiestaVerificaCodiceSessione_2016-09-15="http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RichiestaVerificaCodiceSessione_2016-09-15:Request" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRequest-input"
                    name="LogRequest"
                    tibex:xpdlId="bbbb9231-9785-4ae1-b7f9-3d236e0d645d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RequestToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;LogRequest-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaCodiceSessione'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Recuperati dati request da tracciamento : ',tib:render-xml($Request))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStag-input"
                name="InsertStag" operation="InsertUpdateStaging"
                outputVariable="InsertStag"
                partnerLink="StagingProcessManager"
                portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="1680f198-d625-4de8-bdbb-28f9ee350b13">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns5="http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns3="http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15" version="2.0"&gt;&lt;xsl:param name="Request"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="StagingProcessManager-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;tns4:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_ORDINE_WHS"/&gt;&lt;/tns4:COD_ORDN_OLO&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($Mapper/tns3:VerificaCodiceSessione)"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="175"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$Request/Record[1]/IDRICHIESTA"&gt;&lt;tns4:ID_RICH&gt;&lt;xsl:value-of select="$Request/Record[1]/IDRICHIESTA"/&gt;&lt;/tns4:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns4:ID_RISORSA&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:COR"/&gt;&lt;/tns4:ID_RISORSA&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;tns4:CODICEOPERATOREREC&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_OPERATORE_RECIPIENT"/&gt;&lt;/tns4:CODICEOPERATOREREC&gt;&lt;tns4:CODICEOPERATOREWHS&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_OPERATORE_WHS"/&gt;&lt;/tns4:CODICEOPERATOREWHS&gt;&lt;tns4:IDNOTIFICA&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:ID_NOTIFICA"/&gt;&lt;/tns4:IDNOTIFICA&gt;&lt;tns4:DATANOTIFICA&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DATA_NOTIFICA"/&gt;&lt;/tns4:DATANOTIFICA&gt;&lt;tns4:CODICESESSIONE&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_SESSIONE"/&gt;&lt;/tns4:CODICESESSIONE&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN1"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN1"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN2"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN2"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN3"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN3"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN4"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN4"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN5"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN5"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN6"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN6"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN7"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN7"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN8"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN8"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN9"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN9"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns3:VerificaCodiceSessione/tns3:DN10"&gt;&lt;tns4:DN&gt;&lt;xsl:value-of select="$Mapper/tns3:VerificaCodiceSessione/tns3:DN10"/&gt;&lt;/tns4:DN&gt;&lt;/xsl:if&gt;&lt;tns4:NOMEFLUSSO&gt;&lt;xsl:value-of select="'N8'"/&gt;&lt;/tns4:NOMEFLUSSO&gt;&lt;/tns4:StagingIn&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'TRACC_FL_N8_N10_VS_DBCFX'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="175"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;StagingProcessManager-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns4:COD_ORDN_OLO>&#xa;                &lt;tns4:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper/tns3:VerificaCodiceSessione)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_REQUEST>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;175&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$Request/Record[1]/IDRICHIESTA&quot;>&#xa;                    &lt;tns4:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$Request/Record[1]/IDRICHIESTA&quot;/>&#xa;                    &lt;/tns4:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:COR&quot;/>&#xa;                &lt;/tns4:ID_RISORSA>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:CODICEOPERATOREREC>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_OPERATORE_RECIPIENT&quot;/>&#xa;                &lt;/tns4:CODICEOPERATOREREC>&#xa;                &lt;tns4:CODICEOPERATOREWHS>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_OPERATORE_WHS&quot;/>&#xa;                &lt;/tns4:CODICEOPERATOREWHS>&#xa;                &lt;tns4:IDNOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:ID_NOTIFICA&quot;/>&#xa;                &lt;/tns4:IDNOTIFICA>&#xa;                &lt;tns4:DATANOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DATA_NOTIFICA&quot;/>&#xa;                &lt;/tns4:DATANOTIFICA>&#xa;                &lt;tns4:CODICESESSIONE>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:CODICE_SESSIONE&quot;/>&#xa;                &lt;/tns4:CODICESESSIONE>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DN1&quot;>&#xa;                    &lt;tns4:DN>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DN1&quot;/>&#xa;                    &lt;/tns4:DN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DN2&quot;>&#xa;                    &lt;tns4:DN>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DN2&quot;/>&#xa;                    &lt;/tns4:DN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns3:VerificaCodiceSessione/tns3:DN3&quot;>&#x