                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StagingProcessManagerToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStagingToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaCodiceSessione'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Effettuato insert su staging con codice ordine olo: ',$Start/tns:CodiceOrdineOlo)&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InvokeDBCFX-input"
                name="InvokeDBCFX" operation="checkSessionCode"
                outputVariable="InvokeDBCFX"
                partnerLink="RichiestaVerificaCodiceSessionePortType"
                portType="ns9:RichiestaVerificaCodiceSessionePortType" tibex:xpdlId="c9a850e7-e1f3-48a5-8433-c7d9cdc35929">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15" xmlns:tns7="http://dbcfx/SOA/RichiestaVerificaCodiceSessione" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Request"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="MessageID"/&gt;&lt;xsl:template name="InvokeDBCFX-input" match="/"&gt;&lt;tns7:RichiestaVerificaCodiceSessioneRequest&gt;&lt;Header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-date()),'+')"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-time()),'+')"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$MessageID"/&gt;&lt;/h:messageID&gt;&lt;xsl:if test="$Request/Record[1]/IDRICHIESTA"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$Request/Record[1]/IDRICHIESTA"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/Header&gt;&lt;body&gt;&lt;tns3:Request&gt;&lt;xsl:copy-of select="$Mapper/tns3:VerificaCodiceSessione"/&gt;&lt;/tns3:Request&gt;&lt;/body&gt;&lt;/tns7:RichiestaVerificaCodiceSessioneRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; xmlns:tns7=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;h:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/h:sourceSystem>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;h:messageID>&#xa;                &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;            &lt;/h:messageID>&#xa;            &lt;xsl:if test=&quot;$Request/Record[1]/IDRICHIESTA&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$Request/Record[1]/IDRICHIESTA&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; xmlns:tns7=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Mapper/tns3:VerificaCodiceSessione&quot;/>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToInvokeDBCFX"/>
                </bpws:targets>
