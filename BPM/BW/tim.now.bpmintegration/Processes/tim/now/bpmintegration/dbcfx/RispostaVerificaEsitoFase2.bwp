                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/bx/2009/management/process" xmlns:pm="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rf2="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" xmlns:tns2="http://www.tim.com/NOW/xsd/DatiDBCFX/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="checkDN"/&gt;&lt;xsl:param name="BPMmoduleName"/&gt;&lt;xsl:param name="BPMprocessName"/&gt;&lt;xsl:param name="ConcatSequenceInput"/&gt;&lt;xsl:param name="SelectCodOloAgcom"/&gt;&lt;xsl:param name="MapDatiDBCFX"/&gt;&lt;xsl:param name="TrascodificaCodiceCausale"/&gt;&lt;xsl:param name="PriorityBPM"/&gt;&lt;xsl:template name="createProcessInstance-input" match="/"&gt;&lt;tns:createProcessInstanceRequest&gt;&lt;params&gt;&lt;pm:createProcessInstanceInput&gt;&lt;pm:processQName&gt;&lt;pm:moduleName&gt;&lt;xsl:value-of select="$BPMmoduleName"/&gt;&lt;/pm:moduleName&gt;&lt;pm:processName&gt;&lt;xsl:value-of select="$BPMprocessName"/&gt;&lt;/pm:processName&gt;&lt;/pm:processQName&gt;&lt;pm:operationName&gt;&lt;xsl:value-of select="&amp;quot;Start&amp;quot;"/&gt;&lt;/pm:operationName&gt;&lt;pm:options&gt;&lt;pm:priority&gt;&lt;xsl:value-of select="xsd:short($PriorityBPM)"/&gt;&lt;/pm:priority&gt;&lt;/pm:options&gt;&lt;pm:parameterMap&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;Esito&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;0&amp;quot;])"&gt;&lt;pm:value&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/pm:value&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;2&amp;quot;])"&gt;&lt;pm:value&gt;&lt;xsl:value-of select="&amp;quot;2&amp;quot;"/&gt;&lt;/pm:value&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;pm:value&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/pm:value&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/pm:parameter&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;IDRichiestaOLO&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdentificativoRichiestaOLO"/&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;xsl:if test="string-length($ConcatSequenceInput)&gt;0"&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;DATIDBCFX&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:value-of select="concat(&amp;quot;[&amp;quot;,$ConcatSequenceInput,&amp;quot;]&amp;quot;)"/&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto)&gt;0"&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;CodiceCausaleScarto&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto)"&gt;&lt;xsl:value-of select="$MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($TrascodificaCodiceCausale/parameters/ecm:TrascodificaCodiceCausaleResponse/ecm:IdAnagraficaCausale)"&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;IDCausaleScarto&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:value-of select="$TrascodificaCodiceCausale/parameters/ecm:TrascodificaCodiceCausaleResponse/ecm:IdAnagraficaCausale"/&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;/xsl:if&gt;&lt;/pm:parameterMap&gt;&lt;/pm:createProcessInstanceInput&gt;&lt;/params&gt;&lt;/tns:createProcessInstanceRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/bx/2009/management/process&quot; xmlns:pm=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DatiDBCFX/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkDN.body&quot;/>&#xa;    &lt;xsl:param name=&quot;TrascodificaCodiceCausale.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;ConcatSequenceInput&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCodOloAgcom&quot;/>&#xa;    &lt;xsl:param name=&quot;MapDatiDBCFX&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityBPM&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;pm:createProcessInstanceInput>&#xa;            &lt;pm:processQName>&#xa;                &lt;pm:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;                &lt;/pm:moduleName>&#xa;                &lt;pm:processName>&#xa;                    &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;                &lt;/pm:processName>&#xa;            &lt;/pm:processQName>&#xa;            &lt;pm:operationName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Start&amp;quot;&quot;/>&#xa;            &lt;/pm:operationName>&#xa;            &lt;pm:options>&#xa;                &lt;pm:priority>&#xa;                    &lt;xsl:value-of select=&quot;xsd:short($PriorityBPM)&quot;/>&#xa;                &lt;/pm:priority>&#xa;            &lt;/pm:options>&#xa;            &lt;pm:parameterMap>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esito&amp;quot;&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($checkDN.body/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;0&amp;quot;])&quot;>&#xa;                            &lt;pm:value>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/pm:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($checkDN.body/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;2&amp;quot;])&quot;>&#xa;                            &lt;pm:value>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/pm:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;pm:value>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/pm:value>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/pm:parameter>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDRichiestaOLO&amp;quot;&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;pm:value>&#xa;                        &lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdentificativoRichiestaOLO&quot;/>&#xa;                    &lt;/pm:value>&#xa;                &lt;/pm:parameter>&#xa;                &lt;xsl:if test=&quot;string-length($ConcatSequenceInput)>0&quot;>&#xa;                    &lt;pm:parameter>&#xa;                        &lt;pm:name>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATIDBCFX&amp;quot;&quot;/>&#xa;                        &lt;/pm:name>&#xa;                        &lt;pm:value>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;[&amp;quot;,$ConcatSequenceInput,&amp;quot;]&amp;quot;)&quot;/>&#xa;                        &lt;/pm:value>&#xa;                    &lt;/pm:parameter>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto)>0&quot;>&#xa;                    &lt;pm:parameter>&#xa;                        &lt;pm:name>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CodiceCausaleScarto&amp;quot;&quot;/>&#xa;                        &lt;/pm:name>&#xa;                        &lt;pm:value>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$MapDatiDBCFX/tns2:Esito/tns2:CodiceCausaleScarto&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/pm:value>&#xa;                    &lt;/pm:parameter>&#xa;      