                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:rf2="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="checkDN"/&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="ID_ProcessoNoFile"/&gt;&lt;xsl:param name="Risposta"/&gt;&lt;xsl:template name="InsertUpdateStaging_Error-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingIn&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;xsl:if test="string-length($Risposta/rf2:Codice)&gt;0"&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($Risposta)"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($FaultDetails/StackTrace)&gt;0"&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="&amp;quot;Errore generico&amp;quot;"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$checkDN/header/h:Header/h:transactionID"&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$checkDN/header/h:Header/h:transactionID"/&gt;&lt;/tns1:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdentificativoRichiestaOLO"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:OPERATORE&gt;&lt;xsl:value-of select="&amp;quot;AUTOMATICO&amp;quot;"/&gt;&lt;/tns1:OPERATORE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($checkDN/header/h:Header/h:interactionDate/h:Date)&gt;0 and string-length($checkDN/header/h:Header/h:interactionDate/h:Time)&gt;0  "&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN/header/h:Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN/header/h:Header/h:interactionDate/h:Time))"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:CODICE_ORDINE_TI&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:CodiceOrdineTI"/&gt;&lt;/tns1:CODICE_ORDINE_TI&gt;&lt;tns1:ID_LINEA&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdLinea"/&gt;&lt;/tns1:ID_LINEA&gt;&lt;/tns1:StagingIn&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="&amp;quot;STAG_RICH_VERIFICA_FASE2_NOFIN&amp;quot;"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_ProcessoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($checkDN/header/h:Header/h:interactionDate/h:Date)&gt;0 and string-length($checkDN/header/h:Header/h:interactionDate/h:Time)&gt;0  "&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN/header/h:Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN/header/h:Header/h:interactionDate/h:Time))"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkDN.header&quot;/>&#xa;    &lt;xsl:param name=&quot;checkDN.body&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ProcessoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Risposta&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertUpdateStaging_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingIn>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($checkDN.body)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;string-length($Risposta/rf2:Codice)>0&quot;>&#xa;                    &lt;tns1:CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Risposta)&quot;/>&#xa;                    &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($FaultDetails/StackTrace)>0&quot;>&#xa;                        &lt;tns1:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                        &lt;/tns1:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Errore generico&amp;quot;&quot;/>&#xa;                        &lt;/tns1:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$checkDN.header/h:transactionID&quot;>&#xa;                    &lt;tns1:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$checkDN.header/h:transactionID&quot;/>&#xa;                    &lt;/tns1:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdentificativoRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH_OLO>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($checkDN.header/h:interactionDate/h:Date)>0 and string-length($checkDN.header/h:interactionDate/h:Time)>0  &quot;>&#xa;                        &lt;tns1:TIMSTP_RICH>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN.header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN.header/h:interactionDate/h:Time))&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RICH>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:TIMSTP_RICH>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:TIMSTP_RICH>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:CODICE_ORDINE_TI>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.body/rf2:CodiceOrdineTI&quot;/>&#xa;                &lt;/tns1:CODICE_ORDINE_TI>&#xa;                &lt;tns1:ID_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdLinea&quot;/>&#xa;                &lt;/tns1:ID_LINEA>&#xa;            &lt;/tns1:StagingIn>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_RICH_VERIFICA_FASE2_NOFIN&amp;quot;&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ProcessoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($checkDN.header/h:interactionDate/h:Date)>0 and string-length($checkDN.header/h:interactionDate/h:Time)>0  &quot;>&#xa;                            &lt;ns:TMSP_INIZIO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN.header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN.header/h:interactionDate/h:Time))&quot;/>&#xa;                            &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:TMSP_INIZIO_ELAB>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="Assign1ToInsertUpdateStaging_Error"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertUpdateStaging_ErrorTocheckDNOut_Error"/>
                                    </bpws:sources>
                                    </bpws:invoke>
