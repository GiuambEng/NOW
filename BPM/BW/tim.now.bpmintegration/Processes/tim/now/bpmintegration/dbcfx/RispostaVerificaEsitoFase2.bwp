                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DatiDBCFX/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;checkDN&quot;/>&lt;xsl:param name=&quot;SelectCodOloAgcom&quot;/>&lt;xsl:template name=&quot;MapDatiDBCFX-input&quot; match=&quot;/&quot;>&lt;tns:DatiDBCFXInput>&lt;xsl:if test=&quot;count($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:NumerazioniAccesso)>0&quot;>&lt;xsl:for-each select=&quot;$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:NumerazioniAccesso&quot;>&lt;tns:DatiDBCFX>&lt;tns:ConcatSequenceInput>&lt;xsl:value-of select=&quot;concat('&amp;lt;controlli:DatiDBCFXType xsi:type=&amp;quot;controlli:DatiDBCFXType&amp;quot; xmlns:controlli=&amp;quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&amp;quot; xmlns:xsi=&amp;quot;http://www.w3.org/2001/XMLSchema-instance&amp;quot;>&amp;lt;controlli:Direzionalita>',rf2:Direzionalita,'&amp;lt;/controlli:Direzionalita>&amp;lt;controlli:DN>',rf2:DN,'&amp;lt;/controlli:DN>&amp;lt;/controlli:DatiDBCFXType>')&quot;/>&lt;/tns:ConcatSequenceInput>&lt;/tns:DatiDBCFX>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdLinea)>0&quot;>&lt;tns:DatiDBCFX>&lt;tns:ConcatSequenceInput>&lt;xsl:value-of select=&quot;concat('&amp;lt;controlli:DatiDBCFXType xsi:type=&amp;quot;controlli:DatiDBCFXType&amp;quot; xmlns:controlli=&amp;quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&amp;quot; xmlns:xsi=&amp;quot;http://www.w3.org/2001/XMLSchema-instance&amp;quot;>&amp;lt;controlli:Direzionalita>','BIDIREZIONALE','&amp;lt;/controlli:Direzionalita>&amp;lt;controlli:DN>',$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdLinea,'&amp;lt;/controlli:DN>&amp;lt;/controlli:DatiDBCFXType>')&quot;/>&lt;/tns:ConcatSequenceInput>&lt;/tns:DatiDBCFX>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;0&amp;quot;])&quot;>&lt;tns:Esito/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;2&amp;quot;])&quot;>&lt;tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;XDSL&amp;quot; or $SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;NGA&amp;quot;&quot;>&lt;tns:CodiceCausaleScarto>&lt;xsl:value-of select=&quot;&amp;quot;C19&amp;quot;&quot;/>&lt;/tns:CodiceCausaleScarto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceCausaleScarto>&lt;xsl:value-of select=&quot;&amp;quot;934&amp;quot;&quot;/>&lt;/tns:CodiceCausaleScarto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;XDSL&amp;quot; or $SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;NGA&amp;quot;&quot;>&lt;tns:CodiceCausaleScarto>&lt;xsl:value-of select=&quot;&amp;quot;C18&amp;quot;&quot;/>&lt;/tns:CodiceCausaleScarto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceCausaleScarto>&lt;xsl:value-of select=&quot;&amp;quot;933&amp;quot;&quot;/>&lt;/tns:CodiceCausaleScarto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DatiDBCFXInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
