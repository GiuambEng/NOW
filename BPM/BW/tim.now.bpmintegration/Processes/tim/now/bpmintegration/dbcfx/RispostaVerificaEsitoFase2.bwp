&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:rf2="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:pm="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="checkDN"/&gt;&lt;xsl:param name="_error"/&gt;&lt;xsl:param name="createProcessInstance"/&gt;&lt;xsl:param name="ID_ProcessoNoFile"/&gt;&lt;xsl:param name="Risposta"/&gt;&lt;xsl:template name="InsertUpdateStaging-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingIn&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($checkDN/body/rf2:RispostaVerificaEsitoFase2_Request)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;xsl:if test="string-length($createProcessInstance/params/pm:processID) &gt; 0"&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($Risposta)"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error)"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($_error/StackTrace)&gt;0 "&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="$_error/StackTrace"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="&amp;quot;Errore generico&amp;quot;"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($checkDN/header/h:Header/h:transactionID)&gt;0"&gt;&lt;xsl:if test="$checkDN/header/h:Header/h:transactionID"&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$checkDN/header/h:Header/h:transactionID"/&gt;&lt;/tns1:ID_RICH&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="tib:uuid()"/&gt;&lt;/tns1:ID_RICH&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdentificativoRichiestaOLO"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error)"&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:OPERATORE&gt;&lt;xsl:value-of select="&amp;quot;AUTOMATICO&amp;quot;"/&gt;&lt;/tns1:OPERATORE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($checkDN/header/h:Header/h:interactionDate/h:Date)&gt;0 and string-length($checkDN/header/h:Header/h:interactionDate/h:Time)&gt;0  "&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN/header/h:Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN/header/h:Header/h:interactionDate/h:Time))"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:CODICE_ORDINE_TI&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:CodiceOrdineTI"/&gt;&lt;/tns1:CODICE_ORDINE_TI&gt;&lt;tns1:ID_LINEA&gt;&lt;xsl:value-of select="$checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdLinea"/&gt;&lt;/tns1:ID_LINEA&gt;&lt;/tns1:StagingIn&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="&amp;quot;STAG_RICH_VERIFICA_FASE2_NOFIN&amp;quot;"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_ProcessoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($checkDN/header/h:Header/h:interactionDate/h:Date)&gt;0 and string-length($checkDN/header/h:Header/h:interactionDate/h:Time)&gt;0  "&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN/header/h:Header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN/header/h:Header/h:interactionDate/h:Time))"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:pm=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;createProcessInstance.params&quot;/>&lt;xsl:param name=&quot;checkDN.header&quot;/>&lt;xsl:param name=&quot;checkDN.body&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;ID_ProcessoNoFile&quot;/>&lt;xsl:param name=&quot;Risposta&quot;/>&lt;xsl:template name=&quot;InsertUpdateStaging-input&quot; match=&quot;/&quot;>&lt;tns1:StagingRequest>&lt;tns1:StagingIn>&lt;tns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($checkDN.body)&quot;/>&lt;/tns1:CONTENUTO_REQUEST>&lt;xsl:if test=&quot;string-length($createProcessInstance.params) > 0&quot;>&lt;tns1:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($Risposta)&quot;/>&lt;/tns1:CONTENUTO_RESPONSE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($_error/StackTrace)>0 &quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$_error/StackTrace&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;Errore generico&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($checkDN.header/h:transactionID)>0&quot;>&lt;xsl:if test=&quot;$checkDN.header/h:transactionID&quot;>&lt;tns1:ID_RICH>&lt;xsl:value-of select=&quot;$checkDN.header/h:transactionID&quot;/>&lt;/tns1:ID_RICH>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ID_RICH>&lt;xsl:value-of select=&quot;tib:uuid()&quot;/>&lt;/tns1:ID_RICH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdentificativoRichiestaOLO&quot;/>&lt;/tns1:ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error)&quot;>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;12&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;11&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:OPERATORE>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/tns1:OPERATORE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($checkDN.header/h:interactionDate/h:Date)>0 and string-length($checkDN.header/h:interactionDate/h:Time)>0  &quot;>&lt;tns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN.header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN.header/h:interactionDate/h:Time))&quot;/>&lt;/tns1:TIMSTP_RICH>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:TIMSTP_RICH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$checkDN.body/rf2:CodiceOrdineTI&quot;/>&lt;/tns1:CODICE_ORDINE_TI>&lt;tns1:ID_LINEA>&lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdLinea&quot;/>&lt;/tns1:ID_LINEA>&lt;/tns1:StagingIn>&lt;tns1:StagingType>&lt;xsl:value-of select=&quot;&amp;quot;STAG_RICH_VERIFICA_FASE2_NOFIN&amp;quot;&quot;/>&lt;/tns1:StagingType>&lt;tns1:LoggerIn>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:EsecuzioneNOFileProcessato>&lt;ns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$ID_ProcessoNoFile&quot;/>&lt;/ns:ID_PROCSO_NO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_FINE_ELAB>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($checkDN.header/h:interactionDate/h:Date)>0 and string-length($checkDN.header/h:interactionDate/h:Time)>0  &quot;>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, concat($checkDN.header/h:interactionDate/h:Date,&amp;quot; &amp;quot;,$checkDN.header/h:interactionDate/h:Time))&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:EsecuzioneNOFileProcessato>&lt;ns:LogFileProcessato>&lt;ns:LOG_LEVEL>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/ns:LOG_LEVEL>&lt;ns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&lt;/ns:LOG_MESSAGE>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;/ns:LogFileProcessato>&lt;/tns1:LoggerIn>&lt;/tns1:StagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
