                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/concrete/DatiVerificaControlli/&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkDN.body&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$checkDN.body/rf2:IdentificativoRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;xsl:for-each select=&quot;$checkDN.body/rf2:NumerazioniAccesso&quot;>&#xa;                &lt;tns1:DatiDBCFX>&#xa;                    &lt;tns1:Direzionalita>&#xa;                        &lt;xsl:value-of select=&quot;rf2:Direzionalita&quot;/>&#xa;                    &lt;/tns1:Direzionalita>&#xa;                    &lt;tns1:DN>&#xa;                        &lt;xsl:value-of select=&quot;rf2:DN&quot;/>&#xa;                    &lt;/tns1:DN>&#xa;                &lt;/tns1:DatiDBCFX>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;string-length($checkDN.body/rf2:IdLinea)>0&quot;>&#xa;                &lt;tns1:DatiDBCFX>&#xa;                    &lt;tns1:Direzionalita>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BIDIREZIONALE&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Direzionalita>&#xa;            