essage>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risposta Verifica Esito Fase 2 per IdRichiestaOlo &amp;quot;, $checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdentificativoRichiestaOLO,&amp;quot; inserimento effetuato correttamente. &amp;quot;)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risposta Verifica Esito Fase 2 per IdRichiestaOlo &amp;quot;, $checkDN/body/rf2:RispostaVerificaEsitoFase2_Request/rf2:IdentificativoRichiestaOLO,&amp;quot; inserimento non effettuato.&amp;quot;)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
