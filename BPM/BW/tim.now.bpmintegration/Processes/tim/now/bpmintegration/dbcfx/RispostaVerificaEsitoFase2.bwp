                                    tibex:xpdlId="3e0e7cda-4422-4876-a285-af69f9b423e0" variable="checkDNOut_Error-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/RispostaVerificaEsitoFase2/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:rf2="http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/" version="2.0"&gt;&lt;xsl:param name="checkDN"/&gt;&lt;xsl:param name="Risposta"/&gt;&lt;xsl:template name="checkDNOut_Error-input" match="/"&gt;&lt;tns:RispostaVerificaEsitoFase2Ack&gt;&lt;header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="format-time(current-time(), &amp;quot;[H01]:[m01]:[s01]&amp;quot;)"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$checkDN/header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$checkDN/header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$checkDN/header/h:Header/h:messageID"&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$checkDN/header/h:Header/h:messageID"/&gt;&lt;/h:messageID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$checkDN/header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$checkDN/header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;body&gt;&lt;xsl:copy-of select="$Risposta"/&gt;&lt;/body&gt;&lt;/tns:RispostaVerificaEsitoFase2Ack&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/RispostaVerificaEsitoFase2/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkDN.header&quot;/>&#xa;    &lt;xsl:template name=&quot;checkDNOut_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;h:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/h:sourceSystem>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$checkDN.header/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.header/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$checkDN.header/h:messageID&quot;>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.header/h:messageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$checkDN.header/h:transactionID&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$checkDN.header/h:transactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/RispostaVerificaEsitoFase2/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Risposta&quot;/>&#xa;    &lt;xsl:template name=&quot;checkDNOut_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Risposta&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
