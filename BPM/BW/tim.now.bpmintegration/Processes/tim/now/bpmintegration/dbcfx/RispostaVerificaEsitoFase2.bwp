                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:rf2=&quot;http://www.tim.com/NOW/xsd/RispostaVerificaEsitoFase2/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DatiDBCFX/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkDN.body&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCodOloAgcom&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDatiDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DatiDBCFXInput>&#xa;            &lt;xsl:if test=&quot;count($checkDN.body/rf2:NumerazioniAccesso)>0&quot;>&#xa;                &lt;xsl:for-each select=&quot;$checkDN.body/rf2:NumerazioniAccesso&quot;>&#xa;                    &lt;tns:DatiDBCFX>&#xa;                        &lt;tns:ConcatSequenceInput>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;lt;controlli:DatiDBCFXType xsi:type=&amp;quot;controlli:DatiDBCFXType&amp;quot; xmlns:controlli=&amp;quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&amp;quot; xmlns:xsi=&amp;quot;http://www.w3.org/2001/XMLSchema-instance&amp;quot;>&amp;lt;controlli:Direzionalita>',rf2:Direzionalita,'&amp;lt;/controlli:Direzionalita>&amp;lt;controlli:DN>',rf2:DN,'&amp;lt;/controlli:DN>&amp;lt;/controlli:DatiDBCFXType>')&quot;/>&#xa;                        &lt;/tns:ConcatSequenceInput>&#xa;                    &lt;/tns:DatiDBCFX>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($checkDN.body/rf2:IdLinea)>0&quot;>&#xa;                &lt;tns:DatiDBCFX>&#xa;                    &lt;tns:ConcatSequenceInput>&#xa;                        &lt;xsl:value-of select=&quot;concat('&amp;lt;controlli:DatiDBCFXType xsi:type=&amp;quot;controlli:DatiDBCFXType&amp;quot; xmlns:controlli=&amp;quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&amp;quot; xmlns:xsi=&amp;quot;http://www.w3.org/2001/XMLSchema-instance&amp;quot;>&amp;lt;controlli:Direzionalita>','BIDIREZIONALE','&amp;lt;/controlli:Direzionalita>&amp;lt;controlli:DN>',$checkDN.body/rf2:IdLinea,'&amp;lt;/controlli:DN>&amp;lt;/controlli:DatiDBCFXType>')&quot;/>&#xa;                    &lt;/tns:ConcatSequenceInput>&#xa;                &lt;/tns:DatiDBCFX>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($checkDN.body/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;0&amp;quot;])&quot;>&#xa;                    &lt;tns:Esito/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($checkDN.body/rf2:VerificaFase2[(rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODIFICAOLOAGCOM or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/CODFC_OLO_AGCOM_RICH or rf2:CodiceOLO=$SelectCodOloAgcom/Record[1]/ROUTING_OLO) and rf2:Esito=&amp;quot;2&amp;quot;])&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;XDSL&amp;quot; or $SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;NGA&amp;quot;&quot;>&#xa;                                &lt;tns:CodiceCausaleScarto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;C19&amp;quot;&quot;/>&#xa;                                &lt;/tns:CodiceCausaleScarto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CodiceCausaleScarto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;934&amp;quot;&quot;/>&#xa;                                &lt;/tns:CodiceCausaleScarto>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;XDSL&amp;quot; or $SelectCodOloAgcom/Record[1]/STRUTTURARICHIESTA=&amp;quot;NGA&amp;quot;&quot;>&#xa;                                &lt;tns:CodiceCausaleScarto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;C18&amp;quot;&quot;/>&#xa;                                &lt;/tns:CodiceCausaleScarto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CodiceCausaleScarto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;933&amp;quot;&quot;/>&#xa;                                &lt;/tns:CodiceCausaleScarto>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:DatiDBCFXInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
