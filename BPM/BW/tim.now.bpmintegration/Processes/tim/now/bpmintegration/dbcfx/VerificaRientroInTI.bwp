                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/InterfacciaVerificaRientroInTI/" xmlns:sm="http://www.tibco.com/VerificaRientroInTI/" xmlns:sm1="http://dbcfx/SOA/VerificaRientroInTI/2021-10-05" version="2.0"&gt;
    &lt;xsl:param name="DBCFX"/&gt;
    &lt;xsl:template name="Reply1-input" match="/"&gt;
        &lt;tns:VerificaRientroInTIResponse&gt;
            &lt;output&gt;
                &lt;sm:Response&gt;
                    &lt;sm:EsitoNOW&gt;
                        &lt;xsl:value-of select="false()"/&gt;
                    &lt;/sm:EsitoNOW&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($DBCFX/body/sm1:verificaRientroInTIResponse/sm1:ESITO)&gt;0"&gt;
                            &lt;sm:EsitoDBCFX&gt;
