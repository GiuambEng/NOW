                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tibco.com/VerificaRientroInTI/&quot; xmlns:sm1=&quot;http://dbcfx/SOA/VerificaRientroInTI/2021-10-05&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;DBCFX.body&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaRientroInTIIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($DBCFX.body)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RISPOSTA>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;xsl:if test=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;>&#xa;                &lt;tns1:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_VERIFICA_DN_DBCFX'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStag.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
