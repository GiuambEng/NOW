&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:sm="http://www.tibco.com/VerificaRientroInTI/" xmlns:tns2="http://www.tibco.com/InterfacciaVerificaRientroInTI/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:sm1="http://dbcfx/SOA/VerificaRientroInTI/2021-10-05" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="VerificaRientroInTIIn"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:param name="Richiesta"/&gt;&lt;xsl:template name="InsertStag-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($Richiesta)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$Richiesta/sm1:ID_LINEA"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;xsl:if test="$VerificaRientroInTIIn/input/sm:Request/sm:IdRichiestaOlo"&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="$VerificaRientroInTIIn/input/sm:Request/sm:IdRichiestaOlo"/&gt;&lt;/tns1:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;/tns1:StagingOut&gt;&lt;xsl:if test="$VerificaRientroInTIIn/input/sm:Request/sm:IdRichiestaOlo"&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$VerificaRientroInTIIn/input/sm:Request/sm:IdRichiestaOlo"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_VERIFICA_DN_DBCFX'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:sm=&quot;http://www.tibco.com/VerificaRientroInTI/&quot; xmlns:tns2=&quot;http://www.tibco.com/InterfacciaVerificaRientroInTI/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:sm1=&quot;http://dbcfx/SOA/VerificaRientroInTI/2021-10-05&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRientroInTIIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Richiesta)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;tns1:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/sm1:ID_LINEA&quot;/>&#xa;                &lt;/tns1:ID_RISORSA>&#xa;                &lt;xsl:if test=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;>&#xa;                    &lt;tns1:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns1:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;xsl:if test=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;>&#xa;                &lt;tns1:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaRientroInTIIn.input/sm:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_VERIFICA_DN_DBCFX'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
