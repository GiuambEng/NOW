                            &lt;/sm:CausaleDBCFX&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/sm:Response&gt;
            &lt;/output&gt;
        &lt;/tns:VerificaRientroInTIResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
