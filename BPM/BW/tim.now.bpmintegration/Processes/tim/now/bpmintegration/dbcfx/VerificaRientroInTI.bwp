                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($DBCFX/body/sm1:verificaRientroInTIResponse/sm1:CAUSALE)&gt;0"&gt;
                            &lt;sm:CausaleDBCFX&gt;
