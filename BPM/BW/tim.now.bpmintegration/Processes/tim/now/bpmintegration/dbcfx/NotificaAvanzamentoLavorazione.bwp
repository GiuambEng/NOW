            <bpws:invoke inputVariable="InvokeDBCFX-input"
                name="InvokeDBCFX" operation="sendNotificaMsgDonating"
                outputVariable="InvokeDBCFX"
                partnerLink="MsgDonatingPortType"
                portType="ns8:MsgDonatingPortType" tibex:xpdlId="d462cb57-06d2-4467-a6df-d0d51a4bf3f1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://dbcfx/SOA/MsgDonating/2016-09-15" xmlns:tns7="http://dbcfx/SOA/MsgDonating" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="MessageId"/&gt;&lt;xsl:param name="Richiesta"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="InvokeDBCFX-input" match="/"&gt;&lt;tns7:MsgDonatingRequest&gt;&lt;Header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-date()),'+')"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-time()),'+')"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$MessageId"/&gt;&lt;/h:messageID&gt;&lt;xsl:if test="$Richiesta/Record[1]/IDRICHIESTA"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$Richiesta/Record[1]/IDRICHIESTA"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/Header&gt;&lt;body&gt;&lt;tns3:MsgDonatingRequest&gt;&lt;xsl:copy-of select="$Mapper/tns3:MsgDonating"/&gt;&lt;/tns3:MsgDonatingRequest&gt;&lt;/body&gt;&lt;/tns7:MsgDonatingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/MsgDonating/2016-09-15&quot; xmlns:tns7=&quot;http://dbcfx/SOA/MsgDonating&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MessageId&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;h:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/h:sourceSystem>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;h:messageID>&#xa;                &lt;xsl:value-of select=&quot;$MessageId&quot;/>&#xa;            &lt;/h:messageID>&#xa;            &lt;xsl:if test=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/MsgDonating/2016-09-15&quot; xmlns:tns7=&quot;http://dbcfx/SOA/MsgDonating&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDBCFX-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:MsgDonatingRequest>&#xa;            &lt;xsl:copy-of select=&quot;$Mapper/tns3:MsgDonating&quot;/>&#xa;        &lt;/tns3:MsgDonatingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
