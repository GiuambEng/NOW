                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://dbcfx/SOA/MsgDonating/2016-09-15&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UsciteDel82vsDBCFX/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns3:MsgDonatingRequest>&lt;tns3:MsgDonating>&lt;tns3:CODICE_OPERATORE_RECIPIENT>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODICEOPERATOREREC&quot;/>&lt;/tns3:CODICE_OPERATORE_RECIPIENT>&lt;tns3:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODICEOPERATOREWHS&quot;/>&lt;/tns3:CODICE_OPERATORE_WHS>&lt;tns3:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOlo&quot;/>&lt;/tns3:CODICE_ORDINE_WHS>&lt;tns3:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/IDNOTIFICA&quot;/>&lt;/tns3:ID_NOTIFICA>&lt;tns3:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;concat(substring($Richiesta/Record[1]/DATANOTIFICA, 1, 10), ' ',substring($Richiesta/Record[1]/DATANOTIFICA, 12, 8))&quot;/>&lt;/tns3:DATA_NOTIFICA>&lt;tns3:EVENTO>&lt;xsl:value-of select=&quot;$Start/tns:Evento&quot;/>&lt;/tns3:EVENTO>&lt;tns3:COR>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/COR&quot;/>&lt;/tns3:COR>&lt;xsl:if test=&quot;$Richiesta/Record[1]/DATA&quot;>&lt;tns3:DATA>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/DATA&quot;/>&lt;/tns3:DATA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/Record[1]/ORA&quot;>&lt;tns3:ORA>&lt;xsl:value-of select=&quot;$Richiesta/Record[1]/ORA&quot;/>&lt;/tns3:ORA>&lt;/xsl:if>&lt;/tns3:MsgDonating>&lt;/tns3:MsgDonatingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
