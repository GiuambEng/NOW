                            &lt;/tns4:ID_RICH&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_RISORSA&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:COR"/&gt;
                        &lt;/tns4:ID_RISORSA&gt;
                        &lt;tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                        &lt;tns4:CODICEOPERATOREREC&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:CODICE_OPERATORE_RECIPIENT"/&gt;
                        &lt;/tns4:CODICEOPERATOREREC&gt;
                        &lt;tns4:CODICEOPERATOREWHS&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:CODICE_OPERATORE_WHS"/&gt;
                        &lt;/tns4:CODICEOPERATOREWHS&gt;
                        &lt;tns4:IDNOTIFICA&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:ID_NOTIFICA"/&gt;
                        &lt;/tns4:IDNOTIFICA&gt;
                        &lt;tns4:DATANOTIFICA&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:DATA_NOTIFICA"/&gt;
                        &lt;/tns4:DATANOTIFICA&gt;
                        &lt;tns4:NOMEFLUSSO&gt;
                            &lt;xsl:value-of select="'N10'"/&gt;
                        &lt;/tns4:NOMEFLUSSO&gt;
                        &lt;tns4:EVENTO&gt;
                            &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:EVENTO"/&gt;
                        &lt;/tns4:EVENTO&gt;
                        &lt;xsl:if test="$Mapper/tns3:MsgDonating/tns3:DATA"&gt;
                            &lt;tns4:DATA&gt;
                                &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:DATA"/&gt;
                            &lt;/tns4:DATA&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Mapper/tns3:MsgDonating/tns3:ORA"&gt;
                            &lt;tns4:ORA&gt;
                                &lt;xsl:value-of select="$Mapper/tns3:MsgDonating/tns3:ORA"/&gt;
                            &lt;/tns4:ORA&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'TRACC_FL_N8_N10_VS_DBCFX'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns:TipologiaProcesso&gt;
                        &lt;ns:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns:TipologiaOperazione&gt;
                        &lt;ns:EsecuzioneNOFileProcessato&gt;
                            &lt;ns:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="177"/&gt;
                            &lt;/ns:ID_PROCSO_NO_FILE&gt;
                            &lt;ns:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns:STATO_ESEC&gt;
                            &lt;ns:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:LogFileProcessato&gt;
                            &lt;ns:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns:LOG_LEVEL&gt;
                            &lt;ns:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns:LOG_MESSAGE&gt;
                            &lt;ns:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TIMSTP_INSMTO&gt;
                        &lt;/ns:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns3=&quot;http://dbcfx/SOA/MsgDonating/2016-09-15&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns4:COD_ORDN_OLO>&#xa;                &lt;tns4:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper/tns3:MsgDonating)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_REQUEST>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;177&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;>&#xa;                    &lt;tns4:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;/>&#xa;                    &lt;/tns4:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:COR&quot;/>&#xa;                &lt;/tns4:ID_RISORSA>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:CODICEOPERATOREREC>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:CODICE_OPERATORE_RECIPIENT&quot;/>&#xa;                &lt;/tns4:CODICEOPERATOREREC>&#xa;                &lt;tns4:CODICEOPERATOREWHS>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:CODICE_OPERATORE_WHS&quot;/>&#xa;                &lt;/tns4:CODICEOPERATOREWHS>&#xa;                &lt;tns4:IDNOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:ID_NOTIFICA&quot;/>&#xa;                &lt;/tns4:IDNOTIFICA>&#xa;                &lt;tns4:DATANOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:DATA_NOTIFICA&quot;/>&#xa;                &lt;/tns4:DATANOTIFICA>&#xa;                &lt;tns4:NOMEFLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;'N10'&quot;/>&#xa;                &lt;/tns4:NOMEFLUSSO>&#xa;                &lt;tns4:EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:EVENTO&quot;/>&#xa;                &lt;/tns4:EVENTO>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns3:MsgDonating/tns3:DATA&quot;>&#xa;                    &lt;tns4:DATA>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:DATA&quot;/>&#xa;                    &lt;/tns4:DATA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns3:MsgDonating/tns3:ORA&quot;>&#xa;                    &lt;tns4:ORA>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns3:MsgDonating/tns3:ORA&quot;/>&#xa;                    &lt;/tns4:ORA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'TRACC_FL_N8_N10_VS_DBCFX'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;177&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
