            <bpws:reply name="InvokeOut" operation="Invoke"
                partnerLink="EsitoVerificaCodiceSessione"
                portType="ns1:EsitoVerificaCodiceSessione"
                tibex:xpdlId="1b4925f6-1890-4c05-9121-a19d2c3cc212" variable="InvokeOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:param name="MessageId"/&gt;&lt;xsl:param name="Response"/&gt;&lt;xsl:template name="InvokeOut-input" match="/"&gt;&lt;tns:Response&gt;&lt;output&gt;&lt;xsl:copy-of select="$Response"/&gt;&lt;/output&gt;&lt;header&gt;&lt;h:Header&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:sourceSystem"&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:sourceSystem"/&gt;&lt;/h:sourceSystem&gt;&lt;/xsl:if&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-date()),'+')"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-time()),'+')"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$MessageId"/&gt;&lt;/h:messageID&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Response&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.header&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageId&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:sourceSystem&quot;>&#xa;                &lt;h:sourceSystem>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:sourceSystem&quot;/>&#xa;                &lt;/h:sourceSystem>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:messageID>&#xa;                &lt;xsl:value-of select=&quot;$MessageId&quot;/>&#xa;            &lt;/h:messageID>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:transactionID&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:transactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToInvokeOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'EsitoVerificaCodiceSessione'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaCodiceSessione body: ',tib:render-xml($InvokeIn/input/tns1:Request))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaCodiceSessione header: ',tib:render-xml($InvokeIn/header))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInput-input" name="LogInput"
                    tibex:xpdlId="1afcbde9-2db6-42cc-9720-c88ca597ea10"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeInToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeIn.header&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'EsitoVerificaCodiceSessione'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaCodiceSessione body: ',tib:render-xml($InvokeIn.input))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaCodiceSessione header: ',tib:render-xml($InvokeIn.header))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="MessageId"
                    name="MessageId" outputVariable="MessageId"
                    tibex:xpdlId="2b1fff80-22c0-4852-a6e3-20f4dbb9bb0f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MessageIdToStagingProcessManager"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="string(tib:timestamp())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="MessageId" xsi:type="generalactivities:BWAssign"/>
