                        <bpws:reply name="Reply" operation="Invoke"
                            partnerLink="EsitoVerificaCodiceSessione"
                            portType="ns1:EsitoVerificaCodiceSessione"
                            tibex:xpdlId="645dce85-6762-4dbe-8b46-9eed5f3875b0" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="MessageId"/&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:Response&gt;&lt;output&gt;&lt;tns1:Response&gt;&lt;tns1:ID_NOTIFICA&gt;&lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:ID_NOTIFICA"/&gt;&lt;/tns1:ID_NOTIFICA&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/tns1:ESITO&gt;&lt;tns1:CODICE_MOTIVAZIONE&gt;&lt;xsl:value-of select="'A00'"/&gt;&lt;/tns1:CODICE_MOTIVAZIONE&gt;&lt;tns1:MOTIVAZIONE&gt;&lt;xsl:value-of select="'Errore tecnico di interfaccia'"/&gt;&lt;/tns1:MOTIVAZIONE&gt;&lt;/tns1:Response&gt;&lt;/output&gt;&lt;header&gt;&lt;h:Header&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:sourceSystem"&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:sourceSystem"/&gt;&lt;/h:sourceSystem&gt;&lt;/xsl:if&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-date()),'+')"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="substring-before(xsd:string(current-time()),'+')"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$MessageId"/&gt;&lt;/h:messageID&gt;&lt;xsl:if test="$InvokeIn/header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$InvokeIn/header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;tns1:ID_NOTIFICA>&#xa;                &lt;xsl:value-of select=&quot;$InvokeIn.input/tns1:EsitoVerificaCodiceSessione/tns1:ID_NOTIFICA&quot;/>&#xa;            &lt;/tns1:ID_NOTIFICA>&#xa;            &lt;tns1:ESITO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;            &lt;/tns1:ESITO>&#xa;            &lt;tns1:CODICE_MOTIVAZIONE>&#xa;                &lt;xsl:value-of select=&quot;'A00'&quot;/>&#xa;            &lt;/tns1:CODICE_MOTIVAZIONE>&#xa;            &lt;tns1:MOTIVAZIONE>&#xa;                &lt;xsl:value-of select=&quot;'Errore tecnico di interfaccia'&quot;/>&#xa;            &lt;/tns1:MOTIVAZIONE>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_EsitoVerificaCodiceSessione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.header&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageId&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:sourceSystem&quot;>&#xa;                &lt;h:sourceSystem>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:sourceSystem&quot;/>&#xa;                &lt;/h:sourceSystem>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:messageID>&#xa;                &lt;xsl:value-of select=&quot;$MessageId&quot;/>&#xa;            &lt;/h:messageID>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.header/h:transactionID&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.header/h:transactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorStagingToReply"/>
                            </bpws:targets>
                        </bpws:reply>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
