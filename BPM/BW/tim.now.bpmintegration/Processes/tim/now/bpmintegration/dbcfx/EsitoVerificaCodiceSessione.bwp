                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="InsertUpdateStaging"
                outputVariable="InsertStaging"
                partnerLink="StagingProcessManager"
                portType="ns2:InsertUpdateStagingPortType" tibex:xpdlId="34907060-9e4a-4ae9-a042-c328c0c12a92">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="InvokeIn"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:COD_ORDN_OLO&gt;
                            &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_ORDINE_WHS"/&gt;
                        &lt;/tns4:COD_ORDN_OLO&gt;
                        &lt;tns4:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($InvokeIn/input/tns1:Request)"/&gt;
                        &lt;/tns4:CONTENUTO_REQUEST&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="176"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;xsl:if test="$InvokeIn/header/h:Header/h:transactionID"&gt;
                            &lt;tns4:ID_RICH&gt;
                                &lt;xsl:value-of select="$InvokeIn/header/h:Header/h:transactionID"/&gt;
                            &lt;/tns4:ID_RICH&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                        &lt;xsl:if test="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:MOTIVAZIONE"&gt;
                            &lt;tns4:MOTIVAZIONE&gt;
                                &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:MOTIVAZIONE"/&gt;
                            &lt;/tns4:MOTIVAZIONE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_MOTIVAZIONE"&gt;
                            &lt;tns4:CODICEMOTIVAZIONE&gt;
                                &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_MOTIVAZIONE"/&gt;
                            &lt;/tns4:CODICEMOTIVAZIONE&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:IDNOTIFICA&gt;
                            &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:ID_NOTIFICA"/&gt;
                        &lt;/tns4:IDNOTIFICA&gt;
                        &lt;tns4:DATANOTIFICA&gt;
                            &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:DATA_NOTIFICA"/&gt;
                        &lt;/tns4:DATANOTIFICA&gt;
                        &lt;tns4:ESITO&gt;
                            &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:ESITO"/&gt;
                        &lt;/tns4:ESITO&gt;
                        &lt;xsl:if test="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:NOTE"&gt;
                            &lt;tns4:NOTE&gt;
                                &lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:NOTE"/&gt;
                            &lt;/tns4:NOTE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'TRACC_FL_N9_VS_NOW'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns:TipologiaProcesso&gt;
                        &lt;ns:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns:TipologiaOperazione&gt;
                        &lt;ns:EsecuzioneNOFileProcessato&gt;
                            &lt;ns:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="176"/&gt;
                            &lt;/ns:ID_PROCSO_NO_FILE&gt;
                            &lt;ns:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns:STATO_ESEC&gt;
                            &lt;ns:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:LogFileProcessato&gt;
                            &lt;ns:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns:LOG_LEVEL&gt;
                            &lt;ns:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns:LOG_MESSAGE&gt;
                            &lt;ns:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TIMSTP_INSMTO&gt;
                        &lt;/ns:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeIn.header&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.input/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns4:COD_ORDN_OLO>&#xa;                &lt;tns4:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeIn.input)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_REQUEST>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;176&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.header/h:transactionID&quot;>&#xa;                    &lt;tns4:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.header/h:transactionID&quot;/>&#xa;                    &lt;/tns4:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$Invoke