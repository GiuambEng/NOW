                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultToStagingProcessManager"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogFault-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'EsitoVerificaCodiceSessione'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns2:MsgCode>&lt;tns2:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="ErrorStaging-input"
                            name="ErrorStaging"
                            operation="InsertUpdateStaging"
                            outputVariable="ErrorStaging"
                            partnerLink="StagingProcessManager"
                            portType="ns2:InsertUpdateStagingPortType" tibex:xpdlId="feb20cf3-31f9-4444-a836-9ad0a199da81">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns6="http://www.tim.com/NOW/xsd/NOW_MsgDonating/" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/" version="2.0"&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:template name="ErrorStaging-input" match="/"&gt;&lt;tns3:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;tns4:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_ORDINE_WHS"/&gt;&lt;/tns4:COD_ORDN_OLO&gt;&lt;tns4:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Errore generico nel processo EsitoVerificaCodiceSessione'"/&gt;&lt;/tns4:DESCR_ERRORE&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="176"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;/tns4:StagingIn&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'TRACC_FL_N9_VS_NOW'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="176"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns3:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NOW_MsgDonating/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_EsitoVerificaCodiceSessione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.input/tns1:EsitoVerificaCodiceSessione/tns1:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns4:COD_ORDN_OLO>&#xa;                &lt;tns4:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo EsitoVerificaCodiceSessione'&quot;/>&#xa;                &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;176&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'TRACC_FL_N9_VS_NOW'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;176&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LogFaultToStagingProcessManager"/>
