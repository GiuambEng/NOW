            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="82577e8b-9745-4bf6-aa48-b0631e24bbb3">
                <bpws:onMessage operation="ValidateNotification"
                    partnerLink="StateMachineValidationPortType"
                    portType="ns48:StateMachineValidationPortType"
                    tibex:xpdlId="883af655-968b-40cf-b040-54b2cef568f6" variable="ValidateNotification">
