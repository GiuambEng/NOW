                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" version="2.0"&gt;&lt;xsl:param name="ValidateNotification"/&gt;&lt;xsl:param name="RecuperoNotificaDTU"/&gt;&lt;xsl:template name="CallValidation-input" match="/"&gt;&lt;tns:StateMachineValidationRequest&gt;&lt;parameters&gt;&lt;sm:StateMachineValidationRequest&gt;&lt;sm:IdRichiesta&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdRichiesta"/&gt;&lt;/sm:IdRichiesta&gt;&lt;sm:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEventoOrdnNowWhls"/&gt;&lt;/sm:IdEventoOrdnNowWhls&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:copy-of select="$RecuperoNotificaDTU/ns:EVENTO_NOTIFICA"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;sm:Offerta&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta"/&gt;&lt;/sm:Offerta&gt;&lt;sm:Lavorazione&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Lavorazione"/&gt;&lt;/sm:Lavorazione&gt;&lt;sm:StatoRichiestaNow&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaNow"/&gt;&lt;/sm:StatoRichiestaNow&gt;&lt;sm:StatoRichiestaPrecNow&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaPrecNow"/&gt;&lt;/sm:StatoRichiestaPrecNow&gt;&lt;sm:StatoRichiestaOlo&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaOlo"/&gt;&lt;/sm:StatoRichiestaOlo&gt;&lt;sm:CodProcsoNoFile&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;&lt;/sm:CodProcsoNoFile&gt;&lt;sm:IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEsecProcsoNoFile"/&gt;&lt;/sm:IdEsecProcsoNoFile&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Scenario"&gt;&lt;sm:Scenario&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Scenario"/&gt;&lt;/sm:Scenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:AnnullamentoAutomatico"&gt;&lt;sm:AnnullamentoAutomatico&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:AnnullamentoAutomatico"/&gt;&lt;/sm:AnnullamentoAutomatico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:DataSospensione"&gt;&lt;sm:DataSospensione&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:DataSospensione"/&gt;&lt;/sm:DataSospensione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IDPreventivo"&gt;&lt;sm:IDPreventivo&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IDPreventivo"/&gt;&lt;/sm:IDPreventivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagOpereSpeciali"&gt;&lt;sm:FlagOpereSpeciali&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagOpereSpeciali"/&gt;&lt;/sm:FlagOpereSpeciali&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:OffertaDonating)&gt;0"&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:OffertaDonating"&gt;&lt;sm:OffertaDonating&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:OffertaDonating"/&gt;&lt;/sm:OffertaDonating&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagDisaggregazione"&gt;&lt;sm:FlagDisaggregazione&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagDisaggregazione"/&gt;&lt;/sm:FlagDisaggregazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:GestioneAutonoma"&gt;&lt;sm:GestioneAutonoma&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:GestioneAutonoma"/&gt;&lt;/sm:GestioneAutonoma&gt;&lt;/xsl:if&gt;&lt;/sm:StateMachineValidationRequest&gt;&lt;/parameters&gt;&lt;/tns:StateMachineValidationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNotificaDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;CallValidation-input&quot; match=&quot;/&quot;>&#xa;        &lt;sm:StateMachineValidationRequest>&#xa;            &lt;sm:IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdRichiesta&quot;/>&#xa;            &lt;/sm:IdRichiesta>&#xa;            &lt;sm:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/sm:IdEventoOrdnNowWhls>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$RecuperoNotificaDTU/ns:EVENTO_NOTIFICA&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;sm:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:Offerta&quot;/>&#xa;            &lt;/sm:Offerta>&#xa;            &lt;sm:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:Lavorazione&quot;/>&#xa;            &lt;/sm:Lavorazione>&#xa;            &lt;sm:StatoRichiestaNow>&#xa;                