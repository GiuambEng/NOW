                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBC_RecuperoCompAttributiAsset-input"
                    name="JDBC_RecuperoCompAttributiAsset"
                    outputVariable="JDBC_RecuperoCompAttributiAsset"
                    tibex:xpdlId="dc00330b-58e3-4eaf-883c-8f165ff21fbc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_AssetNumTelFittRisorsa_DATIToJDBC_RecuperoAttributiAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_RecuperoAttributiAssetToLOG_RecuperoAttributiAsset"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dc00330b-58e3-4eaf-883c-8f165ff21fbc+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_RecuperoCompAttributiAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:ConsistenzaDati_In/tns:IdAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:ConsistenzaDati_In/tns:IdAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDASSET>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT att.DTTGLSST_TTRBTIDTTGLISST_BDSID, dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO &#xa;FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID and&#xa;&#x9;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xa;&#x9;ass.IDASSET = ?&#xa;ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>
                                    <columnMetadata
                                    columnName="DTTGLSST_TTRBTIDTTGLISST_BDSID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Map_RecuperoAttributiAsset-input"
                    name="Map_RecuperoAttributiAsset"
                    outputVariable="Map_RecuperoAttributiAsset"
                    tibex:xpdlId="27ed88be-2c41-48a2-a70a-c26dfd05e8ce" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMap_RecuperoAttributiAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Map_RecuperoAttributiAssetToCopy_2_LogInput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_RecuperoCompAttributiAsset&quot;/>&lt;xsl:param name=&quot;Select_AssetNumTelFittRisorsa_FONIA&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Select_AssetNumTelFittRisorsa_DATI&quot;/>&lt;xsl:template name=&quot;Map_RecuperoAttributiAsset-input&quot; match=&quot;/&quot;>&lt;tns:RecuperoAttributiAssetResponse>&lt;tns:ConsistenzaFonia_Out>&lt;xsl:if test=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/NUMEROTELEFONICO&quot;>&lt;tns:NumeroTelefonico>&lt;xsl:value-of select=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/NUMEROTELEFONICO&quot;/>&lt;/tns:NumeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/NUMEROFITTIZIO&quot;>&lt;tns:NumeroFittizio>&lt;xsl:value-of select=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/NUMEROFITTIZIO&quot;/>&lt;/tns:NumeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/IDRISORSA&quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/IDRISORSA&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/DISTRETTO&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/DISTRETTO&quot;/>&lt;/tns:Distretto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$Select_AssetNumTelFittRisorsa_FONIA/Record[1]/CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/tns:ConsistenzaFonia_Out>&lt;tns:ConsistenzaDati_Out>&lt;xsl:variable name=&quot;IDAttribOpz&qu