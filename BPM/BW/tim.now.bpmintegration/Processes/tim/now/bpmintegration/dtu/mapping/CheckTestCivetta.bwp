            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns2:jdbcQueryActivityInput"
            name="PARAMETRI_CFGZ_NOW-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:resultSet" name="PARAMETRI_CFGZ_NOW" sca-bpel:internal="true"/>
        <bpws:variable name="TimeoutJDBC" sca-bpel:hotUpdate="false"
