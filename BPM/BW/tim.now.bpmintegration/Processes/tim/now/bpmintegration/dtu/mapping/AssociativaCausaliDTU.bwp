            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SQLSelect"
                    name="AssignStatement_ASS_EVENTO_DTU_CAUS_OLO"
                    outputVariable="SQLSelect"
                    tibex:xpdlId="9089e9e9-8620-437f-b201-7da758f01c0f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSottofamiglia_lavorazioneToAssignStatement_ASS_EVENTO_DTU_CAUS_OLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignStatement_ASS_EVENTO_DTU_CAUS_OLOToLogStatement"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(&#xd;&#xa;&#x9;($Start/ns0:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $Start/ns0:CausaleEsito = &quot;025&quot; and &#xd;&#xa;&#x9;&#x9;($Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESO&quot; or&#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;ACCODATO&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOOPERESPECIALI&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOATTESAPERMESSI&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;INACCETTAZIONEPREVENTIVO&quot;))&#xd;&#xa;&#x9;and exists($Start/ns0:IdAnagraficaCausalePrec)&#xd;&#xa;&#x9;and string-length($Start/ns0:GestioneAutonoma) > 0)&#xd;&#xa;then concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASS_EVENTO_DTU_CAUS_OLO&#x9;WHERE IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' AND ID_SOTTOFAMIG_OFFERTA = '&quot;, string(xsd:int($Sel_SOTTO_FAMIG_OFFERTA/Record[1]/ID_SOTTOFAMIG_OFFERTA)), &quot;' AND IDTPLG_LAVRZ = '&quot;,string(xsd:int($Sel_TIPOLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)), &quot;' AND GESTIONEAUTONOMA = '&quot;, string($Start/ns0:GestioneAutonoma), &quot;' AND SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID AND (TIPOLOG_TIMEOUT = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR TIPOLOG_TIMEOUT IS NULL)&quot;)&#xd;&#xa;else if(&#xd;&#xa;&#x9;($Start/ns0:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $Start/ns0:CausaleEsito = &quot;025&quot; and &#xd;&#xa;&#x9;&#x9;($Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESO&quot; or&#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;ACCODATO&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOOPERESPECIALI&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOATTESAPERMESSI&quot; or &#xd;&#xa;&#x9;&#x9; $Start/ns0:StatoRichiestaNOWprec = &quot;INACCETTAZIONEPREVENTIVO&quot; or $Start/ns0:StatoRichiestaNOW = ('INANNULLAMENTOSUDTUPEROF','INANNULLAMENTOSUDTUPERKOOF','INANNULLAMENTOSUDTUPERANNULLAMENTOOKOF')))&#xd;&#xa;&#x9;and exists($Start/ns0:IdAnagraficaCausalePrec)&#xd;&#xa;&#x9;and string-length($Start/ns0:GestioneAutonoma) = 0)&#xd;&#xa;then&#xd;&#xa;concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASS_EVENTO_DTU_CAUS_OLO&#x9;WHERE IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' AND ID_SOTTOFAMIG_OFFERTA = '&quot;, string(xsd:int($Sel_SOTTO_FAMIG_OFFERTA/Record[1]/ID_SOTTOFAMIG_OFFERTA)), &quot;' AND IDTPLG_LAVRZ = '&quot;,string(xsd:int($Sel_TIPOLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)), &quot;' AND GESTIONEAUTONOMA IS NULL AND SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID AND (TIPOLOG_TIMEOUT = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR TIPOLOG_TIMEOUT IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else if($Start/ns0:Evento = &quot;NI_PRESA_APPUNTAMENTO&quot; and $Start/ns0:CausaleEsito = (&quot;V1&quot;,&quot;V2&quot;,&quot;V3&quot;,&quot;V6&quot;,&quot;V7&quot;,&quot;V8&quot;,&quot;V9&quot;,&quot;V10&quot;,&quot;V11&quot;,&quot;V12&quot;,&quot;V14&quot;) and ($Start/ns0:StatoRichiestaNOW = &quot;SOSPESOD82&quot; or $Start/ns0:StatoRichiestaNOW = &quot;SOSPESOACD82&quot;) and string-length(string($Start/ns0:IdAnagraficaCausalePrec))>0)&#xd;&#xa;then&#xd;&#xa;concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASS_EVENTO_DTU_CAUS_OLO&#x9;WHERE IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND (ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec),  &quot;') AND ID_SOTTOFAMIG_OFFERTA = '&quot;, string(xsd:int($Sel_SOTTO_FAMIG_OFFERTA/Record[1]/ID_SOTTOFAMIG_OFFERTA)), &quot;' AND IDTPLG_LAVRZ = '&quot;,string(xsd:int($Sel_TIPOLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)), &quot;' AND GESTIONEAUTONOMA IS NULL AND SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID AND (TIPOLOG_TIMEOUT = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR TIPOLOG_TIMEOUT IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else if(string-length($Start/ns0:GestioneAutonoma) > 0)&#xd;&#xa;then&#xd;&#xa;concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASS_EVENTO_DTU_CAUS_OLO&#x9;WHERE IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND (ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec),  &quot;' OR ID_ANAG_CAUS_PREC IS NULL) AND ID_SOTTOFAMIG_OFFERTA = '&quot;, string(xsd:int($Sel_SOTTO_FAMIG_OFFERTA/Record[1]/ID_SOTTOFAMIG_OFFERTA)), &quot;' AND IDTPLG_LAVRZ = '&quot;,string(xsd:int($Sel_TIPOLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)), &quot;' AND GESTIONEAUTONOMA = '&quot;, string($Start/ns0:GestioneAutonoma), &quot;'AND SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID AND (TIPOLOG_TIMEOUT = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR TIPOLOG_TIMEOUT IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else&#xd;&#xa;concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASS_EVENTO_DTU_CAUS_OLO&#x9;WHERE IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND (ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec),  &quot;' OR ID_ANAG_CAUS_PREC IS NULL) AND ID_SOTTOFAMIG_OFFERTA = '&quot;, string(xsd:int($Sel_SOTTO_FAMIG_OFFERTA/Record[1]/ID_SOTTOFAMIG_OFFERTA)), &quot;' AND IDTPLG_LAVRZ = '&quot;,string(xsd:int($Sel_TIPOLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)), &quot;' AND GESTIONEAUTONOMA IS NULL AND SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID AND (TIPOLOG_TIMEOUT = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR TIPOLOG_TIMEOUT IS NULL)&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="SQLSelect" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Sel_SOTTO_FAMIG_OFFERTA-input"
                    name="Sel_SOTTO_FAMIG_OFFERTA"
