                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(($Start/ns0:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $Start/ns0:CausaleEsito = &quot;025&quot; and ($Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESO&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;ACCODATO&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOOPERESPECIALI&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOATTESAPERMESSI&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;INACCETTAZIONEPREVENTIVO&quot;))&#xd;&#xa;and exists($Start/ns0:IdAnagraficaCausalePrec) and string-length($Start/ns0:GestioneAutonoma) > 0)&#xd;&#xa;then concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASSOCIATIVA_CAUS_DTU&#x9;WHERE COD_MACCHINA_STATI_DTU = '&quot;, $Start/ns0:CodiceMacchinaStatiDTU, &quot;' AND IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' AND GESTIONEAUTONOMA = '&quot;, string($Start/ns0:GestioneAutonoma), &quot;' AND (FONTE_ANNULLAMENTO = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR FONTE_ANNULLAMENTO IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else if(($Start/ns0:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $Start/ns0:CausaleEsito = &quot;025&quot; and ($Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESO&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;ACCODATO&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOOPERESPECIALI&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;SOSPESOATTESAPERMESSI&quot; or $Start/ns0:StatoRichiestaNOWprec = &quot;INACCETTAZIONEPREVENTIVO&quot;))&#xd;&#xa;and exists($Start/ns0:IdAnagraficaCausalePrec) and string-length($Start/ns0:GestioneAutonoma) = 0)&#xd;&#xa;then concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASSOCIATIVA_CAUS_DTU&#x9;WHERE COD_MACCHINA_STATI_DTU = '&quot;, $Start/ns0:CodiceMacchinaStatiDTU, &quot;' AND IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' AND GESTIONEAUTONOMA IS NULL AND (FONTE_ANNULLAMENTO = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR FONTE_ANNULLAMENTO IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else if(string-length($Start/ns0:GestioneAutonoma) > 0)&#xd;&#xa;then concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASSOCIATIVA_CAUS_DTU&#x9;WHERE COD_MACCHINA_STATI_DTU = '&quot;, $Start/ns0:CodiceMacchinaStatiDTU, &quot;' AND IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND (ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' OR ID_ANAG_CAUS_PREC IS NULL) AND GESTIONEAUTONOMA = '&quot;, string($Start/ns0:GestioneAutonoma), &quot;'AND (FONTE_ANNULLAMENTO = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR FONTE_ANNULLAMENTO IS NULL)&quot;)&#xd;&#xa;&#xd;&#xa;else concat(&quot;SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_OP_SPEC FROM ASSOCIATIVA_CAUS_DTU&#x9;WHERE COD_MACCHINA_STATI_DTU = '&quot;, $Start/ns0:CodiceMacchinaStatiDTU, &quot;' AND IDTPLG_ESITO_DTU = '&quot;, string($Start/ns0:IdTipologiaEsitoDTU), &quot;' AND (ID_ANAG_CAUS_PREC = '&quot;, string($Start/ns0:IdAnagraficaCausalePrec), &quot;' OR ID_ANAG_CAUS_PREC IS NULL) AND GESTIONEAUTONOMA IS NULL AND (FONTE_ANNULLAMENTO = '&quot;, $Start/ns0:FonteAnnullamento, &quot;' OR FONTE_ANNULLAMENTO IS NULL)&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
