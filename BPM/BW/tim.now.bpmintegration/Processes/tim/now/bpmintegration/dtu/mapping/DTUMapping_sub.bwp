/>&#xa;                                                    &lt;/ns:BANDA_COS3_UP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP5_MAX&quot;>&#xa;                                                    &lt;ns:BANDA_COS5_UP>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP5_MAX&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS5_UP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP6_MAX&quot;>&#xa;                                                    &lt;ns:BANDA_COS6_UP>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP6_MAX&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS6_UP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD' and string-length(string($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:PROFILO)) > 0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:PROFILO_OLD&quot;>&#xa;                                                    &lt;ns:PROFILO_BMD_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:PROFILO_OLD&quot;/>&#xa;                                                    &lt;/ns:PROFILO_BMD_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP2_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS2_DOWN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP2_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS2_DOWN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS3_DOWN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS3_DOWN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP5_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS5_DOWN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OL