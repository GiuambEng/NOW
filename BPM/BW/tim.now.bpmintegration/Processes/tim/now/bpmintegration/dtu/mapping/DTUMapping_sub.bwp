REA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld)))&amp;#x9;and not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld)) and not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea=('1','2','3') and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea)))&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroArea&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroArea&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea=('0') or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea))) and (exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm)) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea))) and not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:NomeMacroAreaComm))&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVLANGBE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='1'&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))) and  exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld)&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:SuperMacroArea=('1') and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea)))&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:NomeMacroArea&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:NomeMacroArea&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVLANVULA' or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;>&lt;ns:NOMEMACROAREA_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;/>&lt;/ns:NOMEMACROAREA_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:UserVlan1Tagging_OLD&quot;>&lt;ns:TIPO_USERVLAN_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:UserVlan1Tagging_OLD&quot;/>&lt;/ns:TIPO_USERVLAN_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaRicarica)>0&quot;>&lt;ns:DATI_RICARICA>&lt;ns:TIPOLOGIA_RICARICA>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaRicarica&quot;/>&lt;/ns:TIPOLOGIA_RICARICA>&lt;ns:DATA_RIC_ESEC>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DataRicEsec&quot;/>&lt;/ns:DATA_RIC_ESEC>&lt;ns:ORA_RIC_ESEC>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OraRicEsec&quot;/>&lt;/ns:ORA_RIC_ESEC>&lt;/ns:DATI_RICARICA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloDnsParentalControl&quot;>&lt;ns:PROFILO_DNS_PARENTAL_CONTROL>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloDnsParentalControl&quot;/>&lt;/ns:PROFILO_DNS_PARENTAL_CONTROL>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:DATI_VARIAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneDinamica = 'Y'&quot;>&lt;ns:DINAMICO>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns:DINAMICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterPrimario&quot;>&lt;ns:CODICE_SPLITTER_PRIMARIO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterPrimario&quot;/>&lt;/ns:CODICE_SPLITTER_PRIMARIO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterSecondario&quot;>&lt;ns:CODICE_SPLITTER_SECONDARIO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterSecondario&quot;/>&lt;/ns:CODICE_SPLITTER_SECONDARIO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceROE&quot;>&lt;ns:CODICE_ROE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceROE&quot;/>&lt;/ns:CODICE_ROE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:PosizioneMorsettieraROE&quot;>&lt;ns:POSIZIONE_MORSETTIERA_ROE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:PosizioneMorsettieraROE&quot;/>&lt;/ns:POSIZIONE_MORSETTIERA_ROE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 1, 1) !='U'&quot;>&lt;ns:ID_RISORSA_ISDN>&lt;xsl:value-of select=&quot;(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 13)))&quot;/>&lt;/ns:ID_RISORSA_ISDN>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&lt;xsl:if test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN)&quot;>&lt;ns:ID_RISORSA_ISDN>&lt;xsl:value-of select=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN)&quot;/>&lt;/ns:ID_RISORSA_ISDN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN&quot;>&lt;ns:ID_RISORSA_ISDN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN&quot;/>&lt;/ns:ID_RISORSA_ISDN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;count($Progetto/Record) > 0 &amp;#xD;&amp;#xA;and (($Start/ndm:Lavorazione='ATTIVAZIONE' or ($Start/ndm:Lavorazione='MIGRAZIONE' and count($Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'CONSISTENZA')]) > 0)) &amp;#xD;&amp;#xA;and (($Start/ndm:FlagNaked='S' and $Start/ndm:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB')) &amp;#xD;&amp;#xA;or $Start/ndm:Offerta = ('BITSTREAMNGAFTTH','VULAFTTH','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH','EASYIPNGAFTTCAB','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','UBBSEMIGPON'))) or ($Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR'))&quot;>&lt;ns:ONE_STEP>&lt;xsl:value-of select=&quot;$FlagOneStep&quot;/>&lt;/ns:ONE_STEP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Lavorazione = ('ATTIVAZIONE','MIGRAZIONE') and not(starts-with($Start/ndm:Offerta, 'EASYIP'))&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Qualifica&quot;>&lt;ns:QUALIFICA>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Qualifica&quot;/>&lt;/ns:QUALIFICA>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB') and $Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagOneStep='SI' and upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)='LINEANONFONIA'&quot;>&lt;ns:TEST2>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns:TEST2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Test2&quot;>&lt;ns:TEST2>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Test2&quot;/>&lt;/ns:TEST2>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;>&lt;ns:CODICE_LOTTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;/>&lt;/ns:CODICE_LOTTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaVlan&quot;>&lt;ns:TIPOLOGIA_VLAN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaVlan&quot;/>&lt;/ns:TIPOLOGIA_VLAN>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='VLAN'&quot;>&lt;xsl:if test=&quot;$AnagGBE/Record[1]/DESCRIZIONE_CLLI&quot;>&lt;ns:DESC_CLE_ATT>&lt;xsl:value-of select=&quot;$AnagGBE/Record[1]/DESCRIZIONE_CLLI&quot;/>&lt;/ns:DESC_CLE_ATT>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta=('FEEDER','CANALE')&quot;>&lt;xsl:if test=&quot;$AnagPDC/Record[1]/DESCRIZIONE_CLLI_PDC&quot;>&lt;ns:DESC_CLE_ATT>&lt;xsl:value-of select=&quot;$AnagPDC/Record[1]/DESCRIZIONE_CLLI_PDC&quot;/>&lt;/ns:DESC_CLE_ATT>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$AnagNGA/Record[1]/NOME_CENTRALE&quot;>&lt;ns:DESC_CLE_ATT>&lt;xsl:value-of select=&quot;$AnagNGA/Record[1]/NOME_CENTRALE&quot;/>&lt;/ns:DESC_CLE_ATT>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl