                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;CalcolaCaratteristicaVlan-input&quot; match=&quot;/&quot;>&lt;ndm:CalcolaCaratteristicaVlanRequest>&lt;ndm:IdRichiesta>&lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&lt;/ndm:IdRichiesta>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN[not(tns:AZIONE='D')]&quot;>&lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&lt;ndm:SvlanCode>&lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&lt;/ndm:SvlanCode>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/ndm:CalcolaCaratteristicaVlanRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.bpmintegration.dtu.mapping.CalcolaCaratteristicaVlan" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDati-input"
                                    name="LogDati"
                                    tibex:xpdlId="98bb037f-4fe6-45b2-8ebb-5ccb96500fa3"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignDatiToCopy_1_LogOut"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_LogOutToEndCiclo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ServizioDati&quot;/>&lt;xsl:template name=&quot;LogDati-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;tns1:Message>&lt;xsl:value-of select=&quot;&amp;quot;Nel loop AssignDati&amp;quot;&quot;/>&lt;/tns1:Message>&lt;tns1:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;***ASSIGNDATI: &amp;quot;, tib:render-xml($ServizioDati, true(), true()))&quot;/>&lt;/tns1:Payload>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOut-input"
                    name="LogOut"
                    tibex:xpdlId="4b415bce-2138-4379-9726-d94f07c26932"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CreaAggregati-Fonia_DatiToLogOut"/>
                        <bpws:target linkName="AssignDatiCessaNoAccessoToLogOut"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOutToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ServizioDati&quot;/>&#xa;    &lt;xsl:param name=&quot;ServizioFonia&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Fine del processo di mapping e arricchimento vs DTU&amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;***FONIA: &amp;quot;, if(exists($ServizioFonia)) then tib:render-xml($ServizioFonia, true(), true()) else &amp;quot;null&amp;quot;, &amp;quot;&amp;#xD;&amp;#xA;&amp;quot;, &amp;quot;***DATI: &amp;quot;, if(exists($ServizioDati)) then tib:render-xml($ServizioDati, true(), true()) else &amp;quot;null&amp;quot;)&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogIn-input"
                    name="LogIn"
                    tibex:xpdlId="f4d71144-1112-439b-8527-27fdec4e1944"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogIn"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInToOscuramento"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIn-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Avvio del processo di mapping e arricchimento vs DTU&amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ServizioDati"
                    name="AssignDatiCessaNoAccesso"
                    outputVariable="ServizioDati"
                    tibex:xpdlId="5cf6fb82-7be1-4bce-aaee-6302ab094e3e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelOffertaDTUToAssignDatiCessaNoAccesso"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignDatiCessaNoAccessoToLogOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelOffertaDTU&quot;/>&lt;xsl:param name=&quot;ServizioDati&quot;/>&lt;xsl:template name=&quot;ServizioDati&quot; match=&quot;/&quot;>&lt;ndm:SERVIZIO_DATI>&lt;ns:SERVIZIO_DATI>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;DIS&amp;quot;&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;$SelOffertaDTU/Record[1]/NOME_OFFERTA_DTU&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelOffertaDTU/Record[1]/NOME_OFFERTA_DTU = &amp;quot;BSFTTCNGA&amp;quot; or &amp;#xD;&amp;#xA;$SelOffertaDTU/Record[1]/NOME_OFFERTA_DTU = &amp;quot;BSFTTHNGA&amp;quot; or &amp;#xD;&amp;#xA;$SelOffertaDTU/Record[1]/NOME_OFFERTA_DTU = &amp;quot;BSFTTCVULA&amp;quot; or &amp;#xD;&amp;#xA;$SelOffertaDTU/Record[1]/NOME_OFFERTA_DTU = &amp;quot;BSFTTHVULA&amp;quot;&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;ETH&amp;quot;&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;ATM&amp;quot;&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ID_VLAN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:ID_VLAN>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:VP_VLAN>&lt;ns:PROFILO_COMM>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:PROFILO_COMM>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;&amp;quot;UNTAGGED&amp;quot;&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;ns:TIPO_VLAN>&lt;xsl:value-of select=&quot;&amp;quot;QINQ&amp;quot;&quot;/>&lt;/ns:TIPO_VLAN>&lt;ns:TIPOLOGIA_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;NAKED&amp;quot;&quot;/>&lt;/ns:TIPOLOGIA_SERVIZIO>&lt;ns:FL_NEW_MODEL_VULA>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:FL_NEW_MODEL_VULA>&lt;/ns:SERVIZIO_DATI>&lt;xsl:for-each select=&quot;$ServizioDati/ns:SERVIZIO_DATI&quot;>&lt;ns:SERVIZIO_DATI>&lt;xsl:if test=&quot;ns:ID_IMPIANTO&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;ns:ID_IMPIANTO&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;ns:DETTAGLIO_LAVORAZIONE&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;ns:SERVIZIO_RICHIESTO&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;xsl:if test=&quot;ns:FLAG_MONITORAGGIO&quot;>&lt;ns:FLAG_MONITORAGGIO>&lt;xsl:value-of select=&quot;ns:FLAG_MONITORAGGIO&quot;/>&lt;/ns:FLAG_MONITORAGGIO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:CLLI_OLT&quot;>&lt;ns:CLLI_OLT>&lt;xsl:value-of select=&quot;ns:CLLI_OLT&quot;/>&lt;/ns:CLLI_OLT>&lt;/xsl:if>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;xsl:if test=&quot;ns:INTERFACCIA_PC&quot;>&lt;ns:INTERFACCIA_PC>&lt;xsl:value-of select=&quot;ns:INTERFACCIA_PC&quot;/>&lt;/ns:INTERFACCIA_PC>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TECNOLOGIA_MODEM&quot;>&lt;ns:TECNOLOGIA_MODEM>&lt;xsl:value-of select=&quot;ns:TECNOLOGIA_MODEM&quot;/>&lt;/ns:TECNOLOGIA_MODEM>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:BANDA_TD&quot;>&lt;ns:BANDA_TD>&lt;xsl:value-of select=&quot;ns:BANDA_TD&quot;/>&lt;/ns:BANDA_TD>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:CHANNEL_TYPE&quot;>&lt;ns:CHANNEL_TYPE>&lt;xsl:value-of select=&quot;ns:CHANNEL_TYPE&quot;/>&lt;/ns:CHANNEL_TYPE>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TD_OLO&quot;>&lt;ns:TD_OLO>&lt;xsl:value-of select=&quot;ns:TD_OLO&quot;/>&lt;/ns:TD_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TIPO_INTERFACCIA&quot;>&lt;ns:TIPO_INTERFACCIA>&lt;xsl:value-of select=&quot;ns:TIPO_INTERFACCIA&quot;/>&lt;/ns:TIPO_INTERFACCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:MODALITA_ACCESSO&quot;>&lt;ns:MODALITA_ACCESSO>&lt;xsl:value-of select=&quot;ns:MODALITA_ACCESSO&quot;/>&lt;/ns:MODALITA_ACCESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:REALM&quot;>&lt;ns:REALM>&lt;xsl:value-of select=&quot;ns:REALM&quot;/>&lt;/ns:REALM>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TIPO_LMI&quot;>&lt;ns:TIPO_LMI>&lt;xsl:value-of select=&quot;ns:TIPO_LMI&quot;/>&lt;/ns:TIPO_LMI>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:VEL_ACC_DOWN&quot;>&lt;ns:VEL_ACC_DOWN>&lt;xsl:value-of select=&quot;ns:VEL_ACC_DOWN&quot;/>&lt;/ns:VEL_ACC_DOWN>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:VEL_ACC_UP&quot;>&lt;ns:VEL_ACC_UP>&lt;xsl:value-of select=&quot;ns:VEL_ACC_UP&quot;/>&lt;/ns:VEL_ACC_UP>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:AGG_DOWN_MIN&quot;>&lt;ns:AGG_DOWN_MIN>&lt;xsl:value-of select=&quot;ns:AGG_DOWN_MIN&quot;/>&lt;/ns:AGG_DOWN_MIN>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:AGG_DOWN_MAX&quot;>&lt;ns:AGG_DOWN_MAX>&lt;xsl:value-of select=&quot;ns:AGG_DOWN_MAX&quot;/>&lt;/ns:AGG_DOWN_MAX>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:AGG_UP_MIN&quot;>&lt;ns:AGG_UP_MIN>&lt;xsl:value-of select=&quot;ns:AGG_UP_MIN&quot;/>&lt;/ns:AGG_UP_MIN>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:AGG_UP_MAX&quot;>&lt;ns:AGG_UP_MAX>&lt;xsl:value-of select=&quot;ns:AGG_UP_MAX&quot;/>&lt;/ns:AGG_UP_MAX>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:ISDN&quot;>&lt;ns:ISDN>&lt;xsl:value-of select=&quot;ns:ISDN&quot;/>&lt;/ns:ISDN>&lt;/xsl:if>&lt;ns:ID_VLAN>&lt;xsl:value-of select=&quot;ns:ID_VLAN&quot;/>&lt;/ns:ID_VLAN>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;ns:VP_VLAN&quot;/>&lt;/ns:VP_VLAN>&lt;ns:PROFILO_COMM>&lt;xsl:value-of select=&quot;ns:PROFILO_COMM&quot;/>&lt;/ns:PROFILO_COMM>&lt;xsl:if test=&quot;ns:TIPO_USERVLAN&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;ns:TIPO_USERVLAN&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TIPO_ACCESSO&quot;>&lt;ns:TIPO_ACCESSO>&lt;xsl:value-of select=&quot;ns:TIPO_ACCESSO&quot;/>&lt;/ns:TIPO_ACCESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TIPO_VLAN&quot;>&lt;ns:TIPO_VLAN>&lt;xsl:value-of select=&quot;ns:TIPO_VLAN&quot;/>&lt;/ns:TIPO_VLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:TIPO_TRASPORTO&quot;>&lt;ns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;ns:TIPO_TRASPORTO&quot;/>&lt;/ns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;ns:TIPOLOGIA_SERVIZIO>&lt;xsl:value-of select=&quot;ns:TIPOLOGIA_SERVIZIO&quot;/>&lt;/ns:TIPOLOGIA_SERVIZIO>&lt;xsl:if test=&quot;ns:FL_NEW_MODEL_VULA&quot;>&lt;ns:FL_NEW_MODEL_VULA>&lt;xsl:value-of select=&quot;ns:FL_NEW_MODEL_VULA&quot;/>&lt;/ns:FL_NEW_MODEL_VULA>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:ID_ODR&quot;>&lt;ns:ID_ODR>&lt;xsl:value-of select=&quot;ns:ID_ODR&quot;/>&lt;/ns:ID_ODR>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:CODICETT&quot;>&lt;ns:CODICETT>&lt;xsl:value-of select=&quot;ns:CODICETT&quot;/>&lt;/ns:CODICETT>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;ns:VIRT_CHAN&quot;/>&lt;xsl:copy-of select=&quot;ns:USER_VLAN&quot;/>&lt;xsl:copy-of select=&quot;ns:ACCIP&quot;/>&lt;xsl:copy-of select=&quot;ns:PRODOTTO&quot;/>&lt;xsl:copy-of select=&quot;ns:DATI_VARIAZIONE&quot;/>&lt;/ns:SERVIZIO_DATI>&lt;/xsl:for-each>&lt;/ndm:SERVIZIO_DATI>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ServizioDati" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelOffertaDTU-input"
                    name="SelOffertaDTU" outputVariable="SelOffertaDTU"
                    tibex:xpdlId="97a8f285-53eb-4b04-8d9a-570b767aade6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CreaAggregati-Fonia_DatiToSelOffertaDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelOffertaDTUToAssignDatiCessaNoAccesso"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97a8f285-53eb-4b04-8d9a-570b767aade6+input&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SelOffertaDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ndm:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TD.DESCR AS NOME_OFFERTA_DTU&#xd;&#xa;&#x9;FROM TRASCODFC_OFFERTA TR, OFFERTA O, TIPOLG_OFFERTA_DTU TD&#xd;&#xa;&#x9;WHERE TD.ID_NOME_OFFERTA_DTU = O.ID_NOME_OFFERTA_DTU&#xd;&#xa;&#x9;&#x9;AND O.ID_OFFERTA = TR.ID_OFFERTA&#xd;&#xa;&#x9;&#x9;AND TR.NOME_OFFERTA_ESTERNA = ?&#xd;&#xa;&#x9;&#x9;AND TR.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="StrutturaRichiesta"
                    name="Assign_InitialStruttura"
                    outputVariable="StrutturaRichiesta"
                    tibex:xpdlId="935e8a2c-59c9-4ca3-83f5-8d96890ba395" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToAssign_InitialStruttura"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign_InitialStrutturaToCopy_1_LogStruttura"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="$Start/ns1:StrutturaRichiesta" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="StrutturaRichiesta" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogInitialStruttura-input"
                    name="LogInitialStruttura"
                    tibex:xpdlId="f9cb4c4f-8667-4c1b-951f-fc8ec725d23a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign_InitialStrutturaToCopy_1_LogStruttura"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_LogStrutturaToCreaAggregati-Fonia_Dati">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInitialStrutturaToProgetto_OneStep">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(($Start/ns1:Lavorazione='ATTIVAZIONE' or ($Start/ns1:Lavorazione='MIGRAZIONE' and count($Start/ns1:Fonia_Dati[starts-with(ns1:NomeComponente, 'CONSISTENZA')]) > 0)) &#xd;&#xa;and (($Start/ns1:FlagNaked='S' and $Start/ns1:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB')) &#xd;&#xa;or $Start/ns1:Offerta = ('BITSTREAMNGAFTTH','VULAFTTH','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH','EASYIPNGAFTTCAB','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE'))) or ($Start/ns1:Lavorazione='ATTIVAZIONE' and $Start/ns1:Offerta=('UBBSEMIGPON','UBBFULLGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(($Start/ns1:Lavorazione='ATTIVAZIONE' or ($Start/ns1:Lavorazione='MIGRAZIONE' and count($Start/ns1:Fonia_Dati[starts-with(ns1:NomeComponente, 'CONSISTENZA')]) > 0)) and (($Start/ns1:FlagNaked='S' and $Start/ns1:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB')) or $Start/ns1:Offerta = ('BITSTREAMNGAFTTH','VULAFTTH','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH','EASYIPNGAFTTCAB','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE'))) or ($Start/ns1:Lavorazione='ATTIVAZIONE' and $Start/ns1:Offerta=('UBBSEMIGPON','UBBFULLGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR'))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInitialStruttura-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Struttura Richiesta iniziale in input: &amp;quot;, $Start/ndm:StrutturaRichiesta)&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Progetto-input"
                    name="Progetto" outputVariable="Progetto"
                    tibex:xpdlId="65ab79cb-bd81-4dcf-917b-94da6bbcbe3b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInitialStrutturaToProgetto_OneStep"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProgettoToAssignOneStep"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+65ab79cb-bd81-4dcf-917b-94da6bbcbe3b+input&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Progetto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CodiceProgetto>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ndm:CodiceProgetto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:CodiceProgetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceProgetto>&#xa;            &lt;CodfcOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$Start/ndm:CodiceOLO_AGCOM&quot;/>&#xa;            &lt;/CodfcOloAgcom>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.ONESTEP&#xd;&#xa;FROM PRGT P, OLO O&#xd;&#xa;WHERE P.COD_PRGT = ?&#xd;&#xa;&#x9;AND P.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM&#xd;&#xa;&#x9;AND O.COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceProgetto"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodfcOloAgcom"/>
                                    <columnMetadata
                                    columnName="ONESTEP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="FlagOneStep"
                    name="AssignOneStep" outputVariable="FlagOneStep"
                    tibex:xpdlId="c296981f-12e2-4d69-b1b8-c08f1990f1bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ProgettoToAssignOneStep"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignOneStepToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if($Progetto/Record[1]/ONESTEP='SI') then 'SI' else 'NO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="FlagOneStep" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOneStep-input"
                    name="LogOneStep"
                    tibex:xpdlId="01c82a2b-eb59-4dfd-9826-762126586a98"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignOneStepToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOneStepToCreaAggregati-Fonia_Dati"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOneStep&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOneStep-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Flag OneStep : &amp;quot;, $FlagOneStep)&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="d0a97a17-b212-4a45-a55a-93b965b50602" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInToOscuramento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToAssign_InitialStruttura"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0a97a17-b212-4a45-a55a-93b965b50602+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_AGESP from OSCURAMENTO_AGESP WHERE COD_AGESP in ('T1PRJ0002889') AND FLAG_OSCURMENTO in ('Y','1')" xsi:type="jdbcPalette:JDBCQueryActivity">
