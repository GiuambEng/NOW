                                    name="AssignDati"
                                    outputVariable="ServizioDati"
                                    tibex:xpdlId="fcfd515e-4b2b-407d-afd4-30535cae3ccc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapValori_OLDToAssignDati"/>
