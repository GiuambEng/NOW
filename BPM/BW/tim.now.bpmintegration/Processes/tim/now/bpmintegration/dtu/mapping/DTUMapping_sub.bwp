taDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&lt;ns:AGG_DOWN_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX))*xsd:int(1024))&quot;/>&lt;/ns:AGG_DOWN_MAX>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_DOWN_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX))*xsd:int(1000))&quot;/>&lt;/ns:AGG_DOWN_MAX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_DOWN_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX)))&quot;/>&lt;/ns:AGG_DOWN_MAX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea) and string-length(string($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN)) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&lt;ns:AGG_UP_MIN>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN))*xsd:int(1024))&quot;/>&lt;/ns:AGG_UP_MIN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_UP_MIN>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN))*xsd:int(1000))&quot;/>&lt;/ns:AGG_UP_MIN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_UP_MIN>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN)))&quot;/>&lt;/ns:AGG_UP_MIN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea) and  string-length(string($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX)) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&lt;ns:AGG_UP_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX))*xsd:int(1024))&quot;/>&lt;/ns:AGG_UP_MAX>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_UP_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX))*xsd:int(1000))&quot;/>&lt;/ns:AGG_UP_MAX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AGG_UP_MAX>&lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX)))&quot;/>&lt;/ns:AGG_UP_MAX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)), 'ISDN') or &amp;#xD;&amp;#xA;upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)) ='LINEANONFONIA'&quot;>&lt;ns:ISDN>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns:ISDN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ISDN>&lt;xsl:value-of select=&quot;'NO'&quot;/>&lt;/ns:ISDN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ID_VLAN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdVlanOlo&quot;/>&lt;/ns:ID_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN') or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta=('FIBERSTREAM')&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta=('FWAITALIA1GIGASARDEGNA')&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;'001'&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Enrich/output/tns:DTUEnrichmentResponse/tns:Dati) > 0 and string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:Dati[1]/tns:MACRO_AREA) > 0&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:Dati[1]/tns:MACRO_AREA&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Enrich/output/tns:DTUEnrichmentResponse/tns:Dati) > 0 and string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:Dati[1]/tns:COD_AREA_RACCOLTA) > 0&quot;>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:Dati[1]/tns:COD_AREA_RACCOLTA&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:VP_VLAN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:VP_VLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea) and string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA) > 0 and $Start/ndm:Offerta!=('FEEDER','CANALE')&quot;>&lt;ns:PROFILO_COMM>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA&quot;/>&lt;/ns:PROFILO_COMM>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FWAITALIA1GIGASARDEGNA'&quot;>&lt;ns:PROFILO_COMM>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/ns:PROFILO_COMM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:PROFILO_COMM>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:PROFILO_COMM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $DettaglioLavorazione = 'DIS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMSIMMETRICO') or $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT') or ($Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA')&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;&amp;quot;TAGGED&amp;quot;&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;($Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA'  or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'EASYIP-FTTC' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'EASYIP-FTTH') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging) > 0&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging)&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;'UNTAGGED'&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ndm:Offerta,'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Offerta,'BITSTREAMATMSIMMETRICO') or $Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')or $Start/ndm:Offerta=('FIBERSTREAM')&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT' or $Start/ndm:Offerta=('FWAITALIA1GIGASARDEGNA')&quot;>&lt;ns:TIPO_USERVLAN>&lt;xsl:value-of select=&quot;&amp;quot;TAGGED&amp;quot;&quot;/>&lt;/ns:TIPO_USERVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;($Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:Off