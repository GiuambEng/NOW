                <bpws:link name="AssignDatiCessaNoAccessoToLogOut" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="SelOffertaDTUToAssignDatiCessaNoAccesso" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="Assign_InitialStrutturaToCopy_1_LogStruttura" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="Copy_1_LogStrutturaToCreaAggregati-Fonia_Dati" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogInitialStrutturaToProgetto_OneStep"
                    tibex:label="OneStep" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ProgettoToAssignOneStep" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignOneStepToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOneStepToCreaAggregati-Fonia_Dati" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToLogIn" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInToOscuramento" tibex:linkType="SUCCESS"/>
                <bpws:link name="OscuramentoToAssign_InitialStruttura" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e41356c5-6865-45cc-aba9-c27c85d93ff9"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogIn"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="08420f8a-1c41-460a-b614-672d380d4088" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOutToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ServizioDati&quot;/>&lt;xsl:param name=&quot;ServizioFonia&quot;/>&lt;xsl:param name=&quot;EnrichAccesso&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;ndm:DTUMappingResponse>&lt;ndm:EnrichAccesso>&lt;xsl:if test=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:NomeOLO&quot;>&lt;ndm:NomeOLO>&lt;xsl:value-of select=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:NomeOLO&quot;/>&lt;/ndm:NomeOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:OffertaDTU&quot;>&lt;ndm:OffertaDTU>&lt;xsl:value-of select=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:OffertaDTU&quot;/>&lt;/ndm:OffertaDTU>&lt;/xsl:if>&lt;xsl:if test=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:ScenarioDTU&quot;>&lt;ndm:ScenarioDTU>&lt;xsl:value-of select=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:ScenarioDTU&quot;/>&lt;/ndm:ScenarioDTU>&lt;/xsl:if>&lt;xsl:if test=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU&quot;>&lt;ndm:SottoLavDTU>&lt;xsl:value-of select=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU&quot;/>&lt;/ndm:SottoLavDTU>&lt;/xsl:if>&lt;/ndm:EnrichAccesso>&lt;ndm:SERVIZIO_FONIA>&lt;xsl:copy-of select=&quot;$ServizioFonia/ns:SERVIZIO_FONIA&quot;/>&lt;/ndm:SERVIZIO_FONIA>&lt;ndm:SERVIZIO_DATI>&lt;xsl:copy-of select=&quot;$ServizioDati/ns:SERVIZIO_DATI&quot;/>&lt;/ndm:SERVIZIO_DATI>&lt;/ndm:DTUMappingResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="CreaAggregati-Fonia_Dati"
                tibex:group="while" tibex:xpdlId="d2dacca4-09b4-41e9-be7f-c45c1d34840a">
                <bpws:targets>
                    <bpws:target linkName="Copy_1_LogStrutturaToCreaAggregati-Fonia_Dati"/>
                    <bpws:target linkName="LogOneStepToCreaAggregati-Fonia_Dati"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CreaAggregati-Fonia_DatiToLogOut">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CreaAggregati-Fonia_DatiToSelOffertaDTU">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:Lavorazione = &quot;CESSAZIONE&quot; and not(exists($Start/ns1:Fonia_Dati[starts-with(ns1:NomeComponente, &quot;ACCESSO&quot;)])) and ($StrutturaRichiesta = &quot;NGA&quot; or $StrutturaRichiesta = &quot;XDSL&quot;) and not($Start/ns1:Offerta=('VLAN','VLANNGA','VLANVULA','VP'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:Lavorazione = "CESSAZIONE" and not(exists($Start/ns1:Fonia_Dati[starts-with(ns1:NomeComponente, "ACCESSO")])) and ($StrutturaRichiesta = "NGA" or $StrutturaRichiesta = "XDSL") and not($Start/ns1:Offerta=('VLAN','VLANNGA','VLANVULA','VP'))]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="7469317a-76c1-4203-9f90-5c4aaa561122"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Start/ns1:Fonia_Dati)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Start/ns1:Fonia_Dati)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign_EnrichAccessoToAssignFonia"
                                    tibex:label="REG_NP" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="AssignFoniaToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign_EnrichAccessoToMapValori_XDSLNGAFIBERSTREAM"
                                    tibex:label="XDSL_NGA_FIBERSTREAM" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="SelStrutturaRichToStrutturaRichiesta" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="StrutturaRichiestaToCopy_1_LogIn" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign_AzioneT"
                                    tibex:label="Azione = T" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogAzioneTToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapValori_OLDToAssignDati" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Copy_1_LogInToEnrich" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EnrichToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssignToCopy_1_LogStruttura" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LOG_DettLavorazioneToAssign_EnrichAccesso" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="EmptyToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToSelStrutturaRich_INVIODTUNULLorY"
                                    tibex:label="INVIO_DTU NULL or Y" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Empty1ToLogInvioADtuIs_INVIODTUN"
                                    tibex:label="INVIO_DTU = N" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="LogInvioADtuIs_NToEndCiclo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDettLavorazioneToEmpty_VlanMulticast"
                                    tibex:label="Vlan\Multicast" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToJDBCQuery1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQueryToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToAssign_EnrichAccesso" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToCopy_1AnagPDC" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Copy_1AnagPDCToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDettLavorazioneToCalcolaCaratteristicaVlan" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="CalcolaCaratteristicaVlanToAssign_EnrichAccesso" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Copy_1_LogOutToEndCiclo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssignDatiToCopy_1_LogOut" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f04cb8d7-2027-4761-a2d0-4ef76d1ba3a1">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="5a3ca93f-3b0b-4dee-8c12-4036dcc3eff5">
                                <bpws:targets>
                                    <bpws:target linkName="EmptyToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke inputVariable="Enrich-input"
                                name="Enrich" operation="enrich"
                                outputVariable="Enrich"
                                partnerLink="DTUEnrichment"
                                portType="ns2:DTUEnrichment" tibex:xpdlId="98dfe8ed-b8c0-49a0-ac42-9609caf8ffbb">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ndm="http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/DTUEnrichment/" xmlns:tns="http://www.tim.com/NOW/xsd/DTUEnrichment/" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="StrutturaRichiesta"/&gt;
    &lt;xsl:template name="Enrich-input" match="/"&gt;
        &lt;tns2:DTUEnrichmentRequest&gt;
            &lt;input&gt;
                &lt;tns:DTUEnrichmentRequest&gt;
                    &lt;tns:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/ndm:IDRichiestaOLO"/&gt;
                    &lt;/tns:IDRichiestaOLO&gt;
                    &lt;tns:CodiceOLO&gt;
                        &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO"/&gt;
                    &lt;/tns:CodiceOLO&gt;
                    &lt;tns:CodiceOLO_AGCOM&gt;
                        &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM"/&gt;
                    &lt;/tns:CodiceOLO_AGCOM&gt;
                    &lt;tns:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$StrutturaRichiesta"/&gt;
                    &lt;/tns:StrutturaRichiesta&gt;
                    &lt;tns:Offerta&gt;
                        &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta"/&gt;
                    &lt;/tns:Offerta&gt;
                    &lt;xsl:if test="$Start/ndm:Fonia_Dati[number($index)]/ndm:IdContratto"&gt;
                        &lt;tns:IdContratto&gt;
                            &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:IdContratto"/&gt;
                        &lt;/tns:IdContratto&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea"&gt;
                        &lt;tns:ProfiloTecnicoLinea&gt;
                            &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea"/&gt;
                        &lt;/tns:ProfiloTecnicoLinea&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD"&gt;
                        &lt;tns:ProfiloTecnicoLinea_OLD&gt;
                            &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD"/&gt;
                        &lt;/tns:ProfiloTecnicoLinea_OLD&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto"&gt;
                        &lt;tns:Distretto&gt;
                            &lt;xsl:value-of select="$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto"/&gt;
                        &lt;/tns:Distretto&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$Start/ndm:Lavorazione = 'CESSAZIONE'"&gt;
                            &lt;xsl:if test="$Start/ndm:TipologiaScenario"&gt;
                                &lt;tns:TipologiaScenario&gt;
                                    &lt;xsl:value-of select="$Start/ndm:TipologiaScenario"/&gt;
                                &lt;/tns:TipologiaScenario&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A' or $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'"&gt;
                                    &lt;xsl:if test="$Start/ndm:TipologiaScenario"&gt;
                                        &lt;tns:TipologiaScenario&gt;
                                            &lt;xsl:value-of select="$Start/ndm:TipologiaScenario"/&gt;
                                        &lt;/tns:TipologiaScenario&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$Start/ndm:Lavorazione = 'CESSAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D') or ($Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:LNA_LA !='LNA'))"&gt;
                            &lt;tns:Lavorazione&gt;
                                &lt;xsl:value-of select="'CESSAZIONE'"/&gt;
                            &lt;/tns:Lavorazione&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$Start/ndm:Lavorazione = 'ATTIVAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A')"&gt;
                            &lt;tns:Lavorazione&gt;
                                &lt;xsl:value-of select="'ATTIVAZIONE'"/&gt;
                            &lt;/tns:Lavorazione&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$Start/ndm:Lavorazione = 'VARIAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M')"&gt;
                            &lt;tns:Lavorazione&gt;
                                &lt;xsl:value-of select="'VARIAZIONE'"/&gt;
                            &lt;/tns:Lavorazione&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:Lavorazione&gt;
                                &lt;xsl:value-of select="$Start/ndm:Lavorazione"/&gt;
                            &lt;/tns:Lavorazione&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$Start/ndm:Lavorazione = 'MIGRAZIONE' or ($Start/ndm:Lavorazione = 'ATTIVAZIONE' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:SottoLavorazione = 'USCITADATI'))"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente !='NUMBERPORTABILITY'"&gt;
                                    &lt;tns:SottoLavorazione&gt;
                                        &lt;xsl:value-of select="'NORMALE'"/&gt;
                                    &lt;/tns:SottoLavorazione&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="$Start/ndm:SottoLavorazione = 'MIGRAZIONEOLO' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="(exists($Start/ndm:Fonia_Dati/ndm:NomeComponente = 'CONSISTENZAFONIA') and $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA']/ndm:CodificaOLOAGCOMDonating = 'TLC' ) or (exists($Start/ndm:Fonia_Dati/ndm:NomeComponente = 'CONSISTENZACPS') and $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZACPS']/ndm:CodificaOLOAGCOMDonating = 'TLC' )"&gt;
                                                    &lt;tns:SottoLavorazione&gt;
                                                        &lt;xsl:value-of select="'NORMALE'"/&gt;
                                                    &lt;/tns:SottoLavorazione&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;tns:SottoLavorazione&gt;
                                                        &lt;xsl:value-of select="'PORTABILITASUCCESSIVA'"/&gt;
                                                    &lt;/tns:SottoLavorazione&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$Start/ndm:SottoLavorazione = 'MIGRAZIONEOLO' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D'"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="$Start/ndm:CodiceOLO_AGCOM = 'TLC'"&gt;
                                                    &lt;tns:SottoLavorazione&gt;
                                                        &lt;xsl:value-of select="'RIENTRONP'"/&gt;
                                                    &lt;/tns:SottoLavorazione&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;tns:SottoLavorazione&gt;
                                                        &lt;xsl:value-of select="'NORMALE'"/&gt;
                                                    &lt;/tns:SottoLavorazione&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$Start/ndm:SottoLavorazione = 'RIENTROINTI' or $Start/ndm:SottoLavorazione = 'RIENTRONP'"&gt;
                                            &lt;tns:SottoLavorazione&gt;
                                                &lt;xsl:value-of select="'RIENTRONP'"/&gt;
                                            &lt;/tns:SottoLavorazione&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$Start/ndm:SottoLavorazione = 'ATTIVAZIONE274'"&gt;
                                            &lt;tns:SottoLavorazione&gt;
                                                &lt;xsl:value-of select="'NORMALE'"/&gt;
                                            &lt;/tns:SottoLavorazione&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$Start/ndm:SottoLavorazione = 'DONOROLO' or $Start/ndm:SottoLavorazione = 'PORTABILITASUCCESSIVA'"&gt;
                                            &lt;xsl:if test="$Start/ndm:SottoLavorazione"&gt;
                                                &lt;tns:SottoLavorazione&gt;
                                                    &lt;xsl:value-of select="$Start/ndm:SottoLavorazione"/&gt;
                                                &lt;/tns:SottoLavorazione&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns:SottoLavorazione&gt;
                                                &lt;xsl:value-of select="'NORMALE'"/&gt;
                                            &lt;/tns:SottoLavorazione&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$Start/ndm:SottoLavorazione"&gt;
                                &lt;tns:SottoLavorazione&gt;
                                    &lt;xsl:value-of select="$Start/ndm:SottoLavorazione"/&gt;
                                &lt;/tns:SottoLavorazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:for-each select="$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2"&gt;
                        &lt;tns:Dati&gt;
                            &lt;xsl:if test="tns:Encapsulation"&gt;
                                &lt;tns:Encapsulation&gt;
                                    &lt;xsl:value-of select="tns:Encapsulation"/&gt;
                                &lt;/tns:Encapsulation&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists(tns:ATMVC)"&gt;
                                    &lt;xsl:copy-of select="tns:ATMVC"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists(tns:GBEVC)"&gt;
                                    &lt;xsl:copy-of select="tns:GBEVC"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:copy-of select="tns:USERVLAN"/&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns:Dati&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/tns:DTUEnrichmentRequest&gt;
            &lt;/input&gt;
        &lt;/tns2:DTUEnrichmentRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/DTUEnrichment/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Enrich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DTUEnrichmentRequest>&#xa;            &lt;tns:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns:IDRichiestaOLO>&#xa;            &lt;tns:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO&quot;/>&#xa;            &lt;/tns:CodiceOLO>&#xa;            &lt;tns:CodiceOLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM&quot;/>&#xa;            &lt;/tns:CodiceOLO_AGCOM>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$StrutturaRichiesta&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;tns:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta&quot;/>&#xa;            &lt;/tns:Offerta>&#xa;            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdContratto&quot;>&#xa;                &lt;tns:IdContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdContratto&quot;/>&#xa;                &lt;/tns:IdContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea&quot;>&#xa;                &lt;tns:ProfiloTecnicoLinea>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea&quot;/>&#xa;                &lt;/tns:ProfiloTecnicoLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&#xa;                &lt;tns:ProfiloTecnicoLinea_OLD>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                &lt;/tns:ProfiloTecnicoLinea_OLD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;>&#xa;                &lt;tns:Distretto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;/>&#xa;                &lt;/tns:Distretto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE'&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:TipologiaScenario&quot;>&#xa;                        &lt;tns:TipologiaScenario>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:TipologiaScenario&quot;/>&#xa;                        &lt;/tns:TipologiaScenario>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A' or $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:TipologiaScenario&quot;>&#xa;                                &lt;tns:TipologiaScenario>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:TipologiaScenario&quot;/>&#xa;                                &lt;/tns:TipologiaScenario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D') or ($Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:LNA_LA !='LNA'))&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A')&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M')&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:Lavorazione&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' or ($Start/ndm:Lavorazione = 'ATTIVAZIONE' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:SottoLavorazione = 'USCITADATI'))&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente !='NUMBERPORTABILITY'&quot;>&#xa;                            &lt;tns:SottoLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                            &lt;/tns:SottoLavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'MIGRAZIONEOLO' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(exists($Start/ndm:Fonia_Dati/ndm:NomeComponente = 'CONSISTENZAFONIA') and $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA']/ndm:CodificaOLOAGCOMDonating = 'TLC' ) or (exists($Start/ndm:Fonia_Dati/ndm:NomeComponente = 'CONSISTENZACPS') and $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZACPS']/ndm:CodificaOLOAGCOMDonating = 'TLC' )&quot;>&#xa;                                            &lt;tns:SottoLavorazione>&#xa;                                                &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                                            &lt;/tns:SottoLavorazione>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SottoLavorazione>&#xa;                                                &lt;xsl:value-of select=&quot;'PORTABILITASUCCESSIVA'&quot;/>&#xa;                                            &lt;/tns:SottoLavorazione>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'MIGRAZIONEOLO' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:CodiceOLO_AGCOM = 'TLC'&quot;>&#xa;                                            &lt;tns:SottoLavorazione>&#xa;                                                &lt;xsl:value-of select=&quot;'RIENTRONP'&quot;/>&#xa;                                            &lt;/tns:SottoLavorazione>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SottoLavorazione>&#xa;                                                &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                                            &lt;/tns:SottoLavorazione>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'RIENTROINTI' or $Start/ndm:SottoLavorazione = 'RIENTRONP'&quot;>&#xa;                                    &lt;tns:SottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'RIENTRONP'&quot;/>&#xa;                                    &lt;/tns:SottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'ATTIVAZIONE274'&quot;>&#xa;                                    &lt;tns:SottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                                    &lt;/tns:SottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'DONOROLO' or $Start/ndm:SottoLavorazione = 'PORTABILITASUCCESSIVA'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione&quot;>&#xa;                                        &lt;tns:SottoLavorazione>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:SottoLavorazione&quot;/>&#xa;                                        &lt;/tns:SottoLavorazione>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                                    &lt;/tns:SottoLavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione&quot;>&#xa;                        &lt;tns:SottoLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:SottoLavorazione&quot;/>&#xa;                        &lt;/tns:SottoLavorazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2&quot;>&#xa;                &lt;tns:Dati>&#xa;                    &lt;xsl:if test=&quot;tns:Encapsulation&quot;>&#xa;                        &lt;tns:Encapsulation>&#xa;                            &lt;xsl:value-of select=&quot;tns:Encapsulation&quot;/>&#xa;                        &lt;/tns:Encapsulation>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(tns:ATMVC)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;tns:ATMVC&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists(tns:GBEVC)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;tns:GBEVC&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:copy-of select=&quot;tns:USERVLAN&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Dati>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:DTUEnrichmentRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Copy_1_LogInToEnrich"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EnrichToAssign1"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ServizioFonia&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Enrich&quot;/>&lt;xsl:param name=&quot;SelStrutturaRich&quot;/>&lt;xsl:param name=&quot;DettaglioLavorazione&quot;/>&lt;xsl:template name=&quot;ServizioFonia&quot; match=&quot;/&quot;>&lt;ndm:SERVIZIO_FONIA>&lt;xsl:copy-of select=&quot;$ServizioFonia/ns:SERVIZIO_FONIA&quot;/>&lt;xsl:if test=&quot;not(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente != 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Offerta = 'NP'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSATMCONDSUWLRVULL' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSGBECONDSUWLRVULL'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'AEASYIPCONDSUWLRVULL'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSNGAVULAFTTCABCONDSUTIFONIAWLR'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'VDESTUSO'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&lt;ns:SERVIZIO_FONIA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'CPS' and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE','MIGRAZIONE')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DN&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DN&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:LNA_LA = 'LNA' and $Start/ndm:Lavorazione != 'MIGRAZIONE'  and $Start/ndm:Lavorazione != 'VARIAZIONE'&quot;/>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:LNA_LA = 'LA' or $Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS' or $Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SLU')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULL')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI' and ndm:Azione != 'D'])&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione=&amp;quot;D&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9; and &amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA' and ndm:Azione = 'D'])&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI' and ndm:Azione = 'D'])&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;&amp;#x9;$DettaglioLavorazione = 'DIS'&amp;#xD;&amp;#xA;&amp;#x9; or &amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')&amp;#xD;&amp;#xA;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0 and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:SottoLavorazione = 'PORTABILITASUCCESSIVA' and $Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM = 'TLC' and $Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic = 'TLC'&quot;>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;'ATT'&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:SottoLavorazione = 'RIENTRONP' and $Start/ndm:TipologiaScenario = 'CNPCRDAOLO'&quot;>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;'ATT'&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;'VAR'&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;'VAR'&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;$DettaglioLavorazione&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;$SelStrutturaRich/Record[1]/NOME_OFFERTA_DTU&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULLDATI')&quot;>&lt;ns:TIPO_UTILIZZO_LINEA>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/ns:TIPO_UTILIZZO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_UTILIZZO_LINEA>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/ns:TIPO_UTILIZZO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIOTIPOLOGIAWLR9' or $Start/ndm:SottoLavorazione = 'CAMBIOTIPOLOGIAWLR10'&quot;>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;'M'&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='NP' and $Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='PORTABILITASUCCESSIVA' and (starts-with($Start/ndm:TipologiaScenario, 'NPSUWLR') or starts-with($Start/ndm:TipologiaScenario, 'NPSUVULL'))&quot;>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;'L'&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;'K'&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeTipoTrasf) > 0&quot;>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeTipoTrasf&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODE_TIPO_TRASF>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODE_TIPO_TRASF>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and &amp;#xD;&amp;#xA;(($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR' and starts-with($Start/ndm:Offerta, 'WLR') &amp;#xD;&amp;#xA;and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaBTSNaked) > 0 and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOULL' and starts-with($Start/ndm:Offerta, 'ULL') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and starts-with(ndm:Offerta, 'BITSTREAM')]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and starts-with($Start/ndm:Offerta, 'SLU') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and starts-with(ndm:Offerta, 'BITSTREAM')]/ndm:TipoLinea), 'POTS')))&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;'FB'&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and &amp;#xD;&amp;#xA;(($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR' and starts-with($Start/ndm:Offerta, 'WLR') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOULL' and starts-with($Start/ndm:Offerta, 'ULL') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and (starts-with(ndm:Offerta, 'BITSTREAM') or starts-with(ndm:Offerta, 'EASYIP'))]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and starts-with($Start/ndm:Offerta, 'SLU') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and (starts-with(ndm:Offerta, 'BITSTREAM') or starts-with(ndm:Offerta, 'EASYIP'))]/ndm:TipoLinea), 'POTS')))&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;'FB'&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULL') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SLU') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']/ndm:TipoLinea), 'POTS'))&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;'FB'&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;'A2'&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;'02'&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeDisFlow) > 0&quot;>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeDisFlow&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODE_DIS_FLOW>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODE_DIS_FLOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Bitrate&quot;>&lt;ns:BIT_RATE_UP_OLO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Bitrate&quot;/>&lt;/ns:BIT_RATE_UP_OLO>&lt;/xsl:if>&lt;ns:CICLO_LAVORAZ>&lt;xsl:value-of select=&quot;'001'&quot;/>&lt;/ns:CICLO_LAVORAZ>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI) &amp;lt; 9&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;>&lt;ns:CLLI_CENTRALE_CO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;/>&lt;/ns:CLLI_CENTRALE_CO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;>&lt;ns:DISTRETTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;/>&lt;/ns:DISTRETTO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='MIGRAZIONE' and $Start/ndm:SottoLavorazione='RIENTROCPS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0&quot;>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOloCess&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZAFONIA','CONSISTENZACPS') and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0&quot;>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;($Start/ndm:Offerta = 'NP' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP') &amp;#xD;&amp;#xA;or  &amp;#xD;&amp;#xA;((starts-with($Start/ndm:Offerta, 'ULL') or starts-with($Start/ndm:Offerta, 'SLU')) &amp;#xD;&amp;#xA;and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' &amp;#xD;&amp;#xA;and(($Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='USCITADATI') &amp;#xD;&amp;#xA;or ($Start/ndm:Lavorazione='MIGRAZIONE' and $Start/ndm:SottoLavorazione=('MIGRAZIONEOLO', 'RIENTROINTI'))) &amp;#xD;&amp;#xA;and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0)&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;>&lt;ns:CODE_GEST_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&lt;/ns:CODE_GEST_OLD>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic&quot;>&lt;ns:CODE_GEST_REC>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic&quot;/>&lt;/ns:CODE_GEST_REC>&lt;/xsl:if>&lt;/xsl:if>&lt;ns:CODE_RICHIESTA_TI>&lt;xsl:value-of select=&quot;$Start/ndm:CodiceOrdineTI&quot;/>&lt;/ns:CODE_RICHIESTA_TI>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'TRASLOCOWLR12'&quot;>&lt;ns:CODE_SERVIZIO>&lt;xsl:value-of select=&quot;'W'&quot;/>&lt;/ns:CODE_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_SERVIZIO>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/ns:CODE_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:CODE_SERVIZIO>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/ns:CODE_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeServizio) > 0&quot;>&lt;ns:CODE_SERVIZIO>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:CodCausDestnrio/tns:CodeServizio&quot;/>&lt;/ns:CODE_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODE_SERVIZIO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODE_SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DestinazioneUso&quot;>&lt;ns:DEST_USO_OLO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DestinazioneUso&quot;/>&lt;/ns:DEST_USO_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE'&quot;>&lt;ns:FLAG_MIGRAZIONE>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/ns:FLAG_MIGRAZIONE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;/>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and $Start/ndm:LNA_LA = 'LNA' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NFili) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NFili&quot;>&lt;ns:NFILI>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NFili&quot;/>&lt;/ns:NFILI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2)) or string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) = 0&quot;>&lt;ns:NFILI>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/ns:NFILI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:NFILI>&lt;xsl:value-of select=&quot;'4'&quot;/>&lt;/ns:NFILI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&lt;xsl:if test=&quot;$Start/ndm:DNOLOCollaudo&quot;>&lt;ns:DN_OLO_COL>&lt;xsl:value-of select=&quot;$Start/ndm:DNOLOCollaudo&quot;/>&lt;/ns:DN_OLO_COL>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&lt;xsl:if test=&quot;$Start/ndm:NumeroVerdeOloCollaudo&quot;>&lt;ns:NVERDE_OLO_COL>&lt;xsl:value-of select=&quot;$Start/ndm:NumeroVerdeOloCollaudo&quot;/>&lt;/ns:NVERDE_OLO_COL>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&lt;xsl:if test=&quot;$Start/ndm:NumeroVerdeOloPT&quot;>&lt;ns:NVERDE_OLO_PRT>&lt;xsl:value-of select=&quot;$Start/ndm:NumeroVerdeOloPT&quot;/>&lt;/ns:NVERDE_OLO_PRT>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' or  $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&quot;>&lt;ns:OPZNP>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/ns:OPZNP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:OPZNP>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/ns:OPZNP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti) > 0&quot;>&lt;ns:OPZ_PRODOTTI>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;/>&lt;/ns:OPZ_PRODOTTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:OPZ_PRODOTTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/ns:OPZ_PRODOTTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) > 0&quot;>&lt;ns:RIPARTITORE>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 1, 3)&quot;/>&lt;/ns:RIPARTITORE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RoutingNumber&quot;>&lt;ns:RN_NEW>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RoutingNumber&quot;/>&lt;/ns:RN_NEW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&lt;ns:TIPO_COLOCAZ>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/ns:TIPO_COLOCAZ>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_COLOCAZ>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:TIPO_COLOCAZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI1&quot;>&lt;ns:POSIZIONE_ARLTI1>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI1&quot;/>&lt;/ns:POSIZIONE_ARLTI1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI2&quot;>&lt;ns:POSIZIONE_ARLTI2>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI2&quot;/>&lt;/ns:POSIZIONE_ARLTI2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO1&quot;>&lt;ns:POSIZIONE_ARLOLO1>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO1&quot;/>&lt;/ns:POSIZIONE_ARLOLO1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO2&quot;>&lt;ns:POSIZIONE_ARLOLO2>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO2&quot;/>&lt;/ns:POSIZIONE_ARLOLO2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDARLOLO&quot;>&lt;ns:ID_ARL_OLO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDARLOLO&quot;/>&lt;/ns:ID_ARL_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDSLUCO&quot;>&lt;ns:IDSLUCO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDSLUCO&quot;/>&lt;/ns:IDSLUCO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) > 0&quot;>&lt;ns:COORDOLO>&lt;ns:BLOCCO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 7, 1)&quot;/>&lt;/ns:BLOCCO>&lt;ns:MONTANTE>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 4, 3)&quot;/>&lt;/ns:MONTANTE>&lt;ns:NODO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 8, 4)&quot;/>&lt;/ns:NODO>&lt;ns:PAGLIETTA1>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 12, 2)&quot;/>&lt;/ns:PAGLIETTA1>&lt;ns:PAGLIETTA2>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 14, 2)&quot;/>&lt;/ns:PAGLIETTA2>&lt;/ns:COORDOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) > 0&quot;>&lt;ns:COORDOLO>&lt;ns:BLOCCO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 7, 1)&quot;/>&lt;/ns:BLOCCO>&lt;ns:MONTANTE>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 4, 3)&quot;/>&lt;/ns:MONTANTE>&lt;ns:NODO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 8, 4)&quot;/>&lt;/ns:NODO>&lt;ns:PAGLIETTA1>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 12, 2)&quot;/>&lt;/ns:PAGLIETTA1>&lt;ns:PAGLIETTA2>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 14, 2)&quot;/>&lt;/ns:PAGLIETTA2>&lt;/ns:COORDOLO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'CPS'&quot;>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero)>0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;>&lt;ns:TIPO_NUMERAZIONE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;/>&lt;/ns:TIPO_NUMERAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $Start/ndm:SottoLavorazione=('USCITADATI','ATTIVAZIONE274','MIGRAZIONEOLO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='’ISDN PRA') or ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:SottoLavorazione='CAMBIOTIPOLOGIAWLR11') or ($Start/ndm:Lavorazione='CESSAZIONE' and $Start/ndm:SottoLavorazione='NORMALE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='’ISDN PRA')&quot;>&lt;ns:TIPO_NUMERAZIONE>&lt;xsl:value-of select=&quot;'GENERICA'&quot;/>&lt;/ns:TIPO_NUMERAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:TIPO_NUMERAZIONE>&lt;xsl:value-of select=&quot;'GENERICA'&quot;/>&lt;/ns:TIPO_NUMERAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;>&lt;ns:TIPO_NUMERAZIONE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;/>&lt;/ns:TIPO_NUMERAZIONE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DnRadicaleAccorpante&quot;>&lt;ns:DN_RADICALE_ACCORPANTE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DnRadicaleAccorpante&quot;/>&lt;/ns:DN_RADICALE_ACCORPANTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'CPS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione=('CESSAZIONE','MIGRAZIONE')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)=('BRA MONO','BRAMONO','SIMPLEX')&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'ISDN BMO'&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)=('BRA MULTI','BRAMULTI')&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'ISDN BMU'&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)='BRA'&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'ISDN'&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale, ' ', $Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale))&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $Start/ndm:SottoLavorazione=('USCITADATI','ATTIVAZIONE274','MIGRAZIONEOLO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA') or ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA') or ($Start/ndm:Lavorazione='CESSAZIONE' and $Start/ndm:SottoLavorazione='NORMALE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA')&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'ISDN PRA'&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')) and &amp;#x9;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) > 0 and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) = 'ISDN' and upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'SIMPLEX'&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'ISDN BMO'&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRA MONO' or upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRAMONO'&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' BMO'))&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRA MULTI' or upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRAMULTI'&quot;>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' BMU'))&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' ', $Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea))&quot;/>&lt;/ns:TIPO_SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:CodicePacchettoNow&quot;>&lt;ns:ID_PACCHETTO>&lt;xsl:value-of select=&quot;$Start/ndm:CodicePacchettoNow&quot;/>&lt;/ns:ID_PACCHETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:IDCorrelazione&quot;>&lt;ns:ID_PACCHETTO_ORIGINARIO>&lt;xsl:value-of select=&quot;$Start/ndm:IDCorrelazione&quot;/>&lt;/ns:ID_PACCHETTO_ORIGINARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2&quot;>&lt;ns:AGGIUNTIVI>&lt;xsl:if test=&quot;ndm:Stato&quot;>&lt;ns:STATO_AGGIUNTIVO>&lt;xsl:value-of select=&quot;ndm:Stato&quot;/>&lt;/ns:STATO_AGGIUNTIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&lt;ns:TEL_AGGIUNTIVO>&lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&lt;/ns:TEL_AGGIUNTIVO>&lt;/xsl:if>&lt;ns:FL_NP_AGGIUNTIVO>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/ns:FL_NP_AGGIUNTIVO>&lt;/ns:AGGIUNTIVI>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BorchiaNT1Plus&quot;>&lt;ns:BorchiaNT1Plus>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BorchiaNT1Plus&quot;/>&lt;/ns:BorchiaNT1Plus>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO=&amp;quot;Y&amp;quot;&quot;>&lt;ns:NUMERAZIONE_DONOR_OLO>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/ns:NUMERAZIONE_DONOR_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO&quot;>&lt;ns:NUMERAZIONE_DONOR_OLO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO&quot;/>&lt;/ns:NUMERAZIONE_DONOR_OLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:STS_L2&quot;>&lt;ns:ATTIVAZIONE_STS>&lt;ns:CODICESTS>&lt;xsl:value-of select=&quot;ndm:CodiceDTU&quot;/>&lt;/ns:CODICESTS>&lt;xsl:if test=&quot;ndm:Descrizione&quot;>&lt;ns:DESCRIZIONESTS>&lt;xsl:value-of select=&quot;ndm:Descrizione&quot;/>&lt;/ns:DESCRIZIONESTS>&lt;/xsl:if>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;ndm:AzioneSTS&quot;/>&lt;/ns:AZIONE>&lt;/ns:ATTIVAZIONE_STS>&lt;/xsl:for-each>&lt;xsl:if test=&quot;(((starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')) and ($Start/ndm:Lavorazione = 'ATTIVAZIONE' or $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A')) or $Start/ndm:SottoLavorazione = 'DECREMENTONP') or&amp;#xD;&amp;#xA;(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and ($Start/ndm:Lavorazione = 'VARIAZIONE')) or ($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS' and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu!='N' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu))))&quot;>&lt;ns:DESC_LINEA>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--ATTIVAZIONE WLR-VULL O DECREMENTONP-->&lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:Direzionalita)) != 'NaN'&quot;>&lt;ns:DIREZIONALITA_RICHIESTA>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:Direzionalita)&quot;/>&lt;/ns:DIREZIONALITA_RICHIESTA>&lt;/xsl:if>&lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaLinee)) != 'NaN'&quot;>&lt;ns:QUANTITALINEE>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaLinee)&quot;/>&lt;/ns:QUANTITALINEE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SelezionePassante&quot;>&lt;ns:SELEZIONEPASSANTE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SelezionePassante&quot;/>&lt;/ns:SELEZIONEPASSANTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AccessoNumerico&quot;>&lt;ns:ACCESSONUMERICO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AccessoNumerico&quot;/>&lt;/ns:ACCESSONUMERICO>&lt;/xsl:if>&lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:NumAggiuntivi)) != 'NaN'&quot;>&lt;ns:NUMAGGIUNTIVI>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:NumAggiuntivi)&quot;/>&lt;/ns:NUMAGGIUNTIVI>&lt;/xsl:if>&lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaCanali)) != 'NaN'&quot;>&lt;ns:QUANTITACANALI>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaCanali)&quot;/>&lt;/ns:QUANTITACANALI>&lt;/xsl:if>&lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:NumLineeMov)) != 'NaN'&quot;>&lt;ns:NUMERO_LINEE_MOVIMENTATE>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:NumLineeMov)&quot;/>&lt;/ns:NUMERO_LINEE_MOVIMENTATE>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS' and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu!='N' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu))))&amp;#xD;&amp;#xA;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2[ndm:Azione='A']&quot;>&lt;ns:NUMERAZIONIAGGIUNTIVE>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;'M'&quot;/>&lt;/ns:AZIONE>&lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&lt;ns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&lt;/ns:NumerazioneAggiuntiva>&lt;/xsl:if>&lt;/ns:NUMERAZIONIAGGIUNTIVE>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2[ndm:Azione='D']&quot;>&lt;ns:NUMERAZIONIAGGIUNTIVE>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;'M'&quot;/>&lt;/ns:AZIONE>&lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&lt;ns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&lt;/ns:NumerazioneAggiuntiva>&lt;/xsl:if>&lt;/ns:NUMERAZIONIAGGIUNTIVE>&lt;/xsl:for-each>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) != 'POTS' &amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;(&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'SIMPLEX'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'PBX'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'GNR'   )) and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta!='CPS'&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2&quot;>&lt;ns:NUMERAZIONIAGGIUNTIVE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(ndm:Azione)>0&quot;>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;ndm:Azione&quot;/>&lt;/ns:AZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/ns:AZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'WLRLINEAATTIVA' or (starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and ../../ndm:LNA_LA = 'LA')&quot;>&lt;xsl:if test=&quot;ndm:DirezionalitaAggiuntivo&quot;>&lt;ns:DIREZIONALITA>&lt;xsl:value-of select=&quot;ndm:DirezionalitaAggiuntivo&quot;/>&lt;/ns:DIREZIONALITA>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&lt;ns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&lt;/ns:NumerazioneAggiuntiva>&lt;/xsl:if>&lt;xsl:if test=&quot;ndm:IdRisorsaPBX&quot;>&lt;ns:ID_RISORSA_PBX>&lt;xsl:value-of select=&quot;ndm:IdRisorsaPBX&quot;/>&lt;/ns:ID_RISORSA_PBX>&lt;/xsl:if>&lt;/ns:NUMERAZIONIAGGIUNTIVE>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL') or $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Capostipite&quot;>&lt;ns:CAPOSTIPITE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Capostipite&quot;/>&lt;/ns:CAPOSTIPITE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Radicale&quot;>&lt;ns:CAPOSTIPITE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Radicale&quot;/>&lt;/ns:CAPOSTIPITE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/ns:DESC_LINEA>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/ndm:Lavorazione = 'VARIAZIONE') or ($Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('NP','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0)&quot;>&lt;ns:FONIA_VARIAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione='PASSAGGIOULLD'&quot;>&lt;ns:TIPO_VARIAZIONE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:TIPO_VARIAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:TIPO_VARIAZIONE>&lt;xsl:value-of select=&quot;'DECREMENTO NP'&quot;/>&lt;/ns:TIPO_VARIAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&lt;ns:TIPO_VARIAZIONE>&lt;xsl:value-of select=&quot;'DECREMENTO ULL'&quot;/>&lt;/ns:TIPO_VARIAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_VARIAZIONE>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:SottoLavorazioneDTU&quot;/>&lt;/ns:TIPO_VARIAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;starts-with($Start/ndm:SottoLavorazione, 'TRASLOCO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR'&quot;>&lt;ns:Trasloco>&lt;ns:CodiceTrasloco>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceTrasloco&quot;/>&lt;/ns:CodiceTrasloco>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;>&lt;ns:FlagMantenimentoProdotti>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;/>&lt;/ns:FlagMantenimentoProdotti>&lt;/xsl:if>&lt;/ns:Trasloco>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione = 'DECREMENTOCANALI' or $Start/ndm:SottoLavorazione = 'INCREMENTOCANALI'&quot;>&lt;ns:CambioCanali>&lt;xsl:choose>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:QuantitaLinee_OLD)) != 'NaN'&quot;>&lt;ns:QuantitaLinee_OLD>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:QuantitaLinee_OLD)&quot;/>&lt;/ns:QuantitaLinee_OLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:Direzionalita_OLD)) != 'NaN'&quot;>&lt;ns:Direzionalita_OLD>&lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:Direzionalita_OLD)&quot;/>&lt;/ns:Direzionalita_OLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD&quot;>&lt;ns:SelezionePassante_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD&quot;/>&lt;/ns:SelezionePassante_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD&quot;>&lt;ns:AccessoNumerico_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD&quot;/>&lt;/ns:AccessoNumerico_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns:CambioCanali>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIOCOPPIA'&quot;>&lt;ns:CambioCoppia>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD) > 0&quot;>&lt;ns:RIPARTITORE_OLD>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 1, 3)&quot;/>&lt;/ns:RIPARTITORE_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD) > 0&quot;>&lt;ns:COORDOLO_OLD>&lt;ns:BLOCCO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 7, 1)&quot;/>&lt;/ns:BLOCCO>&lt;ns:MONTANTE>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 4, 3)&quot;/>&lt;/ns:MONTANTE>&lt;ns:NODO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 8, 4)&quot;/>&lt;/ns:NODO>&lt;ns:PAGLIETTA1>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 12, 2)&quot;/>&lt;/ns:PAGLIETTA1>&lt;ns:PAGLIETTA2>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 14, 2)&quot;/>&lt;/ns:PAGLIETTA2>&lt;/ns:COORDOLO_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD) > 0&quot;>&lt;ns:COORDOLO_OLD>&lt;ns:BLOCCO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 7, 1)&quot;/>&lt;/ns:BLOCCO>&lt;ns:MONTANTE>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 4, 3)&quot;/>&lt;/ns:MONTANTE>&lt;ns:NODO>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 8, 4)&quot;/>&lt;/ns:NODO>&lt;ns:PAGLIETTA1>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 12, 2)&quot;/>&lt;/ns:PAGLIETTA1>&lt;ns:PAGLIETTA2>&lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 14, 2)&quot;/>&lt;/ns:PAGLIETTA2>&lt;/ns:COORDOLO_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI1_OLD&quot;>&lt;ns:POSIZIONE_ARLTI1_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI1_OLD&quot;/>&lt;/ns:POSIZIONE_ARLTI1_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI2_OLD&quot;>&lt;ns:POSIZIONE_ARLTI2_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI2_OLD&quot;/>&lt;/ns:POSIZIONE_ARLTI2_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO1_OLD&quot;>&lt;ns:POSIZIONE_ARLOLO1_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO1_OLD&quot;/>&lt;/ns:POSIZIONE_ARLOLO1_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO2_OLD&quot;>&lt;ns:POSIZIONE_ARLOLO2_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO2_OLD&quot;/>&lt;/ns:POSIZIONE_ARLOLO2_OLD>&lt;/xsl:if>&lt;/ns:CambioCoppia>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIONUMERO3'&quot;>&lt;ns:CambioNumero>&lt;ns:CodiceCambioNumero>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/ns:CodiceCambioNumero>&lt;/ns:CambioNumero>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIONUMERO4'&quot;>&lt;ns:CambioNumero>&lt;ns:CodiceCambioNumero>&lt;xsl:value-of select=&quot;'4'&quot;/>&lt;/ns:CodiceCambioNumero>&lt;/ns:CambioNumero>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR5'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'5'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR6'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'6'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR7'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'7'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR18'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'18'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR19'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'19'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR20'&quot;>&lt;ns:CambioPrestazione>&lt;ns:CodiceCambioPrestazione>&lt;xsl:value-of select=&quot;'20'&quot;/>&lt;/ns:CodiceCambioPrestazione>&lt;/ns:CambioPrestazione>&lt;/xsl:when>&lt;/xsl:choose>&lt;/ns:FONIA_VARIAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneTraffico&quot;>&lt;ns:OPZIONE_TRAFFICO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneTraffico&quot;/>&lt;/ns:OPZIONE_TRAFFICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'CPS' and $Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLineaReale = ('PBX', 'GNR')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Fatturante&quot;>&lt;ns:FATTURANTE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Fatturante&quot;/>&lt;/ns:FATTURANTE>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:SERVIZIO_FONIA>&lt;/xsl:if>&lt;/ndm:SERVIZIO_FONIA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ServizioFonia"
                                    name="AssignFonia"
                                    outputVariable="ServizioFonia"
                                    tibex:xpdlId="ee345db0-0c36-448d-bd06-999fa2bf8253" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign_EnrichAccessoToAssignFonia"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignFoniaToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Enrich.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ServizioFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;SelStrutturaRich&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioLavorazione&quot;/>&#xa;    &lt;xsl:template name=&quot;ServizioFonia&quot; match=&quot;/&quot;>&#xa;        &lt;ndm:SERVIZIO_FONIA>&#xa;            &lt;xsl:copy-of select=&quot;$ServizioFonia/ns:SERVIZIO_FONIA&quot;/>&#xa;            &lt;xsl:if test=&quot;not(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente != 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Offerta = 'NP'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSATMCONDSUWLRVULL' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSGBECONDSUWLRVULL'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'AEASYIPCONDSUWLRVULL'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'ABTSNGAVULAFTTCABCONDSUTIFONIAWLR'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'VDESTUSO'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&#xa;                &lt;ns:SERVIZIO_FONIA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'CPS' and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE','MIGRAZIONE')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DN&quot;>&#xa;                                &lt;ns:ID_IMPIANTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DN&quot;/>&#xa;                                &lt;/ns:ID_IMPIANTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;>&#xa;                                &lt;ns:ID_IMPIANTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;/>&#xa;                                &lt;/ns:ID_IMPIANTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:LNA_LA = 'LNA' and $Start/ndm:Lavorazione != 'MIGRAZIONE'  and $Start/ndm:Lavorazione != 'VARIAZIONE'&quot;/>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and ($Start/ndm:SottoLavorazione = 'ATTIVAZIONE274' or $Start/ndm:LNA_LA = 'LA' or $Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS' or $Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SLU')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULL')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI' and ndm:Azione != 'D'])&amp;#xD;&amp;#xA;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione=&amp;quot;D&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9; and &amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA' and ndm:Azione = 'D'])&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI' and ndm:Azione = 'D'])&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;>&#xa;                                &lt;ns:ID_IMPIANTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;/>&#xa;                                &lt;/ns:ID_IMPIANTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;&amp;#x9;$DettaglioLavorazione = 'DIS'&amp;#xD;&amp;#xA;&amp;#x9; or &amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')&amp;#xD;&amp;#xA;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&amp;#xD;&amp;#xA;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SHA')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0 and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) != 'U'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) != 'NaN'&quot;>&#xa;                                            &lt;ns:ID_IMPIANTO>&#xa;                                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                            &lt;/ns:ID_IMPIANTO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:SottoLavorazione = 'PORTABILITASUCCESSIVA' and $Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM = 'TLC' and $Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic = 'TLC'&quot;>&#xa;                            &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATT'&quot;/>&#xa;                            &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:SottoLavorazione = 'RIENTRONP' and $Start/ndm:TipologiaScenario = 'CNPCRDAOLO'&quot;>&#xa;                            &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATT'&quot;/>&#xa;                            &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'VAR'&quot;/>&#xa;                            &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'VAR'&quot;/>&#xa;                            &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioLavorazione&quot;/>&#xa;                            &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:SERVIZIO_RICHIESTO>&#xa;                        &lt;xsl:value-of select=&quot;$SelStrutturaRich/Record[1]/NOME_OFFERTA_DTU&quot;/>&#xa;                    &lt;/ns:SERVIZIO_RICHIESTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULLDATI')&quot;>&#xa;                            &lt;ns:TIPO_UTILIZZO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                            &lt;/ns:TIPO_UTILIZZO_LINEA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:TIPO_UTILIZZO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                            &lt;/ns:TIPO_UTILIZZO_LINEA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIOTIPOLOGIAWLR9' or $Start/ndm:SottoLavorazione = 'CAMBIOTIPOLOGIAWLR10'&quot;>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta='NP' and $Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='PORTABILITASUCCESSIVA' and (starts-with($Start/ndm:TipologiaScenario, 'NPSUWLR') or starts-with($Start/ndm:TipologiaScenario, 'NPSUVULL'))&quot;>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;'L'&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;'K'&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Enrich.output/tns:CodCausDestnrio/tns:CodeTipoTrasf) > 0&quot;>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:CodCausDestnrio/tns:CodeTipoTrasf&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:CODE_TIPO_TRASF>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:CODE_TIPO_TRASF>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and &amp;#xD;&amp;#xA;(($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR' and starts-with($Start/ndm:Offerta, 'WLR') &amp;#xD;&amp;#xA;and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaBTSNaked) > 0 and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOULL' and starts-with($Start/ndm:Offerta, 'ULL') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and starts-with(ndm:Offerta, 'BITSTREAM')]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and starts-with($Start/ndm:Offerta, 'SLU') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and starts-with(ndm:Offerta, 'BITSTREAM')]/ndm:TipoLinea), 'POTS')))&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;'FB'&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and &amp;#xD;&amp;#xA;(($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR' and starts-with($Start/ndm:Offerta, 'WLR') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOULL' and starts-with($Start/ndm:Offerta, 'ULL') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and (starts-with(ndm:Offerta, 'BITSTREAM') or starts-with(ndm:Offerta, 'EASYIP'))]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or ($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and starts-with($Start/ndm:Offerta, 'SLU') &amp;#xD;&amp;#xA;and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI' and (starts-with(ndm:Offerta, 'BITSTREAM') or starts-with(ndm:Offerta, 'EASYIP'))]/ndm:TipoLinea), 'POTS')))&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;'FB'&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'ULL') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']/ndm:TipoLinea), 'POTS'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'CONSISTENZAFONIA' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'SLU') and exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']) and contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZADATI']/ndm:TipoLinea), 'POTS'))&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;'FB'&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;'A2'&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;'02'&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Enrich.output/tns:CodCausDestnrio/tns:CodeDisFlow) > 0&quot;>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:CodCausDestnrio/tns:CodeDisFlow&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:CODE_DIS_FLOW>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:CODE_DIS_FLOW>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Bitrate&quot;>&#xa;                        &lt;ns:BIT_RATE_UP_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Bitrate&quot;/>&#xa;                        &lt;/ns:BIT_RATE_UP_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:CICLO_LAVORAZ>&#xa;                        &lt;xsl:value-of select=&quot;'001'&quot;/>&#xa;                    &lt;/ns:CICLO_LAVORAZ>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI) &amp;lt; 9&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;>&#xa;                            &lt;ns:CLLI_CENTRALE_CO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;/>&#xa;                            &lt;/ns:CLLI_CENTRALE_CO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;>&#xa;                        &lt;ns:DISTRETTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Distretto&quot;/>&#xa;                        &lt;/ns:DISTRETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='MIGRAZIONE' and $Start/ndm:SottoLavorazione='RIENTROCPS'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0&quot;>&#xa;                                    &lt;ns:CODE_GEST>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/ns:CODE_GEST>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:CODE_GEST>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOloCess&quot;/>&#xa;                                    &lt;/ns:CODE_GEST>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZAFONIA','CONSISTENZACPS') and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0&quot;>&#xa;                            &lt;ns:CODE_GEST>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/ns:CODE_GEST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:CODE_GEST>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceOLO_AGCOM&quot;/>&#xa;                            &lt;/ns:CODE_GEST>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Offerta = 'NP' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP') &amp;#xD;&amp;#xA;or  &amp;#xD;&amp;#xA;((starts-with($Start/ndm:Offerta, 'ULL') or starts-with($Start/ndm:Offerta, 'SLU')) &amp;#xD;&amp;#xA;and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' &amp;#xD;&amp;#xA;and(($Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='USCITADATI') &amp;#xD;&amp;#xA;or ($Start/ndm:Lavorazione='MIGRAZIONE' and $Start/ndm:SottoLavorazione=('MIGRAZIONEOLO', 'RIENTROINTI'))) &amp;#xD;&amp;#xA;and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating) > 0)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;>&#xa;                            &lt;ns:CODE_GEST_OLD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/ns:CODE_GEST_OLD>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic&quot;>&#xa;                            &lt;ns:CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodificaOLOAGCOMRic&quot;/>&#xa;                            &lt;/ns:CODE_GEST_REC>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:CODE_RICHIESTA_TI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:CodiceOrdineTI&quot;/>&#xa;                    &lt;/ns:CODE_RICHIESTA_TI>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'TRASLOCOWLR12'&quot;>&#xa;                            &lt;ns:CODE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;'W'&quot;/>&#xa;                            &lt;/ns:CODE_SERVIZIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                            &lt;/ns:CODE_SERVIZIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:CODE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                            &lt;/ns:CODE_SERVIZIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Enrich.output/tns:CodCausDestnrio/tns:CodeServizio) > 0&quot;>&#xa;                            &lt;ns:CODE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:CodCausDestnrio/tns:CodeServizio&quot;/>&#xa;                            &lt;/ns:CODE_SERVIZIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:CODE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:CODE_SERVIZIO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DestinazioneUso&quot;>&#xa;                        &lt;ns:DEST_USO_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DestinazioneUso&quot;/>&#xa;                        &lt;/ns:DEST_USO_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE'&quot;>&#xa;                        &lt;ns:FLAG_MIGRAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                        &lt;/ns:FLAG_MIGRAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;/>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOSLU' and $Start/ndm:LNA_LA = 'LNA' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NFili) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NFili&quot;>&#xa;                                &lt;ns:NFILI>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NFili&quot;/>&#xa;                                &lt;/ns:NFILI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2)) or string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) = 0&quot;>&#xa;                            &lt;ns:NFILI>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/ns:NFILI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:NFILI>&#xa;                                &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                            &lt;/ns:NFILI>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:DNOLOCollaudo&quot;>&#xa;                            &lt;ns:DN_OLO_COL>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:DNOLOCollaudo&quot;/>&#xa;                            &lt;/ns:DN_OLO_COL>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:NumeroVerdeOloCollaudo&quot;>&#xa;                            &lt;ns:NVERDE_OLO_COL>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:NumeroVerdeOloCollaudo&quot;/>&#xa;                            &lt;/ns:NVERDE_OLO_COL>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:NumeroVerdeOloPT&quot;>&#xa;                            &lt;ns:NVERDE_OLO_PRT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:NumeroVerdeOloPT&quot;/>&#xa;                            &lt;/ns:NVERDE_OLO_PRT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' or  $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&quot;>&#xa;                            &lt;ns:OPZNP>&#xa;                                &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                            &lt;/ns:OPZNP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:OPZNP>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns:OPZNP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti) > 0&quot;>&#xa;                            &lt;ns:OPZ_PRODOTTI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;/>&#xa;                            &lt;/ns:OPZ_PRODOTTI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:OPZ_PRODOTTI>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns:OPZ_PRODOTTI>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) > 0&quot;>&#xa;                        &lt;ns:RIPARTITORE>&#xa;                            &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 1, 3)&quot;/>&#xa;                        &lt;/ns:RIPARTITORE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'NUMBERPORTABILITY'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RoutingNumber&quot;>&#xa;                                &lt;ns:RN_NEW>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RoutingNumber&quot;/>&#xa;                                &lt;/ns:RN_NEW>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&#xa;                            &lt;ns:TIPO_COLOCAZ>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns:TIPO_COLOCAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:TIPO_COLOCAZ>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/ns:TIPO_COLOCAZ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI1&quot;>&#xa;                        &lt;ns:POSIZIONE_ARLTI1>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI1&quot;/>&#xa;                        &lt;/ns:POSIZIONE_ARLTI1>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI2&quot;>&#xa;                        &lt;ns:POSIZIONE_ARLTI2>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLTI2&quot;/>&#xa;                        &lt;/ns:POSIZIONE_ARLTI2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO1&quot;>&#xa;                        &lt;ns:POSIZIONE_ARLOLO1>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO1&quot;/>&#xa;                        &lt;/ns:POSIZIONE_ARLOLO1>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO2&quot;>&#xa;                        &lt;ns:POSIZIONE_ARLOLO2>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:PosizioneARLOLO2&quot;/>&#xa;                        &lt;/ns:POSIZIONE_ARLOLO2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDARLOLO&quot;>&#xa;                        &lt;ns:ID_ARL_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDARLOLO&quot;/>&#xa;                        &lt;/ns:ID_ARL_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDSLUCO&quot;>&#xa;                        &lt;ns:IDSLUCO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDSLUCO&quot;/>&#xa;                        &lt;/ns:IDSLUCO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1) > 0&quot;>&#xa;                        &lt;ns:COORDOLO>&#xa;                            &lt;ns:BLOCCO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 7, 1)&quot;/>&#xa;                            &lt;/ns:BLOCCO>&#xa;                            &lt;ns:MONTANTE>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 4, 3)&quot;/>&#xa;                            &lt;/ns:MONTANTE>&#xa;                            &lt;ns:NODO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 8, 4)&quot;/>&#xa;                            &lt;/ns:NODO>&#xa;                            &lt;ns:PAGLIETTA1>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 12, 2)&quot;/>&#xa;                            &lt;/ns:PAGLIETTA1>&#xa;                            &lt;ns:PAGLIETTA2>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore1, 14, 2)&quot;/>&#xa;                            &lt;/ns:PAGLIETTA2>&#xa;                        &lt;/ns:COORDOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2) > 0&quot;>&#xa;                        &lt;ns:COORDOLO>&#xa;                            &lt;ns:BLOCCO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 7, 1)&quot;/>&#xa;                            &lt;/ns:BLOCCO>&#xa;                            &lt;ns:MONTANTE>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 4, 3)&quot;/>&#xa;                            &lt;/ns:MONTANTE>&#xa;                            &lt;ns:NODO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 8, 4)&quot;/>&#xa;                            &lt;/ns:NODO>&#xa;                            &lt;ns:PAGLIETTA1>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 12, 2)&quot;/>&#xa;                            &lt;/ns:PAGLIETTA1>&#xa;                            &lt;ns:PAGLIETTA2>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:PosizionePermutatore2, 14, 2)&quot;/>&#xa;                            &lt;/ns:PAGLIETTA2>&#xa;                        &lt;/ns:COORDOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'CPS'&quot;>&#xa;                            &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;>&#xa;                                    &lt;ns:TIPO_NUMERAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;/>&#xa;                                    &lt;/ns:TIPO_NUMERAZIONE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $Start/ndm:SottoLavorazione=('USCITADATI','ATTIVAZIONE274','MIGRAZIONEOLO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='’ISDN PRA') or ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:SottoLavorazione='CAMBIOTIPOLOGIAWLR11') or ($Start/ndm:Lavorazione='CESSAZIONE' and $Start/ndm:SottoLavorazione='NORMALE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='’ISDN PRA')&quot;>&#xa;                            &lt;ns:TIPO_NUMERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'GENERICA'&quot;/>&#xa;                            &lt;/ns:TIPO_NUMERAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                            &lt;ns:TIPO_NUMERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'GENERICA'&quot;/>&#xa;                            &lt;/ns:TIPO_NUMERAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;>&#xa;                                &lt;ns:TIPO_NUMERAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoNumero&quot;/>&#xa;                                &lt;/ns:TIPO_NUMERAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DnRadicaleAccorpante&quot;>&#xa;                        &lt;ns:DN_RADICALE_ACCORPANTE>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DnRadicaleAccorpante&quot;/>&#xa;                        &lt;/ns:DN_RADICALE_ACCORPANTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'CPS'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;>&#xa;                                        &lt;ns:TIPO_SERVIZIO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;/>&#xa;                                        &lt;/ns:TIPO_SERVIZIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione=('CESSAZIONE','MIGRAZIONE')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)=('BRA MONO','BRAMONO','SIMPLEX')&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'ISDN BMO'&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)=('BRA MULTI','BRAMULTI')&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'ISDN BMU'&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale)='ISDN' and upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale)='BRA'&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'ISDN'&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoDNReale, ' ', $Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACPS']/ndm:TipoLineaReale))&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $Start/ndm:SottoLavorazione=('USCITADATI','ATTIVAZIONE274','MIGRAZIONEOLO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA') or ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA') or ($Start/ndm:Lavorazione='CESSAZIONE' and $Start/ndm:SottoLavorazione='NORMALE' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BandaServizio='ISDN PRA')&quot;>&#xa;                            &lt;ns:TIPO_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN PRA'&quot;/>&#xa;                            &lt;/ns:TIPO_SERVIZIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;>&#xa;                                        &lt;ns:TIPO_SERVIZIO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio&quot;/>&#xa;                                        &lt;/ns:TIPO_SERVIZIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR')) and &amp;#x9;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) > 0 and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) = 'ISDN' and upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'SIMPLEX'&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'ISDN BMO'&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRA MONO' or upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRAMONO'&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' BMO'))&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRA MULTI' or upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) = 'BRAMULTI'&quot;>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' BMU'))&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:TIPO_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case(concat($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea, ' ', $Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea))&quot;/>&#xa;                                            &lt;/ns:TIPO_SERVIZIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:CodicePacchettoNow&quot;>&#xa;                        &lt;ns:ID_PACCHETTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:CodicePacchettoNow&quot;/>&#xa;                        &lt;/ns:ID_PACCHETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:IDCorrelazione&quot;>&#xa;                        &lt;ns:ID_PACCHETTO_ORIGINARIO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:IDCorrelazione&quot;/>&#xa;                        &lt;/ns:ID_PACCHETTO_ORIGINARIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'NP'&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2&quot;>&#xa;                            &lt;ns:AGGIUNTIVI>&#xa;                                &lt;xsl:if test=&quot;ndm:Stato&quot;>&#xa;                                    &lt;ns:STATO_AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;ndm:Stato&quot;/>&#xa;                                    &lt;/ns:STATO_AGGIUNTIVO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&#xa;                                    &lt;ns:TEL_AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&#xa;                                    &lt;/ns:TEL_AGGIUNTIVO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;ns:FL_NP_AGGIUNTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                                &lt;/ns:FL_NP_AGGIUNTIVO>&#xa;                            &lt;/ns:AGGIUNTIVI>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BorchiaNT1Plus&quot;>&#xa;                        &lt;ns:BorchiaNT1Plus>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BorchiaNT1Plus&quot;/>&#xa;                        &lt;/ns:BorchiaNT1Plus>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO=&amp;quot;Y&amp;quot;&quot;>&#xa;                            &lt;ns:NUMERAZIONE_DONOR_OLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                            &lt;/ns:NUMERAZIONE_DONOR_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO&quot;>&#xa;                                &lt;ns:NUMERAZIONE_DONOR_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagDNDonorOLO&quot;/>&#xa;                                &lt;/ns:NUMERAZIONE_DONOR_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:STS_L2&quot;>&#xa;                        &lt;ns:ATTIVAZIONE_STS>&#xa;                            &lt;ns:CODICESTS>&#xa;                                &lt;xsl:value-of select=&quot;ndm:CodiceDTU&quot;/>&#xa;                            &lt;/ns:CODICESTS>&#xa;                            &lt;xsl:if test=&quot;ndm:Descrizione&quot;>&#xa;                                &lt;ns:DESCRIZIONESTS>&#xa;                                    &lt;xsl:value-of select=&quot;ndm:Descrizione&quot;/>&#xa;                                &lt;/ns:DESCRIZIONESTS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;ndm:AzioneSTS&quot;/>&#xa;                            &lt;/ns:AZIONE>&#xa;                        &lt;/ns:ATTIVAZIONE_STS>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;(((starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')) and ($Start/ndm:Lavorazione = 'ATTIVAZIONE' or $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'A')) or $Start/ndm:SottoLavorazione = 'DECREMENTONP') or&amp;#xD;&amp;#xA;(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and ($Start/ndm:Lavorazione = 'VARIAZIONE')) or ($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS' and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu!='N' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu))))&quot;>&#xa;                        &lt;ns:DESC_LINEA>&#xa;                            &lt;!--ATTIVAZIONE WLR-VULL O DECREMENTONP-->&#xa;                            &lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:Direzionalita)) != 'NaN'&quot;>&#xa;                                &lt;ns:DIREZIONALITA_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:Direzionalita)&quot;/>&#xa;                                &lt;/ns:DIREZIONALITA_RICHIESTA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaLinee)) != 'NaN'&quot;>&#xa;                                &lt;ns:QUANTITALINEE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaLinee)&quot;/>&#xa;                                &lt;/ns:QUANTITALINEE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SelezionePassante&quot;>&#xa;                                &lt;ns:SELEZIONEPASSANTE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SelezionePassante&quot;/>&#xa;                                &lt;/ns:SELEZIONEPASSANTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AccessoNumerico&quot;>&#xa;                                &lt;ns:ACCESSONUMERICO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AccessoNumerico&quot;/>&#xa;                                &lt;/ns:ACCESSONUMERICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:NumAggiuntivi)) != 'NaN'&quot;>&#xa;                                &lt;ns:NUMAGGIUNTIVI>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:NumAggiuntivi)&quot;/>&#xa;                                &lt;/ns:NUMAGGIUNTIVI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaCanali)) != 'NaN'&quot;>&#xa;                                &lt;ns:QUANTITACANALI>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:QuantitaCanali)&quot;/>&#xa;                                &lt;/ns:QUANTITACANALI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:NumLineeMov)) != 'NaN'&quot;>&#xa;                                &lt;ns:NUMERO_LINEE_MOVIMENTATE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:NumLineeMov)&quot;/>&#xa;                                &lt;/ns:NUMERO_LINEE_MOVIMENTATE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS' and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu!='N' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='ACCESSOCPS']/ndm:InvioADtu))))&amp;#xD;&amp;#xA;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&#xa;                                        &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2[ndm:Azione='A']&quot;>&#xa;                                            &lt;ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                                &lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&#xa;                                                    &lt;ns:NumerazioneAggiuntiva>&#xa;                                                        &lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&#xa;                                                    &lt;/ns:NumerazioneAggiuntiva>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2[ndm:Azione='D']&quot;>&#xa;                                            &lt;ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                                &lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&#xa;                                                    &lt;ns:NumerazioneAggiuntiva>&#xa;                                                        &lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&#xa;                                                    &lt;/ns:NumerazioneAggiuntiva>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) != 'POTS' &amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;(&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'SIMPLEX'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'PBX'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:StrutturaLinea) != 'GNR'   )) and $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta!='CPS'&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Aggiuntivo_L2&quot;>&#xa;                                    &lt;ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(ndm:Azione)>0&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;ndm:Azione&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'WLRLINEAATTIVA' or (starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'WLR') and ../../ndm:LNA_LA = 'LA')&quot;>&#xa;                                            &lt;xsl:if test=&quot;ndm:DirezionalitaAggiuntivo&quot;>&#xa;                                                &lt;ns:DIREZIONALITA>&#xa;                                                    &lt;xsl:value-of select=&quot;ndm:DirezionalitaAggiuntivo&quot;/>&#xa;                                                &lt;/ns:DIREZIONALITA>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ndm:NumeroTelefonico&quot;>&#xa;                                            &lt;ns:NumerazioneAggiuntiva>&#xa;                                                &lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&#xa;                                            &lt;/ns:NumerazioneAggiuntiva>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ndm:IdRisorsaPBX&quot;>&#xa;                                            &lt;ns:ID_RISORSA_PBX>&#xa;                                                &lt;xsl:value-of select=&quot;ndm:IdRisorsaPBX&quot;/>&#xa;                                            &lt;/ns:ID_RISORSA_PBX>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns:NUMERAZIONIAGGIUNTIVE>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL') or $Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='CPS'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta, 'VULL')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Capostipite&quot;>&#xa;                                            &lt;ns:CAPOSTIPITE>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Capostipite&quot;/>&#xa;                                            &lt;/ns:CAPOSTIPITE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Radicale&quot;>&#xa;                                            &lt;ns:CAPOSTIPITE>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Radicale&quot;/>&#xa;                                            &lt;/ns:CAPOSTIPITE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:DESC_LINEA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Lavorazione = 'VARIAZIONE') or ($Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('NP','ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0)&quot;>&#xa;                        &lt;ns:FONIA_VARIAZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione='PASSAGGIOULLD'&quot;>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = 'NP' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'DECREMENTO NP'&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and $Start/ndm:Offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:OloRetailer) > 0&quot;>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'DECREMENTO ULL'&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:SottoLavorazioneDTU&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;starts-with($Start/ndm:SottoLavorazione, 'TRASLOCO') and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = 'ACCESSOWLR'&quot;>&#xa;                                &lt;ns:Trasloco>&#xa;                                    &lt;ns:CodiceTrasloco>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceTrasloco&quot;/>&#xa;                                    &lt;/ns:CodiceTrasloco>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;>&#xa;                                        &lt;ns:FlagMantenimentoProdotti>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagMantenimentoProdotti&quot;/>&#xa;                                        &lt;/ns:FlagMantenimentoProdotti>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns:Trasloco>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione = 'DECREMENTOCANALI' or $Start/ndm:SottoLavorazione = 'INCREMENTOCANALI'&quot;>&#xa;                                &lt;ns:CambioCanali>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:QuantitaLinee_OLD)) != 'NaN'&quot;>&#xa;                                            &lt;ns:QuantitaLinee_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:QuantitaLinee_OLD)&quot;/>&#xa;                                            &lt;/ns:QuantitaLinee_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:Direzionalita_OLD)) != 'NaN'&quot;>&#xa;                                            &lt;ns:Direzionalita_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:Direzionalita_OLD)&quot;/>&#xa;                                            &lt;/ns:Direzionalita_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD&quot;>&#xa;                                                &lt;ns:SelezionePassante_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:SelezionePassante_OLD&quot;/>&#xa;                                                &lt;/ns:SelezionePassante_OLD>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD&quot;>&#xa;                                                &lt;ns:AccessoNumerico_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:AccessoNumerico_OLD&quot;/>&#xa;                                                &lt;/ns:AccessoNumerico_OLD>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns:CambioCanali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIOCOPPIA'&quot;>&#xa;                                &lt;ns:CambioCoppia>&#xa;                                    &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD) > 0&quot;>&#xa;                                        &lt;ns:RIPARTITORE_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 1, 3)&quot;/>&#xa;                                        &lt;/ns:RIPARTITORE_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD) > 0&quot;>&#xa;                                        &lt;ns:COORDOLO_OLD>&#xa;                                            &lt;ns:BLOCCO>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 7, 1)&quot;/>&#xa;                                            &lt;/ns:BLOCCO>&#xa;                                            &lt;ns:MONTANTE>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 4, 3)&quot;/>&#xa;                                            &lt;/ns:MONTANTE>&#xa;                                            &lt;ns:NODO>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 8, 4)&quot;/>&#xa;                                            &lt;/ns:NODO>&#xa;                                            &lt;ns:PAGLIETTA1>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 12, 2)&quot;/>&#xa;                                            &lt;/ns:PAGLIETTA1>&#xa;                                            &lt;ns:PAGLIETTA2>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore1_OLD, 14, 2)&quot;/>&#xa;                                            &lt;/ns:PAGLIETTA2>&#xa;                                        &lt;/ns:COORDOLO_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD) > 0&quot;>&#xa;                                        &lt;ns:COORDOLO_OLD>&#xa;                                            &lt;ns:BLOCCO>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 7, 1)&quot;/>&#xa;                                            &lt;/ns:BLOCCO>&#xa;                                            &lt;ns:MONTANTE>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 4, 3)&quot;/>&#xa;                                            &lt;/ns:MONTANTE>&#xa;                                            &lt;ns:NODO>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 8, 4)&quot;/>&#xa;                                            &lt;/ns:NODO>&#xa;                                            &lt;ns:PAGLIETTA1>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 12, 2)&quot;/>&#xa;                                            &lt;/ns:PAGLIETTA1>&#xa;                                            &lt;ns:PAGLIETTA2>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizionePermutatore2_OLD, 14, 2)&quot;/>&#xa;                                            &lt;/ns:PAGLIETTA2>&#xa;                                        &lt;/ns:COORDOLO_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI1_OLD&quot;>&#xa;                                        &lt;ns:POSIZIONE_ARLTI1_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI1_OLD&quot;/>&#xa;                                        &lt;/ns:POSIZIONE_ARLTI1_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI2_OLD&quot;>&#xa;                                        &lt;ns:POSIZIONE_ARLTI2_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLTI2_OLD&quot;/>&#xa;                                        &lt;/ns:POSIZIONE_ARLTI2_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO1_OLD&quot;>&#xa;                                        &lt;ns:POSIZIONE_ARLOLO1_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO1_OLD&quot;/>&#xa;                                        &lt;/ns:POSIZIONE_ARLOLO1_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO2_OLD&quot;>&#xa;                                        &lt;ns:POSIZIONE_ARLOLO2_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriFoniaOLD/ndm:PosizioneARLOLO2_OLD&quot;/>&#xa;                                        &lt;/ns:POSIZIONE_ARLOLO2_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns:CambioCoppia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIONUMERO3'&quot;>&#xa;                                    &lt;ns:CambioNumero>&#xa;                                        &lt;ns:CodiceCambioNumero>&#xa;                                            &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioNumero>&#xa;                                    &lt;/ns:CambioNumero>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'CAMBIONUMERO4'&quot;>&#xa;                                    &lt;ns:CambioNumero>&#xa;                                        &lt;ns:CodiceCambioNumero>&#xa;                                            &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioNumero>&#xa;                                    &lt;/ns:CambioNumero>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR5'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR6'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR7'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'7'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR18'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'18'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR19'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'19'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione = 'PRESTAZIONEWLR20'&quot;>&#xa;                                    &lt;ns:CambioPrestazione>&#xa;                                        &lt;ns:CodiceCambioPrestazione>&#xa;                                            &lt;xsl:value-of select=&quot;'20'&quot;/>&#xa;                                        &lt;/ns:CodiceCambioPrestazione>&#xa;                                    &lt;/ns:CambioPrestazione>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns:FONIA_VARIAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneTraffico&quot;>&#xa;                        &lt;ns:OPZIONE_TRAFFICO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneTraffico&quot;/>&#xa;                        &lt;/ns:OPZIONE_TRAFFICO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = 'CPS' and $Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLineaReale = ('PBX', 'GNR')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Fatturante&quot;>&#xa;                            &lt;ns:FATTURANTE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Fatturante&quot;/>&#xa;                            &lt;/ns:FATTURANTE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns:SERVIZIO_FONIA>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ndm:SERVIZIO_FONIA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ServizioFonia" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ServizioDati&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Enrich&quot;/>&lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&lt;xsl:param name=&quot;MapValori_OLD&quot;/>&lt;xsl:param name=&quot;DettaglioLavorazione&quot;/>&lt;xsl:param name=&quot;EnrichAccesso&quot;/>&lt;xsl:param name=&quot;FlagOneStep&quot;/>&lt;xsl:param name=&quot;Progetto&quot;/>&lt;xsl:param name=&quot;AnagNGA&quot;/>&lt;xsl:param name=&quot;AnagGBE&quot;/>&lt;xsl:param name=&quot;AnagPDC&quot;/>&lt;xsl:param name=&quot;CalcolaCaratteristicaVlan&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;ServizioDati&quot; match=&quot;/&quot;>&lt;ndm:SERVIZIO_DATI>&lt;xsl:copy-of select=&quot;$ServizioDati/ns:SERVIZIO_DATI&quot;/>&lt;xsl:if test=&quot;not(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZADATI','CONSISTENZARACCOLTA','CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT','CONSISTENZARACCOLTAVLANMULTICAST')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'AWLRSUBTSNAKED'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT','CONSISTENZARACCOLTAVLANMULTICAST')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&lt;ns:SERVIZIO_DATI>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:LNA_LA = 'LNA'&quot;/>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:Offerta=('FEEDER','CANALE')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta='FEEDER'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='CANALE' and  $Start/ndm:SottoLavorazione='CREAZIONECANALEFEEDER'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='CANALE' and  $Start/ndm:SottoLavorazione=('CANALEESISTENTEFEEDER','CANALEESISTENTEOLT')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACANALE']/ndm:IdRisorsa&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACANALE']/ndm:IdRisorsa&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and (starts-with($Start/ndm:Offerta, 'BITSTREAM') or starts-with($Start/ndm:Offerta, 'EASYIP') or $Start/ndm:Offerta = 'VULAFTTCAB') and ($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS' or $Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = ('ACCENSIONE','SPEGNIMENTO') and $Start/ndm:Offerta='VULAFTTCAB' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;( &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;and &amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA'])&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA']/ndm:Azione !='D'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) !='U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:SottoLavorazione = 'PASSAGGIO_LA' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:SottoLavorazione = 'PASSAGGIO_LNF'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) !='U'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&lt;ns:ID_IMPIANTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&lt;/ns:ID_IMPIANTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:value-of select=&quot;$DettaglioLavorazione&quot;/>&lt;/ns:DETTAGLIO_LAVORAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='CANALEESISTENTEOLT' and $Start/ndm:Offerta='CANALE'&quot;>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;&amp;quot;CANALEMCO&amp;quot;&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione=('CREAZIONECANALEFEEDER','CANALEESISTENTEFEEDER') and $Start/ndm:Offerta='CANALE'&quot;>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;&amp;quot;CANALEMCF&amp;quot;&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;&amp;quot;FWA_EOLO&amp;quot;&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:SERVIZIO_RICHIESTO>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU&quot;/>&lt;/ns:SERVIZIO_RICHIESTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ndm:FlagMonitoraggio)>0&quot;>&lt;xsl:if test=&quot;$Start/ndm:FlagMonitoraggio&quot;>&lt;ns:FLAG_MONITORAGGIO>&lt;xsl:value-of select=&quot;$Start/ndm:FlagMonitoraggio&quot;/>&lt;/ns:FLAG_MONITORAGGIO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI) &amp;lt; 9&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;>&lt;ns:CLLI_OLT>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;/>&lt;/ns:CLLI_OLT>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSGBESIM' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'EASYIP-FTTH'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'ETH'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSATMSIM'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:PROTOCOLLO = 'ATM IMA'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'ATM_IMA'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:PROTOCOLLO = 'ATM BONDING'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'ATM_BONDING'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:PROTOCOLLO&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='UBBSEMIGPON' or $Start/ndm:Offerta='SEMIGPON1BPNRR'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'SEMI'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta='UBBFULLGPON' or $Start/ndm:Offerta='FULLGPON1BPNRR'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'FULL'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta=('FIBERSTREAM','FWAITALIA1GIGASARDEGNA')&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'ETH'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta=('FEEDER','CANALE') and $Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&lt;ns:TIPOLOGIA_ACCESSO>&lt;xsl:value-of select=&quot;'ETH'&quot;/>&lt;/ns:TIPOLOGIA_ACCESSO>&