Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP6&quot;>&#xa;                                            &lt;ns:BANDA_COS6_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP6&quot;/>&#xa;                                            &lt;/ns:BANDA_COS6_DOWN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP2_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS2_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP2_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS2_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP3_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS3_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP3_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP5_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS5_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP5_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS5_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP6_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS6_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP6_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS6_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--TIPO_PROTOCOLLO valorizzato solo per GBE-->&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, 'EASY')&quot;/>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($Enrich.output/tns:SottoFamigliaOfferta,'ATM')&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:VpConsOld)=0 and ../../../ndm:Offerta='VULAFTTCAB' and ../../../ndm:SottoLavorazione='RICONFIGURAZIONEVC'&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = 'DEDICATA'&quot;>&#xa;                                                                &lt;xsl:if test=&quot;exists(tns:CODICETD)&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:CODICETD&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:CODICETD&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:if test=&quot;exists(tns:CODICEVP)&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:CODICEVP&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:CODICEVP&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;string-length(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD)>0&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;upper-case(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD) = 'DEDICATA'&quot;>&#xa;                                                                &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = 'DEDICATA'&quot;>&#xa;                                                                &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&#xa;                                                                    &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&#xa;                                                                        &lt;ns:VPCONS_OLD>&#xa;                                                                            &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&#xa;                                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, '0.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld&quot;>&#xa;                                            &lt;ns:MCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld&quot;/>&#xa;                                            &lt;/ns:MCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, '.')&quot;>&#xa;                                        &lt;ns:MCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, '.')&quot;/>&#xa;                                        &lt;/ns:MCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, ',')&quot;>&#xa;                                        &lt;ns:MCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld, ',')&quot;/>&#xa;                                        &lt;/ns:MCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld&quot;>&#xa;                                            &lt;ns:MCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrDnOld&quot;/>&#xa;                                            &lt;/ns:MCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, '.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, ',')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld&quot;>&#xa;                                            &lt;ns:MCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld&quot;/>&#xa;                                            &lt;/ns:MCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, '.')&quot;>&#xa;                                        &lt;ns:MCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, '.')&quot;/>&#xa;                                        &lt;/ns:MCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, ',')&quot;>&#xa;                                        &lt;ns:MCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld, '.')&quot;/>&#xa;                                        &lt;/ns:MCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld&quot;>&#xa;                                            &lt;ns:MCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:McrUpOld&quot;/>&#xa;                                            &lt;/ns:MCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, '0.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld&quot;>&#xa;                                            &lt;ns:PCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld&quot;/>&#xa;                                            &lt;/ns:PCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, '.')&quot;>&#xa;                                        &lt;ns:PCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, '.')&quot;/>&#xa;                                        &lt;/ns:PCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, ',')&quot;>&#xa;                                        &lt;ns:PCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld, ',')&quot;/>&#xa;                                        &lt;/ns:PCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld&quot;>&#xa;                                            &lt;ns:PCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrDnOld&quot;/>&#xa;                                            &lt;/ns:PCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, '0.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld&quot;>&#xa;                                            &lt;ns:PCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld&quot;/>&#xa;                                            &lt;/ns:PCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, '.')&quot;>&#xa;                                        &lt;ns:PCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, '.')&quot;/>&#xa;                                        &lt;/ns:PCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, ',')&quot;>&#xa;                                        &lt;ns:PCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld, ',')&quot;/>&#xa;                                        &lt;/ns:PCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld&quot;>&#xa;                                            &lt;ns:PCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:PcrUpOld&quot;/>&#xa;                                            &lt;/ns:PCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, '0.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld&quot;>&#xa;                                            &lt;ns:SCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld&quot;/>&#xa;                                            &lt;/ns:SCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, '.')&quot;>&#xa;                                        &lt;ns:SCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, '.')&quot;/>&#xa;                                        &lt;/ns:SCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, ',')&quot;>&#xa;                                        &lt;ns:SCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld, ',')&quot;/>&#xa;                                        &lt;/ns:SCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld&quot;>&#xa;                                            &lt;ns:SCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrDnOld&quot;/>&#xa;                                            &lt;/ns:SCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, '0.') or starts-with($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld&quot;>&#xa;                                            &lt;ns:SCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld&quot;/>&#xa;                                            &lt;/ns:SCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, '.')&quot;>&#xa;                                        &lt;ns:SCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, '.')&quot;/>&#xa;                                        &lt;/ns:SCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, ',')&quot;>&#xa;                                        &lt;ns:SCRUP_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld, ',')&quot;/>&#xa;                                        &lt;/ns:SCRUP_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld&quot;>&#xa;                                            &lt;ns:SCRUP_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ATM_Azione[number($posVC1)]/tns:ScrUpOld&quot;/>&#xa;                                            &lt;/ns:SCRUP_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns:VIRT_CHAN>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC&quot;>&#xa;                            &lt;xsl:variable name=&quot;posVC2&quot; select=&quot;position()&quot;/>&#xa;                            &lt;ns:VIRT_CHAN>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'CESSAZIONE'&quot;>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(../../../ndm:SottoLavorazione = 'VARIAZIONETAGGING' or ../../../ndm:SottoLavorazione = 'CAMBIOTIPOVLAN') and tns:AZIONE = 'M'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and&amp;#xD;&amp;#xA;(($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:VpCons !=$MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:VpConsOld and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:VpCons)>0 and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:VpConsOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:ProfiloComm !=$MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:ProfiloCommOld and&amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:ProfiloComm)>0 and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:GBE_Azione[number($posVC2)]/tns:ProfiloCommOld)>0))&amp;#xD;&amp;#xA;and tns:AZIONE = 'M'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;tns:VPI&quot;>&#xa;                                    &lt;ns:VP>&#xa;                                        &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                    &lt;/ns:VP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:VCI&quot;>&#xa;                                    &lt;ns:VC>&#xa;                                        &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                    &lt;/ns:VC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:VPI&quot;>&#xa;                                        &lt;ns:VPI_SP>&#xa;                                            &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                        &lt;/ns:VPI_SP>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:VCI&quot;>&#xa;                                        &lt;ns:VCI_SP>&#xa;                                            &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                        &lt;/ns:VCI_SP>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;!--MCRDN, MCRUP, PCRDN, PCRUP, SCRDN, SCRUP non valorizzati per GBE-->&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[$posVC2]/tns:TIPO_BANDA) = 'MONOCOS'&quot;>&#xa;                                        &lt;ns:CLASSE_DI_SERVIZIO>&#xa;                                            &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS&quot;/>&#xa;                                        &lt;/ns:CLASSE_DI_SERVIZIO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:CLASSE_DI_SERVIZIO>&#xa;                                            &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                        &lt;/ns:CLASSE_DI_SERVIZIO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT'&quot;/>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&#xa;                                            &lt;ns:VPCONS>&#xa;                                                &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                            &lt;/ns:VPCONS>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:CVLANID) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:CVLANID&quot;>&#xa;                                            &lt;ns:CVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&#xa;                                            &lt;/ns:CVLAN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:IPDSLAM) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:IPDSLAM&quot;>&#xa;                                            &lt;ns:IP_DSLAM>&#xa;                                                &lt;xsl:value-of select=&quot;tns:IPDSLAM&quot;/>&#xa;                                            &lt;/ns:IP_DSLAM>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:IPKIT) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:IPKIT&quot;>&#xa;                                            &lt;ns:IP_KIT>&#xa;                                                &lt;xsl:value-of select=&quot;tns:IPKIT&quot;/>&#xa;                                            &lt;/ns:IP_KIT>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:PROFILOBMD) > 0&quot;>&#xa;                                        &lt;ns:TIPO_BANDA>&#xa;                                            &lt;xsl:value-of select=&quot;'DEDICATA'&quot;/>&#xa;                                        &lt;/ns:TIPO_BANDA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:TIPO_BANDA>&#xa;                                            &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                        &lt;/ns:TIPO_BANDA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD' and string-length(string($Enrich.output/tns:Dati[$posVC2]/tns:PROFILO)) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:PROFILO&quot;>&#xa;                                            &lt;ns:PROFILO>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:PROFILO&quot;/>&#xa;                                            &lt;/ns:PROFILO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP2&quot;>&#xa;                                            &lt;ns:BANDA_COS2_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP2&quot;/>&#xa;                                            &lt;/ns:BANDA_COS2_DOWN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP3&quot;>&#xa;                                            &lt;ns:BANDA_COS3_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP3&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3_DOWN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP5&quot;>&#xa;                                            &lt;ns:BANDA_COS5_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP5&quot;/>&#xa;                                            &lt;/ns:BANDA_COS5_DOWN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP6&quot;>&#xa;                                            &lt;ns:BANDA_COS6_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP6&quot;/>&#xa;                                            &lt;/ns:BANDA_COS6_DOWN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP2_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS2_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP2_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS2_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP3_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS3_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP3_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP5_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS5_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP5_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS5_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC2]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP6_MAX&quot;>&#xa;                                            &lt;ns:BANDA_COS6_UP>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC2]/tns:BP6_MAX&quot;/>&#xa;                                            &lt;/ns:BANDA_COS6_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:PROTOCOLLOPILA) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:PROTOCOLLOPILA&quot;>&#xa;                                            &lt;ns:TIPO_PROTOCOLLO>&#xa;                                                &lt;xsl:value-of select=&quot;tns:PROTOCOLLOPILA&quot;/>&#xa;                                            &lt;/ns:TIPO_PROTOCOLLO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MapValori_OLD/tns:GBE_Azione[number(position())]/tns:VpConsOld)=0 and ../../../ndm:Offerta='VULAFTTCAB' and ../../../ndm:SottoLavorazione='RICONFIGURAZIONEVC'&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&#xa;                                            &lt;ns:VPCONS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                            &lt;/ns:VPCONS_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&#xa;                                            &lt;ns:VPCONS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&#xa;                                            &lt;/ns:VPCONS_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns:VIRT_CHAN>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&#xa;                        &lt;ns:VIRT_CHAN>&#xa;                            &lt;ns:AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione&quot;/>&#xa;                            &lt;/ns:AZIONE>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Vpi&quot;>&#xa;                                &lt;ns:VPI_SP>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Vpi&quot;/>&#xa;                                &lt;/ns:VPI_SP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaMcr&quot;>&#xa;                                &lt;ns:MCRDN>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaMcr&quot;/>&#xa;                                &lt;/ns:MCRDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaPcr&quot;>&#xa;                                &lt;ns:PCRDN>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaPcr&quot;/>&#xa;                                &lt;/ns:PCRDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:CLASSE_DI_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;'ABR'&quot;/>&#xa;                            &lt;/ns:CLASSE_DI_SERVIZIO>&#xa;                            &lt;xsl:if test=&quot;not(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, '0.') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, '0,'))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;contains($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, '.')&quot;>&#xa;                                        &lt;ns:MCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, '.')&quot;/>&#xa;                                        &lt;/ns:MCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, ',')&quot;>&#xa;                                        &lt;ns:MCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld, ',')&quot;/>&#xa;                                        &lt;/ns:MCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld&quot;>&#xa;                                            &lt;ns:MCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaMcrOld&quot;/>&#xa;                                            &lt;/ns:MCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not(starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, '0.') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, '0,'))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;contains($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, '.')&quot;>&#xa;                                        &lt;ns:PCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, '.')&quot;/>&#xa;                                        &lt;/ns:PCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, ',')&quot;>&#xa;                                        &lt;ns:PCRDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld, ',')&quot;/>&#xa;                                        &lt;/ns:PCRDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld&quot;>&#xa;                                            &lt;ns:PCRDN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaPcrOld&quot;/>&#xa;                                            &lt;/ns:PCRDN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:VpiOld&quot;>&#xa;                                &lt;ns:VPI_SP_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:VpiOld&quot;/>&#xa;                                &lt;/ns:VPI_SP_OLD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:VIRT_CHAN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='MIGRAZIONE'&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN[tns:AZIONE !='D']&quot;>&#xa;                                    &lt;xsl:variable name=&quot;posUSERVLAN&quot; select=&quot;position()&quot;/>&#xa;                                    &lt;ns:USER_VLAN>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'ATTIVAZIONE' and ../../../ndm:SottoLavorazione !='CAMBIOTECNOLOGIA'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'CESSAZIONE'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'VARIAZIONETAGGING' and tns:AZIONE = 'M'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'CAMBIOTIPOVLAN'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and &amp;#xD;&amp;#xA;(($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpCons !=$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpConsOld and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpConsOld)>0 and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpCons)>0)&amp;#xD;&amp;#xA; or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLan !=$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld  and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLan)>0 and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld)>0)) and tns:AZIONE = 'M'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;>&#xa;                                                    &lt;ns:PCRDN>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;/>&#xa;                                                    &lt;/ns:PCRDN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '.')&quot;>&#xa;                                                &lt;ns:PCRDN>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '.')&quot;/>&#xa;                                                &lt;/ns:PCRDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, ',')&quot;>&#xa;                                                &lt;ns:PCRDN>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, ',')&quot;/>&#xa;                                                &lt;/ns:PCRDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;>&#xa;                                                    &lt;ns:PCRDN>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;/>&#xa;                                                    &lt;/ns:PCRDN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;>&#xa;                                                    &lt;ns:PCRUP>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;/>&#xa;                                                    &lt;/ns:PCRUP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '.')&quot;>&#xa;                                                &lt;ns:PCRUP>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '.')&quot;/>&#xa;                                                &lt;/ns:PCRUP>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, ',')&quot;>&#xa;                                                &lt;ns:PCRUP>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, ',')&quot;/>&#xa;                                                &lt;/ns:PCRUP>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;>&#xa;                                                    &lt;ns:PCRUP>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;/>&#xa;                                                    &lt;/ns:PCRUP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;>&#xa;                                                    &lt;ns:PCRDN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;/>&#xa;                                                    &lt;/ns:PCRDN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '.')&quot;>&#xa;                                                &lt;ns:PCRDN_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '.')&quot;/>&#xa;                                                &lt;/ns:PCRDN_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, ',')&quot;>&#xa;                                                &lt;ns:PCRDN_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, ',')&quot;/>&#xa;                                                &lt;/ns:PCRDN_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;>&#xa;                                                    &lt;ns:PCRDN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;/>&#xa;                                                    &lt;/ns:PCRDN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;>&#xa;                                                    &lt;ns:PCRUP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;/>&#xa;                                                    &lt;/ns:PCRUP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '.')&quot;>&#xa;                                                &lt;ns:PCRUP_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '.')&quot;/>&#xa;                                                &lt;/ns:PCRUP_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, ',')&quot;>&#xa;                                                &lt;ns:PCRUP_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, ',')&quot;/>&#xa;                                                &lt;/ns:PCRUP_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;>&#xa;                                                    &lt;ns:PCRUP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;/>&#xa;                                                    &lt;/ns:PCRUP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA') and tns:FLAGMULTICAST!='SI'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FIBERSTREAM'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:PROFILOVLAN&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;tns:FLAGMULTICAST='SI'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MONOCOS'&quot;>&#xa;                                                        &lt;ns:CLASSE_SERVIZIO>&#xa;                                                            &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS&quot;/>&#xa;                                                        &lt;/ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:CLASSE_SERVIZIO>&#xa;                                                            &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                        &lt;/ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(tns:FLAGMULTICAST='SI') or (../../ndm:Offerta = ('FWAITALIA1GIGASARDEGNA'))&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../ndm:Offerta = ('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS')&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'DEDICATA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../ndm:Offerta = ('FIBERSTREAM')&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;not(exists(tns:PROFILOBMD))&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;tns:BMCLIGHT='Y'&quot;>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MONOCOS'&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BMCLIGHT='Y'&quot;>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MULTICOS' and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS) = 'BMC'&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BMCLIGHT='Y'&quot;>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'DEDICATA'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0 and tns:SVLANCODE !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                &lt;ns:VPCONS>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                                &lt;/ns:VPCONS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FIBERSTREAM'&quot;>&#xa;                                                &lt;ns:VPCONS>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:SERVICEVLAN&quot;/>&#xa;                                                &lt;/ns:VPCONS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:VPCONS>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/ns:VPCONS>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU!='CAMBIO_TIPO_VLAN'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length(tns:ValoriDatiOLD/tns:SvLanCode_OLD)=0 and string-length(tns:ValoriDatiOLD/tns:CvLanID_OLD)>0 and ../../../ndm:Offerta=('VULAFTTCAB','VULAFTTH','BITSTREAMNGAFTTH','SEMIBISTREAMNGAFTTH','SEMIVULAFTTH','BITSTREAMNGAFTTCAB') and ../../../ndm:SottoLavorazione='RICONFIGURAZIONEVC'&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0&quot;>&#xa;                                                            &lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&#xa;                                                                &lt;ns:VPCONS_OLD>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                                                &lt;/ns:VPCONS_OLD>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:VPCONS_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                            &lt;/ns:VPCONS_OLD>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&#xa;                                                        &lt;ns:VPCONS_OLD>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&#xa;                                                        &lt;/ns:VPCONS_OLD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(string-length(tns:CVLANID) > 0 and tns:CVLANID !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;) or ($Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:CVLANID&quot;>&#xa;                                                    &lt;ns:CVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&#xa;                                                    &lt;/ns:CVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FIBERSTREAM'&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:CUSTOMERVLAN&quot;>&#xa;                                                    &lt;ns:CVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:CUSTOMERVLAN&quot;/>&#xa;                                                    &lt;/ns:CVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:CVLAN>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/ns:CVLAN>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld&quot;>&#xa;                                            &lt;ns:CVLAN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld&quot;/>&#xa;                                            &lt;/ns:CVLAN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD' and string-length(string($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:PROFILO)) > 0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:PROFILO&quot;>&#xa;                                                    &lt;ns:PROFILO>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:PROFILO&quot;/>&#xa;                                                    &lt;/ns:PROFILO>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP2&quot;>&#xa;                                                    &lt;ns:BANDA_COS2_DOWN>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP2&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS2_DOWN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP3&quot;>&#xa;                                                    &lt;ns:BANDA_COS3_DOWN>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP3&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS3_DOWN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP5&quot;>&#xa;                                                    &lt;ns:BANDA_COS5_DOWN>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP5&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS5_DOWN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BP6&quot;>&#xa;                                                    &lt;ns:BANDA_COS6_DOWN>&#xa;                                                       