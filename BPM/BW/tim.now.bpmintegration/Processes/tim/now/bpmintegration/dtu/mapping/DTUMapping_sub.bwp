                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Enrich.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;MapValori_OLD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VariazioneAzione>&#xa;            &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC&quot;>&#xa;                    &lt;tns:ATM_Azione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, &amp;quot;EASY&amp;quot;)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($Enrich.output/tns:SottoFamigliaOfferta, 'ATM')&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = &amp;quot;DEDICATA&amp;quot;&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:CODICETD&quot;>&#xa;                                                    &lt;tns:VpCons>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:CODICETD&quot;/>&#xa;                                                    &lt;/tns:VpCons>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;tns:CODICEVP&quot;>&#xa;                                                    &lt;tns:VpCons>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:CODICEVP&quot;/>&#xa;                                                    &lt;/tns:VpCons>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, &amp;quot;EASY&amp;quot;)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($Enrich.output/tns:SottoFamigliaOfferta, 'ATM')&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD)>0&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD) = 'DEDICATA'&quot;>&#xa;                                                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&#xa;                                                            &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&#xa;                                                                &lt;tns:VpConsOld>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&#xa;                                                                &lt;/tns:VpConsOld>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&#xa;                                                            &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&#xa;                                                                &lt;tns:VpConsOld>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&#xa;                                                                &lt;/tns:VpConsOld>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = 'DEDICATA'&quot;>&#xa;                                                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&#xa;                                                            &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&#xa;                                                                &lt;tns:VpConsOld>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&#xa;                                                                &lt;/tns:VpConsOld>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&#xa;                                                            &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&#xa;                                                                &lt;tns:VpConsOld>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&#xa;                                                                &lt;/tns:VpConsOld>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&#xa;                            &lt;tns:ProfiloComm>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&#xa;                            &lt;/tns:ProfiloComm>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&#xa;                            &lt;tns:ProfiloCommOld>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                            &lt;/tns:ProfiloCommOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:MCRDOWN&quot;>&#xa;                            &lt;tns:McrDn>&#xa;                                &lt;xsl:value-of select=&quot;tns:MCRDOWN&quot;/>&#xa;                            &lt;/tns:McrDn>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:McrDown_OLD&quot;>&#xa;                            &lt;tns:McrDnOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:McrDown_OLD&quot;/>&#xa;                            &lt;/tns:McrDnOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:MCRUP&quot;>&#xa;                            &lt;tns:McrUp>&#xa;                                &lt;xsl:value-of select=&quot;tns:MCRUP&quot;/>&#xa;                            &lt;/tns:McrUp>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:McrUp_OLD&quot;>&#xa;                            &lt;tns:McrUpOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:McrUp_OLD&quot;/>&#xa;                            &lt;/tns:McrUpOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:PCRDOWN&quot;>&#xa;                            &lt;tns:PcrDn>&#xa;                                &lt;xsl:value-of select=&quot;tns:PCRDOWN&quot;/>&#xa;                            &lt;/tns:PcrDn>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrDown_OLD&quot;>&#xa;                            &lt;tns:PcrDnOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrDown_OLD&quot;/>&#xa;                            &lt;/tns:PcrDnOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:PCRUP&quot;>&#xa;                            &lt;tns:PcrUp>&#xa;                                &lt;xsl:value-of select=&quot;tns:PCRUP&quot;/>&#xa;                            &lt;/tns:PcrUp>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrUp_OLD&quot;>&#xa;                            &lt;tns:PcrUpOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrUp_OLD&quot;/>&#xa;                            &lt;/tns:PcrUpOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:SCRDOWN&quot;>&#xa;                            &lt;tns:ScrDn>&#xa;                                &lt;xsl:value-of select=&quot;tns:SCRDOWN&quot;/>&#xa;                            &lt;/tns:ScrDn>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:ScrDown_OLD&quot;>&#xa;                            &lt;tns:ScrDnOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:ScrDown_OLD&quot;/>&#xa;                            &lt;/tns:ScrDnOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:SCRUP&quot;>&#xa;                            &lt;tns:ScrUp>&#xa;                                &lt;xsl:value-of select=&quot;tns:SCRUP&quot;/>&#xa;                            &lt;/tns:ScrUp>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:ScrUp_OLD&quot;>&#xa;                            &lt;tns:ScrUpOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:ScrUp_OLD&quot;/>&#xa;                            &lt;/tns:ScrUpOld>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ATM_Azione>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC&quot;>&#xa;                    &lt;tns:GBE_Azione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&#xa;                                    &lt;tns:VpCons>&#xa;                                        &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                    &lt;/tns:VpCons>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VpCons>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns:VpCons>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&#xa;                            &lt;tns:VpConsOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&#xa;                            &lt;/tns:VpConsOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:CVLANID&quot;>&#xa;                            &lt;tns:CvLan>&#xa;                                &lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&#xa;                            &lt;/tns:CvLan>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;>&#xa;                            &lt;tns:CvLanOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;/>&#xa;                            &lt;/tns:CvLanOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&#xa;                            &lt;tns:ProfiloComm>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&#xa;                            &lt;/tns:ProfiloComm>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&#xa;                            &lt;tns:ProfiloCommOld>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                            &lt;/tns:ProfiloCommOld>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:GBE_Azione>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN&quot;>&#xa;                    &lt;tns:UserVlan_Azione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&#xa;                                    &lt;tns:VpCons>&#xa;                                        &lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&#xa;                                    &lt;/tns:VpCons>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VpCons>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns:VpCons>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&#xa;                            &lt;tns:VpConsOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&#xa;                            &lt;/tns:VpConsOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:CVLANID&quot;>&#xa;                            &lt;tns:CvLan>&#xa;                                &lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&#xa;                            &lt;/tns:CvLan>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;>&#xa;                            &lt;tns:CvLanOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;/>&#xa;                            &lt;/tns:CvLanOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&#xa;                            &lt;tns:ProfiloComm>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&#xa;                            &lt;/tns:ProfiloComm>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&#xa;                            &lt;tns:ProfiloCommOld>&#xa;                                &lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                            &lt;/tns:ProfiloCommOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:BANDAPICCODOWN&quot;>&#xa;                            &lt;tns:PcrDn_BandaPicDn>&#xa;                                &lt;xsl:value-of select=&quot;tns:BANDAPICCODOWN&quot;/>&#xa;                            &lt;/tns:PcrDn_BandaPicDn>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrDown_BandaPicDn_OLD&quot;>&#xa;                            &lt;tns:PcrDnOld_BandaPicDnOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrDown_BandaPicDn_OLD&quot;/>&#xa;                            &lt;/tns:PcrDnOld_BandaPicDnOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:BANDAPICCOUP&quot;>&#xa;                            &lt;tns:PcrUp_BandaPicUp>&#xa;                                &lt;xsl:value-of select=&quot;tns:BANDAPICCOUP&quot;/>&#xa;                            &lt;/tns:PcrUp_BandaPicUp>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrUp_BandaPicUp_OLD&quot;>&#xa;                            &lt;tns:PcrUpOld_BandaPicUpOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrUp_BandaPicUp_OLD&quot;/>&#xa;                            &lt;/tns:PcrUpOld_BandaPicUpOld>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:Uservlan_OLD&quot;>&#xa;                            &lt;tns:UservlanOld>&#xa;                                &lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:Uservlan_OLD&quot;/>&#xa;                            &lt;/tns:UservlanOld>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:UserVlan_Azione>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and ($Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA')&quot;>&#xa;                    &lt;tns:ModalitaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/tns:ModalitaAccesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and  tib:trim(upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:MODELLO_ACCS)) = 'FIXED'&quot;>&#xa;                            &lt;tns:ModalitaAccesso>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns:ModalitaAccesso>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and  tib:trim(upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:MODELLO_ACCS)) = 'RATE ADAPTIVE'&quot;>&#xa;                            &lt;tns:ModalitaAccesso>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:ModalitaAccesso>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:MODELLO_ACCS_OLD) = 'RATE ADAPTIVE' and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;tns:ModalitaAccessoOLD>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/tns:ModalitaAccessoOLD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:MODELLO_ACCS_OLD) = 'FIXED' and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;tns:ModalitaAccessoOLD>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/tns:ModalitaAccessoOLD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;XDSL&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modulazione = '1'&quot;>&#xa;                            &lt;tns:ChannelType>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelType>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modulazione = '0'&quot;>&#xa;                            &lt;tns:ChannelType>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelType>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea) and upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'INTERLEAVED'&quot;>&#xa;                            &lt;tns:ChannelType>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelType>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea) and (upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'ALL' or upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'FAST')&quot;>&#xa;                            &lt;tns:ChannelType>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelType>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;XDSL&amp;quot; and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Modulazione_OLD = '1'&quot;>&#xa;                            &lt;tns:ChannelTypeOLD>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelTypeOLD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Modulazione_OLD = '0'&quot;>&#xa;                            &lt;tns:ChannelTypeOLD>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelTypeOLD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;NGA&amp;quot; and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD) and upper-case($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'INTERLEAVED'&quot;>&#xa;                            &lt;tns:ChannelTypeOLD>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelTypeOLD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD) and (upper-case($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'ALL' or upper-case($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'FAST')&quot;>&#xa;                            &lt;tns:ChannelTypeOLD>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                            &lt;/tns:ChannelTypeOLD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:VariazioneAzione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:DTUEnrichment="http://www.tim.com/NOW/xsd/DTUEnrichment/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="DTUEnrichment:VariazioneAzione" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogStruttura-input"
                                    name="LogStruttura"
                                    tibex:xpdlId="5309c80a-991c-404f-85ad-8e54c097f7ed"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="StrutturaRichiestaToCopy_1_LogIn"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_LogInToEnrich"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SelStrutturaRich&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStruttura-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Determina Struttura Richiesta&amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;if(count($SelStrutturaRich/Record) > 0) then concat(&amp;quot;Da SelectStrutturaRich: &amp;quot;, tib:render-xml($SelStrutturaRich/Record[1], true(), true()), &amp;quot; | Da Assign: &amp;quot;, $StrutturaRichiesta) else &amp;quot;Nessun record trovato per l'OFFERTA, impossibile ricavare la STRUTTURA RICHIESTA&amp;quot;&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Enrich&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;EnrichAccesso&quot;/>&#xa;    &lt;xsl:template name=&quot;EnrichAccesso&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, &amp;quot;ACCESSO&amp;quot;) or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='DATIRICARICA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:ScenarioDTU='NPDEL82' or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, &amp;quot;RACCOLTAVLAN&amp;quot;) or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente=&amp;quot;RACCOLTAVP&amp;quot;&quot;>&#xa;                &lt;ndm:EnrichAccessoMapper>&#xa;                    &lt;ndm:EnrichAccessoType>&#xa;                        &lt;xsl:if test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:NomeOLO&quot;>&#xa;                            &lt;ndm:NomeOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:NomeOLO&quot;/>&#xa;                            &lt;/ndm:NomeOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU&quot;>&#xa;                            &lt;ndm:OffertaDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU&quot;/>&#xa;                            &lt;/ndm:OffertaDTU>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ScenarioDTU&quot;>&#xa;                            &lt;ndm:ScenarioDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:ScenarioDTU&quot;/>&#xa;                            &lt;/ndm:ScenarioDTU>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:SottoLavorazioneDTU&quot;>&#xa;                            &lt;ndm:SottoLavDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:SottoLavorazioneDTU&quot;/>&#xa;                            &lt;/ndm:SottoLavDTU>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ndm:EnrichAccessoType>&#xa;                &lt;/ndm:EnrichAccessoMapper>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($EnrichAccesso)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$EnrichAccesso&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ndm:EnrichAccessoMapper>&#xa;                    &lt;ndm:EnrichAccessoType/>&#xa;                &lt;/ndm:EnrichAccessoMapper>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="EnrichAccesso"
                                    name="Assign_EnrichAccesso"
                                    outputVariable="EnrichAccesso"
                                    tibex:xpdlId="551793b8-1981-47b0-a8ed-5310d038f63b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_DettLavorazioneToAssign_EnrichAccesso"/>
                                    <bpws:target linkName="Empty1ToAssign_EnrichAccesso"/>
                                    <bpws:target linkName="CalcolaCaratteristicaVlanToAssign_EnrichAccesso"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign_EnrichAccessoToMapValori_XDSLNGAFIBERSTREAM">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($StrutturaRichiesta = 'NGA' or $StrutturaRichiesta = 'XDSL' or $StrutturaRichiesta = 'FIBERSTREAM') and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione != 'T' and $Start/ns1:Fonia_Dati[number($index)]/ns1:NomeComponente != &quot;NUMBERPORTABILITY&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($StrutturaRichiesta = 'NGA' or $StrutturaRichiesta = 'XDSL' or $StrutturaRichiesta = 'FIBERSTREAM') and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione != 'T' and $Start/ns1:Fonia_Dati[number($index)]/ns1:NomeComponente != "NUMBERPORTABILITY"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Assign_EnrichAccessoToAssignFonia">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($StrutturaRichiesta = 'NPG' or $StrutturaRichiesta = 'REGOLATORIO' or $Start/ns1:Fonia_Dati[number($index)]/ns1:NomeComponente = 'NUMBERPORTABILITY') and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione != 'T'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($StrutturaRichiesta = 'NPG' or $StrutturaRichiesta = 'REGOLATORIO' or $Start/ns1:Fonia_Dati[number($index)]/ns1:NomeComponente = 'NUMBERPORTABILITY') and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione != 'T']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Assign_AzioneT">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Enrich.output&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;EnrichAccesso&quot;/>&#xa;    &lt;xsl:template name=&quot;EnrichAccesso&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, &amp;quot;ACCESSO&amp;quot;) or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='DATIRICARICA' or $Enrich.output/tns:ScenarioDTU='NPDEL82' or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, &amp;quot;RACCOLTAVLAN&amp;quot;) or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente=&amp;quot;RACCOLTAVP&amp;quot;&quot;>&#xa;                &lt;ndm:EnrichAccessoMapper>&#xa;                    &lt;ndm:EnrichAccessoType>&#xa;                        &lt;xsl:if test=&quot;$Enrich.output/tns:NomeOLO&quot;>&#xa;                            &lt;ndm:NomeOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:NomeOLO&quot;/>&#xa;                            &lt;/ndm:NomeOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich.output/tns:OffertaDTU&quot;>&#xa;                            &lt;ndm:OffertaDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:OffertaDTU&quot;/>&#xa;                            &lt;/ndm:OffertaDTU>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich.output/tns:ScenarioDTU&quot;>&#xa;                            &lt;ndm:ScenarioDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:ScenarioDTU&quot;/>&#xa;                            &lt;/ndm:ScenarioDTU>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Enrich.output/tns:SottoLavorazioneDTU&quot;>&#xa;                            &lt;ndm:SottoLavDTU>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:SottoLavorazioneDTU&quot;/>&#xa;                            &lt;/ndm:SottoLavDTU>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ndm:EnrichAccessoType>&#xa;                &lt;/ndm:EnrichAccessoMapper>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($EnrichAccesso)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$EnrichAccesso&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ndm:EnrichAccessoMapper>&#xa;                    &lt;ndm:EnrichAccessoType/>&#xa;                &lt;/ndm:EnrichAccessoMapper>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="EnrichAccesso" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DettaglioLavorazione"
                                    name="DettLavorazione"
                                    outputVariable="DettaglioLavorazione"
                                    tibex:xpdlId="64ded825-9492-4e6c-b3a0-7d50141c2a32" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EnrichToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCopy_1_LogStruttura"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($Start/ns1:Lavorazione = 'CESSAZIONE' or ($Start/ns1:Lavorazione = 'MIGRAZIONE' and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione = 'D') or ($Start/ns1:Lavorazione = 'ATTIVAZIONE' and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione = 'D' and ($Start/ns1:SottoLavorazione = 'ATTIVAZIONE274' or not(exists($Start/ns1:LNA_LA)) or $Start/ns1:LNA_LA != 'LNA')) or ($Start/ns1:Lavorazione = 'ATTIVAZIONE' and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione = 'D' and $Start/ns1:SottoLavorazione = 'CAMBIOTECNOLOGIA' and $Start/ns1:LNA_LA = 'LNA')) then 'DIS'&#xd;&#xa;else if($Start/ns1:Lavorazione = 'ATTIVAZIONE' or ($Start/ns1:Lavorazione = 'MIGRAZIONE' and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione = 'A')) then 'ATT' &#xd;&#xa;else if($Start/ns1:Lavorazione = 'VARIAZIONE' or ($Start/ns1:Lavorazione = 'MIGRAZIONE' and $Start/ns1:Fonia_Dati[number($index)]/ns1:Azione = 'M') or $Start/ns1:Lavorazione = 'SPEGNIMENTO' or $Start/ns1:Lavorazione = 'ACCENSIONE') then 'VAR'&#xd;&#xa;else if($Start/ns1:Lavorazione = 'ATTIVAZIONE' and $Start/ns1:Offerta='FWAITALIA1GIGASARDEGNA') then 'Attivazione' else if ($Start/ns1:Lavorazione = 'MIGRAZIONE' and $Start/ns1:Offerta='FIBERSTREAM' and $Start/ns1:SottoLavorazione='RIENTRIDEL82') then 'ATT'&#xd;&#xa;else &quot;&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DettaglioLavorazione" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDettLavorazione-input"
                                    name="LogDettLavorazione"
                                    tibex:xpdlId="37f7b52b-0c86-4973-9738-552e87674f69"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCopy_1_LogStruttura"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_DettLavorazioneToAssign_EnrichAccesso">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogDettLavorazioneToEmpty_VlanMulticast">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta=('VLAN','VLANNGA','VLANVULA','CANALE','FEEDER')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta=('VLAN','VLANNGA','VLANVULA','CANALE','FEEDER')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogDettLavorazioneToCalcolaCaratteristicaVlan">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioLavorazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DettLavorazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Determina dettaglio lavorazione: &amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioLavorazione&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logg