osUSERVLAN)]/tns:DATI_OLD[1]/tns:BP2_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS2_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS3_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS3_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP5_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS5_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP5_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS5_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP6_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS6_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP6_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS6_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case(../../ndm:UserVlan1Tagging) = 'UNTAGGED'&quot;/>&#xa;                                            &lt;xsl:when test=&quot;upper-case(../../ndm:UserVlan1Tagging) = 'TAGGED' or $Start/ndm:Offerta = ('BITSTREAMGBESIMMETRICOFLAT','FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:USERVLANID&quot;>&#xa;                                                    &lt;ns:USERVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:USERVLANID&quot;/>&#xa;                                                    &lt;/ns:USERVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FIBERSTREAM'&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:USERVLAN&quot;>&#xa;                                                    &lt;ns:USERVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:USERVLAN&quot;/>&#xa;                                                    &lt;/ns:USERVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:UservlanOld&quot;>&#xa;                                            &lt;ns:USERVLAN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:UservlanOld&quot;/>&#xa;                                            &lt;/ns:USERVLAN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Enrich.output/tns:SottoFamigliaOfferta = 'GBE' and tns:FLAGMULTICAST!='SI'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) >0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA = 'MONOCOS' and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = '3'&quot;>&#xa;                                                        &lt;ns:TIPO_TRAFFICO>&#xa;                                                            &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                        &lt;/ns:TIPO_TRAFFICO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_TRAFFICO>&#xa;                                                            &lt;xsl:value-of select=&quot;'U'&quot;/>&#xa;                                                        &lt;/ns:TIPO_TRAFFICO>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;tns:FLAGMULTICAST='SI'&quot;>&#xa;                                                &lt;ns:TIPO_TRAFFICO>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:TIPO_TRAFFICO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;tns:PROTOCOLLOPILA&quot;>&#xa;                                            &lt;ns:TIPO_PROTOCOLLO>&#xa;                                                &lt;xsl:value-of select=&quot;tns:PROTOCOLLOPILA&quot;/>&#xa;                                            &lt;/ns:TIPO_PROTOCOLLO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns:USER_VLAN>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN&quot;>&#xa;                                    &lt;xsl:variable name=&quot;posUSERVLAN&quot; select=&quot;position()&quot;/>&#xa;                                    &lt;ns:USER_VLAN>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'ATTIVAZIONE' and ../../../ndm:SottoLavorazione !='CAMBIOTECNOLOGIA'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'CESSAZIONE'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'VARIAZIONETAGGING' and tns:AZIONE = 'M'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'CAMBIOTIPOVLAN'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and &amp;#xD;&amp;#xA;(($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpCons !=$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpConsOld and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpConsOld)>0 and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:VpCons)>0)&amp;#xD;&amp;#xA; or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLan !=$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld  and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLan)>0 and string-length($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:CvLanOld)>0)) and tns:AZIONE = 'M'&quot;>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                        &lt;/ns:AZIONE>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;>&#xa;                                                    &lt;ns:PCRDN>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;/>&#xa;                                                    &lt;/ns:PCRDN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '.')&quot;>&#xa;                                                &lt;ns:PCRDN>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, '.')&quot;/>&#xa;                                                &lt;/ns:PCRDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, ',')&quot;>&#xa;                                                &lt;ns:PCRDN>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn, ',')&quot;/>&#xa;                                                &lt;/ns:PCRDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;>&#xa;                                                    &lt;ns:PCRDN>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDn_BandaPicDn&quot;/>&#xa;                                                    &lt;/ns:PCRDN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;>&#xa;                                                    &lt;ns:PCRUP>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;/>&#xa;                                                    &lt;/ns:PCRUP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '.')&quot;>&#xa;                                                &lt;ns:PCRUP>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, '.')&quot;/>&#xa;                                                &lt;/ns:PCRUP>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, ',')&quot;>&#xa;                                                &lt;ns:PCRUP>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp, ',')&quot;/>&#xa;                                                &lt;/ns:PCRUP>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;>&#xa;                                                    &lt;ns:PCRUP>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUp_BandaPicUp&quot;/>&#xa;                                                    &lt;/ns:PCRUP>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;>&#xa;                                                    &lt;ns:PCRDN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;/>&#xa;                                                    &lt;/ns:PCRDN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '.')&quot;>&#xa;                                                &lt;ns:PCRDN_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, '.')&quot;/>&#xa;                                                &lt;/ns:PCRDN_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, ',')&quot;>&#xa;                                                &lt;ns:PCRDN_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld, ',')&quot;/>&#xa;                                                &lt;/ns:PCRDN_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;>&#xa;                                                    &lt;ns:PCRDN_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrDnOld_BandaPicDnOld&quot;/>&#xa;                                                    &lt;/ns:PCRDN_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '0.') or starts-with($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '0,')&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;>&#xa;                                                    &lt;ns:PCRUP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;/>&#xa;                                                    &lt;/ns:PCRUP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '.')&quot;>&#xa;                                                &lt;ns:PCRUP_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, '.')&quot;/>&#xa;                                                &lt;/ns:PCRUP_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, ',')&quot;>&#xa;                                                &lt;ns:PCRUP_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld, ',')&quot;/>&#xa;                                                &lt;/ns:PCRUP_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;>&#xa;                                                    &lt;ns:PCRUP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:PcrUpOld_BandaPicUpOld&quot;/>&#xa;                                                    &lt;/ns:PCRUP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA') and tns:FLAGMULTICAST!='SI'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FIBERSTREAM'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:PROFILOVLAN&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;tns:FLAGMULTICAST='SI'&quot;>&#xa;                                                &lt;ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                &lt;/ns:CLASSE_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MONOCOS'&quot;>&#xa;                                                        &lt;ns:CLASSE_SERVIZIO>&#xa;                                                            &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS&quot;/>&#xa;                                                        &lt;/ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:CLASSE_SERVIZIO>&#xa;                                                            &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                        &lt;/ns:CLASSE_SERVIZIO>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(tns:FLAGMULTICAST='SI') or (../../ndm:Offerta = ('FWAITALIA1GIGASARDEGNA'))&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../ndm:Offerta = ('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS')&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'DEDICATA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../ndm:Offerta = ('FIBERSTREAM')&quot;>&#xa;                                                &lt;ns:TIPO_BANDA>&#xa;                                                    &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                                                &lt;/ns:TIPO_BANDA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;not(exists(tns:PROFILOBMD))&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;tns:BMCLIGHT='Y'&quot;>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MONOCOS'&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BMCLIGHT='Y'&quot;>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA) = 'MULTICOS' and upper-case($Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS) = 'BMC'&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:BMCLIGHT='Y'&quot;>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA_LIGHT'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns:TIPO_BANDA>&#xa;                                                                    &lt;xsl:value-of select=&quot;'CONDIVISA'&quot;/>&#xa;                                                                &lt;/ns:TIPO_BANDA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_BANDA>&#xa;                                                            &lt;xsl:value-of select=&quot;'DEDICATA'&quot;/>&#xa;                                                        &lt;/ns:TIPO_BANDA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0 and tns:SVLANCODE !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                &lt;ns:VPCONS>&#xa;                       