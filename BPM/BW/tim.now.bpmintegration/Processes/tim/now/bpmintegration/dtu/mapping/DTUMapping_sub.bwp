                       &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, 'EASY')&quot;/>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;starts-with($Enrich.output/tns:SottoFamigliaOfferta, 'ATM')&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = 'DEDICATA'&quot;>&#xa;                                                        &lt;xsl:if test=&quot;tns:CODICETD&quot;>&#xa;                                                            &lt;ns:VPCONS>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:CODICETD&quot;/>&#xa;                                                            &lt;/ns:VPCONS>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;tns:CODICEVP&quot;>&#xa;                                                            &lt;ns:VPCONS>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:CODICEVP&quot;/>&#xa;                                                            &lt;/ns:VPCONS>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--CVLAN, USERVLAN, IP_DSLAM, IP_KIT valorizzati solo per GBE-->&#xa;                                &lt;ns:TIPO_BANDA>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case(tns:TIPOBANDACONSEGNA)&quot;/>&#xa;                                &lt;/ns:TIPO_BANDA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD' and string-length($Enrich.output/tns:Dati[$posVC1]/tns:PROFILO) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:PROFILO&quot;>&#xa;                                            &lt;ns:PROFILO>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:PROFILO&quot;/>&#xa;                                            &lt;/ns:PROFILO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:Dati[$posVC1]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP2&quot;>&#xa;                                            &lt;ns:BANDA_COS2_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[$posVC1]/tns:BP2&quot;/>&#xa;                                            &lt;/ns:BANDA_COS2_DOWN>&#xa;      