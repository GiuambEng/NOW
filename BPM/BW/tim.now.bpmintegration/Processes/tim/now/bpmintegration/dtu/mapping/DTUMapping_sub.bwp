)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP2_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS2_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP2_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS2_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS3_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP3_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS3_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP5_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS5_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP5_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS5_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati/tns:DATI_OLD) > 0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = 'BMD'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP6_MAX_OLD&quot;>&#xa;                                                    &lt;ns:BANDA_COS6_UP_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:DATI_OLD[1]/tns:BP6_MAX_OLD&quot;/>&#xa;                                                    &lt;/ns:BANDA_COS6_UP_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case(../../ndm:UserVlan1Tagging) = 'UNTAGGED'&quot;/>&#xa;                                            &lt;xsl:when test=&quot;upper-case(../../ndm:UserVlan1Tagging) = 'TAGGED' or $Start/ndm:Offerta = ('BITSTREAMGBESIMMETRICOFLAT','FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:USERVLANID&quot;>&#xa;                                                    &lt;ns:USERVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:USERVLANID&quot;/>&#xa;                                                    &lt;/ns:USERVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FIBERSTREAM'&quot;>&#xa;                                                &lt;xsl:if test=&quot;tns:USERVLAN&quot;>&#xa;                                                    &lt;ns:USERVLAN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:USERVLAN&quot;/>&#xa;                                                    &lt;/ns:USERVLAN>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:UservlanOld&quot;>&#xa;                                            &lt;ns:USERVLAN_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:UserVlan_Azione[number($posUSERVLAN)]/tns:UservlanOld&quot;/>&#xa;                                            &lt;/ns:USERVLAN_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Enrich.output/tns:SottoFamigliaOfferta = 'GBE' and tns:FLAGMULTICAST!='SI'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) >0 and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_BANDA = 'MONOCOS' and $Enrich.output/tns:Dati[number($posUSERVLAN)]/tns:TIPO_COS = '3'&quot;>&#xa;                                                        &lt;ns:TIPO_TRAFFICO>&#xa;                                                            &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                        &lt;/ns:TIPO_TRAFFICO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns:TIPO_TRAFFICO>&#xa;                                                            &lt;xsl:value-of select=&quot;'U'&quot;/>&#xa;                                                        &lt;/ns:TIPO_TRAFFICO>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;tns:FLAGMULTICAST='SI'&quot;>&#xa;                                                &lt;ns:TIPO_TRAFFICO>&#xa;                                                    &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                                &lt;/ns:TIPO_TRAFFICO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;tns:PROTOCOLLOPILA&quot;>&#xa;                                            &lt;ns:TIPO_PROTOCOLLO>&#xa;                                                &lt;xsl:value-of select=&quot;tns:PROTOCOLLOPILA&quot;/>&#xa;                                            &lt;/ns:TIPO_PROTOCOLLO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns:USER_VLAN>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Enrich.output/tns:FamigliaOfferta = 'EASYIP' or starts-with($Enrich.output/tns:OffertaDTU, 'EASYIP-FTT')&quot;>&#xa;                        &lt;ns:ACCIP>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'L2TP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'CLASSICALIP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'RACCOLTA_BACKBONE_IP_TI'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:INDIRIZZAMENTO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;'DINAMICO'&quot;/>&#xa;                                    &lt;/ns:INDIRIZZAMENTO_CF>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:INDIRIZZAMENTO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;'STATICO'&quot;/>&#xa;                                    &lt;/ns:INDIRIZZAMENTO_CF>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '2'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '3'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '4'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '6'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '7'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '8'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns:ACCIP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Modem) and $Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Codice !='M00') or (exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Splitter) and $Start/ndm:Fonia_Dati[number($index)]/ndm:Splitter/ndm:Codice !='0')&quot;>&#xa;                        &lt;ns:PRODOTTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Modem)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM) = &amp;quot;MODEM 2 MBIT/S&amp;quot;&quot;>&#xa;                                            &lt;ns:COD>&#xa;                                                &lt;xsl:value-of select=&quot;'W-MOD2'&quot;/>&#xa;                                            &lt;/ns:COD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM) = &amp;quot;MODEM 4 MBIT/S&amp;quot;&quot;>&#xa;                                            &lt;ns:COD>&#xa;                                                &lt;xsl:value-of select=&quot;'W-MOD4'&quot;/>&#xa;                                            &lt;/ns:COD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM) = &amp;quot;MODEM 6 MBIT/S&amp;quot;&quot;>&#xa;                                            &lt;ns:COD>&#xa;                                                &lt;xsl:value-of select=&quot;'W-MOD6'&quot;/>&#xa;                                            &lt;/ns:COD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and upper-case($Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM) = 'MODEM 8 MBIT/S'&quot;>&#xa;                                            &lt;ns:COD>&#xa;                                                &lt;xsl:value-of select=&quot;'W-MOD8'&quot;/>&#xa;                                            &lt;/ns:COD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:COD>&#xa;                                                &lt;xsl:value-of select=&quot;'W-MOD2'&quot;/>&#xa;                                            &lt;/ns:COD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:COD>&#xa;                                        &lt;xsl:value-of select=&quot;'W-SPL'&quot;/>&#xa;                                    &lt;/ns:COD>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Modem)&quot;>&#xa;                                    &lt;ns:TIPO>&#xa;                                        &lt;xsl:value-of select=&quot;'MODEM'&quot;/>&#xa;                                    &lt;/ns:TIPO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO>&#xa;                                        &lt;xsl:value-of select=&quot;'SPLITTER'&quot;/>&#xa;                                    &lt;/ns:TIPO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Modem) and exists($Enrich.output/tns:ProfiloTcncLinea)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM&quot;>&#xa;                                        &lt;ns:DESCRIZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:COD_MODEM&quot;/>&#xa;                                        &lt;/ns:DESCRIZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:DESCRIZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'SPLITTER'&quot;/>&#xa;                                    &lt;/ns:DESCRIZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns:QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/ns:QUANTITA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RitiroProdotti='C'&quot;>&#xa;                                    &lt;ns:RITIRO>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/ns:RITIRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RitiroProdotti&quot;>&#xa;                                        &lt;ns:RITIRO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:RitiroProdotti&quot;/>&#xa;                                        &lt;/ns:RITIRO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns:PRODOTTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = ('VARIAZIONE', 'ACCENSIONE', 'SPEGNIMENTO')&quot;>&#xa;                        &lt;ns:DATI_VARIAZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:SottoLavorazione='VARIAZIONEBANDA' and $Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:Offerta=('VLAN','VLANNGA','VLANVULA')&quot;>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'RICONFIGURAZIONE VC'&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_VARIAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU&quot;/>&#xa;                                    &lt;/ns:TIPO_VARIAZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;($EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU = 'PASSAGGIO_LNF' or $EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU = 'PASSAGGIO_LA') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Distretto_OLD) > 0&quot;>&#xa;                                &lt;ns:CD_DISTRETTO_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('0', string(xsd:int($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Distretto_OLD)))&quot;/>&#xa;                                &lt;/ns:CD_DISTRETTO_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;($EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU = 'PASSAGGIO_LNF' or $EnrichAccesso/ndm:EnrichAccessoType/ndm:SottoLavDTU = 'PASSAGGIO_LA') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NumeroTelefonico_OLD) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NumeroTelefonico_OLD&quot;>&#xa;                                    &lt;ns:CD_NUMERO_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NumeroTelefonico_OLD&quot;/>&#xa;                                    &lt;/ns:CD_NUMERO_OLD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea_OLD) > 0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea_OLD) = 'ISDN' or upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea_OLD) = 'LINEANONFONIA'&quot;>&#xa;                                        &lt;ns:ISDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                                        &lt;/ns:ISDN_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:ISDN_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                        &lt;/ns:ISDN_OLD>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta=('VLAN','VLANNGA','VLANVULA','VP') and $Start/ndm:SottoLavorazione='VARIAZIONETDKIT'&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:TdKitOld&quot;>&#xa;                                    &lt;ns:TD_OLO_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:TdKitOld&quot;/>&#xa;                                    &lt;/ns:TD_OLO_OLD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio_OLD&quot;>&#xa;                                &lt;ns:TIPO_SERVIZIO_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoServizio_OLD&quot;/>&#xa;                                &lt;/ns:TIPO_SERVIZIO_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$MapValori_OLD/tns:ModalitaAccessoOLD&quot;>&#xa;                                &lt;ns:MODALITA_ACCESSO_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ModalitaAccessoOLD&quot;/>&#xa;                                &lt;/ns:MODALITA_ACCESSO_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$MapValori_OLD/tns:ChannelTypeOLD&quot;>&#xa;                                &lt;ns:CHANNEL_TYPE_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ChannelTypeOLD&quot;/>&#xa;                                &lt;/ns:CHANNEL_TYPE_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '0'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;'L2TP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD ='2' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '3' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '4' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '6' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '7' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD= '8'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;'RACCOLTA_BACKBONE_IP_TI'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '5'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;'CLASSICALIP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '5'&quot;>&#xa;                                            &lt;ns:INDIRIZZAMENTO_CF_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'DINAMICO'&quot;/>&#xa;                                            &lt;/ns:INDIRIZZAMENTO_CF_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:INDIRIZZAMENTO_CF_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'STATICO'&quot;/>&#xa;                                            &lt;/ns:INDIRIZZAMENTO_CF_OLD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '5'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '2'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '3'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '4'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '6'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '7'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ModalitaConsegna_OLD = '8'&quot;>&#xa;                                            &lt;ns:SUBNET_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                            &lt;/ns:SUBNET_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_COMMERCIALE_DOWN_OLD&quot;>&#xa;                                &lt;ns:VELACCDOWN_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_COMMERCIALE_DOWN_OLD&quot;/>&#xa;                                &lt;/ns:VELACCDOWN_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_COMMERCIALE_UP_OLD&quot;>&#xa;                                &lt;ns:VELACCUP_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_COMMERCIALE_UP_OLD&quot;/>&#xa;                                &lt;/ns:VELACCUP_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_DOWN_MAX_OLD&quot;>&#xa;                                &lt;ns:AGGDOWNMIN_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_DOWN_MAX_OLD&quot;/>&#xa;                                &lt;/ns:AGGDOWNMIN_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_DOWN_MIN_OLD&quot;>&#xa;                                &lt;ns:AGGDOWNMAX_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_DOWN_MIN_OLD&quot;/>&#xa;                                &lt;/ns:AGGDOWNMAX_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_UP_MIN_OLD&quot;>&#xa;                                &lt;ns:AGGUPMIN_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_UP_MIN_OLD&quot;/>&#xa;                                &lt;/ns:AGGUPMIN_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_UP_MAX_OLD&quot;>&#xa;                                &lt;ns:AGGUPMAX_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:VELOCITA_AGGANCIO_UP_MAX_OLD&quot;/>&#xa;                                &lt;/ns:AGGUPMAX_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = ('ACCENSIONE', 'SPEGNIMENTO')&quot;>&#xa;                                    &lt;ns:PROFILOCOMM_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:PROFILOCOMM_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&#xa;                                        &lt;ns:PROFILOCOMM_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                                        &lt;/ns:PROFILOCOMM_OLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente=('RACCOLTAVLANGBE','RACCOLTAVLANNGA') and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:IdCarOld) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:IdCarOld)>0&quot;>&#xa;                                &lt;ns:IDCAR_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('CAR',$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:IdCarOld)&quot;/>&#xa;                                &lt;/ns:IDCAR_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN')&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:IdVlanOloOld&quot;>&#xa;                                    &lt;ns:IDVLAN_OLO_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:IdVlanOloOld&quot;/>&#xa;                                    &lt;/ns:IDVLAN_OLO_OLD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAV')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVLANNGA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='1'&quot;>&#xa;                                                &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&#xa;                                                &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='2'&quot;>&#xa;                                                &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;'SUPERMACROAREA_CC'&quot;/>&#xa;                                                &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='3'&quot;>&#xa;                                                &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;'SUPERMACROAREA_LIB'&quot;/>&#xa;                                                &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld&quot;>&#xa;                                                    &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld&quot;/>&#xa;                                                    &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))) and not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld)) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;>&#xa;                                                    &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;/>&#xa;                                                    &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld)))&amp;#x9;and not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaCommOld)) and not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld))&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea=('1','2','3') and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea)))&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroArea&quot;>&#xa;                                                            &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroArea&quot;/>&#xa;                                                            &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea=('0') or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:SuperMacroArea))) and (exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm)) and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea))) and not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:NomeMacroAreaComm))&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm&quot;>&#xa;                                                            &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANNGA']/ndm:NomeMacroAreaComm&quot;/>&#xa;                                                            &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVLANGBE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='1'&quot;>&#xa;                                                &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                    &lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&#xa;                                                &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))) and  exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;>&#xa;                                                    &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;/>&#xa;                                                    &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld='0' or not(exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:SuperMacroAreaOld))&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:SuperMacroArea=('1') and ($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea='0' or not(exists($Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZARACCOLTA']/ndm:SuperMacroArea)))&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:NomeMacroArea&quot;>&#xa;                                                            &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='RACCOLTAVLANGBE']/ndm:NomeMacroArea&quot;/>&#xa;                                                            &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVLANVULA' or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;>&#xa;                                            &lt;ns:NOMEMACROAREA_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:NomeMacroAreaOld&quot;/>&#xa;                                            &lt;/ns:NOMEMACROAREA_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:UserVlan1Tagging_OLD&quot;>&#xa;                                &lt;ns:TIPO_USERVLAN_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:UserVlan1Tagging_OLD&quot;/>&#xa;                                &lt;/ns:TIPO_USERVLAN_OLD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaRicarica)>0&quot;>&#xa;                                &lt;ns:DATI_RICARICA>&#xa;                                    &lt;ns:TIPOLOGIA_RICARICA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaRicarica&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_RICARICA>&#xa;                                    &lt;ns:DATA_RIC_ESEC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:DataRicEsec&quot;/>&#xa;                                    &lt;/ns:DATA_RIC_ESEC>&#xa;                                    &lt;ns:ORA_RIC_ESEC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OraRicEsec&quot;/>&#xa;                                    &lt;/ns:ORA_RIC_ESEC>&#xa;                                &lt;/ns:DATI_RICARICA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloDnsParentalControl&quot;>&#xa;                                    &lt;ns:PROFILO_DNS_PARENTAL_CONTROL>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloDnsParentalControl&quot;/>&#xa;                                    &lt;/ns:PROFILO_DNS_PARENTAL_CONTROL>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:DATI_VARIAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:OpzioneDinamica = 'Y'&quot;>&#xa;                        &lt;ns:DINAMICO>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/ns:DINAMICO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterPrimario&quot;>&#xa;                            &lt;ns:CODICE_SPLITTER_PRIMARIO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterPrimario&quot;/>&#xa;                            &lt;/ns:CODICE_SPLITTER_PRIMARIO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterSecondario&quot;>&#xa;                            &lt;ns:CODICE_SPLITTER_SECONDARIO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceSplitterSecondario&quot;/>&#xa;                            &lt;/ns:CODICE_SPLITTER_SECONDARIO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceROE&quot;>&#xa;                            &lt;ns:CODICE_ROE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:CodiceROE&quot;/>&#xa;                            &lt;/ns:CODICE_ROE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:RequestType = 'NOTIFICA_OL_FF'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:PosizioneMorsettieraROE&quot;>&#xa;                            &lt;ns:POSIZIONE_MORSETTIERA_ROE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlashFiber/ndm:PosizioneMorsettieraROE&quot;/>&#xa;                            &lt;/ns:POSIZIONE_MORSETTIERA_ROE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 1, 1) !='U'&quot;>&#xa;                                    &lt;ns:ID_RISORSA_ISDN>&#xa;                                        &lt;xsl:value-of select=&quot;(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN, 13)))&quot;/>&#xa;                                    &lt;/ns:ID_RISORSA_ISDN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&#xa;                                    &lt;xsl:if test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN)&quot;>&#xa;                                        &lt;ns:ID_RISORSA_ISDN>&#xa;                                            &lt;xsl:value-of select=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN)&quot;/>&#xa;                                        &lt;/ns:ID_RISORSA_ISDN>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN&quot;>&#xa;                                        &lt;ns:ID_RISORSA_ISDN>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaISDN&quot;/>&#xa;                                        &lt;/ns:ID_RISORSA_ISDN>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;count($Progetto/Record) > 0 &amp;#xD;&amp;#xA;and (($Start/ndm:Lavorazione='ATTIVAZIONE' or ($Start/ndm:Lavorazione='MIGRAZIONE' and count($Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'CONSISTENZA')]) > 0)) &amp;#xD;&amp;#xA;and (($Start/ndm:FlagNaked='S' and $Start/ndm:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB')) &amp;#xD;&amp;#xA;or $Start/ndm:Offerta = ('BITSTREAMNGAFTTH','VULAFTTH','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH','EASYIPNGAFTTCAB','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','UBBSEMIGPON'))) or ($Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR'))&quot;>&#xa;                        &lt;ns:ONE_STEP>&#xa;                            &lt;xsl:value-of select=&quot;$FlagOneStep&quot;/>&#xa;                        &lt;/ns:ONE_STEP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = ('ATTIVAZIONE','MIGRAZIONE') and not(starts-with($Start/ndm:Offerta, 'EASYIP'))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Qualifica&quot;>&#xa;                            &lt;ns:QUALIFICA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Qualifica&quot;/>&#xa;                            &lt;/ns:QUALIFICA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta=('BITSTREAMNGAFTTCAB','VULAFTTCAB') and $Start/ndm:Lavorazione=('ATTIVAZIONE','MIGRAZIONE')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$FlagOneStep='SI' and upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)='LINEANONFONIA'&quot;>&#xa;                                &lt;ns:TEST2>&#xa;                                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                                &lt;/ns:TEST2>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Test2&quot;>&#xa;                                    &lt;ns:TEST2>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Test2&quot;/>&#xa;                                    &lt;/ns:TEST2>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;>&#xa;                        &lt;ns:CODICE_LOTTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;/>&#xa;                        &lt;/ns:CODICE_LOTTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaVlan&quot;>&#xa;                        &lt;ns:TIPOLOGIA_VLAN>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipologiaVlan&quot;/>&#xa;                        &lt;/ns:TIPOLOGIA_VLAN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta='VLAN'&quot;>&#xa;                            &lt;xsl:if test=&quot;$AnagGBE/Record[1]/DESCRIZIONE_CLLI&quot;>&#xa;                                &lt;ns:DESC_CLE_ATT>&#xa;                                    &lt;xsl:value-of select=&quot;$AnagGBE/Record[1]/DESCRIZIONE_CLLI&quot;/>&#xa;                                &lt;/ns:DESC_CLE_ATT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta=('FEEDER','CANALE')&quot;>&#xa;                            &lt;xsl:if test=&quot;$AnagPDC/Record[1]/DESCRIZIONE_CLLI_PDC&quot;>&#xa;                                &lt;ns:DESC_CLE_ATT>&#xa;                                    &lt;xsl:value-of select=&quot;$AnagPDC/Record[1]/DESCRIZIONE_CLLI_PDC&quot;/>&#xa;                                &lt;/ns:DESC_CLE_ATT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$AnagNGA/Record[1]/NOME_CENTRALE&quot;>&#xa;                                &lt;ns:DESC_CLE_ATT>&#xa;                                    &lt;xsl:value-of select=&quot;$AnagNGA/Record[1]/NOME_CENTRALE&quot;/>&#xa;                                &lt;/ns:DESC_CLE_ATT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:Modello)='MADR'&quot;>&#xa;                            &lt;ns:MODELLO>&#xa;                                &lt;xsl:value-of select=&quot;'MACROAREA'&quot;/>&#xa;                            &lt;/ns:MODELLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:Modello)='ADR'&quot;>&#xa;                            &lt;ns:MODELLO>&#xa;                                &lt;xsl:value-of select=&quot;'ADR'&quot;/>&#xa;                            &lt;/ns:MODELLO>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliPdc&quot;>&#xa;                        &lt;ns:CLLIPDC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliPdc&quot;/>&#xa;                        &lt;/ns:CLLIPDC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAV') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'ACCESSOFEEDER')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'ACCESSOFEEDER')&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;>&#xa;                                    &lt;ns:NOMEMACROAREA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;/>&#xa;                                    &lt;/ns:NOMEMACROAREA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLANNGA')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SuperMacroArea='1'&quot;>&#xa;                                        &lt;ns:NOMEMACROAREA>&#xa;                                            &lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&#xa;                                        &lt;/ns:NOMEMACROAREA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SuperMacroArea='2'&quot;>&#xa;                                        &lt;ns:NOMEMACROAREA>&#xa;                                            &lt;xsl:value-of select=&quot;'SUPERMACROAREA_CC'&quot;/>&#xa;                                        &lt;/ns:NOMEMACROAREA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SuperMacroArea='3'&quot;>&#xa;                                        &lt;ns:NOMEMACROAREA>&#xa;                                            &lt;xsl:value-of select=&quot;'SUPERMACROAREA_LIB'&quot;/>&#xa;                                        &lt;/ns:NOMEMACROAREA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroAreaComm) &amp;#xD;&amp;#xA;and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroAreaComm)>0 &amp;#xD;&amp;#xA;and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroAreaComm!='ATTRIBUTO IN ELIMINAZIONE'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroAreaComm&quot;>&#xa;                                                    &lt;ns:NOMEMACROAREA>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroAreaComm&quot;/>&#xa;                                                    &lt;/ns:NOMEMACROAREA>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;>&#xa;                                                    &lt;ns:NOMEMACROAREA>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;/>&#xa;                                                    &lt;/ns:NOMEMACROAREA>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLANGBE')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:SuperMacroArea='1'&quot;>&#xa;                                        &lt;ns:NOMEMACROAREA>&#xa;                                            &lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&#xa;                                        &lt;/ns:NOMEMACROAREA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;>&#xa;                                            &lt;ns:NOMEMACROAREA>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;/>&#xa;                                            &lt;/ns:NOMEMACROAREA>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLANVULA') or starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVP')&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;>&#xa;                                    &lt;ns:NOMEMACROAREA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;/>&#xa;                                    &lt;/ns:NOMEMACROAREA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($Start/ndm:Offerta='VLANNGA' and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE','VARIAZIONE')) or ($Start/ndm:Offerta='VLANVULA' and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE'))&quot;>&#xa;                            &lt;ns:VLAN_TRANSLATION>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns:VLAN_TRANSLATION>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:VlanTranslation&quot;>&#xa;                                &lt;ns:VLAN_TRANSLATION>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:VlanTranslation&quot;/>&#xa;                                &lt;/ns:VLAN_TRANSLATION>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdVlanOlo&quot;>&#xa;                        &lt;ns:IDVLAN_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdVlanOlo&quot;/>&#xa;                        &lt;/ns:IDVLAN_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoOfferta&quot;>&#xa;                        &lt;ns:TIPO_OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoOfferta&quot;/>&#xa;                        &lt;/ns:TIPO_OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA','FEEDER')&quot;>&#xa;                        &lt;ns:VLANFTTX>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione='M'&quot;>&#xa;                                    &lt;ns:AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                    &lt;/ns:AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione&quot;/>&#xa;                                    &lt;/ns:AZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA') and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:IdCar) and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdCar)>0&quot;>&#xa;                                &lt;ns:IDCAR>&#xa;                                    &lt;xsl:value-of select=&quot;concat('CAR',$Start/ndm:Fonia_Dati[number($index)]/ndm:IdCar)&quot;/>&#xa;                                &lt;/ns:IDCAR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('2','3') or $Start/ndm:Offerta='VLANVULA'&quot;>&#xa;                                    &lt;ns:COS>&#xa;                                        &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                                    &lt;/ns:COS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:COS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdentificativoCos&quot;/>&#xa;                                    &lt;/ns:COS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&#xa;                                    &lt;ns:TIPO_BANDA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;DEDICATA&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_BANDA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='2' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BmcLight='SI'&quot;>&#xa;                                    &lt;ns:TIPO_BANDA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CONDIVISA LIGHT&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_BANDA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_BANDA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CONDIVISA&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_BANDA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA') and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE')&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoTraffico&quot;>&#xa;                                    &lt;ns:TIPO_TRAFFICO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoTraffico&quot;/>&#xa;                                    &lt;/ns:TIPO_TRAFFICO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' and $Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&#xa;                                        &lt;ns:BANDA_COS3_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS3_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos3Old&quot;>&#xa;                                            &lt;ns:BANDA_COS3_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos3Old&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&#xa;                                        &lt;ns:BANDA_COS3_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS3_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' and $Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&#xa;                                        &lt;ns:BANDA_COS5_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS5_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos5Old&quot;>&#xa;                                            &lt;ns:BANDA_COS5_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos5Old&quot;/>&#xa;                                            &lt;/ns:BANDA_COS5_OLD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&#xa;                                        &lt;ns:BANDA_COS5_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS5_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;>&#xa;                                &lt;ns:TD_KIT>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;/>&#xa;                                &lt;/ns:TD_KIT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA','FEEDER')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&#xa;                                        &lt;ns:BANDA_COS3>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS3>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FEEDER'&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;>&#xa;                                            &lt;ns:BANDA_COS3>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;>&#xa;                                            &lt;ns:BANDA_COS3>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;/>&#xa;                                            &lt;/ns:BANDA_COS3>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&#xa;                                        &lt;ns:BANDA_COS3>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS3>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&#xa;                                        &lt;ns:BANDA_COS5>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS5>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos5&quot;>&#xa;                                            &lt;ns:BANDA_COS5>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos5&quot;/>&#xa;                                            &lt;/ns:BANDA_COS5>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&#xa;                                        &lt;ns:BANDA_COS5>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ns:BANDA_COS5>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Offerta = 'VLANNGA' and $Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly&quot;>&#xa;                                    &lt;ns:FTTHONLY>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly&quot;/>&#xa;                                    &lt;/ns:FTTHONLY>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeBouquet&quot;>&#xa;                                &lt;ns:NOME_BOUQUET>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeBouquet&quot;/>&#xa;                                &lt;/ns:NOME_BOUQUET>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaFeeder&quot;>&#xa;                                &lt;ns:BANDA_FEEDER>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaFeeder&quot;/>&#xa;                                &lt;/ns:BANDA_FEEDER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AsNumber&quot;>&#xa;                                &lt;ns:AS_NUMBER>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AsNumber&quot;/>&#xa;                                &lt;/ns:AS_NUMBER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSessione&quot;>&#xa;                                &lt;ns:IP_SEZIONE_BGP>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSessione&quot;/>&#xa;                                &lt;/ns:IP_SEZIONE_BGP>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:VLANFTTX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdGpon&quot;>&#xa;                        &lt;ns:IDGPON>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdGpon&quot;/>&#xa;                        &lt;/ns:IDGPON>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdArmadio&quot;>&#xa;                        &lt;ns:IDARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdArmadio&quot;/>&#xa;                        &lt;/ns:IDARMADIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&#xa;                        &lt;ns:CARATTERIZZAZIONE_GPON>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ONESTOP&amp;quot;&quot;/>&#xa;                        &lt;/ns:CARATTERIZZAZIONE_GPON>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&#xa;                        &lt;ns:OPERATORETE>&#xa;                            &lt;xsl:value-of select=&quot;'FIBERCOP'&quot;/>&#xa;                        &lt;/ns:OPERATORETE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Coinvestimento&quot;>&#xa;                        &lt;ns:COINVESTIMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Coinvestimento&quot;/>&#xa;                        &lt;/ns:COINVESTIMENTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta=('SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Semifibra&quot;>&#xa;                            &lt;ns:SEMIFIBRA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Semifibra&quot;/>&#xa;                            &lt;/ns:SEMIFIBRA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('CANALE')&quot;>&#xa;                        &lt;ns:CANALEMC>&#xa;                            &lt;ns:AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                            &lt;/ns:AZIONE>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPMulticast&quot;>&#xa;                                &lt;ns:IPMULTICAST>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPMulticast&quot;/>&#xa;                                &lt;/ns:IPMULTICAST>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSorgente&quot;>&#xa;                                &lt;ns:IPSORGENTE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSorgente&quot;/>&#xa;                                &lt;/ns:IPSORGENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione = ('CREAZIONECANALEFEEDER','CANALEESISTENTEFEEDER')&quot;>&#xa;                                    &lt;ns:TIPO_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_APPARATO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione = 'CANALEESISTENTEOLT'&quot;>&#xa;                                    &lt;ns:TIPO_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_APPARATO>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliCentrale&quot;>&#xa;                                &lt;ns:CLLI_APPARATO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliCentrale&quot;/>&#xa;                                &lt;/ns:CLLI_APPARATO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:CANALEMC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLANVULA')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IntermediateAgentDhcp&quot;>&#xa;                            &lt;ns:INTERMEDIATE_AGENT_DHCP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IntermediateAgentDhcp&quot;/>&#xa;                            &lt;/ns:INTERMEDIATE_AGENT_DHCP>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneGeo&quot;>&#xa;                        &lt;ns:CARATTERIZZAZIONE_GEOGRAFICA>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneGeo&quot;/>&#xa;                        &lt;/ns:CARATTERIZZAZIONE_GEOGRAFICA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta=('FIBERSTREAM')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:identificativodelpop&quot;>&#xa;                            &lt;ns:ID_PCN>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:identificativodelpop&quot;/>&#xa;                            &lt;/ns:ID_PCN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati/ndm:Linea&quot;>&#xa;                        &lt;ns:LINEA>&#xa;                            &lt;ns:NUMERO_TELEFONICO>&#xa;                                &lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&#xa;                            &lt;/ns:NUMERO_TELEFONICO>&#xa;                            &lt;xsl:if test=&quot;ndm:TipoNumerazione&quot;>&#xa;                                &lt;ns:TIPO_NUMERAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;ndm:TipoNumerazione&quot;/>&#xa;                                &lt;/ns:TIPO_NUMERAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:LINEA>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Offerta = ('VULAFTTH','SEMIVULAFTTH','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH' ,'UBBSEMIGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR') and $Start/ndm:Lavorazione = ('ATTIVAZIONE')) or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:SottoLavorazione='MIGRAZIONEDEL82')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:SottoLavorazione='MIGRAZIONEDEL82'&quot;>&#xa;                                &lt;ns:NRCU_OT>&#xa;                                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                                &lt;/ns:NRCU_OT>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NRCU_OT&quot;>&#xa;                                    &lt;ns:NRCU_OT>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NRCU_OT&quot;/>&#xa;                                    &lt;/ns:NRCU_OT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta = 'FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDVlanEOLO&quot;>&#xa;                            &lt;ns:ID_VLAN_EOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDVlanEOLO&quot;/>&#xa;                            &lt;/ns:ID_VLAN_EOLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = ('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','FULLGPONPLUSNGA')&quot;>&#xa;                            &lt;xsl:if test=&quot;$CalcolaCaratteristicaVlan/ndm:CaratteristicaVlan&quot;>&#xa;                                &lt;ns:CARATTERIZZAZIONE_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;$CalcolaCaratteristicaVlan/ndm:CaratteristicaVlan&quot;/>&#xa;                                &lt;/ns:CARATTERIZZAZIONE_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta ='VLANNGA' and not($Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan='ATTRIBUTO IN ELIMINAZIONE')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan&quot;>&#xa;                                &lt;ns:CARATTERIZZAZIONE_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan&quot;/>&#xa;                                &lt;/ns:CARATTERIZZAZIONE_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta = 'FIBERSTREAM'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneArea&quot;>&#xa;                            &lt;ns:CARATTERIZZAZIONE_FS>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneArea&quot;/>&#xa;                            &lt;/ns:CARATTERIZZAZIONE_FS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Offerta = ('FULLGPONPLUS','FULLGPONPLUSNGA') and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')) or ($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = ('FULLGPONPLUS','FULLGPONPLUSNGA') and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='CONSISTENZADATI' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione='D')&quot;>&#xa;                        &lt;ns:FULLGPONPLUS>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/ns:FULLGPONPLUS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'SEMIGPON1BPNRR' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&#xa;                            &lt;ns:TIPO_ACCESSO_UBB>&#xa;                                &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                            &lt;/ns:TIPO_ACCESSO_UBB>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FULLGPON1BPNRR' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&#xa;                            &lt;ns:TIPO_ACCESSO_UBB>&#xa;                                &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                            &lt;/ns:TIPO_ACCESSO_UBB>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $DettaglioLavorazione = 'DIS' and string-length($Start/ndm:Cluster) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Cluster&quot;>&#xa;                            &lt;ns:CLUSTER>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Cluster&quot;/>&#xa;                            &lt;/ns:CLUSTER>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and  ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:SottoLavorazione='RICONFIGURAZIONEIP') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0&quot;>&#xa;                        &lt;ns:ACCIP_OLD>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'L2TP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'CLASSICALIP'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:MODALITA_CONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;'RACCOLTA_BACKBONE_IP_TI'&quot;/>&#xa;                                    &lt;/ns:MODALITA_CONSEGNA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:INDIRIZZAMENTO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;'DINAMICO'&quot;/>&#xa;                                    &lt;/ns:INDIRIZZAMENTO_CF>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:INDIRIZZAMENTO_CF>&#xa;                                        &lt;xsl:value-of select=&quot;'STATICO'&quot;/>&#xa;                                    &lt;/ns:INDIRIZZAMENTO_CF>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '2'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '3'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '4'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '6'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '7'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '8'&quot;>&#xa;                                    &lt;ns:SUBNET>&#xa;                                        &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                    &lt;/ns:SUBNET>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns:ACCIP_OLD>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns:SERVIZIO_DATI>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ndm:SERVIZIO_DATI>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ServizioDati" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
