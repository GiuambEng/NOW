;xsl:value-of select=&quot;'M'&quot;/>&lt;/ns:COS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COS>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdentificativoCos&quot;/>&lt;/ns:COS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&lt;ns:TIPO_BANDA>&lt;xsl:value-of select=&quot;&amp;quot;DEDICATA&amp;quot;&quot;/>&lt;/ns:TIPO_BANDA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='2' and $Start/ndm:Fonia_Dati[number($index)]/ndm:BmcLight='SI'&quot;>&lt;ns:TIPO_BANDA>&lt;xsl:value-of select=&quot;&amp;quot;CONDIVISA LIGHT&amp;quot;&quot;/>&lt;/ns:TIPO_BANDA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_BANDA>&lt;xsl:value-of select=&quot;&amp;quot;CONDIVISA&amp;quot;&quot;/>&lt;/ns:TIPO_BANDA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA') and $Start/ndm:Lavorazione=('ATTIVAZIONE','CESSAZIONE')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoTraffico&quot;>&lt;ns:TIPO_TRAFFICO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoTraffico&quot;/>&lt;/ns:TIPO_TRAFFICO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' and $Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&lt;ns:BANDA_COS3_OLD>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS3_OLD>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos3Old&quot;>&lt;ns:BANDA_COS3_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos3Old&quot;/>&lt;/ns:BANDA_COS3_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&lt;ns:BANDA_COS3_OLD>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS3_OLD>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' and $Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&lt;ns:BANDA_COS5_OLD>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS5_OLD>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos5Old&quot;>&lt;ns:BANDA_COS5_OLD>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:BandaCos5Old&quot;/>&lt;/ns:BANDA_COS5_OLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&lt;ns:BANDA_COS5_OLD>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS5_OLD>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;>&lt;ns:TD_KIT>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;/>&lt;/ns:TD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA','FEEDER')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&lt;ns:BANDA_COS3>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS3>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FEEDER'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;>&lt;ns:BANDA_COS3>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;/>&lt;/ns:BANDA_COS3>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;>&lt;ns:BANDA_COS3>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos3&quot;/>&lt;/ns:BANDA_COS3>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&lt;ns:BANDA_COS3>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS3>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLAN','VLANNGA','VLANVULA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'VLANVULA'&quot;>&lt;ns:BANDA_COS5>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS5>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan=('1','2')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos5&quot;>&lt;ns:BANDA_COS5>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaCos5&quot;/>&lt;/ns:BANDA_COS5>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FamigliaVlan='3'&quot;>&lt;ns:BANDA_COS5>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:BANDA_COS5>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = 'VLANNGA' and $Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly='Y'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly&quot;>&lt;ns:FTTHONLY>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FtthOnly&quot;/>&lt;/ns:FTTHONLY>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeBouquet&quot;>&lt;ns:NOME_BOUQUET>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeBouquet&quot;/>&lt;/ns:NOME_BOUQUET>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaFeeder&quot;>&lt;ns:BANDA_FEEDER>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:BandaFeeder&quot;/>&lt;/ns:BANDA_FEEDER>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AsNumber&quot;>&lt;ns:AS_NUMBER>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:AsNumber&quot;/>&lt;/ns:AS_NUMBER>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSessione&quot;>&lt;ns:IP_SEZIONE_BGP>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSessione&quot;/>&lt;/ns:IP_SEZIONE_BGP>&lt;/xsl:if>&lt;/ns:VLANFTTX>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdGpon&quot;>&lt;ns:IDGPON>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdGpon&quot;/>&lt;/ns:IDGPON>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdArmadio&quot;>&lt;ns:IDARMADIO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdArmadio&quot;/>&lt;/ns:IDARMADIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&lt;ns:CARATTERIZZAZIONE_GPON>&lt;xsl:value-of select=&quot;&amp;quot;ONESTOP&amp;quot;&quot;/>&lt;/ns:CARATTERIZZAZIONE_GPON>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&lt;ns:OPERATORETE>&lt;xsl:value-of select=&quot;'FIBERCOP'&quot;/>&lt;/ns:OPERATORETE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Coinvestimento&quot;>&lt;ns:COINVESTIMENTO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Coinvestimento&quot;/>&lt;/ns:COINVESTIMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta=('SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Semifibra&quot;>&lt;ns:SEMIFIBRA>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Semifibra&quot;/>&lt;/ns:SEMIFIBRA>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = ('CANALE')&quot;>&lt;ns:CANALEMC>&lt;ns:AZIONE>&lt;xsl:value-of select=&quot;'A'&quot;/>&lt;/ns:AZIONE>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPMulticast&quot;>&lt;ns:IPMULTICAST>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPMulticast&quot;/>&lt;/ns:IPMULTICAST>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSorgente&quot;>&lt;ns:IPSORGENTE>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IPSorgente&quot;/>&lt;/ns:IPSORGENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione = ('CREAZIONECANALEFEEDER','CANALEESISTENTEFEEDER')&quot;>&lt;ns:TIPO_APPARATO>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/ns:TIPO_APPARATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione = 'CANALEESISTENTEOLT'&quot;>&lt;ns:TIPO_APPARATO>&lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&lt;/ns:TIPO_APPARATO>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliCentrale&quot;>&lt;ns:CLLI_APPARATO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ClliCentrale&quot;/>&lt;/ns:CLLI_APPARATO>&lt;/xsl:if>&lt;/ns:CANALEMC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = ('VLANVULA')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IntermediateAgentDhcp&quot;>&lt;ns:INTERMEDIATE_AGENT_DHCP>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IntermediateAgentDhcp&quot;/>&lt;/ns:INTERMEDIATE_AGENT_DHCP>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneGeo&quot;>&lt;ns:CARATTERIZZAZIONE_GEOGRAFICA>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneGeo&quot;/>&lt;/ns:CARATTERIZZAZIONE_GEOGRAFICA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('FIBERSTREAM')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:identificativodelpop&quot;>&lt;ns:ID_PCN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:identificativodelpop&quot;/>&lt;/ns:ID_PCN>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati/ndm:Linea&quot;>&lt;ns:LINEA>&lt;ns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;ndm:NumeroTelefonico&quot;/>&lt;/ns:NUMERO_TELEFONICO>&lt;xsl:if test=&quot;ndm:TipoNumerazione&quot;>&lt;ns:TIPO_NUMERAZIONE>&lt;xsl:value-of select=&quot;ndm:TipoNumerazione&quot;/>&lt;/ns:TIPO_NUMERAZIONE>&lt;/xsl:if>&lt;/ns:LINEA>&lt;/xsl:for-each>&lt;xsl:if test=&quot;($Start/ndm:Offerta = ('VULAFTTH','SEMIVULAFTTH','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH' ,'UBBSEMIGPON','FULLGPONPLUS','FULLGPONPLUSNGA','SEMIGPON1BPNRR','FULLGPON1BPNRR') and $Start/ndm:Lavorazione = ('ATTIVAZIONE')) or ($Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:SottoLavorazione='MIGRAZIONEDEL82')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $Start/ndm:SottoLavorazione='MIGRAZIONEDEL82'&quot;>&lt;ns:NRCU_OT>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns:NRCU_OT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NRCU_OT&quot;>&lt;ns:NRCU_OT>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NRCU_OT&quot;/>&lt;/ns:NRCU_OT>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta = 'FWAITALIA1GIGASARDEGNA'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDVlanEOLO&quot;>&lt;ns:ID_VLAN_EOLO>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IDVlanEOLO&quot;/>&lt;/ns:ID_VLAN_EOLO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = ('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','FULLGPONPLUSNGA')&quot;>&lt;xsl:if test=&quot;$CalcolaCaratteristicaVlan/ndm:CaratteristicaVlan&quot;>&lt;ns:CARATTERIZZAZIONE_VLAN>&lt;xsl:value-of select=&quot;$CalcolaCaratteristicaVlan/ndm:CaratteristicaVlan&quot;/>&lt;/ns:CARATTERIZZAZIONE_VLAN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta ='VLANNGA' and not($Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan='ATTRIBUTO IN ELIMINAZIONE')&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan&quot;>&lt;ns:CARATTERIZZAZIONE_VLAN>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneVlan&quot;/>&lt;/ns:CARATTERIZZAZIONE_VLAN>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Offerta = 'FIBERSTREAM'&quot;>&lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneArea&quot;>&lt;ns:CARATTERIZZAZIONE_FS>&lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CaratterizzazioneArea&quot;/>&lt;/ns:CARATTERIZZAZIONE_FS>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/ndm:Offerta = ('FULLGPONPLUS','FULLGPONPLUSNGA') and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')) or ($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = ('FULLGPONPLUS','FULLGPONPLUSNGA') and $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='CONSISTENZADATI' and $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione='D')&quot;>&lt;ns:FULLGPONPLUS>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns:FULLGPONPLUS>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'SEMIGPON1BPNRR' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&lt;ns:TIPO_ACCESSO_UBB>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/ns:TIPO_ACCESSO_UBB>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FULLGPON1BPNRR' and starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO')&quot;>&lt;ns:TIPO_ACCESSO_UBB>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/ns:TIPO_ACCESSO_UBB>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $DettaglioLavorazione = 'DIS' and string-length($Start/ndm:Cluster) > 0&quot;>&lt;xsl:if test=&quot;$Start/ndm:Cluster&quot;>&lt;ns:CLUSTER>&lt;xsl:value-of select=&quot;$Start/ndm:Cluster&quot;/>&lt;/ns:CLUSTER>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ndm:Offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and  ($Start/ndm:Lavorazione='VARIAZIONE' and $Start/ndm:SottoLavorazione='RICONFIGURAZIONEIP') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0&quot;>&lt;ns:ACCIP_OLD>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0'&quot;>&lt;ns:MODALITA_CONSEGNA>&lt;xsl:value-of select=&quot;'L2TP'&quot;/>&lt;/ns:MODALITA_CONSEGNA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&lt;ns:MODALITA_CONSEGNA>&lt;xsl:value-of select=&quot;'CLASSICALIP'&quot;/>&lt;/ns:MODALITA_CONSEGNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:MODALITA_CONSEGNA>&lt;xsl:value-of select=&quot;'RACCOLTA_BACKBONE_IP_TI'&quot;/>&lt;/ns:MODALITA_CONSEGNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&lt;ns:INDIRIZZAMENTO_CF>&lt;xsl:value-of select=&quot;'DINAMICO'&quot;/>&lt;/ns:INDIRIZZAMENTO_CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:INDIRIZZAMENTO_CF>&lt;xsl:value-of select=&quot;'STATICO'&quot;/>&lt;/ns:INDIRIZZAMENTO_CF>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '0' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '5'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '2'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '3'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '4'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '6'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'5'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '7'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'4'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ModalitaConsegna = '8'&quot;>&lt;ns:SUBNET>&lt;xsl:value-of select=&quot;'6'&quot;/>&lt;/ns:SUBNET>&lt;/xsl:when>&lt;/xsl:choose>&lt;/ns:ACCIP_OLD>&lt;/xsl:if>&lt;/ns:SERVIZIO_DATI>&lt;/xsl:if>&lt;/ndm:SERVIZIO_DATI>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
