                                    <bpws:source linkName="AssignDatiToCopy_1_LogOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Enrich.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ServizioDati&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;MapValori_OLD&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioLavorazione&quot;/>&#xa;    &lt;xsl:param name=&quot;EnrichAccesso&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOneStep&quot;/>&#xa;    &lt;xsl:param name=&quot;Progetto&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagGBE&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagPDC&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcolaCaratteristicaVlan&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;ServizioDati&quot; match=&quot;/&quot;>&#xa;        &lt;ndm:SERVIZIO_DATI>&#xa;            &lt;xsl:copy-of select=&quot;$ServizioDati/ns:SERVIZIO_DATI&quot;/>&#xa;            &lt;xsl:if test=&quot;not(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'M'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZADATI','CONSISTENZARACCOLTA','CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT','CONSISTENZARACCOLTAVLANMULTICAST')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:TipologiaScenario = 'AWLRSUBTSNAKED'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'VARIAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente = ('CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT','CONSISTENZARACCOLTAVLANMULTICAST')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'N'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&#xa;                &lt;ns:SERVIZIO_DATI>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:LNA_LA = 'LNA'&quot;/>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and $Start/ndm:Offerta=('FEEDER','CANALE')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta='FEEDER'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;>&#xa;                                        &lt;ns:ID_IMPIANTO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;/>&#xa;                                        &lt;/ns:ID_IMPIANTO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta='CANALE' and  $Start/ndm:SottoLavorazione='CREAZIONECANALEFEEDER'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;>&#xa;                                        &lt;ns:ID_IMPIANTO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[$index]/ndm:IdRisorsa&quot;/>&#xa;                                        &lt;/ns:ID_IMPIANTO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta='CANALE' and  $Start/ndm:SottoLavorazione=('CANALEESISTENTEFEEDER','CANALEESISTENTEOLT')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACANALE']/ndm:IdRisorsa&quot;>&#xa;                                        &lt;ns:ID_IMPIANTO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente='CONSISTENZACANALE']/ndm:IdRisorsa&quot;/>&#xa;                                        &lt;/ns:ID_IMPIANTO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'ATTIVAZIONE' and (starts-with($Start/ndm:Offerta, 'BITSTREAM') or starts-with($Start/ndm:Offerta, 'EASYIP') or $Start/ndm:Offerta = 'VULAFTTCAB') and ($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS' or $Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0&quot;>&#xa;                            &lt;ns:ID_IMPIANTO>&#xa;                                &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                            &lt;/ns:ID_IMPIANTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = ('ACCENSIONE','SPEGNIMENTO') and $Start/ndm:Offerta='VULAFTTCAB' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;>&#xa;                                &lt;ns:ID_IMPIANTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico&quot;/>&#xa;                                &lt;/ns:ID_IMPIANTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'MIGRAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;( &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'ATTIVAZIONE' &amp;#xD;&amp;#xA;&amp;#x9;and &amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:LNA_LA = 'LA'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;$Start/ndm:Lavorazione = 'CESSAZIONE'&amp;#xD;&amp;#xA;&amp;#x9;and&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;exists($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA'])&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZAFONIA']/ndm:Azione !='D'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) !='U'&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE' &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:SottoLavorazione = 'PASSAGGIO_LA' &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:SottoLavorazione = 'PASSAGGIO_LNF'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;(&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'POTS'&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea = 'ISDN'&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroTelefonico)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:NumeroFittizio)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 14, 1) = 'W' and substring($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 1, 1) !='U'&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long(tib:trim(tib:left($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa, 13)))))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string(number($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)) !='NaN'&quot;>&#xa;                                    &lt;ns:ID_IMPIANTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', string(xsd:long($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)))&quot;/>&#xa;                                    &lt;/ns:ID_IMPIANTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:DETTAGLIO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$DettaglioLavorazione&quot;/>&#xa;                    &lt;/ns:DETTAGLIO_LAVORAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione='CANALEESISTENTEOLT' and $Start/ndm:Offerta='CANALE'&quot;>&#xa;                            &lt;ns:SERVIZIO_RICHIESTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CANALEMCO&amp;quot;&quot;/>&#xa;                            &lt;/ns:SERVIZIO_RICHIESTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione='ATTIVAZIONE' and $Start/ndm:SottoLavorazione=('CREAZIONECANALEFEEDER','CANALEESISTENTEFEEDER') and $Start/ndm:Offerta='CANALE'&quot;>&#xa;                            &lt;ns:SERVIZIO_RICHIESTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CANALEMCF&amp;quot;&quot;/>&#xa;                            &lt;/ns:SERVIZIO_RICHIESTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                            &lt;ns:SERVIZIO_RICHIESTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;FWA_EOLO&amp;quot;&quot;/>&#xa;                            &lt;/ns:SERVIZIO_RICHIESTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:SERVIZIO_RICHIESTO>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:OffertaDTU&quot;/>&#xa;                            &lt;/ns:SERVIZIO_RICHIESTO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ndm:FlagMonitoraggio)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:FlagMonitoraggio&quot;>&#xa;                            &lt;ns:FLAG_MONITORAGGIO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:FlagMonitoraggio&quot;/>&#xa;                            &lt;/ns:FLAG_MONITORAGGIO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI) &amp;lt; 9&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;>&#xa;                            &lt;ns:CLLI_OLT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CLLI&quot;/>&#xa;                            &lt;/ns:CLLI_OLT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSGBESIM' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'EASYIP-FTTH'&quot;>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'ETH'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSATMSIM'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:PROTOCOLLO = 'ATM IMA'&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;'ATM_IMA'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:PROTOCOLLO = 'ATM BONDING'&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;'ATM_BONDING'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:PROTOCOLLO&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta='UBBSEMIGPON' or $Start/ndm:Offerta='SEMIGPON1BPNRR'&quot;>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'SEMI'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta='UBBFULLGPON' or $Start/ndm:Offerta='FULLGPON1BPNRR'&quot;>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'FULL'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FIBERSTREAM','FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'ETH'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FEEDER','CANALE') and $Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'ETH'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:TIPOLOGIA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;'ATM'&quot;/>&#xa;                            &lt;/ns:TIPOLOGIA_ACCESSO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'H'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'Altro CDN'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'E'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SETH'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'M'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SHDSL8F'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'L'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SHDSL6F'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'X'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SSHDSL'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'K'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'HSHDSL'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'G'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SHDSL4F'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'A'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'ADSL'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'D'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SDH'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'S'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'SHDSL'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'V'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'VDSL'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Tecnologia = 'Z'&quot;>&#xa;                                    &lt;ns:TECNOLOGIA_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;'FTTH'&quot;/>&#xa;                                    &lt;/ns:TECNOLOGIA_MODEM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT') and string-length($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) > 0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;substring-after(string(tib:round-fraction(xsd:decimal($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) div 1024, 1)), &amp;quot;.&amp;quot;) !=&amp;quot;0&amp;quot;&quot;>&#xa;                                &lt;ns:BANDA_TD>&#xa;                                    &lt;xsl:value-of select=&quot;string(tib:round-fraction(xsd:decimal($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) div 1024, 1))&quot;/>&#xa;                                &lt;/ns:BANDA_TD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns:BANDA_TD>&#xa;                                    &lt;xsl:value-of select=&quot;string(xsd:int(xsd:decimal($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) div 1024))&quot;/>&#xa;                                &lt;/ns:BANDA_TD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapValori_OLD/tns:ChannelType&quot;>&#xa;                        &lt;ns:CHANNEL_TYPE>&#xa;                            &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ChannelType&quot;/>&#xa;                        &lt;/ns:CHANNEL_TYPE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;>&#xa;                        &lt;ns:TD_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TdKit&quot;/>&#xa;                        &lt;/ns:TD_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StrutturaRichiesta='XDSL' and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia) > 0 and $Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Codice !='M00'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '3' or $Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '9'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'ETHERNET'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '4'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'V35'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '5'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'G703bil'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '6'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'G703sbil'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '7'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'SDH34'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modem/ndm:Interfaccia = '8'&quot;>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'SDH155'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns:TIPO_INTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;'G703/704'&quot;/>&#xa;                                &lt;/ns:TIPO_INTERFACCIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapValori_OLD/tns:ModalitaAccesso&quot;>&#xa;                        &lt;ns:MODALITA_ACCESSO>&#xa;                            &lt;xsl:value-of select=&quot;$MapValori_OLD/tns:ModalitaAccesso&quot;/>&#xa;                        &lt;/ns:MODALITA_ACCESSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLmi&quot;>&#xa;                        &lt;ns:TIPO_LMI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLmi&quot;/>&#xa;                        &lt;/ns:TIPO_LMI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and exists($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTH'&quot;>&#xa;                                &lt;ns:VEL_ACC_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN))*xsd:int(1000))&quot;/>&#xa;                                &lt;/ns:VEL_ACC_DOWN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'  or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTC') and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2'&quot;>&#xa;                                        &lt;ns:VEL_ACC_DOWN>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN))*xsd:int(1024))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_DOWN>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:VEL_ACC_DOWN>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN))*xsd:int(1000))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_DOWN>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) = '10240' or string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) = '10000'&quot;>&#xa;                                        &lt;ns:VEL_ACC_DOWN>&#xa;                                            &lt;xsl:value-of select=&quot;'10000'&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_DOWN>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) = '20480' or string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN) = '20000'&quot;>&#xa;                                        &lt;ns:VEL_ACC_DOWN>&#xa;                                            &lt;xsl:value-of select=&quot;'20000'&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_DOWN>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:VEL_ACC_DOWN>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_DOWN)))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_DOWN>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and exists($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTH'&quot;>&#xa;                                &lt;ns:VEL_ACC_UP>&#xa;                                    &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP))*xsd:int(1000))&quot;/>&#xa;                                &lt;/ns:VEL_ACC_UP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTC') and exists($Start/ndm:Fonia_Dati/ndm:ProfiloTecnicoLinea)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2'&quot;>&#xa;                                        &lt;ns:VEL_ACC_UP>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP))*xsd:int(1024))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_UP>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:VEL_ACC_UP>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP))*xsd:int(1000))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_UP>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP) = '10240' or string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP) = '10000'&quot;>&#xa;                                        &lt;ns:VEL_ACC_UP>&#xa;                                            &lt;xsl:value-of select=&quot;'10000'&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_UP>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP) = '20480' or string($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP) = '20000'&quot;>&#xa;                                        &lt;ns:VEL_ACC_UP>&#xa;                                            &lt;xsl:value-of select=&quot;'20000'&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_UP>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:VEL_ACC_UP>&#xa;                                            &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_COMMERCIALE_UP)))&quot;/>&#xa;                                        &lt;/ns:VEL_ACC_UP>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and string-length(string($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MIN)) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&#xa;                                            &lt;ns:AGG_DOWN_MIN>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MIN))*xsd:int(1024))&quot;/>&#xa;                                            &lt;/ns:AGG_DOWN_MIN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:AGG_DOWN_MIN>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MIN))*xsd:int(1000))&quot;/>&#xa;                                            &lt;/ns:AGG_DOWN_MIN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:AGG_DOWN_MIN>&#xa;                                        &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MIN)))&quot;/>&#xa;                                    &lt;/ns:AGG_DOWN_MIN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and string-length(string($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX)) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&#xa;                                            &lt;ns:AGG_DOWN_MAX>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX))*xsd:int(1024))&quot;/>&#xa;                                            &lt;/ns:AGG_DOWN_MAX>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:AGG_DOWN_MAX>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX))*xsd:int(1000))&quot;/>&#xa;                                            &lt;/ns:AGG_DOWN_MAX>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:AGG_DOWN_MAX>&#xa;                                        &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_DOWN_MAX)))&quot;/>&#xa;                                    &lt;/ns:AGG_DOWN_MAX>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and string-length(string($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN)) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&#xa;                                            &lt;ns:AGG_UP_MIN>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN))*xsd:int(1024))&quot;/>&#xa;                                            &lt;/ns:AGG_UP_MIN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:AGG_UP_MIN>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN))*xsd:int(1000))&quot;/>&#xa;                                            &lt;/ns:AGG_UP_MIN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:AGG_UP_MIN>&#xa;                                        &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MIN)))&quot;/>&#xa;                                    &lt;/ns:AGG_UP_MIN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and  string-length(string($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX)) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V1' or $Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea = 'V2')&quot;>&#xa;                                            &lt;ns:AGG_UP_MAX>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX))*xsd:int(1024))&quot;/>&#xa;                                            &lt;/ns:AGG_UP_MAX>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:AGG_UP_MAX>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX))*xsd:int(1000))&quot;/>&#xa;                                            &lt;/ns:AGG_UP_MAX>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:AGG_UP_MAX>&#xa;                                        &lt;xsl:value-of select=&quot;string(xsd:int(xsd:double($Enrich.output/tns:ProfiloTcncLinea/tns:VELOCITA_AGGANCIO_UP_MAX)))&quot;/>&#xa;                                    &lt;/ns:AGG_UP_MAX>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)), 'ISDN') or &amp;#xD;&amp;#xA;upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea)) ='LINEANONFONIA'&quot;>&#xa;                            &lt;ns:ISDN>&#xa;                                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                            &lt;/ns:ISDN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ISDN>&#xa;                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                            &lt;/ns:ISDN>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:ID_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdVlanOlo&quot;/>&#xa;                    &lt;/ns:ID_VLAN>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN') or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceLotto&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FIBERSTREAM')&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;'001'&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and string-length($Enrich.output/tns:Dati[1]/tns:MACRO_AREA) > 0&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[1]/tns:MACRO_AREA&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and string-length($Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA) > 0&quot;>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:VP_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:VP_VLAN>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Enrich.output/tns:ProfiloTcncLinea) and string-length($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA) > 0 and $Start/ndm:Offerta!=('FEEDER','CANALE')&quot;>&#xa;                            &lt;ns:PROFILO_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA&quot;/>&#xa;                            &lt;/ns:PROFILO_COMM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                            &lt;ns:PROFILO_COMM>&#xa;                                &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                            &lt;/ns:PROFILO_COMM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:PROFILO_COMM>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:PROFILO_COMM>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $DettaglioLavorazione = 'DIS'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMSIMMETRICO') or $Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT') or ($Start/ndm:Offerta='FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;TAGGED&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'  or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTC' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTH') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging) > 0&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging)&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'UNTAGGED'&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($Start/ndm:Offerta,'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Offerta,'BITSTREAMATMSIMMETRICO') or $Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON')or $Start/ndm:Offerta=('FIBERSTREAM')&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT' or $Start/ndm:Offerta=('FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;TAGGED&amp;quot;&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTC' or $Enrich.output/tns:OffertaDTU = 'EASYIP-FTTH') and string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging) > 0&quot;>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:UserVlan1Tagging)&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_USERVLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'UNTAGGED'&quot;/>&#xa;                                    &lt;/ns:TIPO_USERVLAN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Enrich.output/tns:FamigliaOfferta = 'EASYIP'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($Enrich.output/tns:Dati) > 0 and $Enrich.output/tns:FlagAnfibio = 'Y'&quot;>&#xa;                                    &lt;ns:TIPO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;'ANFIBIO'&quot;/>&#xa;                                    &lt;/ns:TIPO_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;'ATM'&quot;/>&#xa;                                    &lt;/ns:TIPO_ACCESSO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN') or $Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente='RACCOLTAVP'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('VLAN','VLANNGA')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoVlan='1'&quot;>&#xa;                                            &lt;ns:TIPO_VLAN>&#xa;                                                &lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&#xa;                                            &lt;/ns:TIPO_VLAN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:TipoVlan='2'&quot;>&#xa;                                            &lt;ns:TIPO_VLAN>&#xa;                                                &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                            &lt;/ns:TIPO_VLAN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:TIPO_VLAN>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ns:TIPO_VLAN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta='VLANVULA'&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON','FIBERSTREAM')&quot;/>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FEEDER','FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                            &lt;ns:TIPO_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&#xa;                            &lt;/ns:TIPO_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta=('CANALE')&quot;>&#xa;                            &lt;ns:TIPO_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns:TIPO_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'MIGRAZIONE' and $DettaglioLavorazione = 'DIS'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta, 'BITSTREAMATMSIMMETRICO')&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:Offerta=('BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMGBESIMMETRICOFLAT','BITSTREAMGBESIMMETRICO') and ((exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC/tns:SVLANCODE) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC/tns:CVLANID)) or (exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN/tns:SVLANCODE) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN/tns:CVLANID)))&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:Encapsulation)) = 'DOUBLETAG'&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($Start/ndm:Offerta,'BITSTREAMATMASIMMETRICO') or starts-with($Start/ndm:Offerta,'BITSTREAMATMSIMMETRICO')&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA' or $Enrich.output/tns:OffertaDTU = 'BSFTTCVULA'&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMGBESIMMETRICOFLAT','BITSTREAMGBESIMMETRICO') and ((exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC/tns:SVLANCODE) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC/tns:CVLANID)) or (exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN/tns:SVLANCODE) and exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN/tns:CVLANID)))&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case(tib:trim($Start/ndm:Fonia_Dati[number($index)]/ndm:Encapsulation)) = 'DOUBLETAG'&quot;>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'QINQ'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_VLAN>&#xa;                                        &lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&#xa;                                    &lt;/ns:TIPO_VLAN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC/tns:PROTOCOLLOPILA)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC[tns:PROTOCOLLOPILA !='IPoA'])&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPO_TRASPORTO>&#xa;                                        &lt;xsl:value-of select=&quot;'IPoA'&quot;/>&#xa;                                    &lt;/ns:TIPO_TRASPORTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'NAKED'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains(upper-case($Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea), 'POTS') or contains(upper-case($Start/ndm:Fonia_Dati[starts-with(ndm:NomeComponente, 'ACCESSO')]/ndm:TipoLinea), 'ISDN')&quot;>&#xa;                                            &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'CONDIVISO'&quot;/>&#xa;                                            &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'NAKED'&quot;/>&#xa;                                            &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:TipoLinea) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:TipoLinea), 'POTS') or contains(upper-case($Start/ndm:Fonia_Dati[ndm:NomeComponente = 'CONSISTENZADATI']/ndm:TipoLinea), 'ISDN')&quot;>&#xa;                                            &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'CONDIVISO'&quot;/>&#xa;                                            &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;'NAKED'&quot;/>&#xa;                                            &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('UBBSEMIGPON','UBBFULLGPON','FWAITALIA1GIGASARDEGNA','SEMIGPON1BPNRR','FULLGPON1BPNRR')&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'NAKED'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FIBERSTREAM')&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$Start/ndm:Offerta=('FEEDER','CANALE') and $Start/ndm:Lavorazione='ATTIVAZIONE'&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'POTS') or contains(upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea), 'ISDN')&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'CONDIVISO'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/ndm:Fonia_Dati[number($index)]/ndm:TipoLinea) = 'LINEANONFONIA'&quot;>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'NAKED'&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:TIPOLOGIA_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns:TIPOLOGIA_SERVIZIO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta = ('VULAFTTH','VULAFTTCAB','SEMIVULAFTTH','FULLGPONPLUS')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:FlagNuovoModello) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagNuovoModello&quot;>&#xa;                                        &lt;ns:FL_NEW_MODEL_VULA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:FlagNuovoModello&quot;/>&#xa;                                        &lt;/ns:FL_NEW_MODEL_VULA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:FL_NEW_MODEL_VULA>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/ns:FL_NEW_MODEL_VULA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:Lavorazione = 'CESSAZIONE' and &amp;#xD;&amp;#xA;($Enrich.output/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich.output/tns:OffertaDTU = 'BSFTTHVULA') and (string-length($Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaNOW) > 0 and $Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaNOW !=$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;>&#xa;                            &lt;ns:ID_ODR>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsa&quot;/>&#xa;                            &lt;/ns:ID_ODR>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ndm:CodiceTTM&quot;>&#xa;                        &lt;ns:CODICETT>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ndm:CodiceTTM&quot;/>&#xa;                        &lt;/ns:CODICETT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;($Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT') and (starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente, 'ACCESSO') or $Start/ndm:Lavorazione = 'CESSAZIONE')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaNOW&quot;>&#xa;                            &lt;ns:TD_CLIENTE_FINALE1>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:IdRisorsaNOW&quot;/>&#xa;                            &lt;/ns:TD_CLIENTE_FINALE1>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT') and string-length($Enrich.output/tns:DescrPagamento) > 0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Enrich.output/tns:DescrPagamento = 'FLAT'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Enrich.output/tns:DescrPagamento&quot;>&#xa;                                        &lt;ns:MODALITA_FATTURAZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;$Enrich.output/tns:DescrPagamento&quot;/>&#xa;                                        &lt;/ns:MODALITA_FATTURAZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:MODALITA_FATTURAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;'CONSUMO'&quot;/>&#xa;                                    &lt;/ns:MODALITA_FATTURAZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente=('RACCOLTAVP','ACCESSOFEEDER','ACCESSOCANALE')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceMacroArea&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceMacroArea&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceAreaRaccolta&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:CodiceAreaRaccolta&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente=('RACCOLTAVP','ACCESSOFEEDER','ACCESSOCANALE')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA_DESC>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeMacroArea&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA_DESC>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;starts-with($Start/ndm:Fonia_Dati[number($index)]/ndm:NomeComponente,'RACCOLTAVLAN')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeAreaRaccolta&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA_DESC>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:NomeAreaRaccolta&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA_DESC>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/ndm:Offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/ndm:Offerta = 'BITSTREAMGBESIMMETRICOFLAT'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA_DESC&quot;>&#xa;                                &lt;ns:AREADIRACCOLTA_DESC>&#xa;                                    &lt;xsl:value-of select=&quot;$Enrich.output/tns:Dati[1]/tns:COD_AREA_RACCOLTA_DESC&quot;/>&#xa;                                &lt;/ns:AREADIRACCOLTA_DESC>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC&quot;>&#xa;                            &lt;xsl:variable name=&quot;posVC1&quot; select=&quot;position()&quot;/>&#xa;                            &lt;ns:VIRT_CHAN>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'CESSAZIONE'&quot;>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(../../../ndm:SottoLavorazione = 'VARIAZIONETAGGING' or ../../../ndm:SottoLavorazione = 'CAMBIOTIPOVLAN') and tns:AZIONE = 'M'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and &amp;#xD;&amp;#xA;(($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:VpCons !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:VpConsOld and&amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:VpCons)>0 and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:VpConsOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ProfiloComm !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ProfiloCommOld and&amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ProfiloComm)>0 and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ProfiloCommOld)>0)&amp;#xD;&amp;#xA;) and tns:AZIONE = 'M'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrDn !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrDnOld and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrDn)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrDnOld)>0) &amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrUp !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrUpOld and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrUp)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:McrUpOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrDn !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrDnOld and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrDn)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrDnOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrUp !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrUpOld and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrUp)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:PcrUpOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrDn !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrDnOld and&amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrDn)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrDnOld)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrUp !=$MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrUpOld and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrUp)>0 and string-length($MapValori_OLD/tns:ATM_Azione[number(position())]/tns:ScrUpOld)>0))&amp;#xD;&amp;#xA;and tns:AZIONE = 'M'&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;../../../ndm:SottoLavorazione = 'RICONFIGURAZIONEVC' and &amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA !=$Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_TCNC_LINEA_OLD and string-length($Enrich.output/tns:ProfiloTcncLinea/tns:PROFILO_TCNC_LINEA)>0 and string-length($Enrich.output/tns:ProfiloTecnicoLineaOLD/tns:PROFILO_TCNC_LINEA_OLD)>0) &amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;($MapValori_OLD/tns:ModalitaAccesso !=$MapValori_OLD/tns:ModalitaAccessoOLD and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ModalitaAccesso)>0 and string-length($MapValori_OLD/tns:ModalitaAccessoOLD)>0)&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;($MapValori_OLD/tns:ChannelType !=$MapValori_OLD/tns:ChannelTypeOLD and &amp;#xD;&amp;#xA;string-length($MapValori_OLD/tns:ChannelType)>0 and string-length($MapValori_OLD/tns:ChannelTypeOLD)>0)&amp;#xD;&amp;#xA;)&quot;>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                                &lt;/ns:AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;tns:AZIONE&quot;/>&#xa;                                        &lt;/ns:AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;tns:VPI&quot;>&#xa;                                    &lt;ns:VP>&#xa;                                        &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                    &lt;/ns:VP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:VCI&quot;>&#xa;                                    &lt;ns:VC>&#xa;                                        &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                    &lt;/ns:VC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:DLCI&quot;>&#xa;                                    &lt;ns:DLCI>&#xa;                                        &lt;xsl:value-of select=&quot;tns:DLCI&quot;/>&#xa;                                    &lt;/ns:DLCI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:VPI&quot;>&#xa;                                            &lt;ns:VPI_SP>&#xa;                                                &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                            &lt;/ns:VPI_SP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../../ndm:Lavorazione = 'VARIAZIONE'&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:VCI&quot;>&#xa;                                            &lt;ns:VCI_SP>&#xa;                                                &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                            &lt;/ns:VCI_SP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with(tns:MCRDOWN, '0.') or starts-with(tns:MCRDOWN, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:MCRDOWN&quot;>&#xa;                                            &lt;ns:MCRDN>&#xa;                                                &lt;xsl:value-of select=&quot;tns:MCRDOWN&quot;/>&#xa;                                            &lt;/ns:MCRDN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains(tns:MCRDOWN, '.')&quot;>&#xa;                                        &lt;ns:MCRDN>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(tns:MCRDOWN, '.')&quot;/>&#xa;                                        &lt;/ns:MCRDN>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains(tns:MCRDOWN, ',')&quot;>&#xa;                                        &lt;ns:MCRDN>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(tns:MCRDOWN, ',')&quot;/>&#xa;                                        &lt;/ns:MCRDN>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;tns:MCRDOWN&quot;>&#xa;                                            &lt;ns:MCRDN>&#xa;                                                &lt;xsl:value-of select=&quot;tns:MCRDOWN&quot;/>&#xa;                                            &lt;/ns:MCRDN>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with(tns:MCRUP, '0.') or starts-with(tns:MCRUP, '0,')&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:MCRUP&quot;>&#xa;                                            &lt;ns:MCRUP>&#xa;                                                &lt;xsl:value-of select=&quot;tns:MCRUP&quot;/>&#xa;                                            &lt;/ns:MCRUP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;contains(tns:MCRUP, '.')&quot;>&#xa;                                        &lt;ns:MCRUP>&#xa;                                            &lt;xsl:value-of select=&quot;substri