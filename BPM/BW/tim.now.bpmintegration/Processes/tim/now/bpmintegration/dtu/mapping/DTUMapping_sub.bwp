                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa1cf9c6-848f-4d8c-a176-ddf2fc35a0a4+input&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SelStrutturaRich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FO.DESCR as FAMIG_OFFERTA, SO.DESCR as SOTTO_FAMIG_OFFERTA, TD.DESCR AS NOME_OFFERTA_DTU&#xa;&#x9;FROM FAMIG_OFFERTA FO, SOTTO_FAMIG_OFFERTA SO, TRASCODFC_OFFERTA TR, OFFERTA O, TIPOLG_OFFERTA_DTU TD&#xa;&#x9;WHERE FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA AND TD.ID_NOME_OFFERTA_DTU = O.ID_NOME_OFFERTA_DTU&#xa;      AND SO.ID_SOTTOFAMIG_OFFERTA = O.ID_SOTTOFAMIG_OFFERTA AND O.ID_OFFERTA = TR.ID_OFFERTA&#xa;&#x9;  AND TR.NOME_OFFERTA_ESTERNA = ? AND TR.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="FAMIG_OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SOTTO_FAMIG_OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="StrutturaRichiesta"
                                    name="StrutturaRichiesta"
                                    outputVariable="StrutturaRichiesta"
                                    tibex:xpdlId="1934291e-71c8-4c5b-b8af-9b731d28dfbe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelStrutturaRichToStrutturaRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="StrutturaRichiestaToCopy_1_LogIn"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta = 'NP') &#xd;&#xa;then 'NPG'&#xd;&#xa;else if ($SelStrutturaRich/Record[1]/FAMIG_OFFERTA = 'VULA' or $Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta = ('VLANNGA','VLANVULA') or $SelStrutturaRich/Record[1]/FAMIG_OFFERTA = ('GPON','FULLGPONPLUS','FULLGPONPLUSNGA')) &#xd;&#xa;        then 'NGA' &#xd;&#xa;else if ($SelStrutturaRich/Record[1]/FAMIG_OFFERTA = 'BITSTREAM' or $SelStrutturaRich/Record[1]/FAMIG_OFFERTA = 'EASYIP' or $Start/ns1:Fonia_Dati[number($index)]/ns1:Offerta = ('VLAN','VP')) &#xd;&#xa;        then 'XDSL'&#xd;&#xa;else $SelStrutturaRich/Record[1]/FAMIG_OFFERTA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="StrutturaRichiesta" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogAzioneT-input"
                                    name="LogAzioneT"
                                    tibex:xpdlId="ce351aa0-2f55-4b5d-b633-6b07f767e0c3"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign_AzioneT"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogAzioneTToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAzioneT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUMapping_sub'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ndm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Componente con Struttura: &amp;quot;, $StrutturaRichiesta, &amp;quot; e Azione: &amp;quot;, $Start/ndm:Fonia_Dati[number($index)]/ndm:Azione, &amp;quot; non mappata al ciclo n. &amp;quot;, string($index))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Enrich&quot;/>&lt;xsl:param name=&quot;StrutturaRichiesta&quot;/>&lt;xsl:template name=&quot;MapValori_OLD-input&quot; match=&quot;/&quot;>&lt;tns:VariazioneAzione>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC)&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:ATMVC&quot;>&lt;tns:ATM_Azione>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, &amp;quot;EASY&amp;quot;)&quot;/>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Enrich/output/tns:DTUEnrichmentResponse/tns:SottoFamigliaOfferta, 'ATM')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = &amp;quot;DEDICATA&amp;quot;&quot;>&lt;xsl:if test=&quot;tns:CODICETD&quot;>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;tns:CODICETD&quot;/>&lt;/tns:VpCons>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:CODICEVP&quot;>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;tns:CODICEVP&quot;/>&lt;/tns:VpCons>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../ndm:Offerta, &amp;quot;EASY&amp;quot;)&quot;/>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Enrich/output/tns:DTUEnrichmentResponse/tns:SottoFamigliaOfferta, 'ATM')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns:ValoriDatiOLD/tns:TipoBandaConsegna_OLD) = 'DEDICATA'&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns:TIPOBANDACONSEGNA) = 'DEDICATA'&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD!=tns:CODICETD or (exists(tns:ValoriDatiOLD/tns:CodiceTd_OLD) and not(exists(tns:CODICETD)))&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceTd_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD!=tns:CODICEVP or (exists(tns:ValoriDatiOLD/tns:CodiceVp_OLD) and not(exists(tns:CODICEVP)))&quot;>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CodiceVp_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&lt;tns:ProfiloComm>&lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&lt;/tns:ProfiloComm>&lt;/xsl:if>&lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&lt;tns:ProfiloCommOld>&lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&lt;/tns:ProfiloCommOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MCRDOWN&quot;>&lt;tns:McrDn>&lt;xsl:value-of select=&quot;tns:MCRDOWN&quot;/>&lt;/tns:McrDn>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:McrDown_OLD&quot;>&lt;tns:McrDnOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:McrDown_OLD&quot;/>&lt;/tns:McrDnOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MCRUP&quot;>&lt;tns:McrUp>&lt;xsl:value-of select=&quot;tns:MCRUP&quot;/>&lt;/tns:McrUp>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:McrUp_OLD&quot;>&lt;tns:McrUpOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:McrUp_OLD&quot;/>&lt;/tns:McrUpOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PCRDOWN&quot;>&lt;tns:PcrDn>&lt;xsl:value-of select=&quot;tns:PCRDOWN&quot;/>&lt;/tns:PcrDn>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrDown_OLD&quot;>&lt;tns:PcrDnOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrDown_OLD&quot;/>&lt;/tns:PcrDnOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PCRUP&quot;>&lt;tns:PcrUp>&lt;xsl:value-of select=&quot;tns:PCRUP&quot;/>&lt;/tns:PcrUp>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrUp_OLD&quot;>&lt;tns:PcrUpOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrUp_OLD&quot;/>&lt;/tns:PcrUpOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:SCRDOWN&quot;>&lt;tns:ScrDn>&lt;xsl:value-of select=&quot;tns:SCRDOWN&quot;/>&lt;/tns:ScrDn>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:ScrDown_OLD&quot;>&lt;tns:ScrDnOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:ScrDown_OLD&quot;/>&lt;/tns:ScrDnOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:SCRUP&quot;>&lt;tns:ScrUp>&lt;xsl:value-of select=&quot;tns:SCRUP&quot;/>&lt;/tns:ScrUp>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:ScrUp_OLD&quot;>&lt;tns:ScrUpOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:ScrUp_OLD&quot;/>&lt;/tns:ScrUpOld>&lt;/xsl:if>&lt;/tns:ATM_Azione>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC)&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:GBEVC&quot;>&lt;tns:GBE_Azione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0&quot;>&lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&lt;/tns:VpCons>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VpCons>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CVLANID&quot;>&lt;tns:CvLan>&lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&lt;/tns:CvLan>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;>&lt;tns:CvLanOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;/>&lt;/tns:CvLanOld>&lt;/xsl:if>&lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&lt;tns:ProfiloComm>&lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&lt;/tns:ProfiloComm>&lt;/xsl:if>&lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&lt;tns:ProfiloCommOld>&lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&lt;/tns:ProfiloCommOld>&lt;/xsl:if>&lt;/tns:GBE_Azione>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN)&quot;>&lt;xsl:for-each select=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Dati_L2/tns:USERVLAN&quot;>&lt;tns:UserVlan_Azione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:SVLANCODE) > 0&quot;>&lt;xsl:if test=&quot;tns:SVLANCODE&quot;>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;tns:SVLANCODE&quot;/>&lt;/tns:VpCons>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VpCons>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VpCons>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;>&lt;tns:VpConsOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:SvLanCode_OLD&quot;/>&lt;/tns:VpConsOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CVLANID&quot;>&lt;tns:CvLan>&lt;xsl:value-of select=&quot;tns:CVLANID&quot;/>&lt;/tns:CvLan>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;>&lt;tns:CvLanOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:CvLanID_OLD&quot;/>&lt;/tns:CvLanOld>&lt;/xsl:if>&lt;xsl:if test=&quot;../../ndm:ProfiloTecnicoLinea&quot;>&lt;tns:ProfiloComm>&lt;xsl:value-of select=&quot;../../ndm:ProfiloTecnicoLinea&quot;/>&lt;/tns:ProfiloComm>&lt;/xsl:if>&lt;xsl:if test=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;>&lt;tns:ProfiloCommOld>&lt;xsl:value-of select=&quot;../../ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD&quot;/>&lt;/tns:ProfiloCommOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BANDAPICCODOWN&quot;>&lt;tns:PcrDn_BandaPicDn>&lt;xsl:value-of select=&quot;tns:BANDAPICCODOWN&quot;/>&lt;/tns:PcrDn_BandaPicDn>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrDown_BandaPicDn_OLD&quot;>&lt;tns:PcrDnOld_BandaPicDnOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrDown_BandaPicDn_OLD&quot;/>&lt;/tns:PcrDnOld_BandaPicDnOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BANDAPICCOUP&quot;>&lt;tns:PcrUp_BandaPicUp>&lt;xsl:value-of select=&quot;tns:BANDAPICCOUP&quot;/>&lt;/tns:PcrUp_BandaPicUp>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:PcrUp_BandaPicUp_OLD&quot;>&lt;tns:PcrUpOld_BandaPicUpOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:PcrUp_BandaPicUp_OLD&quot;/>&lt;/tns:PcrUpOld_BandaPicUpOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ValoriDatiOLD/tns:Uservlan_OLD&quot;>&lt;tns:UservlanOld>&lt;xsl:value-of select=&quot;tns:ValoriDatiOLD/tns:Uservlan_OLD&quot;/>&lt;/tns:UservlanOld>&lt;/xsl:if>&lt;/tns:UserVlan_Azione>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Azione = 'D' and ($Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCNGA' or $Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTCVULA')&quot;>&lt;tns:ModalitaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:ModalitaAccesso>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea) and  tib:trim(upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:MODELLO_ACCS)) = 'FIXED'&quot;>&lt;tns:ModalitaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:ModalitaAccesso>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea) and  tib:trim(upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:MODELLO_ACCS)) = 'RATE ADAPTIVE'&quot;>&lt;tns:ModalitaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:ModalitaAccesso>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTecnicoLineaOLD/tns:MODELLO_ACCS_OLD) = 'RATE ADAPTIVE' and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;tns:ModalitaAccessoOLD>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:ModalitaAccessoOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTecnicoLineaOLD/tns:MODELLO_ACCS_OLD) = 'FIXED' and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;tns:ModalitaAccessoOLD>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:ModalitaAccessoOLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;XDSL&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modulazione = '1'&quot;>&lt;tns:ChannelType>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/tns:ChannelType>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:Modulazione = '0'&quot;>&lt;tns:ChannelType>&lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&lt;/tns:ChannelType>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;NGA&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea) and upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'INTERLEAVED'&quot;>&lt;tns:ChannelType>&lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&lt;/tns:ChannelType>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ProfiloTecnicoLinea) and (upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'ALL' or upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTcncLinea/tns:TIPO_MODULAZIONE) = 'FAST')&quot;>&lt;tns:ChannelType>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/tns:ChannelType>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;XDSL&amp;quot; and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Modulazione_OLD = '1'&quot;>&lt;tns:ChannelTypeOLD>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/tns:ChannelTypeOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:Modulazione_OLD = '0'&quot;>&lt;tns:ChannelTypeOLD>&lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&lt;/tns:ChannelTypeOLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$StrutturaRichiesta=&amp;quot;NGA&amp;quot; and $Start/ndm:Lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHNGA' or &amp;#xD;&amp;#xA;$Enrich/output/tns:DTUEnrichmentResponse/tns:OffertaDTU = 'BSFTTHVULA'&quot;/>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD) and upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'INTERLEAVED'&quot;>&lt;tns:ChannelTypeOLD>&lt;xsl:value-of select=&quot;&amp;quot;I&amp;quot;&quot;/>&lt;/tns:ChannelTypeOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ndm:Fonia_Dati[number($index)]/ndm:ValoriDatiOLD/ndm:ProfiloTecnicoLinea_OLD) and (upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'ALL' or upper-case($Enrich/output/tns:DTUEnrichmentResponse/tns:ProfiloTecnicoLineaOLD/tns:TIPO_MODULAZIONE_OLD) = 'FAST')&quot;>&lt;tns:ChannelTypeOLD>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/tns:ChannelTypeOLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:VariazioneAzione>&lt;/xsl:template>&lt;/xsl:stylesheet>"
