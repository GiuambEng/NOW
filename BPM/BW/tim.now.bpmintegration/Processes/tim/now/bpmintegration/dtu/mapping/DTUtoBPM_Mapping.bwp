            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiuntiviPrenotaz-input&quot; match=&quot;/&quot;>&#xa;        &lt;AggiuntiviPrenotazioneNumero>&#xa;            &lt;xsl:for-each select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI&quot;>&#xa;                &lt;Aggiuntivo>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'STATOAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TELAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'DIREZIONALITA'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOLOGIAACCESSO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                &lt;/Aggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI&quot;>&#xa;                &lt;Aggiuntivo>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'STATOAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TELAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'DIREZIONALITA'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOLOGIA