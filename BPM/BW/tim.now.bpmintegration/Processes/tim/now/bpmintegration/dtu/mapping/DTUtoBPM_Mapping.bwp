                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6b5127f4-345d-4731-a445-9cde3ab436e7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Permutatore1&quot;/>&lt;xsl:param name=&quot;Permutatore2&quot;/>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:template name=&quot;Get_DizNomeCompnte_Attr-input&quot; match=&quot;/&quot;>&lt;tns:inputs>&lt;inputSet>&lt;TIPO_NOTIFICA>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&lt;/TIPO_NOTIFICA>&lt;NOME_ATTR_START_IN>&lt;xsl:for-each select=&quot;$ParseXml/Coppia&quot;>&lt;xsl:if test=&quot;NodeName&quot;>&lt;APPUSER.T_NOME_ATTR_START>&lt;xsl:value-of select=&quot;NodeName&quot;/>&lt;/APPUSER.T_NOME_ATTR_START>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:if test=&quot;string-length($Permutatore1)>0&quot;>&lt;APPUSER.T_NOME_ATTR_START>&lt;xsl:value-of select=&quot;'CONCAT_PERMUTATORE_1'&quot;/>&lt;/APPUSER.T_NOME_ATTR_START>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Permutatore2)>0&quot;>&lt;APPUSER.T_NOME_ATTR_START>&lt;xsl:value-of select=&quot;'CONCAT_PERMUTATORE_2'&quot;/>&lt;/APPUSER.T_NOME_ATTR_START>&lt;/xsl:if>&lt;/NOME_ATTR_START_IN>&lt;IDRICHIESTA>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_SOSPENSIONE&amp;quot; and $