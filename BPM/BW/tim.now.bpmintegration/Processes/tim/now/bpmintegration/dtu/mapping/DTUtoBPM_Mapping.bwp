            </bpws:extensionActivity>
            <bpws:scope name="While2" tibex:group="while" tibex:xpdlId="b6d1bc97-f87b-468e-a177-424fa0fa4e27">
                <bpws:targets>
                    <bpws:target linkName="AggFoniaToWhile2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While2ToCallProcess"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="while">
                    <bpws:assign name="GroupInit2"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+34d82082-27c2-4c0f-bb8e-aca8d74f51e6" version="2.0"> <xsl:template name="Accumulate2" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate2"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while2" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $countAggiuntiviFonia" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $countAggiuntiviFonia]]></bpws:condition>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart2ToMapArrichAggiuntFonia" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapArrichAggiuntFoniaToAccumulate2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="d335cf1f-49d3-4294-b8b4-7c863be5a1bc">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToMapArrichAggiuntFonia"/>
                                </bpws:sources>
                            </bpws:empty>
