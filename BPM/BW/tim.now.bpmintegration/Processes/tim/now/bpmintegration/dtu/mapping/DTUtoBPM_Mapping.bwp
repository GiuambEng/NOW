                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate2&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:param name=&quot;countAggiuntiviFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;countAggiuntiviPrenotazione&quot;/>&#xa;    &lt;xsl:param name=&quot;MapArricApparati2&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponse2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:manageNotificationRequest>&#xa;            &lt;tns4:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;            &lt;/tns4:ID_RICHIESTA>&#xa;            &lt;tns4:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ProgressivoNotificaDTU>&#xa;            &lt;tns4:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEventoOrdnNowWhls>&#xa;            &lt;tns4:CodProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns4:CodProcsoNoFile>&#xa;            &lt;tns4:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEsecProcsoNoFile>&#xa;            &lt;xsl:copy-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA&quot;/>&#xa;            &lt;tns4:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ID_ANAGRAFICA_CAUSALE>&#xa;            &lt;tns4:ARRICCHIMENTI>&#xa;                &lt;tns4:Arricchimento>&#xa;                    &lt;xsl:copy-of select=&quot;$Response/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement&quot;/>&#xa;                    &lt;xsl:if test=&quot;$countAggiuntiviPrenotazione>0&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$Accumulate1/tns2:Arricchimenti_Type/Arricchimento&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;ns2:DettaglioOrdineElement&quot;/>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$countAggiuntiviFonia>0 &amp;#xD;&amp;#xA;and not($DTUtoBPMIn.input/tns1:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$Accumulate2/tns2:Arricchimenti_Type/Arricchimento&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;ns2:DettaglioOrdineElement&quot;/>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;count($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZIO_AGGIUNTIVO)>0&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$MapArricApparati2/Arricchimento/ns2:DettaglioOrdineElement&quot;/>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:Arricchimento>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;            &lt;/tns4:ARRICCHIMENTI>&#xa;        &lt;/tns4:manageNotificationRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
