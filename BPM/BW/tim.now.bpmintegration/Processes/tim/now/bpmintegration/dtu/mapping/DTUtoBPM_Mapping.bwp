                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Get_DizNomeCompnte_Attr&quot;/>&#xa;    &lt;xsl:template name=&quot;ComponentiOrdine&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Componenti>&#xa;            &lt;xsl:for-each-group select=&quot;$Get_DizNomeCompnte_Attr/outputSet/RESULTSET/APPUSER.T_DIZ_RECORDS[COMPONENTE!='DTUDISAGGREGAZIONE' or (COMPONENTE='DTUDISAGGREGAZIONE' and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE='EX-DISAGGREGATO' and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA!='NI_PRESA_IN_CARICO') or (COMPONENTE='DTUDISAGGREGAZIONE' and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NI_PRESA_IN_CARICO')]&quot; group-by=&quot;COMPONENTE&quot;>&#xa;                &lt;Componente>&#xa;                    &lt;NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;COMPONENTE&quot;/>&#xa;                    &lt;/NomeComponente>&#xa;                &lt;/Componente>&#xa;            &lt;/xsl:for-each-group>&#xa;        &lt;/tns2:Componenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ComponentiOrdine" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ComponentiOrdine"
                    name="AssignAttributi"
                    outputVariable="ComponentiOrdine"
                    tibex:xpdlId="8fff00d4-368e-4b5f-a9f4-3a23825f55d9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogComponentiToAssignAttributi"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignAttributiToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;Get_DizNomeCompnte_Attr&quot;/>&#xa;    &lt;xsl:template name=&quot;ComponentiOrdine&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Componenti>&#xa;            &lt;xsl:for-each select=&quot;$ComponentiOrdine/Componente&quot;>&#xa;                &lt;Componente>&#xa;                    &lt;xsl:variable name=&quot;curComponente&quot; select=&quot;NomeComponente&quot;/>&#xa;                    &lt;NomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;NomeComponente&quot;/>&#xa;                    &lt;/NomeComponente>&#xa;                    &lt;xsl:for-each select=&quot;$Get_DizNomeCompnte_Attr/outputSet/RESULTSET/APPUSER.T_DIZ_RECORDS[COMPONENTE = $curComponente]&quot;>&#xa;                        &lt;Attributo>&#xa;                            &lt;xsl:if test=&quot;not((string(NOME_ATTR_START/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NOME_ATTR_START/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NOME_ATTR_START)&quot;>&#xa;                                &lt;NomeAttributoStart>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_ATTR_START&quot;/>&#xa;                                &lt;/NomeAttributoStart>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(NOME_ATTR_END/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NOME_ATTR_END/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NOME_ATTR_END)&quot;>&#xa;                                &lt;NomeAttributoEnd>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_ATTR_END&quot;/>&#xa;                                &lt;/NomeAttributoEnd>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Attributo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/Componente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:Componenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ComponentiOrdine" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;MapArrichDatiOperReteFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE_C03_2021&quot;/>&#xa;    &lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:manageNotificationRequest>&#xa;            &lt;tns4:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;            &lt;/tns4:ID_RICHIESTA>&#xa;            &lt;tns4:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ProgressivoNotificaDTU>&#xa;            &lt;tns4:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEventoOrdnNowWhls>&#xa;            &lt;tns4:CodProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns4:CodProcsoNoFile>&#xa;            &lt;tns4:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEsecProcsoNoFile>&#xa;            &lt;xsl:copy-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA&quot;/>&#xa;            &lt;tns4:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ID_ANAGRAFICA_CAUSALE>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type[exists(Arricchimento/ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]) or exists(Arricchimento/ns2:SedeElement) or exists(Arricchimento/ns2:ReferenteElement) or exists(Arricchimento/ns2:DettaglioAssetElement)])&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:for-each select=&quot;$Accumulate/tns2:Arricchimenti_Type[exists(Arricchimento/ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]) or exists(Arricchimento/ns2:SedeElement) or exists(Arricchimento/ns2:ReferenteElement) or exists(Arricchimento/ns2:DettaglioAssetElement)]&quot;>&#xa;                            &lt;xsl:for-each select=&quot;Arricchimento[exists(ns2:DettaglioOrdineElement)]&quot;>&#xa;                                &lt;xsl:for-each select=&quot;ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]&quot;>&#xa;                                    &lt;ns2:DettaglioOrdineElement>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                            &lt;IDDettaglioOrdineParent>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineParent>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                            &lt;IDDettaglioOrdineRoot>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineRoot>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                            &lt;IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                            &lt;/IDRisorsa>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;nomeComponente>&#xa;                                            &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                        &lt;/nomeComponente>&#xa;                                        &lt;integrationID>&#xa;                                            &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                        &lt;/integrationID>&#xa;                                        &lt;xsl:for-each select=&quot;attributiDettaglioOrdine[string-length(valoreAttributo) > 0]&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                        &lt;/progressivo>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                            &lt;IDRisorsaNOW>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                            &lt;/IDRisorsaNOW>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns2:DettaglioOrdineElement>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE) and tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_DTUDATIOPERATORERETE_C03_2021) > -1&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MapArrichDatiOperReteFonia/Arricchimento/ns2:DettaglioOrdineElement&quot;/>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:SedeElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:SedeElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:ReferenteElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:ReferenteElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:manageNotificationRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperResponse-input"
                    name="MapperResponse"
                    outputVariable="MapperResponse"
                    tibex:xpdlId="ba8e07be-ba4b-4ebc-b677-aa3658fdc713" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogComponentiToMapperResponse_NOCOMPONENTI"/>
                        <bpws:target linkName="Empty2ToMapperResponse"/>
                        <bpws:target linkName="GenericLoggerToMapperResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperResponseToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;MapArrichDatiOperReteFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE_C03_2021&quot;/>&#xa;    &lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:manageNotificationRequest>&#xa;            &lt;tns4:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;            &lt;/tns4:ID_RICHIESTA>&#xa;            &lt;tns4:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ProgressivoNotificaDTU>&#xa;            &lt;tns4:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEventoOrdnNowWhls>&#xa;            &lt;tns4:CodProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns4:CodProcsoNoFile>&#xa;            &lt;tns4:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:IdEsecProcsoNoFile>&#xa;            &lt;xsl:copy-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA&quot;/>&#xa;            &lt;tns4:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns4:ID_ANAGRAFICA_CAUSALE>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type[exists(Arricchimento/ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]) or exists(Arricchimento/ns2:SedeElement) or exists(Arricchimento/ns2:ReferenteElement) or exists(Arricchimento/ns2:DettaglioAssetElement)])&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:for-each select=&quot;$Accumulate/tns2:Arricchimenti_Type[exists(Arricchimento/ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]) or exists(Arricchimento/ns2:SedeElement) or exists(Arricchimento/ns2:ReferenteElement) or exists(Arricchimento/ns2:DettaglioAssetElement)]&quot;>&#xa;                            &lt;xsl:for-each select=&quot;Arricchimento[exists(ns2:DettaglioOrdineElement)]&quot;>&#xa;                                &lt;xsl:for-each select=&quot;ns2:DettaglioOrdineElement[attributiDettaglioOrdine[string-length(valoreAttributo) > 0]]&quot;>&#xa;                                    &lt;ns2:DettaglioOrdineElement>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                            &lt;IDDettaglioOrdineParent>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineParent>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                            &lt;IDDettaglioOrdineRoot>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineRoot>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                            &lt;IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                            &lt;/IDRisorsa>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;nomeComponente>&#xa;                                            &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                        &lt;/nomeComponente>&#xa;                                        &lt;integrationID>&#xa;                                            &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                        &lt;/integrationID>&#xa;                                        &lt;xsl:for-each select=&quot;attributiDettaglioOrdine[string-length(valoreAttributo) > 0]&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                        &lt;/progressivo>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                            &lt;IDRisorsaNOW>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                            &lt;/IDRisorsaNOW>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns2:DettaglioOrdineElement>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE) and tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_DTUDATIOPERATORERETE_C03_2021) > -1&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MapArrichDatiOperReteFonia/Arricchimento/ns2:DettaglioOrdineElement&quot;/>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:SedeElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:SedeElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:ReferenteElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$Accumulate/tns2:Arricchimenti_Type/Arricchimento/ns2:ReferenteElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:manageNotificationRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:BPM_DTUNotificationManagement_v1="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="BPM_DTUNotificationManagement_v1:manageNotificationRequest" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:param name=&quot;MapperResponse&quot;/>&lt;xsl:template name=&quot;LogOutputMapping-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/tns3:BusinessID>&lt;tns3:Message>&lt;xsl:value-of select=&quot;&amp;quot;Output intermedio DTUtoBPM_Mapping&amp;quot;&quot;/>&lt;/tns3:Message>&lt;tns3:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($MapperResponse, true(), true())&quot;/>&lt;/tns3:Payload>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns3:LogLevel>&lt;tns3:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns3:LogJMS>&lt;/tns3:GenericLogger>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOutputMapping-input"
                    name="LogOutputMapping"
                    tibex:xpdlId="fcff3cea-7231-4def-96f6-1043c5e46db3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperResponseToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOutputMappingToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutputMapping-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Output intermedio DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperResponse, true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Componenti da creare tornate dalla procedura: &amp;quot;, tib:concat-sequence-format($ComponentiOrdine/Componente/NomeComponente, ' - ', true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogComponenti-input"
                    name="LogComponenti"
                    tibex:xpdlId="999d9c1c-df71-45af-918e-3e6e982806e2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignComponentiToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogComponentiToAssignAttributi">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ComponentiOrdine/Componente) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ComponentiOrdine/Componente) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogComponentiToMapperResponse_NOCOMPONENTI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Componenti da creare tornate dalla procedura: &amp;quot;, tib:concat-sequence-format($ComponentiOrdine/Componente/NomeComponente, ' - ', true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAttributi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Attributi da creare per ogni componente&amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ComponentiOrdine, true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogAttributi-input"
                    name="LogAttributi"
                    tibex:xpdlId="03555210-babe-40af-a04c-4a04599ea5b7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignAttributiToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogAttributiToJDBCQuery1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAttributi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Attributi da creare per ogni componente&amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ComponentiOrdine, true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="1ba0b696-336e-4a5d-a0e9-89214e5604cf">
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToWhile"/>
                    <bpws:target linkName="GenericLoggerToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLOG_Output"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+a13765b6-193d-4507-bc3a-9ada363bd411" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $countAggreg" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $countAggreg]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToMapArricchimenti" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapArricchimentiToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="da889566-19c2-432a-9fc5-9c6962457bdb">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapArricchimenti"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="a13765b6-193d-4507-bc3a-9ada363bd411" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapArricchimentiToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapArricchimenti</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Operation&quot;/>&lt;xsl:param name=&quot;Permutatore1&quot;/>&lt;xsl:param name=&quot;Permutatore2&quot;/>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Get_DizNomeCompnte_Attr&quot;/>&lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;AttributiOrdine&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE_C03_2021&quot;/>&lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&lt;xsl:param name=&quot;QueryONESTEP&quot;/>&lt;xsl:param name=&quot;DTLimite_ROE_FFIB&quot;/>&lt;xsl:param name=&quot;Query_Oscuramento&quot;/>&lt;xsl:param name=&quot;DTLimite_CARATTERIZZAZIONE_GEO&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOAGGIUNTIVO&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C06_2024&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C05_2026&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C06_2026&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C09_2026&quot;/>&lt;xsl:template name=&quot;MapArricchimenti-input&quot; match=&quot;/&quot;>&lt;tns2:Arricchimenti_Type>&lt;xsl:if test=&quot;count($Get_DizNomeCompnte_Attr/outputSet/RESULTSET/APPUSER.T_DIZ_RECORDS) > 0&quot;>&lt;xsl:for-each select=&quot;$ComponentiOrdine/Componente&quot;>&lt;Arricchimento>&lt;ns2:DettaglioOrdineElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeComponente>&lt;xsl:value-of select=&quot;NomeComponente&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/integrationID>&lt;xsl:for-each select=&quot;Attributo&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;NomeAttributoEnd&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;../NomeComponente='DTUDATIOPERATORERETE' and not(exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_OPERATORE_RETE) or exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_OPERATORE_RETE))&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Permutatore1) and NomeAttributoStart = &amp;quot;CONCAT_PERMUTATORE_1&amp;quot; and $ParseXml/Coppia[NodeName = &amp;quot;COORDOLO&amp;quot; and NodeCount = $index]/NodeValue&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Permutatore1&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Permutatore2) and NomeAttributoStart = &amp;quot;CONCAT_PERMUTATORE_2&amp;quot; and $ParseXml/Coppia[NodeName = &amp;quot;COORDOLO&amp;quot; and NodeCount = $index]/NodeValue&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Permutatore2&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_CONFIGURAZIONE_LOGICA' and NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_VC) and exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart and NodeCount = $index]/NodeValue&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_CONFIGURAZIONE_LOGICA&amp;quot; and exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart]/NodeValue&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;, &amp;quot;DIMENSIONEMORSETTIERA&amp;quot;, &amp;quot;RIPROGETTATO&amp;quot;, &amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;) and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NF_ESPLETAMENTO&amp;quot; and exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart and NodeCount = ($index+1)]/NodeValue&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;STATOAGGIUNTIVO&amp;quot;, &amp;quot;TELAGGIUNTIVO&amp;quot; ,&amp;quot;DIREZIONALITA&amp;quot;, &amp;quot;TIPOLOGIAACCESSO&amp;quot;)  and ../NomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;NUMAGGIUNTIVI&amp;quot; and $index!=1 and ../NomeComponente='DTUFONIA') or (NomeAttributoEnd = &amp;quot;NUMAGGIUNTIVI&amp;quot; and $index=1 and ../NomeComponente!='DTUFONIA')) and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;CODICEARMADIO&amp;quot; and $index!=1 and ../NomeComponente='DTUFONIA') or (NomeAttributoEnd = &amp;quot;CCLIARMADIO&amp;quot; and $index=1 and ../NomeComponente!='DTUFONIA')) and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;../NomeComponente='DTUDATICOLLAUDO' and (($AttributiOrdine/Record[1]/NOMECOMPONENTE=('ACCESSOATMASIMFLAT','ACCESSOATMASIMHL','ACCESSOATMASIMLITE','ACCESSOGBEASIMFLAT','ACCESSOVULAFTTCAB','ACCESSONGAFTTCAB','ACCESSOEASYIPFTTCAB') and (not(exists($AttributiOrdine/Record[NOMEATTRIBUTO='QUALIFICA']/VALOREATTRIBUTO)) or $AttributiOrdine/Record[NOMEATTRIBUTO='QUALIFICA']/VALOREATTRIBUTO='NO') and NomeAttributoEnd=('MBRDOWN','MBRUP','CBRDOWN','CBRUP')) or ($AttributiOrdine/Record[1]/NOMECOMPONENTE=('ACCESSOVULAFTTCAB','ACCESSONGAFTTCAB','ACCESSOEASYIPFTTCAB') and (not(exists($AttributiOrdine/Record[NOMEATTRIBUTO='TEST2']/VALOREATTRIBUTO)) or $AttributiOrdine/Record[NOMEATTRIBUTO='TEST2']/VALOREATTRIBUTO='NO') and NomeAttributoEnd='INDIRIZZOIPDESTINAZIONE')) and $QueryONESTEP/Record[1]/VALORE !='SI' and $QueryONESTEP/Record[1]/VALORE !='Y'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_CONFIGURAZIONE_LOGICA&amp;quot; and exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_OPERATORE_RETE) and ../NomeComponente='DTUCONFIGURAZIONE'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;NomeAttributoEnd = ('IDGPON','DIMENSIONEMORSETTIERA','CODICESPLITTERPRIMARIO','CODICESPLITTERSECONDARIO','ROE','POSIZIONESPLITTER','POSIZIONEMORSETTIERAROE','RIPROGETTATO','CAUSALERIPROGETTAZIONE') a