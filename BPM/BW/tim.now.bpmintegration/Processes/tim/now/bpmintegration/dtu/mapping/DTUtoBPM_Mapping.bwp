            <bpws:empty name="Empty" tibex:xpdlId="9b3ba664-792c-4fc2-9dc3-371a821db815">
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAggiuntiviPrenotaz">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$countAggiuntiviPrenotazione>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$countAggiuntiviPrenotazione>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($DTUtoBPMIn/input/tns:MappingDTUNotificationInput/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:SERVIZIO_AGGIUNTIVO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($DTUtoBPMIn.input/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:SERVIZIO_AGGIUNTIVO)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty1" tibex:xpdlId="e04b654a-ffda-45bc-83a5-006d3dcab9ab">
                <bpws:targets>
                    <bpws:target linkName="EmptyToEmpty1"/>
                    <bpws:target linkName="LogAggiuntPrenotToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToMapperResponse2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToMapper">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$countAggiuntiviFonia>0 &#xd;&#xa;and not($DTUtoBPMIn/input/tns:MappingDTUNotificationInput/tns:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$countAggiuntiviFonia>0 
and not($DTUtoBPMIn.input/tns:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="e0b956a0-3c65-4dd9-90f5-4c5fb9bc5d96">
                <bpws:targets>
                    <bpws:target linkName="AggiuntiviPrenotazToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToLogAggiuntPrenot"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+f5a2ce7d-9782-4b8c-bebd-a9fb45b302e6" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate1"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $countAggiuntiviPrenotazione" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $countAggiuntiviPrenotazione]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="1d371899-d365-437f-aa5a-f3b8f2b8a78c">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToMapper"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="f5a2ce7d-9782-4b8c-bebd-a9fb45b302e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
