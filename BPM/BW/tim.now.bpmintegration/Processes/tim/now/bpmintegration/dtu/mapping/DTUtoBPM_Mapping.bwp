            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:template name=&quot;LogResponse-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/tns3:BusinessID>&lt;tns3:Message>&lt;xsl:value-of select=&quot;&amp;quot;Output DTUtoBPM_Mapping&amp;quot;&quot;/>&lt;/tns3:Message>&lt;tns3:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Response, true(), true())&quot;/>&lt;/tns3:Payload>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns3:LogLevel>&lt;tns3:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns3:LogJMS>&lt;/tns3:GenericLogger>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogResponse-input" name="LogResponse"
                    tibex:xpdlId="a4df87fa-0264-45b5-85c3-e7a495aa031b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($countAggiuntiviFonia>0 &#xd;&#xa;and not($DTUtoBPMIn/input/tns:MappingDTUNotificationInput/tns:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)) &#xd;&#xa;or $countAggiuntiviPrenotazione>0 or count($DTUtoBPMIn/input/tns:MappingDTUNotificationInput/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:SERVIZIO_AGGIUNTIVO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($countAggiuntiviFonia>0 
and not($DTUtoBPMIn.input/tns:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)) 
or $countAggiuntiviPrenotazione>0 or count($DTUtoBPMIn.input/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:SERVIZIO_AGGIUNTIVO)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenericLoggerToDTUtoBPMOut">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Output DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response, true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperResponse&quot;/>&lt;xsl:param name=&quot;Operation&quot;/>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C10_2025&quot;/>&lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&lt;xsl:param name=&quot;Query_Oscuramento&quot;/>&lt;xsl:template name=&quot;Response-input&quot; match=&quot;/&quot;>&lt;tns4:manageNotificationRequest>&lt;tns4:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:ID_RICHIESTA&quot;/>&lt;/tns4:ID_RICHIESTA>&lt;tns4:ProgressivoNotificaDTU>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:ProgressivoNotificaDTU&quot;/>&lt;/tns4:ProgressivoNotificaDTU>&lt;tns4:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:IdEventoOrdnNowWhls&quot;/>&lt;/tns4:IdEventoOrdnNowWhls>&lt;tns4:CodProcsoNoFile>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:CodProcsoNoFile&quot;/>&lt;/tns4:CodProcsoNoFile>&lt;tns4:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:IdEsecProcsoNoFile&quot;/>&lt;/tns4:IdEsecProcsoNoFile>&lt;xsl:copy-of select=&quot;$MapperResponse/ns:EVENTO_NOTIFICA&quot;/>&lt;tns4:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;$MapperResponse/tns4:ID_ANAGRAFICA_CAUSALE&quot;/>&lt;/tns4:ID_ANAGRAFICA_CAUSALE>&lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement)&quot;>&lt;tns4:ARRICCHIMENTI>&lt;tns4:Arricchimento>&lt;xsl:for-each select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement[not(nomeComponente='DTUSERVIZIOPZIONALI')]&quot;>&lt;xsl:copy-of select=&quot;.&quot;/>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&lt;ns2:DettaglioOrdineElement>&lt;xsl:variable name=&quot;CodiceServizio&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;xsl:copy-of select=&quot;attributiDettaglioOrdine&quot;/>&lt;xsl:if test=&quot;string-length($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:PARAMETRO_NON_CONFORME)>0 and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C10_2025) > -1 and  ($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = 'N' or $Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = '0') or count($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'PARAMETRONONCONFORME'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:PARAMETRO_NON_CONFORME&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:VALORE_PARAMETRO_NON_CONFORME)>0 and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C10_2025) > -1 and ($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = 'N' or $Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = '0') or count($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'VALOREPARAMETRONONCONFORME'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:VALORE_PARAMETRO_NON_CONFORME&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;progressivo>&lt;xsl:value-of select=&quot;progressivo&quot;/>&lt;/progressivo>&lt;/ns2:DettaglioOrdineElement>&lt;/xsl:for-each>&lt;/tns4:Arricchimento>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;$Operation&quot;/>&lt;/tns4:Operation>&lt;/tns4:ARRICCHIMENTI>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:SedeElement)&quot;>&lt;tns4:ARRICCHIMENTI>&lt;tns4:Arricchimento>&lt;xsl:copy-of select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:SedeElement&quot;/>&lt;/tns4:Arricchimento>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;$Operation&quot;/>&lt;/tns4:Operation>&lt;/tns4:ARRICCHIMENTI>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:ReferenteElement)&quot;>&lt;tns4:ARRICCHIMENTI>&lt;tns4:Arricchimento>&lt;xsl:copy-of select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:ReferenteElement&quot;/>&lt;/tns4:Arricchimento>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;$Operation&quot;/>&lt;/tns4:Operation>&lt;/tns4:ARRICCHIMENTI>&lt;/xsl:if>&lt;/tns4:manageNotificationRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Response-input" name="Response"
                    outputVariable="Response"
                    tibex:xpdlId="1c8d04d4-10c7-47a2-989d-21eeb80673ee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOutputMappingToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C10_2025&quot;/>&#xa;    &lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Response-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:manageNotificationRequest>&#xa;            &lt;tns4:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:ID_RICHIESTA&quot;/>&#xa;            &lt;/tns4:ID_RICHIESTA>&#xa;            &lt;tns4:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:ProgressivoNotificaDTU&quot;/>&#xa;            &lt;/tns4:ProgressivoNotificaDTU>&#xa;            &lt;tns4:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/tns4:IdEventoOrdnNowWhls>&#xa;            &lt;tns4:CodProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:CodProcsoNoFile&quot;/>&#xa;            &lt;/tns4:CodProcsoNoFile>&#xa;            &lt;tns4:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:IdEsecProcsoNoFile&quot;/>&#xa;            &lt;/tns4:IdEsecProcsoNoFile>&#xa;            &lt;xsl:copy-of select=&quot;$MapperResponse/ns:EVENTO_NOTIFICA&quot;/>&#xa;            &lt;tns4:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;$MapperResponse/tns4:ID_ANAGRAFICA_CAUSALE&quot;/>&#xa;            &lt;/tns4:ID_ANAGRAFICA_CAUSALE>&#xa;            &lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:for-each select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement[not(nomeComponente='DTUSERVIZIOPZIONALI')]&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;.&quot;/>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:for-each select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&#xa;                            &lt;ns2:DettaglioOrdineElement>&#xa;                                &lt;xsl:variable name=&quot;CodiceServizio&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;xsl:copy-of select=&quot;attributiDettaglioOrdine&quot;/>&#xa;                                &lt;xsl:if test=&quot;string-length($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:PARAMETRO_NON_CONFORME)>0 and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C10_2025) > -1 and  ($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = 'N' or $Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = '0') or count($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0)&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;'PARAMETRONONCONFORME'&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:PARAMETRO_NON_CONFORME&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:VALORE_PARAMETRO_NON_CONFORME)>0 and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C10_2025) > -1 and ($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = 'N' or $Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = '0') or count($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0)&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;'VALOREPARAMETRONONCONFORME'&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI[ns:CODICE_SERVIZIO=$CodiceServizio]/ns:NON_CONFORMITA_ONT_OPERATORE/ns:VALORE_PARAMETRO_NON_CONFORME&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/ns2:DettaglioOrdineElement>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:SedeElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:SedeElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:ReferenteElement)&quot;>&#xa;                &lt;tns4:ARRICCHIMENTI>&#xa;                    &lt;tns4:Arricchimento>&#xa;                        &lt;xsl:copy-of select=&quot;$MapperResponse/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:ReferenteElement&quot;/>&#xa;                    &lt;/tns4:Arricchimento>&#xa;                    &lt;tns4:Operation>&#xa;                        &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;                    &lt;/tns4:Operation>&#xa;                &lt;/tns4:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:manageNotificationRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
