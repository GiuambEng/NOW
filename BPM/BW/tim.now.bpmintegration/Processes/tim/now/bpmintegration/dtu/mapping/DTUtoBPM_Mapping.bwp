            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:param name=&quot;countAggiuntiviFonia&quot;/>&lt;xsl:param name=&quot;Operation&quot;/>&lt;xsl:param name=&quot;countAggiuntiviPrenotazione&quot;/>&lt;xsl:param name=&quot;MapArricApparati2&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;MapperResponse2-input&quot; match=&quot;/&quot;>&lt;tns4:manageNotificationRequest>&lt;tns4:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/tns4:ID_RICHIESTA>&lt;tns4:ProgressivoNotificaDTU>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns4:ProgressivoNotificaDTU>&lt;tns4:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns4:IdEventoOrdnNowWhls>&lt;tns4:CodProcsoNoFile>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns4:CodProcsoNoFile>&lt;tns4:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns4:IdEsecProcsoNoFile>&lt;xsl:copy-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA&quot;/>&lt;tns4:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns4:ID_ANAGRAFICA_CAUSALE>&lt;tns4:ARRICCHIMENTI>&lt;tns4:Arricchimento>&lt;xsl:copy-of select=&quot;$Response/tns4:ARRICCHIMENTI/tns4:Arricchimento/ns2:DettaglioOrdineElement&quot;/>&lt;xsl:if test=&quot;$countAggiuntiviPrenotazione>0&quot;>&lt;xsl:for-each select=&quot;$Accumulate1/tns2:Arricchimenti_Type/Arricchimento&quot;>&lt;xsl:copy-of select=&quot;ns2:DettaglioOrdineElement&quot;/>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;$countAggiuntiviFonia>0 &amp;#xD;&amp;#xA;and not($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/tns1:Offerta=('WLRLINEAATTIVA','VULL','WLRLINEANONATTIVA') and $countAggiuntiviPrenotazione>0)&quot;>&lt;xsl:for-each select=&quot;$Accumulate2/tns2:Arricchimenti_Type/Arricchimento&quot;>&lt;xsl:copy-of select=&quot;ns2:DettaglioOrdineElement&quot;/>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;count($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZIO_AGGIUNTIVO)>0&quot;>&lt;xsl:copy-of select=&quot;$MapArricApparati2/Arricchimento/ns2:DettaglioOrdineElement&quot;/>&lt;/xsl:if>&lt;/tns4:Arricchimento>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;$Operation&quot;/>&lt;/tns4:Operation>&lt;/tns4:ARRICCHIMENTI>&lt;/tns4:manageNotificationRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperResponse2-input"
                    name="MapperResponse2"
                    outputVariable="MapperResponse2"
                    tibex:xpdlId="b75410a1-928e-45fb-b58b-adc60f3a09af" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
