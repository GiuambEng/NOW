                    expression="if (exists($DTUtoBPMIn/input/tns:MappingDTUNotificationInput/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:DATI_REPORTISTICA))&#xd;&#xa;then ($countAggreg +1)&#xd;&#xa;else $countAggreg"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="countAggreg" name="Assign"
                    outputVariable="countAggreg"
                    tibex:xpdlId="7297e007-3554-4db4-ad15-abbf08cb9663" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign_countAggregToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLOG_countAggreg"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (exists($DTUtoBPMIn.input/ns3:EVENTO_NOTIFICA/ns3:FINALE/ns3:DATI_REPORTISTICA))&#xd;&#xa;then ($countAggreg +1)&#xd;&#xa;else $countAggreg" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
