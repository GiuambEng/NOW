                    <bpws:sources>
                        <bpws:source linkName="DatiOperReteFoniaToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiOperReteFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;DatiOperatoreReteFonia>&#xa;            &lt;DatiOperatoreRete>&#xa;                &lt;Coppia>&#xa;                    &lt;Name>&#xa;                        &lt;xsl:value-of select=&quot;'TIPORETE'&quot;/>&#xa;                    &lt;/Name>&#xa;                    &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:TIPO_RETE_RAME&quot;>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:TIPO_RETE_RAME&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Coppia>&#xa;                &lt;Coppia>&#xa;                    &lt;Name>&#xa;                        &lt;xsl:value-of select=&quot;'DISTRIBUTORE'&quot;/>&#xa;                    &lt;/Name>&#xa;                    &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:DISTRIBUTORE&quot;>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:DISTRIBUTORE&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Coppia>&#xa;                &lt;Coppia>&#xa;                    &lt;Name>&#xa;                        &lt;xsl:value-of select=&quot;'COPPIA'&quot;/>&#xa;                    &lt;/Name>&#xa;                    &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:COPPIA&quot;>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE/ns:COPPIA&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Coppia>&#xa;            &lt;/DatiOperatoreRete>&#xa;        &lt;/DatiOperatoreReteFonia>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
