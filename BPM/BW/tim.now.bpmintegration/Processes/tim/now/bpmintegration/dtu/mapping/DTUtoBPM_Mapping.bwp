tart and NodeCount = $index]/NodeValue&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--La condizione su NUMAGGIUNTIVI è stata aggiunta per non creare 2 volte la componente DTUFONIA quando arriva anche PRENOTAZIONE_NUMERO da DTU ( o viceversa) poichè il tag è presente nelle 2 strutture-->&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:for-each>&lt;progressivo>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivo>&lt;/ns2:DettaglioOrdineElement>&lt;/Arricchimento>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_VERIFICA_TECNICA_E_TOPONOMASTICA' and $index=1&quot;>&lt;Arricchimento>&lt;ns2:SedeElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;IDSede>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDSede>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP&quot;>&lt;particellaToponomastica>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP&quot;/>&lt;/particellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA&quot;>&lt;via>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA&quot;/>&lt;/via>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_VIA&quot;>&lt;codiceVia>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_VIA&quot;/>&lt;/codiceVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO&quot;>&lt;civico>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO&quot;/>&lt;/civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:LOCALITA&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:LOCALITA&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE&quot;>&lt;comune>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE&quot;/>&lt;/comune>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:DESC_PROV&quot;>&lt;provincia>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:DESC_PROV&quot;/>&lt;/provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CAP&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CAP&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO&quot;>&lt;interno>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO&quot;/>&lt;/interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA&quot;>&lt;scala>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA&quot;/>&lt;/scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO&quot;>&lt;piano>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO&quot;/>&lt;/piano>&lt;/xsl:if>&lt;indirizzoEsteso>&lt;xsl:value-of select=&quot;concat($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP, &amp;quot; &amp;quot;, &amp;#xD;&amp;#xA;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO, &amp;quot; &amp;quot;, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO)&quot;/>&lt;/indirizzoEsteso>&lt;codiceISTATComune>&lt;xsl:value-of select=&quot;concat($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV, $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_COMUNE)&quot;/>&lt;/codiceISTATComune>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV&quot;>&lt;codiceISTATProvincia>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV&quot;/>&lt;/codiceISTATProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CODICE_INDIRIZZO&quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CODICE_INDIRIZZO&quot;/>&lt;/codiceToponomastica>&lt;/xsl:if>&lt;tipologiaSede>&lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTECERT&amp;quot;&quot;/>&lt;/tipologiaSede>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SIGLA_PROV&quot;>&lt;siglaProvincia>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SIGLA_PROV&quot;/>&lt;/siglaProvincia>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;/ns2:SedeElement>&lt;/Arricchimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_PRESA_APPUNTAMENTO' and $index=1 and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/tns1:Lavorazione = 'ATTIVAZIONE' and $DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/tns1:Offerta = 'FIXEDWIRELESSACCESS' and not($Query_Oscuramento/Record[COD_AGESP = 'R1I-22-0058']/FLAG_OSCURMENTO = 'Y')&quot;>&lt;Arricchimento>&lt;ns2:ReferenteElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/progressivoReferente>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&lt;/qualificaReferente>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;&amp;quot;3333333333&amp;quot;&quot;/>&lt;/telefonoFissoReferente>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;&amp;quot;3333333333&amp;quot;&quot;/>&lt;/telefonoMobileReferente>&lt;/ns2:ReferenteElement>&lt;/Arricchimento>&lt;/xsl:if>&lt;Operation>&lt;xsl:value-of select=&quot;$Operation&quot;/>&lt;/Operation>&lt;/tns2:Arricchimenti_Type>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapArricchimenti-input"
                                    name="MapArricchimenti"
                                    outputVariable="MapArricchimenti"
                                    tibex:xpdlId="8b5bb331-de33-470a-8d6e-97787331e9a6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToMapArricchimenti"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapArricchimentiToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;Permutatore1&quot;/>&#xa;    &lt;xsl:param name=&quot;Permutatore2&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Get_DizNomeCompnte_Attr&quot;/>&#xa;    &lt;xsl:param name=&quot;ComponentiOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;AttributiOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE_C03_2021&quot;/>&#xa;    &lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryONESTEP&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ROE_FFIB&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_CARATTERIZZAZIONE_GEO&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOAGGIUNTIVO&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C06_2024&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C05_2026&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C06_2026&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C09_2026&quot;/>&#xa;    &lt;xsl:template name=&quot;MapArricchimenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Arricchimenti_Type>&#xa;            &lt;xsl:if test=&quot;count($Get_DizNomeCompnte_Attr/outputSet/RESULTSET/APPUSER.T_DIZ_RECORDS) > 0&quot;>&#xa;                &lt;xsl:for-each select=&quot;$ComponentiOrdine/Componente&quot;>&#xa;                    &lt;Arricchimento>&#xa;                        &lt;ns2:DettaglioOrdineElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;NomeComponente&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;Attributo&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;NomeAttributoEnd&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;../NomeComponente='DTUDATIOPERATORERETE' and not(exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_OPERATORE_RETE) or exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_OPERATORE_RETE))&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Permutatore1) and NomeAttributoStart = &amp;quot;CONCAT_PERMUTATORE_1&amp;quot; and $ParseXml/Coppia[NodeName = &amp;quot;COORDOLO&amp;quot; and NodeCount = $index]/NodeValue&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Permutatore1&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Permutatore2) and NomeAttributoStart = &amp;quot;CONCAT_PERMUTATORE_2&amp;quot; and $ParseXml/Coppia[NodeName = &amp;quot;COORDOLO&amp;quot; and NodeCount = $index]/NodeValue&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Permutatore2&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_CONFIGURAZIONE_LOGICA' and NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_VC) and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart and NodeCount = $index]/NodeValue&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_CONFIGURAZIONE_LOGICA&amp;quot; and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart]/NodeValue&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;, &amp;quot;DIMENSIONEMORSETTIERA&amp;quot;, &amp;quot;RIPROGETTATO&amp;quot;, &amp;quot;CAUSALERIPROGETTAZIONE&amp;quot;) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NF_ESPLETAMENTO&amp;quot; and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart and NodeCount = ($index+1)]/NodeValue&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;STATOAGGIUNTIVO&amp;quot;, &amp;quot;TELAGGIUNTIVO&amp;quot; ,&amp;quot;DIREZIONALITA&amp;quot;, &amp;quot;TIPOLOGIAACCESSO&amp;quot;)  and ../NomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;NUMAGGIUNTIVI&amp;quot; and $index!=1 and ../NomeComponente='DTUFONIA') or (NomeAttributoEnd = &amp;quot;NUMAGGIUNTIVI&amp;quot; and $index=1 and ../NomeComponente!='DTUFONIA')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;CODICEARMADIO&amp;quot; and $index!=1 and ../NomeComponente='DTUFONIA') or (NomeAttributoEnd = &amp;quot;CCLIARMADIO&amp;quot; and $index=1 and ../NomeComponente!='DTUFONIA')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;../NomeComponente='DTUDATICOLLAUDO' and (($AttributiOrdine/Record[1]/NOMECOMPONENTE=('ACCESSOATMASIMFLAT','ACCESSOATMASIMHL','ACCESSOATMASIMLITE','ACCESSOGBEASIMFLAT','ACCESSOVULAFTTCAB','ACCESSONGAFTTCAB','ACCESSOEASYIPFTTCAB') and (not(exists($AttributiOrdine/Record[NOMEATTRIBUTO='QUALIFICA']/VALOREATTRIBUTO)) or $AttributiOrdine/Record[NOMEATTRIBUTO='QUALIFICA']/VALOREATTRIBUTO='NO') and NomeAttributoEnd=('MBRDOWN','MBRUP','CBRDOWN','CBRUP')) or ($AttributiOrdine/Record[1]/NOMECOMPONENTE=('ACCESSOVULAFTTCAB','ACCESSONGAFTTCAB','ACCESSOEASYIPFTTCAB') and (not(exists($AttributiOrdine/Record[NOMEATTRIBUTO='TEST2']/VALOREATTRIBUTO)) or $AttributiOrdine/Record[NOMEATTRIBUTO='TEST2']/VALOREATTRIBUTO='NO') and NomeAttributoEnd='INDIRIZZOIPDESTINAZIONE')) and $QueryONESTEP/Record[1]/VALORE !='SI' and $QueryONESTEP/Record[1]/VALORE !='Y'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;IDGPON&amp;quot;, &amp;quot;IDEGON&amp;quot; ,&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;, &amp;quot;CODICESPLITTERSECONDARIO&amp;quot;, &amp;quot;ROE&amp;quot;, &amp;quot;POSIZIONESPLITTER&amp;quot;, &amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_CONFIGURAZIONE_LOGICA&amp;quot; and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_OPERATORE_RETE) and ../NomeComponente='DTUCONFIGURAZIONE'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = ('IDGPON','DIMENSIONEMORSETTIERA','CODICESPLITTERPRIMARIO','CODICESPLITTERSECONDARIO','ROE','POSIZIONESPLITTER','POSIZIONEMORSETTIERAROE','RIPROGETTATO','CAUSALERIPROGETTAZIONE') and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NF_ESPLETAMENTO&amp;quot; and exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_OPERATORE_RETE) and ../NomeComponente='DTUDATIACCESSO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = ('TIPORETE','DISTRIBUTORE','COPPIA') and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NF_ESPLETAMENTO&amp;quot; and ../NomeComponente='DTUDATIOPERATORERETE' and tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_DTUDATIOPERATORERETE_C03_2021) = -1&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'ROEFFIB' and ../NomeComponente='DTUDATIOPERATORERETE' and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_ROE_FFIB) = -1 or $Query_Oscuramento/Record[COD_AGESP= 'R9F-21-0030']/FLAG_OSCURMENTO = 'Y')&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;CODICEESITO&amp;quot; and $index=1 and ../NomeComponente='DTUSERVIZIOPZIONALI')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'CARATTERIZZAZIONEGEO' and ../NomeComponente='DTUDATIACCESSO' and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_CARATTERIZZAZIONE_GEO) = -1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'BANDOPUBBLICO' and ../NomeComponente='DTUDATIACCESSO' and &amp;#xD;&amp;#xA; tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C05_2026) = -1&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'DIRETTOINFRATEL' and ../NomeComponente='DTUDATIACCESSO' and &amp;#xD;&amp;#xA; tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C05_2026) = -1&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'COPERTOFTTH' and ../NomeComponente='DTUDATIACCESSO' and &amp;#xD;&amp;#xA; tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C05_2026) = -1&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'SPECIALPRICE' and ../NomeComponente='DTUDATIACCESSO' and &amp;#xD;&amp;#xA; tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C05_2026) = -1&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'COPERTOFTTH' and ../NomeComponente='DTUDATIACCESSO' and &amp;#xD;&amp;#xA;($Query_Oscuramento/Record[COD_AGESP= 'T1PRJ0063400']/FLAG_OSCURMENTO = 'Y' or $Query_Oscuramento/Record[COD_AGESP= 'T1PRJ0063400']/FLAG_OSCURMENTO = '1' or tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C09_2026) = -1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = 'ESITOCP' and ../NomeComponente='DTUDATIREPORTISTICA' and &amp;#xD;&amp;#xA;($Query_Oscuramento/Record[COD_AGESP= 'T1PRJ0002889']/FLAG_OSCURMENTO = 'Y' or $Query_Oscuramento/Record[COD_AGESP= 'T1PRJ0002889']/FLAG_OSCURMENTO = '1' or tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C06_2026) = -1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = ('IDPCN','IDKIT','SERVICEVLAN','CVLAN','VLANAGGREGANTE','PROFILOVLAN') and ../NomeComponente='DTUDATIVC' and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_DTUSERVIZIOAGGIUNTIVO) = -1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;CODICESERVIZIO&amp;quot; and ../NomeComponente='DTUSERVIZIOPZIONALI')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO' and not(exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI))&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = &amp;quot;ESITO&amp;quot; and ../NomeComponente='DTUDATIVC' and $index>count($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC))) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = ('IPADDRESSNET','SUBNETMASKNET') and ../NomeComponente='DTUDATIACCESSO' and (tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_KIT_C06_2024) = -1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = (&amp;quot;CODICESERVIZIO&amp;quot;,&amp;quot;ESITO&amp;quot;) and ../NomeComponente='DTUAPPARATOFWA')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO' and not(exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:APPARATO))&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = (&amp;quot;CODICEESITO&amp;quot;,&amp;quot;DESCRIZIONEESITO&amp;quot;) and ../NomeComponente='DTUINTERVENTOSEDECLIENTE')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO' and (not(exists($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:MOTIVAZIONE_INTERVENTO_IN_SEDE_CLIENTE)) or $index=1)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;NomeAttributoEnd = (&amp;quot;FLAGONTOPERATORE&amp;quot;,&amp;quot;MODELLOSERVIZIOPERVALIDAZIONI&amp;quot;) and ../NomeComponente='DTUONTOPERATORE' and ($Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = 'Y' or $Query_Oscuramento/Record[COD_AGESP= 'R1I-25-0151']/FLAG_OSCURMENTO = '1')&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((NomeAttributoEnd = (&amp;quot;CODICE&amp;quot;,&amp;quot;DESCRIZIONE&amp;quot;) and ../NomeComponente='DTUDATIVC')) and $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA='NF_ESPLETAMENTO' and $index>count($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$ParseXml/Coppia[NodeName = current()/NomeAttributoStart and NodeCount = $index]/NodeValue&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;!--La condizione su NUMAGGIUNTIVI è stata aggiunta per non creare 2 volte la componente DTUFONIA quando arriva anche PRENOTAZIONE_NUMERO da DTU ( o viceversa) poichè il tag è presente nelle 2 strutture-->&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/ns2:DettaglioOrdineElement>&#xa;                    &lt;/Arricchimento>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_VERIFICA_TECNICA_E_TOPONOMASTICA' and $index=1&quot;>&#xa;                &lt;Arricchimento>&#xa;                    &lt;ns2:SedeElement>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDSede>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/IDSede>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP&quot;>&#xa;                            &lt;particellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP&quot;/>&#xa;                            &lt;/particellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA&quot;>&#xa;                            &lt;via>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA&quot;/>&#xa;                            &lt;/via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_VIA&quot;>&#xa;                            &lt;codiceVia>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_VIA&quot;/>&#xa;                            &lt;/codiceVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO&quot;>&#xa;                            &lt;civico>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO&quot;/>&#xa;                            &lt;/civico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:LOCALITA&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:LOCALITA&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:DESC_PROV&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:DESC_PROV&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;indirizzoEsteso>&#xa;                            &lt;xsl:value-of select=&quot;concat($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMUNE, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PARTICELLATOP, &amp;quot; &amp;quot;, &amp;#xD;&amp;#xA;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:VIA, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CIVICO, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:COMPLESSO, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SCALA, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:PIANO, &amp;quot; &amp;quot;, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:INTERNO)&quot;/>&#xa;                        &lt;/indirizzoEsteso>&#xa;                        &lt;codiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;concat($DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV, $DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_COMUNE)&quot;/>&#xa;                        &lt;/codiceISTATComune>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:ISTAT_PROV&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CODICE_INDIRIZZO&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:CODICE_INDIRIZZO&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaSede>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTECERT&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaSede>&#xa;                        &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SIGLA_PROV&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE/ns:SIGLA_PROV&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                        &lt;/operatore>&#xa;                    &lt;/ns2:SedeElement>&#xa;                &lt;/Arricchimento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = 'NI_PRESA_APPUNTAMENTO' and $index=1 and $DTUtoBPMIn.input/tns1:Lavorazione = 'ATTIVAZIONE' and $DTUtoBPMIn.input/tns1:Offerta = 'FIXEDWIRELESSACCESS' and not($Query_Oscuramento/Record[COD_AGESP = 'R1I-22-0058']/FLAG_OSCURMENTO = 'Y')&quot;>&#xa;                &lt;Arricchimento>&#xa;                    &lt;ns2:ReferenteElement>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;progressivoReferente>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/progressivoReferente>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;qualificaReferente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;3333333333&amp;quot;&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;3333333333&amp;quot;&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/ns2:ReferenteElement>&#xa;                &lt;/Arricchimento>&#xa;            &lt;/xsl:if>&#xa;            &lt;Operation>&#xa;                &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;            &lt;/Operation>&#xa;        &lt;/tns2:Arricchimenti_Type>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:DTUtoBPM_Mapping="http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="DTUtoBPM_Mapping:Arricchimenti_Type" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
