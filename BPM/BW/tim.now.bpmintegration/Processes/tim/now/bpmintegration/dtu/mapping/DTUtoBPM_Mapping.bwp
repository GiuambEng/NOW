                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:template name=&quot;AggFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;AggiuntiviFonia>&#xa;            &lt;xsl:for-each select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:AGGIUNTIVI&quot;>&#xa;                &lt;Aggiuntivo>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'STATOAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TELAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'DIREZIONALITA'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;xsl:if test=&quot;ns:DIREZIONALITA&quot;>&#xa;                            &lt;Value>&#xa;                                &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                            &lt;/Value>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOLOGIAACCESSO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                &lt;/Aggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/AggiuntiviFonia>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="AggFonia-input" name="AggFonia"
                    outputVariable="AggFonia"
                    tibex:xpdlId="08f2c6ba-078d-4f19-adbc-3545d459a72b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AggFoniaToWhile2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;AggFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;AggiuntiviFonia>&#xa;            &lt;xsl:for-each select=&quot;$DTUtoBPMIn.input/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:AGGIUNTIVI&quot;>&#xa;                &lt;Aggiuntivo>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'STATOAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TELAGGIUNTIVO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'DIREZIONALITA'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;xsl:if test=&quot;ns:DIREZIONALITA&quot;>&#xa;                            &lt;Value>&#xa;                                &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                            &lt;/Value>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Coppia>&#xa;                    &lt;Coppia>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOLOGIAACCESSO'&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Coppia>&#xa;                &lt;/Aggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/AggiuntiviFonia>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
