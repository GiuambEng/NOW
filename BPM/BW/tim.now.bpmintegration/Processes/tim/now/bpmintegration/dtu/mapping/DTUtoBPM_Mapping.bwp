                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapArricchAggiuntPrenotaz</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DTUtoBPM_Mapping/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:ns2=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Operation&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUtoBPMIn&quot;/>&#xa;    &lt;xsl:param name=&quot;countAggreg&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;AggiuntiviPrenotaz&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE_C03_2021&quot;/>&#xa;    &lt;xsl:param name=&quot;CreatedRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;MapArricchAggiuntPrenotaz-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Arricchimenti_Type>&#xa;            &lt;Arricchimento>&#xa;                &lt;ns2:DettaglioOrdineElement>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;'DTUPRENOTAZIONEAGGIUNTIVO'&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;xsl:for-each select=&quot;$AggiuntiviPrenotaz/Aggiuntivo[number($index)]/Coppia[string-length(Value)>0]&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;Name&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;Value&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($DTUtoBPMIn/input/tns1:MappingDTUNotificationInput/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA/ns:DATI_OPERATORE_RETE) and tib:compare-dateTime($CreatedRichiesta/Record[1]/CREATED, $DTLimite_DTUDATIOPERATORERETE_C03_2021) > -1&quot;>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+$countAggreg+1)&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+$countAggreg)&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns2:DettaglioOrdineElement>&#xa;            &lt;/Arricchimento>&#xa;            &lt;Operation>&#xa;                &lt;xsl:value-of select=&quot;$Operation&quot;/>&#xa;            &lt;/Operation>&#xa;        &lt;/tns2:Arricchimenti_Type>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapArricchAggiuntPrenotaz-input"
                                    name="MapArricchAggiuntPrenotaz"
