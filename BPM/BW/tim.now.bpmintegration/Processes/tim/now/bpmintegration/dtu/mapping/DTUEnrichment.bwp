                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Proc_TrascodCodCausDest&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Procedura-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;enrich&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Estratti dati da procedura: &amp;quot;, tib:concat-sequence-format($Proc_TrascodCodCausDest/outputSet/RESULTSET, &amp;quot;|&amp;quot;, true()), &amp;quot; .&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectNomeOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectScenario&quot;/>&#xa;    &lt;xsl:param name=&quot;selDatiOffertaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_SottoLavrzDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_FirstStep-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;enrich&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione dati: SelectNomeOLO: &amp;quot;, $SelectNomeOLO/Record[1]/NOME_OLO, &amp;quot; - SelectScenario: &amp;quot;, tib:concat-sequence-format($SelectScenario/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelectSottoLavrzDTU: &amp;quot;, tib:concat-sequence-format($Select_SottoLavrzDTU/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelectDatiOffertaDTU: &amp;quot;, tib:concat-sequence-format($selDatiOffertaDTU/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; .&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_FirstStep-input"
                    name="LOG_FirstStep"
                    tibex:xpdlId="9d4bbfe6-0e82-4bef-9533-5fd6b90579d6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="selDatiOffertaDTUToLOG_FirstStep"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_FirstStepToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$enrichIn/input/ns4:DTUEnrichmentRequest/ns4:StrutturaRichiesta = 'NGA' or $enrichIn/input/ns4:DTUEnrichmentRequest/ns4:StrutturaRichiesta = 'XDSL' or $enrichIn/input/ns4:DTUEnrichmentRequest/ns4:StrutturaRichiesta = 'FIBERSTREAM'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$enrichIn.input/ns4:StrutturaRichiesta = 'NGA' or $enrichIn.input/ns4:StrutturaRichiesta = 'XDSL' or $enrichIn.input/ns4:StrutturaRichiesta = 'FIBERSTREAM']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToProc_REGOLATORIO-NP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectNomeOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectScenario&quot;/>&#xa;    &lt;xsl:param name=&quot;selDatiOffertaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_SottoLavrzDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_FirstStep-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUEnrichment&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;enrich&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione dati: SelectNomeOLO: &amp;quot;, $SelectNomeOLO/Record[1]/NOME_OLO, &amp;quot; - SelectScenario: &amp;quot;, tib:concat-sequence-format($SelectScenario/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelectSottoLavrzDTU: &amp;quot;, tib:concat-sequence-format($Select_SottoLavrzDTU/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelectDatiOffertaDTU: &amp;quot;, tib:concat-sequence-format($selDatiOffertaDTU/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; .&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d43f110-c22a-411f-9daf-96533ddb6b81+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Select_SottoLavrzDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;SottoLavorazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:SottoLavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:SottoLavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SottoLavorazione>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Select_SottoLavrzDTU-input"
                    name="Select_SottoLavrzDTU"
                    outputVariable="Select_SottoLavrzDTU"
                    tibex:xpdlId="4d43f110-c22a-411f-9daf-96533ddb6b81" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
