                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FO.DESCR as FAMIG_OFFERTA, SO.DESCR as SOTTO_FAMIG_OFFERTA, TD.DESCR AS NOME_OFFERTA_DTU&#xa;&#x9;FROM FAMIG_OFFERTA FO, SOTTO_FAMIG_OFFERTA SO, TRASCODFC_OFFERTA TR, OFFERTA O, TIPOLG_OFFERTA_DTU TD&#xa;&#x9;WHERE FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA &#xa;    AND TD.ID_NOME_OFFERTA_DTU = O.ID_NOME_OFFERTA_DTU&#xa;    AND SO.ID_SOTTOFAMIG_OFFERTA = O.ID_SOTTOFAMIG_OFFERTA&#xa;&#x9;&#x9;AND O.ID_OFFERTA = TR.ID_OFFERTA&#xa;&#x9;&#x9;AND TR.NOME_OFFERTA_ESTERNA = ?&#xa;&#x9;&#x9;AND TR.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="FAMIG_OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SOTTO_FAMIG_OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
