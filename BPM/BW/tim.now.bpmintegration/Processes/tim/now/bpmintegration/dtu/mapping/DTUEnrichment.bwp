                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;selectProfiloVLANbdm_OLD&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiOLD_Out&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($selectProfiloVLANbdm_OLD/Record) > 0&quot;>&#xa;                &lt;tns1:DatiOLD_Out>&#xa;                    &lt;tns1:PROFILO_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/PROFILO)&quot;/>&#xa;                    &lt;/tns1:PROFILO_OLD>&#xa;                    &lt;tns1:BP2_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP2)&quot;/>&#xa;                    &lt;/tns1:BP2_OLD>&#xa;                    &lt;tns1:BP2_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP2_MAX)&quot;/>&#xa;                    &lt;/tns1:BP2_MAX_OLD>&#xa;                    &lt;tns1:BP3_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP3)&quot;/>&#xa;                    &lt;/tns1:BP3_OLD>&#xa;                    &lt;tns1:BP3_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP3_MAX)&quot;/>&#xa;                    &lt;/tns1:BP3_MAX_OLD>&#xa;                    &lt;tns1:BP5_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP5)&quot;/>&#xa;                    &lt;/tns1:BP5_OLD>&#xa;                    &lt;tns1:BP5_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP5_MAX)&quot;/>&#xa;                    &lt;/tns1:BP5_MAX_OLD>&#xa;                    &lt;tns1:BP6_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP6)&quot;/>&#xa;                    &lt;/tns1:BP6_OLD>&#xa;                    &lt;tns1:BP6_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm_OLD/Record[1]/BP6_MAX)&quot;/>&#xa;                    &lt;/tns1:BP6_MAX_OLD>&#xa;                &lt;/tns1:DatiOLD_Out>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:DatiOLD_Out/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
