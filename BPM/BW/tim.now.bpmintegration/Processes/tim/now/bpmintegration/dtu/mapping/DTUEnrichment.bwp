/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($selectProfiloVLANbdm/Record) > 0&quot;>&#xa;                    &lt;tns1:BP6>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm/Record[1]/BP6)&quot;/>&#xa;                    &lt;/tns1:BP6>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($selectProfiloVLANbdm/Record) > 0&quot;>&#xa;                    &lt;tns1:BP6_MAX>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm/Record[1]/BP6_MAX)&quot;/>&#xa;                    &lt;/tns1:BP6_MAX>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/BMC_LIGHT&quot;>&#xa;                &lt;tns1:BMCLIGHT>&#xa;                    &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/BMC_LIGHT&quot;/>&#xa;                &lt;/tns1:BMCLIGHT>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:DATI_OLD>&#xa;                &lt;xsl:copy-of select=&quot;$DatiOLD_Out/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$DatiOLD_Out/@*&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$DatiOLD_Out/node()&quot;/>&#xa;            &lt;/tns1:DATI_OLD>&#xa;        &lt;/tns1:DatiOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
