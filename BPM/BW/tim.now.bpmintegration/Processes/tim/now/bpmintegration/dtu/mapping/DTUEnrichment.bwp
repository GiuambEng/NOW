                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c1015b35-063c-432b-8efa-f1431c885b5c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelPrfTcnLinea_OLD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;            &lt;PROFILO_TCNC_LINEA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:ProfiloTecnicoLinea_OLD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/PROFILO_TCNC_LINEA>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PTL.PROFILO_TCNC_LINEA, PTL.TIPO_MODULAZIONE, PTL.MODELLO_ACCS, PTL.PROFILO_COMMERCIALE_DOWN,&#xa; &#x9;PTL.PROFILO_COMMERCIALE_UP, PTL.VELOCITA_AGGANCIO_DOWN_MAX,&#xa; &#x9;PTL.VELOCITA_AGGANCIO_DOWN_MIN, PTL.VELOCITA_AGGANCIO_UP_MIN, PTL.VELOCITA_AGGANCIO_UP_MAX&#xa;FROM PROFILO_TCNC_LINEA PTL, TRASCODFC_OFFERTA O&#xa;WHERE PTL.ID_OFFERTA = O.ID_OFFERTA AND O.NOME_OFFERTA_ESTERNA = ? AND O.PROVENIENZA = 'BPM'&#xa; AND PTL.PROFILO_TCNC_LINEA = ?&#xa;ORDER BY PTL.MODELLO_ACCS&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO_TCNC_LINEA"/>
                                    <columnMetadata
                                    columnName="PROFILO_TCNC_LINEA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_MODULAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="MODELLO_ACCS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROFILO_COMMERCIALE_DOWN"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PROFILO_COMMERCIALE_UP"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VELOCITA_AGGANCIO_DOWN_MAX"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VELOCITA_AGGANCIO_DOWN_MIN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VELOCITA_AGGANCIO_UP_MIN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VELOCITA_AGGANCIO_UP_MAX"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelCampoServizioIT&quot;/>&#xa;    &lt;xsl:param name=&quot;SelFlagContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;SelPrfTcnLinea&quot;/>&#xa;    &lt;xsl:param name=&quot;SelDescrPag&quot;/>&#xa;    &lt;xsl:template name=&quot;LogGenericEnrich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'DTUEnrichment'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'DTUEnrichment'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'enrich'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione dati generici: SelectCampoServizioIT: &amp;quot;, $SelCampoServizioIT/Record[1]/CAMPO_SERVIZIO_IT, &amp;quot; - SelFlagContratto: &amp;quot;, $SelFlagContratto/Record[1]/FLAG_ANFIBIO, &amp;quot; - SelPrfTcncLinea: &amp;quot;, tib:concat-sequence-format($SelPrfTcnLinea/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelDescrPagamento: &amp;quot;, $SelDescrPag/Record[1]/DESCR_PAGAMENTO, &amp;quot; .&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogPrfTcnLinea_OLD-input"
                    name="LogPrfTcnLinea_OLD"
                    tibex:xpdlId="c279fde5-b158-4a3c-826a-96aa0c3c8f3f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
