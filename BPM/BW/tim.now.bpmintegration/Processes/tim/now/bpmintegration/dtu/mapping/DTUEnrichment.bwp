            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectNomeOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelCampoServizioIT&quot;/>&#xa;    &lt;xsl:param name=&quot;selDatiOffertaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;SelFlagContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateDatiOut&quot;/>&#xa;    &lt;xsl:param name=&quot;SelPrfTcnLinea&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectScenario&quot;/>&#xa;    &lt;xsl:param name=&quot;Proc_TrascodCodCausDest&quot;/>&#xa;    &lt;xsl:param name=&quot;SelDescrPag&quot;/>&#xa;    &lt;xsl:param name=&quot;SelPrfTcnLinea_OLD&quot;/>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_SottoLavrzDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;MapResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DTUEnrichmentResponse>&#xa;            &lt;xsl:if test=&quot;count($SelectNomeOLO/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelectNomeOLO/Record[1]/NOME_OLO&quot;>&#xa;                    &lt;tns1:NomeOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNomeOLO/Record[1]/NOME_OLO&quot;/>&#xa;                    &lt;/tns1:NomeOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelCampoServizioIT/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelCampoServizioIT/Record[1]/CAMPO_SERVIZIO_IT&quot;>&#xa;                    &lt;tns1:CampoServizioIT>&#xa;                        &lt;xsl:value-of select=&quot;$SelCampoServizioIT/Record[1]/CAMPO_SERVIZIO_IT&quot;/>&#xa;                    &lt;/tns1:CampoServizioIT>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/NOME_OFFERTA_DTU&quot;>&#xa;                    &lt;tns1:OffertaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/NOME_OFFERTA_DTU&quot;/>&#xa;                    &lt;/tns1:OffertaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/FAMIG_OFFERTA&quot;>&#xa;                    &lt;tns1:FamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/FAMIG_OFFERTA&quot;/>&#xa;                    &lt;/tns1:FamigliaOfferta>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/SOTTO_FAMIG_OFFERTA&quot;>&#xa;                    &lt;tns1:SottoFamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/SOTTO_FAMIG_OFFERTA&quot;/>&#xa;                    &lt;/tns1:SottoFamigliaOfferta>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelFlagContratto/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelFlagContratto/Record[1]/FLAG_ANFIBIO&quot;>&#xa;                    &lt;tns1:FlagAnfibio>&#xa;                        &lt;xsl:value-of select=&quot;$SelFlagContratto/Record[1]/FLAG_ANFIBIO&quot;/>&#xa;                    &lt;/tns1:FlagAnfibio>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelectScenario/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelectScenario/Record[1]/SCENARIO_DTU&quot;>&#xa;                    &lt;tns1:ScenarioDTU>&#xa;                        &lt;xsl:value-of select=&quot;$SelectScenario/Record[1]/SCENARIO_DTU&quot;/>&#xa;                    &lt;/tns1:ScenarioDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Select_SottoLavrzDTU/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Select_SottoLavrzDTU/Record[1]/TIPOLG_SOTTO_LAVRZ_DTU&quot;>&#xa;                        &lt;tns1:SottoLavorazioneDTU>&#xa;                            &lt;xsl:value-of select=&quot;$Select_SottoLavrzDTU/Record[1]/TIPOLG_SOTTO_LAVRZ_DTU&quot;/>&#xa;                        &lt;/tns1:SottoLavorazioneDTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:SottoLavorazione&quot;>&#xa;                        &lt;tns1:SottoLavorazioneDTU>&#xa;                            &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:SottoLavorazione&quot;/>&#xa;                        &lt;/tns1:SottoLavorazioneDTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($SelDescrPag/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelDescrPag/Record[1]/DESCR_PAGAMENTO&quot;>&#xa;                    &lt;tns1:DescrPagamento>&#xa;                        &lt;xsl:value-of select=&quot;$SelDescrPag/Record[1]/DESCR_PAGAMENTO&quot;/>&#xa;                    &lt;/tns1:DescrPagamento>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelPrfTcnLinea/Record) > 0&quot;>&#xa;                    &lt;tns1:ProfiloTcncLinea>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/PROFILO_TCNC_LINEA&quot;>&#xa;                            &lt;tns1:PROFILO_TCNC_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/PROFILO_TCNC_LINEA&quot;/>&#xa;                            &lt;/tns1:PROFILO_TCNC_LINEA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/TIPO_MODULAZIONE&quot;>&#xa;                            &lt;tns1:TIPO_MODULAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/TIPO_MODULAZIONE&quot;/>&#xa;                            &lt;/tns1:TIPO_MODULAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/MODELLO_ACCS&quot;>&#xa;                            &lt;tns1:MODELLO_ACCS>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/MODELLO_ACCS&quot;/>&#xa;                            &lt;/tns1:MODELLO_ACCS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:PROFILO_COMMERCIALE_DOWN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                        &lt;/tns1:PROFILO_COMMERCIALE_DOWN>&#xa;                        &lt;tns1:PROFILO_COMMERCIALE_UP>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                        &lt;/tns1:PROFILO_COMMERCIALE_UP>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_DOWN_MAX>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MAX>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_DOWN_MIN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MIN>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_UP_MIN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_UP_MIN)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_UP_MIN>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_UP_MAX>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_UP_MAX)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_UP_MAX>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/COD_MODEM&quot;>&#xa;                            &lt;tns1:COD_MODEM>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/COD_MODEM&quot;/>&#xa;                            &lt;/tns1:COD_MODEM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/PROTOCOLLO&quot;>&#xa;                            &lt;tns1:PROTOCOLLO>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/PROTOCOLLO&quot;/>&#xa;                            &lt;/tns1:PROTOCOLLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:ProfiloTcncLinea>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($SelPrfTcnLinea_OLD/Record) > 0&quot;>&#xa;                &lt;tns1:ProfiloTecnicoLineaOLD>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/PROFILO_TCNC_LINEA&quot;>&#xa;                        &lt;tns1:PROFILO_TCNC_LINEA_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/PROFILO_TCNC_LINEA&quot;/>&#xa;                        &lt;/tns1:PROFILO_TCNC_LINEA_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/TIPO_MODULAZIONE&quot;>&#xa;                        &lt;tns1:TIPO_MODULAZIONE_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/TIPO_MODULAZIONE&quot;/>&#xa;                        &lt;/tns1:TIPO_MODULAZIONE_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/MODELLO_ACCS&quot;>&#xa;                        &lt;tns1:MODELLO_ACCS_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/MODELLO_ACCS&quot;/>&#xa;                        &lt;/tns1:MODELLO_ACCS_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:PROFILO_COMMERCIALE_DOWN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                    &lt;/tns1:PROFILO_COMMERCIALE_DOWN_OLD>&#xa;                    &lt;tns1:PROFILO_COMMERCIALE_UP_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                    &lt;/tns1:PROFILO_COMMERCIALE_UP_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_DOWN_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MAX_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_DOWN_MIN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MIN_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_UP_MIN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_UP_MIN)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_UP_MIN_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_UP_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_UP_MAX)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_UP_MAX_OLD>&#xa;                &lt;/tns1:ProfiloTecnicoLineaOLD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateDatiOut/tns1:DatiOut&quot;>&#xa;                &lt;tns1:Dati>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_KIT&quot;>&#xa;                        &lt;tns1:COD_KIT>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_KIT&quot;/>&#xa;                        &lt;/tns1:COD_KIT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                        &lt;tns1:TIPO_BANDA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                        &lt;/tns1:TIPO_BANDA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                        &lt;tns1:TIPO_COS>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                        &lt;/tns1:TIPO_COS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_AREA_RACCOLTA_DESC&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA_DESC>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_AREA_RACCOLTA_DESC&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA_DESC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:MACRO_AREA&quot;>&#xa;                        &lt;tns1:MACRO_AREA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:MACRO_AREA&quot;/>&#xa;                        &lt;/tns1:MACRO_AREA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:PROFILO&quot;>&#xa;                        &lt;tns1:PROFILO>&#xa;                            &lt;xsl:value-of select=&quot;tns1:PROFILO&quot;/>&#xa;                        &lt;/tns1:PROFILO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP2&quot;>&#xa;                        &lt;tns1:BP2>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP2&quot;/>&#xa;                        &lt;/tns1:BP2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP2_MAX&quot;>&#xa;                        &lt;tns1:BP2_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP2_MAX&quot;/>&#xa;                        &lt;/tns1:BP2_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP3&quot;>&#xa;                        &lt;tns1:BP3>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP3&quot;/>&#xa;                        &lt;/tns1:BP3>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP3_MAX&quot;>&#xa;                        &lt;tns1:BP3_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP3_MAX&quot;/>&#xa;                        &lt;/tns1:BP3_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP5&quot;>&#xa;                        &lt;tns1:BP5>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP5&quot;/>&#xa;                        &lt;/tns1:BP5>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP5_MAX&quot;>&#xa;                        &lt;tns1:BP5_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP5_MAX&quot;/>&#xa;                        &lt;/tns1:BP5_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP6&quot;>&#xa;                        &lt;tns1:BP6>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP6&quot;/>&#xa;                        &lt;/tns1:BP6>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP6_MAX&quot;>&#xa;                        &lt;tns1:BP6_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP6_MAX&quot;/>&#xa;                        &lt;/tns1:BP6_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BMCLIGHT&quot;>&#xa;                        &lt;tns1:BMCLIGHT>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BMCLIGHT&quot;/>&#xa;                        &lt;/tns1:BMCLIGHT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;tns1:DATI_OLD&quot;/>&#xa;                &lt;/tns1:Dati>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;count($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO) > 0&quot;>&#xa;                &lt;tns1:CodCausDestnrio>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeTipoTrasf>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeTipoTrasf>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeDisFlow>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeDisFlow>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeServizio>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeServizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:CodCausDestnrio>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:DTUEnrichmentResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapResponse-input" name="MapResponse"
                    outputVariable="MapResponse"
                    tibex:xpdlId="6aba4e29-d293-479a-a2f2-b2027c11485e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileNumOccursToMapResponse"/>
                        <bpws:target linkName="LOG_FirstStepToMapResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapResponseToLogOutput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectNomeOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelCampoServizioIT&quot;/>&#xa;    &lt;xsl:param name=&quot;selDatiOffertaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;SelFlagContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateDatiOut&quot;/>&#xa;    &lt;xsl:param name=&quot;SelPrfTcnLinea&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectScenario&quot;/>&#xa;    &lt;xsl:param name=&quot;Proc_TrascodCodCausDest&quot;/>&#xa;    &lt;xsl:param name=&quot;SelDescrPag&quot;/>&#xa;    &lt;xsl:param name=&quot;SelPrfTcnLinea_OLD&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_SottoLavrzDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;MapResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DTUEnrichmentResponse>&#xa;            &lt;xsl:if test=&quot;count($SelectNomeOLO/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelectNomeOLO/Record[1]/NOME_OLO&quot;>&#xa;                    &lt;tns1:NomeOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNomeOLO/Record[1]/NOME_OLO&quot;/>&#xa;                    &lt;/tns1:NomeOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelCampoServizioIT/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelCampoServizioIT/Record[1]/CAMPO_SERVIZIO_IT&quot;>&#xa;                    &lt;tns1:CampoServizioIT>&#xa;                        &lt;xsl:value-of select=&quot;$SelCampoServizioIT/Record[1]/CAMPO_SERVIZIO_IT&quot;/>&#xa;                    &lt;/tns1:CampoServizioIT>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/NOME_OFFERTA_DTU&quot;>&#xa;                    &lt;tns1:OffertaDTU>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/NOME_OFFERTA_DTU&quot;/>&#xa;                    &lt;/tns1:OffertaDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/FAMIG_OFFERTA&quot;>&#xa;                    &lt;tns1:FamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/FAMIG_OFFERTA&quot;/>&#xa;                    &lt;/tns1:FamigliaOfferta>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($selDatiOffertaDTU/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$selDatiOffertaDTU/Record[1]/SOTTO_FAMIG_OFFERTA&quot;>&#xa;                    &lt;tns1:SottoFamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;$selDatiOffertaDTU/Record[1]/SOTTO_FAMIG_OFFERTA&quot;/>&#xa;                    &lt;/tns1:SottoFamigliaOfferta>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelFlagContratto/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelFlagContratto/Record[1]/FLAG_ANFIBIO&quot;>&#xa;                    &lt;tns1:FlagAnfibio>&#xa;                        &lt;xsl:value-of select=&quot;$SelFlagContratto/Record[1]/FLAG_ANFIBIO&quot;/>&#xa;                    &lt;/tns1:FlagAnfibio>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($SelectScenario/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelectScenario/Record[1]/SCENARIO_DTU&quot;>&#xa;                    &lt;tns1:ScenarioDTU>&#xa;                        &lt;xsl:value-of select=&quot;$SelectScenario/Record[1]/SCENARIO_DTU&quot;/>&#xa;                    &lt;/tns1:ScenarioDTU>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Select_SottoLavrzDTU/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Select_SottoLavrzDTU/Record[1]/TIPOLG_SOTTO_LAVRZ_DTU&quot;>&#xa;                        &lt;tns1:SottoLavorazioneDTU>&#xa;                            &lt;xsl:value-of select=&quot;$Select_SottoLavrzDTU/Record[1]/TIPOLG_SOTTO_LAVRZ_DTU&quot;/>&#xa;                        &lt;/tns1:SottoLavorazioneDTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$enrichIn.input/tns1:SottoLavorazione&quot;>&#xa;                        &lt;tns1:SottoLavorazioneDTU>&#xa;                            &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:SottoLavorazione&quot;/>&#xa;                        &lt;/tns1:SottoLavorazioneDTU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($SelDescrPag/Record) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelDescrPag/Record[1]/DESCR_PAGAMENTO&quot;>&#xa;                    &lt;tns1:DescrPagamento>&#xa;                        &lt;xsl:value-of select=&quot;$SelDescrPag/Record[1]/DESCR_PAGAMENTO&quot;/>&#xa;                    &lt;/tns1:DescrPagamento>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelPrfTcnLinea/Record) > 0&quot;>&#xa;                    &lt;tns1:ProfiloTcncLinea>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/PROFILO_TCNC_LINEA&quot;>&#xa;                            &lt;tns1:PROFILO_TCNC_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/PROFILO_TCNC_LINEA&quot;/>&#xa;                            &lt;/tns1:PROFILO_TCNC_LINEA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/TIPO_MODULAZIONE&quot;>&#xa;                            &lt;tns1:TIPO_MODULAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/TIPO_MODULAZIONE&quot;/>&#xa;                            &lt;/tns1:TIPO_MODULAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/MODELLO_ACCS&quot;>&#xa;                            &lt;tns1:MODELLO_ACCS>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/MODELLO_ACCS&quot;/>&#xa;                            &lt;/tns1:MODELLO_ACCS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:PROFILO_COMMERCIALE_DOWN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                        &lt;/tns1:PROFILO_COMMERCIALE_DOWN>&#xa;                        &lt;tns1:PROFILO_COMMERCIALE_UP>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                        &lt;/tns1:PROFILO_COMMERCIALE_UP>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_DOWN_MAX>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MAX>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_DOWN_MIN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MIN>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_UP_MIN>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_UP_MIN)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_UP_MIN>&#xa;                        &lt;tns1:VELOCITA_AGGANCIO_UP_MAX>&#xa;                            &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea/Record[1]/VELOCITA_AGGANCIO_UP_MAX)&quot;/>&#xa;                        &lt;/tns1:VELOCITA_AGGANCIO_UP_MAX>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/COD_MODEM&quot;>&#xa;                            &lt;tns1:COD_MODEM>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/COD_MODEM&quot;/>&#xa;                            &lt;/tns1:COD_MODEM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelPrfTcnLinea/Record[1]/PROTOCOLLO&quot;>&#xa;                            &lt;tns1:PROTOCOLLO>&#xa;                                &lt;xsl:value-of select=&quot;$SelPrfTcnLinea/Record[1]/PROTOCOLLO&quot;/>&#xa;                            &lt;/tns1:PROTOCOLLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:ProfiloTcncLinea>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($SelPrfTcnLinea_OLD/Record) > 0&quot;>&#xa;                &lt;tns1:ProfiloTecnicoLineaOLD>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/PROFILO_TCNC_LINEA&quot;>&#xa;                        &lt;tns1:PROFILO_TCNC_LINEA_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/PROFILO_TCNC_LINEA&quot;/>&#xa;                        &lt;/tns1:PROFILO_TCNC_LINEA_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/TIPO_MODULAZIONE&quot;>&#xa;                        &lt;tns1:TIPO_MODULAZIONE_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/TIPO_MODULAZIONE&quot;/>&#xa;                        &lt;/tns1:TIPO_MODULAZIONE_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelPrfTcnLinea_OLD/Record[1]/MODELLO_ACCS&quot;>&#xa;                        &lt;tns1:MODELLO_ACCS_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$SelPrfTcnLinea_OLD/Record[1]/MODELLO_ACCS&quot;/>&#xa;                        &lt;/tns1:MODELLO_ACCS_OLD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:PROFILO_COMMERCIALE_DOWN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                    &lt;/tns1:PROFILO_COMMERCIALE_DOWN_OLD>&#xa;                    &lt;tns1:PROFILO_COMMERCIALE_UP_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                    &lt;/tns1:PROFILO_COMMERCIALE_UP_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_DOWN_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MAX_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_DOWN_MIN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_DOWN_MIN_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_UP_MIN_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_UP_MIN)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_UP_MIN_OLD>&#xa;                    &lt;tns1:VELOCITA_AGGANCIO_UP_MAX_OLD>&#xa;                        &lt;xsl:value-of select=&quot;string($SelPrfTcnLinea_OLD/Record[1]/VELOCITA_AGGANCIO_UP_MAX)&quot;/>&#xa;                    &lt;/tns1:VELOCITA_AGGANCIO_UP_MAX_OLD>&#xa;                &lt;/tns1:ProfiloTecnicoLineaOLD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateDatiOut/tns1:DatiOut&quot;>&#xa;                &lt;tns1:Dati>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_KIT&quot;>&#xa;                        &lt;tns1:COD_KIT>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_KIT&quot;/>&#xa;                        &lt;/tns1:COD_KIT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                        &lt;tns1:TIPO_BANDA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                        &lt;/tns1:TIPO_BANDA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                        &lt;tns1:TIPO_COS>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                        &lt;/tns1:TIPO_COS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:COD_AREA_RACCOLTA_DESC&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA_DESC>&#xa;                            &lt;xsl:value-of select=&quot;tns1:COD_AREA_RACCOLTA_DESC&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA_DESC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:MACRO_AREA&quot;>&#xa;                        &lt;tns1:MACRO_AREA>&#xa;                            &lt;xsl:value-of select=&quot;tns1:MACRO_AREA&quot;/>&#xa;                        &lt;/tns1:MACRO_AREA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:PROFILO&quot;>&#xa;                        &lt;tns1:PROFILO>&#xa;                            &lt;xsl:value-of select=&quot;tns1:PROFILO&quot;/>&#xa;                        &lt;/tns1:PROFILO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP2&quot;>&#xa;                        &lt;tns1:BP2>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP2&quot;/>&#xa;                        &lt;/tns1:BP2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP2_MAX&quot;>&#xa;                        &lt;tns1:BP2_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP2_MAX&quot;/>&#xa;                        &lt;/tns1:BP2_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP3&quot;>&#xa;                        &lt;tns1:BP3>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP3&quot;/>&#xa;                        &lt;/tns1:BP3>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP3_MAX&quot;>&#xa;                        &lt;tns1:BP3_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP3_MAX&quot;/>&#xa;                        &lt;/tns1:BP3_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP5&quot;>&#xa;                        &lt;tns1:BP5>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP5&quot;/>&#xa;                        &lt;/tns1:BP5>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP5_MAX&quot;>&#xa;                        &lt;tns1:BP5_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP5_MAX&quot;/>&#xa;                        &lt;/tns1:BP5_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP6&quot;>&#xa;                        &lt;tns1:BP6>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP6&quot;/>&#xa;                        &lt;/tns1:BP6>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BP6_MAX&quot;>&#xa;                        &lt;tns1:BP6_MAX>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BP6_MAX&quot;/>&#xa;                        &lt;/tns1:BP6_MAX>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BMCLIGHT&quot;>&#xa;                        &lt;tns1:BMCLIGHT>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BMCLIGHT&quot;/>&#xa;                        &lt;/tns1:BMCLIGHT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;tns1:DATI_OLD&quot;/>&#xa;                &lt;/tns1:Dati>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;count($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO) > 0&quot;>&#xa;                &lt;tns1:CodCausDestnrio>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeTipoTrasf>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_TIPO_TRASF&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeTipoTrasf>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeDisFlow>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_DIS_FLOW&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeDisFlow>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO)&quot;>&#xa;                            &lt;tns1:CodeServizio>&#xa;                                &lt;xsl:value-of select=&quot;$Proc_TrascodCodCausDest/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[ATTR = &amp;quot;CODE_SERVIZIO&amp;quot;]/COD_CAUS_DESTNRIO&quot;/>&#xa;                            &lt;/tns1:CodeServizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:CodCausDestnrio>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:DTUEnrichmentResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
