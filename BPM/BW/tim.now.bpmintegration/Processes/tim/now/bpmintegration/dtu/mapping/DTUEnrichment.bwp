            <bpws:scope name="WhileNumOccurs" tibex:group="while" tibex:xpdlId="8fe365fb-0cdd-41a0-888e-34561579206e">
                <bpws:targets>
                    <bpws:target linkName="AssignNumOccursToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileNumOccursToMapResponse"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable element="ns4:DatiOLD_Out" name="DatiOLD_Out"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit"
                        tibex:xpdlId="d2179fec-8b7e-4d2b-bf5c-789584a94d62" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+63d778ee-8191-4e2a-bc76-1f49cbef5041" version="2.0"> <xsl:template name="AccumulateDatiOut" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateDatiOut"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $numOccurs" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $numOccurs]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="InitDatiOLDToSelAnagVLAN"
                                    tibex:label="GBE-USERVLAN" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="InitDatiOLDToVLAN_bmd"
                                    tibex:label="" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="SelAnagVLANToVLAN_bmd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="VLAN_bmdToselectProfiloVLANbdm"
                                    tibex:label="ProfiloBMD" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Assign_DatiOLD_OutToMapDatiOut" tibex:linkType="SUCCESS"/>
                                <bpws:link name="VLAN_bmdToMapDatiOut"
                                    tibex:label="Otherwise" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="VLAN_bmdToSelectAnagKit_EasyIpBaseorSimmandDEDICATA"
                                    tibex:label="EasyIpBase or (Simm and DEDICATA)" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="VLAN_bmdToSelectDistr_EasyIpSpecial"
                                    tibex:label="EasyIpSpecial" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="SelectDistr_MacroAreaToMapDatiOut" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SelectAnagKit_CodAreaRaccToMapDatiOut" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapDatiOutToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToAccumulateDatiOut" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="selectProfiloVLANbdmToselectProfiloVLANbdm_OLD"
                                    tibex:label="Profilo_OLD" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="selectProfiloVLANbdmToMapDatiOut" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQueryToMapDatiOut" tibex:linkType="SUCCESS"/>
                                <bpws:link name="VLAN_SimmandCONDIVISA"
                                    tibex:label="Simm and CONDIVISA" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="selectProfiloVLANbdm_OLDToAssign_DatiOLD_Out" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToInitDatiOLD" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="b0a7a63d-7259-43c0-927c-00cd0744ac17">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInitDatiOLD"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateDatiOut"
                                    outputVariable="AccumulateDatiOut"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="63d778ee-8191-4e2a-bc76-1f49cbef5041" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToAccumulateDatiOut"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapDatiOut</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
