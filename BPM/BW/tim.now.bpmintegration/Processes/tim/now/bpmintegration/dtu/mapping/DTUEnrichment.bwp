&amp;quot; - SelFlagContratto: &amp;quot;, $SelFlagContratto/Record[1]/FLAG_ANFIBIO, &amp;quot; - SelPrfTcncLinea: &amp;quot;, tib:concat-sequence-format($SelPrfTcnLinea/Record[1], &amp;quot;|&amp;quot;, true()), &amp;quot; - SelDescrPagamento: &amp;quot;, $SelDescrPag/Record[1]/DESCR_PAGAMENTO, &amp;quot; .&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
