            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (count($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati) > 0)&#xd;&#xa;then count($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati)&#xd;&#xa;else 0"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="numOccurs" name="AssignNumOccurs"
