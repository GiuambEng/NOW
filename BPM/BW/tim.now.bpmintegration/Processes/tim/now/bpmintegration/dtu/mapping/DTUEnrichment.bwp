                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+567f6064-cb0a-41a5-aac9-5114840b3bfc+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;enrichIn&quot;/>&lt;xsl:template name=&quot;selectProfiloVLANbdm_OLD-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC) and string-length($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD_OLD) > 0&quot;>&lt;ID_PROFILO_BMD>&lt;xsl:value-of select=&quot;xsd:int($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD_OLD)&quot;/>&lt;/ID_PROFILO_BMD>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN) and string-length($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD_OLD) > 0&quot;>&lt;ID_PROFILO_BMD>&lt;xsl:value-of select=&quot;xsd:int($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD_OLD)&quot;/>&lt;/ID_PROFILO_BMD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_PROFILO_BMD xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'BITSTREAMNGAFTTCAB' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'BITSTREAMNGAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'SEMIBITSTREAMNGAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'FULLGPONPLUSNGA'&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'VULAFTTCAB' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'VULAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'SEMIVULAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'FULLGPONPLUS'&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'VULA'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta, 'GBE')&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'GBE'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TPLG_VLAN xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;OFFERTA>&lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta&quot;/>&lt;/OFFERTA>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
