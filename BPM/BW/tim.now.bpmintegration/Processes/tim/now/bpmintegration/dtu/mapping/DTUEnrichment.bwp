                    <bpws:sources>
                        <bpws:source linkName="AssignNumOccursToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (count($enrichIn.input/ns4:Dati) > 0)&#xd;&#xa;then count($enrichIn.input/ns4:Dati)&#xd;&#xa;else 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
