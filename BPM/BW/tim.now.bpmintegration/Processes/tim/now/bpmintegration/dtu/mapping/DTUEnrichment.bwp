                                <tibex:activityExtension
                                    inputVariable="DatiOLD_Out"
                                    name="InitDatiOLD"
                                    outputVariable="DatiOLD_Out"
                                    tibex:xpdlId="14155fe6-f9c8-49b3-9148-cb605c5f10e4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInitDatiOLD"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InitDatiOLDToVLAN_bmd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="InitDatiOLDToSelAnagVLAN">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)&#xd;&#xa;]/ns4:GBEVC) or exists($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)&#xd;&#xa;]/ns4:USERVLAN)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($enrichIn.input/ns4:Dati[number($index)
]/ns4:GBEVC) or exists($enrichIn.input/ns4:Dati[number($index)
]/ns4:USERVLAN)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
