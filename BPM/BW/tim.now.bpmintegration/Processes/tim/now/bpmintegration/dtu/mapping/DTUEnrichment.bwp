                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d43f110-c22a-411f-9daf-96533ddb6b81+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Select_SottoLavrzDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;SottoLavorazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:SottoLavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:SottoLavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SottoLavorazione>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPOLG_SOTTO_LAVRZ_DTU&#xa;FROM TIPOLG_SOTTO_LAVRZ&#xa;WHERE DESCR = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SottoLavorazione"/>
                                    <columnMetadata
                                    columnName="TIPOLG_SOTTO_LAVRZ_DTU"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b19bca87-ac08-4f00-92cf-c893ce3b6a4a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelDescrPagamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;nomeOffertaEsterna>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta&quot;/>&#xa;            &lt;/nomeOffertaEsterna>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelDescrPag-input" name="SelDescrPag"
                    outputVariable="SelDescrPag"
                    tibex:xpdlId="b19bca87-ac08-4f00-92cf-c893ce3b6a4a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_FirstStepToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelDescrPagamentoToSelCampoServizioIT"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b19bca87-ac08-4f00-92cf-c893ce3b6a4a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelDescrPagamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;nomeOffertaEsterna>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/nomeOffertaEsterna>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.IDTPLG_PAGAMENTO_ACCS, PAG.DESCR_PAGAMENTO&#xa;FROM TRASCODFC_OFFERTA TR, OFFERTA O, TIPOLG_PAGAMENTO_ACCS PAG&#xa;WHERE O.ID_OFFERTA = TR.ID_OFFERTA&#xa;    AND O.IDTPLG_PAGAMENTO_ACCS = PAG.IDTPLG_PAGAMENTO_ACCS&#xa;&#x9;&#x9;AND TR.NOME_OFFERTA_ESTERNA = ?&#xa;&#x9;&#x9;AND TR.PROVENIENZA = 'BPM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="nomeOffertaEsterna"/>
                                    <columnMetadata
                                    columnName="IDTPLG_PAGAMENTO_ACCS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_PAGAMENTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c1015b35-063c-432b-8efa-f1431c885b5c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelPrfTcnLinea_OLD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;            &lt;PROFILO_TCNC_LINEA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:ProfiloTecnicoLinea_OLD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:ProfiloTecnicoLinea_OLD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/PROFILO_TCNC_LINEA>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelPrfTcnLinea_OLD-input"
                    name="SelPrfTcnLinea_OLD"
                    outputVariable="SelPrfTcnLinea_OLD"
