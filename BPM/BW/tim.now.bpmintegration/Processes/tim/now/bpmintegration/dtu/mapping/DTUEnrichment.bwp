                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME AS NOME_OLO&#xa;FROM OLO &#xa;WHERE COD_OLO = ? AND CODFC_OLO_AGCOM = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
