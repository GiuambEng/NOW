                                    name="selectProfiloVLANbdm_OLD"
                                    outputVariable="selectProfiloVLANbdm_OLD"
                                    tibex:xpdlId="567f6064-cb0a-41a5-aac9-5114840b3bfc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="selectProfiloVLANbdmToselectProfiloVLANbdm_OLD"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="selectProfiloVLANbdm_OLDToAssign_DatiOLD_Out"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+567f6064-cb0a-41a5-aac9-5114840b3bfc+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;selectProfiloVLANbdm_OLD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC) and string-length($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD_OLD) > 0&quot;>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD_OLD)&quot;/>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN) and string-length($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD_OLD) > 0&quot;>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD_OLD)&quot;/>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_PROFILO_BMD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$enrichIn.input/tns1:Offerta = 'BITSTREAMNGAFTTCAB' or $enrichIn.input/tns1:Offerta = 'BITSTREAMNGAFTTH' or $enrichIn.input/tns1:Offerta = 'SEMIBITSTREAMNGAFTTH' or $enrichIn.input/tns1:Offerta = 'FULLGPONPLUSNGA'&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$enrichIn.input/tns1:Offerta = 'VULAFTTCAB' or $enrichIn.input/tns1:Offerta = 'VULAFTTH' or $enrichIn.input/tns1:Offerta = 'SEMIVULAFTTH' or $enrichIn.input/tns1:Offerta = 'FULLGPONPLUS'&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'VULA'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($enrichIn.input/tns1:Offerta, 'GBE')&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'GBE'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TPLG_VLAN xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PVB.PROFILO, PVB.BP2, PVB.BP2_MAX, PVB.BP3, PVB.BP3_MAX, PVB.BP5, PVB.BP5_MAX, PVB.BP6, PVB.BP6_MAX&#xa;  FROM PROFILO_VLAN_BMD PVB, TIPOLG_VLAN TV&#xa;  WHERE PVB.ID_PROFILO_BMD = ? AND PVB.IDTPLG_VLAN = TV.IDTPLG_VLAN &#xa;    AND TV.DESCR = ? AND PVB.ID_SOTTOFAMIG_OFFERTA = (&#xa;      SELECT O.ID_SOTTOFAMIG_OFFERTA &#xa;      FROM OFFERTA O, TRASCODFC_OFFERTA TR&#xa;      WHERE O.ID_OFFERTA = TR.ID_OFFERTA&#xa;          AND TR.NOME_OFFERTA_ESTERNA = ?&#xa;          AND TR.PROVENIENZA = 'BPM')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_PROFILO_BMD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TPLG_VLAN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="BP2"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP2_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f3691882-6ed1-4906-9c3a-6c119e6fe64e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;enrichIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelAnagVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;CodVP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:ATMVC/tns1:CODICEVP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:ATMVC/tns1:CODICEVP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodVP>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelAnagVP-input"
                                    name="SelAnagVP"
                                    outputVariable="SelAnagVP"
                                    tibex:xpdlId="f3691882-6ed1-4906-9c3a-6c119e6fe64e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VLAN_SimmandCONDIVISA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapDatiOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f3691882-6ed1-4906-9c3a-6c119e6fe64e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;SelAnagVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;CodVP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:Dati[number($index)]/tns1:ATMVC/tns1:CODICEVP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:Dati[number($index)]/tns1:ATMVC/tns1:CODICEVP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodVP>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_AREA_RACCOLTA, DESC_AREA_RACCOLTA FROM ANAG_VP WHERE COD_VP = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
