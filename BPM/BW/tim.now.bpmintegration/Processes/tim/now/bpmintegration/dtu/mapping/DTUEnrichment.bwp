                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DatiOLD_Out" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
