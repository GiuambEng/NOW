                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+62b1bca1-afa9-4675-94f9-c3f16c67ccc3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;enrichIn&quot;/>&lt;xsl:template name=&quot;selectProfiloVLANbdm-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC) and string-length($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD) > 0&quot;>&lt;ID_PROFILO_BMD>&lt;xsl:value-of select=&quot;xsd:int($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD)&quot;/>&lt;/ID_PROFILO_BMD>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN) and string-length($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD) > 0&quot;>&lt;ID_PROFILO_BMD>&lt;xsl:value-of select=&quot;xsd:int($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD)&quot;/>&lt;/ID_PROFILO_BMD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_PROFILO_BMD xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'BITSTREAMNGAFTTCAB' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'BITSTREAMNGAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'SEMIBITSTREAMNGAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'FULLGPONPLUSNGA'&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'VULAFTTCAB' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'VULAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'SEMIVULAFTTH' or $enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta = 'FULLGPONPLUS'&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'VULA'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta, 'GBE')&quot;>&lt;TPLG_VLAN>&lt;xsl:value-of select=&quot;'GBE'&quot;/>&lt;/TPLG_VLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TPLG_VLAN xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;OFFERTA>&lt;xsl:value-of select=&quot;$enrichIn/input/tns1:DTUEnrichmentRequest/tns1:Offerta&quot;/>&lt;/OFFERTA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="selectProfiloVLANbdm-input"
                                    name="selectProfiloVLANbdm"
                                    outputVariable="selectProfiloVLANbdm"
                                    tibex:xpdlId="62b1bca1-afa9-4675-94f9-c3f16c67ccc3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VLAN_bmdToselectProfiloVLANbdm"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="selectProfiloVLANbdmToselectProfiloVLANbdm_OLD">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:GBEVC/ns4:PROFILOBMD_OLD) > 0 or string-length($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD_OLD) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($enrichIn.input/ns4:Dati[number($index)]/ns4:GBEVC/ns4:PROFILOBMD_OLD) > 0 or string-length($enrichIn.input/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD_OLD) > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="selectProfiloVLANbdmToMapDatiOut">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+62b1bca1-afa9-4675-94f9-c3f16c67ccc3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;enrichIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;selectProfiloVLANbdm-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC) and string-length($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD) > 0&quot;>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($enrichIn.input/tns1:Dati[number($index)]/tns1:GBEVC/tns1:PROFILOBMD)&quot;/>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN) and string-length($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD) > 0&quot;>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($enrichIn.input/tns1:Dati[number($index)]/tns1:USERVLAN/tns1:PROFILOBMD)&quot;/>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_PROFILO_BMD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$enrichIn.input/tns1:Offerta = 'BITSTREAMNGAFTTCAB' or $enrichIn.input/tns1:Offerta = 'BITSTREAMNGAFTTH' or $enrichIn.input/tns1:Offerta = 'SEMIBITSTREAMNGAFTTH' or $enrichIn.input/tns1:Offerta = 'FULLGPONPLUSNGA'&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$enrichIn.input/tns1:Offerta = 'VULAFTTCAB' or $enrichIn.input/tns1:Offerta = 'VULAFTTH' or $enrichIn.input/tns1:Offerta = 'SEMIVULAFTTH' or $enrichIn.input/tns1:Offerta = 'FULLGPONPLUS'&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'VULA'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($enrichIn.input/tns1:Offerta, 'GBE')&quot;>&#xa;                    &lt;TPLG_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;'GBE'&quot;/>&#xa;                    &lt;/TPLG_VLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TPLG_VLAN xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$enrichIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PVB.PROFILO, PVB.BP2, PVB.BP2_MAX, PVB.BP3, PVB.BP3_MAX, PVB.BP5, PVB.BP5_MAX, PVB.BP6, PVB.BP6_MAX&#xa;  FROM PROFILO_VLAN_BMD PVB, TIPOLG_VLAN TV&#xa;  WHERE PVB.ID_PROFILO_BMD = ? AND PVB.IDTPLG_VLAN = TV.IDTPLG_VLAN &#xa;    AND TV.DESCR = ? AND PVB.ID_SOTTOFAMIG_OFFERTA = (&#xa;      SELECT O.ID_SOTTOFAMIG_OFFERTA &#xa;      FROM OFFERTA O, TRASCODFC_OFFERTA TR&#xa;      WHERE O.ID_OFFERTA = TR.ID_OFFERTA&#xa;          AND TR.NOME_OFFERTA_ESTERNA = ?&#xa;          AND TR.PROVENIENZA = 'BPM')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_PROFILO_BMD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TPLG_VLAN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="BP2"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP2_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="VLAN_bmd" tibex:xpdlId="9403d2ea-e52f-4845-97f2-338668191b3a">
                                <bpws:targets>
                                    <bpws:target linkName="SelAnagVLANToVLAN_bmd"/>
                                    <bpws:target linkName="InitDatiOLDToVLAN_bmd"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="VLAN_bmdToselectProfiloVLANbdm">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:GBEVC/ns4:PROFILOBMD) > 0 or (string-length($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD) > 0 and $enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD!='ATTRIBUTO IN ELIMINAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($enrichIn.input/ns4:Dati[number($index)]/ns4:GBEVC/ns4:PROFILOBMD) > 0 or (string-length($enrichIn.input/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD) > 0 and $enrichIn.input/ns4:Dati[number($index)]/ns4:USERVLAN/ns4:PROFILOBMD!='ATTRIBUTO IN ELIMINAZIONE')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VLAN_bmdToMapDatiOut">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VLAN_bmdToSelectAnagKit_EasyIpBaseorSimmandDEDICATA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="starts-with($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Offerta, &quot;EASYIPBASEPLUS&quot;) or (starts-with($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Offerta, &quot;BITSTREAMATMSIMMETRICO&quot;) and upper-case($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:ATMVC/ns4:TIPOBANDACONSEGNA) = 'DEDICATA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[starts-with($enrichIn.input/ns4:Offerta, "EASYIPBASEPLUS") or (starts-with($enrichIn.input/ns4:Offerta, "BITSTREAMATMSIMMETRICO") and upper-case($enrichIn.input/ns4:Dati[number($index)]/ns4:ATMVC/ns4:TIPOBANDACONSEGNA) = 'DEDICATA')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VLAN_bmdToSelectDistr_EasyIpSpecial">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Offerta = &quot;EASYIPSPECIALPROFILEFLAT&quot; or $enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Offerta = &quot;EASYIPSPECIALPROFILELITE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$enrichIn.input/ns4:Offerta = "EASYIPSPECIALPROFILEFLAT" or $enrichIn.input/ns4:Offerta = "EASYIPSPECIALPROFILELITE"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VLAN_SimmandCONDIVISA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="starts-with($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Offerta, &quot;BITSTREAMATMSIMMETRICO&quot;) and upper-case($enrichIn/input/ns4:DTUEnrichmentRequest/ns4:Dati[number($index)]/ns4:ATMVC/ns4:TIPOBANDACONSEGNA) = &quot;CONDIVISA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[starts-with($enrichIn.input/ns4:Offerta, "BITSTREAMATMSIMMETRICO") and upper-case($enrichIn.input/ns4:Dati[number($index)]/ns4:ATMVC/ns4:TIPOBANDACONSEGNA) = "CONDIVISA"]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="MapDatiOut-input"
                                    name="MapDatiOut"
                                    outputVariable="MapDatiOut"
                                    tibex:xpdlId="db88b8dc-6406-4502-8d4b-89ff9be96f8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectAnagKit_CodAreaRaccToMapDatiOut"/>
                                    <bpws:target linkName="Assign_DatiOLD_OutToMapDatiOut"/>
                                    <bpws:target linkName="SelectDistr_MacroAreaToMapDatiOut"/>
                                    <bpws:target linkName="VLAN_bmdToMapDatiOut"/>
                                    <bpws:target linkName="selectProfiloVLANbdmToMapDatiOut"/>
                                    <bpws:target linkName="JDBCQueryToMapDatiOut"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapDatiOutToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectDistr_MacroArea&quot;/>&#xa;    &lt;xsl:param name=&quot;selectProfiloVLANbdm&quot;/>&#xa;    &lt;xsl:param name=&quot;SelAnagVLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAnagKit_CodAreaRacc&quot;/>&#xa;    &lt;xsl:param name=&quot;SelAnagVP&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiOLD_Out&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDatiOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiOut>&#xa;            &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/COD_KIT&quot;>&#xa;                &lt;tns1:COD_KIT>&#xa;                    &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/COD_KIT&quot;/>&#xa;                &lt;/tns1:COD_KIT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/TIPO_BANDA&quot;>&#xa;                &lt;tns1:TIPO_BANDA>&#xa;                    &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/TIPO_BANDA&quot;/>&#xa;                &lt;/tns1:TIPO_BANDA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/TIPO_COS&quot;>&#xa;                &lt;tns1:TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/TIPO_COS&quot;/>&#xa;                &lt;/tns1:TIPO_COS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectAnagKit_CodAreaRacc/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectAnagKit_CodAreaRacc/Record[1]/COD_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA>&#xa;                            &lt;xsl:value-of select=&quot;$SelectAnagKit_CodAreaRacc/Record[1]/COD_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($SelAnagVLAN/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/COD_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/COD_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($SelAnagVP/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelAnagVP/Record[1]/COD_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagVP/Record[1]/COD_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectAnagKit_CodAreaRacc/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectAnagKit_CodAreaRacc/Record[1]/DESC_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA_DESC>&#xa;                            &lt;xsl:value-of select=&quot;$SelectAnagKit_CodAreaRacc/Record[1]/DESC_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA_DESC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($SelAnagVLAN/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelAnagVLAN/Record[1]/DESC_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA_DESC>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagVLAN/Record[1]/DESC_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA_DESC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($SelAnagVP/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelAnagVP/Record[1]/DESC_AREA_RACCOLTA&quot;>&#xa;                        &lt;tns1:COD_AREA_RACCOLTA_DESC>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagVP/Record[1]/DESC_AREA_RACCOLTA&quot;/>&#xa;                        &lt;/tns1:COD_AREA_RACCOLTA_DESC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SelectDistr_MacroArea/Record[1]/MACRO_AREA&quot;>&#xa;                &lt;tns1:MACRO_AREA>&#xa;                    &lt;xsl:value-of select=&quot;$SelectDistr_MacroArea/Record[1]/MACRO_AREA&quot;/>&#xa;                &lt;/tns1:MACRO_AREA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($selectProfiloVLANbdm/Record) > 0&quot;>&#xa;                    &lt;tns1:PROFILO>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm/Record[1]/PROFILO)&quot;/>&#xa;                    &lt;/tns1:PROFILO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($selectProfiloVLANbdm/Record) > 0&quot;>&#xa;                    &lt;tns1:BP2>&#xa;                        &lt;xsl:value-of select=&quot;string($selectProfiloVLANbdm/Record[1]/BP2)&quot;/>&#xa;                    &lt;/tns1:BP2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($selectProfiloVLANbdm/Record) >