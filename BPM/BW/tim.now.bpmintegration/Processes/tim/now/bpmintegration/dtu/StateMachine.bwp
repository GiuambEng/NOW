                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($ValidateDTUEvent.parameters/ns6:Evento = "NF_CONFERMA_ANNULLAMENTO" and $ValidateDTUEvent.parameters/ns6:CausaleEsito = "025" and ($ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow = "SOSPESO" or $ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow = "ACCODATO" or $ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow = "SOSPESOOPERESPECIALI" or $ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow = "SOSPESOATTESAPERMESSI" or
$ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow = "INACCETTAZIONEPREVENTIVO")) or ($ValidateDTUEvent.parameters/ns6:Evento = "NI_RIMODULAZIONE_DAC" and $ValidateDTUEvent.parameters/ns6:CausaleEsito = "NS86" and $ValidateDTUEvent.parameters/ns6:CodiceEsito = "019")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLoggerToSelAnagCau">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='INANNULLAMENTOSUDELIVERYD82' or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='INANNULLAMENTOACSUDELIVERYD82' or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='INANNULLAMENTOTIMEOUTSUDELIVERYD82') and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:CausaleEsito = &quot;025&quot; and ($ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaPrecNow='SOSPESOD82' or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaPrecNow='SOSPESOACD82')) or ($ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Evento = &quot;NI_PRESA_APPUNTAMENTO&quot; and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:CausaleEsito = (&quot;V1&quot;,&quot;V2&quot;,&quot;V3&quot;,&quot;V6&quot;,&quot;V7&quot;,&quot;V8&quot;,&quot;V9&quot;,&quot;V10&quot;,&quot;V11&quot;,&quot;V12&quot;,&quot;V14&quot;) and ($ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='SOSPESOD82' or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='SOSPESOACD82') and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Scenario=&quot;MIGDEL82&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(($ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='INANNULLAMENTOSUDELIVERYD82' or $ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='INANNULLAMENTOACSUDELIVERYD82' or $ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='INANNULLAMENTOTIMEOUTSUDELIVERYD82') and $ValidateDTUEvent.parameters/ns6:Evento = "NF_CONFERMA_ANNULLAMENTO" and $ValidateDTUEvent.parameters/ns6:CausaleEsito = "025" and ($ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow='SOSPESOD82' or $ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow='SOSPESOACD82')) or ($ValidateDTUEvent.parameters/ns6:Evento = "NI_PRESA_APPUNTAMENTO" and $ValidateDTUEvent.parameters/ns6:CausaleEsito = ("V1","V2","V3","V6","V7","V8","V9","V10","V11","V12","V14") and ($ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='SOSPESOD82' or $ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='SOSPESOACD82') and $ValidateDTUEvent.parameters/ns6:Scenario="MIGDEL82")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLoggerToSelectTracc">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaPrecNow='CODICESESSIONEKOD82' and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaNow='INANNULLAMENTOSUDELIVERYD82' and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Scenario='MIGDEL82'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ValidateDTUEvent.parameters/ns6:StatoRichiestaPrecNow='CODICESESSIONEKOD82' and $ValidateDTUEvent.parameters/ns6:StatoRichiestaNow='INANNULLAMENTOSUDELIVERYD82' and $ValidateDTUEvent.parameters/ns6:Scenario='MIGDEL82']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoRichiestaOF&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Output RichiestaOF: &amp;quot;, tib:render-xml($StatoRichiestaOF))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
