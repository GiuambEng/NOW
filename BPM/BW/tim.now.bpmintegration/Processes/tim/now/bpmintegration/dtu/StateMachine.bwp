                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Notifiche&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelAnagCaus&quot;/>&lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&lt;xsl:param name=&quot;QueryFLAGDELIBERA103&quot;/>&lt;xsl:param name=&quot;QueryOsccuramentoAgesp&quot;/>&lt;xsl:param name=&quot;queryAttribDettOrd&quot;/>&lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&lt;xsl:param name=&quot;SelectTracc&quot;/>&lt;xsl:template name=&quot;Notifiche&quot; match=&quot;/&quot;>&lt;sm:Notifiche>&lt;xsl:copy-of select=&quot;$Notifiche/sm:Notifica&quot;/>&lt;sm:Notifica>&lt;xsl:choose>&lt;xsl:when test=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CausaleEsito = 'MDL'&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&lt;sm:CODICE_CAUSALE_NOW>&lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&lt;/sm:CODICE_CAUSALE_NOW>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CausaleEsito = 'MDL'&quot;/>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectTracc/Record)>0&quot;>&lt;sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;xsd:int($SelectTracc/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/sm:ID_ANAGRAFICA_CAUSALE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/sm:ID_ANAGRAFICA_CAUSALE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CodiceEsito = &amp;quot;032&amp;quot; and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CausaleEsito = (&amp;quot;N72&amp;quot;,&amp;quot;C31&amp;quot;)) and ($QueryOsccuramentoAgesp/Record[COD_AGESP = &amp;quot;R1I-23-0015&amp;quot;]/FLAG_OSCURMENTO = &amp;quot;1&amp;quot; or not(exists($queryAttribDettOrd/Record[NOMEATTRIBUTO = &amp;quot;DATAAPPUNTAMENTO&amp;quot;]/VALOREATTRIBUTO)) or tib:compare-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $queryAttribDettOrd/Record[NOMEATTRIBUTO = &amp;quot;DATAAPPUNTAMENTO&amp;quot;]/VALOREATTRIBUTO), current-date()) = 1) and contains($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Offerta, 'FTTH')&quot;/>&lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT = 'TC11'&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT&quot;>&lt;sm:ID_NOTIFICA_RECIPIENT>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/sm:ID_NOTIFICA_RECIPIENT>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING = 'TC11'&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING&quot;>&lt;sm:ID_NOTIFICA_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/sm:ID_NOTIFICA_DONATING>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR = 'TC11'&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR&quot;>&lt;sm:ID_NOTIFICA_DONOR>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/sm:ID_NOTIFICA_DONOR>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DONATING&quot;>&lt;sm:COMPONENTE_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DONATING&quot;/>&lt;/sm:COMPONENTE_DONATING>&lt;/xsl:if>&lt;/sm:Notifica>&lt;xsl:if test=&quot;exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING) > 0&quot;>&lt;sm:Notifica>&lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&lt;sm:CODICE_CAUSALE_NOW>&lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&lt;/sm:CODICE_CAUSALE_NOW>&lt;/xsl:if>&lt;sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING&quot;>&lt;sm:ID_NOTIFICA_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&lt;/sm:ID_NOTIFICA_DONATING>&lt;/xsl:if>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DPP_DONATING&quot;>&lt;sm:COMPONENTE_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DPP_DONATING&quot;/>&lt;/sm:COMPONENTE_DONATING>&lt;/xsl:if>&lt;/sm:Notifica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS) > 0 and exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS)>0&quot;>&lt;sm:Notifica>&lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&lt;sm:CODICE_CAUSALE_NOW>&lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&lt;/sm:CODICE_CAUSALE_NOW>&lt;/xsl:if>&lt;sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS&quot;>&lt;sm:ID_NOTIFICA_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS&quot;/>&lt;/sm:ID_NOTIFICA_DONATING>&lt;/xsl:if>&lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS&quot;>&lt;sm:COMPONENTE_DONATING>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS&quot;/>&lt;/sm:COMPONENTE_DONATING>&lt;/xsl:if>&lt;/sm:Notifica>&lt;/xsl:if>&lt;/sm:Notifiche>&lt;/xsl:template>&lt;/xsl:stylesheet>"
