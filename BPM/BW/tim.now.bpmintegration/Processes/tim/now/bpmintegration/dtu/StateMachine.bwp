of select=&quot;&amp;quot;T&amp;quot;&quot;/>&#xa;                        &lt;/sm:FonteAnnullamento>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;sm:FonteAnnullamento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                        &lt;/sm:FonteAnnullamento>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;            &lt;sm:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:Lavorazione&quot;/>&#xa;            &lt;/sm:Lavorazione>&#xa;            &lt;sm:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:Offerta&quot;/>&#xa;            &lt;/sm:Offerta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ValidateDTUEvent.parameters/sm:GestioneAutonoma='N'&quot;/>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ValidateDTUEvent.parameters/sm:GestioneAutonoma&quot;>&#xa;                        &lt;sm:GestioneAutonoma>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:GestioneAutonoma&quot;/>&#xa;                        &lt;/sm:GestioneAutonoma>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;sm:StatoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:StatoRichiestaNow&quot;/>&#xa;            &lt;/sm:StatoRichiestaNOW>&#xa;        &lt;/sm:AssociativaCausaliDTURequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
