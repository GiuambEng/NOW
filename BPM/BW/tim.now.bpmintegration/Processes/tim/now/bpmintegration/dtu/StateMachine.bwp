                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperOutputToLOG_Output"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_OutputToValidateDTUEventOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperOutput&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Output-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Esito ammissibilita evento DTU: &amp;quot;, tib:render-xml($MapperOutput, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_MacchinaStati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Numero di record estratti dalla macchina a stati: &amp;quot;, string(count($OutputMacchinaStati/sm:QueryMacchinaStatiResponse)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LOG_MacchinaStati-input"
                                    name="LOG_MacchinaStati"
                                    tibex:xpdlId="388f1964-af9f-44de-81e2-704b686aac95"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MSOutputToLOG_MacchinaStati"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_Name">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="false() and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Evento = &quot;NF_CONFERMA_ANNULLAMENTO&quot; and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:CausaleEsito = &quot;025&quot; and ($ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaOlo = &quot;ACQUISITO&quot; or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaOlo = &quot;INDELIVERY&quot; or $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:StatoRichiestaOlo = &quot;INVIATOADELIVERY&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[false() and $ValidateDTUEvent.parameters/ns6:Evento = "NF_CONFERMA_ANNULLAMENTO" and $ValidateDTUEvent.parameters/ns6:CausaleEsito = "025" and ($ValidateDTUEvent.parameters/ns6:StatoRichiestaOlo = "ACQUISITO" or $ValidateDTUEvent.parameters/ns6:StatoRichiestaOlo = "INDELIVERY" or $ValidateDTUEvent.parameters/ns6:StatoRichiestaOlo = "INVIATOADELIVERY")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LOG_MacchinaStatiToJDBCQuery1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_MacchinaStati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Numero di record estratti dalla macchina a stati: &amp;quot;, string(count($OutputMacchinaStati/sm:QueryMacchinaStatiResponse)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:reply name="ReplyKO"
                                operation="ValidateDTUEvent"
                                partnerLink="StateMachinePortType"
                                portType="ns1:StateMachinePortType"
                                tibex:xpdlId="7570b582-8381-4b15-9bfc-1e9fb99af77f" variable="ReplyKO-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://www.tim.com/NOW/wsdl/abstract/StateMachine/" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" version="2.0"&gt;
    &lt;xsl:param name="SelAnagCaus"/&gt;
    &lt;xsl:param name="CallAssCausaliDTU"/&gt;
    &lt;xsl:param name="OutputMacchinaStati"/&gt;
    &lt;xsl:template name="ReplyKO-input" match="/"&gt;
        &lt;tns9:ValidateDTUEventResponse&gt;
            &lt;parameters&gt;
                &lt;sm:ValidateDTUEventResponse&gt;
                    &lt;sm:CausaleEsitoACK&gt;
                        &lt;xsl:value-of select="&amp;quot;003&amp;quot;"/&gt;
                    &lt;/sm:CausaleEsitoACK&gt;
                    &lt;sm:DescrizioneErrore&gt;
                        &lt;xsl:value-of select="&amp;quot;KO Evento Fuori sequenza&amp;quot;"/&gt;
                    &lt;/sm:DescrizioneErrore&gt;
                    &lt;sm:Notifica&gt;
                        &lt;xsl:if test="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_RECIPIENT"&gt;
                            &lt;sm:ID_NOTIFICA_RECIPIENT&gt;
                                &lt;xsl:value-of select="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_RECIPIENT"/&gt;
                            &lt;/sm:ID_NOTIFICA_RECIPIENT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_DONATING"&gt;
                            &lt;sm:ID_NOTIFICA_DONATING&gt;
                                &lt;xsl:value-of select="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_DONATING"/&gt;
                            &lt;/sm:ID_NOTIFICA_DONATING&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_DONOR"&gt;
                            &lt;sm:ID_NOTIFICA_DONOR&gt;
                                &lt;xsl:value-of select="$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[1]/sm:COD_TIPOLG_NOTF_DONOR"/&gt;
                            &lt;/sm:ID_NOTIFICA_DONOR&gt;
                        &lt;/xsl:if&gt;
                    &lt;/sm:Notifica&gt;
                    &lt;sm:Error&gt;
                        &lt;sm:CodiceErrore&gt;
                            &lt;xsl:value-of select="&amp;quot;KO_ASSOCIATIVA&amp;quot;"/&gt;
