                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+819908a5-f26f-4ae7-8c8b-f592f94bdd75+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:template name=&quot;SelCausalePrecedente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;DESCR_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;'NI_SOSPENSIONE'&quot;/>&#xa;            &lt;/DESCR_EVENTO>&#xa;            &lt;DESCR_EVENTO_2>&#xa;                &lt;xsl:value-of select=&quot;'NI_ACCODAMENTO'&quot;/>&#xa;            &lt;/DESCR_EVENTO_2>&#xa;            &lt;DESCR_EVENTO_3>&#xa;                &lt;xsl:value-of select=&quot;'NI_FINE_TENTATIVO_CONTATTO'&quot;/>&#xa;            &lt;/DESCR_EVENTO_3>&#xa;            &lt;ID_RICH_OLO_2>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;            &lt;/ID_RICH_OLO_2>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelCausalePrecedente-input"
                                    name="SelCausalePrecedente"
                                    outputVariable="SelCausalePrecedente"
                                    tibex:xpdlId="819908a5-f26f-4ae7-8c8b-f592f94bdd75" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToSelCausalePrecedente_Name"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelCausalePrecedenteToWhile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+819908a5-f26f-4ae7-8c8b-f592f94bdd75+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelCausalePrecedente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;DESCR_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;'NI_SOSPENSIONE'&quot;/>&#xa;            &lt;/DESCR_EVENTO>&#xa;            &lt;DESCR_EVENTO_2>&#xa;                &lt;xsl:value-of select=&quot;'NI_ACCODAMENTO'&quot;/>&#xa;            &lt;/DESCR_EVENTO_2>&#xa;            &lt;DESCR_EVENTO_3>&#xa;                &lt;xsl:value-of select=&quot;'NI_FINE_TENTATIVO_CONTATTO'&quot;/>&#xa;            &lt;/DESCR_EVENTO_3>&#xa;            &lt;ID_RICH_OLO_2>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;            &lt;/ID_RICH_OLO_2>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_NOW_A IN &#xa;     ('SOSPESO',&#xa;      'ACCODATO',&#xa;      'SOSPESOOPERESPECIALI',&#xa;      'SOSPESOATTESAPERMESSI')&#xa;AND T.ID_EVENTO_ORDN_NOW_WHLS IS NULL&#xa;UNION ALL&#xa;SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;JOIN EVENTO_ORDN_NOW_WHLS EV ON EV.ID_RICH_OLO = TO_NCHAR(T.ID_RICH_OLO)&#xa;  AND EV.ID_EVENTO_ORDN_NOW_WHLS = T.ID_EVENTO_ORDN_NOW_WHLS&#xa;JOIN TIPOLG_EVENTO TE ON TE.IDTPLG_EVENTO = EV.IDTPLG_EVENTO&#xa;  AND (TE.DESCR_EVENTO = ? OR TE.DESCR_EVENTO = ? OR TE.DESCR_EVENTO = ?)&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_NOW_A IN &#xa;     ('SOSPESO',&#xa;      'ACCODATO',&#xa;      'SOSPESOOPERESPECIALI',&#xa;      'SOSPESOATTESAPERMESSI')&#xa;ORDER BY 2 DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO_2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO_3"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_2"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_TRACC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:param name=&quot;SelCausalePrecedente&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Select della Causale Precedente | Numero di record estratti: &amp;quot;, string(count($SelCausalePrecedente/Record)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;count($SelCausalePrecedente/Record) > 0&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($SelCausalePrecedente/Record[1], true(), true())&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallLog-input"
                                    name="CallLog"
                                    tibex:xpdlId="f66c9210-60cd-4145-928c-423e760e8c5e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelCausalePrecedenteToWhile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToWhile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelCausalePrecedente&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Select della Causale Precedente | Numero di record estratti: &amp;quot;, string(count($SelCausalePrecedente/Record)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;count($SelCausalePrecedente/Record) > 0&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($SelCausalePrecedente/Record[1], true(), true())&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="5a939304-49d1-4e75-99a7-3eec37c7d857">
                                <bpws:targets>
                                    <bpws:target linkName="LogScenarioToEmpty"/>
                                    <bpws:target linkName="LOG_InputToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToJDBCQuery"/>
