lt;/sm:GestioneAutonoma>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;sm:StatoRichiestaNOW>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:StatoRichiestaNow&quot;/>&lt;/sm:StatoRichiestaNOW>&lt;/sm:AssociativaCausaliDTURequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
