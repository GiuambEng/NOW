                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6f529522-f556-42d2-a7c5-4e233ee1f7c1+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&lt;xsl:param name=&quot;SelScenario&quot;/>&lt;xsl:template name=&quot;MacchinaStati-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;StatoCorrente>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:StatoRichiestaNow&quot;/>&lt;/StatoCorrente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:StatoRichiestaPrecNow)>0&quot;>&lt;StatoPrecedente>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:StatoRichiestaPrecNow&quot;/>&lt;/StatoPrecedente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatoPrecedente xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;Servizio>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Offerta&quot;/>&lt;/Servizio>&lt;Lavorazione>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Lavorazione&quot;/>&lt;/Lavorazione>&lt;Evento>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento&quot;/>&lt;/Evento>&lt;CodiceEsito>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CodiceEsito&quot;/>&lt;/CodiceEsito>&lt;CausaleEsito>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CausaleEsito&quot;/>&lt;/CausaleEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelScenario/Record) > 0&quot;>&lt;IdScenario>&lt;xsl:value-of select=&quot;xsd:integer($SelScenario/Record[1]/ID_SCENARIO)&quot;/>&lt;/IdScenario>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IdScenario xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:FlagDisaggregazione) and string-length($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:FlagDisaggregazione)>0 and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento=('NI_DISPACCIATO_A_MOI_MOS','NI_ASSEGNAZIONE_SUPPORTO')&quot;>&lt;FlagDisaggregazione>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FlagDisaggregazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FlagDisaggregazione>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FlagDisaggregazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:GestioneAutonoma)>0&quot;>&lt;GestioneAutonoma>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:GestioneAutonoma)&quot;>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:GestioneAutonoma&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/GestioneAutonoma>&lt;/xsl:when>&lt;xsl:otherwise>&lt;GestioneAutonoma>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/GestioneAutonoma>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MacchinaStati-input"
                                    name="MacchinaStati"
                                    outputVariable="MacchinaStati"
                                    tibex:xpdlId="6f529522-f556-42d2-a7c5-4e233ee1f7c1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToMacchinaStati"/>
