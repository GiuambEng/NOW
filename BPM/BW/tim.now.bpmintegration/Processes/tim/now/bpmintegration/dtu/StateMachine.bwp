                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Notifiche&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelAnagCaus&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryFLAGDELIBERA103&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryOsccuramentoAgesp&quot;/>&#xa;    &lt;xsl:param name=&quot;queryAttribDettOrd&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTracc&quot;/>&#xa;    &lt;xsl:template name=&quot;Notifiche&quot; match=&quot;/&quot;>&#xa;        &lt;sm:Notifiche>&#xa;            &lt;xsl:copy-of select=&quot;$Notifiche/sm:Notifica&quot;/>&#xa;            &lt;sm:Notifica>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ValidateDTUEvent.parameters/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent.parameters/sm:CausaleEsito = 'MDL'&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&#xa;                            &lt;sm:CODICE_CAUSALE_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&#xa;                            &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ValidateDTUEvent.parameters/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent.parameters/sm:CausaleEsito = 'MDL'&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($SelectTracc/Record)>0&quot;>&#xa;                                &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectTracc/Record[1]/ID_ANAG_CAUS)&quot;/>&#xa;                                &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&#xa;                                &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($ValidateDTUEvent.parameters/sm:Evento = &amp;quot;NI_SOSPENSIONE&amp;quot; and $ValidateDTUEvent.parameters/sm:CodiceEsito = &amp;quot;032&amp;quot; and $ValidateDTUEvent.parameters/sm:CausaleEsito = (&amp;quot;N72&amp;quot;,&amp;quot;C31&amp;quot;)) and ($QueryOsccuramentoAgesp/Record[COD_AGESP = &amp;quot;R1I-23-0015&amp;quot;]/FLAG_OSCURMENTO = &amp;quot;1&amp;quot; or not(exists($queryAttribDettOrd/Record[NOMEATTRIBUTO = &amp;quot;DATAAPPUNTAMENTO&amp;quot;]/VALOREATTRIBUTO)) or tib:compare-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $queryAttribDettOrd/Record[NOMEATTRIBUTO = &amp;quot;DATAAPPUNTAMENTO&amp;quot;]/VALOREATTRIBUTO), current-date()) = 1) and contains($ValidateDTUEvent.parameters/sm:Offerta, 'FTTH')&quot;/>&#xa;                    &lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT = 'TC11'&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT&quot;>&#xa;                            &lt;sm:ID_NOTIFICA_RECIPIENT>&#xa;                                &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_RECIPIENT&quot;/>&#xa;                            &lt;/sm:ID_NOTIFICA_RECIPIENT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING = 'TC11'&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING&quot;>&#xa;                            &lt;sm:ID_NOTIFICA_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONATING&quot;/>&#xa;                            &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$QueryFLAGDELIBERA103/Record[1]/FLAGDELIBERA103= 'Y' and $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR = 'TC11'&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR&quot;>&#xa;                            &lt;sm:ID_NOTIFICA_DONOR>&#xa;                                &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DONOR&quot;/>&#xa;                            &lt;/sm:ID_NOTIFICA_DONOR>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DONATING&quot;>&#xa;                    &lt;sm:COMPONENTE_DONATING>&#xa;                        &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DONATING&quot;/>&#xa;                    &lt;/sm:COMPONENTE_DONATING>&#xa;                &lt;/xsl:if>&#xa;            &lt;/sm:Notifica>&#xa;            &lt;xsl:if test=&quot;exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING) > 0&quot;>&#xa;                &lt;sm:Notifica>&#xa;                    &lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&#xa;                        &lt;sm:CODICE_CAUSALE_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&#xa;                        &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&#xa;                    &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DPP_DONATING&quot;>&#xa;                        &lt;sm:COMPONENTE_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMPONENTE_DPP_DONATING&quot;/>&#xa;                        &lt;/sm:COMPONENTE_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:Notifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS) > 0 and exists($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS) and string-length($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS)>0&quot;>&#xa;                &lt;sm:Notifica>&#xa;                    &lt;xsl:if test=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;>&#xa;                        &lt;sm:CODICE_CAUSALE_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$SelAnagCaus/Record[1]/COD_CAUS_INTERNO&quot;/>&#xa;                        &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelAnagCaus/Record[1]/ID_ANAG_CAUS)&quot;/>&#xa;                    &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_TIPO_NOTF_DONOR_CPS&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS&quot;>&#xa;                        &lt;sm:COMPONENTE_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COMP_DONATING_CPS&quot;/>&#xa;                        &lt;/sm:COMPONENTE_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:Notifica>&#xa;            &lt;/xsl:if>&#xa;        &lt;/sm:Notifiche>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
