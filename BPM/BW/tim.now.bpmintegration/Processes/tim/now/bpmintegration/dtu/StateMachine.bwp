                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+53011347-92b5-4489-90e5-79f3dd0a443e+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT attrd.NOMEATTRIBUTO, attrd.VALOREATTRIBUTO&#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA rich &#xa;JOIN APPUSER.BDS_1_CASEDATA_ORDINE ordine ON rich.IDRICHIESTAOLO = ordine.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE dett ON ordine.IDRICHIESTAOLO = dett.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN attrd ON dett.IDRICHIESTAOLO = attrd.IDRICHIESTAOLO&#xa;WHERE rich.IDRICHIESTAOLO = ? AND dett.BDS_ID = attrd.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID AND dett.NOMECOMPONENTE = 'DTUAPPUNTAMENTO' AND attrd.NOMEATTRIBUTO = 'DATAAPPUNTAMENTO'&#xa;ORDER BY dett.NOMECOMPONENTE, dett.BDS_ID, attrd.NOMEATTRIBUTO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:while>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Notifiche&quot;/>&#xa;    &lt;xsl:param name=&quot;CallTrascCodCausale&quot;/>&#xa;    &lt;xsl:template name=&quot;Notifiche&quot; match=&quot;/&quot;>&#xa;        &lt;sm:Notifiche>&#xa;            &lt;sm:Notifica>&#xa;                &lt;xsl:if test=&quot;$Notifiche/sm:Notifica[1]/sm:CODICE_CAUSALE_NOW&quot;>&#xa;                    &lt;sm:CODICE_CAUSALE_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$Notifiche/sm:Notifica[1]/sm:CODICE_CAUSALE_NOW&quot;/>&#xa;                    &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;xsl:value-of select=&quot;$CallTrascCodCausale/parameters/ecm:TrascodificaCodiceCausaleResponse/ecm:IdAnagraficaCausale&quot;/>&#xa;                &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:if test=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_RECIPIENT&quot;>&#xa;                    &lt;sm:ID_NOTIFICA_RECIPIENT>&#xa;                        &lt;xsl:value-of select=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_RECIPIENT&quot;/>&#xa;                    &lt;/sm:ID_NOTIFICA_RECIPIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_DONATING&quot;>&#xa;                    &lt;sm:ID_NOTIFICA_DONATING>&#xa;                        &lt;xsl:value-of select=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_DONATING&quot;/>&#xa;                    &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_DONOR&quot;>&#xa;                    &lt;sm:ID_NOTIFICA_DONOR>&#xa;                        &lt;xsl:value-of select=&quot;$Notifiche/sm:Notifica[1]/sm:ID_NOTIFICA_DONOR&quot;/>&#xa;                    &lt;/sm:ID_NOTIFICA_DONOR>&#xa;                &lt;/xsl:if>&#xa;            &lt;/sm:Notifica>&#xa;        &lt;/sm:Notifiche>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
