                                    tibex:xpdlId="53011347-92b5-4489-90e5-79f3dd0a443e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogCausaleToJDBCQuery1"/>
