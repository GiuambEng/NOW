                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_OPENFIBER_A IN &#xa;     ('ACQUISITOKO',&#xa;      'ACCETTATOKO',&#xa;      'ANNULLATOOF',&#xa;      'ESPLETATOKO')&#xa;AND T.ID_EVENTO_ORDN_NOW_WHLS IS NULL&#xa;UNION ALL&#xa;SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;JOIN EVENTO_ORDN_NOW_WHLS EV ON EV.ID_RICH_OLO = TO_NCHAR(T.ID_RICH_OLO)&#xa;  AND EV.ID_EVENTO_ORDN_NOW_WHLS = T.ID_EVENTO_ORDN_NOW_WHLS&#xa;JOIN TIPOLG_EVENTO TE ON TE.IDTPLG_EVENTO = EV.IDTPLG_EVENTO&#xa;  AND (TE.DESCR_EVENTO = 'OF_CompletionOrder_OpenStream' OR TE.DESCR_EVENTO = 'OF_StatusUpdate' OR TE.DESCR_EVENTO = 'WHS_OrderCompletionMig' OR TE.DESCR_EVENTO = 'WHS_StatusUpdateMig')&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_OPENFIBER_A IN &#xa;     ('ACQUISITOKO',&#xa;      'ACCETTATOKO',&#xa;      'ANNULLATOOF',&#xa;      'ESPLETATOKO')&#xa;ORDER BY 2 DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

