                                    <bpws:sources>
                                    <bpws:source linkName="MacchinaStatiDisaggToMSOutput">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($MacchinaStati/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($MacchinaStati/Record) > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="MacchinaStatiDisaggToLogKOFuoriSeq">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6f529522-f556-42d2-a7c5-4e233ee1f7c1+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelScenario&quot;/>&#xa;    &lt;xsl:template name=&quot;MacchinaStati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;StatoCorrente>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:StatoRichiestaNow&quot;/>&#xa;            &lt;/StatoCorrente>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ValidateDTUEvent.parameters/sm:StatoRichiestaPrecNow)>0&quot;>&#xa;                    &lt;StatoPrecedente>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:StatoRichiestaPrecNow&quot;/>&#xa;                    &lt;/StatoPrecedente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoPrecedente xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;Servizio>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:Offerta&quot;/>&#xa;            &lt;/Servizio>&#xa;            &lt;Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:Lavorazione&quot;/>&#xa;            &lt;/Lavorazione>&#xa;            &lt;Evento>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:Evento&quot;/>&#xa;            &lt;/Evento>&#xa;            &lt;CodiceEsito>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:CodiceEsito&quot;/>&#xa;            &lt;/CodiceEsito>&#xa;            &lt;CausaleEsito>&#xa;                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:CausaleEsito&quot;/>&#xa;            &lt;/CausaleEsito>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelScenario/Record) > 0&quot;>&#xa;                    &lt;IdScenario>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($SelScenario/Record[1]/ID_SCENARIO)&quot;/>&#xa;                    &lt;/IdScenario>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IdScenario xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ValidateDTUEvent.parameters/sm:FlagDisaggregazione) and string-length($ValidateDTUEvent.parameters/sm:FlagDisaggregazione)>0 and $ValidateDTUEvent.parameters/sm:Evento=('NI_DISPACCIATO_A_MOI_MOS','NI_ASSEGNAZIONE_SUPPORTO')&quot;>&#xa;                    &lt;FlagDisaggregazione>&#xa;                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                    &lt;/FlagDisaggregazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FlagDisaggregazione>&#xa;                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                    &lt;/FlagDisaggregazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ValidateDTUEvent.parameters/sm:GestioneAutonoma)>0&quot;>&#xa;                    &lt;GestioneAutonoma>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ValidateDTUEvent.parameters/sm:GestioneAutonoma)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:GestioneAutonoma&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/GestioneAutonoma>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;GestioneAutonoma>&#xa;                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                    &lt;/GestioneAutonoma>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT MS.COD_TIPOLG_NOTF_RECIPIENT, MS.COD_TIPOLG_NOTF_DONATING, MS.COD_TIPOLG_NOTF_DONOR, MS.COD_TIPOLG_NOTF_DPP_DONATING,&#xa;        ST1.STATO_RICH_NOW, TE.IDTPLG_ESITO_DTU, AD.COD_MACCHINA_A_STATI_DTU, MS.COMPONENTE_DONATING, MS.COMPONENTE_DPP_DONATING,&#xa;        TE.FLAG_ALTRO_OPERATORE, MS.COMP_DONATING_CPS, MS.COD_TIPO_NOTF_DONOR_CPS&#xa;  FROM MACCHINA_STATI_DTU MS, TIPOLG_ESITO_DTU TE, AMBITO_DTU AD, TIPOLG_LAVRZ TL, TRASCODFC_OFFERTA TRO, TIPOLG_RICH_COMSTNOW ST1&#xa;  WHERE MS.IDRICH_COM_STRC_SUCCV = ST1.IDRICH_COM_STRC&#xa;    AND MS.IDRICH_COM_STRC_CORRNT = (SELECT ST2.IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTNOW ST2 WHERE ST2.STATO_RICH_NOW = ?)&#xa;    AND (MS.IDRICH_COM_STRC_PRECED = (SELECT ST3.IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTNOW ST3 WHERE ST3.STATO_RICH_NOW = ?)&#xa;            OR MS.IDRICH_COM_STRC_PRECED IS NULL)       &#xa;    AND TRO.NOME_OFFERTA_ESTERNA = ?  AND TRO.PROVENIENZA = 'BPM' AND TRO.ID_OFFERTA = AD.ID_OFFERTA&#xa;    AND TL.TIPOLG_LAVRZ = ? AND TL.IDTPLG_LAVRZ = AD.IDTPLG_LAVRZ&#xa;    AND AD.COD_MACCHINA_A_STATI_DTU = MS.COD_MACCHINA_STATI_DTU AND TE.EVENTO_NATIVO_DTU = ?&#xa;    AND TE.ESITO = ? AND TE.CAUS_ESITO = ? AND TE.IDTPLG_EVENTO = MS.IDTPLG_EVENTO&#xa;    AND (AD.ID_SCENARIO = ? OR AD.ID_SCENARIO IS NULL)&#xa;    AND MS.FLAG_DISAGGREGAZIONE=?&#xa;&#x9;AND NVL(MS.GESTIONEAUTONOMA, 'N') like ?&#xa;    ORDER BY MS.IDTPLG_EVENTO ASC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StatoCorrente"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StatoPrecedente"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Evento"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceEsito"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CausaleEsito"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdScenario"/>

                                    <PreparedParameters
                                    DataType="1"
                                    DataTypeDisplayValue="CHAR" ParameterName="FlagDisaggregazione"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="GestioneAutonoma"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="COD_TIPOLG_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="COD_TIPOLG_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="COD_TIPOLG_NOTF_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="STATO_RICH_NOW"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="IDTPLG_ESITO_DTU"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="COD_MACCHINA_A_STATI_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="8"
                                    columnName="COMPONENTE_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="9"
                                    columnName="COMPONENTE_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="10"
                                    columnName="FLAG_ALTRO_OPERATORE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="11"
                                    columnName="COMP_DONATING_CPS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="12"
                                    columnName="COD_TIPO_NOTF_DONOR_CPS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="OutputMacchinaStati"
                                    name="MSOutput"
                                    outputVariable="OutputMacchinaStati"
                                    tibex:xpdlId="00d97b4d-ece1-4283-8ea6-9ec36d1d1502" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MacchinaStatiDisaggToMSOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MSOutputToLOG_MacchinaStati">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MacchinaStati&quot;/>&lt;xsl:template name=&quot;OutputMacchinaStati&quot; match=&quot;/&quot;>&lt;sm:QueryMacchinaStati_Response>&lt;xsl:for-each select=&quot;$MacchinaStati/Record&quot;>&lt;sm:QueryMacchinaStatiResponse>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_RECIPIENT&quot;>&lt;sm:COD_TIPOLG_NOTF_RECIPIENT>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/sm:COD_TIPOLG_NOTF_RECIPIENT>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_DONATING&quot;>&lt;sm:COD_TIPOLG_NOTF_DONATING>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/sm:COD_TIPOLG_NOTF_DONATING>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_DONOR&quot;>&lt;sm:COD_TIPOLG_NOTF_DONOR>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/sm:COD_TIPOLG_NOTF_DONOR>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_DPP_DONATING&quot;>&lt;sm:COD_TIPOLG_NOTF_DPP_DONATING>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&lt;/sm:COD_TIPOLG_NOTF_DPP_DONATING>&lt;/xsl:if>&lt;sm:STATO_RICH_NOW>&lt;xsl:value-of select=&quot;STATO_RICH_NOW&quot;/>&lt;/sm:STATO_RICH_NOW>&lt;sm:IDTPLG_ESITO_DTU>&lt;xsl:value-of select=&quot;xsd:int(IDTPLG_ESITO_DTU)&quot;/>&lt;/sm:IDTPLG_ESITO_DTU>&lt;sm:COD_MACCHINA_A_STATI_DTU>&lt;xsl:value-of select=&quot;COD_MACCHINA_A_STATI_DTU&quot;/>&lt;/sm:COD_MACCHINA_A_STATI_DTU>&lt;xsl:if test=&quot;COMPONENTE_DONATING&quot;>&lt;sm:COMPONENTE_DONATING>&lt;xsl:value-of select=&quot;COMPONENTE_DONATING&quot;/>&lt;/sm:COMPONENTE_DONATING>&lt;/xsl:if>&lt;xsl:if test=&quot;COMPONENTE_DPP_DONATING&quot;>&lt;sm:COMPONENTE_DPP_DONATING>&lt;xsl:value-of select=&quot;COMPONENTE_DPP_DONATING&quot;/>&lt;/sm:COMPONENTE_DPP_DONATING>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAG_ALTRO_OPERATORE&quot;>&lt;sm:FLAG_ALTRO_OPERATORE>&lt;xsl:value-of select=&quot;FLAG_ALTRO_OPERATORE&quot;/>&lt;/sm:FLAG_ALTRO_OPERATORE>&lt;/xsl:if>&lt;xsl:if test=&quot;COMP_DONATING_CPS&quot;>&lt;sm:COMP_DONATING_CPS>&lt;xsl:value-of select=&quot;COMP_DONATING_CPS&quot;/>&lt;/sm:COMP_DONATING_CPS>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPO_NOTF_DONOR_CPS&quot;>&lt;sm:COD_TIPO_NOTF_DONOR_CPS>&lt;xsl:value-of select=&quot;COD_TIPO_NOTF_DONOR_CPS&quot;/>&lt;/sm:COD_TIPO_NOTF_DONOR_CPS>&lt;/xsl:if>&lt;/sm:QueryMacchinaStatiResponse>&lt;/xsl:for-each>&lt;/sm:QueryMacchinaStati_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
