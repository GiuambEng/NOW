                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutMS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Recupero Causale dall'associativa per il record &amp;quot;, string($index), &amp;quot; della macchina a stati&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)], true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogOutMS-input"
                                    name="LogOutMS"
                                    tibex:xpdlId="291965e6-57e3-48c1-8a02-0fb8004cb176"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLogOutMS"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogOutMSToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutMS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Recupero Causale dall'associativa per il record &amp;quot;, string($index), &amp;quot; della macchina a stati&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)], true(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+30bfebd6-ac56-40f8-bfb7-d7a3108b7533+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:param name=&quot;CallAssCausaliDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;SelAnagCaus-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:FlagOpereSpeciali) and $ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:FlagOpereSpeciali = 'S'&quot;>&#xa;                    &lt;ID_ANAG_CAUS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausaleOpereSpeciali)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausaleOpereSpeciali&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ANAG_CAUS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelAnagCaus-input"
                                    name="SelAnagCaus"
                                    outputVariable="SelAnagCaus"
                                    tibex:xpdlId="30bfebd6-ac56-40f8-bfb7-d7a3108b7533" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogCausaleToSelAnagCaus"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelAnagCausToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+30bfebd6-ac56-40f8-bfb7-d7a3108b7533+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CallAssCausaliDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;SelAnagCaus-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ValidateDTUEvent.parameters/sm:FlagOpereSpeciali) and $ValidateDTUEvent.parameters/sm:FlagOpereSpeciali = 'S'&quot;>&#xa;                    &lt;ID_ANAG_CAUS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausaleOpereSpeciali)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausaleOpereSpeciali&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ANAG_CAUS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CallAssCausaliDTU/sm:RecordAssociativa[1]/sm:IdAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAG_CAUS, COD_CAUS_INTERNO&#xa;FROM ANAG_CAUS&#xa;WHERE ID_ANAG_CAUS = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ANAG_CAUS"/>

                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="COD_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&#xa;    &lt;xsl:param name=&quot;SelAnagCaus&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCausale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Select della Descrizione dalla tabella ANAG_CAUS | Numero di record estratti: &amp;quot;, string(count($SelAnagCaus/Record)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;count($SelAnagCaus/Record) > 0&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($SelAnagCaus, false(), false())&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogCausale-input"
                                    name="LogCausale"
                                    tibex:xpdlId="c110f4ef-2a1f-4943-bae4-74e7278a6eda"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelAnagCausToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCausaleToJDBCQuery">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Lavorazione = 'ATTIVAZIONE' and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Offerta= 'NP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ValidateDTUEvent.parameters/ns6:Lavorazione = 'ATTIVAZIONE' and $ValidateDTUEvent.parameters/ns6:Offerta= 'NP']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogCausaleToAssignNotifiche">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogCausaleToJDBCQuery1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:Evento = &quot;NI_SOSPENSIONE&quot; and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:CodiceEsito= '032' and $ValidateDTUEvent/parameters/ns6:ValidateDTUEventRequest/ns6:CausaleEsito= ('N72', 'C31')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ValidateDTUEvent.parameters/ns6:Evento = "NI_SOSPENSIONE" and $ValidateDTUEvent.parameters/ns6:CodiceEsito= '032' and $ValidateDTUEvent.parameters/ns6:CausaleEsito= ('N72', 'C31')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateDTUEvent.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelAnagCaus&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCausale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachinePortType'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateDTUEvent'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateDTUEvent.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Select della Descrizione dalla tabella ANAG_CAUS | Numero di record estratti: &amp;quot;, string(count($SelAnagCaus/Record)))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;count($SelAnagCaus/Record) > 0&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($SelAnagCaus, false(), false())&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ValidateDTUEvent&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelCausalePrecedente&quot;/>&lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&lt;xsl:param name=&quot;SelCausalePrecedenteOF&quot;/>&lt;xsl:param name=&quot;SelAnagCau&quot;/>&lt;xsl:param name=&quot;SelectTracc&quot;/>&lt;xsl:template name=&quot;CallAssCausaliDTU-input&quot; match=&quot;/&quot;>&lt;sm:AssociativaCausaliDTURequest>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:IdRichiesta&quot;/>&lt;/sm:IdRichiesta>&lt;sm:Evento>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:Evento&quot;/>&lt;/sm:Evento>&lt;sm:CausaleEsito>&lt;xsl:value-of select=&quot;$ValidateDTUEvent/parameters/sm:ValidateDTUEventRequest/sm:CausaleEsito&quot;/>&lt;/sm:CausaleEsito>&lt;sm:CodiceMacchinaStatiDTU>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_MACCHINA_A_STATI_DTU&quot;/>&lt;/sm:CodiceMacchinaStatiDTU>&lt;sm:IdTipologiaEsitoDTU>&lt;xsl:value-of select=&quot;$OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:IDTPLG_ESITO_DTU&quot;/>&lt;/sm:IdTipologiaEsitoDTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelAnagCau/Record[1]/ID_ANAG_CAUS)&quot;>&lt;sm:IdAnagraficaCausalePrec>&lt;xsl:value-of select=&quot;xsd:int($SelAnagCau/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/sm:IdAnagraficaCausalePrec>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($SelCausalePrecedente/Record[1]/ID_ANAG_CAUS)&quot;>&lt;sm:IdAnagraficaCausalePrec>&lt;xsl:value-of select=&quot;xsd:int($SelCausalePrecedent