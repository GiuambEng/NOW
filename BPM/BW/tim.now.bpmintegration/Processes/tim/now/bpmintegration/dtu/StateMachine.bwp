                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputMacchinaStati&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Nessuna Causale trovata nella tabella Associativa per IdTipologiaEsitoDTU &amp;quot;, string($OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:IDTPLG_ESITO_DTU), &amp;quot; e Codice Macchina a Stati &amp;quot;, $OutputMacchinaStati/sm:QueryMacchinaStatiResponse[number($index)]/sm:COD_MACCHINA_A_STATI_DTU)&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO_ASSOCIATIVA&amp;quot;&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns9:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
