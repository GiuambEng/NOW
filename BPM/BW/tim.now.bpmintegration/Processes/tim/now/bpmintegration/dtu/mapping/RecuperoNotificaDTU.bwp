<bpws:process exitOnStandardFault="no"
    name="tim.now.bpmintegration.dtu.mapping.RecuperoNotificaDTU"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20180619161504"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tim.com/NOW/xsd/StateMachine/"
    xmlns:ns1="http://www.tibco.com/namespaces/tnt/plugins/jdbc+803bcd24-8afc-4eb9-83bc-1073bd5ed9b5+input"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jdbc+803bcd24-8afc-4eb9-83bc-1073bd5ed9b5+output"
    xmlns:ns3="http://www.tibco.com/namespaces/tnt/plugins/parsexml"
    xmlns:ns4="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"
    xmlns:ns5="http://www.tim.com/NOW/xsd/GenericLogger"
    xmlns:ns6="http://schemas.xmlsoap.org/soap/envelope/"
