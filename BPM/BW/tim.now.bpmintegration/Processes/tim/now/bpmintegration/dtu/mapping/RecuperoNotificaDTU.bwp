                        <bpws:target linkName="ParseEVENTOToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $ParseEnvelope/tns1:Body/*, element, ns:EVENTO_NOTIFICA -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseEnvelope&quot;/>&lt;xsl:param name=&quot;ParseEVENTO&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:StateMachineValidationRequest>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns:IdRichiesta>&lt;tns:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$Start/tns:IdEventoOrdnNowWhls&quot;/>&lt;/tns:IdEventoOrdnNowWhls>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseEVENTO)&quot;>&lt;xsl:copy-of select=&quot;$ParseEVENTO&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseEnvelope)&quot;>&lt;xsl:copy-of select=&quot;$ParseEnvelope/tns1:Body/ns:EVENTO_NOTIFICA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/tns:Offerta>&lt;tns:Lavorazione>&lt;xsl:value-of select=&quot;$Start/tns:Lavorazione&quot;/>&lt;/tns:Lavorazione>&lt;tns:StatoRichiestaNow>&lt;xsl:value-of select=&quot;$Start/tns:StatoRichiestaNow&quot;/>&lt;/tns:StatoRichiestaNow>&lt;tns:StatoRichiestaPrecNow>&lt;xsl:value-of select=&quot;$Start/tns:StatoRichiestaPrecNow&quot;/>&lt;/tns:StatoRichiestaPrecNow>&lt;tns:StatoRichiestaOlo>&lt;xsl:value-of select=&quot;$Start/tns:StatoRichiestaOlo&quot;/>&lt;/tns:StatoRichiestaOlo>&lt;tns:CodProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns:CodProcsoNoFile&quot;/>&lt;/tns:CodProcsoNoFile>&lt;tns:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns:IdEsecProcsoNoFile>&lt;xsl:if test=&quot;$Start/tns:Scenario&quot;>&lt;tns:Scenario>&lt;xsl:value-of select=&quot;$Start/tns:Scenario&quot;/>&lt;/tns:Scenario>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AnnullamentoAutomatico&quot;>&lt;tns:AnnullamentoAutomatico>&lt;xsl:value-of select=&quot;$Start/tns:AnnullamentoAutomatico&quot;/>&lt;/tns:AnnullamentoAutomatico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:DataSospensione&quot;>&lt;tns:DataSospensione>&lt;xsl:value-of select=&quot;$Start/tns:DataSospensione&quot;/>&lt;/tns:DataSospensione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:IDPreventivo&quot;>&lt;tns:IDPreventivo>&lt;xsl:value-of select=&quot;$Start/tns:IDPreventivo&quot;/>&lt;/tns:IDPreventivo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:FlagOpereSpeciali&quot;>&lt;tns:FlagOpereSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:FlagOpereSpeciali&quot;/>&lt;/tns:FlagOpereSpeciali>&lt;/xsl:if>&lt;/tns:StateMachineValidationRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
