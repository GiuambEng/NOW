                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;&lt;xsl:param name="Mapper_ACK"/&gt;&lt;xsl:param name="AckComunicazione"/&gt;&lt;xsl:template name="Invoke_RichiestaACK-input" match="/"&gt;&lt;tns1:Richiesta_ACK&gt;&lt;richiesta&gt;&lt;xsl:copy-of select="$Mapper_ACK"/&gt;&lt;/richiesta&gt;&lt;header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]'))&amp;#xD;&amp;#xA;"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]'))"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO"/&gt;&lt;/h:businessID&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="'-'"/&gt;&lt;/h:messageID&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$Mapper_ACK/ns:TRANSACTION_ID"/&gt;&lt;/h:transactionID&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns1:Richiesta_ACK&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper_ACK&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_RichiestaACK-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Mapper_ACK&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
