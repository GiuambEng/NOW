                                    name="ConfirmRequestToExit" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;AckComunicazione&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails4&quot;/>&#xa;    &lt;xsl:template name=&quot;ACK_Scarto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AckComunicazione'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;string-length($AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO) > 0&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails4/MsgCode&quot;/>&#xa;                &lt;/tns2:MsgCode>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails4/Msg&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.dtu&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AckComunicazione&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;string-length($AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO) > 0&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AckComunicazione_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;xsl:if test=&quot;string-length($AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO) > 0&quot;>&#xa;                            &lt;tns2:trackID>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;AckComunicazione_&amp;quot;, $AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO)&quot;/>&#xa;                            &lt;/tns2:trackID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO) > 0&quot;>&#xa;                                &lt;tns2:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore su AckComunicazione, id richiesta: &amp;quot;, $AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO)&quot;/>&#xa;                                &lt;/tns2:Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Errore su AckComunicazione&amp;quot;&quot;/>&#xa;                                &lt;/tns2:Descrizione>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;