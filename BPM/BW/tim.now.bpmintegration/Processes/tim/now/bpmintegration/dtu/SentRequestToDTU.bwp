ntType>&#xa;                        &lt;xsl:if test=&quot;string-length($AckComunicazione.parameters/tns:IdRichiestaOLO) > 0&quot;>&#xa;                            &lt;tns2:trackID>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;AckComunicazione_&amp;quot;, $AckComunicazione.parameters/tns:IdRichiestaOLO)&quot;/>&#xa;                            &lt;/tns2:trackID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($AckComunicazione.parameters/tns:IdRichiestaOLO) > 0&quot;>&#xa;                                &lt;tns2:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore su AckComunicazione, id richiesta: &amp;quot;, $AckComunicazione.parameters/tns:IdRichiestaOLO)&quot;/>&#xa;                                &lt;/tns2:Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Errore su AckComunicazione&amp;quot;&quot;/>&#xa;                                &lt;/tns2:Descrizione>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                        &lt;tns2:ErrorReport>&#xa;                            &lt;tns2:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/StackTrace&quot;/>&#xa;                            &lt;/tns2:StackTrace>&#xa;                            &lt;tns2:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/Msg&quot;/>&#xa;                            &lt;/tns2:Msg>&#xa;                            &lt;tns2:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/ProcessStack&quot;/>&#xa;                            &lt;/tns2:ProcessStack>&#xa;                            &lt;tns2:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                            &lt;/tns2:MsgCode>&#xa;                            &lt;tns2:Data/>&#xa;                        &lt;/tns2:ErrorReport>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
