                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AckComunicazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ACK_COMUNICAZIONE>&#xa;            &lt;xsl:copy-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:ACK/ancestor-or-self::*/namespace::node()&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:ACK/@*&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:ACK/node()&quot;/>&#xa;        &lt;/ns:ACK_COMUNICAZIONE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper_ACK-input"
                                    name="Mapper_ACK"
                                    outputVariable="Mapper_ACK"
                                    tibex:xpdlId="469caa29-4be7-4527-afe1-0a25faafc062" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
