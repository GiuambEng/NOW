    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="58f967fa-c9b1-4dfb-90f7-9d6aec82e650">
                <bpws:onMessage operation="SendDTU"
                    partnerLink="SendDTUPortType"
                    portType="ns1:SendDTUPortType"
                    tibex:xpdlId="a1b3d5bf-db76-413c-b15d-f04444f2a092" variable="SendDTU">
                    <bpws:scope name="scope2">
