                            <bpws:invoke
                                inputVariable="InsertStagingAck-input"
                                name="InsertStagingAck"
                                operation="InsertUpdateStaging"
                                outputVariable="InsertStagingAck"
                                partnerLink="StagingProcessManager"
                                portType="ns33:InsertUpdateStagingPortType" tibex:xpdlId="186b7d70-a3ac-4bbb-8fda-1fee85603479">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IdProcesso_DTU"/&gt;
    &lt;xsl:param name="statoStaging_OK"/&gt;
    &lt;xsl:param name="Select_Id_TipologiaEvento_Ack"/&gt;
    &lt;xsl:param name="Mapper_ACK"/&gt;
    &lt;xsl:param name="AckComunicazione"/&gt;
    &lt;xsl:template name="InsertStagingAck-input" match="/"&gt;
        &lt;tns4:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns3:StagingRequest&gt;
                    &lt;tns3:StagingOut&gt;
                        &lt;tns3:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($Mapper_ACK)"/&gt;
                        &lt;/tns3:CONTENUTO_REQUEST&gt;
                        &lt;tns3:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                        &lt;/tns3:ID_PROCSO_NO_FILE&gt;
                        &lt;tns3:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$statoStaging_OK"/&gt;
                        &lt;/tns3:ID_STATO_ELAB_STAG&gt;
                        &lt;tns3:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns3:TIMSTP_RICH&gt;
                        &lt;tns3:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$Mapper_ACK/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns3:TRANSACTION_ID&gt;
                        &lt;tns3:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$Mapper_ACK/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns3:ID_RICH_DTU&gt;
                        &lt;tns3:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO"/&gt;
                        &lt;/tns3:ID_RICH_OLO&gt;
                        &lt;tns3:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns3:OPERATORE&gt;
                        &lt;tns3:ID_TIPOLOGIA_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_Id_TipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns3:ID_TIPOLOGIA_EVENTO&gt;
                    &lt;/tns3:StagingOut&gt;
                    &lt;tns3:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO"/&gt;
                    &lt;/tns3:IdRichiestaOLO&gt;
                    &lt;tns3:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RICH_DTU'"/&gt;
                    &lt;/tns3:StagingType&gt;
                    &lt;tns3:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns3:LoggerIn&gt;
                &lt;/tns3:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns4:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AckComunicazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcesso_DTU&quot;/>&#xa;    &lt;xsl:param name=&quot;statoStaging_OK&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_Id_TipologiaEvento_Ack&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper_ACK&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagingAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:StagingRequest>&#xa;            &lt;tns3:StagingOut>&#xa;                &lt;tns3:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper_ACK)&quot;/>&#xa;                &lt;/tns3:CONTENUTO_REQUEST>&#xa;                &lt;tns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                &lt;/tns3:ID_PROCSO_NO_FILE>&#xa;                &lt;tns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$statoStaging_OK&quot;/>&#xa;                &lt;/tns3:ID_STATO_ELAB_STAG>&#xa;                &lt;tns3:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TIMSTP_RICH>&#xa;                &lt;tns3:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_ACK/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns3:TRANSACTION_ID>&#xa;                &lt;tns3:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_ACK/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns3:ID_RICH_DTU>&#xa;                &lt;tns3:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$AckComunicazione.parameters/tns:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns3:ID_RICH_OLO>&#xa;                &lt;tns3:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns3:OPERATORE>&#xa;                &lt;tns3:ID_TIPOLOGIA_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_Id_TipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns3:ID_TIPOLOGIA_EVENTO>&#xa;            &lt;/tns3:StagingOut>&#xa;            &lt;tns3:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$AckComunicazione.parameters/tns:IdRichiestaOLO&quot;/>&#xa;            &lt;/tns3:IdRichiestaOLO>&#xa;            &lt;tns3:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RICH_DTU'&quot;/>&#xa;            &lt;/tns3:StagingType>&#xa;            &lt;tns3:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns3:LoggerIn>&#xa;        &lt;/tns3:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="InvokeToInsertStagingAck"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InsertStagingAckToConfirmAck"/>
                                </bpws:sources>
                                <bpws:correlations/>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;AckComunicazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_OutputAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AckComunicazione'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Exit from SendDTUPortType/AckComunicazione service with result code: &amp;quot;, $AckComunicazione/parameters/tns:ACK_COMUNICAZIONE/tns:ACK/ns:CAUSALE_ESITO)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl: