                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUtoBPM_Mapping.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateEventOnStateMachine2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ASSEGNATOADIMPRESA&quot;/>&#xa;    &lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATICOLLAUDO&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_SOSPESOCONNOTIFICAFS&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOPZIONALI&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagDTUDATICOLLAUDO&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOAGGIUNTIVO&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C07_2024&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C09_2025&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C10_2025&quot;/>&#xa;    &lt;xsl:template name=&quot;MapResponse_OK-input&quot; match=&quot;/&quot;>&#xa;        &lt;sm:StateMachineValidation_Response>&#xa;            &lt;sm:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/sm:ID_RICHIESTA>&#xa;            &lt;sm:ESITO_VALIDAZIONE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;            &lt;/sm:ESITO_VALIDAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1 and $ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo='ASSEGNATOADIMPRESA'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'INDELIVERY'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_SOSPESOCONNOTIFICAFS) &amp;lt; 1 and $ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo='SOSPESOCONNOTIFICAFS'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'SOSPESO'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo&quot;>&#xa;                        &lt;sm:STATO_SUCCESSIVO>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo&quot;/>&#xa;                        &lt;/sm:STATO_SUCCESSIVO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2.parameters/sm:FlagAltroOperatore&quot;>&#xa;                &lt;sm:FLAG_ALTRO_OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2.parameters/sm:FlagAltroOperatore&quot;/>&#xa;                &lt;/sm:FLAG_ALTRO_OPERATORE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$ValidateEventOnStateMachine2.parameters/sm:Notifica&quot;>&#xa;                &lt;sm:NOTIFICA>&#xa;                    &lt;xsl:if test=&quot;sm:CODICE_CAUSALE_NOW&quot;>&#xa;                        &lt;sm:CODICE_CAUSALE_NOW>&#xa;                            &lt;xsl:value-of select=&quot;sm:CODICE_CAUSALE_NOW&quot;/>&#xa;                        &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;>&#xa;                        &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;/>&#xa;                        &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_RECIPIENT>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_RECIPIENT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONATING&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONATING&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONOR&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONOR>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONOR&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONOR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:COMPONENTE_DONATING&quot;>&#xa;                        &lt;sm:COMPONENTE_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:COMPONENTE_DONATING&quot;/>&#xa;                        &lt;/sm:COMPONENTE_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:NOTIFICA>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Invoke_DTUtoBPM_Mapping.output/Q1:ARRICCHIMENTI&quot;>&#xa;                &lt;xsl:if test=&quot;exists(Q1:Arricchimento/ns1:DettaglioOrdineElement)&quot;>&#xa;                    &lt;sm:ARRICCHIMENTI>&#xa;                        &lt;xsl:for-each select=&quot;Q1:Arricchimento&quot;>&#xa;                            &lt;xsl:for-each select=&quot;ns1:DettaglioOrdineElement[nomeComponente = 'DTUCONTATTO']&quot;>&#xa;                                &lt;ns1:DettaglioOrdineElement>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                        &lt;IDDettaglioOrdineParent>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                        &lt;IDDettaglioOrdineRoot>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineRoot>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:copy-of select=&quot;attributiDettaglioOrdine&quot;/>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                        &lt;IDRisorsaNOW>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                        &lt;/IDRisorsaNOW>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns1:DettaglioOrdineElement>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;ns1:DettaglioOrdineElement[nomeComponente = 'DTUDATIACCESSO']&quot;>&#xa;                                &lt;ns1:DettaglioOrdineElement>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                        &lt;IDDettaglioOrdineParent>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                        &lt;IDDettaglioOrdineRoot>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineRoot>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:for-each select=&quot;attributiDettaglioOrdine&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;nomeAttributo='RITIROPRODOTTI' and valoreAttributo='SI'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;nomeAttributo='RITIROPRODOTTI' and valoreAttributo='NO'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'C'&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                        &lt;IDRisorsaNOW>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                        &lt;/IDRisorsaNOW>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns1:DettaglioOrdineElement>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;ns1:DettaglioOrdineElement[nomeComponente = 'DTUDATIVC']&quot;>&#xa;                                &lt;ns1:DettaglioOrdineElement>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                        &lt;IDDettaglioOrdineParent>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                        &lt;IDDettaglioOrdineRoot>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                        &lt;/IDDettaglioOrdineRoot>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:copy-of select=&quot;attributiDettaglioOrdine&quot;/>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                    &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                        &lt;IDRisorsaNOW>&#xa;                                            &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                        &lt;/IDRisorsaNOW>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns1:DettaglioOrdineElement>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;ns1:DettaglioOrdineElement[nomeComponente = 'DTUDATICOLLAUDO']&quot;>&#xa;                                &lt;xsl:if test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_DTUDATICOLLAUDO) > -1 and $FlagDTUDATICOLLAUDO='True'&quot;>&#xa;                                    &lt;ns1:DettaglioOrdineElement>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                            &lt;IDDettaglioOrdineParent>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineParent>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                            &lt;IDDettaglioOrdineRoot>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineRoot>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                            &lt;IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                            &lt;/IDRisorsa>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;nomeComponente>&#xa;                                            &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                        &lt;/nomeComponente>&#xa;                                        &lt;integrationID>&#xa;                                            &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                        &lt;/integrationID>&#xa;                                        &lt;xsl:copy-of select=&quot;attributiDettaglioOrdine&quot;/>&#xa;                                        &lt;progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                        &lt;/progressivo>&#xa;                                        &lt;xsl:if test=&quot;IDRisorsaNOW&quot;>&#xa;                                            &lt;IDRisorsaNOW>&#xa;                                                &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                            &lt;/IDRisorsaNOW>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns1:DettaglioOrdineElement>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;ns1:DettaglioOrdineElement[nomeComponente = 'DTUINDIRIZZOCERT' or nomeComponente = 'DTUCONFIGURAZIONE']&quot;>&#xa;                                &lt;xsl:if test=&quot;not($ValidateNotification.parameters/sm:Offerta=('VLAN','VLANNGA','VLANVULA','VP'))&quot;>&#xa;                                    &lt;ns1:DettaglioOrdineElement>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/IDDettaglioOrdin