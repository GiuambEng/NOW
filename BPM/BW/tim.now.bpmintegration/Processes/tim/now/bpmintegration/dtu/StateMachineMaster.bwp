                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ADC&quot;/>&#xa;    &lt;xsl:param name=&quot;ADCinVolo&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_ADC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM_Mapping&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DTUtoBPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ADCinVolo/Record) > 0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per notifica: &amp;quot;, $ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA, &amp;quot;. Risultati query: &amp;quot;, tib:render-xml($ADCinVolo/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Nessun record recuperato per notifica: &amp;quot;, $ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA)&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Valore GV: &amp;quot;, string($DTLimite_ADC))&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DataCreazioneRichiesta-input"
                                    name="DataCreazioneRichiesta"
                                    outputVariable="DataCreazioneRichiesta"
                                    tibex:xpdlId="090e3997-c7d2-495e-9686-4df2e0ab52e5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToDataCreazioneRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DataCreazioneRichiestaToInvoke_DTUtoBPM_Mapping"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+090e3997-c7d2-495e-9686-4df2e0ab52e5+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/IdRichiesta>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CREATED&#xa;  FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE IDRICHIESTAOLO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdRichiesta"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateEventOnStateMachine2&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ASSEGNATOADIMPRESA&quot;/>&#xa;    &lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_SOSPESOCONNOTIFICAFS&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUtoBPM_Mapping&quot;/>&#xa;    &lt;xsl:template name=&quot;MapResponse_OK_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;sm:StateMachineValidation_Response>&#xa;            &lt;sm:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/sm:ID_RICHIESTA>&#xa;            &lt;sm:ESITO_VALIDAZIONE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;            &lt;/sm:ESITO_VALIDAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1 and $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo='ASSEGNATOADIMPRESA'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'INDELIVERY'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_SOSPESOCONNOTIFICAFS) &amp;lt; 1 and $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo='SOSPESOCONNOTIFICAFS'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'SOSPESO'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo&quot;>&#xa;                        &lt;sm:STATO_SUCCESSIVO>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo&quot;/>&#xa;                        &lt;/sm:STATO_SUCCESSIVO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:FlagAltroOperatore&quot;>&#xa;                &lt;sm:FLAG_ALTRO_OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:FlagAltroOperatore&quot;/>&#xa;                &lt;/sm:FLAG_ALTRO_OPERATORE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Notifica&quot;>&#xa;                &lt;sm:NOTIFICA>&#xa;                    &lt;xsl:if test=&quot;sm:CODICE_CAUSALE_NOW&quot;>&#xa;                        &lt;sm:CODICE_CAUSALE_NOW>&#xa;                            &lt;xsl:value-of select=&quot;sm:CODICE_CAUSALE_NOW&quot;/>&#xa;                        &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;>&#xa;                        &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;/>&#xa;                        &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_RECIPIENT>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_RECIPIENT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONATING&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONATING&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONOR&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONOR>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONOR&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONOR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:COMPONENTE_DONATING&quot;>&#xa;                        &lt;sm:COMPONENTE_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:COMPONENTE_DONATING&quot;/>&#xa;                        &lt;/sm:COMPONENTE_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:NOTIFICA>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($Invoke_DTUtoBPM_Mapping/output/Q1:manageNotificationRequest/Q1:ARRICCHIMENTI/Q1:Arricchimento/ns1:SedeElement)&quot;>&#xa;                &lt;sm:ARRICCHIMENTI>&#xa;                    &lt;xsl:copy-of select=&quot;$Invoke_DTUtoBPM_Mapping/output/Q1:manageNotificationRequest/Q1:ARRICCHIMENTI/Q1:Arricchimento/ns1:SedeElement&quot;/>&#xa;                &lt;/sm:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1&quot;>&#xa;                    &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/sm:StateMachineValidation_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapResponse_OK_2-input"
                                    name="MapResponse_OK_2"
                                    outputVariable="MapResponse_OK_2"
                                    tibex:xpdlId="19646a6e-bbe0-46ec-8a2a-d43b2277f9a0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Invoke_DTUtoBPM_MappingToMapResponse_OK_OscuramentiComponenti"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapResponse_OK_2ToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUtoBPM_Mapping.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateEventOnStateMachine2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ASSEGNATOADIMPRESA&quot;/>&#xa;    &lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_SOSPESOCONNOTIFICAFS&quot;/>&#xa;    &lt;xsl:template name=&quot;MapResponse_OK_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;sm:StateMachineValidation_Response>&#xa;            &lt;sm:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/sm:ID_RICHIESTA>&#xa;            &lt;sm:ESITO_VALIDAZIONE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;            &lt;/sm:ESITO_VALIDAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1 and $ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo='ASSEGNATOADIMPRESA'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'INDELIVERY'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_SOSPESOCONNOTIFICAFS) &amp;lt; 1 and $ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo='SOSPESOCONNOTIFICAFS'&quot;>&#xa;                    &lt;sm:STATO_SUCCESSIVO>&#xa;                        &lt;xsl:value-of select=&quot;'SOSPESO'&quot;/>&#xa;                    &lt;/sm:STATO_SUCCESSIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo&quot;>&#xa;                        &lt;sm:STATO_SUCCESSIVO>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2.parameters/sm:StatoSuccessivo&quot;/>&#xa;                        &lt;/sm:STATO_SUCCESSIVO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ValidateEventOnStateMachine2.parameters/sm:FlagAltroOperatore&quot;>&#xa;                &lt;sm:FLAG_ALTRO_OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2.parameters/sm:FlagAltroOperatore&quot;/>&#xa;                &lt;/sm:FLAG_ALTRO_OPERATORE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$ValidateEventOnStateMachine2.parameters/sm:Notifica&quot;>&#xa;                &lt;sm:NOTIFICA>&#xa;                    &lt;xsl:if test=&quot;sm:CODICE_CAUSALE_NOW&quot;>&#xa;                        &lt;sm:CODICE_CAUSALE_NOW>&#xa;                            &lt;xsl:value-of select=&quot;sm:CODICE_CAUSALE_NOW&quot;/>&#xa;                        &lt;/sm:CODICE_CAUSALE_NOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;>&#xa;                        &lt;sm:ID_ANAGRAFICA_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;/>&#xa;                        &lt;/sm:ID_ANAGRAFICA_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_RECIPIENT>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_RECIPIENT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONATING&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONATING&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONOR&quot;>&#xa;                        &lt;sm:ID_NOTIFICA_DONOR>&#xa;                            &lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONOR&quot;/>&#xa;                        &lt;/sm:ID_NOTIFICA_DONOR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sm:COMPONENTE_DONATING&quot;>&#xa;                        &lt;sm:COMPONENTE_DONATING>&#xa;                            &lt;xsl:value-of select=&quot;sm:COMPONENTE_DONATING&quot;/>&#xa;                        &lt;/sm:COMPONENTE_DONATING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:NOTIFICA>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($Invoke_DTUtoBPM_Mapping.output/Q1:ARRICCHIMENTI/Q1:Arricchimento/ns1:SedeElement)&quot;>&#xa;                &lt;sm:ARRICCHIMENTI>&#xa;                    &lt;xsl:copy-of select=&quot;$Invoke_DTUtoBPM_Mapping.output/Q1:ARRICCHIMENTI/Q1:Arricchimento/ns1:SedeElement&quot;/>&#xa;                &lt;/sm:ARRICCHIMENTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1&quot;>&#xa;                    &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/sm:StateMachineValidation_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:StateMachine="http://www.tim.com/NOW/xsd/StateMachine/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
