                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:tns="http://www.tibco.com/DTUtoBPM_mapping/" xmlns:tns1="http://www.tim.com/NOW/xsd/MappingDTUNotification/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="ValidateNotification"/&gt;&lt;xsl:param name="IdRichiestaOloOriginal"/&gt;&lt;xsl:param name="OscuraAgesp"/&gt;&lt;xsl:param name="Rec_CasedataRich"/&gt;&lt;xsl:param name="DTLimite_CausaleRiprogFF"/&gt;&lt;xsl:param name="DTLimite_ADC"/&gt;&lt;xsl:param name="ADCinVolo"/&gt;&lt;xsl:param name="DTLinite_StatoTokenAppuntamento"/&gt;&lt;xsl:param name="DataCreazioneRichiesta"/&gt;&lt;xsl:param name="DTLimite_KIT_C09_2023"/&gt;&lt;xsl:template name="Invoke_DTUtoBPM_Mapping-input" match="/"&gt;&lt;tns:DTUtoBPMRequest&gt;&lt;input&gt;&lt;tns1:MappingDTUNotificationInput&gt;&lt;ns:EVENTO_NOTIFICA&gt;&lt;ns:TESTATA&gt;&lt;ns:ID_RICHIESTA&gt;&lt;xsl:value-of select="$IdRichiestaOloOriginal"/&gt;&lt;/ns:ID_RICHIESTA&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:TIPOLOGIA_NOTIFICA&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA"/&gt;&lt;/ns:TIPOLOGIA_NOTIFICA&gt;&lt;ns:DATA_INVIO_NOTIFICA_NOW&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW"/&gt;&lt;/ns:DATA_INVIO_NOTIFICA_NOW&gt;&lt;ns:CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ORDINE_OLO"/&gt;&lt;/ns:CODICE_ORDINE_OLO&gt;&lt;ns:CODICE_OLO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_OLO"/&gt;&lt;/ns:CODICE_OLO&gt;&lt;ns:CODICE_ORDINE_TI&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ORDINE_TI"/&gt;&lt;/ns:CODICE_ORDINE_TI&gt;&lt;ns:CODICE_ESITO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ESITO"/&gt;&lt;/ns:CODICE_ESITO&gt;&lt;ns:CAUSALE_ESITO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CAUSALE_ESITO"/&gt;&lt;/ns:CAUSALE_ESITO&gt;&lt;ns:DATA_ESITO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO"/&gt;&lt;/ns:DATA_ESITO&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_PACCHETTO"&gt;&lt;ns:ID_PACCHETTO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_PACCHETTO"/&gt;&lt;/ns:ID_PACCHETTO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_KIT_C09_2023) &amp;lt; 1 and $ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE = 'EX-GESTIONE_AUTONOMA'"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE"&gt;&lt;ns:STATO_DISAGGREGAZIONE&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE"/&gt;&lt;/ns:STATO_DISAGGREGAZIONE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU"&gt;&lt;ns:ID_ORDINE_DTU&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU"/&gt;&lt;/ns:ID_ORDINE_DTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tib:compare-dateTime($DTLinite_StatoTokenAppuntamento, $DataCreazioneRichiesta/Record[1]/CREATED) &amp;lt; 1"&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO"&gt;&lt;ns:STATO_TOKEN_APPUNTAMENTO&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO"/&gt;&lt;/ns:STATO_TOKEN_APPUNTAMENTO&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:OPERATORE_RETE"&gt;&lt;ns:OPERATORE_RETE&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:OPERATORE_RETE"/&gt;&lt;/ns:OPERATORE_RETE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tib:compare-dateTime($DTLimite_KIT_C09_2023, $DataCreazioneRichiesta/Record[1]/CREATED) &amp;lt; 1"&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:GA_IN_LAVORAZIONE_TIM"&gt;&lt;ns:GA_IN_LAVORAZIONE_TIM&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:GA_IN_LAVORAZIONE_TIM"/&gt;&lt;/ns:GA_IN_LAVORAZIONE_TIM&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA)&gt;0"&gt;&lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA"&gt;&lt;ns:ID_FOGLIA&gt;&lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA"/&gt;&lt;/ns:ID_FOGLIA&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/ns:TESTATA&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA)"&gt;&lt;ns:INTERMEDIA&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INFO_CU_RDAC)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INFO_CU_RDAC"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONFIGURAZIONE)"&gt;&lt;xsl:copy-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONFIGURAZIONE"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($ValidateNotification/parameters/sm:StateMachineVali