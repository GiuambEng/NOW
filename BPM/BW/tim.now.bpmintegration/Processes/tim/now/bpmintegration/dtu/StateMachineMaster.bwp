                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tns3=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Recupera_Prog_DTU&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;Valorizza_Consuntivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ValorizzaConsuntivo_Request>&#xa;            &lt;tns3:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/tns3:IdRichiestaOLO>&#xa;            &lt;tns3:IdEventoDTU>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/tns3:IdEventoDTU>&#xa;            &lt;tns3:ProgEventoDtu>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Recupera_Prog_DTU/Record[1]/PROGRS_EVENTO_DTU)&quot;/>&#xa;            &lt;/tns3:ProgEventoDtu>&#xa;            &lt;tns3:IdPreventivo>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IDPreventivo&quot;/>&#xa;            &lt;/tns3:IdPreventivo>&#xa;            &lt;tns3:DtuOpereSpeciali>&#xa;                &lt;tns3:TIPO_OPA>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:TIPO_OPA&quot;/>&#xa;                &lt;/tns3:TIPO_OPA>&#xa;                &lt;tns3:CONTRIBUTO_CLIENTE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:CONTRIBUTO_CLIENTE&quot;/>&#xa;                &lt;/tns3:CONTRIBUTO_CLIENTE>&#xa;                &lt;tns3:GIORNI_PREVISTI>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:GIORNI_PREVISTI&quot;/>&#xa;                &lt;/tns3:GIORNI_PREVISTI>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;>&#xa;                    &lt;tns3:NOTE_PREVENTIVO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;/>&#xa;                    &lt;/tns3:NOTE_PREVENTIVO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:DESCRIZIONE_OPERE>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;>&#xa;                        &lt;ns:Tubazione>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;/>&#xa;                        &lt;/ns:Tubazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;>&#xa;                        &lt;ns:Pozzetto>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;/>&#xa;                        &lt;/ns:Pozzetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;>&#xa;                        &lt;ns:Ripristini>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;/>&#xa;                        &lt;/ns:Ripristini>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;>&#xa;                        &lt;ns:PosaPaloTerrenoStandard>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;/>&#xa;                        &lt;/ns:PosaPaloTerrenoStandard>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;>&#xa;                        &lt;ns:PosaPaloRoccia>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;/>&#xa;                        &lt;/ns:PosaPaloRoccia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;>&#xa;                        &lt;ns:ScavoPavimentazione>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;/>&#xa;                        &lt;/ns:ScavoPavimentazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;>&#xa;                        &lt;ns:ScavoTerreno>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;/>&#xa;                        &lt;/ns:ScavoTerreno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;>&#xa;                        &lt;ns:ScavoRoccia>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;/>&#xa;                        &lt;/ns:ScavoRoccia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:LunghezzaTotaleLinea>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:LunghezzaTotaleLinea&quot;/>&#xa;                    &lt;/ns:LunghezzaTotaleLinea>&#xa;                &lt;/tns3:DESCRIZIONE_OPERE>&#xa;            &lt;/tns3:DtuOpereSpeciali>&#xa;        &lt;/tns3:ValorizzaConsuntivo_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.bpmintegration.operespeciali.ValorizzaConsuntivo" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:reply name="ReplytoBPM"
                                operation="ValidateNotification"
                                partnerLink="StateMachineValidationPortType"
                                portType="ns48:StateMachineValidationPortType"
                                tibex:xpdlId="312a38fb-57f8-436d-99f8-2827124719d1" variable="ReplytoBPM-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:tns3="http://www.example.org/OpereSpeciali" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:Q1="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/" version="2.0"&gt;
    &lt;xsl:param name="MapResponse_KO"/&gt;
    &lt;xsl:param name="MapResponse_OK"/&gt;
    &lt;xsl:param name="Valo_Preventivo"/&gt;
    &lt;xsl:param name="Valorizza_Consuntivo"/&gt;
    &lt;xsl:param name="Invoke_DTUtoBPM_Mapping"/&gt;
    &lt;xsl:param name="MapResponse_OK_2"/&gt;
    &lt;xsl:template name="ReplytoBPM-input" match="/"&gt;
        &lt;tns4:StateMachineValidationResponse&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($MapResponse_OK)"&gt;
                        &lt;sm:StateMachineValidationResponse&gt;
                            &lt;sm:ID_RICHIESTA&gt;
                                &lt;xsl:value-of select="$MapResponse_OK/sm:ID_RICHIESTA"/&gt;
                            &lt;/sm:ID_RICHIESTA&gt;
                            &lt;sm:ESITO_VALIDAZIONE&gt;
                                &lt;xsl:value-of select="$MapResponse_OK/sm:ESITO_VALIDAZIONE"/&gt;
                            &lt;/sm:ESITO_VALIDAZIONE&gt;
                            &lt;xsl:if test="$MapResponse_OK/sm:STATO_SUCCESSIVO"&gt;
                                &lt;sm:STATO_SUCCESSIVO&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK/sm:STATO_SUCCESSIVO"/&gt;
                                &lt;/sm:STATO_SUCCESSIVO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapResponse_OK/sm:FLAG_ALTRO_OPERATORE"&gt;
                                &lt;sm:FLAG_ALTRO_OPERATORE&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK/sm:FLAG_ALTRO_OPERATORE"/&gt;
                                &lt;/sm:FLAG_ALTRO_OPERATORE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$MapResponse_OK/sm:NOTIFICA"/&gt;
                            &lt;xsl:copy-of select="$MapResponse_OK/sm:ARRICCHIMENTI"/&gt;
                            &lt;xsl:if test="string-length(string($Valo_Preventivo/tns3:IdPreventivo)) &gt; 0"&gt;
                                &lt;sm:IDPreventivo&gt;
                                    &lt;xsl:value-of select="xsd:int($Valo_Preventivo/tns3:IdPreventivo)"/&gt;
                                &lt;/sm:IDPreventivo&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(string($Valorizza_Consuntivo/tns3:IdConsuntivo)) &gt; 0"&gt;
                                &lt;sm:IDConsuntivo&gt;
                                    &lt;xsl:value-of select="xsd:int($Valorizza_Consuntivo/tns3:IdConsuntivo)"/&gt;
                                &lt;/sm:IDConsuntivo&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$Invoke_DTUtoBPM_Mapping/output/Q1:manageNotificationRequest/ns:EVENTO_NOTIFICA"/&gt;
                            &lt;xsl:if test="$MapResponse_OK/sm:FLAG_ARRICCHIMENTO"&gt;
                                &lt;sm:FLAG_ARRICCHIMENTO&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK/sm:FLAG_ARRICCHIMENTO"/&gt;
                                &lt;/sm:FLAG_ARRICCHIMENTO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/sm:StateMachineValidationResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:when test="exists($MapResponse_OK_2)"&gt;
                        &lt;sm:StateMachineValidationResponse&gt;
                            &lt;sm:ID_RICHIESTA&gt;
                                &lt;xsl:value-of select="$MapResponse_OK_2/sm:ID_RICHIESTA"/&gt;
                            &lt;/sm:ID_RICHIESTA&gt;
                            &lt;sm:ESITO_VALIDAZIONE&gt;
                                &lt;xsl:value-of select="$MapResponse_OK_2/sm:ESITO_VALIDAZIONE"/&gt;
                            &lt;/sm:ESITO_VALIDAZIONE&gt;
                            &lt;xsl:if test="$MapResponse_OK_2/sm:STATO_SUCCESSIVO"&gt;
                                &lt;sm:STATO_SUCCESSIVO&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK_2/sm:STATO_SUCCESSIVO"/&gt;
                                &lt;/sm:STATO_SUCCESSIVO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapResponse_OK_2/sm:FLAG_ALTRO_OPERATORE"&gt;
                                &lt;sm:FLAG_ALTRO_OPERATORE&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK_2/sm:FLAG_ALTRO_OPERATORE"/&gt;
                                &lt;/sm:FLAG_ALTRO_OPERATORE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$MapResponse_OK_2/sm:NOTIFICA"/&gt;
                            &lt;xsl:copy-of select="$MapResponse_OK_2/sm:ARRICCHIMENTI"/&gt;
                            &lt;xsl:if test="string-length(string($Valo_Preventivo/tns3:IdPreventivo)) &gt; 0"&gt;
                                &lt;sm:IDPreventivo&gt;
                                    &lt;xsl:value-of select="xsd:int($Valo_Preventivo/tns3:IdPreventivo)"/&gt;
                                &lt;/sm:IDPreventivo&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(string($Valorizza_Consuntivo/tns3:IdConsuntivo)) &gt; 0"&gt;
                                &lt;sm:IDConsuntivo&gt;
                                    &lt;xsl:value-of select="xsd:int($Valorizza_Consuntivo/tns3:IdConsuntivo)"/&gt;
                                &lt;/sm:IDConsuntivo&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$Invoke_DTUtoBPM_Mapping/output/Q1:manageNotificationRequest/ns:EVENTO_NOTIFICA"/&gt;
                            &lt;xsl:if test="$MapResponse_OK_2/sm:FLAG_ARRICCHIMENTO"&gt;
                                &lt;sm:FLAG_ARRICCHIMENTO&gt;
                                    &lt;xsl:value-of select="$MapResponse_OK_2/sm:FLAG_ARRICCHIMENTO"/&gt;
                                &lt;/sm:FLAG_ARRICCHIMENTO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/sm:StateMachineValidationResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;sm:StateMachineValidationResponse&gt;
                            &lt;sm:ID_RICHIESTA&gt;
                                &lt;xsl:value-of select="$MapResponse_KO/sm:ID_RICHIESTA"/&gt;
                            &lt;/sm:ID_RICHIESTA&gt;
                            &lt;sm:ESITO_VALIDAZIONE&gt;
                                &lt;xsl:value-of select="$MapResponse_KO/sm:ESITO_VALIDAZIONE"/&gt;
                            &lt;/sm:ESITO_VALIDAZIONE&gt;
                            &lt;xsl:copy-of select="$Invoke_DTUtoBPM_Mapping/output/Q1:manageNotificationRequest/ns:EVENTO_NOTIFICA"/&gt;
                        &lt;/sm:StateMachineValidationResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns4:StateMachineValidationResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tns3=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUtoBPM_Mapping.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MapResponse_KO&quot;/>&#xa;    &lt;xsl:param name=&quot;MapResponse_OK&quot;/>&#xa;    &lt;xsl:param name=&quot;Valo_Preventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;Valorizza_Consuntivo&quot;/>&#xa;    &lt;xsl:param name=&quot;MapResponse_OK_2&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplytoBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($MapResponse_OK)&quot;>&#xa;                &lt;sm:StateMachineValidationResponse>&#xa;                    &lt;sm:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_OK/sm:ID_RICHIESTA&quot;/>&#xa;                    &lt;/sm:ID_RICHIESTA>&#xa;                    &lt;sm:ESITO_VALIDAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_OK/sm:ESITO_VALIDAZIONE&quot;/>&#xa;                    &lt;/sm:ESITO_VALIDAZIONE>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK/sm:STATO_SUCCESSIVO&quot;>&#xa;                        &lt;sm:STATO_SUCCESSIVO>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK/sm:STATO_SUCCESSIVO&quot;/>&#xa;                        &lt;/sm:STATO_SUCCESSIVO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK/sm:FLAG_ALTRO_OPERATORE&quot;>&#xa;                        &lt;sm:FLAG_ALTRO_OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK/sm:FLAG_ALTRO_OPERATORE&quot;/>&#xa;                        &lt;/sm:FLAG_ALTRO_OPERATORE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$MapResponse_OK/sm:NOTIFICA&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$MapResponse_OK/sm:ARRICCHIMENTI&quot;/>&#xa;                    &lt;xsl:if test=&quot;string-length(string($Valo_Preventivo/tns3:IdPreventivo)) > 0&quot;>&#xa;                        &lt;sm:IDPreventivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Valo_Preventivo/tns3:IdPreventivo)&quot;/>&#xa;                        &lt;/sm:IDPreventivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(string($Valorizza_Consuntivo/tns3:IdConsuntivo)) > 0&quot;>&#xa;                        &lt;sm:IDConsuntivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Valorizza_Consuntivo/tns3:IdConsuntivo)&quot;/>&#xa;                        &lt;/sm:IDConsuntivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$Invoke_DTUtoBPM_Mapping.output/ns:EVENTO_NOTIFICA&quot;/>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK/sm:FLAG_ARRICCHIMENTO&quot;>&#xa;                        &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK/sm:FLAG_ARRICCHIMENTO&quot;/>&#xa;                        &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:StateMachineValidationResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($MapResponse_OK_2)&quot;>&#xa;                &lt;sm:StateMachineValidationResponse>&#xa;                    &lt;sm:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_OK_2/sm:ID_RICHIESTA&quot;/>&#xa;                    &lt;/sm:ID_RICHIESTA>&#xa;                    &lt;sm:ESITO_VALIDAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_OK_2/sm:ESITO_VALIDAZIONE&quot;/>&#xa;                    &lt;/sm:ESITO_VALIDAZIONE>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK_2/sm:STATO_SUCCESSIVO&quot;>&#xa;                        &lt;sm:STATO_SUCCESSIVO>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK_2/sm:STATO_SUCCESSIVO&quot;/>&#xa;                        &lt;/sm:STATO_SUCCESSIVO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK_2/sm:FLAG_ALTRO_OPERATORE&quot;>&#xa;                        &lt;sm:FLAG_ALTRO_OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK_2/sm:FLAG_ALTRO_OPERATORE&quot;/>&#xa;                        &lt;/sm:FLAG_ALTRO_OPERATORE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$MapResponse_OK_2/sm:NOTIFICA&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$MapResponse_OK_2/sm:ARRICCHIMENTI&quot;/>&#xa;                    &lt;xsl:if test=&quot;string-length(string($Valo_Preventivo/tns3:IdPreventivo)) > 0&quot;>&#xa;                        &lt;sm:IDPreventivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Valo_Preventivo/tns3:IdPreventivo)&quot;/>&#xa;                        &lt;/sm:IDPreventivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(string($Valorizza_Consuntivo/tns3:IdConsuntivo)) > 0&quot;>&#xa;                        &lt;sm:IDConsuntivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Valorizza_Consuntivo/tns3:IdConsuntivo)&quot;/>&#xa;                        &lt;/sm:IDConsuntivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$Invoke_DTUtoBPM_Mapping.output/ns:EVENTO_NOTIFICA&quot;/>&#xa;                    &lt;xsl:if test=&quot;$MapResponse_OK_2/sm:FLAG_ARRICCHIMENTO&quot;>&#xa;                        &lt;sm:FLAG_ARRICCHIMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$MapResponse_OK_2/sm:FLAG_ARRICCHIMENTO&quot;/>&#xa;                        &lt;/sm:FLAG_ARRICCHIMENTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/sm:StateMachineValidationResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;sm:StateMachineValidationResponse>&#xa;                    &lt;sm:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_KO/sm:ID_RICHIESTA&quot;/>&#xa;                    &lt;/sm:ID_RICHIESTA>&#xa;                    &lt;sm:ESITO_VALIDAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$MapResponse_KO/sm:ESITO_VALIDAZIONE&quot;/>&#xa;                    &lt;/sm:ESITO_VALIDAZIONE>&#xa;                    &lt;xsl:copy-of select=&quot;$Invoke_DTUtoBPM_Mapping.output/ns:EVENTO_NOTIFICA&quot;/>&#xa;                &lt;/sm:StateMachineValidationResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="UpdatedTrue2ToReply"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ReplyToOnMessageEnd1"/>
                                </bpws:sources>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d38e1b08-085c-4549-8ab3-250cad285da1+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;Recupera_Prog_DTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idRichOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/idRichOlo>&#xa;            &lt;idEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/idEventoOrdnNowWhls>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Recupera_Prog_DTU-input"
                                    name="Recupera_Prog_DTU"
                                    outputVariable="Recupera_Prog_DTU"
                                    tibex:xpdlId="d38e1b08-085c-4549-8ab3-250cad285da1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdStatoEventoDTU_6ToRecupera_Prog_NFCONFPREV"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Recupera_Prog_DTUToLogRecupera_Prog_DTU"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d38e1b08-085c-4549-8ab3-250cad285da1+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;Recupera_Prog_DTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idRichOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/idRichOlo>&#xa;            &lt;idEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/idEventoOrdnNowWhls>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT MAX(ev.PROGRS_EVENTO_DTU) AS PROGRS_EVENTO_DTU&#xa;  FROM APPUSER.EVENTO_ORDN_NOW_WHLS whls, APPUSER.EVENTO_DTU ev&#xa;  WHERE whls.ID_RICH_OLO = ev.ID_RICH_OLO&#xa;    AND whls.ID_EVENTO_ORDN_NOW_WHLS = ev.ID_EVENTO_ORDN_NOW_WHLS&#xa;    AND ev.ID_RICH_OLO = ? &#xa;    AND ev.ID_EVENTO_ORDN_NOW_WHLS = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichOlo"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="idEventoOrdnNowWhls"/>
                                    <columnMetadata
                                    columnName="PROGRS_EVENTO_DTU"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogRecupera_Prog_DTU-input"
