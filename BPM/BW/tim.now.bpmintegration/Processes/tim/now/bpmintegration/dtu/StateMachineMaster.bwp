                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;Valorizza_Preventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ValorizzaPreventivo_Request>&#xa;            &lt;tns3:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/tns3:IdRichiestaOLO>&#xa;            &lt;tns3:IdEventoDTU>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/tns3:IdEventoDTU>&#xa;            &lt;tns3:ProgEventoDtu>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns3:ProgEventoDtu>&#xa;            &lt;tns3:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta&quot;/>&#xa;            &lt;/tns3:Offerta>&#xa;            &lt;tns3:DtuOpereSpeciali>&#xa;                &lt;tns3:TIPO_OPA>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:TIPO_OPA&quot;/>&#xa;                &lt;/tns3:TIPO_OPA>&#xa;                &lt;tns3:CONTRIBUTO_CLIENTE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:CONTRIBUTO_CLIENTE&quot;/>&#xa;                &lt;/tns3:CONTRIBUTO_CLIENTE>&#xa;                &lt;tns3:GIORNI_PREVISTI>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:GIORNI_PREVISTI&quot;/>&#xa;                &lt;/tns3:GIORNI_PREVISTI>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:FLAG_PERMESSI&quot;>&#xa;                    &lt;tns3:FLAG_PERMESSI>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:FLAG_PERMESSI&quot;/>&#xa;                    &lt;/tns3:FLAG_PERMESSI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;>&#xa;                    &lt;tns3:NOTE_PREVENTIVO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:NOTE_PREVENTIVO&quot;/>&#xa;                    &lt;/tns3:NOTE_PREVENTIVO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:DESCRIZIONE_OPERE>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;>&#xa;                        &lt;ns:Tubazione>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Tubazione&quot;/>&#xa;                        &lt;/ns:Tubazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;>&#xa;                        &lt;ns:Pozzetto>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Pozzetto&quot;/>&#xa;                        &lt;/ns:Pozzetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;>&#xa;                        &lt;ns:Ripristini>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:Ripristini&quot;/>&#xa;                        &lt;/ns:Ripristini>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;>&#xa;                        &lt;ns:PosaPaloTerrenoStandard>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloTerrenoStandard&quot;/>&#xa;                        &lt;/ns:PosaPaloTerrenoStandard>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;>&#xa;                        &lt;ns:PosaPaloRoccia>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:PosaPaloRoccia&quot;/>&#xa;                        &lt;/ns:PosaPaloRoccia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;>&#xa;                        &lt;ns:ScavoPavimentazione>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoPavimentazione&quot;/>&#xa;                        &lt;/ns:ScavoPavimentazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;>&#xa;                        &lt;ns:ScavoTerreno>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoTerreno&quot;/>&#xa;                        &lt;/ns:ScavoTerreno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;>&#xa;                        &lt;ns:ScavoRoccia>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:ScavoRoccia&quot;/>&#xa;                        &lt;/ns:ScavoRoccia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:LunghezzaTotaleLinea>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI/ns:DESCRIZIONE_OPERE/ns:LunghezzaTotaleLinea&quot;/>&#xa;                    &lt;/ns:LunghezzaTotaleLinea>&#xa;                &lt;/tns3:DESCRIZIONE_OPERE>&#xa;            &lt;/tns3:DtuOpereSpeciali>&#xa;            &lt;tns3:DtuSospensioneOpereSpeciali>&#xa;                &lt;tns3:DATASOSPENSIONE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:date($ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:DataSospensione)&quot;/>&#xa;                &lt;/tns3:DATASOSPENSIONE>&#xa;            &lt;/tns3:DtuSospensioneOpereSpeciali>&#xa;        &lt;/tns3:ValorizzaPreventivo_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Valo_Preventivo-input"
                                    name="Valo_Preventivo"
