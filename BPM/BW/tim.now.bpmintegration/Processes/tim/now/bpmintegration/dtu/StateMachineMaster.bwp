            tibex:propertySource="/Process/StateMachine/DTLimite_KIT_C07_2024" type="xsd:dateTime"/>
        <bpws:variable name="DTLimite_KIT_C09_2025"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/StateMachine/DTLimite_KIT_C09_2025" type="xsd:dateTime"/>
        <bpws:variable name="DTLimite_KIT_C10_2025"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/StateMachine/DTLimite_KIT_C10_2025" type="xsd:dateTime"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="82577e8b-9745-4bf6-aa48-b0631e24bbb3">
                <bpws:onMessage operation="ValidateNotification"
                    partnerLink="StateMachineValidationPortType"
                    portType="ns48:StateMachineValidationPortType"
                    tibex:xpdlId="ddb58298-92f3-46ee-adcb-1e3528b90db8" variable="ValidateNotification">
                    <bpws:scope name="ValidateNotification_ID">
                        <bpws:variables>
                            <bpws:variable
                                element="ns52:ACK_COMUNICAZIONE" name="MessaggioACK"/>
                            <bpws:variable name="isUpdStaging" type="xsd:boolean">
                                <bpws:from>
                                    <bpws:literal>false</bpws:literal>
                                </bpws:from>
                            </bpws:variable>
                            <bpws:variable name="FlagDTUDATICOLLAUDO" type="xsd:string"/>
                        </bpws:variables>
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails1"
                                tibex:faultNameVar="FaultName1" tibex:xpdlId="0a2cbab5-1eed-4c80-8c57-b18832f1c3f2">
                                <bpws:scope name="scope3">
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="InvokeToReplyFault2" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogFault2ToInvoke"
                                    tibex:label="Is Not Updated Staging" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogFault2ToReply"
                                    tibex:label="KO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogFault2-input"
                                    name="LogFault2"
                                    tibex:xpdlId="55f00847-cf7b-4499-befa-cd3d1413a977"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogFault2ToReply">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogFault2ToInvoke">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$isUpdStaging = false() and exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdRichiesta)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$isUpdStaging = false() and exists($ValidateNotification.parameters/sm:IdRichiesta)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFault2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachineValidation'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachineValidation'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateNotification'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($IdRichiestaOloOriginal) > 0&quot;>&#xa;                        &lt;tns3:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;                        &lt;/tns3:BusinessID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/Msg&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails1, false(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:reply faultName="fault"
                                    name="ReplyFault2"
                                    operation="ValidateNotification"
                                    partnerLink="StateMachineValidationPortType"
                                    portType="ns48:StateMachineValidationPortType"
                                    tibex:xpdlId="9961bf40-94e5-4b53-aeff-c3b29d580759" variable="ReplyFault2-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns3="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;
    &lt;xsl:param name="MessaggioACK"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns4:StateMachineValidationFault&gt;
            &lt;parameters&gt;
                &lt;sm:ValidateDTUEventFault&gt;
                    &lt;sm:CausaleEsito&gt;
                        &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                    &lt;/sm:CausaleEsito&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE) and string-length($MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE) &gt; 0"&gt;
                            &lt;xsl:if test="$MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE"&gt;
                                &lt;sm:DescrizioneErrore&gt;
                                    &lt;xsl:value-of select="$MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE"/&gt;
                                &lt;/sm:DescrizioneErrore&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;sm:DescrizioneErrore&gt;
                                &lt;xsl:value-of select="'Errore Generico nella validazione della macchina a stati'"/&gt;
                            &lt;/sm:DescrizioneErrore&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/sm:ValidateDTUEventFault&gt;
            &lt;/parameters&gt;
        &lt;/tns4:StateMachineValidationFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/StateMachineValidation/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MessaggioACK&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;sm:ValidateDTUEventFault>&#xa;            &lt;sm:CausaleEsito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/sm:CausaleEsito>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE) and string-length($MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                        &lt;sm:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;$MessaggioACK/tns3:ACK/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                        &lt;/sm:DescrizioneErrore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;sm:DescrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;'Errore Generico nella validazione della macchina a stati'&quot;/>&#xa;                    &lt;/sm:DescrizioneErrore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/sm:ValidateDTUEventFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToReplyFault2"/>
                                    <bpws:target linkName="LogFault2ToReply"/>
                                    </bpws:targets>
                                    <bpws:correlations/>
                                    </bpws:reply>
                                    <bpws:invoke
                                    inputVariable="UpdateStagingKO2-input"
                                    name="UpdateStagingKO2"
                                    operation="InsertUpdateStaging"
                                    outputVariable="UpdateStagingKO2"
                                    partnerLink="StagingProcessManager"
                                    portType="ns35:InsertUpdateStagingPortType" tibex:xpdlId="17fdd29b-9866-40e4-b7c5-5544fb936fe3">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:tns5="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="StatoStagingKO"/&gt;
    &lt;xsl:param name="MessaggioACK"/&gt;
    &lt;xsl:param name="ValidateNotification"/&gt;
    &lt;xsl:param name="IdRichiestaOloOriginal"/&gt;
    &lt;xsl:template name="UpdateStagingKO2-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;xsl:if test="$MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE"&gt;
                            &lt;tns4:DESCR_ERRORE&gt;
                                &lt;xsl:value-of select="$MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE"/&gt;
                            &lt;/tns4:DESCR_ERRORE&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"&gt;
                            &lt;tns4:ID_RICH_DTU&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                            &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOloOriginal"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$MessaggioACK/tns5:ACK/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;"&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingKO"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"&gt;
                            &lt;tns4:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                            &lt;/tns4:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:COD_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                        &lt;/tns4:COD_PROCSO_NO_FILE&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                            &lt;/ns2:COD_PROCSO_FILE&gt;
                            &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEsecProcsoNoFile"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'CHIUSO'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_FINE_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                            &lt;/ns2:COD_PROCSO&gt;
                            &lt;ns2:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEsecProcsoNoFile"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'ERROR'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: ACK INVIATO&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingKO&quot;/>&#xa;    &lt;xsl:param name=&quot;MessaggioACK&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagingKO2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;xsl:if test=&quot;$MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;tns4:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;tns4:ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MessaggioACK/tns5:ACK/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;&quot;>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingKO&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;tns4:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns4:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:COD_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:CodProcsoNoFile&quot;/>&#xa;                &lt;/tns4:COD_PROCSO_NO_FILE>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:CodProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEsecProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_FINE_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOF