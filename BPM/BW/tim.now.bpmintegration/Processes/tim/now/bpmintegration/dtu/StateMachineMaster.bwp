                                    outputVariable="FlagDTUDATICOLLAUDO"
                                    tibex:xpdlId="c50b1f24-2d6b-4b03-9ec4-f9597bec8850" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Invoke_DTUtoBPM_MappingToDTUDatiCollaudo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DTUDatiCollaudoToQueryONESTEP">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta=('VULAFTTCAB','BITSTREAMNGAFTTCAB','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ValidateNotification.parameters/sm:Offerta=('VULAFTTCAB','BITSTREAMNGAFTTCAB','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE')]]></bpws:transitionCondition>
