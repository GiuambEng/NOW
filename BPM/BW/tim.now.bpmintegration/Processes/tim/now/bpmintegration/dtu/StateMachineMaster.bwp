                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO CTRL_RICHIESTE_TEMP (&#xd;&#xa;IDRICHIESTAOLO, TASK, STATO, QUEUE_NAME, SCADENZA, CREATED, &#xd;&#xa;LAST_UPDATE)&#xd;&#xa;VALUES (?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
