                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;MapResponse_OK&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_LOG_MapperBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachineValidation'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'StateMachineValidation'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ValidateNotification'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdRichiesta&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Invio Esito validazione al BPM&amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapResponse_OK, false(), true())&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f42805ed-85b0-4576-ad9f-e06f3c077e32+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStatoEventoDTU_6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;IdRichOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/IdRichOlo>&#xa;            &lt;IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/IdEventoOrdnNowWhls>&#xa;            &lt;TransactionId>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TransactionId>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpdStatoEventoDTU_6-input"
                                    name="UpdStatoEventoDTU_6"
                                    outputVariable="UpdStatoEventoDTU_6"
                                    tibex:xpdlId="f42805ed-85b0-4576-ad9f-e06f3c077e32" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="__Link14"/>
                                    <bpws:target linkName="GenericLoggerToUpdStatoEventoDTU_6"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Upd_StatoEventoDTU_6ToLOG_Otherwise">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Upd_StatoEventoDTU_NIOPERE">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = &quot;NI_OPERE_SPECIALI&quot;  and exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns12:EVENTO_NOTIFICA/ns12:INTERMEDIA/ns12:OPERE_SPECIALI) and (not(exists($ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore)) or $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore != &quot;KO_ASSOCIATIVA&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ValidateNotification.parameters/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = "NI_OPERE_SPECIALI"  and exists($ValidateNotification.parameters/ns12:EVENTO_NOTIFICA/ns12:INTERMEDIA/ns12:OPERE_SPECIALI) and (not(exists($ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore)) or $ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore != "KO_ASSOCIATIVA")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdStatoEventoDTU_6ToRecupera_Prog_NFCONFPREV">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = &quot;NF_CONFERMA_PREVENTIVO&quot; and exists($ValidateNotification/parameters/sm:StateMachineValidationRequest/ns12:EVENTO_NOTIFICA/ns12:FINALE/ns12:OPERE_SPECIALI) and (not(exists($ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore)) or $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore != &quot;KO_ASSOCIATIVA&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ValidateNotification.parameters/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = "NF_CONFERMA_PREVENTIVO" and exists($ValidateNotification.parameters/ns12:EVENTO_NOTIFICA/ns12:FINALE/ns12:OPERE_SPECIALI) and (not(exists($ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore)) or $ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore != "KO_ASSOCIATIVA")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdStatoEventoDTU_6ToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = &quot;NF_ESPLETAMENTO&quot; and $ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Lavorazione= 'ATTIVAZIONE' and $ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta = 'FIXEDWIRELESSACCESS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ValidateNotification.parameters/ns12:EVENTO_NOTIFICA/ns12:TESTATA/ns12:TIPOLOGIA_NOTIFICA = "NF_ESPLETAMENTO" and $ValidateNotification.parameters/sm:Lavorazione= 'ATTIVAZIONE' and $ValidateNotification.parameters/sm:Offerta = 'FIXEDWIRELESSACCESS']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f42805ed-85b0-4576-ad9f-e06f3c077e32+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStatoEventoDTU_6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;IdRichOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;            &lt;/IdRichOlo>&#xa;            &lt;IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/IdEventoOrdnNowWhls>&#xa;            &lt;TransactionId>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TransactionId>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_DTU SET IDTPLG_STATO_EVENTO_DTU = (SELECT IDTPLG_STATO_EVENTO_DTU FROM TIPOLG_STATO_EVENTO_DTU WHERE DESCR_STATO_EVENTO_DTU = 'EVENTO_AMMESSO')&#xd;&#xa;&#x9;WHERE ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ? AND TRANSACTION_ID = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdRichOlo"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IdEventoOrdnNowWhls"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TransactionId"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ValidateEventOnStateMachine2&quot;/>&lt;xsl:param name=&quot;Invoke_DTUtoBPM_Mapping&quot;/>&lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&lt;xsl:param name=&quot;DTLimite_ASSEGNATOADIMPRESA&quot;/>&lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUDATICOLLAUDO&quot;/>&lt;xsl:param name=&quot;DTLimite_SOSPESOCONNOTIFICAFS&quot;/>&lt;xsl:param name=&quot;ValidateNotification&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUDATIOPERATORERETE&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOPZIONALI&quot;/>&lt;xsl:param name=&quot;FlagDTUDATICOLLAUDO&quot;/>&lt;xsl:param name=&quot;DTLimite_DTUSERVIZIOAGGIUNTIVO&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C07_2024&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C09_2025&quot;/>&lt;xsl:param name=&quot;DTLimite_KIT_C10_2025&quot;/>&lt;xsl:template name=&quot;MapResponse_OK-input&quot; match=&quot;/&quot;>&lt;sm:StateMachineValidation_Response>&lt;sm:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&lt;/sm:ID_RICHIESTA>&lt;sm:ESITO_VALIDAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/sm:ESITO_VALIDAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_ASSEGNATOADIMPRESA) &amp;lt; 1 and $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo='ASSEGNATOADIMPRESA'&quot;>&lt;sm:STATO_SUCCESSIVO>&lt;xsl:value-of select=&quot;'INDELIVERY'&quot;/>&lt;/sm:STATO_SUCCESSIVO>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_SOSPESOCONNOTIFICAFS) &amp;lt; 1 and $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo='SOSPESOCONNOTIFICAFS'&quot;>&lt;sm:STATO_SUCCESSIVO>&lt;xsl:value-of select=&quot;'SOSPESO'&quot;/>&lt;/sm:STATO_SUCCESSIVO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo&quot;>&lt;sm:STATO_SUCCESSIVO>&lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:StatoSuccessivo&quot;/>&lt;/sm:STATO_SUCCESSIVO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:FlagAltroOperatore&quot;>&lt;sm:FLAG_ALTRO_OPERATORE>&lt;xsl:value-of select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:FlagAltroOperatore&quot;/>&lt;/sm:FLAG_ALTRO_OPERATORE>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Notifica&quot;>&lt;sm:NOTIFICA>&lt;xsl:if test=&quot;sm:CODICE_CAUSALE_NOW&quot;>&lt;sm:CODICE_CAUSALE_NOW>&lt;xsl:value-of select=&quot;sm:CODICE_CAUSALE_NOW&quot;/>&lt;/sm:CODICE_CAUSALE_NOW>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;>&lt;sm:ID_ANAGRAFICA_CAUSALE>&lt;xsl:value-of select=&quot;sm:ID_ANAGRAFICA_CAUSALE&quot;/>&lt;/sm:ID_ANAGRAFICA_CAUSALE>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;>&lt;sm:ID_NOTIFICA_RECIPIENT>&lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_RECIPIENT&quot;/>&lt;/sm:ID_NOTIFICA_RECIPIENT>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:ID_NOTIFICA_DONATING&quot;>&lt;sm:ID_NOTIFICA_DONATING>&lt;xsl:value-of select=&quot;sm:ID_NOTIFICA_DONATING&quot;/>&lt;/sm:ID_NOTIFICA_DONATING>&lt;/xsl