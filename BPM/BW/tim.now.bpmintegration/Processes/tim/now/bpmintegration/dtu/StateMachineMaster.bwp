                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tns=&quot;http://www.tibco.com/DTUtoBPM_mapping/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingDTUNotification/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuraAgesp&quot;/>&#xa;    &lt;xsl:param name=&quot;Rec_CasedataRich&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_CausaleRiprogFF&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_ADC&quot;/>&#xa;    &lt;xsl:param name=&quot;ADCinVolo&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLinite_StatoTokenAppuntamento&quot;/>&#xa;    &lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_KIT_C09_2023&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_DTUtoBPM_Mapping-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:MappingDTUNotificationInput>&#xa;            &lt;ns:EVENTO_NOTIFICA>&#xa;                &lt;ns:TESTATA>&#xa;                    &lt;ns:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;                    &lt;/ns:ID_RICHIESTA>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:TIPOLOGIA_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                    &lt;/ns:TIPOLOGIA_NOTIFICA>&#xa;                    &lt;ns:DATA_INVIO_NOTIFICA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;/>&#xa;                    &lt;/ns:DATA_INVIO_NOTIFICA_NOW>&#xa;                    &lt;ns:CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ORDINE_OLO&quot;/>&#xa;                    &lt;/ns:CODICE_ORDINE_OLO>&#xa;                    &lt;ns:CODICE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_OLO&quot;/>&#xa;                    &lt;/ns:CODICE_OLO>&#xa;                    &lt;ns:CODICE_ORDINE_TI>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ORDINE_TI&quot;/>&#xa;                    &lt;/ns:CODICE_ORDINE_TI>&#xa;                    &lt;ns:CODICE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ESITO&quot;/>&#xa;                    &lt;/ns:CODICE_ESITO>&#xa;                    &lt;ns:CAUSALE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CAUSALE_ESITO&quot;/>&#xa;                    &lt;/ns:CAUSALE_ESITO>&#xa;                    &lt;ns:DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:DATA_ESITO&quot;/>&#xa;                    &lt;/ns:DATA_ESITO>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_PACCHETTO&quot;>&#xa;                        &lt;ns:ID_PACCHETTO>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_PACCHETTO&quot;/>&#xa;                        &lt;/ns:ID_PACCHETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_KIT_C09_2023) &amp;lt; 1 and $ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE = 'EX-GESTIONE_AUTONOMA'&quot;/>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                                &lt;ns:STATO_DISAGGREGAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                                &lt;/ns:STATO_DISAGGREGAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;ns:ID_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/ns:ID_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tib:compare-dateTime($DTLinite_StatoTokenAppuntamento, $DataCreazioneRichiesta/Record[1]/CREATED) &amp;lt; 1&quot;>&#xa;                        &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO&quot;>&#xa;                            &lt;ns:STATO_TOKEN_APPUNTAMENTO>&#xa;                                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO&quot;/>&#xa;                            &lt;/ns:STATO_TOKEN_APPUNTAMENTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:OPERATORE_RETE&quot;>&#xa;                        &lt;ns:OPERATORE_RETE>&#xa;                            &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:OPERATORE_RETE&quot;/>&#xa;                        &lt;/ns:OPERATORE_RETE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tib:compare-dateTime($DTLimite_KIT_C09_2023, $DataCreazioneRichiesta/Record[1]/CREATED) &amp;lt; 1&quot;>&#xa;                        &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:GA_IN_LAVORAZIONE_TIM&quot;>&#xa;                            &lt;ns:GA_IN_LAVORAZIONE_TIM>&#xa;                                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:GA_IN_LAVORAZIONE_TIM&quot;/>&#xa;                            &lt;/ns:GA_IN_LAVORAZIONE_TIM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA&quot;>&#xa;                            &lt;ns:ID_FOGLIA>&#xa;                                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:ID_FOGLIA&quot;/>&#xa;                            &lt;/ns:ID_FOGLIA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns:TESTATA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA)&quot;>&#xa;                        &lt;ns:INTERMEDIA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INFO_CU_RDAC)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INFO_CU_RDAC&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONTATTO&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRESA_APPUNTAMENTO&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:INDIRIZZO_CERT&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONFIGURAZIONE)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:CONFIGURAZIONE&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_VC)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_VC&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:ASU)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:ASU&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:OPERE_SPECIALI&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:FONIA)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:FONIA&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PIC)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:PIC&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF) and (count($OscuraAgesp/Record) = 0 or (count($OscuraAgesp/Record) > 0 and  $OscuraAgesp/Record[1]/FLAG_OSCURMENTO !='Y'))&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_FF&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_OPERATORE_RETE&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:SEDE&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:DATI_ACCESSO&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:APP_EOLO&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:INTERMEDIA/ns:AVVIO_POLICY_CONTATTO&quot;/>&#xa;                        &lt;/ns:INTERMEDIA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE)&quot;>&#xa;                        &lt;ns:FINALE>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI)&quot;>&#xa;                                &lt;ns:DATI>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_VC&quot;/>&#xa;                                    &lt;xsl:for-each select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_ACCESSO&quot;>&#xa;                                        &lt;ns:DATI_ACCESSO>&#xa;                                            &lt;ns:DES>&#xa;                                                &lt;xsl:value-of select=&quot;ns:DES&quot;/>&#xa;                                            &lt;/ns:DES>&#xa;                                            &lt;ns:ORA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;ns:ORA_DES&quot;/>&#xa;                                            &lt;/ns:ORA_DES>&#xa;                                            &lt;xsl:if test=&quot;ns:ATTEN_DN&quot;>&#xa;                                                &lt;ns:ATTEN_DN>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:ATTEN_DN&quot;/>&#xa;                                                &lt;/ns:ATTEN_DN>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:MODEM_RETE_TI&quot;>&#xa;                                                &lt;ns:MODEM_RETE_TI>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:MODEM_RETE_TI&quot;/>&#xa;                                                &lt;/ns:MODEM_RETE_TI>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:INDIRIZZO_IP_1&quot;>&#xa;                                                &lt;ns:INDIRIZZO_IP_1>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:INDIRIZZO_IP_1&quot;/>&#xa;                                                &lt;/ns:INDIRIZZO_IP_1>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:INDIRIZZO_IP_2&quot;>&#xa;                                                &lt;ns:INDIRIZZO_IP_2>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:INDIRIZZO_IP_2&quot;/>&#xa;                                                &lt;/ns:INDIRIZZO_IP_2>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:INDIRIZZO_IP_3&quot;>&#xa;                                                &lt;ns:INDIRIZZO_IP_3>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:INDIRIZZO_IP_3&quot;/>&#xa;                                                &lt;/ns:INDIRIZZO_IP_3>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:INDIRIZZO_IP_4&quot;>&#xa;                                                &lt;ns:INDIRIZZO_IP_4>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:INDIRIZZO_IP_4&quot;/>&#xa;                                                &lt;/ns:INDIRIZZO_IP_4>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:TECNOLOGIA&quot;>&#xa;                                                &lt;ns:TECNOLOGIA>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:TECNOLOGIA&quot;/>&#xa;                                                &lt;/ns:TECNOLOGIA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:AGG_UP&quot;>&#xa;                                                &lt;ns:AGG_UP>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:AGG_UP&quot;/>&#xa;                                                &lt;/ns:AGG_UP>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:AGG_DN&quot;>&#xa;                                                &lt;ns:AGG_DN>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:AGG_DN&quot;/>&#xa;                                                &lt;/ns:AGG_DN>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:NM_UP&quot;>&#xa;                                                &lt;ns:NM_UP>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:NM_UP&quot;/>&#xa;                                                &lt;/ns:NM_UP>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:NM_DN&quot;>&#xa;                                                &lt;ns:NM_DN>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:NM_DN&quot;/>&#xa;                                                &lt;/ns:NM_DN>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:ATTEN_UP&quot;>&#xa;                                                &lt;ns:ATTEN_UP>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:ATTEN_UP&quot;/>&#xa;                                                &lt;/ns:ATTEN_UP>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:MODEM_SEDE_CLIENTE&quot;>&#xa;                                                &lt;ns:MODEM_SEDE_CLIENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:MODEM_SEDE_CLIENTE&quot;/>&#xa;                                                &lt;/ns:MODEM_SEDE_CLIENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:NUMERO_COPPIE_RAME&quot;>&#xa;                                                &lt;ns:NUMERO_COPPIE_RAME>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:NUMERO_COPPIE_RAME&quot;/>&#xa;                                                &lt;/ns:NUMERO_COPPIE_RAME>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:ATTRIBUTO_MODEM_SEDE_CLIENTE&quot;>&#xa;                                                &lt;ns:ATTRIBUTO_MODEM_SEDE_CLIENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:ATTRIBUTO_MODEM_SEDE_CLIENTE&quot;/>&#xa;                                                &lt;/ns:ATTRIBUTO_MODEM_SEDE_CLIENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:ID_ODR&quot;>&#xa;                                                &lt;ns:ID_ODR>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:ID_ODR&quot;/>&#xa;                                                &lt;/ns:ID_ODR>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:IMEI&quot;>&#xa;                                                &lt;ns:IMEI>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:IMEI&quot;/>&#xa;                                                &lt;/ns:IMEI>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:IMSI&quot;>&#xa;                                                &lt;ns:IMSI>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:IMSI&quot;/>&#xa;                                                &lt;/ns:IMSI>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:MSISDN&quot;>&#xa;                                                &lt;ns:MSISDN>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:MSISDN&quot;/>&#xa;                                                &lt;/ns:MSISDN>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:SERIAL_NUMBER&quot;>&#xa;                                                &lt;ns:SERIAL_NUMBER>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:SERIAL_NUMBER&quot;/>&#xa;                                                &lt;/ns:SERIAL_NUMBER>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;count($ADCinVolo/Record) > 0 and tib:compare-dateTime($DTLimite_ADC, $ADCinVolo/Record[1]/CREATED) &amp;lt; 1&quot;>&#xa;                                                &lt;xsl:if test=&quot;ns:ADC&quot;>&#xa;                                                    &lt;ns:ADC>&#xa;                                                        &lt;xsl:value-of select=&quot;ns:ADC&quot;/>&#xa;                                                    &lt;/ns:ADC>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:PRODOTTO_RITIRATO&quot;>&#xa;                                                &lt;ns:PRODOTTO_RITIRATO>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:PRODOTTO_RITIRATO&quot;/>&#xa;                                                &lt;/ns:PRODOTTO_RITIRATO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:CARATTERIZZAZIONE_GEOGRAFICA&quot;>&#xa;                                                &lt;ns:CARATTERIZZAZIONE_GEOGRAFICA>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:CARATTERIZZAZIONE_GEOGRAFICA&quot;/>&#xa;                                                &lt;/ns:CARATTERIZZAZIONE_GEOGRAFICA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:AREA&quot;>&#xa;                                                &lt;ns:AREA>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:AREA&quot;/>&#xa;                                                &lt;/ns:AREA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:BANDO_PUBBLICO&quot;>&#xa;                                                &lt;ns:BANDO_PUBBLICO>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:BANDO_PUBBLICO&quot;/>&#xa;                                                &lt;/ns:BANDO_PUBBLICO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:DIRETTO_INFRATEL&quot;>&#xa;                                                &lt;ns:DIRETTO_INFRATEL>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:DIRETTO_INFRATEL&quot;/>&#xa;                                                &lt;/ns:DIRETTO_INFRATEL>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:SPECIAL_PRICE&quot;>&#xa;                                                &lt;ns:SPECIAL_PRICE>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:SPECIAL_PRICE&quot;/>&#xa;                                                &lt;/ns:SPECIAL_PRICE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns:COPERTO_FTTH&quot;>&#xa;                                                &lt;ns:COPERTO_FTTH>&#xa;                                                    &lt;xsl:value-of select=&quot;ns:COPERTO_FTTH&quot;/>&#xa;                                                &lt;/ns:COPERTO_FTTH>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns:DATI_ACCESSO>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF) and count($Rec_CasedataRich/Record) > 0 and $Rec_CasedataRich/Record[1]/OPERATORERETE = &amp;quot;FF&amp;quot;&quot;>&#xa;                                        &lt;ns:DATI_FF>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:ID_GPON&quot;>&#xa;                                                &lt;ns:ID_GPON>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:ID_GPON&quot;/>&#xa;                                                &lt;/ns:ID_GPON>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:DIMENSIONEMORSETTIERA&quot;>&#xa;                                                &lt;ns:DIMENSIONEMORSETTIERA>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:DIMENSIONEMORSETTIERA&quot;/>&#xa;                                                &lt;/ns:DIMENSIONEMORSETTIERA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CODICESPLITTERPRIMARIO&quot;>&#xa;                                                &lt;ns:CODICESPLITTERPRIMARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CODICESPLITTERPRIMARIO&quot;/>&#xa;                                                &lt;/ns:CODICESPLITTERPRIMARIO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;>&#xa;                                                &lt;ns:CODICESPLITTERSECONDARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CODICESPLITTERSECONDARIO&quot;/>&#xa;                                                &lt;/ns:CODICESPLITTERSECONDARIO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:ROE&quot;>&#xa;                                                &lt;ns:ROE>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:ROE&quot;/>&#xa;                                                &lt;/ns:ROE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:POSIZIONESPLITTER&quot;>&#xa;                                                &lt;ns:POSIZIONESPLITTER>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:POSIZIONESPLITTER&quot;/>&#xa;                                                &lt;/ns:POSIZIONESPLITTER>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:POSIZIONEMORSETTIERAROE&quot;>&#xa;                                                &lt;ns:POSIZIONEMORSETTIERAROE>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:POSIZIONEMORSETTIERAROE&quot;/>&#xa;                                                &lt;/ns:POSIZIONEMORSETTIERAROE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:RIPROGETTATO&quot;>&#xa;                                                &lt;ns:RIPROGETTATO>&#xa;                                                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:RIPROGETTATO&quot;/>&#xa;                                                &lt;/ns:RIPROGETTATO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tib:compare-dateTime($DTLimite_CausaleRiprogFF, $Rec_CasedataRich/Record[1]/CREATED) &amp;lt; 1&quot;>&#xa;                                                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CAUSALERIPROGETTAZIONE&quot;>&#xa;                                                    &lt;ns:CAUSALERIPROGETTAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_FF/ns:CAUSALERIPROGETTAZIONE&quot;/>&#xa;                                                    &lt;/ns:CAUSALERIPROGETTAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns:DATI_FF>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_COLLAUDO&quot;/>&#xa;                                    &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI/ns:DATI_OPERATORE_RETE&quot;/>&#xa;                                &lt;/ns:DATI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:FONIA&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:NOTIFICHE_VERSO_OLO&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OPERE_SPECIALI&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:OL_IN_CORSO&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:PRENOTAZIONE_NUMERO&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZI_OPZIONALI&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZIO_AGGIUNTIVO)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:SERVIZIO_AGGIUNTIVO&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:APPARATO)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:APPARATO&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:MOTIVAZIONE_INTERVENTO_IN_SEDE_CLIENTE)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:MOTIVAZIONE_INTERVENTO_IN_SEDE_CLIENTE&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:INDIRIZZO_CERT)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:INDIRIZZO_CERT&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:ONT_OPERATORE)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:ONT_OPERATORE&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI_REPORTISTICA)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:FINALE/ns:DATI_REPORTISTICA&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns:FINALE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:copy-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:CONFERMA_ANNULLAMENTO&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:EVENTO_NOTIFICA>&#xa;            &lt;tns1:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:Offerta&quot;/>&#xa;            &lt;/tns1:Offerta>&#xa;            &lt;tns1:OffertaDonating>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:OffertaDonating&quot;/>&#xa;            &lt;/tns1:OffertaDonating>&#xa;            &lt;tns1:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:Lavorazione&quot;/>&#xa;            &lt;/tns1:Lavorazione>&#xa;        &lt;/tns1:MappingDTUNotificationInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="DataCreazioneRichiestaToInvoke_DTUtoBPM_Mapping"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Invoke_DTUtoBPM_MappingToMapResponse_OK_OscuramentiComponenti">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Invoke_DTUtoBPM_Mapping/output/ns18:manageNotificationRequest/ns18:ARRICCHIMENTI[1]/ns18:Arricchimento/ns74:DettaglioOrdineElement)=1 and ($Invoke_DTUtoBPM_Mapping/output/ns18:manageNotificationRequest/ns18:ARRICCHIMENTI[1]/ns18:Arricchimento/ns74:DettaglioOrdineElement[1]/nomeComponente=('DTUINDIRIZZOCERT','DTUCONFIGURAZIONE') and $ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta=('VLAN','VLANNGA','VLANVULA','VP'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($Invoke_DTUtoBPM_Mapping.output/ns18:ARRICCHIMENTI[1]/ns18:Arricchimento/ns74:DettaglioOrdineElement)=1 and ($Invoke_DTUtoBPM_Mapping.output/ns18:ARRICCHIMENTI[1]/ns18:Arricchimento/ns74:DettaglioOrdineElement[1]/nomeComponente=('DTUINDIRIZZOCERT','DTUCONFIGURAZIONE') and $ValidateNotification.parameters/sm:Offerta=('VLAN','VLANNGA','VLANVULA','VP'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Invoke_DTUtoBPM_MappingToDTUDatiCollaudo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:invoke
                                inputVariable="UpdateStaging2-input"
                                name="UpdateStaging2"
                                operation="InsertUpdateStaging"
                                outputVariable="UpdateStaging2"
                                partnerLink="StagingProcessManager"
                                portType="ns35:InsertUpdateStagingPortType" tibex:xpdlId="9652fbfe-a7ca-46fb-aad3-f094980dfa5d">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachine/" xmlns:tns5="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="StatoStagingKO"/&gt;
    &lt;xsl:param name="MessaggioACK"/&gt;
    &lt;xsl:param name="ValidateNotification"/&gt;
    &lt;xsl:param name="ValidateEventOnStateMachine2"/&gt;
    &lt;xsl:param name="IdRichiestaOloOriginal"/&gt;
    &lt;xsl:template name="UpdateStaging2-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore) and string-length($ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore)&gt;0"&gt;
                                &lt;tns4:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="concat($ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:CodiceErrore,' - ', $ValidateEventOnStateMachine2/parameters/sm:ValidateDTUEventResponse/sm:Error/sm:DescrizioneErrore,' - ', &amp;#xD;&amp;#xA;' MESSAGGIO DA VALIDARE - IdRichiesta: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdRichiesta,&amp;#xD;&amp;#xA;' TIPOLOGIA_NOTIFICA: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA,&amp;#xD;&amp;#xA;' CODICE_ESITO: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ESITO,&amp;#xD;&amp;#xA;' CAUSALE_ESITO: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CAUSALE_ESITO,&amp;#xD;&amp;#xA;' Offerta: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Offerta,&amp;#xD;&amp;#xA;' Lavorazione: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Lavorazione,&amp;#xD;&amp;#xA;' StatoRichiestaNow: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaNow,&amp;#xD;&amp;#xA;' StatoRichiestaPrecNow: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaPrecNow,&amp;#xD;&amp;#xA;' StatoRichiestaOlo: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:StatoRichiestaOlo,&amp;#xD;&amp;#xA;' Scenario: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:Scenario,&amp;#xD;&amp;#xA;' AnnullamentoAutomatico: ',string($ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:AnnullamentoAutomatico),&amp;#xD;&amp;#xA;' FlagOpereSpeciali: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagOpereSpeciali,&amp;#xD;&amp;#xA;' FlagDisaggregazione: ',$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:FlagDisaggregazione,&amp;#xD;&amp;#xA;' - ', $MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE)"/&gt;
                                &lt;/tns4:DESCR_ERRORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"&gt;
                            &lt;tns4:ID_RICH_DTU&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                            &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOloOriginal"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$MessaggioACK/tns5:ACK/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;"&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingKO"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;xsl:if test="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"&gt;
                            &lt;tns4:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                            &lt;/tns4:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:COD_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                        &lt;/tns4:COD_PROCSO_NO_FILE&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdRichiesta"/&gt;
                    &lt;/tns4:IdRichiestaOLO&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                            &lt;/ns2:COD_PROCSO_FILE&gt;
                            &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEsecProcsoNoFile"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'CHIUSO'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_FINE_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:CodProcsoNoFile"/&gt;
                            &lt;/ns2:COD_PROCSO&gt;
                            &lt;ns2:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="$ValidateNotification/parameters/sm:StateMachineValidationRequest/sm:IdEsecProcsoNoFile"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: ACK INVIATO&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachine/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidateEventOnStateMachine2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ValidateNotification.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingKO&quot;/>&#xa;    &lt;xsl:param name=&quot;MessaggioACK&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOloOriginal&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore) and string-length($ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore)>0&quot;>&#xa;                        &lt;tns4:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;concat($ValidateEventOnStateMachine2.parameters/sm:Error/sm:CodiceErrore,' - ', $ValidateEventOnStateMachine2.parameters/sm:Error/sm:DescrizioneErrore,' - ', &amp;#xD;&amp;#xA;' MESSAGGIO DA VALIDARE - IdRichiesta: ',$ValidateNotification.parameters/sm:IdRichiesta,&amp;#xD;&amp;#xA;' TIPOLOGIA_NOTIFICA: ',$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA,&amp;#xD;&amp;#xA;' CODICE_ESITO: ',$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CODICE_ESITO,&amp;#xD;&amp;#xA;' CAUSALE_ESITO: ',$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:CAUSALE_ESITO,&amp;#xD;&amp;#xA;' Offerta: ',$ValidateNotification.parameters/sm:Offerta,&amp;#xD;&amp;#xA;' Lavorazione: ',$ValidateNotification.parameters/sm:Lavorazione,&amp;#xD;&amp;#xA;' StatoRichiestaNow: ',$ValidateNotification.parameters/sm:StatoRichiestaNow,&amp;#xD;&amp;#xA;' StatoRichiestaPrecNow: ',$ValidateNotification.parameters/sm:StatoRichiestaPrecNow,&amp;#xD;&amp;#xA;' StatoRichiestaOlo: ',$ValidateNotification.parameters/sm:StatoRichiestaOlo,&amp;#xD;&amp;#xA;' Scenario: ',$ValidateNotification.parameters/sm:Scenario,&amp;#xD;&amp;#xA;' AnnullamentoAutomatico: ',string($ValidateNotification.parameters/sm:AnnullamentoAutomatico),&amp;#xD;&amp;#xA;' FlagOpereSpeciali: ',$ValidateNotification.parameters/sm:FlagOpereSpeciali,&amp;#xD;&amp;#xA;' FlagDisaggregazione: ',$ValidateNotification.parameters/sm:FlagDisaggregazione,&amp;#xD;&amp;#xA;' - ', $MessaggioACK/tns5:ACK/ns:DESCRIZIONE_ERRORE)&quot;/>&#xa;                        &lt;/tns4:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;tns4:ID_RICH_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOloOriginal&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MessaggioACK/tns5:ACK/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;&quot;>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingKO&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;>&#xa;                    &lt;tns4:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/ns:EVENTO_NOTIFICA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns4:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:COD_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:CodProcsoNoFile&quot;/>&#xa;                &lt;/tns4:COD_PROCSO_NO_FILE>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdRichiesta&quot;/>&#xa;            &lt;/tns4:IdRichiestaOLO>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:COD_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:CodProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEsecProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_FINE_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;ns2:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:CodProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:COD_PROCSO>&#xa;                    &lt;ns2:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$ValidateNotification.parameters/sm:IdEsecProcsoNoFile&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW ASINC: ACK INVIATO&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
