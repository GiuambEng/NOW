                                    sqlStatement="SELECT CODICE_FISCALE_HASH, COGNOME_RAGIONE_SOCIALE_HASH, NOME_HASH,&#xa;  PARTITA_IVA_HASH&#xa;  FROM APPUSER.RICHIESTA_ORDINE_CLIENTE_HASH&#xa;  WHERE ID_RICHIESTA_OLO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
