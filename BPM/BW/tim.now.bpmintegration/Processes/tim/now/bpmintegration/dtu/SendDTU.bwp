s1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:OWNER_PRESA_APPUNTAMENTO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:OWNER_PRESA_APPUNTAMENTO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='DISAGGREGAZIONE'])&quot;>&#xa;                                    &lt;tns5:OWNER_PRESA_APPUNTAMENTO>&#xa;                                        &lt;xsl:value-of select=&quot;'TI'&quot;/>&#xa;                                    &lt;/tns5:OWNER_PRESA_APPUNTAMENTO>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO'])&quot;>&#xa;                                    &lt;tns5:DATA_APPUNTAMENTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 7, 4),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 4, 2),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 1, 2))&quot;/>&#xa;                                    &lt;/tns5:DATA_APPUNTAMENTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO'])&quot;>&#xa;                                    &lt;tns5:DATA_APPUNTAMENTO>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 7, 4),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 4, 2),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 1, 2))&quot;/>&#xa;                                    &lt;/tns5:DATA_APPUNTAMENTO>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA'])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:FASCIA_ORARIA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA'])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:FASCIA_ORARIA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns5:PRESA_APPUNTAMENTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']) or ($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&#xa;                        &lt;tns5:PRESTAZIONI_AGGIUNTIVE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&#xa;                                    &lt;tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                    &lt;/tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']/attributiDettaglioOrdine[nomeAttributo='FLAGPRESTAZIONEAGGIUNTIVA']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&#xa;                                    &lt;tns5:PRESTAZIONE_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;'Prestazione sempre presente'&quot;/>&#xa;                                    &lt;/tns5:PRESTAZIONE_AGGIUNTIVA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:PRESTAZIONE_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']/attributiDettaglioOrdine[nomeAttributo='PRESTAZIONEAGGIUNTIVA']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:PRESTAZIONE_AGGIUNTIVA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns5:PRESTAZIONI_AGGIUNTIVE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='SLAPLUSSU'])&quot;>&#xa;                        &lt;tns5:SLA_PLUS_SU>&#xa;                            &lt;tns5:FLAG_SLA_PLUS_SU>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='SLAPLUSSU']/attributiDettaglioOrdine[nomeAttributo='FLAGSLAPLUSSU']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:FLAG_SLA_PLUS_SU>&#xa;                            &lt;tns5:VALORE_SLA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='SLAPLUSSU']/attributiDettaglioOrdine[nomeAttributo='VALORESLA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:VALORE_SLA>&#xa;                        &lt;/tns5:SLA_PLUS_SU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='OS' and ($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAOPERATORE' ]/attributiDettaglioOrdine[nomeAttributo = 'DESCRIZIONETIPOLOGIAIMPRESA']/valoreAttributo= 'OPSYSC3')&quot;>&#xa;                            &lt;tns5:GESTIONE_AUTONOMA>&#xa;                                &lt;xsl:value-of select=&quot;'OPSYSC3'&quot;/>&#xa;                            &lt;/tns5:GESTIONE_AUTONOMA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='OS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']))&quot;>&#xa;                            &lt;tns5:GESTIONE_AUTONOMA>&#xa;                                &lt;xsl:value-of select=&quot;'OPSYSS'&quot;/>&#xa;                            &lt;/tns5:GESTIONE_AUTONOMA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='OS' and exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])&quot;>&#xa;                            &lt;tns5:GESTIONE_AUTONOMA>&#xa;                                &lt;xsl:value-of select=&quot;'OPSYSC'&quot;/>&#xa;                            &lt;/tns5:GESTIONE_AUTONOMA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='IS'&quot;>&#xa;                            &lt;tns5:GESTIONE_AUTONOMA>&#xa;                                &lt;xsl:value-of select=&quot;'SYSC'&quot;/>&#xa;                            &lt;/tns5:GESTIONE_AUTONOMA>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSOGPON']/attributiDettaglioOrdine[nomeAttributo='AREADICENTRALE']/valoreAttributo&quot;>&#xa;                        &lt;tns5:AREA_CENTRALE>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSOGPON']/attributiDettaglioOrdine[nomeAttributo='AREADICENTRALE']/valoreAttributo&quot;/>&#xa;                        &lt;/tns5:AREA_CENTRALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='GESTIONEAUTONOMAOPERATORE']/attributiDettaglioOrdine[nomeAttributo='SUBAPPALTO']/valoreAttributo&quot;>&#xa;                        &lt;tns5:SUB_APPALTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='GESTIONEAUTONOMAOPERATORE']/attributiDettaglioOrdine[nomeAttributo='SUBAPPALTO']/valoreAttributo&quot;/>&#xa;                        &lt;/tns5:SUB_APPALTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:DISAGGREGAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType = 'EMISSIONE' and $Start/tns1:RichiestaElement/offerta = 'FIXEDWIRELESSACCESS'&quot;>&#xa;                &lt;tns5:SERVIZIO_FWA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                            &lt;tns5:DETTAGLIO_LAVORAZIONE_FWA>&#xa;                                &lt;xsl:value-of select=&quot;'ATT'&quot;/>&#xa;                            &lt;/tns5:DETTAGLIO_LAVORAZIONE_FWA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:DETTAGLIO_LAVORAZIONE_FWA>&#xa;                                &lt;xsl:value-of select=&quot;'DIS'&quot;/>&#xa;                            &lt;/tns5:DETTAGLIO_LAVORAZIONE_FWA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns5:SERVIZIO_RICHIESTO>&#xa;                        &lt;xsl:value-of select=&quot;'FWA'&quot;/>&#xa;                    &lt;/tns5:SERVIZIO_RICHIESTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE'&quot;>&#xa;                            &lt;tns5:FLAG_INTERVENTO>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/tns5:FLAG_INTERVENTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:FLAG_INTERVENTO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'FLAGINTERVENTO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:FLAG_INTERVENTO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns5:TIPOLOGIA_CPE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'TIPOLOGIACPE']/valoreAttributo&quot;/>&#xa;                    &lt;/tns5:TIPOLOGIA_CPE>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOFWA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = 'IMEI']/valoreAttributo&quot;>&#xa;                            &lt;tns5:IMEI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOFWA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = 'IMEI']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:IMEI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'IMSI']/valoreAttributo&quot;>&#xa;                            &lt;tns5:IMSI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'IMSI']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:IMSI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'MSISDN']/valoreAttributo&quot;>&#xa;                            &lt;tns5:MSISDN>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'MSISDN']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:MSISDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'VELUP']/valoreAttributo&quot;>&#xa;                            &lt;tns5:VEL_UP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'VELUP']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:VEL_UP>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'VELDOWN']/valoreAttributo&quot;>&#xa;                            &lt;tns5:VEL_DOWN>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'VELDOWN']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:VEL_DOWN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'PROFILO']/valoreAttributo&quot;>&#xa;                            &lt;tns5:PROFILO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'PROFILO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:PROFILO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'IPSTATICO']/valoreAttributo&quot;>&#xa;                            &lt;tns5:IPSTATICO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'IPSTATICO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:IPSTATICO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE'&quot;>&#xa;                        &lt;tns5:PRODOTTO>&#xa;                            &lt;tns5:TIPO>&#xa;                                &lt;xsl:value-of select=&quot;'CPE'&quot;/>&#xa;                            &lt;/tns5:TIPO>&#xa;                            &lt;tns5:DESCRIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'CPE'&quot;/>&#xa;                            &lt;/tns5:DESCRIZIONE>&#xa;                            &lt;tns5:QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns5:QUANTITA>&#xa;                            &lt;tns5:CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;'COMODATO GRATUITO'&quot;/>&#xa;                            &lt;/tns5:CONTRATTO>&#xa;                            &lt;tns5:COD_NMU>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo = 'CODICENMU']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:COD_NMU>&#xa;                            &lt;tns5:AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATT'&quot;/>&#xa;                            &lt;/tns5:AZIONE>&#xa;                        &lt;/tns5:PRODOTTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:SERVIZIO_FWA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0 and exists($Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld)&quot;>&#xa;                        &lt;tns5:SERVIZIO_OPZIONALI>&#xa;                            &lt;tns5:CODICE_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:CodiceServizio&quot;/>&#xa;                            &lt;/tns5:CODICE_SERVIZIO>&#xa;                            &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;>&#xa;                                &lt;tns5:DESC_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;/>&#xa;                                &lt;/tns5:DESC_SERVIZIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;>&#xa;                                &lt;tns5:DATI_TECNICI>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;/>&#xa;                                &lt;/tns5:DATI_TECNICI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;>&#xa;                                &lt;tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;/>&#xa;                                &lt;/tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns5:SERVIZIO_OPZIONALI>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']&quot;>&#xa;                            &lt;tns5:SERVIZIO_OPZIONALI>&#xa;                                &lt;xsl:variable name=&quot;var&quot; select=&quot;position()&quot;/>&#xa;                                &lt;tns5:CODICE_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns5:CODICE_SERVIZIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;../../lavorazione='ATTIVAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC9'&quot;>&#xa;                                                &lt;tns5:DESC_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'ONT Fibercop'&quot;/>&#xa;                                                &lt;/tns5:DESC_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC8'&quot;>&#xa;                                                &lt;tns5:DESC_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;'ONT Operatore'&quot;/>&#xa;                                                &lt;/tns5:DESC_SERVIZIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONESERVIZIO']/valoreAttributo&quot;>&#xa;                                                    &lt;tns5:DESC_SERVIZIO>&#xa;                                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONESERVIZIO']/valoreAttributo&quot;/>&#xa;                                                    &lt;/tns5:DESC_SERVIZIO>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONESERVIZIO']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:DESC_SERVIZIO>&#xa;                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONESERVIZIO']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:DESC_SERVIZIO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$Accumulate/tns4:OutputString[$var]/tns4:NewString&quot;>&#xa;                                    &lt;tns5:DATI_TECNICI>&#xa;                                        &lt;xsl:value-of select=&quot;$Accumulate/tns4:OutputString[$var]/tns4:NewString&quot;/>&#xa;                                    &lt;/tns5:DATI_TECNICI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='VINCOLANTEPERESPLETAMENTO']/valoreAttributo&quot;>&#xa;                                    &lt;tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VINCOLANTEPERESPLETAMENTO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC8' or attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC9') and string-length(attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo)=0&quot;>&#xa;                                            &lt;tns5:SERVIZIO_NON_VALIDO>&#xa;                                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                            &lt;/tns5:SERVIZIO_NON_VALIDO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:SERVIZIO_NON_VALIDO>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:SERVIZIO_NON_VALIDO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:INFORMAZIONI_SERVIZIO>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:INFORMAZIONI_SERVIZIO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns5:SERVIZIO_OPZIONALI>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType!='SBLOCCO'  and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente, 'SERVIZIOAGGIUNTIVO']&quot;>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='AMBITO']/valoreAttributo= 'DTU'&quot;>&#xa;                        &lt;tns5:SERVIZIO_AGGIUNTIVO>&#xa;                            &lt;xsl:variable name=&quot;idDettOrdAgg&quot; select=&quot;IDDettaglioOrdine&quot;/>&#xa;                            &lt;tns5:NOME_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOMESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:NOME_SERVIZIO>&#xa;                            &lt;tns5:INFORMAZIONI_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:INFORMAZIONI_SERVIZIO>&#xa;                            &lt;tns5:VINCOLO_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VINCOLOSERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:VINCOLO_SERVIZIO>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPARATO' and IDDettaglioOrdineParent=$idDettOrdAgg]&quot;>&#xa;                                &lt;tns5:APPARATO>&#xa;                                    &lt;tns5:TIPOLOGIA_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TIPOLOGIAAPPARATO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:TIPOLOGIA_APPARATO>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='PASSWORDAPPARATO']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:PASSWORD_APPARATO>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PASSWORDAPPARATO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:PASSWORD_APPARATO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns5:CODICE_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEAPPARATO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:CODICE_APPARATO>&#xa;                                    &lt;tns5:AZIONE_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='AZIONEAPPARATO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:AZIONE_APPARATO>&#xa;                                    &lt;tns5:QTA_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='QTAAPPARATO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:QTA_APPARATO>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALE']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:CAUSALE>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALE']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:CAUSALE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns5:APPARATO>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns5:SERVIZIO_AGGIUNTIVO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione=('MIGRAZIONE','VARIAZIONE','CESSAZIONE') &amp;#xD;&amp;#xA;and $Start/tns1:RichiestaElement/offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0 and exists($Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld)&quot;>&#xa;                &lt;tns5:SERVIZIO_OPZIONALI_OLD>&#xa;                    &lt;tns5:CODICE_SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:CodiceServizio&quot;/>&#xa;                    &lt;/tns5:CODICE_SERVIZIO>&#xa;                    &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;>&#xa;                        &lt;tns5:DESC_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;/>&#xa;                        &lt;/tns5:DESC_SERVIZIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;>&#xa;                        &lt;tns5:DATI_TECNICI>&#xa;                            &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;/>&#xa;                        &lt;/tns5:DATI_TECNICI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;>&#xa;                        &lt;tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;/>&#xa;                        &lt;/tns5:VINCOLANTE_PER_ESPLETAMENTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:SERVIZIO_OPZIONALI_OLD>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:EVENTO_RICHIESTA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Richiesta_Notifica_NOW_DTU="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Richiesta_Notifica_NOW_DTU:EVENTO_RICHIESTA" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_MapRichiestaDTU-input"
                    name="LOG_MapRichiestaDTU"
                    tibex:xpdlId="bf850521-f444-4f40-9ace-98127f7de6d6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_MapRequestToDTUToCopy_1_LOG_MapRichiestaDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_LOG_MapRichiestaDTUToSelect_IdTipologiaEvento"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;MapRequestToDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_LOG_MapRichiestaDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Inviato msg a DTU per IdRichiesta &amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO, tib:render-xml($MapRequestToDTU, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;            &lt;tns8:ActiveLoggerServices>&#xa;                &lt;tns8:Envelope>&#xa;                    &lt;tns8:Identifier>&#xa;                        &lt;tns8:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.dtu&amp;quot;&quot;/>&#xa;                        &lt;/tns8:ServiceName>&#xa;                        &lt;tns8:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Operation>&#xa;                        &lt;tns8:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;tns8:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns8:BusinessID>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SentRequestToDTU_&amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                &lt;/tns8:Envelope>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
