ttributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO'])&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo&quot;>&lt;tns5:OWNER_PRESA_APPUNTAMENTO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo&quot;/>&lt;/tns5:OWNER_PRESA_APPUNTAMENTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='DISAGGREGAZIONE'])&quot;>&lt;tns5:OWNER_PRESA_APPUNTAMENTO>&lt;xsl:value-of select=&quot;'TI'&quot;/>&lt;/tns5:OWNER_PRESA_APPUNTAMENTO>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO'])&quot;>&lt;tns5:DATA_APPUNTAMENTO>&lt;xsl:value-of select=&quot;concat(substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 7, 4),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 4, 2),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 1, 2))&quot;/>&lt;/tns5:DATA_APPUNTAMENTO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO'])&quot;>&lt;tns5:DATA_APPUNTAMENTO>&lt;xsl:value-of select=&quot;concat(substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 7, 4),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 4, 2),'-',substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='DATAAPPUNTAMENTO']/valoreAttributo, 1, 2))&quot;/>&lt;/tns5:DATA_APPUNTAMENTO>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA'])&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;>&lt;tns5:FASCIA_ORARIA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;/>&lt;/tns5:FASCIA_ORARIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA'])&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;>&lt;tns5:FASCIA_ORARIA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTOGESTIONEAUTONOMA']/attributiDettaglioOrdine[nomeAttributo='FASCIAORARIA']/valoreAttributo&quot;/>&lt;/tns5:FASCIA_ORARIA>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns5:PRESA_APPUNTAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']) or ($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&lt;tns5:PRESTAZIONI_AGGIUNTIVE>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&lt;tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']/attributiDettaglioOrdine[nomeAttributo='FLAGPRESTAZIONEAGGIUNTIVA']/valoreAttributo&quot;/>&lt;/tns5:FLAG_PRESTAZIONE_AGGIUNTIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/gestioneAutonoma='IS' and not(exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE'])))&quot;>&lt;tns5:PRESTAZIONE_AGGIUNTIVA>&lt;xsl:value-of select=&quot;'Prestazione sempre presente'&quot;/>&lt;/tns5:PRESTAZIONE_AGGIUNTIVA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:PRESTAZIONE_AGGIUNTIVA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']/attributiDettaglioOrdine[nomeAttributo='PRESTAZIONEAGGIUNTIVA']/valoreAttributo&quot;/>&lt;/tns5:PRESTAZIONE_AGGIUNTIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns5:PRESTAZIONI_AGGIUNTIVE>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='SLAPLUSSU'])&quot;>&lt;tns5:SLA_PLUS_SU>&lt;tns5:FLAG_SLA_PLUS_SU>&lt;xsl:value-of select=&quot;$Start/