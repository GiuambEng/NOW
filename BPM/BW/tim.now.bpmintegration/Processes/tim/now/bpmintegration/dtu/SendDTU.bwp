test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:IMPRESA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:IMPRESA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:IMPRESA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:IMPRESA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordi