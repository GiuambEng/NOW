                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/DTUEnrichment/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Call_RecuperoAttributiAsset&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Call_DtuMappingSub-input&quot; match=&quot;/&quot;>&lt;ndm:DTUMappingRequest>&lt;ndm:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ndm:IDRichiestaOLO>&lt;ndm:TransactionId>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/ndm:TransactionId>&lt;ndm:RequestType>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns1:RequestType&quot;/>&lt;/ndm:RequestType>&lt;ndm:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codificaOLONOW&quot;/>&lt;/ndm:CodiceOLO>&lt;ndm:CodiceOLO_AGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/ndm:CodiceOLO_AGCOM>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/offerta&quot;>&lt;ndm:Offerta>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/offerta&quot;/>&lt;/ndm:Offerta>&lt;/xsl:if>&lt;ndm:Lavorazione>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/lavorazione&quot;/>&lt;/ndm:Lavorazione>&lt;ndm:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/strutturaRichiesta&quot;/>&lt;/ndm:StrutturaRichiesta>&lt;ndm:CodiceOrdineTI>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceOrdineTI&quot;/>&lt;/ndm:CodiceOrdineTI>&lt;ndm:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/ndm:CodiceOrdineOLO>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;>&lt;ndm:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;/>&lt;/ndm:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;>&lt;ndm:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;/>&lt;/ndm:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav&quot;>&lt;ndm:SottoLavorazione>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav&quot;/>&lt;/ndm:SottoLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaScenario&quot;>&lt;ndm:TipologiaScenario>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaScenario&quot;/>&lt;/ndm:TipologiaScenario>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/DNOLOCollaudo&quot;>&lt;ndm:DNOLOCollaudo>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/DNOLOCollaudo&quot;/>&lt;/ndm:DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/numeroVerdeOloCollaudo&quot;>&lt;ndm:NumeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/numeroVerdeOloCollaudo&quot;/>&lt;/ndm:NumeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/numeroVerdeOloPT&quot;>&lt;ndm:NumeroVerdeOloPT>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/numeroVerdeOloPT&quot;/>&lt;/ndm:NumeroVerdeOloPT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codicePacchettoNOW&quot;>&lt;ndm:CodicePacchettoNow>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codicePacchettoNOW&quot;/>&lt;/ndm:CodicePacchettoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/IDCorrelazione&quot;>&lt;ndm:IDCorrelazione>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDCorrelazione&quot;/>&lt;/ndm:IDCorrelazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/LNA_LA&quot;>&lt;ndm:LNA_LA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/LNA_LA&quot;/>&lt;/ndm:LNA_LA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]/attributiDettaglioOrdine[nomeAttributo='VARIAZIONECONCORDATA']/valoreAttributo='SI'&quot;>&lt;ndm:FlagMonitoraggio>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ndm:FlagMonitoraggio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ndm:FlagMonitoraggio>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ndm:FlagMonitoraggio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='ATMVC']/attributiDettaglioOrdine[nomeAttributo='RICHIESTAMONITORAGGIO']/valoreAttributo='SI'&quot;>&lt;ndm:FlagMonitoraggio>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ndm:FlagMonitoraggio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceTTM&quot;>&lt;ndm:CodiceTTM>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceTTM&quot;/>&lt;/ndm:CodiceTTM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/flagNaked&quot;>&lt;ndm:FlagNaked>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/flagNaked&quot;/>&lt;/ndm:FlagNaked>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0 and ($Start/tns1:RichiestaElement/offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB','SEMIEASYIPNGAFTTH') or $Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:Offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB','SEMIEASYIPNGAFTTH'))&quot;>&lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:Cluster&quot;>&lt;ndm:Cluster>&lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:Cluster&quot;/>&lt;/ndm:Cluster>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;) &amp;#xD;&amp;#xA;or nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; or starts-with(nomeComponente, &amp;quot;CONSISTENZA&amp;quot;) &amp;#xD;&amp;#xA;or starts-with(nomeComponente, &amp;quot;DATIRICARICA&amp;quot;) &amp;#xD;&amp;#xA;or (starts-with(nomeComponente, &amp;quot;RACCOLTAVLAN&amp;quot;) and nomeComponente!=&amp;quot;RACCOLTAVLANMULTICAST&amp;quot;) or nomeComponente='RACCOLTAVP']&quot;>&lt;xsl:variable name=&quot;varIDDettOrd&quot; select=&quot;IDDettaglioOrdine&quot;/>&lt;ndm:Fonia_Dati>&lt;ndm:NomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/ndm:NomeComponente>&lt;xsl:if test=&quot;../../codificaOLONOW&quot;>&lt;ndm:CodiceOLO>&lt;xsl:value-of select=&quot;../../codificaOLONOW&quot;/>&lt;/ndm:CodiceOLO>&lt;/xsl:if>&lt;ndm:CodiceOLO_AGCOM>&lt;xsl:value-of select=&quot;../../codificaOLOAGCOM&quot;/>&lt;/ndm:CodiceOLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;>&lt;ndm:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quo