-length($Start/tns1:RichiestaElement/ordine/codOperatoreSecondario)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;>&lt;tns5:CODICE_OLO_SECONDARIO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;/>&lt;/tns5:CODICE_OLO_SECONDARIO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/tns1:RichiestaElement/offerta,'FTTH') and ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' or $Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE')&quot;>&lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/codOperatoreSecondario)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;>&lt;tns5:CODICE_OLO_SECONDARIO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;/>&lt;/tns5:CODICE_OLO_SECONDARIO>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/modelServPerValidazioni)>0 and contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' ) or ($Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE'))&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidazioni&quot;>&lt;tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidazioni&quot;/>&lt;/tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' ) or ($Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;s