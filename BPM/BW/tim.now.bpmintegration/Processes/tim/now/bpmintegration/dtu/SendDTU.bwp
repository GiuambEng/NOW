                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns8:MsgCode>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;            &lt;tns8:ActiveLoggerServices>&#xa;                &lt;tns8:Envelope>&#xa;                    &lt;tns8:Identifier>&#xa;                        &lt;tns8:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.dtu&amp;quot;&quot;/>&#xa;                        &lt;/tns8:ServiceName>&#xa;                        &lt;tns8:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Operation>&#xa;                        &lt;tns8:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;tns8:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns8:BusinessID>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SentRequestToDTU_&amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                    &lt;tns8:ErrorLog>&#xa;                        &lt;tns8:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns8:TimeStamp>&#xa;                        &lt;tns8:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore su SentRequestToDTU, id_richiesta: &amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:Descrizione>&#xa;                        &lt;tns8:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns8:Codice>&#xa;                        &lt;tns8:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns8:track_position>&#xa;                        &lt;tns8:ErrorReport>&#xa;                            &lt;tns8:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                            &lt;/tns8:StackTrace>&#xa;                            &lt;tns8:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                            &lt;/tns8:Msg>&#xa;                            &lt;tns8:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                            &lt;/tns8:ProcessStack>&#xa;                            &lt;tns8:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                            &lt;/tns8:MsgCode>&#xa;                            &lt;tns8:Data/>&#xa;                        &lt;/tns8:ErrorReport>&#xa;                    &lt;/tns8:ErrorLog>&#xa;                &lt;/tns8:Envelope>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="66647fa5-7dce-4e66-86d6-f63e8fe60b10">
                            <bpws:targets>
                                <bpws:target linkName="LogFaultToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
