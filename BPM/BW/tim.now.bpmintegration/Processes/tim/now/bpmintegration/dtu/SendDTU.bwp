                    <bpws:sources>
                        <bpws:source linkName="LOG_InsertDTUEventoToRichiesta_Evento"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapRequestToDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_InsertDTUEvento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Terminata chiamata a Insert_DTU_Evento&amp;quot;&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;            &lt;tns8:ActiveLoggerServices>&#xa;                &lt;tns8:Envelope>&#xa;                    &lt;tns8:Identifier>&#xa;                        &lt;tns8:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.dtu&amp;quot;&quot;/>&#xa;                        &lt;/tns8:ServiceName>&#xa;                        &lt;tns8:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Operation>&#xa;                        &lt;tns8:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;tns8:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns8:BusinessID>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SentRequestToDTU_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SentRequestToDTU_&amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                &lt;/tns8:Envelope>&#xa;                &lt;tns8:Playload>&#xa;                    &lt;tns8:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($MapRequestToDTU)))&quot;/>&#xa;                    &lt;/tns8:Binary>&#xa;                    &lt;tns8:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapRequestToDTU, true(), true())&quot;/>&#xa;                    &lt;/tns8:XMLString>&#xa;                &lt;/tns8:Playload>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
