                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Util/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;ResultDetokenizzazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogResultDetoken-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ResultDetokenizzazione/tns2:Esito='OK'&quot;>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato detokenizzazione : ',tib:render-xml($ResultDetokenizzazione))&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun referente detokenizzato'&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
