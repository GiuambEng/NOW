            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_InsertDTUEvento-input"
                    name="LOG_InsertDTUEvento"
                    tibex:xpdlId="f6599832-521d-4e42-9dcd-6b5d6b4cdf85"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
