                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f521d5e5-2b98-48f8-b9f0-7d93eefa74e1+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ReferenteProgettiSpeciali-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns10:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
