            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="fca48e4d-0675-4d40-ba76-8959c71a5988">
                <bpws:targets>
                    <bpws:target linkName="Empty2ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToMapRequestToDTU"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit"
                        tibex:xpdlId="0d406945-a7cd-49cd-b8c7-ddd040d14b3b" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+50faea28-42ce-4588-a2d9-10b5beaf1c87" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns9:RichiestaElement/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns9:RichiestaElement/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns26:Iterate1_Current_Element_dettaglioordine"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow3">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToReplaceMoreString" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ReplaceMoreStringToGroupEnd1" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="4c7f04ba-b59b-4180-86dd-a912e1756cf5" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToReplaceMoreString"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns9:RichiestaElement/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI'])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="50faea28-42ce-4588-a2d9-10b5beaf1c87" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ReplaceMoreStringToGroupEnd1"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>ReplaceMoreString</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ReplaceMoreString-input"
                                    name="ReplaceMoreString"
                                    outputVariable="ReplaceMoreString"
                                    tibex:xpdlId="99045d96-665e-41c4-a735-6851b580cd9b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToReplaceMoreString"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ReplaceMoreStringToGroupEnd1"/>
                                    </bpws:sources>
