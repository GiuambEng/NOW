                partnerLink="StagingProcessManager"
                portType="ns14:InsertUpdateStagingPortType" tibex:xpdlId="1c6b6877-410d-4e44-8a5b-86968b6298c8">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns11="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento"/&gt;
    &lt;xsl:param name="TransactionId"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="IdProcesso_DTU"/&gt;
    &lt;xsl:param name="statoStaging_OK"/&gt;
    &lt;xsl:param name="MapRequestToDTU"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_DTU"/&gt;
    &lt;xsl:template name="Insert_Staging-input" match="/"&gt;
        &lt;tns10:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns11:StagingRequest&gt;
                    &lt;tns11:StagingOut&gt;
                        &lt;tns11:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapRequestToDTU)"/&gt;
                        &lt;/tns11:CONTENUTO_REQUEST&gt;
                        &lt;tns11:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                        &lt;/tns11:ID_PROCSO_NO_FILE&gt;
                        &lt;tns11:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$statoStaging_OK"/&gt;
                        &lt;/tns11:ID_STATO_ELAB_STAG&gt;
                        &lt;tns11:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns11:TIMSTP_RICH&gt;
                        &lt;tns11:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$TransactionId"/&gt;
                        &lt;/tns11:TRANSACTION_ID&gt;
                        &lt;tns11:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$TransactionId"/&gt;
                        &lt;/tns11:ID_RICH_DTU&gt;
                        &lt;tns11:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns11:ID_RICH_OLO&gt;
                        &lt;tns11:ID_RICHIESTA_OLO_DTU&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_DTU"/&gt;
                        &lt;/tns11:ID_RICHIESTA_OLO_DTU&gt;
                        &lt;tns11:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns11:OPERATORE&gt;
                        &lt;tns11:ID_TIPOLOGIA_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns11:ID_TIPOLOGIA_EVENTO&gt;
                    &lt;/tns11:StagingOut&gt;
                    &lt;tns11:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;
                    &lt;/tns11:IdRichiestaOLO&gt;
                    &lt;tns11:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RICH_DTU'"/&gt;
                    &lt;/tns11:StagingType&gt;
                    &lt;tns11:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns11:LoggerIn&gt;
                &lt;/tns11:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns10:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcesso_DTU&quot;/>&#xa;    &lt;xsl:param name=&quot;statoStaging_OK&quot;/>&#xa;    &lt;xsl:param name=&quot;MapRequestToDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_DTU&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:StagingRequest>&#xa;            &lt;tns11:StagingOut>&#xa;                &lt;tns11:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapRequestToDTU)&quot;/>&#xa;                &lt;/tns11:CONTENUTO_REQUEST>&#xa;                &lt;tns11:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                &lt;/tns11:ID_PROCSO_NO_FILE>&#xa;                &lt;tns11:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$statoStaging_OK&quot;/>&#xa;                &lt;/tns11:ID_STATO_ELAB_STAG>&#xa;                &lt;tns11:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:TIMSTP_RICH>&#xa;                &lt;tns11:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns11:TRANSACTION_ID>&#xa;                &lt;tns11:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns11:ID_RICH_DTU>&#xa;                &lt;tns11:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns11:ID_RICH_OLO>&#xa;                &lt;tns11:ID_RICHIESTA_OLO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_DTU&quot;/>&#xa;                &lt;/tns11:ID_RICHIESTA_OLO_DTU>&#xa;                &lt;tns11:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns11:OPERATORE>&#xa;                &lt;tns11:ID_TIPOLOGIA_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns11:ID_TIPOLOGIA_EVENTO>&#xa;            &lt;/tns11:StagingOut>&#xa;            &lt;tns11:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns11:IdRichiestaOLO>&#xa;            &lt;tns11:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RICH_DTU'&quot;/>&#xa;            &lt;/tns11:StagingType>&#xa;            &lt;tns11:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns11:LoggerIn>&#xa;        &lt;/tns11:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
