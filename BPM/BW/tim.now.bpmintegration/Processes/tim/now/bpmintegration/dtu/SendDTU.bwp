ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$qualifica='CF' and exists($CheckTestCivetta/ndm:FlagTestCivetta) and $CheckTestCivetta/ndm:FlagTestCivetta='Y'&quot;>&#xa;                                            &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;$CheckTestCivetta/ndm:TelefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;starts-with(telefonoMobileReferente,'kk') and count($PAR_CFGZ_NOW/Record)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                                        &lt;tns5:MAIL>&#xa;                                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                                        &lt;/tns5:MAIL>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns5:REFERENTE>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE'&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEPERINTERRUZIONESOSPENSIONE'][progressivoReferente = max($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEPERINTERRUZIONESOSPENSIONE']/progressivoReferente)]&quot;>&#xa;                                &lt;tns5:REFERENTE>&#xa;                                    &lt;xsl:variable name=&quot;var1&quot; select=&quot;position()&quot;/>&#xa;                                    &lt;xsl:variable name=&quot;qualifica&quot; select=&quot;qualificaReferente&quot;/>&#xa;                                    &lt;tns5:PROGRESSIVO>&#xa;                                        &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                                    &lt;/tns5:PROGRESSIVO>&#xa;                                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                                        &lt;tns5:QUALIFICA_REF>&#xa;                                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                                        &lt;/tns5:QUALIFICA_REF>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns5:COGNOMEREFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(cognomeReferente, 1, 60)&quot;/>&#xa;                                    &lt;/tns5:COGNOMEREFERENTE>&#xa;                                    &lt;tns5:NOMEREREFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(nomeReferente, 1, 30)&quot;/>&#xa;                                    &lt;/tns5:NOMEREREFERENTE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with(telefonoFissoReferente,'kk') and count($PAR_CFGZ_NOW/Record)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$qualifica='CF' and exists($CheckTestCivetta/ndm:FlagTestCivetta) and $CheckTestCivetta/ndm:FlagTestCivetta='Y'&quot;>&#xa;                                            &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;$CheckTestCivetta/ndm:TelefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;starts-with(telefonoMobileReferente,'kk') and count($PAR_CFGZ_NOW/Record)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var1]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                                        &lt;tns5:MAIL>&#xa;                                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                                        &lt;/tns5:MAIL>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns5:REFERENTE>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTE' and progressivoReferente!=0]&quot;>&#xa;                                &lt;tns5:REFERENTE>&#xa;                                    &lt;xsl:variable name=&quot;var&quot; select=&quot;position()&quot;/>&#xa;                                    &lt;xsl:variable name=&quot;qualifica2&quot; select=&quot;qualificaReferente&quot;/>&#xa;                                    &lt;tns5:PROGRESSIVO>&#xa;                                        &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                                    &lt;/tns5:PROGRESSIVO>&#xa;                                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                                        &lt;tns5:QUALIFICA_REF>&#xa;                                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                                        &lt;/tns5:QUALIFICA_REF>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns5:COGNOMEREFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(cognomeReferente, 1, 60)&quot;/>&#xa;                                    &lt;/tns5:COGNOMEREFERENTE>&#xa;                                    &lt;tns5:NOMEREREFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(nomeReferente, 1, 30)&quot;/>&#xa;                                    &lt;/tns5:NOMEREREFERENTE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with(telefonoFissoReferente,'kk') and count($PAR_CFGZ_NOW/Record)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var]/telefonoFissoReferente]/tns2:TelefonoFisso&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                &lt;tns5:TELEFONOFISSOREFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                &lt;/tns5:TELEFONOFISSOREFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$qualifica2='CF' and exists($CheckTestCivetta/ndm:FlagTestCivetta) and $CheckTestCivetta/ndm:FlagTestCivetta='Y'&quot;>&#xa;                                            &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;$CheckTestCivetta/ndm:TelefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;starts-with(telefonoMobileReferente,'kk') and count($PAR_CFGZ_NOW/Record)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione[tns2:Token=$Start/tns1:RichiestaElement/ordine/referente[$var]/telefonoMobileReferente]/tns2:TelefonoMobile&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                                        &lt;tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                                        &lt;/tns5:TELEFONOMOBILEREFERENTE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                                        &lt;tns5:MAIL>&#xa;                                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                                        &lt;/tns5:MAIL>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns5:REFERENTE>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TOKENAPPUNTAMENTO']/valoreAttributo&quot;>&#xa;                        &lt;tns5:TOKEN_APPUNTAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TOKENAPPUNTAMENTO']/valoreAttributo&quot;/>&#xa;                        &lt;/tns5:TOKEN_APPUNTAMENTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH&quot;>&#xa;                        &lt;tns5:COGNOME_HASH>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH&quot;/>&#xa;                        &lt;/tns5:COGNOME_HASH>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/NOME_HASH&quot;>&#xa;                        &lt;tns5:NOME_HASH>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/NOME_HASH&quot;/>&#xa;                        &lt;/tns5:NOME_HASH>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Richiesta_Ordine_Cliente_Hash/Record[1]/CODICE_FISCALE_HASH)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/CODICE_FISCALE_HASH&quot;>&#xa;                                &lt;tns5:CODICE_FISCALE_HASH>&#xa;                                    &lt;xsl:value-of select=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/CODICE_FISCALE_HASH&quot;/>&#xa;                                &lt;/tns5:CODICE_FISCALE_HASH>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/PARTITA_IVA_HASH&quot;>&#xa;                                &lt;tns5:PARTITA_IVA_HASH>&#xa;                                    &lt;xsl:value-of select=&quot;$Richiesta_Ordine_Cliente_Hash/Record[1]/PARTITA_IVA_HASH&quot;/>&#xa;                                &lt;/tns5:PARTITA_IVA_HASH>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDBUILDING']/valoreAttributo)>0 and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and $Start/tns1:RichiestaElement/offerta='FIBERSTREAM' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav='RIENTRIDEL82'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDBUILDING']/valoreAttributo&quot;>&#xa;                            &lt;tns5:ID_BUILDING>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDBUILDING']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:ID_BUILDING>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:CLIENTE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:Testata/tns1:RequestType='SBLOCCO' or $Start/tns1:Testata/tns1:RequestType='ACQUISITO_OK' or $Start/tns1:Testata/tns1:RequestType='ACCETTATO'&quot;>&#xa;                    &lt;tns5:DATI_ACCESSO>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav='RIENTRIDEL82' and $Start/tns1:RichiestaElement/ordine/offerta='FIBERSTREAM'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'OFDATITECNICI')]/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;>&#xa;                                &lt;tns5:REMOTE_ID_OF>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'OFDATITECNICI')]/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns5:REMOTE_ID_OF>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns5:DATI_ACCESSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:DATI_ACCESSO>&#xa;                        &lt;xsl:variable name=&quot;var_IdRisorsa&quot; select=&quot;tib:trim(substring($Start/tns1:RichiestaElement/ordine/IDRisorsa, 1, 13))&quot;/>&#xa;                        &lt;xsl:variable name=&quot;varIdRisorsaNOW&quot; select=&quot;tib:trim(substring($Start/tns1:RichiestaElement/ordine/IDRisorsaNOW, 1, 13))&quot;/>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta=('VP','VLAN','VLANNGA','VLANVULA','FEEDER','CANALE','FIBERSTREAM','FWAITALIA1GIGASARDEGNA')&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/IDRisorsa&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/IDRisorsa&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/strutturaRichiesta = ('XDSL','NGA') and $Start/tns1:RichiestaElement/lavorazione = ('CESSAZIONE','VARIAZIONE') and (string-length($Start/tns1:RichiestaElement/ordine/IDRisorsaNOW) > 0 and $Start/tns1:RichiestaElement/ordine/IDRisorsaNOW !=$Start/tns1:RichiestaElement/ordine/IDRisorsa)&quot;>&#xa;                                &lt;tns5:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$varIdRisorsaNOW&quot;/>&#xa;                                &lt;/tns5:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;not(starts-with($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo, 'SHA')) and (($Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE') or ($Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'ATTIVAZIONE274')) and (string-length($Start/tns1:RichiestaElement/ordine/IDRisorsaNOW) > 0 and $Start/tns1:RichiestaElement/ordine/IDRisorsaNOW !=$Start/tns1:RichiestaElement/ordine/IDRisorsa)&quot;>&#xa;                                &lt;tns5:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$varIdRisorsaNOW&quot;/>&#xa;                                &lt;/tns5:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'VARIAZIONE' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav = 'DECREMENTONP'&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('ACCESSOULL','ACCESSOULLDATI','ACCESSOSLU')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSALNA']/valoreAttributo&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('ACCESSOULL','ACCESSOULLDATI','ACCESSOSLU')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSALNA']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'VARIAZIONE' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav = ('TRASLOCOWLR13', 'TRASLOCOWLR14', 'TRASLOCOWLR15', 'TRASLOCOWLR16', 'CAMBIONUMERO3', 'CAMBIONUMERO4')&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$var_IdRisorsa&quot;/>&#xa;                                &lt;/tns5:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede/tipologiaSede = 'SEDECLIENTECERT') and string-length(string($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/IDSede)) > 0&quot;>&#xa;                            &lt;tns5:INDIRIZZO_CERT>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/localita)&quot;>&#xa;                                        &lt;tns5:LOCALITA>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/localita, 1, 60)&quot;/>&#xa;                                        &lt;/tns5:LOCALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:LOCALITA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:LOCALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune) > 0&quot;>&#xa;                                        &lt;tns5:CODICE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune, 1, 10)&quot;/>&#xa;                                        &lt;/tns5:CODICE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:CODICE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:CODICE_COMUNE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune)&quot;>&#xa;                                        &lt;tns5:ISTAT_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;tib:right($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune, 3)&quot;/>&#xa;                                        &lt;/tns5:ISTAT_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:ISTAT_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:ISTAT_COMUNE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/CAP&quot;>&#xa;                                    &lt;tns5:CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/CAP&quot;/>&#xa;                                    &lt;/tns5:CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/particellaToponomastica)&quot;>&#xa;                                        &lt;tns5:PARTICELLATOP>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/particellaToponomastica, 1, 20)&quot;/>&#xa;                                        &lt;/tns5:PARTICELLATOP>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:PARTICELLATOP>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:PARTICELLATOP>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/via)&quot;>&#xa;                                        &lt;tns5:VIA>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/via, 1, 70)&quot;/>&#xa;                                        &lt;/tns5:VIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:VIA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:VIA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/civico)&quot;>&#xa;                                        &lt;tns5:CIVICO>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/civico, 1, 10)&quot;/>&#xa;                                        &lt;/tns5:CIVICO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:CIVICO>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns5:CIVICO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns5:COMPLESSO>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/complesso, 1, 3)&quot;/>&#xa;                                &lt;/tns5:COMPLESSO>&#xa;                                &lt;tns5:SCALA>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/scala, 1, 2)&quot;/>&#xa;                                &lt;/tns5:SCALA>&#xa;                                &lt;tns5:PIANO>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/piano, 1, 2)&quot;/>&#xa;                                &lt;/tns5:PIANO>&#xa;                                &lt;tns5:INTERNO>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/interno, 1, 3)&quot;/>&#xa;                                &lt;/tns5:INTERNO>&#xa;                                &lt;tns5:CODICE_INDIRIZZO>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceToponomastica, 1, 30)&quot;/>&#xa;                                &lt;/tns5:CODICE_INDIRIZZO>&#xa;                                &lt;tns5:COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/comune, 1, 50)&quot;/>&#xa;                                &lt;/tns5:COMUNE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATProvincia) and string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATProvincia) > 0&quot;>&#xa;                                        &lt;tns5:ISTAT_PROV>&#xa;                                            &lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATProvincia, 3, '0')&quot;/>&#xa;                                        &lt;/tns5:ISTAT_PROV>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/siglaProvincia&quot;>&#xa;                                    &lt;tns5:SIGLA_PROV>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/siglaProvincia&quot;/>&#xa;                                    &lt;/tns5:SIGLA_PROV>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns5:DESC_PROV>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/provincia, 1, 80)&quot;/>&#xa;                                &lt;/tns5:DESC_PROV>&#xa;                                &lt;tns5:ISTAT_VIA>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceVia, 1, 9)&quot;/>&#xa;                                &lt;/tns5:ISTAT_VIA>&#xa;                            &lt;/tns5:INDIRIZZO_CERT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE' or $Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE_DAD'&quot;>&#xa;                                &lt;xsl:if test=&quot;$SelNoteAltraLav/Record[1]/NOTE&quot;>&#xa;                                    &lt;tns5:note>&#xa;                                        &lt;xsl:value-of select=&quot;$SelNoteAltraLav/Record[1]/NOTE&quot;/>&#xa;                                    &lt;/tns5:note>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;!--RU_790 - Invio verso DTU campo Note da Richieste di tipo: Rimodulazione DA, Interruzione Sospensione -->&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;>&#xa;                                    &lt;tns5:note>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;/>&#xa;                                    &lt;/tns5:note>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/distretto&quot;>&#xa;                            &lt;tns5:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/distretto&quot;/>&#xa;                            &lt;/tns5:Distretto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario='NPSUNPDEL82'&quot;/>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE' and $Start/tns1:RichiestaElement/offerta=('ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','SLULINEANONATTIVA','VULLLINEANONATTIVA') and $Start/tns1:Testata/tns1:RequestType='EMISSIONE'&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/DRO)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE' or $Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE DAC') and $Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'MIGRAZIONEDEL82'&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulata)) >0 and string($Start/tns1:RichiestaElement/ordine/DACRimodulata)!=string($Start/tns1:RichiestaElement/ordine/DAC)&quot;>&#xa;                                        &lt;tns5:DAC>&#xa;                                            &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&#xa;                                        &lt;/tns5:DAC>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/DAC)&quot;>&#xa;                                                &lt;tns5:DAC>&#xa;                                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&#xa;                                                &lt;/tns5:DAC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulataTemp)) >0&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulataTemp)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulata)) >0&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DAC)) >0&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE' and ($Start/tns1:RichiestaElement/tipologiaSottolav = 'ATTIVAZIONE274' or $Start/tns1:RichiestaElement/ordine/tipologiaSottolav = 'ATTIVAZIONE274') and not(exists($Start/tns1:RichiestaElement/ordine/DAC)) and not(exists($Start/tns1:RichiestaElement/ordine/DACRimodulata)) and exists($Start/tns1:RichiestaElement/DRO)&quot;>&#xa;                                &lt;tns5:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;string($DRO5.parameters/tns6:outputDate)&quot;/>&#xa;                                &lt;/tns5:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario='NPSUNPDEL82'&quot;/>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DAC)) > 0&quot;>&#xa;                                &lt;tns5:DAC_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&#xa;                                &lt;/tns5:DAC_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DADRimodulata)) > 0&quot;>&#xa;                                &lt;tns5:DAD>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DADRimodulata)&quot;/>&#xa;                                &lt;/tns5:DAD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($Start/tns1:Testata/tns1:RequestType = 'EMISSIONE' or $Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE') and string-length(string($Start/tns1:RichiestaElement/ordine/DAD)) > 0&quot;>&#xa;                                &lt;tns5:DAD>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAD)&quot;/>&#xa;                                &lt;/tns5:DAD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'MIGRAZIONEDEL82'&quot;/>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav='MIGRAZIONEDEL82'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;08:30:00&amp;quot;)=0)&quot;>&#xa;                                        &lt;tns5:DAD_FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                                        &lt;/tns5:DAD_FASCIA_ORARIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,'10:30:00')=0)&quot;>&#xa;                                        &lt;tns5:DAD_FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&#xa;                                        &lt;/tns5:DAD_FASCIA_ORARIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;13:00:00&amp;quot;)=0)&quot;>&#xa;                                        &lt;tns5:DAD_FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&#xa;                                        &lt;/tns5:DAD_FASCIA_ORARIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;15:00:00&amp;quot;)=0)&quot;>&#xa;                                        &lt;tns5:DAD_FASCIA_ORARIA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;04&amp;quot;&quot;/>&#xa;                                        &lt;/tns5:DAD_FASCIA_ORARIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/IDFasciaOraria&quot;>&#xa;                                    &lt;tns5:DAD_FASCIA_ORARIA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDFasciaOraria&quot;/>&#xa;                                    &lt;/tns5:DAD_FASCIA_ORARIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaQualita&quot;>&#xa;                            &lt;tns5:CODICE_QUALITA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaQualita&quot;/>&#xa;                            &lt;/tns5:CODICE_QUALITA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD']) or exists($ReferenteProgettiSpeciali/Record[1]/REFOAOPROGETTISPECIALI)&quot;>&#xa;                            &lt;tns5:REFERENTEONFIELD>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'])&quot;>&#xa;                                        &lt;tns5:RF_COGNOME>&#xa;                                            &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/cognomeReferente, 1, 60)&quot;/>&#xa;                                        &lt;/tns5:RF_COGNOME>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:RF_COGNOME>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot; &amp;quot;&quot;/>&#xa;                                        &lt;/tns5:RF_COGNOME>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns5:RF_NOME>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/nomeReferente, 1, 30)&quot;/>&#xa;                                &lt;/tns5:RF_NOME>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoFissoReferente&quot;>&#xa;                                    &lt;tns5:RF_TELEFONO_FISSO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoFissoReferente&quot;/>&#xa;                                    &lt;/tns5:RF_TELEFONO_FISSO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoMobileReferente&quot;>&#xa;                                    &lt;tns5:RF_TELEFONO_MOBILE>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoMobileReferente&quot;/>&#xa;                                    &lt;/tns5:RF_TELEFONO_MOBILE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ReferenteProgettiSpeciali/Record[1]/REFOAOPROGETTISPECIALI&quot;>&#xa;                                    &lt;tns5:REFERENTE_PS>&#xa;                                        &lt;xsl:value-of select=&quot;$ReferenteProgettiSpeciali/Record[1]/REFOAOPROGETTISPECIALI&quot;/>&#xa;                                    &lt;/tns5:REFERENTE_PS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns5:REFERENTEONFIELD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario='NPSUNPDEL82'&quot;/>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaLavorazione = 'ATTIVAZIONE'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaSottolav='CAMBIOTECNOLOGIA'and contains($Start/tns1:RichiestaElement/ordine/offerta, 'FTTH') and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('CONSISTENZADATI','CONSISTENZAFONIA')and azione = 'D']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo)>0&quot;>&#xa;                                        &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                            &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('CONSISTENZADATI','CONSISTENZAFONIA')and azione = 'D']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                        &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                                        &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                            &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente=('CONSISTENZADATI','CONSISTENZAFONIA') and azione = 'T']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                        &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;starts-with($Start/tns1:RichiestaElement/ordine/offerta, 'ULL') or starts-with($Start/tns1:RichiestaElement/ordine/offerta, 'SLU') or  starts-with($Start/tns1:RichiestaElement/ordine/offerta, 'WLR') or starts-with($Start/tns1:RichiestaElement/ordine/offerta, 'VULL')&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo)>0&quot;>&#xa;                                                &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                                &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']