            <bpws:invoke inputVariable="Insert_DTU_Evento-input"
                name="Insert_DTU_Evento" operation="InvioDTUEvento"
                outputVariable="Insert_DTU_Evento"
                partnerLink="DTUEvento"
                portType="ns15:DTUEventoPortType" tibex:xpdlId="6226ce85-8193-4e15-8ae3-c47d0cd88666">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://www.tim.com/DTUEvento/" xmlns:Q1="http://www.tim.com/NOW/xsd/DTUEventoOrdine/" xmlns:tns5="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns1="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;
    &lt;xsl:param name="MapRequestToDTU"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="Insert_DTU_Evento-input" match="/"&gt;
        &lt;tns10:DTU_Evento&gt;
            &lt;input&gt;
                &lt;Q1:DTUEventoRequest&gt;
                    &lt;tns5:EVENTO_RICHIESTA&gt;
                        &lt;tns5:TESTATA&gt;
                            &lt;tns5:ID_RICHIESTA&gt;
                                &lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;
                            &lt;/tns5:ID_RICHIESTA&gt;
                            &lt;tns5:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:TRANSACTION_ID"/&gt;
                            &lt;/tns5:TRANSACTION_ID&gt;
                            &lt;tns5:TIPOLOGIA_EVENTO&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:TIPOLOGIA_EVENTO"/&gt;
                            &lt;/tns5:TIPOLOGIA_EVENTO&gt;
                            &lt;tns5:DATA_INVIO_RICHIESTA_DTU&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:DATA_INVIO_RICHIESTA_DTU"/&gt;
                            &lt;/tns5:DATA_INVIO_RICHIESTA_DTU&gt;
                            &lt;tns5:CODICE_ORDINE_OLO&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ORDINE_OLO"/&gt;
                            &lt;/tns5:CODICE_ORDINE_OLO&gt;
                            &lt;tns5:CODICE_ORDINE_TI&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ORDINE_TI"/&gt;
                            &lt;/tns5:CODICE_ORDINE_TI&gt;
                            &lt;tns5:CODICE_OLO&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_OLO"/&gt;
                            &lt;/tns5:CODICE_OLO&gt;
                            &lt;tns5:CODICE_ISP&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ISP"/&gt;
                            &lt;/tns5:CODICE_ISP&gt;
                            &lt;tns5:DESCRIZIONE_OLO&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:DESCRIZIONE_OLO"/&gt;
                            &lt;/tns5:DESCRIZIONE_OLO&gt;
                            &lt;tns5:LAVORAZIONE_OLO&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:LAVORAZIONE_OLO"/&gt;
                            &lt;/tns5:LAVORAZIONE_OLO&gt;
                            &lt;tns5:SISTEMA_SORGENTE&gt;
                                &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:SISTEMA_SORGENTE"/&gt;
                            &lt;/tns5:SISTEMA_SORGENTE&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_PROGETTO"&gt;
                                &lt;tns5:CODICE_PROGETTO&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_PROGETTO"/&gt;
                                &lt;/tns5:CODICE_PROGETTO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_DELIVERY"&gt;
                                &lt;tns5:CODICE_DELIVERY&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_DELIVERY"/&gt;
                                &lt;/tns5:CODICE_DELIVERY&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:FLAG_NPD"&gt;
                                &lt;tns5:FLAG_NPD&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:FLAG_NPD"/&gt;
                                &lt;/tns5:FLAG_NPD&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:CAMPO_SERVIZIO_IT"&gt;
                                &lt;tns5:CAMPO_SERVIZIO_IT&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:CAMPO_SERVIZIO_IT"/&gt;
                                &lt;/tns5:CAMPO_SERVIZIO_IT&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:SERVIZIO_IN_EOI"&gt;
                                &lt;tns5:SERVIZIO_IN_EOI&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:SERVIZIO_IN_EOI"/&gt;
                                &lt;/tns5:SERVIZIO_IN_EOI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$MapRequestToDTU/tns5:TESTATA/tns5:MIGRAZIONE_INTRA_OLO"&gt;
                                &lt;tns5:MIGRAZIONE_INTRA_OLO&gt;
                                    &lt;xsl:value-of select="$MapRequestToDTU/tns5:TESTATA/tns5:MIGRAZIONE_INTRA_OLO"/&gt;
                                &lt;/tns5:MIGRAZIONE_INTRA_OLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns5:TESTATA&gt;
                        &lt;xsl:copy-of select="$MapRequestToDTU/tns5:CLIENTE"/&gt;
                        &lt;xsl:copy-of select="$MapRequestToDTU/tns5:DATI_ACCESSO"/&gt;
                        &lt;xsl:copy-of select="$MapRequestToDTU/tns5:SERVIZIO_FONIA"/&gt;
                        &lt;xsl:copy-of select="$MapRequestToDTU/tns5:SERVIZIO_DATI"/&gt;
                    &lt;/tns5:EVENTO_RICHIESTA&gt;
                &lt;/Q1:DTUEventoRequest&gt;
            &lt;/input&gt;
        &lt;/tns10:DTU_Evento&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/DTUEvento/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapRequestToDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_DTU_Evento-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:DTUEventoRequest>&#xa;            &lt;tns5:EVENTO_RICHIESTA>&#xa;                &lt;tns5:TESTATA>&#xa;                    &lt;tns5:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:ID_RICHIESTA>&#xa;                    &lt;tns5:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns5:TRANSACTION_ID>&#xa;                    &lt;tns5:TIPOLOGIA_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:TIPOLOGIA_EVENTO&quot;/>&#xa;                    &lt;/tns5:TIPOLOGIA_EVENTO>&#xa;                    &lt;tns5:DATA_INVIO_RICHIESTA_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:DATA_INVIO_RICHIESTA_DTU&quot;/>&#xa;                    &lt;/tns5:DATA_INVIO_RICHIESTA_DTU>&#xa;                    &lt;tns5:CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ORDINE_OLO&quot;/>&#xa;                    &lt;/tns5:CODICE_ORDINE_OLO>&#xa;                    &lt;tns5:CODICE_ORDINE_TI>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ORDINE_TI&quot;/>&#xa;                    &lt;/tns5:CODICE_ORDINE_TI>&#xa;                    &lt;tns5:CODICE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_OLO&quot;/>&#xa;                    &lt;/tns5:CODICE_OLO>&#xa;                    &lt;tns5:CODICE_ISP>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_ISP&quot;/>&#xa;                    &lt;/tns5:CODICE_ISP>&#xa;                    &lt;tns5:DESCRIZIONE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:DESCRIZIONE_OLO&quot;/>&#xa;                    &lt;/tns5:DESCRIZIONE_OLO>&#xa;                    &lt;tns5:LAVORAZIONE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:LAVORAZIONE_OLO&quot;/>&#xa;                    &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;tns5:SISTEMA_SORGENTE>&#xa;                        &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:SISTEMA_SORGENTE&quot;/>&#xa;                    &lt;/tns5:SISTEMA_SORGENTE>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_PROGETTO&quot;>&#xa;                        &lt;tns5:CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_PROGETTO&quot;/>&#xa;                        &lt;/tns5:CODICE_PROGETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_DELIVERY&quot;>&#xa;                        &lt;tns5:CODICE_DELIVERY>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CODICE_DELIVERY&quot;/>&#xa;                        &lt;/tns5:CODICE_DELIVERY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:FLAG_NPD&quot;>&#xa;                        &lt;tns5:FLAG_NPD>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:FLAG_NPD&quot;/>&#xa;                        &lt;/tns5:FLAG_NPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CAMPO_SERVIZIO_IT&quot;>&#xa;                        &lt;tns5:CAMPO_SERVIZIO_IT>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:CAMPO_SERVIZIO_IT&quot;/>&#xa;                        &lt;/tns5:CAMPO_SERVIZIO_IT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:SERVIZIO_IN_EOI&quot;>&#xa;                        &lt;tns5:SERVIZIO_IN_EOI>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:SERVIZIO_IN_EOI&quot;/>&#xa;                        &lt;/tns5:SERVIZIO_IN_EOI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:MIGRAZIONE_INTRA_OLO&quot;>&#xa;                        &lt;tns5:MIGRAZIONE_INTRA_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$MapRequestToDTU/tns5:TESTATA/tns5:MIGRAZIONE_INTRA_OLO&quot;/>&#xa;                        &lt;/tns5:MIGRAZIONE_INTRA_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:TESTATA>&#xa;                &lt;xsl:copy-of select=&quot;$MapRequestToDTU/tns5:CLIENTE&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$MapRequestToDTU/tns5:DATI_ACCESSO&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$MapRequestToDTU/tns5:SERVIZIO_FONIA&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$MapRequestToDTU/tns5:SERVIZIO_DATI&quot;/>&#xa;            &lt;/tns5:EVENTO_RICHIESTA>&#xa;        &lt;/Q1:DTUEventoRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="InvokeToInvoke1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Invoke1ToLOG_InsertDTUEvento"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="Richiesta_Evento-input"
                name="Richiesta_Evento" operation="Richiesta_Evento"
                partnerLink="PortType" portType="ns16:PortType" tibex:xpdlId="a8215c7c-4fc0-4c42-b971-c5157cddb4f5">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns1="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="TransactionId"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="MapRequestToDTU"/&gt;&lt;xsl:template name="Richiesta_Evento-input" match="/"&gt;&lt;tns:Richiesta_Evento&gt;&lt;richiesta&gt;&lt;xsl:copy-of select="$MapRequestToDTU"/&gt;&lt;/richiesta&gt;&lt;header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]'))&amp;#xD;&amp;#xA;"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]'))"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/h:businessID&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="'-'"/&gt;&lt;/h:messageID&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$TransactionId"/&gt;&lt;/h:transactionID&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns:Richiesta_Evento&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapRequestToDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta_Evento-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$MapRequestToDTU&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/DTU/xsd/Richiesta_Notifica_NOW_DTU_Concrete&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta_Evento-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;h:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/h:sourceSystem>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;string(format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]'))&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;string(format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]'))&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;h:businessID>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/h:businessID>&#xa;            &lt;h:messageID>&#xa;                &lt;xsl:value-of select=&quot;'-'&quot;/>&#xa;            &lt;/h:messageID>&#xa;            &lt;h:transactionID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;            &lt;/h:transactionID>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_InsertDTUEventoToRichiesta_Evento"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Richiesta_EventoToCallProcess1"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="Update_Staging-input"
                name="Update_Staging" operation="InsertUpdateStaging"
                outputVariable="Update_Staging"
                partnerLink="StagingProcessManager"
                portType="ns14:InsertUpdateStagingPortType" tibex:xpdlId="622d657f-122c-4caa-a837-c98c38fd63c9">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns11="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns1="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;
    &lt;xsl:param name="statoStaging_OK"/&gt;
    &lt;xsl:param name="TransactionId"/&gt;
    &lt;xsl:param name="IdProcesso_DTU"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento"/&gt;
    &lt;xsl:param name="Insert_Staging"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_DTU"/&gt;
    &lt;xsl:template name="Update_Staging-input" match="/"&gt;
        &lt;tns10:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns11:StagingRequest&gt;
                    &lt;tns11:StagingOut&gt;
                        &lt;tns11:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                        &lt;/tns11:ID_PROCSO_NO_FILE&gt;
                        &lt;tns11:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$statoStaging_OK"/&gt;
                        &lt;/tns11:ID_STATO_ELAB_STAG&gt;
                        &lt;tns11:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns11:TIMSTP_RICH&gt;
                        &lt;tns11:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns11:TIMSTP_RISPOSTA&gt;
                        &lt;tns11:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$TransactionId"/&gt;
                        &lt;/tns11:TRANSACTION_ID&gt;
                        &lt;tns11:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$TransactionId"/&gt;
                        &lt;/tns11:ID_RICH_DTU&gt;
                        &lt;tns11:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;
                        &lt;/tns11:ID_RICH_OLO&gt;
                        &lt;tns11:ID_RICHIESTA_OLO_DTU&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_DTU"/&gt;
                        &lt;/tns11:ID_RICHIESTA_OLO_DTU&gt;
                        &lt;tns11:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns11:OPERATORE&gt;
                        &lt;xsl:if test="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                            &lt;tns11:COD_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                            &lt;/tns11:COD_PROCSO_NO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns11:ID_TIPOLOGIA_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns11:ID_TIPOLOGIA_EVENTO&gt;
                    &lt;/tns11:StagingOut&gt;
                    &lt;tns11:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/tns1:RichiestaElement/IDRichiestaOLO"/&gt;
                    &lt;/tns11:IdRichiestaOLO&gt;
                    &lt;tns11:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RICH_DTU'"/&gt;
                    &lt;/tns11:StagingType&gt;
                    &lt;tns11:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcesso_DTU"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'CHIUSO'"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;xsl:if test="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO&gt;
                                    &lt;xsl:value-of select="$Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($Insert_Staging/RESPONSE/tns11:StagingResponse/tns11:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns11:LoggerIn&gt;
                &lt;/tns11:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns10:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Insert_Staging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;statoStaging_OK&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcesso_DTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_DTU&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:StagingRequest>&#xa;            &lt;tns11:StagingOut>&#xa;                &lt;tns11:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                &lt;/tns11:ID_PROCSO_NO_FILE>&#xa;                &lt;tns11:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$statoStaging_OK&quot;/>&#xa;                &lt;/tns11:ID_STATO_ELAB_STAG>&#xa;                &lt;tns11:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:TIMSTP_RICH>&#xa;                &lt;tns11:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:TIMSTP_RISPOSTA>&#xa;                &lt;tns11:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns11:TRANSACTION_ID>&#xa;                &lt;tns11:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns11:ID_RICH_DTU>&#xa;                &lt;tns11:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns11:ID_RICH_OLO>&#xa;                &lt;tns11:ID_RICHIESTA_OLO_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_DTU&quot;/>&#xa;                &lt;/tns11:ID_RICHIESTA_OLO_DTU>&#xa;                &lt;tns11:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns11:OPERATORE>&#xa;                &lt;xsl:if test=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                    &lt;tns11:COD_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/tns11:COD_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns11:ID_TIPOLOGIA_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns11:ID_TIPOLOGIA_EVENTO>&#xa;            &lt;/tns11:StagingOut>&#xa;            &lt;tns11:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns11:IdRichiestaOLO>&#xa;            &lt;tns11:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RICH_DTU'&quot;/>&#xa;            &lt;/tns11:StagingType>&#xa;            &lt;tns11:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Insert_Staging.RESPONSE/tns11:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcesso_DTU&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$Insert_Staging.RESPONSE/tns11:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Insert_Staging.RESPONSE/tns11:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns11:LoggerIn>&#xa;        &lt;/tns11:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
