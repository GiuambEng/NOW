            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Call_RecuperoAttributiAsset-input"
                    name="Call_RecuperoAttributiAsset"
                    outputVariable="Call_RecuperoAttributiAsset"
                    tibex:xpdlId="d5805aed-5b53-4080-b3fb-d9a2e805d0c5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign_IdRichiestaDTUToCall_RecuperoAttributiAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Call_RecuperoAttributiAssetToCall_DtuMappingSub"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_RecuperoAttributiAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;ndm:RecuperoAttributiAssetRequest>&#xa;            &lt;ndm:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/ndm:IdRichiestaOLO>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]) or exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZACPS&amp;quot;])&quot;>&#xa;                &lt;ndm:ConsistenzaFonia_In>&#xa;                    &lt;ndm:TipoConsistenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZAFONIA&amp;quot;&quot;/>&#xa;                    &lt;/ndm:TipoConsistenza>&#xa;                    &lt;ndm:IdAsset>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = (&amp;quot;CONSISTENZAFONIA&amp;quot;,&amp;quot;CONSISTENZACPS&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/ndm:IdAsset>&#xa;                    &lt;ndm:AzioneConsistenza>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = (&amp;quot;CONSISTENZAFONIA&amp;quot;,&amp;quot;CONSISTENZACPS&amp;quot;)]/azione&quot;/>&#xa;                    &lt;/ndm:AzioneConsistenza>&#xa;                &lt;/ndm:ConsistenzaFonia_In>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;])  or exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZARACCOLTA&amp;quot;])&quot;>&#xa;                &lt;ndm:ConsistenzaDati_In>&#xa;                    &lt;ndm:TipoConsistenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZADATI&amp;quot;&quot;/>&#xa;                    &lt;/ndm:TipoConsistenza>&#xa;                    &lt;ndm:IdAsset>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = (&amp;quot;CONSISTENZADATI&amp;quot;,&amp;quot;CONSISTENZARACCOLTA&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/ndm:IdAsset>&#xa;                    &lt;ndm:AzioneConsistenza>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = (&amp;quot;CONSISTENZADATI&amp;quot;,&amp;quot;CONSISTENZARACCOLTA&amp;quot;)]/azione&quot;/>&#xa;                    &lt;/ndm:AzioneConsistenza>&#xa;                &lt;/ndm:ConsistenzaDati_In>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ndm:RecuperoAttributiAssetRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.dtu.mapping.RecuperoAttributiAsset" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DRO5-input" name="DRO5"
                operation="calcNextDateByDuration" outputVariable="DRO5"
                partnerLink="GetNextDatePortType"
                portType="ns6:GetNextDatePortType" tibex:xpdlId="e4a9ab2b-4d53-46b0-9e91-9eb3b786495f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/SendDTU/" xmlns:tns10="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns6="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="GetNextWorkingDate-input" match="/"&gt;
        &lt;tns10:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns6:Request&gt;
                    &lt;tns6:inputDate&gt;
                        &lt;xsl:value-of select="$Start/tns1:RichiestaElement/DRO"/&gt;
                    &lt;/tns6:inputDate&gt;
                    &lt;tns6:GiorniLavorativi&gt;
                        &lt;xsl:value-of select="5"/&gt;
                    &lt;/tns6:GiorniLavorativi&gt;
                &lt;/tns6:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns10:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GetNextWorkingDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Request>&#xa;            &lt;tns6:inputDate>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/DRO&quot;/>&#xa;            &lt;/tns6:inputDate>&#xa;            &lt;tns6:GiorniLavorativi>&#xa;                &lt;xsl:value-of select=&quot;5&quot;/>&#xa;            &lt;/tns6:GiorniLavorativi>&#xa;        &lt;/tns6:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_DtuMappingSubToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO5&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_NextDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Out GetNextDate: &amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO, tib:render-xml($DRO5/parameters/tns6:Response, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_NextDate-input"
                    name="Log_NextDate"
                    tibex:xpdlId="c5fda6f4-7abe-4341-826f-24d35720dc4d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_NextDateToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO5.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_NextDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Out GetNextDate: &amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO, tib:render-xml($DRO5.parameters, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="IdRichiestaOlo_DTU"
                    name="Assign_IdRichiestaDTU"
                    outputVariable="IdRichiestaOlo_DTU"
                    tibex:xpdlId="b0116793-88c7-4dcd-813a-77b5b617a034" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignTransactionIdToAssign_IdRichiestaDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign_IdRichiestaDTUToCall_RecuperoAttributiAsset">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Start/ns9:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &quot;CONSISTENZA&quot;)]) &#xd;&#xa;and string-length($Start/ns9:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &quot;CONSISTENZA&quot;)]/attributiDettaglioOrdine[nomeAttributo = &quot;IDENTIFICATIVOASSET&quot;]/valoreAttributo) > 0&#xd;&#xa;and not(exists($Start/ns9:RichiestaElement/ordine/dettaglioordine[nomeComponente=('CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT')]))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($Start/ns9:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, "CONSISTENZA")]) 
and string-length($Start/ns9:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, "CONSISTENZA")]/attributiDettaglioOrdine[nomeAttributo = "IDENTIFICATIVOASSET"]/valoreAttributo) > 0
and not(exists($Start/ns9:RichiestaElement/ordine/dettaglioordine[nomeComponente=('CONSISTENZACANALE','CONSISTENZAFEEDER','CONSISTENZASEDEOLT')]))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Assign_IdRichiestaDTUToCall_DtuMappingSub">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(string-length(string($Start/ns9:RichiestaElement/progressivoEmissioneDTU)) > 0) then concat($Start/ns9:RichiestaElement/IDRichiestaOLO, &quot;_&quot;, string($Start/ns9:RichiestaElement/progressivoEmissioneDTU)) else $Start/ns9:RichiestaElement/IDRichiestaOLO" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="IdRichiestaOlo_DTU" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Check_Cess_Simm" tibex:xpdlId="f7298552-a362-4c15-8cd0-c6e17e7528c2">
                <bpws:targets>
                    <bpws:target linkName="Log_NextDateToEmpty"/>
                    <bpws:target linkName="LOG_DtuMappingSubToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Check_Cess_SimmToCheckTestCivetta">
                        <tibex:DesignExpression/>
                    </bpws:source>
