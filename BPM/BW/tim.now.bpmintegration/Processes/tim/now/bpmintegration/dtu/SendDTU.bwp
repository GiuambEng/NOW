eAttributo&quot;>&lt;tns5:VINCOLANTE_PER_ESPLETAMENTO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VINCOLANTEPERESPLETAMENTO']/valoreAttributo&quot;/>&lt;/tns5:VINCOLANTE_PER_ESPLETAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC8' or attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='TLC9') and string-length(attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo)=0&quot;>&lt;tns5:SERVIZIO_NON_VALIDO>&lt;xsl:value-of select=&quot;'NO'&quot;/>&lt;/tns5:SERVIZIO_NON_VALIDO>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo&quot;>&lt;tns5:SERVIZIO_NON_VALIDO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='SERVIZIONONVALIDO']/valoreAttributo&quot;/>&lt;/tns5:SERVIZIO_NON_VALIDO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;>&lt;tns5:INFORMAZIONI_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:INFORMAZIONI_SERVIZIO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;/tns5:SERVIZIO_OPZIONALI>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType!='SBLOCCO'  and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente, 'SERVIZIOAGGIUNTIVO']&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='AMBITO']/valoreAttributo= 'DTU'&quot;>&lt;tns5:SERVIZIO_AGGIUNTIVO>&lt;xsl:variable name=&quot;idDettOrdAgg&quot; select=&quot;IDDettaglioOrdine&quot;/>&lt;tns5:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOMESERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:NOME_SERVIZIO>&lt;tns5:INFORMAZIONI_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:INFORMAZIONI_SERVIZIO>&lt;tns5:VINCOLO_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VINCOLOSERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:VINCOLO_SERVIZIO>&lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPARATO' and IDDettaglioOrdineParent=$idDettOrdAgg]&quot;>&lt;tns5:APPARATO>&lt;tns5:TIPOLOGIA_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TIPOLOGIAAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:TIPOLOGIA_APPARATO>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='PASSWORDAPPARATO']/valoreAttributo&quot;>&lt;tns5:PASSWORD_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PASSWORDAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:PASSWORD_APPARATO>&lt;/xsl:if>&lt;tns5:CODICE_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:CODICE_APPARATO>&lt;tns5:AZIONE_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='AZIONEAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:AZIONE_APPARATO>&lt;tns5:QTA_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='QTAAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:QTA_APPARATO>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALE']/valoreAttributo&quot;>&lt;tns5:CAUSALE>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALE']/valoreAttributo&quot;/>&lt;/tns5:CAUSALE>&lt;/xsl:if>&lt;/tns5:APPARATO>&lt;/xsl:for-each>&lt;/tns5:SERVIZIO_AGGIUNTIVO>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/lavorazione=('MIGRAZIONE','VARIAZIONE','CESSAZIONE') &amp;#xD;&amp;#xA;and $Start/tns1:RichiestaElement/offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB') &amp;#xD;&amp;#xA;and count($Oscuramento/Record[COD_AGESP= 'T1PRJ0002889'])=0 and exists($Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld)&quot;>&lt;tns5:SERVIZIO_OPZIONALI_OLD>&lt;tns5:CODICE_SERVIZIO>&lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:CodiceServizio&quot;/>&lt;/tns5:CODICE_SERVIZIO>&lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;>&lt;tns5:DESC_SERVIZIO>&lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DescServizio&quot;/>&lt;/tns5:DESC_SERVIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;>&lt;tns5:DATI_TECNICI>&lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:DatiTecnici&quot;/>&lt;/tns5:DATI_TECNICI>&lt;/xsl:if>&lt;xsl:if test=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;>&lt;tns5:VINCOLANTE_PER_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$Call_RecuperoAttributiAsset/ndm:ConsistenzaDati_Out/ndm:ServiziOpzionaliOld/ndm:VincolantePerEspletamento&quot;/>&lt;/tns5:VINCOLANTE_PER_ESPLETAMENTO>&lt;/xsl:if>&lt;/tns5:SERVIZIO_OPZIONALI_OLD>&lt;/xsl:if>&lt;/tns5:EVENTO_RICHIESTA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapRequestToDTU-input"
                    name="MapRequestToDTU"
                    outputVariable="MapRequestToDTU"
                    tibex:xpdlId="4adcbb06-5c9e-46d9-99b4-91d9d0637959" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToMapRequestToDTU"/>
                        <bpws:target linkName="Iterate1ToMapRequestToDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_MapRequestToDTUToCopy_1_LOG_MapRichiestaDTU"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Util/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO5.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_DtuMappingSub&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_DTU&quot;/>&#xa;    &lt;xsl:param name=&quot;SelNoteAltraLav&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckTestCivetta&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTLimite_Disaggregato&quot;/>&#xa;    &lt;xsl:param name=&quot;ResultDetokenizzazione&quot;/>&#xa;    &lt;xsl:param name=&quot;PAR_CFGZ_NOW&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferenteProgettiSpeciali&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta_Ordine_Cliente_Hash&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;ANAG_COW&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_RecuperoAttributiAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;MapRequestToDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:EVENTO_RICHIESTA>&#xa;            &lt;tns5:TESTATA>&#xa;                &lt;tns5:ID_RICHIESTA>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_DTU&quot;/>&#xa;                &lt;/tns5:ID_RICHIESTA>&#xa;                &lt;tns5:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns5:TRANSACTION_ID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaLavorazione = 'ACCENSIONE' or $Start/tns1:RichiestaElement/ordine/tipologiaLavorazione = 'SPEGNIMENTO'&quot;>&#xa;                        &lt;tns5:TIPOLOGIA_EVENTO>&#xa;                            &lt;xsl:value-of select=&quot;'EMISSIONE'&quot;/>&#xa;                        &lt;/tns5:TIPOLOGIA_EVENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:TIPOLOGIA_EVENTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns1:RequestType&quot;/>&#xa;                        &lt;/tns5:TIPOLOGIA_EVENTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:DATA_INVIO_RICHIESTA_DTU>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:DATA_INVIO_RICHIESTA_DTU>&#xa;                &lt;tns5:CODICE_ORDINE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns5:CODICE_ORDINE_OLO>&#xa;                &lt;tns5:CODICE_ORDINE_TI>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineTI&quot;/>&#xa;                &lt;/tns5:CODICE_ORDINE_TI>&#xa;                &lt;tns5:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns5:CODICE_OLO>&#xa;                &lt;tns5:CODICE_ISP>&#xa;                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/codificaOLONOW)&quot;/>&#xa;                &lt;/tns5:CODICE_ISP>&#xa;                &lt;tns5:DESCRIZIONE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Call_DtuMappingSub/ndm:EnrichAccesso/ndm:NomeOLO&quot;/>&#xa;                &lt;/tns5:DESCRIZIONE_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav = 'ATTIVAZIONE274'&quot;>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'ATTIVAZIONE274'&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario = ('CNPCRDAOLO','NPSUNPDEL82','NPDEL82')&quot;>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'NP' and $Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'NUMBERPORTABILITY']/attributiDettaglioOrdine[nomeAttributo = 'OLORETAILER']/valoreAttributo) > 0&quot;>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and $Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'NUMBERPORTABILITY']/attributiDettaglioOrdine[nomeAttributo = 'OLORETAILER']/valoreAttributo) > 0&quot;>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'CPS' and $Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE'&quot;>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:LAVORAZIONE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/lavorazione&quot;/>&#xa;                        &lt;/tns5:LAVORAZIONE_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:SISTEMA_SORGENTE>&#xa;                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                &lt;/tns5:SISTEMA_SORGENTE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/offerta = 'UBBSEMIGPON' and $Start/tns1:RichiestaElement/gestioneAutonoma = ('IS', 'OS'))&quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;>&#xa;                            &lt;tns5:CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;/>&#xa;                            &lt;/tns5:CODICE_PROGETTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;>&#xa;                    &lt;tns5:CODICE_DELIVERY>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;/>&#xa;                    &lt;/tns5:CODICE_DELIVERY>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:FLAG_NPD>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns5:FLAG_NPD>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'CAMPOSERVIZIOIT']/valoreAttributo&quot;>&#xa;                    &lt;tns5:CAMPO_SERVIZIO_IT>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'CAMPOSERVIZIOIT']/valoreAttributo&quot;/>&#xa;                    &lt;/tns5:CAMPO_SERVIZIO_IT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'ULLLINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'ULLDATILINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'SLULINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'VULAFTTH'&quot;>&#xa;                        &lt;tns5:SERVIZIO_IN_EOI>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/tns5:SERVIZIO_IN_EOI>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo&quot;>&#xa;                            &lt;tns5:MIGRAZIONE_INTRA_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:MIGRAZIONE_INTRA_OLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/rendezVous) and $Start/tns1:RichiestaElement/rendezVous = 'S'&quot;>&#xa;                    &lt;tns5:OPZIONE_SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;'RV'&quot;/>&#xa;                    &lt;/tns5:OPZIONE_SERVIZIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/nomeComponente)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/attributiDettaglioOrdine[nomeAttributo = 'CAUSALERIFIUTOFF']/valoreAttributo&quot;>&#xa;                            &lt;tns5:CAUSALERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/attributiDettaglioOrdine[nomeAttributo = 'CAUSALERIFIUTOFF']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:CAUSALERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/nomeComponente)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/attributiDettaglioOrdine[nomeAttributo = 'DESCRIZIONERIFIUTOFF']/valoreAttributo&quot;>&#xa;                            &lt;tns5:DESCRIZIONERIFIUTOFF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/attributiDettaglioOrdine[nomeAttributo = 'DESCRIZIONERIFIUTOFF']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:DESCRIZIONERIFIUTOFF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'ACCESSOSLU']/attributiDettaglioOrdine[nomeAttributo = 'RIPROGETTAZIONEONFIELD']/valoreAttributo) > 0&quot;>&#xa;                    &lt;tns5:RIPROGETTAZIONE_ONFIELD>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/tns5:RIPROGETTAZIONE_ONFIELD>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;(exists($Start/tns1:RichiestaElement/cambioTecnologia) and $Start/tns1:RichiestaElement/cambioTecnologia = 'S') or ($Start/tns1:RichiestaElement/lavorazione=('ATTIVAZIONE','CESSAZIONE') and $Start/tns1:RichiestaElement/codiceTrasformazione='CCAMBIOTECNOLOGIA')&quot;>&#xa;                    &lt;tns5:CAMBIO_TECNOLOGIA>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/tns5:CAMBIO_TECNOLOGIA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DESOSPENSIONEOLO']/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DESOSPENSIONEOLO']/valoreAttributo&quot;>&#xa;                        &lt;tns5:DESOSP_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DESOSPENSIONEOLO']/valoreAttributo&quot;/>&#xa;                        &lt;/tns5:DESOSP_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/flagDelibera103= 'Y' and $Start/tns1:RichiestaElement/offerta = 'NP'&quot;>&#xa;                        &lt;tns5:DELIBERA_103>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns5:DELIBERA_103>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/flagDelibera103= 'N' and $Start/tns1:RichiestaElement/offerta = 'NP'&quot;/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])>0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($ANAG_COW/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$ANAG_COW/Record[1]/OPERATORE&quot;>&#xa;                                    &lt;tns5:CODICE_OLO_SECONDARIO>&#xa;                                        &lt;xsl:value-of select=&quot;$ANAG_COW/Record[1]/OPERATORE&quot;/>&#xa;                                    &lt;/tns5:CODICE_OLO_SECONDARIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/codOperatoreSecondario)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/codOperatoreSecondario&quot;>&#xa;                                    &lt;tns5:CODICE_OLO_SECONDARIO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codOperatoreSecondario&quot;/>&#xa;                                    &lt;/tns5:CODICE_OLO_SECONDARIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/codOperatoreSecondario)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;>&#xa;                                    &lt;tns5:CODICE_OLO_SECONDARIO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;/>&#xa;                                    &lt;/tns5:CODICE_OLO_SECONDARIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($Start/tns1:RichiestaElement/offerta,'FTTH') and ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' or $Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE')&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/codOperatoreSecondario)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;>&#xa;                                &lt;tns5:CODICE_OLO_SECONDARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codOperatoreSecondario&quot;/>&#xa;                                &lt;/tns5:CODICE_OLO_SECONDARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/modelServPerValidazioni)>0 and contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' ) or ($Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE'))&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidazioni&quot;>&#xa;                        &lt;tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidazioni&quot;/>&#xa;                        &lt;/tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' ) or ($Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE'))&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/descOperatoreSecondario)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/descOperatoreSecondario&quot;>&#xa;                                    &lt;tns5:DESCRIZIONE_OLO_SECONDARIO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/descOperatoreSecondario&quot;/>&#xa;                                    &lt;/tns5:DESCRIZIONE_OLO_SECONDARIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($ANAG_COW/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$ANAG_COW/Record[1]/OPERATORE&quot;>&#xa;                                    &lt;tns5:DESCRIZIONE_OLO_SECONDARIO>&#xa;                                        &lt;xsl:value-of select=&quot;$ANAG_COW/Record[1]/OPERATORE&quot;/>&#xa;                                    &lt;/tns5:DESCRIZIONE_OLO_SECONDARIO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and  count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRCOMMERCIALEINTRAOLO']/valoreAttributo) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRCOMMERCIALEINTRAOLO']/valoreAttributo&quot;>&#xa;                                    &lt;tns5:COWUGUALEOPSEC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRCOMMERCIALEINTRAOLO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:COWUGUALEOPSEC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/codiceSLAAssurance)>0 and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE'  and count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceSLAAssurance&quot;>&#xa;                        &lt;tns5:SLA_PREMIUM_ASSURANCE>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceSLAAssurance&quot;/>&#xa;                        &lt;/tns5:SLA_PREMIUM_ASSURANCE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/modelServPerValidOld)>0 and contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE') )&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidOld&quot;>&#xa;                        &lt;tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI_OLD>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidOld&quot;/>&#xa;                        &lt;/tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI_OLD>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo) > 0 and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or $Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' )&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo&quot;>&#xa;                        &lt;tns5:ONT_OP_IN_ASSET>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo&quot;/>&#xa;                        &lt;/tns5:ONT_OP_IN_ASSET>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R8K-25-0004'])=0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/flagIU&quot;>&#xa;                        &lt;tns5:FLAG_IU>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/flagIU&quot;/>&#xa;                        &lt;/tns5:FLAG_IU>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R8K-25-0004'])=0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineOF&quot;>&#xa;                        &lt;tns5:CODICE_ORDINE_OF>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineOF&quot;/>&#xa;                        &lt;/tns5:CODICE_ORDINE_OF>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns5:TESTATA>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType !='ANNULLAMENTO' and $Start/tns1:RichiestaElement/tipologiaScenario!='NPSUNPDEL82' and $Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;tns5:CLIENTE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/cognomeRagioneSociale) > 0&quot;>&#xa;                            &lt;tns5:COGNOME>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&#xa;                            &lt;/tns5:COGNOME>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:COGNOME>&#xa;                                &lt;xsl:value-of select=&quot;' '&quot;/>&#xa;                            &lt;/tns5:COGNOME>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns5:NOME>&#xa;                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/nome, 1, 30)&quot;/>&#xa;                    &lt;/tns5:NOME>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/CF) > 0 and (not(string-length($Start/tns1:RichiestaElement/ordine/PIVA) >0) or $Start/tns1:RichiestaElement/ordine/PIVA='0' or string(number($Start/tns1:RichiestaElement/ordine/PIVA)) = 'NaN')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string(number($Start/tns1:RichiestaElement/ordine/CF)) !='NaN' and (not(string-length($Start/tns1:RichiestaElement/ordine/PIVA) >0))&quot;>&#xa;                                    &lt;tns5:CODICE_FISCALE>&#xa;                                        &lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:RichiestaElement/ordine/CF, 16, '0')&quot;/>&#xa;                                    &lt;/tns5:CODICE_FISCALE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:CODICE_FISCALE>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/CF, 1, 16)&quot;/>&#xa;                                    &lt;/tns5:CODICE_FISCALE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string(number($Start/tns1:RichiestaElement/ordine/PIVA)) !='NaN' and string-length($Start/tns1:RichiestaElement/ordine/PIVA) > 11&quot;>&#xa;                                    &lt;tns5:PARTITA_IVA>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/PIVA, 6, 11)&quot;/>&#xa;                                    &lt;/tns5:PARTITA_IVA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:PARTITA_IVA>&#xa;                                        &lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:RichiestaElement/ordine/PIVA, 11, '0')&quot;/>&#xa;                                    &lt;/tns5:PARTITA_IVA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede/tipologiaSede = 'SEDECLIENTE') and string-length(string($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/IDSede)) > 0&quot;>&#xa;                        &lt;tns5:INDIRIZZO_CLIENTE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/localita)&quot;>&#xa;                                    &lt;tns5:LOCALITA>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/localita, 1, 60)&quot;/>&#xa;                                    &lt;/tns5:LOCALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:LOCALITA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns5:LOCALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceISTATComune) > 0&quot;>&#xa;                                    &lt;tns5:CODICE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceISTATComune, 1, 10)&quot;/>&#xa;                                    &lt;/tns5:CODICE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:CODICE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns5:CODICE_COMUNE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns5:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:right($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceISTATComune, 3)&quot;/>&#xa;                            &lt;/tns5:ISTAT_COMUNE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/CAP) = 5&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/CAP&quot;>&#xa;                                        &lt;tns5:CAP>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/CAP&quot;/>&#xa;                                        &lt;/tns5:CAP>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/particellaToponomastica)&quot;>&#xa;                                    &lt;tns5:PARTICELLATOP>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/particellaToponomastica, 1, 20)&quot;/>&#xa;                                    &lt;/tns5:PARTICELLATOP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:PARTICELLATOP>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns5:PARTICELLATOP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/via)&quot;>&#xa;                                    &lt;tns5:VIA>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/via, 1, 70)&quot;/>&#xa;                                    &lt;/tns5:VIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:VIA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns5:VIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/civico)&quot;>&#xa;                                    &lt;tns5:CIVICO>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/civico, 1, 10)&quot;/>&#xa;                                    &lt;/tns5:CIVICO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:CIVICO>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/tns5:CIVICO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns5:COMPLESSO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/complesso, 1, 3)&quot;/>&#xa;                            &lt;/tns5:COMPLESSO>&#xa;                            &lt;tns5:SCALA>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/scala, 1, 2)&quot;/>&#xa;                            &lt;/tns5:SCALA>&#xa;                            &lt;tns5:PIANO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/piano, 1, 2)&quot;/>&#xa;                            &lt;/tns5:PIANO>&#xa;                            &lt;tns5:INTERNO>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tn