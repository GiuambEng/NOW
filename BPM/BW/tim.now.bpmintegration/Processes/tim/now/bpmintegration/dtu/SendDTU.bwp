&quot;>&#xa;                                                &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSAORIGINARIO']/valoreAttributo, 13))&quot;/>&#xa;                                                &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo) > 0&quot;>&#xa;                                                &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                                &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo) > 0&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo) > 13 and $Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOLINEA']/valoreAttributo = 'POTS'&quot;>&#xa;                                                        &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                            &lt;xsl:value-of select=&quot;substring(tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13)), 4)&quot;/>&#xa;                                                        &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo&quot;>&#xa;                                                            &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                                            &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaSottolav = 'PASSAGGIOULLD'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo) > 0&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo) > 13 and $Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOLINEA']/valoreAttributo = 'POTS'&quot;>&#xa;                                                        &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                            &lt;xsl:value-of select=&quot;substring(tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13)), 4)&quot;/>&#xa;                                                        &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo&quot;>&#xa;                                                            &lt;tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:trim(tib:left($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'IDRISORSANOW']/valoreAttributo, 13))&quot;/>&#xa;                                                            &lt;/tns5:ID_RISORSA_ORIGINARIO>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'RIENTRIDEL82' and $Start/tns1:RichiestaElement/tipologiaScenario='RIENTROD82FIBERSTREAM'&quot;>&#xa;                                &lt;tns5:SCENARIO_DTU>&#xa;                                    &lt;xsl:value-of select=&quot;'RIDEL82'&quot;/>&#xa;                                &lt;/tns5:SCENARIO_DTU>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'VARIAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'PASSAGGIOULLD'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo = 'SHACONMANODOPERA'&quot;>&#xa;                                        &lt;tns5:SCENARIO_DTU>&#xa;                                            &lt;xsl:value-of select=&quot;'ASHACM'&quot;/>&#xa;                                        &lt;/tns5:SCENARIO_DTU>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns5:SCENARIO_DTU>&#xa;                                            &lt;xsl:value-of select=&quot;'ASHASM'&quot;/>&#xa;                                        &lt;/tns5:SCENARIO_DTU>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='CESSAZIONE' and $Start/tns1:RichiestaElement/codiceTrasformazione='CCAMBIOTECNOLOGIA'&quot;/>&#xa;                            &lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/offerta='FIBERSTREAM' and not ($Start/tns1:RichiestaElement/lavorazione='CESSAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'USCITEDEL82')) or $Start/tns1:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA'&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Call_DtuMappingSub/ndm:EnrichAccesso/ndm:ScenarioDTU&quot;>&#xa;                                    &lt;tns5:SCENARIO_DTU>&#xa;                                        &lt;xsl:value-of select=&quot;$Call_DtuMappingSub/ndm:EnrichAccesso/ndm:ScenarioDTU&quot;/>&#xa;                                    &lt;/tns5:SCENARIO_DTU>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;($Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE_DAC' or $Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE') and ($Start/tns1:RichiestaElement/offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/tns1:RichiestaElement/offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/tns1:RichiestaElement/offerta = 'BITSTREAMGBESIMMETRICOFLAT')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;>&#xa;                                &lt;tns5:INFO_UTILI_TI>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;/>&#xa;                                &lt;/tns5:INFO_UTILI_TI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;($Start/tns1:RichiestaElement/offerta = 'BITSTREAMATMSIMMETRICOFLAT' or $Start/tns1:RichiestaElement/offerta = 'BITSTREAMATMSIMMETRICOHL' or $Start/tns1:RichiestaElement/offerta = 'BITSTREAMGBESIMMETRICOFLAT') and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DATADISPONIBILITASEDE']/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns5:DATA_DISP_LOC>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DATADISPONIBILITASEDE']/valoreAttributo, 7, 4), '-', substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DATADISPONIBILITASEDE']/valoreAttributo, 4, 2), '-', substring($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'DATADISPONIBILITASEDE']/valoreAttributo, 1, 2))&quot;/>&#xa;                            &lt;/tns5:DATA_DISP_LOC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;>&#xa;                                &lt;tns5:FLAG_MARCAGGIO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                &lt;/tns5:FLAG_MARCAGGIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='PROPRIETAMATERIALE']/valoreAttributo)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='PROPRIETAMATERIALE']/valoreAttributo&quot;>&#xa;                                &lt;tns5:PROPRIETA_MATERIALE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='PROPRIETAMATERIALE']/valoreAttributo&quot;/>&#xa;                                &lt;/tns5:PROPRIETA_MATERIALE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGEQUIVALENZAPRODOTTI']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGEQUIVALENZAPRODOTTI']/valoreAttributo&quot;>&#xa;                                    &lt;tns5:EQUIVALENZA_PRODOTTI_APPLICABILE>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGEQUIVALENZAPRODOTTI']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:EQUIVALENZA_PRODOTTI_APPLICABILE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulata))>0&quot;>&#xa;                                &lt;tns5:DATA_PREV_ATT>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&#xa;                                &lt;/tns5:DATA_PREV_ATT>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DAC))>0&quot;>&#xa;                                &lt;tns5:DATA_PREV_ATT>&#xa;                                    &lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&#xa;                                &lt;/tns5:DATA_PREV_ATT>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType='ATTIVATO_OK' or $Start/tns1:RichiestaElement/lavorazione= 'CESSAZIONE'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/idRisorsaOpenFiber&quot;>&#xa;                                &lt;tns5:ID_RISORSA_OF>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/idRisorsaOpenFiber&quot;/>&#xa;                                &lt;/tns5:ID_RISORSA_OF>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'OFDATITECNICI')]/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;>&#xa;                            &lt;tns5:REMOTE_ID_OF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'OFDATITECNICI')]/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns5:REMOTE_ID_OF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CLUSTER']/valoreAttributo) and count($Oscuramento/Record[COD_AGESP= 'R1I-25-0147'])=0 and $Start/tns1:RichiestaElement/lavorazione=('ATTIVAZIONE','MIGRAZIONE','VARIAZIONE','CESSAZIONE') and $Start/tns1:RichiestaElement/offerta=('EASYIPNGAFTTH', 'EASYIPNGAFTTCAB','SEMIEASYIPNGAFTTH')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CLUSTER']/valoreAttributo&quot;>&#xa;                                &lt;tns5:CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CLUSTER']/valoreAttributo&quot;/>&#xa;                                &lt;/tns5:CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns5:DATI_ACCESSO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$Call_DtuMappingSub/ndm:SERVIZIO_FONIA/tns5:SERVIZIO_FONIA&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$Call_DtuMappingSub/ndm:SERVIZIO_DATI/tns5:SERVIZIO_DATI&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;(string-length($Start/tns1:RichiestaElement/disaggregato)>0 or $Start/tns1:RichiestaElement/gestioneAutonoma=('IS','OS')) and $Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&#xa;                &lt;tns5:DISAGGREGAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/disaggregato!='S' or not(exists($Start/tns1:RichiestaElement/disaggregato)) or string-length($Start/tns1:RichiestaElement/disaggregato)=0&quot;/>&#xa;                        &lt;xsl:when test=&quot;(count($Oscuramento/Record[COD_AGESP='R1I-19-0350'])>0 and $Start/tns1:RichiestaElement/disaggregato = 'S') or (tib:compare-dateTime($DataCreazioneRichiesta/Record[1]/CREATED, $DTLimite_Disaggregato)&amp;lt;1 and  $Start/tns1:RichiestaElement/disaggregato = 'S')&quot;>&#xa;                            &lt;tns5:DISAGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                            &lt;/tns5:DISAGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/disaggregato = 'S' and (exists($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD']) or (exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo) and $Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo=('OP','SU')) or exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='PRESTAZIONIAGGIUNTIVE']))&quot;>&#xa;                            &lt;tns5:DISAGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'DC'&quot;/>&#xa;                            &lt;/tns5:DISAGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:DISAGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'DS'&quot;/>&#xa;                            &lt;/tns5:DISAGGREGATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='OS'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAOPERATORE']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/t