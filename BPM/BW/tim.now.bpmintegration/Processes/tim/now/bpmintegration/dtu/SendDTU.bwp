aElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;>&lt;tns5:IMPRESA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;/>&lt;/tns5:IMPRESA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo&quot;>&lt;tns5:IMPRESA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'IMPRESAADCENTRALE']/valoreAttributo&quot;/>&lt;/tns5:IMPRESA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;>&lt;tns5:IMPRESA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo&quot;/>&lt;/tns5:IMPRESA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='OS'&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAOPERATORE']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;>&lt;tns5:NOTE_SU>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAOPERATORE']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;/>&lt;/tns5:NOTE_SU>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/gestioneAutonoma='IS'&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;>&lt;tns5:NOTE_SU>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'GESTIONEAUTONOMAIMPRESA']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;/>&lt;/tns5:NOTE_SU>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;>&lt;tns5:NOTE_SU>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'NOTESU']/valoreAttributo&quot;/>&lt;/tns5:NOTE_SU>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo) and exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'ATI']/valoreAttributo) and $Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'SYSTEMUNICO']/valoreAttributo=$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'DISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo = 'ATI']/valoreAttributo&quot;>&lt;tns5:ATI>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns5:ATI>&lt;/xsl:if>&lt;xsl:if te