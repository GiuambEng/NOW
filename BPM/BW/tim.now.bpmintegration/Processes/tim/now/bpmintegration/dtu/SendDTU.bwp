LIENTECERT']/codiceISTATProvincia) > 0&quot;>&lt;tns5:ISTAT_PROV>&lt;xsl:value-of select=&quot;tib:pad-front($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATProvincia, 3, '0')&quot;/>&lt;/tns5:ISTAT_PROV>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/siglaProvincia&quot;>&lt;tns5:SIGLA_PROV>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/siglaProvincia&quot;/>&lt;/tns5:SIGLA_PROV>&lt;/xsl:if>&lt;tns5:DESC_PROV>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/provincia, 1, 80)&quot;/>&lt;/tns5:DESC_PROV>&lt;tns5:ISTAT_VIA>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceVia, 1, 9)&quot;/>&lt;/tns5:ISTAT_VIA>&lt;/tns5:INDIRIZZO_CERT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE' or $Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE_DAD'&quot;>&lt;xsl:if test=&quot;$SelNoteAltraLav/Record[1]/NOTE&quot;>&lt;tns5:note>&lt;xsl:value-of select=&quot;$SelNoteAltraLav/Record[1]/NOTE&quot;/>&lt;/tns5:note>&lt;/xsl:if>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        &lt;!--RU_790 - Invio verso DTU campo Note da Richieste di tipo: Rimodulazione DA, Interruzione Sospensione -->&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;>&lt;tns5:note>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/noteCliente&quot;/>&lt;/tns5:note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/distretto&quot;>&lt;tns5:Distretto>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/distretto&quot;/>&lt;/tns5:Distretto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario='NPSUNPDEL82'&quot;/>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='ATTIVAZIONE' and $Start/tns1:RichiestaElement/offerta=('ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','SLULINEANONATTIVA','VULLLINEANONATTIVA') and $Start/tns1:Testata/tns1:RequestType='EMISSIONE'&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/DRO)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE' or $Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE DAC') and $Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'MIGRAZIONEDEL82'&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta=('UBBSEMIGPON','UBBFULLGPON')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulata)) >0 and string($Start/tns1:RichiestaElement/ordine/DACRimodulata)!=string($Start/tns1:RichiestaElement/ordine/DAC)&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/DAC)&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulataTemp)) >0&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulataTemp)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DACRimodulata)) >0&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DACRimodulata)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DAC)) >0&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'ATTIVAZIONE' and ($Start/tns1:RichiestaElement/tipologiaSottolav = 'ATTIVAZIONE274' or $Start/tns1:RichiestaElement/ordine/tipologiaSottolav = 'ATTIVAZIONE274') and not(exists($Start/tns1:RichiestaElement/ordine/DAC)) and not(exists($Start/tns1:RichiestaElement/ordine/DACRimodulata)) and exists($Start/tns1:RichiestaElement/DRO)&quot;>&lt;tns5:DAC>&lt;xsl:value-of select=&quot;string($DRO5/parameters/tns6:Response/tns6:outputDate)&quot;/>&lt;/tns5:DAC>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario='NPSUNPDEL82'&quot;/>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DAC)) > 0&quot;>&lt;tns5:DAC_OLO>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAC)&quot;/>&lt;/tns5:DAC_OLO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/tns1:RichiestaElement/ordine/DADRimodulata)) > 0&quot;>&lt;tns5:DAD>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DADRimodulata)&quot;/>&lt;/tns5:DAD>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns1:Testata/tns1:RequestType = 'EMISSIONE' or $Start/tns1:Testata/tns1:RequestType = 'DESOSPENSIONE') and string-length(string($Start/tns1:RichiestaElement/ordine/DAD)) > 0&quot;>&lt;tns5:DAD>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/ordine/DAD)&quot;/>&lt;/tns5:DAD>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and $Start/tns1:RichiestaElement/tipologiaSottolav = 'MIGRAZIONEDEL82'&quot;/>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE' and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav='MIGRAZIONEDEL82'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;08:30:00&amp;quot;)=0)&quot;>&lt;tns5:DAD_FASCIA_ORARIA>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns5:DAD_FASCIA_ORARIA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,'10:30:00')=0)&quot;>&lt;tns5:DAD_FASCIA_ORARIA>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns5:DAD_FASCIA_ORARIA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;13:00:00&amp;quot;)=0)&quot;>&lt;tns5:DAD_FASCIA_ORARIA>&lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&lt;/tns5:DAD_FASCIA_ORARIA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82) and (compare($Start/tns1:RichiestaElement/ordine/fasciaOraUltimoApptD82,&amp;quot;15:00:00&amp;quot;)=0)&quot;>&lt;tns5:DAD_FASCIA_ORARIA>&lt;xsl:value-of select=&quot;&amp;quot;04&amp;quot;&quot;/>&lt;/tns5:DAD_FASCIA_ORARIA>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/IDFasciaOraria&quot;>&lt;tns5:DAD_FASCIA_ORARIA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDFasciaOraria&quot;/>&lt;/tns5:DAD_FASCIA_ORARIA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaQualita&quot;>&lt;tns5:CODICE_QUALITA>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaQualita&quot;/>&lt;/tns5:CODICE_QUALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD']) or exists($ReferenteProgettiSpeciali/Record[1]/REFOAOPROGETTISPECIALI)&quot;>&lt;tns5:REFERENTEONFIELD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'])&quot;>&lt;tns5:RF_COGNOME>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/cognomeReferente, 1, 60)&quot;/>&lt;/tns5:RF_COGNOME>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:RF_COGNOME>&lt;xsl:value-of select=&quot;&amp;quot; &amp;quot;&quot;/>&lt;/tns5:RF_COGNOME>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:RF_NOME>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/nomeReferente, 1, 30)&quot;/>&lt;/tns5:RF_NOME>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoFissoReferente&quot;>&lt;tns5:RF_TELEFONO_FISSO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoFissoReferente&quot;/>&lt;/tns5:RF_TELEFONO_FISSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoMobileReferente&quot;>&lt;tns5:RF_TELEFONO_MOBILE>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/referente[tipoReferenteOrdine = 'REFERENTEONFIELD'][1]/telefonoMobileReferente&quot;/>&lt;/tns5:RF_TELEFONO_MOBILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ReferenteProgettiSpeciali/Record[1]/