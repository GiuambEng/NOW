;quot;]/valoreAttributo&quot;>&lt;ndm:AsNumber>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;ASNUMBER&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:AsNumber>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta=('FEEDER')&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPSESSIONE&amp;quot;]/valoreAttributo&quot;>&lt;ndm:IPSessione>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPSESSIONE&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:IPSessione>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta=('FEEDER')&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;TIPOCOS&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BANDA&amp;quot;]/valoreAttributo&quot;>&lt;ndm:BandaFeeder>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;TIPOCOS&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BANDA&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:BandaFeeder>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta=('VLANVULA') and nomeComponente = &amp;quot;RACCOLTAVLANVULA&amp;quot;&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTDHCPOPTION82&amp;quot;]/valoreAttributo&quot;>&lt;ndm:IntermediateAgentDhcp>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTDHCPOPTION82&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:IntermediateAgentDhcp>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta='CANALE'&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPMULTICAST&amp;quot;]/valoreAttributo&quot;>&lt;ndm:IPMulticast>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPMULTICAST&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:IPMulticast>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta='CANALE'&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPSORGENTE&amp;quot;]/valoreAttributo&quot;>&lt;ndm:IPSorgente>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;IPSORGENTE&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:IPSorgente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta='CANALE'&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CLLICENTRALE&amp;quot;]/valoreAttributo&quot;>&lt;ndm:ClliCentrale>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CLLICENTRALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ndm:ClliCentrale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../../offerta='FIBERSTREAM'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;../tipologiaSottolav='RIENTRIDEL82'&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVODELPOP']/valoreAttributo&quot;>&lt;ndm:identificativodelpop>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVODELPOP']/valoreAttributo&quot;/>&lt;/ndm:identificativodelpop>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;../sede[tipologiaSede='SEDECLIENTE']/identificativoDelPop&quot;>&lt;ndm:identificativodelpop>&lt;xsl:value-of select=&quot;../sede[tipologiaSede='SEDECLIENTE']/identificativoDelPop&quot;/>&lt;/ndm:identificativodelpop>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente= &amp;quot;FONIA&amp;quot;]&quot;>&lt;ndm:Linea>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&lt;ndm:NumeroTelefonico>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/ndm:NumeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='TIPONUMERAZIONE']/valoreAttributo&quot;>&lt;ndm:TipoNumerazione>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TIPONUMERAZIONE']/valoreAttributo&quot;/>&lt;/ndm:TipoNumerazione>&lt;/xsl:if>&lt;/ndm:Linea>&lt;/xsl:for-each>&lt;/ndm:Fonia_Dati>&lt;/xsl:for-each>&lt;/ndm:DTUMappingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.dtu.mapping.DTUMapping_sub" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_DtuMappingSub-input"
                    name="LOG_DtuMappingSub"
                    tibex:xpdlId="8e20ed58-d439-4f12-a09c-1a20725a1a69"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Call_DtuMappingSubToLOG_DtuMappingSub"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_DtuMappingSubToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_DtuMappingSubToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns9:RichiestaElement/lavorazione=&quot;ATTIVAZIONE&quot; and ($Start/ns9:RichiestaElement/tipologiaSottolav=&quot;ATTIVAZIONE274&quot; or $Start/ns9:RichiestaElement/ordine/tipologiaSottolav=&quot;ATTIVAZIONE274&quot;) and not(exists($Start/ns9:RichiestaElement/ordine/DAC)) and not(exists($Start/ns9:RichiestaElement/ordine/DACRimodulata)) and exists($Start/ns9:RichiestaElement/DRO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns9:RichiestaElement/lavorazione="ATTIVAZIONE" and ($Start/ns9:RichiestaElement/tipologiaSottolav="ATTIVAZIONE274" or $Start/ns9:RichiestaElement/ordine/tipologiaSottolav="ATTIVAZIONE274") and not(exists($Start/ns9:RichiestaElement/ordine/DAC)) and not(exists($Start/ns9:RichiestaElement/ordine/DACRimodulata)) and exists($Start/ns9:RichiestaElement/DRO)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_DtuMappingSub&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DtuMappingSub-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Out DtuMappingSub: &amp;quot;, $Start/tns1:RichiestaElement/IDRichiestaOLO, tib:render-xml($Call_DtuMappingSub, true(), true()))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ndm=&quot;http://www.tim.com/NOW/xsd/NOWtoDTU_Mapping/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Util/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Call_DtuMappingSub&quot;/>&lt;xsl:param name=&quot;DRO5&quot;/>&lt;xsl:param name=&quot;IdRichiestaOlo_DTU&quot;/>&lt;xsl:param name=&quot;SelNoteAltraLav&quot;/>&lt;xsl:param name=&quot;CheckTestCivetta&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;DataCreazioneRichiesta&quot;/>&lt;xsl:param name=&quot;DTLimite_Disaggregato&quot;/>&lt;xsl:param name=&quot;ResultDetokenizzazione&quot;/>&lt;xsl:param name=&quot;PAR_CFGZ_NOW&quot;/>&lt;xsl:param name=&quot;ReferenteProgettiSpeciali&quot;/>&lt;xsl:param name=&quot;Richiesta_Ordine_Cliente_Hash&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;ANAG_COW&quot;/>&lt;xsl:param name=&quot;Call_RecuperoAttributiAsset&quot;/>&lt;xsl:template name=&quot;MapRequestToDTU-input&quot; match=&quot;/&quot;>&lt;tns5:EVENTO_RICHIESTA>&lt;tns5:TESTATA>&lt;tns5:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$IdRichiestaOlo_DTU&quot;/>&lt;/tns5:ID_RICHIESTA>&lt;tns5:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns5:TRANSACTION_ID>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaLavorazione = 'ACCENSIONE' or $Start/tns1:RichiestaElement/ordine/tipologiaLavorazione = 'SPEGNIMENTO'&quot;>&lt;tns5:TIPOLOGIA_EVENTO>&lt;xsl:value-of select=&quot;'EMISSIONE'&quot;/>&lt;/tns5:TIPOLOGIA_EVENTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:TIPOLOGIA_EVENTO>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns1:RequestType&quot;/>&lt;/tns5:TIPOLOGIA_EVENTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:DATA_INVIO_RICHIESTA_DTU>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:DATA_INVIO_RICHIESTA_DTU>&lt;tns5:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns5:CODICE_ORDINE_OLO>&lt;tns5:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineTI&quot;/>&lt;/tns5:CODICE_ORDINE_TI>&lt;tns5:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/tns5:CODICE_OLO>&lt;tns5:CODICE_ISP>&lt;xsl:value-of select=&quot;string($Start/tns1:RichiestaElement/codificaOLONOW)&quot;/>&lt;/tns5:CODICE_ISP>&lt;tns5:DESCRIZIONE_OLO>&lt;xsl:value-of select=&quot;$Call_DtuMappingSub/ndm:EnrichAccesso/ndm:NomeOLO&quot;/>&lt;/tns5:DESCRIZIONE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/ordine/tipologiaSottolav = 'ATTIVAZIONE274'&quot;>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;'ATTIVAZIONE274'&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/tipologiaScenario = ('CNPCRDAOLO','NPSUNPDEL82','NPDEL82')&quot;>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'NP' and $Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'NUMBERPORTABILITY']/attributiDettaglioOrdine[nomeAttributo = 'OLORETAILER']/valoreAttributo) > 0&quot;>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = ('ULLLINEAATTIVANP','SLULINEAATTIVANP','ULLDATILINEAATTIVANP') and $Start/tns1:RichiestaElement/lavorazione = 'CESSAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'NUMBERPORTABILITY']/attributiDettaglioOrdine[nomeAttributo = 'OLORETAILER']/valoreAttributo) > 0&quot;>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'CPS' and $Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE'&quot;>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:LAVORAZIONE_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/lavorazione&quot;/>&lt;/tns5:LAVORAZIONE_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:SISTEMA_SORGENTE>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns5:SISTEMA_SORGENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns1:RichiestaElement/offerta = 'UBBSEMIGPON' and $Start/tns1:RichiestaElement/gestioneAutonoma = ('IS', 'OS'))&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;>&lt;tns5:CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceProgetto&quot;/>&lt;/tns5:CODICE_PROGETTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;>&lt;tns5:CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceDelivery&quot;/>&lt;/tns5:CODICE_DELIVERY>&lt;/xsl:if>&lt;tns5:FLAG_NPD>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns5:FLAG_NPD>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'CAMPOSERVIZIOIT']/valoreAttributo&quot;>&lt;tns5:CAMPO_SERVIZIO_IT>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'CAMPOSERVIZIOIT']/valoreAttributo&quot;/>&lt;/tns5:CAMPO_SERVIZIO_IT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/offerta = 'ULLLINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'ULLDATILINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'SLULINEANONATTIVA' or $Start/tns1:RichiestaElement/offerta = 'VULAFTTH'&quot;>&lt;tns5:SERVIZIO_IN_EOI>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns5:SERVIZIO_IN_EOI>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RichiestaElement/lavorazione = 'MIGRAZIONE' and string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo&quot;>&lt;tns5:MIGRAZIONE_INTRA_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = 'MIGRAZIONEINTRAOLO']/valoreAttributo&quot;/>&lt;/tns5:MIGRAZIONE_INTRA_OLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/tns1:RichiestaElement/rendezVous) and $Start/tns1:RichiestaElement/rendezVous = 'S'&quot;>&lt;tns5:OPZIONE_SERVIZIO>&lt;xsl:value-of select=&quot;'RV'&quot;/>&lt;/tns5:OPZIONE_SERVIZIO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = 'FFRIFIUTOACQUISITO']/nomeComponente)&quot;>&l