                        &lt;tns5:DESC_PROV>&#xa;                                &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/provincia, 1, 80)&quot;/>&#xa;                            &lt;/tns5:DESC_PROV>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;not($Start/tns1:RichiestaElement/offerta=('UBBSEMIGPON','UBBFULLGPON') and string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceEGON)>0)&quot;>&#xa;                                    &lt;tns5:ISTAT_VIA>&#xa;                                        &lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceVia, 1, 9)&quot;/>&#xa;                                    &lt;/tns5:ISTAT_VIA>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/offerta=('UBBSEMIGPON','UBBFULLGPON','FWAITALIA1GIGASARDEGNA') and string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceEGON)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceEGON&quot;>&#xa;                                    &lt;tns5:EGON>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTE']/codiceEGON&quot;/>&#xa;                                    &lt;/tns5:EGON>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns5:INDIRIZZO_CLIENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Testata/tns1:RequestType = 'RIMODULAZIONE_DAD'&quot;>&#xa;     