t;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/codiceSLAAssurance)>0 and $Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE'  and count($Oscuramento/Record[COD_AGESP= 'R1I-25-0151'])=0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceSLAAssurance&quot;>&lt;tns5:SLA_PREMIUM_ASSURANCE>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceSLAAssurance&quot;/>&lt;/tns5:SLA_PREMIUM_ASSURANCE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/modelServPerValidOld)>0 and contains($Start/tns1:RichiestaElement/offerta,'FTTH') and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or ($Start/tns1:RichiestaElement/lavorazione='VARIAZIONE') )&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidOld&quot;>&lt;tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI_OLD>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/modelServPerValidOld&quot;/>&lt;/tns5:MODELLO_SERVIZIO_PER_VALIDAZIONI_OLD>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo) > 0 and (($Start/tns1:RichiestaElement/ordine/tipologiaSottolav ='MIGRAZIONEDEL82' and $Start/tns1:RichiestaElement/lavorazione='MIGRAZIONE') or $Start/tns1:RichiestaElement/lavorazione='VARIAZIONE' )&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo&quot;>&lt;tns5:ONT_OP_IN_ASSET>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'ONTOPERATORE']/valoreAttributo&quot;/>&lt;/tns5:ONT_OP_IN_ASSET>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R8K-25-0004'])=0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/flagIU&quot;>&lt;tns5:FLAG_IU>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/flagIU&quot;/>&lt;/tns5:FLAG_IU>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP= 'R8K-25-0004'])=0&quot;>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineOF&quot;>&lt;tns5:CODICE_ORDINE_OF>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/codiceOrdineOF&quot;/>&lt;/tns5:CODICE_ORDINE_OF>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns5:TESTATA>&lt;xsl:if test=&quot;$Start/tns1:Testata/tns1:RequestType !='ANNULLAMENTO' and $Start/tns1:RichiestaElement/tipologiaScenario!='NPSUNPDEL82' and $Start/tns1:Testata/tns1:RequestType!='SBLOCCO' and $Start/tns1:Testata/tns1:RequestType!='ACQUISITO_OK' and $Start/tns1:Testata/tns1:RequestType!='ACCETTATO'&quot;>&lt;tns5:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/cognomeRagioneSociale) > 0&quot;>&lt;tns5:COGNOME>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&lt;/tns5:COGNOME>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:COGNOME>&lt;xsl:value-of select=&quot;' '&quot;/>&lt;/tns5:COGNOME>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:NOME>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/nome, 1, 30)&quot;/>&lt;/tns5:NOME>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/CF) > 0 and (not(string-length($Start/tns1:RichiestaElement/ordine/PIVA) >0) or $Start/tns1:RichiestaElement/ordine/PIVA='0' or string(number($Start/tns1:RichiestaElement/ordine/PIVA)) = 'NaN')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string(number($Start/tns1:Richie