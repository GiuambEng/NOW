                        <bpws:source linkName="PAR_CFGZ_NOWToLogDetoken">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($PAR_CFGZ_NOW/Record)>0 and exists($Start/ns9:RichiestaElement/ordine/referente[starts-with(telefonoFissoReferente,'kk') or starts-with(telefonoMobileReferente,'kk')])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($PAR_CFGZ_NOW/Record)>0 and exists($Start/ns9:RichiestaElement/ordine/referente[starts-with(telefonoFissoReferente,'kk') or starts-with(telefonoMobileReferente,'kk')])]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+579e25d3-e897-4035-8046-a664d219d0a3+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT VALORE_STRINGA&#xa;FROM PARAMETRI_CFGZ_NOW&#xa;WHERE CHIAVE='RECAPITI_DTU_TOKENIZZATI' AND NOME_PROCSO='DTU_RICHIESTA' AND VALORE_STRINGA='NO'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="VALORE_STRINGA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogDetoken-input"
                    name="LogDetoken"
                    tibex:xpdlId="31908fe7-e455-445c-9e8a-fe587bff2d13"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PAR_CFGZ_NOWToLogDetoken"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDetokenToGetLocalIP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDetoken-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Inizio Detokenizzazione Referenti'&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="def67ef9-b469-4411-8c66-d7344c6857df">
                <bpws:targets>
                    <bpws:target linkName="GetLocalIPToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToGenericLogger"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns9:RichiestaElement/ordine/referente[starts-with(telefonoFissoReferente,'kk') or starts-with(telefonoMobileReferente,'kk')]" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns9:RichiestaElement/ordine/referente[starts-with(telefonoFissoReferente,'kk') or starts-with(telefonoMobileReferente,'kk')])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns26:Iterate_Current_Element_referente"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogSecoloInputToCallSecolo" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallSecoloToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogSecoloOutputToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="231872c6-f8d2-4525-ac26-000d100c0863" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToGenericLogger"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns9:RichiestaElement/ordine/referente[starts-with(telefonoFissoReferente,'kk') or starts-with(telefonoMobileReferente,'kk')])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="56621559-a44f-4d85-909b-0ef3719f7dea">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogSecoloInput-input"
                                    name="LogSecoloInput"
                                    tibex:xpdlId="1d87ee28-7843-47ed-8731-a36d76aafe87"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogSecoloInputToCallSecolo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSecoloInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;starts-with($currentElement/telefonoFissoReferente,'kk')&quot;>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Chiamata a Secolo per token : ',$currentElement/telefonoFissoReferente)&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Chiamata a Secolo per token : ',$currentElement/telefonoMobileReferente)&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallSecolo-input"
                                    name="CallSecolo"
                                    outputVariable="CallSecolo"
                                    tibex:xpdlId="292b4788-c6cd-4338-a781-9b78af29d94a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogSecoloInputToCallSecolo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallSecoloToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns11=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&#xa;    &lt;xsl:template name=&quot;CallSecolo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:RequestDecode_token>&#xa;            &lt;tns10:CodificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns10:CodificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                &lt;tns10:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns10:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'EMISSDTU'&quot;/>&#xa;            &lt;/tns10:Funzione>&#xa;            &lt;tns10:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($Start/tns1:RichiestaElement/codiceOrdineOLO,string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns10:ChiaveRiferimento>&#xa;            &lt;tns10:Operatore>&#xa;                &lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&#xa;            &lt;/tns10:Operatore>&#xa;            &lt;xsl:if test=&quot;$GetLocalIP/tns11:IPAddress&quot;>&#xa;                &lt;tns10:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$GetLocalIP/tns11:IPAddress&quot;/>&#xa;                &lt;/tns10:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($currentElement/telefonoFissoReferente) and string-length($currentElement/telefonoFissoReferente)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$currentElement/telefonoFissoReferente&quot;>&#xa;                        &lt;tns10:Token>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns10:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$currentElement/telefonoMobileReferente&quot;>&#xa;                        &lt;tns10:Token>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns10:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns10:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.bpmintegration.secolo.CallSecoloDecode" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogSecoloOutput-input"
                                    name="LogSecoloOutput"
                                    tibex:xpdlId="461c242f-2328-40b1-81db-1299c737969e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallSecoloToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogSecoloOutputToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;CallSecolo&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSecoloOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SentRequestToDTU'&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTUPortType'&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'SendDTU'&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;tns8:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Response Secolo  : ',tib:render-xml($CallSecolo))&quot;/>&#xa;                &lt;/tns8:Message>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ResultDetokenizzazione"
                                    name="Result"
                                    outputVariable="ResultDetokenizzazione"
                                    tibex:xpdlId="99fc8868-5d74-440b-b039-35a6150fafc1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogSecoloOutputToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Util/&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallSecolo&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;ResultDetokenizzazione&quot;/>&#xa;    &lt;xsl:template name=&quot;ResultDetokenizzazione&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ResultDetokenizzazione>&#xa;            &lt;tns2:Esito>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/tns2:Esito>&#xa;            &lt;xsl:copy-of select=&quot;$ResultDetokenizzazione/tns2:ResultDetokenizzazione&quot;/>&#xa;            &lt;tns2:ResultDetokenizzazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($currentElement/telefonoFissoReferente) and string-length($currentElement/telefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$currentElement/telefonoFissoReferente&quot;>&#xa;                            &lt;tns2:Token>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/telefonoFissoReferente&quot;/>&#xa;                            &lt;/tns2:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$currentElement/telefonoMobileReferente&quot;>&#xa;                            &lt;tns2:Token>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/telefonoMobileReferente&quot;/>&#xa;                            &lt;/tns2:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$CallSecolo/tns10:N_Recap_Cliente&quot;>&#xa;                    &lt;tns2:TelefonoFisso>&#xa;                        &lt;xsl:value-of select=&quot;$CallSecolo/tns10:N_Recap_Cliente&quot;/>&#xa;                    &lt;/tns2:TelefonoFisso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CallSecolo/tns10:N_Recap_Cliente_ALT&quot;>&#xa;                    &lt;tns2:TelefonoMobile>&#xa;                        &lt;xsl:value-of select=&quot;$CallSecolo/tns10:N_Recap_Cliente_ALT&quot;/>&#xa;                    &lt;/tns2:TelefonoMobile>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:ResultDetokenizzazione>&#xa;        &lt;/tns2:ResultDetokenizzazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
