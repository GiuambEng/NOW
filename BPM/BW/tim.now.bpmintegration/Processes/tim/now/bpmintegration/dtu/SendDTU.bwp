uot;''&quot;/>&lt;/tns5:LOCALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune) > 0&quot;>&lt;tns5:CODICE_COMUNE>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune, 1, 10)&quot;/>&lt;/tns5:CODICE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:CODICE_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns5:CODICE_COMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune)&quot;>&lt;tns5:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tib:right($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/codiceISTATComune, 3)&quot;/>&lt;/tns5:ISTAT_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns5:ISTAT_COMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/CAP&quot;>&lt;tns5:CAP>&lt;xsl:value-of select=&quot;$Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/CAP&quot;/>&lt;/tns5:CAP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/particellaToponomastica)&quot;>&lt;tns5:PARTICELLATOP>&lt;xsl:value-of select=&quot;substring($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/particellaToponomastica, 1, 20)&quot;/>&lt;/tns5:PARTICELLATOP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:PARTICELLATOP>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns5:PARTICELLATOP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RichiestaElement/ordine/sede[tipologiaSede = 'SEDECLIENTECERT']/via)&quot;>&lt;tns5:VIA>&lt;xsl:value-of