                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;MapRichOLODetailNPNG-input&quot; match=&quot;/&quot;>&lt;tns:MappingCaseRequest>&#xa;                    &lt;!-- DN -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DN&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/DN&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                &lt;!-- RoutingNumber -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;ROUTINGNUMBER&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/RoutingNumber&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                            &lt;!-- CodiceDonor -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;CODICEOPERATOREDONOR&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/CodiceDonor&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                        &lt;!-- NoteAggiuntive -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NOTEAGGIUNTIVE&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/NoteAggiuntive&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                    &lt;!-- CODIFICAOLOAGCOMDONATING -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/CodiceDonating&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!-- DataSottoscrizioneContratto -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DSC&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/DataSottoscrizioneContratto&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!-- OpzioneTraffico -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;OPZIONETRAFFICO&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/OpzioneTraffico&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        &lt;!-- OraCutOver -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;ORACUTOVER&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/OraCutOver&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!-- DataCutOver -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DATACUTOVER&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/DataCutOver&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!-- CodiceProvisioning -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;CODICEPROVISIONING&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/CodiceProvisioning&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!-- NumeroBolletta -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NUMEROBOLLETTA&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/NumeroBolletta&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        &lt;!-- BimestreRiferimento -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;BIMESTRERIFERIMENTO&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/BimestreRiferimento&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!-- TipoPrestazione -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;TIPOPRESTAZIONE&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/TipoPrestazione&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!-- TipoNp -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;TIPONP&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/NPnonGeografica/TipoNp&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           