                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(ID_RICH_OLO) AS COUNTIDRICHOLO from RICH_ORDN_COMUNIC_NOTF&#xa;where ID_RICH_OLO = ?&#xa;and COD_TIPOLG_NOTF = 'AC'&#xa;and IDTPLG_DESTNRIO_NOTF = '3'&#xa;and CODFC_OLO_AGCOM = 'TLC'"
