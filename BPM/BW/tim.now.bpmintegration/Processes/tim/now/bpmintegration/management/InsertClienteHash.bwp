                    <bpws:targets>
                        <bpws:target linkName="InsertClienteToUpdateCliente_VariazioniCessazioni"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateClienteToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a66247c0-f5cf-4e27-8ef6-0964d667443f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RICH_ORDINE_CLIENTE_HASH&quot;/>&lt;xsl:template name=&quot;UpdateCliente-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/Lavorazione = 'VARIAZIONE'&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Start/IDAssetVariati&quot;>&lt;xsl:if test=&quot;count($RICH_ORDINE_CLIENTE_HASH/Record)>0&quot;>&lt;Record>&lt;COGNOMEHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COGNOMEHASH>&lt;NOMEHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/NOME_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/NOME_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOMEHASH>&lt;CFHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/CODICE_FISCALE_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/CODICE_FISCALE_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CFHASH>&lt;PIVAHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/PARTITA_IVA_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/PARTITA_IVA_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PIVAHASH>&lt;IDASSET>&lt;xsl:value-of select=&quot;xsd:integer(.)&quot;/>&lt;/IDASSET>&lt;/Record>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Start/IDAssetCessati&quot;>&lt;xsl:if test=&quot;count($RICH_ORDINE_CLIENTE_HASH/Record)>0&quot;>&lt;Record>&lt;COGNOMEHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/COGNOME_RAGIONE_SOCIALE_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COGNOMEHASH>&lt;NOMEHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/NOME_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/NOME_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOMEHASH>&lt;CFHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/CODICE_FISCALE_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/CODICE_FISCALE_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CFHASH>&lt;PIVAHASH>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RICH_ORDINE_CLIENTE_HASH/Record[1]/PARTITA_IVA_HASH)&quot;>&lt;xsl:value-of select=&quot;$RICH_ORDINE_CLIENTE_HASH/Record[1]/PARTITA_IVA_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PIVAHASH>&lt;IDASSET>&lt;xsl:value-of select=&quot;xsd:integer(.)&quot;/>&lt;/IDASSET>&lt;/Record>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.CLIENTE_HASH&#xa;  SET COGNOME_RAGIONE_SOCIALE_HASH = ?, NOME_HASH = ?, CODICE_FISCALE_HASH = ?, PARTITA_IVA_HASH = ?, TIMESTAMP_AGGIORNAMENTO = SYSDATE&#xa;  WHERE IDENTIFICATIVO_ASSET = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COGNOMEHASH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMEHASH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CFHASH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PIVAHASH"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEnd-input"
                    name="LogEnd"
                    tibex:xpdlId="60f6f529-b5f5-4a27-9d9e-563d6330f0ed"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateClienteToGenericLogger"/>
                        <bpws:target linkName="InsertClienteToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;InsertCliente&quot;/>&lt;xsl:param name=&quot;UpdateCliente&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;InsertClienteHash&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;InsertClienteHashPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InsertClienteHash&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(($Start/Lavorazione = 'VARIAZIONE' and count($Start/IDAssetVariati)>0) or ($Start/Lavorazione = 'CESSAZIONE' and count($Start/IDAssetCessati)>0)) and not($Start/CanaleRichiesta = 'INTERNAL')&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Effettuato sia Insert che Update Cliente'&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Effettuata Insert Cliente'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(($Start/Lavorazione = 'VARIAZIONE' and count($Start/IDAssetVariati)>0) or ($Start/Lavorazione = 'CESSAZIONE' and count($Start/IDAssetCessati)>0)) and not($Start/CanaleRichiesta = 'INTERNAL')&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;InsertCliente n: &amp;quot;,xsd:string($InsertCliente/noOfUpdates),&amp;quot; Update Cliente n: &amp;quot;,xsd:string($UpdateCliente/noOfUpdates))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;InsertCliente n: &amp;quot;,xsd:string($InsertCliente/noOfUpdates))&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
