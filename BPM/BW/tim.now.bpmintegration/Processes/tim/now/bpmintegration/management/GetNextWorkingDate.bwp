                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://services.dac.n2.tibco.com/BusinessDeadlineService_1.7.0" xmlns:ns="http://deadline.api.dac.n2.tibco.com" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="DurationNEW"/&gt;
    &lt;xsl:param name="calcNextUsefulDate"/&gt;
    &lt;xsl:param name="nomeCalendario"/&gt;
    &lt;xsl:template name="calcDeadlineDateByWorkingDay-input" match="/"&gt;
        &lt;tns:calcDeadlineRequest&gt;
            &lt;parameters&gt;
                &lt;ns:calcDeadline&gt;
                    &lt;xsl:attribute name="duration"&gt;
                        &lt;xsl:value-of select="xsd:dayTimeDuration($DurationNEW)"/&gt;
                    &lt;/xsl:attribute&gt;
                    &lt;xsl:attribute name="start-date-time"&gt;
                        &lt;xsl:value-of select="dateTime(xsd:date(tib:left(string($calcNextUsefulDate/parameters/tns1:calcNextUsefulDate/tns1:inputDate), 10)), xsd:time(&amp;quot;04:00:00&amp;quot;))"/&gt;
                    &lt;/xsl:attribute&gt;
                    &lt;calendar-lookup&gt;
                        &lt;calendar-ref&gt;
                            &lt;xsl:value-of select="$nomeCalendario"/&gt;
                        &lt;/calendar-ref&gt;
                    &lt;/calendar-lookup&gt;
                &lt;/ns:calcDeadline&gt;
            &lt;/parameters&gt;
        &lt;/tns:calcDeadlineRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
