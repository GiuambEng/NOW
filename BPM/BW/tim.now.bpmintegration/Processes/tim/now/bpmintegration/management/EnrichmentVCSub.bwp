                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectProfiloVC&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:EnrichmentVC_Response>&lt;xsl:for-each select=&quot;$SelectProfiloVC/Record&quot;>&lt;tns:EnrichmentVCResponse>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;xsd:int(ID_PRFL_VC)&quot;/>&lt;/tns:IdProfiloVC>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(MCR_DOWN)=MCR_DOWN&quot;>&lt;tns:MCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(MCR_DOWN)&quot;/>&lt;/tns:MCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;MCR_DOWN&quot;>&lt;tns:MCRDOWN>&lt;xsl:value-of select=&quot;MCR_DOWN&quot;/>&lt;/tns:MCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(MCR_UP)=MCR_UP&quot;>&lt;tns:MCRUP>&lt;xsl:value-of select=&quot;xsd:int(MCR_UP)&quot;/>&lt;/tns:MCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;MCR_UP&quot;>&lt;tns:MCRUP>&lt;xsl:value-of select=&quot;MCR_UP&quot;/>&lt;/tns:MCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(PCR_DOWN)=PCR_DOWN&quot;>&lt;tns:PCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(PCR_DOWN)&quot;/>&lt;/tns:PCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;PCR_DOWN&quot;>&lt;tns:PCRDOWN>&lt;xsl:value-of select=&quot;PCR_DOWN&quot;/>&lt;/tns:PCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(PCR_UP)=PCR_UP&quot;>&lt;tns:PCRUP>&lt;xsl:value-of select=&quot;xsd:int(PCR_UP)&quot;/>&lt;/tns:PCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;PCR_UP&quot;>&lt;tns:PCRUP>&lt;xsl:value-of select=&quot;PCR_UP&quot;/>&lt;/tns:PCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(SCR_DOWN)=SCR_DOWN&quot;>&lt;tns:SCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(SCR_DOWN)&quot;/>&lt;/tns:SCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;SCR_DOWN&quot;>&lt;tns:SCRDOWN>&lt;xsl:value-of select=&quot;SCR_DOWN&quot;/>&lt;/tns:SCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(SCR_UP)=SCR_UP&quot;>&lt;tns:SCRUP>&lt;xsl:value-of select=&quot;xsd:int(SCR_UP)&quot;/>&lt;/tns:SCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;SCR_UP&quot;>&lt;tns:SCRUP>&lt;xsl:value-of select=&quot;SCR_UP&quot;/>&lt;/tns:SCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:EnrichmentVCResponse>&lt;/xsl:for-each>&lt;/tns:EnrichmentVC_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
