                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b148004a-6aa1-4b70-8283-d5feb6e9e802+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;SelectProfiloVC-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_PRFL_VC>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:EnrichmentVCRequest[number($index)]/tns1:IdProfiloVC)&quot;/>&lt;/ID_PRFL_VC>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ID_PRFL_VC, MCR_DOWN,MCR_UP,PCR_DOWN,PCR_UP,SCR_DOWN,SCR_UP&#xd;&#xa;from PROFILO_VC&#xd;&#xa;WHERE ID_PRFL_VC =?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PRFL_VC"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectProfiloVC&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:EnrichmentVC_Response>&lt;xsl:for-each select=&quot;$SelectProfiloVC/Record&quot;>&lt;tns:EnrichmentVCResponse>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;xsd:int(ID_PRFL_VC)&quot;/>&lt;/tns:IdProfiloVC>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(MCR_DOWN)=MCR_DOWN&quot;>&lt;tns:MCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(MCR_DOWN)&quot;/>&lt;/tns:MCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;MCR_DOWN&quot;>&lt;tns:MCRDOWN>&lt;xsl:value-of select=&quot;MCR_DOWN&quot;/>&lt;/tns:MCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(MCR_UP)=MCR_UP&quot;>&lt;tns:MCRUP>&lt;xsl:value-of select=&quot;xsd:int(MCR_UP)&quot;/>&lt;/tns:MCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;MCR_UP&quot;>&lt;tns:MCRUP>&lt;xsl:value-of select=&quot;MCR_UP&quot;/>&lt;/tns:MCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(PCR_DOWN)=PCR_DOWN&quot;>&lt;tns:PCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(PCR_DOWN)&quot;/>&lt;/tns:PCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;PCR_DOWN&quot;>&lt;tns:PCRDOWN>&lt;xsl:value-of select=&quot;PCR_DOWN&quot;/>&lt;/tns:PCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(PCR_UP)=PCR_UP&quot;>&lt;tns:PCRUP>&lt;xsl:value-of select=&quot;xsd:int(PCR_UP)&quot;/>&lt;/tns:PCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;PCR_UP&quot;>&lt;tns:PCRUP>&lt;xsl:value-of select=&quot;PCR_UP&quot;/>&lt;/tns:PCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(SCR_DOWN)=SCR_DOWN&quot;>&lt;tns:SCRDOWN>&lt;xsl:value-of select=&quot;xsd:int(SCR_DOWN)&quot;/>&lt;/tns:SCRDOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;SCR_DOWN&quot;>&lt;tns:SCRDOWN>&lt;xsl:value-of select=&quot;SCR_DOWN&quot;/>&lt;/tns:SCRDOWN>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;floor(SCR_UP)=SCR_UP&quot;>&lt;tns:SCRUP>&lt;xsl:value-of select=&quot;xsd:int(SCR_UP)&quot;/>&lt;/tns:SCRUP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;SCR_UP&quot;>&lt;tns:SCRUP>&lt;xsl:value-of select=&quot;SCR_UP&quot;/>&lt;/tns:SCRUP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:EnrichmentVCResponse>&lt;/xsl:for-each>&lt;/tns:EnrichmentVC_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="edfd20c5-9814-4093-8041-8cf6039b6cd7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
