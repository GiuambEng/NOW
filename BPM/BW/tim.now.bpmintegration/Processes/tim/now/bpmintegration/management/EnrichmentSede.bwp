        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="583b73d7-2b3b-430c-9a29-351a6508b714"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_EnrichSede&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Select_EnrichSede/Record) > 0&quot;>&lt;tns:EnrichmentSede_Response>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;tns:CodISTATComune>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/tns:CodISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_COMUNE&quot;>&lt;tns:DescrComune>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_COMUNE&quot;/>&lt;/tns:DescrComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_PARTICELLA_TOPON&quot;>&lt;tns:DescrParticellaToponomastica>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns:DescrParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_VIA&quot;>&lt;tns:DescrVia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_VIA&quot;/>&lt;/tns:DescrVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/NUMERO_CIVICO&quot;>&lt;tns:NumeroCivico>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/NUMERO_CIVICO&quot;/>&lt;/tns:NumeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/SIGLA_PROV&quot;>&lt;tns:SiglaProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/SIGLA_PROV&quot;/>&lt;/tns:SiglaProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_PROV&quot;>&lt;tns:CodiceISTATProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_PROV&quot;/>&lt;/tns:CodiceISTATProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_PROV&quot;>&lt;tns:DescrProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_PROV&quot;/>&lt;/tns:DescrProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DR&quot;>&lt;tns:DR>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DR&quot;/>&lt;/tns:DR>&lt;/xsl:if>&lt;tns:CodVia>&lt;xsl:value-of select=&quot;xsd:int($Select_EnrichSede/Record[1]/COD_VIA)&quot;/>&lt;/tns:CodVia>&lt;/tns:EnrichmentSede_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:EnrichmentSede_Response/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="ced8c5d1-b5fa-4c8e-8fc9-c1bb3bea46fa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_EnrichSede&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Select_EnrichSede/Record) > 0&quot;>&lt;tns:EnrichmentSede_Response>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;tns:CodISTATComune>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/tns:CodISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_COMUNE&quot;>&lt;tns:DescrComune>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_COMUNE&quot;/>&lt;/tns:DescrComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_PARTICELLA_TOPON&quot;>&lt;tns:DescrParticellaToponomastica>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns:DescrParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_VIA&quot;>&lt;tns:DescrVia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_VIA&quot;/>&lt;/tns:DescrVia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/NUMERO_CIVICO&quot;>&lt;tns:NumeroCivico>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/NUMERO_CIVICO&quot;/>&lt;/tns:NumeroCivico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/SIGLA_PROV&quot;>&lt;tns:SiglaProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/SIGLA_PROV&quot;/>&lt;/tns:SiglaProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_PROV&quot;>&lt;tns:CodiceISTATProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/COD_ISTAT_PROV&quot;/>&lt;/tns:CodiceISTATProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DESCR_PROV&quot;>&lt;tns:DescrProvincia>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DESCR_PROV&quot;/>&lt;/tns:DescrProvincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_EnrichSede/Record[1]/DR&quot;>&lt;tns:DR>&lt;xsl:value-of select=&quot;$Select_EnrichSede/Record[1]/DR&quot;/>&lt;/tns:DR>&lt;/xsl:if>&lt;tns:CodVia>&lt;xsl:value-of select=&quot;xsd:int($Select_EnrichSede/Record[1]/COD_VIA)&quot;/>&lt;/tns:CodVia>&lt;/tns:EnrichmentSede_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:EnrichmentSede_Response/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4ec4c293-21b6-4885-bd61-6a829b50a764+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Select_EnrichSede-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodiceToponomastica>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceToponomastica&quot;/>&lt;/CodiceToponomastica>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Select_EnrichSede-input"
                    name="Select_EnrichSede"
                    outputVariable="Select_EnrichSede"
                    tibex:xpdlId="4ec4c293-21b6-4885-bd61-6a829b50a764" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4ec4c293-21b6-4885-bd61-6a829b50a764+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Select_EnrichSede-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodiceToponomastica>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceToponomastica&quot;/>&lt;/CodiceToponomastica>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NC.CAP, NC.NUMERO_CIVICO, NC.DR, P.DESCR_PARTICELLA_TOPON, VIA.DESCR_VIA, VIA.COD_ISTAT_COMUNE, VIA.COD_VIA, COLO.DESCR_COMUNE,&#xd;&#xa;  PROV.DESCR_PROV, PROV.SIGLA_PROV, PROV.COD_ISTAT_PROV&#xd;&#xa;FROM  NUMERO_CIVICO NC, PARTICELLA P, VIA, COMUNE_O_LOCALITA COLO, PROV&#xd;&#xa;WHERE NC.COD_TOPON = ? &#xd;&#xa;AND NC.COD_STRADA = VIA.COD_STRADA&#xd;&#xa;AND VIA.COD_PARTICELLA_TOPON = P.COD_PARTICELLA_TOPON&#xd;&#xa;AND VIA.COD_COMUNE = COLO.COD_COMUNE&#xd;&#xa;AND COLO.COD_PROV = PROV.COD_PROV" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceToponomastica"/>
                                    <columnMetadata columnName="CAP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_CIVICO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_PARTICELLA_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_VIA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_VIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SIGLA_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
