ating/NPAggiuntive/NumAggiuntivaPortata&quot;>&#xa;                        &lt;tns:MappingCaseRequest>&#xa;                            &lt;tns:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:ID_RICH_OLO>&#xa;                            &lt;tns:IDTPLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                            &lt;/tns:IDTPLG_DATO_RICH>&#xa;                            &lt;tns:NOME>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DISTRETTO&amp;quot;&quot;/>&#xa;                            &lt;/tns:NOME>&#xa;                            &lt;tns:NOTE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:Note&quot;/>&#xa;                            &lt;/tns:NOTE>&#xa;                            &lt;tns:OPERATORE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:Operatore&quot;/>&#xa;                            &lt;/tns:OPERATORE>&#xa;                            &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;tns:TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_AGGTO>&#xa;                            &lt;tns:TIMSTP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;substring(., 2, 1) = &amp;quot;6&amp;quot; or substring(., 2, 1) = &amp;quot;2&amp;quot;&quot;>&#xa;                                    &lt;tns:VALORE>&