                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/transformxml&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichOLODettNPIn&quot;/>&lt;xsl:template name=&quot;RemoveNamespace_NP_N-input&quot; match=&quot;/&quot;>&lt;tns:textInput>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;$RichOLODettNPIn/input/ns:RichOLODettNP_Request/ns:ContenutoXML&quot;/>&lt;/tns:xmlString>&lt;/tns:textInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
