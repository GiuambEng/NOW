                    <bpws:targets>
                        <bpws:target linkName="RichOLODettNPInToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TransformXmlToCallProcess1_NPR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione='VALIDFORMALEDONATINGDONOR' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione='VALIDTECNICADONATINGDONOR' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione='VALIDTECNICACESSAZIONE' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione='RIMODULAZIONEDAC' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione='ESPLETAMENTODONORRECIPIENTDONATING'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$RichOLODettNPIn.input/ns3:Lavorazione='VALIDFORMALEDONATINGDONOR' or $RichOLODettNPIn.input/ns3:Lavorazione='VALIDTECNICADONATINGDONOR' or $RichOLODettNPIn.input/ns3:Lavorazione='VALIDTECNICACESSAZIONE' or $RichOLODettNPIn.input/ns3:Lavorazione='RIMODULAZIONEDAC' or $RichOLODettNPIn.input/ns3:Lavorazione='ESPLETAMENTODONORRECIPIENTDONATING']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TransformXmlToCallProcess_NPN">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione = 'PORTIN' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione = 'CESSAZIONE' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione = 'ANNULLAMENTO' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione = 'PRENOTIFICADONATING' or $RichOLODettNPIn/input/ns3:RichOLODettNP_Request/ns3:Lavorazione = 'ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$RichOLODettNPIn.input/ns3:Lavorazione = 'PORTIN' or $RichOLODettNPIn.input/ns3:Lavorazione = 'CESSAZIONE' or $RichOLODettNPIn.input/ns3:Lavorazione = 'ANNULLAMENTO' or $RichOLODettNPIn.input/ns3:Lavorazione = 'PRENOTIFICADONATING' or $RichOLODettNPIn.input/ns3:Lavorazione = 'ATTIVAZIONE']]></bpws:transitionCondition>
