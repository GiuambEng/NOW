      &lt;tns:TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_AGGTO>&#xa;                            &lt;tns:TIMSTP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_INSMTO>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/tns:MappingCaseRequest>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXml_NP_N/Richiesta/Cessazione/NPAggiuntive/NumAggiuntivaPortata&quot;>&#xa;                        &lt;tns:MappingCaseRequest>&#xa;                            &lt;tns:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:ID_RICH_OLO>&#xa;                            &lt;tns:IDTPLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                            &lt;/tns:IDTPLG_DATO_RICH>&#xa;                            &lt;tns:NOME>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DISTRETTO&amp;quot;&quot;/>&#xa;                            &lt;/tns:NOME>&#xa;                            &lt;tns:NOTE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:Note&quot;/>&#xa;                            &lt;/tns:NOTE>&#xa;                            &lt;tns:OPERATORE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNPIn.input/ns:Operatore&quot;/>&#xa;                            &lt;/tns:OPERATORE>&#xa;                            &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;tns:TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_AGGTO>&#xa;                            &lt;tns:TIMSTP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;substring(., 2, 1) = &amp;quot;6&amp;quot; or substring(., 2, 1) = &amp;quot;2&amp;quot;&quot;>&#xa;                                    &lt;tns:VALORE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(., 1, 2)&quot;/>&#xa;                                    &lt;/tns:VALORE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;substring(., 3, 1) = &amp;quot;0&amp;quot; or substring(., 3, 1) = &amp;quot;1&amp;quot; or substring(., 3, 1) = &amp;quot;5&amp;quot; or substring(., 3, 1) = &amp;quot;9&amp;quot;&quot;>&#xa;                                    &lt;tns:VALORE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(., 1, 3)&quot;/>&#xa;                                    &lt;/tns:VALORE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:VALORE>&#xa;                                        &lt;xsl:value-of select=&quot;substring(., 2, 4)&quot;/>&#xa;                                    &lt;/tns:VALORE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:MappingCaseRequest>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:MappingCaseReques