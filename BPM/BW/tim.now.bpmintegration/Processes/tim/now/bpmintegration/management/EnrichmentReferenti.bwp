                                    sqlStatement="SELECT PROGR_REFERENTE,&#xa;QUALIF_REFERENTE,&#xa;  COGN_REFERENTE,&#xa;  NOME_REFERENTE,&#xa;  TEL_FISSO_REFERENTE,&#xa;  TEL_MOBILE_REFERENTE, &#xa;  EMAIL_REFERENTE&#xa;FROM REFERENTE_SIMM_CRMWS &#xa; where ID_ASSET_CRMWS=?" xsi:type="jdbcPalette:JDBCQueryActivity">
