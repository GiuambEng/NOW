            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Offerta-input"
                    name="Offerta" outputVariable="Offerta"
                    tibex:xpdlId="8ab909eb-54d5-4946-8357-e4c6affaf121" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToOfferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OffertaToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ab909eb-54d5-4946-8357-e4c6affaf121+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Offerta-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/IDRICHIESTAOLO>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OFFERTA, LAVORAZIONE, CANALERICHIESTA, FLAGMIGDEL82,FLAGRIENTRIDEL82&#xa;  FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE IDRICHIESTAOLO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="CANALERICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="FLAGMIGDEL82"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="FLAGRIENTRIDEL82"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOfferta-input"
                    name="LogOfferta"
                    tibex:xpdlId="da5556b4-2a28-44a9-b3ab-861f0a693600"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OffertaToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToParseXml">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOffertaToRientriDel82">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Offerta/Record[1]/FLAGRIENTRIDEL82='SI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Offerta/Record[1]/FLAGRIENTRIDEL82='SI']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogOfferta-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;'tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;&amp;quot;RichOLODettOF&amp;quot;&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;&amp;quot;CasedataTrackingPortType&amp;quot;&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RichOLODettOF&amp;quot;&quot;/>&lt;/tns2:Operation>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Record trovato su Offerta Richiesta: &amp;quot;,tib:render-xml($Offerta,true(),true()))&quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Message>&lt;xsl:value-of select=&quot;'Record non trovato su Offerta Richiesta'&quot;/>&lt;/tns2:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="RientriDel82-input"
                    name="RientriDel82" outputVariable="RientriDel82"
                    tibex:xpdlId="875afd09-acfa-4d61-89f3-ac5b18f77efc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOffertaToRientriDel82"/>
