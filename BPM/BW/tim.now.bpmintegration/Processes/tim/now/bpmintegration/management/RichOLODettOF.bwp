                    <bpws:sources>
                        <bpws:source linkName="RientriDel82ToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RientriDel82-input&quot; match=&quot;/&quot;>&lt;ns:RichOLODettOF_Request>&lt;ns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/ns:IDRichiestaOLO>&lt;xsl:if test=&quot;$Start/ns:Note&quot;>&lt;ns:Note>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/ns:Note>&lt;/xsl:if>&lt;ns:Operatore>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/ns:Operatore>&lt;ns:ContenutoXML>&lt;xsl:value-of select=&quot;$Start/ns:ContenutoXML&quot;/>&lt;/ns:ContenutoXML>&lt;ns:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Start/ns:StrutturaRichiesta&quot;/>&lt;/ns:StrutturaRichiesta>&lt;ns:Lavorazione>&lt;xsl:value-of select=&quot;$Start/ns:Lavorazione&quot;/>&lt;/ns:Lavorazione>&lt;xsl:if test=&quot;$Start/ns:IDFile&quot;>&lt;ns:IDFile>&lt;xsl:value-of select=&quot;$Start/ns:IDFile&quot;/>&lt;/ns:IDFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:ProgrRichiestaFile&quot;>&lt;ns:ProgrRichiestaFile>&lt;xsl:value-of select=&quot;$Start/ns:ProgrRichiestaFile&quot;/>&lt;/ns:ProgrRichiestaFile>&lt;/xsl:if>&lt;/ns:RichOLODettOF_Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.management.RientriDel82" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
