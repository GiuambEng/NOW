                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettRicaricheIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlRicariche&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAccensione&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectSpegnimento_Annullamento&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProlungamento&quot;/>&#xa;    &lt;xsl:param name=&quot;CanaleRic&quot;/>&#xa;    &lt;xsl:template name=&quot;MapRichOLODetailRicariche-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATAINIZIORICARICA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CanaleRic/Record[1]/CANALERICHIESTA='B2B' and  exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string($ParseXmlRicariche/Richiesta/TipoAzione/Accensione/node()/TipologiaAccensioneRicarica)='NRT'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;minutes-from-dateTime(current-dateTime())>=00 and minutes-from-dateTime(current-dateTime())&amp;lt;=30&quot;>&#xa;                                        &lt;tns:VALORE>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime(current-dateTime()),month-from-dateTime(current-dateTime()),day-from-dateTime(current-dateTime()),hours-from-dateTime(current-dateTime()),30,0,0)&quot;/>&#xa;                                        &lt;/tns:VALORE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:VALORE>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime(current-dateTime()),month-from-dateTime(current-dateTime()),day-from-dateTime(current-dateTime()),hours-from-dateTime(current-dateTime())+1,0,0,0)&quot;/>&#xa;                                        &lt;/tns:VALORE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DataInizioRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/DATAINIZIO&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/node()/DataInizioRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATAINIZIORICARICADTU&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;string(tib:add-to-dateTime($ParseXmlRicariche/Richiesta/TipoAzione/Accensione/node()/DataInizioRicarica, 0, 0, 0, 0, xsd:int($SelectAccensione/Record[1]/VALORE_NUMERICO), 0))&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATAFINERICARICA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DataFineRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/DATAFINE&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/node()/DataFineRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSET&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/IDASSET&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/DatiRisorsa/IdAsset&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CODIFICAOLOAGCOM&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OFFERTA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectProlungamento/Record[1]/OFFERTA&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/OFFERTA&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;local-name($ParseXmlRicariche/Richiesta/TipoAzione/*[1]/*[1])&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIARICARICA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DatiProlungamento/TaglioRicaricaXDSL)>0&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DatiProlungamento/TaglioRicaricaXDSL&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DatiProlungamento/TaglioRicaricaNGA_VULA)>0&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DatiProlungamento/TaglioRicaricaNGA_VULA&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/TIPOLOGIARICARICA&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/node()/TaglioRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSETRICARICA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/IdRicarica&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:MappingCaseRequest>&#xa;            &lt;tns:MappingCaseRequest>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:IDTPLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;37&quot;/>&#xa;                &lt;/tns:IDTPLG_DATO_RICH>&#xa;                &lt;tns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIAACCENSIONERICARICA&amp;quot;&quot;/>&#xa;                &lt;/tns:NOME>&#xa;                &lt;tns:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Note&quot;/>&#xa;                &lt;/tns:NOTE>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn.input/ns:Operatore&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_INSMTO>&#xa;                &lt;xsl:choos