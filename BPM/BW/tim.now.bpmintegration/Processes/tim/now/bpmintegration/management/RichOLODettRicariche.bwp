   &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;tns1:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                    &lt;ns:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;tns1:VALORE&quot;/>&#xa;                    &lt;/ns:VALORE>&#xa;                &lt;/ns:RichOLODett_Response>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns:RichOLODettRicariche_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
