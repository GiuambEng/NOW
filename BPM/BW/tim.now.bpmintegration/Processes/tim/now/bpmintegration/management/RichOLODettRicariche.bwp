t;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/FAMIGLIAASSET&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Accensione/node()/TipologiaAccensioneRicarica&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;/tns:MappingCaseRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapRichOLODetailRicariche-input"
