                    outputVariable="MapRichOLODetailRicariche"
                    tibex:xpdlId="33e659bb-821d-4b13-b0d8-5340f10f3815" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapRichOLODetailRicariche1"/>
