                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectSpegnimento_Annullamento-input"
                    name="SelectSpegnimento_Annullamento"
                    outputVariable="SelectSpegnimento_Annullamento"
                    tibex:xpdlId="30147220-119a-4746-bf82-a0ec2592cdd1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseXmlRicaricheToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToMapRichOLODetailRicariche1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+30147220-119a-4746-bf82-a0ec2592cdd1+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlRicariche&quot;/>&lt;xsl:template name=&quot;SelectSpegnimento_Annullamento-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IdAsset>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/DatiRisorsa/IdAsset&quot;/>&lt;/IdAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento)&quot;>&lt;IdAssetRicarica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento/IdRicarica)&quot;>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento/IdRicarica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdAssetRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IdAssetRicarica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento/IdRicarica)&quot;>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Annullamento/IdRicarica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdAssetRicarica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AR.DATAINIZIO, AR.DATAFINE, AR.IDASSET, ASS.CODIFICAOLOAGCOM, AR.TIPOLOGIARICARICA, OFF.OFFERTA, AR.FAMIGLIAASSET&#xa;FROM BDS_1_CASEDATA_ASSETRICARICA AR&#xa;LEFT JOIN BDS_1_CASEDATA_ASSET ASS on AR.IDASSET=ASS.IDASSET&#xa;LEFT JOIN OFFERTA OFF on ASS.IDOFFERTA=OFF.ID_OFFERTA&#xa;WHERE AR.IDASSET = ? and AR.IDASSETRICARICA = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdAsset"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdAssetRicarica"/>
                                    <columnMetadata
                                    columnName="DATAINIZIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAFINE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5"
