            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlRicariche&quot;/>&lt;xsl:param name=&quot;RichOLODettRicaricheIn&quot;/>&lt;xsl:param name=&quot;SelectAccensione&quot;/>&lt;xsl:param name=&quot;SelectSpegnimento_Annullamento&quot;/>&lt;xsl:param name=&quot;SelectProlungamento&quot;/>&lt;xsl:param name=&quot;CanaleRic&quot;/>&lt;xsl:template name=&quot;MapRichOLODetailRicariche-input&quot; match=&quot;/&quot;>&lt;tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DATAINIZIORICARICA&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$CanaleRic/Record[1]/CANALERICHIESTA='B2B' and  exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string($ParseXmlRicariche/Richiesta/TipoAzione/Accensione/node()/TipologiaAccensioneRicarica)='NRT'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;minutes-from-dateTime(current-dateTime())>=00 and minutes-from-dateTime(current-dateTime())&amp;lt;=30&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime(current-dateTime()),month-from-dateTime(current-dateTime()),day-from-dateTime(current-dateTime()),hours-from-dateTime(current-dateTime()),30,0,0)&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime(current-dateTime()),month-from-dateTime(current-dateTime()),day-from-dateTime(current-dateTime()),hours-from-dateTime(current-dateTime())+1,0,0,0)&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DataInizioRicarica&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/DATAINIZIO&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/node()/DataInizioRicarica&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DATAINIZIORICARICADTU&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;string(tib:add-to-dateTime($ParseXmlRicariche/Richiesta/TipoAzione/Accensione/node()/DataInizioRicarica, 0, 0, 0, 0, xsd:int($SelectAccensione/Record[1]/VALORE_NUMERICO), 0))&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DATAFINERICARICA&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento/DataFineRicarica&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/DATAFINE&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/TipoAzione/node()/node()/DataFineRicarica&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSET&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/