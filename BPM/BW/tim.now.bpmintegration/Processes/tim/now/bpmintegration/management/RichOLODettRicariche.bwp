sl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/CODIFICAOLOAGCOM&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlRicariche/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;OFFERTA&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectProlungamento/Record[1]/OFFERTA&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Spegnimento) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Annullamento)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$SelectSpegnimento_Annullamento/Record[1]/OFFERTA&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlRicariche/Richiesta/TipoAzione/Accensione) or exists($ParseXmlRicariche/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;local-name($ParseXmlRicariche/Richiesta/TipoAzione/*[1]/*[1])&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;37&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIARICARICA&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRicaricheIn/input/ns:RichOLODettRicariche_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_I