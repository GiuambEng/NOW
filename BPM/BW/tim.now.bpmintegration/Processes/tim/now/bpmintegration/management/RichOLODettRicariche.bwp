            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectAccensione-input"
                    name="SelectAccensione"
                    outputVariable="SelectAccensione"
                    tibex:xpdlId="43bd346a-b1df-4bc6-b437-ed65e475576a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
