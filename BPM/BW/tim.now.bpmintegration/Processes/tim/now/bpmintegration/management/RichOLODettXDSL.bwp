                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettXDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_MapRichOLODetailXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Attivazione)&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaNonFonia) and exists($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:VC/ns0:ProfiloVC/ns0:ABR)&quot;>&#xa;                                &lt;tns:MappingCaseRequest>&#xa;                                    &lt;tns:MappingCaseRequest>&#xa;                                        &lt;tns:ID_RICH_OLO>&#xa;                                            &lt;xsl:value-of select=&quot;$RichOLODettXDSLIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                                        &lt;/tns:ID_RICH_OLO>&#xa;                                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                                            &lt;xsl:value-of select=&quot;9&quot;/>&#xa;                                        &lt;/tns: