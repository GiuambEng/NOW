                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettXDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDatiMigrazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione)&quot;>&#xa;                &lt;tns:MappingCaseRequest>&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettXDSLIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;22&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot; upper-case(local-name($ParseXmlXDSL/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione/ns0:CodiceRisorsa1))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettXDSLIn.input/ns:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettXDSLIn.input/ns:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#x