                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($EstrazioneOLO/Record)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EstrazioneOLOToThrow1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cefc3014-2a0f-42a0-8a32-f45cc2e11b62+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNumerazioneDonorOLOOperation.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoNormalizzato&quot;/>&#xa;    &lt;xsl:param name=&quot;Numero&quot;/>&#xa;    &lt;xsl:template name=&quot;EstrazioneOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTR>&#xa;                &lt;xsl:value-of select=&quot;$DistrettoNormalizzato&quot;/>&#xa;            &lt;/COD_DISTR>&#xa;            &lt;numero>&#xa;                &lt;xsl:value-of select=&quot;$Numero&quot;/>&#xa;            &lt;/numero>&#xa;            &lt;lunghezza_pad0>&#xa;                &lt;xsl:value-of select=&quot;string-length($Numero)&quot;/>&#xa;            &lt;/lunghezza_pad0>&#xa;            &lt;lunghezza_pad9>&#xa;                &lt;xsl:value-of select=&quot;string-length($Numero)&quot;/>&#xa;            &lt;/lunghezza_pad9>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaNumerazioneDonorOLOOperation.parameters/tns1:DATA_INVIO_RICH)&quot;>&#xa;                    &lt;Data>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNumerazioneDonorOLOOperation.parameters/tns1:DATA_INVIO_RICH)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNumerazioneDonorOLOOperation.parameters/tns1:DATA_INVIO_RICH&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;           