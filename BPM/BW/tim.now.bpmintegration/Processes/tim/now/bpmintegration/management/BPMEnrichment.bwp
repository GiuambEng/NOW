                                    <columnMetadata
                                    columnName="DESCR_BPM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
