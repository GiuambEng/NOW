' or upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRAMULTI') and (not(exists($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita='0' or $CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita='1') and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita) > 0 and ($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita='BIDIREZIONALE' or $CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita='2') and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'H'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:CodFatturazione_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper_CodiceFatturazione-input"
                                    name="Mapper_CodiceFatturazione"
                                    outputVariable="Mapper_CodiceFatturazione"
                                    tibex:xpdlId="39475679-88db-4387-98af-55899b171a89" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogStartCodiceFatturazioneJPUBToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToLogEndCodiceFatturazioneJPUB"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiceFatturazioneJPUB.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_CodiceFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CodFatturazione_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:CodiceFiscale) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'SIMPLEX' and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'C'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:CodiceFiscale) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MONO' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMONO') and  (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0')&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'B'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:CodiceFiscale) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'SIMPLEX'&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'SIMPLEX' and (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0')&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and  string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'SIMPLEX' and (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0')&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'E'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and  upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'E'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MONO' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMONO') and (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0')&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0' or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='1') and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and ($CodiceFatturazioneJPUB.input/tns1:Direzionalita='BIDIREZIONALE' or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='2') and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'H'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'H'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and  (upper-case($CodiceFatturazioneJPUB.input/tns1:BandaServizio)='ISDNPRA' or upper-case($CodiceFatturazioneJPUB.input/tns1:BandaServizio)='ISDN PRA') and string-length($CodiceFatturazioneJPUB.input/tns1:CanaliEntranti)>0 and string-length($CodiceFatturazioneJPUB.input/tns1:CanaliTotali)>0 and $CodiceFatturazioneJPUB.input/tns1:CanaliTotali=$CodiceFatturazioneJPUB.input/tns1:CanaliEntranti&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'M'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and  (upper-case($CodiceFatturazioneJPUB.input/tns1:BandaServizio)='ISDNPRA' or upper-case($CodiceFatturazioneJPUB.input/tns1:BandaServizio)='ISDN PRA') and string-length($CodiceFatturazioneJPUB.input/tns1:CanaliEntranti)>0 and string-length($CodiceFatturazioneJPUB.input/tns1:CanaliTotali)>0  and string-length($CodiceFatturazioneJPUB.input/tns1:CanaliBidirezionali)>0  and $CodiceFatturazioneJPUB.input/tns1:CanaliTotali>$CodiceFatturazioneJPUB.input/tns1:CanaliEntranti&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '0' and $CodiceFatturazioneJPUB.input/tns1:AccessoNumerico = '0'&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'Q'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '1' and $CodiceFatturazioneJPUB.input/tns1:AccessoNumerico = '0'&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'R'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '0' and $CodiceFatturazioneJPUB.input/tns1:AccessoNumerico = '1'&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '1' and $CodiceFatturazioneJPUB.input/tns1:AccessoNumerico = '1'&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'T'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '0' and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) &amp;lt; 15 and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) >= 3&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'I'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '1' and (not(exists($CodiceFatturazioneJPUB.input/tns1:AccessoNumerico)) or string-length($CodiceFatturazioneJPUB.input/tns1:AccessoNumerico) = 0) and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) &amp;lt; 15 and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) >= 3&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'L'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR' and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '0' and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) >= 15&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'O'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'GNR'  and $CodiceFatturazioneJPUB.input/tns1:SelezionePassante = '1' and xsd:int($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) >= 15&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'P'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--CODICE FATTURAZIONE AGGIUNTIVI-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:QuantitaCanali) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'H'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'PBX' and  string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and (not(exists($CodiceFatturazioneJPUB.input/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='0' or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='1') and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'G'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB.input/tns1:PartitaIVA) > 0 and upper-case($CodiceFatturazioneJPUB.input/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRA MULTI' or upper-case($CodiceFatturazioneJPUB.input/tns1:StrutturaLinea) = 'BRAMULTI') and string-length($CodiceFatturazioneJPUB.input/tns1:Direzionalita) > 0 and ($CodiceFatturazioneJPUB.input/tns1:Direzionalita='BIDIREZIONALE' or $CodiceFatturazioneJPUB.input/tns1:Direzionalita='2') and string-length($CodiceFatturazioneJPUB.input/tns1:NumAggiuntivi) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazioneAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;'H'&quot;/>&#xa;                    &lt;/tns1:CodFatturazioneAggiuntivi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:CodFatturazione_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:BPMEnrichment="http://www.tim.com/NOW/xsd/BPMEnrichment"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
