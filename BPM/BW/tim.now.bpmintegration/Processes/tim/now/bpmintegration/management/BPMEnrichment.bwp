                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;DistrettoNormalizzato&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;Numero&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;BPMEnrichment&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;TipologiaAccessoPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaNumerazioneDonorOLOOperation&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Distretto: &amp;quot;,$Distretto,&amp;quot; Distretto normalizzato: &amp;quot;,$DistrettoNormalizzato, &amp;quot; Numero: &amp;quot;,$Numero)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cefc3014-2a0f-42a0-8a32-f45cc2e11b62+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DistrettoNormalizzato&quot;/>&#xa;    &lt;xsl:param name=&quot;Numero&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaNumerazioneDonorOLOOperation&quot;/>&#xa;    &lt;xsl:template name=&quot;EstrazioneOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTR>&#xa;                &lt;xsl:value-of select=&quot;$DistrettoNormalizzato&quot;/>&#xa;            &lt;/COD_DISTR>&#xa;            &lt;numero>&#xa;                &lt;xsl:value-of select=&quot;$Numero&quot;/>&#xa;            &lt;/numero>&#xa;            &lt;lunghezza_pad0>&#xa;                &lt;xsl:value-of select=&quot;string-length($Numero)&quot;/>&#xa;            &lt;/lunghezza_pad0>&#xa;            &lt;lunghezza_pad9>&#xa;                &lt;xsl:value-of select=&quot;string-length($Numero)&quot;/>&#xa;            &lt;/lunghezza_pad9>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaNumerazioneDonorOLOOperation/parameters/tns1:VerificaNumerazioneDonorOLORequest/tns1:DATA_INVIO_RICH)&quot;>&#xa;                    &lt;Data>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNumerazioneDonorOLOOperation/parameters/tns1:VerificaNumerazioneDonorOLORequest/tns1:DATA_INVIO_RICH)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNumerazioneDonorOLOOperation/parameters/tns1:VerificaNumerazioneDonorOLORequest/tns1:DATA_INVIO_RICH&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Data>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Data xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="EstrazioneOLO-input"
                                    name="EstrazioneOLO"
                                    outputVariable="EstrazioneOLO"
                                    tibex:xpdlId="cefc3014-2a0f-42a0-8a32-f45cc2e11b62" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
