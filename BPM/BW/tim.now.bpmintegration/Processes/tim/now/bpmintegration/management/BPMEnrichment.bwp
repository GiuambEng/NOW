                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5b963af0-1462-4775-b463-4b5e9309fe61+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaContrattoAttivo&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="5b963af0-1462-4775-b463-4b5e9309fe61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToJDBCQuery"/>
                                    <bpws:target linkName="RecuperaContAttivoLogToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToRecuperaContAttivoLog2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5b963af0-1462-4775-b463-4b5e9309fe61+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaContrattoAttivo.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.FLAG_DIFFIDATO, CON.FLAG_ANFIBIO, CON.ID_COD_CONTRATTO_PADRE,CON.FLAG_NPD,CON.TIMSTP_INSMTO, CON.ID_TPLG_OPERATORE&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.PROVENIENZA = ? AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = ?&#xa;ORDER BY CON.FLAG_NPD desc,CON.TIMSTP_INSMTO desc&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ANFIBIO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_NPD"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_TPLG_OPERATORE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6e20cf40-997d-44e0-bed2-ce57d673dd00+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaContrattoAttivo&quot;/>&#xa;    &lt;xsl:template name=&quot;TrascodificaOPRETE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose/>&#xa;            &lt;CODICEOPERATORERETE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:CodiceOperatoreRete)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaContrattoAttivo/input/tns1:RecuperaContrattoAttivoRequest/tns1:CodiceOperatoreRete&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICEOPERATORERETE>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="TrascodificaOPRETE-input"
                                    name="TrascodificaOPRETE"
                                    outputVariable="TrascodificaOPRETE"
