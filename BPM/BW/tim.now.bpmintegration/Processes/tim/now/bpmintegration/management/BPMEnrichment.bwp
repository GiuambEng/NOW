                                    sqlStatement="SELECT COD_AGESP from OSCURAMENTO_AGESP WHERE COD_AGESP=? AND FLAG_OSCURMENTO in ('Y','1')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

