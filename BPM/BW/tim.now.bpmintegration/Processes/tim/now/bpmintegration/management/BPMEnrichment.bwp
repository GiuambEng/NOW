                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPMEnrichment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiceFatturazioneJPUB&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_CodiceFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CodFatturazione_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:CodiceFiscale) > 0 and upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:TipoLinea) = 'POTS' and upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'SIMPLEX' and string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita) > 0&quot;>&#xa;                    &lt;tns1:CodFatturazionePrincipale>&#xa;                        &lt;xsl:value-of select=&quot;'C'&quot;/>&#xa;                    &lt;/tns1:CodFatturazionePrincipale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:CodiceFiscale) > 0 and upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:TipoLinea) = 'ISDN' and (upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRA MONO' or upper-case($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:StrutturaLinea) = 'BRAMONO') and  (not(exists($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita)) or string-length($CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita) = 0 or $CodiceFatturazioneJPUB/input/tns1:CodFatturazione_Request/tns1:Direzionalita='0')&quot;>