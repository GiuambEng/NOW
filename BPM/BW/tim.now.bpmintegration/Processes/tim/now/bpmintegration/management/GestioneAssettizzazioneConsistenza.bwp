                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idAsset"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idAssetDa"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idStatoAsset"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numeroTelefonico"/>

                                    <PreparedParameters
                                    DataType="92"
                                    DataTypeDisplayValue="TIME" ParameterName="oraDes"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="timstpInsmtoStorico"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numeroFittizio"/>

                                    <PreparedParameters
