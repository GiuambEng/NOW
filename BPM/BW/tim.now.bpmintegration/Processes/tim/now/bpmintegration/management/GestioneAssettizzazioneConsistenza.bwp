ione.parameters/operatoreRete)) != 'NaN'&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Assettizzazione.parameters/operatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NOME>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Assettizzazione.parameters/cliente/nome)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/cliente/nome&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME>&#xa;            &lt;COGNOME_RAG_SOC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Assettizzazione.parameters/cliente/cognomeRagioneSociale)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/cliente/cognomeRagioneSociale&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COGNOME_RAG_SOC>&#xa;            &lt;PARTITA_IVA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Assettizzazione.parameters/cliente/partitaIVA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/cliente/partitaIVA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/PARTITA_IVA>&#xa;            &lt;CODICE_FISCALE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Assettizzazione.parameters/cliente/codiceFiscale)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/cliente/codiceFiscale&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_FISCALE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
