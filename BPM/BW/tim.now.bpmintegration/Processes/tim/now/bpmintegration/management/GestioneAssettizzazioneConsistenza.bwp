LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.management&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GestioneAssettizzazioneConsistenza&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Assettizzazione/parameters/tns1:AssetElement/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Assettizzazione/parameters/tns1:AssetElement/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;GestioneAssettizzazioneConsistenza_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;GestioneAssettizzazioneConsistenza_&amp;quot;, $Assettizzazione/parameters/tns1:AssetElement/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Assettizzazione/parameters/tns1:AssetElement)))&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Assettizzazione/parameters/tns1:AssetElement, true(), true())&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
