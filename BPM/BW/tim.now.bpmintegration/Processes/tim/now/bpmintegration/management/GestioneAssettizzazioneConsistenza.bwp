ue&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/numeroTelefonico>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;numeroTelefonico xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Assettizzazione.parameters/dettaglioasset[nomeComponente =&amp;quot;DTUFONIA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;ORADES&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;oraDes>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;HH:mm&amp;quot;, $Assettizzazione.parameters/dettaglioasset[nomeComponente =&amp;quot;DTUFONIA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;ORADES&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/oraDes>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;oraDes>&#xa;                        &lt;xsl:value-of select=&quot;current-time()&quot;/>&#xa;                    &lt;/oraDes>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;timstpInsmtoStorico>&#xa;                &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/created&quot;/>&#xa;            &lt;/timstpInsmtoStorico>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Assettizzazione.parameters/numeroFittizio) > 0&quot;>&#xa;                    &lt;numeroFittizio>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Assettizzazione.parameters/numeroFittizio)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Assettizzazione.parameters/numeroFittizio&quot;/>&#xa;                            &lt;/xsl:when>&