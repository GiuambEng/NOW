                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AC.COD_CAUS_INTERNO, AC.DESCR_CAUS_INTERNO, ACF.ID_OFFERTA &#xa; FROM ANAG_CAUS AC, ANAG_CAUS_FASE ACF&#xa; WHERE AC.ID_ANAG_CAUS = ? AND ACF.ID_ANAG_CAUS = AC.ID_ANAG_CAUS&#xa; AND (ACF.ID_OFFERTA = (SELECT O.ID_OFFERTA FROM TRASCODFC_OFFERTA O WHERE O.NOME_OFFERTA_ESTERNA = ? AND O.PROVENIENZA = 'BPM') OR ACF.ID_OFFERTA = (SELECT off.ID_OFFERTA FROM offerta off WHERE off.OFFERTA='ALL'))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAG_CAUS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
