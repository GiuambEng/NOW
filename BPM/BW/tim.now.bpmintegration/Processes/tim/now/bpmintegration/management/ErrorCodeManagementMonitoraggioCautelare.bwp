                    outputVariable="Select_AnagCausFase_Off"
                    tibex:xpdlId="9e14eb48-b124-4179-be00-3854de4e9a7b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess2ToJDBCQuery2_OK"/>
                    </bpws:targets>
                    <bpws:sources>
