                    tibex:xpdlId="87ff3716-3b25-485e-9047-5fce7e0a9d7e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;ns:RichOLODettVarPC_Response>&lt;xsl:for-each select=&quot;$Variable/tns1:MappingCaseRequest&quot;>&lt;ns:RichOLODett_Response>&lt;ns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;tns1:ID_RICH_OLO&quot;/>&lt;/ns:ID_RICH_OLO>&lt;ns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;tns1:IDTPLG_DATO_RICH&quot;/>&lt;/ns:IDTPLG_DATO_RICH>&lt;ns:NOME>&lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&lt;/ns:NOME>&lt;ns:NOTE>&lt;xsl:value-of select=&quot;tns1:NOTE&quot;/>&lt;/ns:NOTE>&lt;ns:OPERATORE>&lt;xsl:value-of select=&quot;tns1:OPERATORE&quot;/>&lt;/ns:OPERATORE>&lt;ns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;tns1:PROGRS_TIPOLG_DATO_RICH&quot;/>&lt;/ns:PROGRS_TIPOLG_DATO_RICH>&lt;ns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;tns1:TIMSTP_AGGTO&quot;/>&lt;/ns:TIMSTP_AGGTO>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;tns1:TIMSTP_INSMTO&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;ns:VALORE>&lt;xsl:value-of select=&quot;tns1:VALORE&quot;/>&lt;/ns:VALORE>&lt;/ns:RichOLODett_Response>&lt;/xsl:for-each>&lt;/ns:RichOLODettVarPC_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:inputBinding
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">&lt;?xml version="1.0" encoding="UTF-8"?&gt; &lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/xsd/RichOLODett" version="2.0"&gt; &lt;xsl:template name="End-input" match="/"&gt; &lt;ns:RichOLODettVarPC_Response/&gt;&lt;/xsl:template&gt; &lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                    <tibex:config>
