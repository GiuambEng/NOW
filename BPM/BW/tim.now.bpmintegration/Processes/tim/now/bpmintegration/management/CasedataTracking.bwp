                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Storicizzazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InserimentoNumerazioniFittizie&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DistrettoFittizio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, '00')&quot;>&#xa;                    &lt;Distretto>&#xa;                        &lt;xsl:value-of select=&quot;substring($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, 2, 2)&quot;/>&#xa;                    &lt;/Distretto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, '0')&quot;>&#xa;                    &lt;Distretto>&#xa;                        &lt;xsl:value-of select=&quot;substring($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, 1, 3)&quot;/>&#xa;                    &lt;/Distretto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Distretto>&#xa;                        &lt;xsl:value-of select=&quot;concat('0',substring($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, 1, 3))&quot;/>&#xa;                    &lt;/Distretto>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;Fittizio>&#xa;                &lt;xsl:value-of select=&quot;tib:trim(substring-before($InserimentoNumerazioniFittizie/input/tns3:InserimentoNumerazioniFittizieRequest/IdRisorsa, 'W'))&quot;/>&#xa;            &lt;/Fittizio>&#xa;        &lt;/tns3:DistrettoFittizio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
