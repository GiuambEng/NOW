s($RichOloStoricoOp.parameters/IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ANAG_CAUS xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDContratto)&quot;>&#xa;                    &lt;ID_CONTRATTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDContratto)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDContratto&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_CONTRATTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_CONTRATTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_CORLZ>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDCorrelazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDCorrelazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CORLZ>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDFileInput)&quot;>&#xa;                    &lt;ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDFileInput)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDFileInput&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_FILE_PROCSTO_INPUT xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDFileOutput)&quot;>&#xa;                    &lt;ID_FILE_PROCSTO_OUTPUT>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDFileOutput)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDFileOutput&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_FILE_PROCSTO_OUTPUT xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDPacchettoNOW)&quot;>&#xa;                    &lt;ID_PACTO_NOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/IDPacchettoNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDPacchettoNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_PACTO_NOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_PACTO_NOW xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ISTAT_COMUNE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/ISTATComune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/ISTATComune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ISTAT_COMUNE>&#xa;            &lt;LAVRZ_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVRZ_RICH>&#xa;            &lt;LOCALITA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/localita)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/localita&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LOCALITA>&#xa;            &lt;NOTE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/note)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/note&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOTE>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/operatore&quot;/>&#xa;            &lt;/OPERATORE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/progressivoRichiestaFile)&quot;>&#xa;                    &lt;PROGRS_RICH_FILE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/progressivoRichiestaFile)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/progressivoRichiestaFile&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/PROGRS_RICH_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PROGRS_RICH_FILE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;SOTTOSTATO_LAVRZ_MANUALE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/sottostatoLavorManuale)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/sottostatoLavorManuale&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SOTTOSTATO_LAVRZ_MANUALE>&#xa;            &lt;STATO_RICH_NOW_A>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/statoRichiestaNOW&quot;/>&#xa;            &lt;/STATO_RICH_NOW_A>&#xa;            &lt;STATO_RICH_NOW_DA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/statoRichiestaPrecedNOW)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/STATO_RICH_NOW_DA>&#xa;            &lt;STATO_RICH_OLO_A>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/statoRichiestaOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/statoRichiestaOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/STATO_RICH_OLO_A>&#xa;            &lt;STATO_RICH_OLO_DA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/statoRichiestaPrecedOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/STATO_RICH_OLO_DA>&#xa;            &lt;STRUTTURA_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/strutturaRichiesta&quot;/>&#xa;            &lt;/STRUTTURA_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/created)&quot;>&#xa;                    &lt;TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/created&quot;/>&#xa;                    &lt;/TIMSTP_AGGTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIMSTP_AGGTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/lastUpdate)&quot;>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/lastUpdate&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIMSTP_INSMTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_INSMTO_STORICO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_STORICO>&#xa;            &lt;TIPO_PACTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/tipoPacchetto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/tipoPacchetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPO_PACTO>&#xa;            &lt;TIPO_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/tipoRichiesta&quot;/>&#xa;            &lt;/TIPO_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/totaleRichiestePacchetto)&quot;>&#xa;                    &lt;TOT_RICH_PACTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/totaleRichiestePacchetto)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/totaleRichiestePacchetto&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TOT_RICH_PACTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TOT_RICH_PACTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;XML_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/contenutoXML)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/contenutoXML&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/XML_RICH>&#xa;            &lt;TPLG_LAVRZ>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/ordine/tipologiaLavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/ordine/tipologiaLavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TPLG_LAVRZ>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_OLO_STORICO &#xd;&#xa;(ID_RICH_OLO_STORICO, AMBITO, CANALE_RICH, COD_ORDN_OLO, COD_ORDN_OLO_PADRE, COD_ORDN_OLO_TARGET, &#xd;&#xa;&#x9;COD_ORDN_TI, COD_PRGT, CODFC_OLO_AGCOM, CODFC_OLO_NOW, DATA_CTRLI_FORMALI, DATA_INVIO_RICH, &#xd;&#xa;&#x9;ID_RISORSA, ID_ANAG_CAUS, ID_CONTRATTO, ID_CORLZ, ID_FILE_PROCSTO_INPUT, ID_FILE_PROCSTO_OUTPUT, &#xd;&#xa;&#x9;ID_PACTO_NOW, ID_RICH_OLO, ISTAT_COMUNE, LAVRZ_RICH, LOCALITA, NOTE, OFFERTA, OPERATORE, &#xd;&#xa;&#x9;PROGRS_RICH_FILE, SOTTOSTATO_LAVRZ_MANUALE, STATO_RICH_NOW_A, STATO_RICH_NOW_DA, STATO_RICH_OLO_A, &#xd;&#xa;&#x9;STATO_RICH_OLO_DA, STRUTTURA_RICH, TIMSTP_AGGTO, TIMSTP_INSMTO, TIMSTP_INSMTO_STORICO, TIPO_PACTO, &#xd;&#xa;&#x9;TIPO_RICH, TOT_RICH_PACTO, XML_RICH, IDTPLG_LAVRZ) &#xd;&#xa;VALUES(S_RICH_OLO_STORICO.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, &#xd;&#xa;&#x9;&#x9;?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, (SELECT IDTPLG_LAVRZ FROM TIPOLG_LAVRZ &#xd;&#xa;&#x9;&#x9;WHERE TIPOLG_LAVRZ = ?)&#xd;&#xa;)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CANALE_RICH"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDN_OLO"/>

