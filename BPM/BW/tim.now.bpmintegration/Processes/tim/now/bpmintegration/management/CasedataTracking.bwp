           &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(not(exists($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC)) or string-length(xsd:string($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC))=0) and tib:compare-date(current-date(), xsd:date($DESCalcolata)) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC))>0 and tib:compare-date($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DES, $AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(not(exists($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC)) or string-length(xsd:string($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DAC))=0) and tib:compare-date($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DES, xsd:date($DESCalcolata)) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:STATO_RICH_NOW>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/statoRichiestaNOW&quot;/>&#xa;                &lt;/tns3:STATO_RICH_NOW>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_ANAG_CAUS/Record) > 0&quot;>&#xa;                        &lt;tns3:CATEGORIA_REPORT_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($Select_ANAG_CAUS/Record[1]/IDTPLG_FAMIG_AGCOM_KO)&quot;/>&#xa;                        &lt;/tns3:CATEGORIA_REPORT_AGCOM>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/IDAnagraficaCausale&quot;>&#xa;                    &lt;tns3:ID_ANAG_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/IDAnagraficaCausale&quot;/>&#xa;                    &lt;/tns3:ID_ANAG_CAUS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Update_PPS_ORDN_CHIUSI>&#xa;        &lt;/tns3:UpdatePPSORDNCHIUSI_Root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
