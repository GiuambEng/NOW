                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_NOTF,ID_EVENTO_ORDN_NOW_WHLS&#xd;&#xa;FROM RICH_ORDN_COMUNIC_TRACC&#xd;&#xa;WHERE ID_RICH_OLO = ? AND  STATO_NOW_A = ? AND STATO_NOW_DA =? &#xd;&#xa; AND COD_ORDN_OLO = ? AND CODFC_OLO_AGCOM = ? AND  LAVRZ_RICH =? AND OPERATORE =?&#xd;&#xa;AND STRUTTURA_RICH = ? order by TIMSTP_TRACC desc" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
