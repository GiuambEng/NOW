                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AggiornamentoGiacenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AggiornamentoGiacenza&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_ANAG_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_TPLG_LAVRZ&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;DESCalcolata&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_PPS_ORDN_CHIUSI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:UpdatePPSORDNCHIUSI_Root>&#xa;            &lt;tns3:Update_PPS_ORDN_CHIUSI>&#xa;                &lt;tns3:ID_AGCOM_AGGRO>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns3:ID_AGCOM_AGGRO>&#xa;                &lt;tns3:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_OLO/Record) > 0 and string-length($Select_OLO/Record[1]/COD_OLO_ACCORPANTE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Select_OLO/Record[1]/COD_OLO_ACCORPANTE&quot;>&#xa;                            &lt;tns3:CODFC_OLO_AGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Select_OLO/Record[1]/COD_OLO_ACCORPANTE&quot;/>&#xa;                            &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DES)) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DES&quot;>&#xa;                            &lt;tns3:DATA_CHIUSURA>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DES&quot;/>&#xa;                            &lt;/tns3:DATA_CHIUSURA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:DATA_CHIUSURA>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns3:DATA_CHIUSURA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza/input/ns1:RichiestaElement/ordine/DACRimodulata)) > 0&quot;>&#xa;                        &lt;tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                        &lt;/tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                        &lt;/tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/