                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_TRACC (ID_EVENTO_ORDN_NOW_WHLS, CANALE_RICH, COD_ORDN_OLO,&#xd;&#xa;COD_ORDN_OLO_PADRE, COD_ORDN_OLO_TARGET, COD_ORDN_TI, CODFC_OLO_AGCOM, CONTENUTO_TRACC,&#xd;&#xa;DAC_A, DAC_DA, ID_RISORSA, ID_RISORSA_NOW, ID_ANAG_CAUS, ID_NOTF, ID_RICH_OLO, LAVRZ_RICH,&#xd;&#xa;OPERATORE, SOTTOSTATO_LAVRZ_MANUALE, STATO_NOW_A, STATO_NOW_DA, STATO_OLO_A, STATO_OLO_DA,&#xd;&#xa;STRUTTURA_RICH, TIMSTP_TRACC, TIPO_RICH, ID_NOTF_DONATING, ID_NOTF_DONOR)&#xd;&#xa;       VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

