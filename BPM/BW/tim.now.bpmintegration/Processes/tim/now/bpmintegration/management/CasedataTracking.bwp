                                    name="JDBCQueryCtrlDuplicato"
                                    outputVariable="JDBCQueryCtrlDuplicato"
                                    tibex:xpdlId="de6d7fec-2616-4501-9082-4e927b0a339e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogDistrettoToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryCtrlDuplicatoToInserimentoNumerazioniFittizieOut">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($JDBCQueryCtrlDuplicato/Record[1]/ID_NUMRZNE_RECUPERABILE) and string-length(xsd:string($JDBCQueryCtrlDuplicato/Record[1]/ID_NUMRZNE_RECUPERABILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($JDBCQueryCtrlDuplicato/Record[1]/ID_NUMRZNE_RECUPERABILE) and string-length(xsd:string($JDBCQueryCtrlDuplicato/Record[1]/ID_NUMRZNE_RECUPERABILE))>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCQueryCtrlDuplicatoToSequenceArcoDati">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+de6d7fec-2616-4501-9082-4e927b0a339e+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryCtrlDuplicato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTR>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/Distretto&quot;/>&#xa;            &lt;/COD_DISTR>&#xa;            &lt;FLAG_NUMRZNE_UTILIZZABILE>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/FLAG_NUMRZNE_UTILIZZABILE>&#xa;            &lt;NUMRZNE_FITTIZIA>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/Fittizio&quot;/>&#xa;            &lt;/NUMRZNE_FITTIZIA>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
