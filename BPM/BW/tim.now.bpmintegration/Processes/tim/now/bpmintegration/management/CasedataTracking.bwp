&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/CreatedCaseRequest" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/RichOLODett/" xmlns:ns="http://www.tim.com/NOW/xsd/RichOLODett" version="2.0"&gt;
    &lt;xsl:param name="CreatedCaseRequest"/&gt;
    &lt;xsl:param name="RecuperaXML"/&gt;
    &lt;xsl:template name="Invoke_RichOLODettNP-input" match="/"&gt;
        &lt;tns3:RichOLODettNPRequest&gt;
            &lt;input&gt;
                &lt;ns:RichOLODettNP_Request&gt;
                    &lt;ns:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:IDRichiestaOLO"/&gt;
                    &lt;/ns:IDRichiestaOLO&gt;
                    &lt;xsl:if test="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:Note"&gt;
                        &lt;ns:Note&gt;
                            &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:Note"/&gt;
                        &lt;/ns:Note&gt;
                    &lt;/xsl:if&gt;
                    &lt;ns:Operatore&gt;
                        &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:Operatore"/&gt;
                    &lt;/ns:Operatore&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:ContenutoXML)&gt;0"&gt;
                            &lt;ns:ContenutoXML&gt;
                                &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:ContenutoXML"/&gt;
                            &lt;/ns:ContenutoXML&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;ns:ContenutoXML&gt;
                                &lt;xsl:value-of select="$RecuperaXML/Record[1]/CONTENUTO_XML_OLO"/&gt;
                            &lt;/ns:ContenutoXML&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;ns:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/ns:StrutturaRichiesta&gt;
                    &lt;ns:Lavorazione&gt;
                        &lt;xsl:value-of select="$CreatedCaseRequest/parameters/tns1:CreatedCaseRequestInput/tns1:Lavorazione"/&gt;
                    &lt;/ns:Lavorazione&gt;
                &lt;/ns:RichOLODettNP_Request&gt;
            &lt;/input&gt;
        &lt;/tns3:RichOLODettNPRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
