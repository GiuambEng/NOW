                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+94a89f6e-92b7-4b58-b153-dd49bf207b17+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOrdComTrackingOp&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;STATO_NOW_A>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/statoRichiestaNOW&quot;/>&#xa;            &lt;/STATO_NOW_A>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/statoRichiestaPrecedNOW)>0&quot;>&#xa;                    &lt;STATO_NOW_DA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/statoRichiestaPrecedNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;        