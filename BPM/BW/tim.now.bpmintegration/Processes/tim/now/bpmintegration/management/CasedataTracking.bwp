                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cdcec741-0a9c-4aa5-918d-550f236f6952+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOrdComTrackingOp.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_IDNotf&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCInsertRichOrdCom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CANALE_RICH>&#xa;           