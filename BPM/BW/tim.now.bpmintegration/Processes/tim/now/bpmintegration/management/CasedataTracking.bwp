                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_OLO_DETT (ID_RICH_OLO, IDTPLG_DATO_RICH, NOME, NOTE,&#xa;OPERATORE, PROGRS_TIPOLG_DATO_RICH, TIMSTP_AGGTO, TIMSTP_INSMTO,VALORE)&#xa;  VALUES (?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
