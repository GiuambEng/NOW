OloStoricoOp.parameters/codiceProgetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_PRGT>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/codificaOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOloStoricoOp.parameters/codificaOLONOW) > 0&quot;>&#xa;                    &lt;CODFC_OLO_NOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/codificaOLONOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/codificaOLONOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODFC_OLO_NOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODFC_OLO_NOW xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/dataControlliFormali)&quot;>&#xa;                    &lt;DATA_CTRLI_FORMALI>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOloStoricoOp.parameters/dataControlliFormali)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOloStoricoOp.parameters/dataControll