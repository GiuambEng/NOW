edNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_NOW_DA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_NOW_DA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO)>0&quot;>&#xa;                    &lt;STATO_OLO_A>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_OLO_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_OLO_A xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO)>0&quot;>&#xa;                    &lt;STATO_OLO_DA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_OLO_DA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_OLO_DA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;STRUTTURA_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/strutturaRichiesta&quot;/>&#xa;            &lt;/STRUTTURA_RICH>&#xa;            &lt;TIMSTP_TRACC>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_TRACC>&#xa;            &lt;TIPO_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/tipoRichiesta&quot;/>&#xa;            &lt;/TIPO_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonating)&quot;>&#xa;                    &lt;ID_NOTF_DONATING>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp