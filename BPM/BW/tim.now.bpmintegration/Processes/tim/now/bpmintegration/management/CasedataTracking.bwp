                      &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DAC_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                    &lt;DAC_A>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DAC_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DAC_A xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                    &lt;DAC_DA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/ordine/DAC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DAC_DA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DAC_DA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RISORSA_NOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA_NOW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDAnagraficaCausale)&quot;>&#xa;                    &lt;ID_ANAG_CAUS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAG_CAUS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ANAG_CAUS xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotifica) and count($JDBCQuery_IDNotf/Record) >0&quot;>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/ID_NOTF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_NOTF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotifica)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotifica&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;SOTTOSTATO_LAVRZ_MANUALE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/sottostatoLavorManuale)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/sottostatoLavorManuale&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SOTTOSTATO_LAVRZ_MANUALE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO)>0&quot;>&#xa;                    &lt;STATO_OLO_A>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_OLO_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_OLO_A xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO)>0&quot;>&#xa;                    &lt;STATO_OLO_DA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_OLO_DA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_OLO_DA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;STRUTTURA_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/strutturaRichiesta&quot;/>&#xa;            &lt;/STRUTTURA_RICH>&#xa;            &lt;TIMSTP_TRACC>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_TRACC>&#xa;            &lt;TIPO_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/tipoRichiesta&quot;/>&#xa;            &lt;/TIPO_RICH>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonating)&quot;>&#xa;                    &lt;ID_NOTF_DONATING>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonating&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF_DONATING>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_NOTF_DONATING xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonor)&quot;>&#xa;                    &lt;ID_NOTF_DONOR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonor)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDNotificaDonor&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF_DONOR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_NOTF_DONOR xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;STATO_NOW_A>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaNOW&quot;/>&#xa;            &lt;/STATO_NOW_A>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedNOW)>0&quot;>&#xa;                    &lt;STATO_NOW_DA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_NOW_DA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_NOW_DA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;COD_ORDN_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/codiceOrdineOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/codiceOrdineOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ORDN_OLO>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;LAVRZ_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVRZ_RICH>&#xa;            &lt;OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp.parameters/tns1:strutturaRichiesta/operatore&quot;/>&#xa;            &lt;/OPERATORE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.RICH_ORDN_COMUNIC_TRACC&#xa;  SET CANALE_RICH = ?, COD_ORDN_OLO_PADRE = ?, COD_ORDN_OLO_TARGET = ?,&#xa;      COD_ORDN_TI = ?, CONTENUTO_TRACC = ?, DAC_A = ?, DAC_DA = ?,&#xa;      ID_RISORSA = ?, ID_RISORSA_NOW = ?, ID_ANAG_CAUS = ?, ID_NOTF = ?,&#xa;      SOTTOSTATO_LAVRZ_MANUALE = ?, STATO_OLO_A = ?, STATO_OLO_DA = ?,&#xa;      STRUTTURA_RICH = ?, TIMSTP_TRACC = ?, TIPO_RICH = ?, ID_EVENTO_ORDN_NOW_WHLS = ?, &#xa;      ID_NOTF_DONATING = ? , ID_NOTF_DONOR = ?&#xa;  WHERE ID_RICH_OLO = ? AND STATO_NOW_A = ? AND STATO_NOW_DA = ? AND COD_ORDN_OLO = ?&#xa;    AND CODFC_OLO_AGCOM = ? AND LAVRZ_RICH = ? AND OPERATORE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CANALE_RICH"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDN_OLO_PADRE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDN_OLO_TARGET"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDN_TI"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_TRACC"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DAC_A"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DAC_DA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_NOW"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAG_CAUS"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SOTTOSTATO_LAVRZ_MANUALE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_OLO_A"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_OLO_DA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_RICH"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_TRACC"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_RICH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF_DONATING"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF_DONOR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_NOW_A"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_NOW_DA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDN_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVRZ_RICH"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOrdComTrackingOp&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCUPDATERichOrdCom&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CasedataTracking'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CasedataTrackingPortType'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'RichOrdComTracking'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('RichOrdCom UPDATE  NoOfUpdate: ', string($JDBCUPDATERichOrdCom/noOfUpdates))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &l