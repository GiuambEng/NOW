                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+55f677c2-9be1-405f-9c10-d81ace48f721+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOrdComTrackingOp&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_IDNotf&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUPDATERichOrdCom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;CANALE_RICH>&#xa;                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/canaleRichiesta&quot;/>&#xa;            &lt;/CANALE_RICH>&#xa;            &lt;COD_ORDN_OLO_PADRE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineOLOPadre)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineOLOPadre&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ORDN_OLO_PADRE>&#xa;            &lt;COD_ORDN_OLO_TARGET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineOLOTarget)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ORDN_OLO_TARGET>&#xa;            &lt;COD_ORDN_TI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineTI)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/codiceOrdineTI&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ORDN_TI>&#xa;            &lt;CONTENUTO_TRACC>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;lt;![CDATA[&amp;quot;, tib:render-xml($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta), &amp;quot;]]>&amp;quot;)&quot;/>&#xa;            &lt;/CONTENUTO_TRACC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DACRimodulata)&quot;>&#xa;                    &lt;DAC_A>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DACRimodulata)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DACRimodulata&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DAC_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                    &lt;DAC_A>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DAC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DAC_A>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DAC_A xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RichOrdComTrackingOp/parameters/tns1:RichOrdComTrackingOpRequest/tns1:strutturaRichiesta/ordine/DAC)&quot;>&#xa;                    &lt;DAC_DA>&#xa;                        &lt;xsl