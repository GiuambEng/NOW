                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AggiornamentoGiacenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AggiornamentoGiacenza.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_ANAG_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_TPLG_LAVRZ&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;DESCalcolata&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_PPS_ORDN_CHIUSI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:UpdatePPSORDNCHIUSI_Root>&#xa;            &lt;tns3:Update_PPS_ORDN_CHIUSI>&#xa;                &lt;tns3:ID_AGCOM_AGGRO>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns3:ID_AGCOM_AGGRO>&#xa;                &lt;tns3:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_OLO/Record) > 0 and string-length($Select_OLO/Record[1]/COD_OLO_ACCORPANTE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Select_OLO/Record[1]/COD_OLO_ACCORPANTE&quot;>&#xa;                            &lt;tns3:CODFC_OLO_AGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Select_OLO/Record[1]/COD_OLO_ACCORPANTE&quot;/>&#xa;                            &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DES)) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$AggiornamentoGiacenza.input/ordine/DES&quot;>&#xa;                            &lt;tns3:DATA_CHIUSURA>&#xa;                                &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/ordine/DES&quot;/>&#xa;                            &lt;/tns3:DATA_CHIUSURA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:DATA_CHIUSURA>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns3:DATA_CHIUSURA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DACRimodulata)) > 0&quot;>&#xa;                        &lt;tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                        &lt;/tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                        &lt;/tns3:FLAG_RIMODULAZIONE_DAC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza.input/statoRichiestaOLO&quot;>&#xa;                    &lt;tns3:STATO_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/statoRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:STATO_RICH_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza.input/IDOfferta&quot;>&#xa;                    &lt;tns3:ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/IDOfferta&quot;/>&#xa;                    &lt;/tns3:ID_OFFERTA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_TPLG_LAVRZ/Record) > 0&quot;>&#xa;                        &lt;tns3:IDTPLG_LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($Select_TPLG_LAVRZ/Record[1]/IDTPLG_LAVRZ)&quot;/>&#xa;                        &lt;/tns3:IDTPLG_LAVRZ>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(not(exists($AggiornamentoGiacenza.input/ordine/DES)) or string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DES)) = 0)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DAC)) > 0 and tib:compare-date(current-date(), $AggiornamentoGiacenza.input/ordine/DAC) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(not(exists($AggiornamentoGiacenza.input/ordine/DAC)) or string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DAC))=0) and tib:compare-date(current-date(), xsd:date($DESCalcolata)) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DAC))>0 and tib:compare-date($AggiornamentoGiacenza.input/ordine/DES, $AggiornamentoGiacenza.input/ordine/DAC) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(not(exists($AggiornamentoGiacenza.input/ordine/DAC)) or string-length(xsd:string($AggiornamentoGiacenza.input/ordine/DAC))=0) and tib:compare-date($AggiornamentoGiacenza.input/ordine/DES, xsd:date($DESCalcolata)) = 1&quot;>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:IN_SLA>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns3:IN_SLA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:STATO_RICH_NOW>&#xa;                    &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/statoRichiestaNOW&quot;/>&#xa;                &lt;/tns3:STATO_RICH_NOW>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza.input/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_ANAG_CAUS/Record) > 0&quot;>&#xa;                        &lt;tns3:CATEGORIA_REPORT_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($Select_ANAG_CAUS/Record[1]/IDTPLG_FAMIG_AGCOM_KO)&quot;/>&#xa;                        &lt;/tns3:CATEGORIA_REPORT_AGCOM>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$AggiornamentoGiacenza.input/IDAnagraficaCausale&quot;>&#xa;                    &lt;tns3:ID_ANAG_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;$AggiornamentoGiacenza.input/IDAnagraficaCausale&quot;/>&#xa;                    &lt;/tns3:ID_ANAG_CAUS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Update_PPS_ORDN_CHIUSI>&#xa;        &lt;/tns3:UpdatePPSORDNCHIUSI_Root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
