        <bpws:variable name="OperatoreSecolo" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="//tim.now.shared_library///Processes/SECOLO/OPERATORE" type="xsd:string"/>
        <bpws:variable element="ns3:Element" name="GetLocalIP" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:GenerateHashingClienteRequest"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
