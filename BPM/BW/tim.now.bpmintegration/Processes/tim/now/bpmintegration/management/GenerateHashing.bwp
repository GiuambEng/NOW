            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerJDBC/TimeoutJDBC" type="xsd:int"/>
        <bpws:variable element="ns6:jdbcQueryActivityInput"
            name="CheckOscuramento-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:resultSet" name="CheckOscuramento" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:CW_BUS_MESSAGE"
