                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="GenericLoggerToEnd1" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashing&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashingPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashingCliente&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Fault Generate Hashing: &amp;quot;, tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="GenericLogger-input"
                                name="GenericLogger"
                                tibex:xpdlId="ea741139-fa98-458a-ac09-f96e4aa65f81"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToEnd1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashing&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashingPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GenerateHashingCliente&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Fault Generate Hashing: &amp;quot;, tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateHashingCliente/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GenerateHashingClienteResponse>&lt;Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/Codice>&lt;Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/Esito>&lt;/tns:GenerateHashingClienteResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="End-input" name="End1"
                                tibex:xpdlId="986e6bf1-3493-4a24-99b1-d9336d35bcf5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToEnd1"/>
                                </bpws:targets>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateHashingCliente/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GenerateHashingClienteResponse>&lt;Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/Codice>&lt;Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/Esito>&lt;/tns:GenerateHashingClienteResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.end"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCheckOscuramento" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetLocalIPToCallSecoloHash" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallSecoloDecodeToGenericLogger" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="GetLocalIPToCallSecoloDecode" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallSecoloHashToGenericLogger" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCUpdateToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckOscuramentoToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToGetLocalIP" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogDetokToCallSecoloHash" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="GenericLoggerToInsertRICHIESTA_ORDINE_HASH" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToEnd"
                    tibex:label="OSCURATO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallSecoloDecodeToEnd" tibex:label="KO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallSecoloHashToEnd" tibex:label="KO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="0c11fdb2-7da7-43e1-8cd3-215c1a4c05bf"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCheckOscuramento">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateHashingCliente/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GenerateHashingClienteResponse>&lt;Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/Codice>&lt;Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/Esito>&lt;/tns:GenerateHashingClienteResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="adfc843d-73b4-479a-9520-bc401e81b524" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToEnd"/>
                        <bpws:target linkName="CallSecoloHashToEnd"/>
                        <bpws:target linkName="CallSecoloDecodeToEnd"/>
                        <bpws:target linkName="LogOscuramentoToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateHashingCliente/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:GenerateHashingClienteResponse>&lt;Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/Codice>&lt;Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/Esito>&lt;/tns:GenerateHashingClienteResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:template name=&quot;CallSecoloDecode-input&quot; match=&quot;/&quot;>&lt;tns:RequestDecode_token>&lt;xsl:if test=&quot;$Start/CodificaOLOAGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/CodificaOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/CodiceOrdineOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/CodiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/CanaleRichiesta = 'GUI'&quot;>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'DETOK_ACQGUI'&quot;/>&lt;/tns:Funzione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'DETOK_ACQFILE'&quot;/>&lt;/tns:Funzione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($Start/CodiceOrdineOLO,string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns1:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns1:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/CognomeRagioneSociale)>0&quot;>&lt;xsl:if test=&quot;$Start/CognomeRagioneSociale&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/CognomeRagioneSociale&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/Nome)>0&quot;>&lt;xsl:if test=&quot;$Start/Nome&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/Nome&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/CF)>0&quot;>&lt;xsl:if test=&quot;$Start/CF&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/CF&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/PIVA&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/PIVA&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RequestDecode_token>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CallSecoloDecode-input"
                    name="CallSecoloDecode"
                    outputVariable="CallSecoloDecode"
                    tibex:xpdlId="d91edd56-1337-425f-ba22-c990a835c180"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToCallSecoloDecode"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallSecoloDecodeToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CallSecoloDecode/ns0:ESITO != 'KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CallSecoloDecode/ns0:ESITO != 'KO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallSecoloDecodeToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:template name=&quot;CallSecoloDecode-input&quot; match=&quot;/&quot;>&lt;tns:RequestDecode_token>&lt;xsl:if test=&quot;$Start/CodificaOLOAGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/CodificaOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/CodiceOrdineOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/CodiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/CanaleRichiesta = 'GUI'&quot;>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'DETOK_ACQGUI'&quot;/>&lt;/tns:Funzione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'DETOK_ACQFILE'&quot;/>&lt;/tns:Funzione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($Start/CodiceOrdineOLO,string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns1:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns1:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/CognomeRagioneSociale)>0&quot;>&lt;xsl:if test=&quot;$Start/CognomeRagioneSociale&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/CognomeRagioneSociale&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test