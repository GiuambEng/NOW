                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettRegolatorioIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlREGOLATORIO&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_RichOLODettRegolatorio_ALTRO-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/InterruzioneSospensione)&quot;>&#xa;                &lt;tns:MappingCaseRequest>&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;16&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/QualificaRef))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;       