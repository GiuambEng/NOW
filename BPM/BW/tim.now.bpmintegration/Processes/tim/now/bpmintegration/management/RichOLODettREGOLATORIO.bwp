            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichOLODettRegolatorioIn&quot;/>&lt;xsl:param name=&quot;ParseXmlREGOLATORIO&quot;/>&lt;xsl:template name=&quot;Mapper_RichOLODettRegolatorio_ALTRO-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/InterruzioneSospensione)&quot;>&lt;tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;16&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/QualificaRef))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:valu