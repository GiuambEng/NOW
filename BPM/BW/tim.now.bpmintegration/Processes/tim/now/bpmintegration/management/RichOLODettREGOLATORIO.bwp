                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;16&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/NomeReferente))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;16&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;              