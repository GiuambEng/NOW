ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&lt;/tns:MappingCaseRequest>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/Ordine/Migrazione)&quot;>&lt;tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!--DESTINAZIONEUSO-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXmlREGOLATORIO/Testata/CodiceOlo !=&amp;quot;TLC&amp;quot; and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia) and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXmlREGOLATORIO/Testata/CodiceOlo = &amp;quot;TLC&amp;quot; and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia) and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;concat($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia, &amp;quot;|&amp;quot;, $ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati)&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia)&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati&quot;/>&lt;/tns:VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        &lt;!--IdUllCo-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;28&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/IdUllCo))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/IdUllCo&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--BitRate-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;'BITRATE'&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/BitRate&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!--PosizionePermutatore1-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;28&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/PosizionePermutatore1))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/PosizionePermutatore1&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--PosizionePermutatore2-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;28&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/PosizionePermutatore2))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn/input/ns1:RichOLODettRegolatorio_Request/ns1:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/PosizionePermutatore2&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     