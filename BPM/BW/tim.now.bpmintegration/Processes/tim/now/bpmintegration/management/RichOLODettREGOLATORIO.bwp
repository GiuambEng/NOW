                          &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                &lt;/tns:MappingCaseRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/Ordine/Migrazione)&quot;>&#xa;                &lt;tns:MappingCaseRequest>&#xa;                    &lt;!--DESTINAZIONEUSO-->&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ParseXmlREGOLATORIO/Testata/CodiceOlo !=&amp;quot;TLC&amp;quot; and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia) and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati)&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$ParseXmlREGOLATORIO/Testata/CodiceOlo = &amp;quot;TLC&amp;quot; and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia) and exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati)&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;concat($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia, &amp;quot;|&amp;quot;, $ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati)&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia)&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/fonia&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/TipoDati&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                    &lt;!--IdUllCo-->&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;28&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/IdUllCo))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/IdUllCo&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                    &lt;!--BitRate-->&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;'BITRATE'&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Operatore&quot;/>&#xa;                        &lt;/tns:OPERATORE>&#xa;                        &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                        &lt;tns:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_AGGTO>&#xa;                        &lt;tns:TIMSTP_INSMTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TIMSTP_INSMTO>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/DestinazioneUso/dati/BitRate&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/tns:MappingCaseRequest>&#xa;                    &lt;!--PosizionePermutatore1-->&#xa;                    &lt;tns:MappingCaseRequest>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                        &lt;tns:IDTPLG_DATO_RICH>&#xa;                            &lt;xsl:value-of select=&quot;28&quot;/>&#xa;                        &lt;/tns:IDTPLG_DATO_RICH>&#xa;                        &lt;tns:NOME>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlREGOLATORIO/Ordine/Migrazione/Servizio/node()/PosizionePermutatore1))&quot;/>&#xa;                        &lt;/tns:NOME>&#xa;                        &lt;tns:NOTE>&#xa;                            &lt;xsl:value-of select=&quot;$RichOLODettRegolatorioIn.input/ns1:Note&quot;/>&#xa;                        &lt;/tns:NOTE>&#xa;                        &lt;tns:OPERATORE>&#xa;                   