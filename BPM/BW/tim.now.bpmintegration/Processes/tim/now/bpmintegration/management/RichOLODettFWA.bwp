                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapRichOLODetailFWA&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RichOLODettFWA_Response>&lt;xsl:for-each select=&quot;$MapRichOLODetailFWA/tns1:MappingCaseRequest&quot;>&lt;tns:RichOLODett_Response>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;tns1:ID_RICH_OLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;tns1:IDTPLG_DATO_RICH&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;tns1:NOME&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;tns1:NOTE&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;tns1:OPERATORE&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;tns1:PROGRS_TIPOLG_DATO_RICH&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;tns1:TIMSTP_AGGTO&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;tns1:TIMSTP_INSMTO&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;tns1:VALORE&quot;/>&lt;/tns:VALORE>&lt;/tns:RichOLODett_Response>&lt;/xsl:for-each>&lt;/tns:RichOLODettFWA_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
