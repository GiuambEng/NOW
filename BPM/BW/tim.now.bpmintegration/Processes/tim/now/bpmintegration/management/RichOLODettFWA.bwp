            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:ns0=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;MapRichOLODetailFWA-input&quot; match=&quot;/&quot;>&lt;tns:MappingCaseRequest>&#xa;                    &lt;!-- Profilo -->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:Profilo))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:Profilo&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                &lt;!--TipologiaCPE-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:TipologiaCPE))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:TipologiaCPE&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                            &lt;!--FlagIntervento-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:FlagIntervento))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:FlagIntervento&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                        &lt;!--CognomeRagSoc-->&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:CognomeRagSoc))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:CognomeRagSoc&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&lt;xsl:if test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:Nome)&quot;>&lt;tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                            &lt;!--Nome-->&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:Nome))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$Start/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:Nome&quot;/>&lt;/tns:VALORE>&lt;/tns:MappingCaseRequest>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:ClienteFinale/ns0:CF)&quot;>&lt;tns:MappingCaseRequest>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--CF-->&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXml/n