<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="tim.now.bpmintegration.management.RichOLODettFWA"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20181010123828"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tim.com/NOW/xsd/RichOLODett"
    xmlns:ns1="http://www.tibco.com/namespaces/tnt/plugins/parsexml"
    xmlns:ns2="http://fwa.telecomitalia.it/crm/fwa/order"
