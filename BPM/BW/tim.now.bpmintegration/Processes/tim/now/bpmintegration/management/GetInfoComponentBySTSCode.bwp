        location="../../../../../Schemas/Management/GenericEnrichment.xsd" namespace="http://www.tim.com/NOW/xsd/GenericEnrichment"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:EnrichmentSTS_Request" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:EnrichmentSTS_Response"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="InputLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="OutputLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:jdbcQueryActivityInput"
            name="GetInfoComponent-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:resultSet" name="GetInfoComponent" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
