    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToInputLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="OutputLogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="InputLogToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToOutputLog_Name" tibex:label="" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToInfoComponent" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
