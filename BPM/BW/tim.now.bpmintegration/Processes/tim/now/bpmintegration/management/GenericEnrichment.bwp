                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStartToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(starts-with($GenericEnrichment/parameters/ns4:GenericEnrichmentRequest/ns4:Richiesta/offerta, &quot;EASYIP&quot;) or $GenericEnrichment/parameters/ns4:GenericEnrichmentRequest/ns4:Richiesta/offerta = 'BITSTREAMGBESIMMETRICOFLAT' or starts-with($GenericEnrichment/parameters/ns4:GenericEnrichmentRequest/ns4:Richiesta/offerta, &quot;BITSTREAMATMSIM&quot;)) and ($GenericEnrichment/parameters/ns4:GenericEnrichmentRequest/ns4:Richiesta/lavorazione =&quot;ATTIVAZIONE&quot; or $GenericEnrichment/parameters/ns4:GenericEnrichmentRequest/ns4:Richiesta/lavorazione =&quot;MIGRAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(starts-with($GenericEnrichment.parameters/ns4:Richiesta/offerta, "EASYIP") or $GenericEnrichment.parameters/ns4:Richiesta/offerta = 'BITSTREAMGBESIMMETRICOFLAT' or starts-with($GenericEnrichment.parameters/ns4:Richiesta/offerta, "BITSTREAMATMSIM")) and ($GenericEnrichment.parameters/ns4:Richiesta/lavorazione ="ATTIVAZIONE" or $GenericEnrichment.parameters/ns4:Richiesta/lavorazione ="MIGRAZIONE")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="OnMessageStartToCallProcess1">
