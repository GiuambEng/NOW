                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ParametriProfiloLinea&quot;/>&lt;xsl:param name=&quot;SelectParametri&quot;/>&lt;xsl:template name=&quot;LogOutputParametriProfiloLinea-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'GenericEnrichment'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'GenericEnrichmentPortType'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'ParametriProfiloLinea'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ParametriProfiloLinea/input/tns1:ParametriProfiloLinea_Request/tns1:IdRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Log dati recuperati per EnrichmentBande'&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;MCR UP: &amp;quot;, string($SelectParametri/Record[1]/MCR_UP), &amp;#xD;&amp;#xA;      &amp;quot; MCR DOWN: &amp;quot;,string($SelectParametri/Record[1]/MCR_DOWN), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; PCR UP: &amp;quot;, string($SelectParametri/Record[1]/PCR_UP), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; PCR DOWN: &amp;quot;, string($SelectParametri/Record[1]/PCR_DOWN), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; ID PROFILO VC: &amp;quot;, string($SelectParametri/Record[1]/ID_PRFL_VC),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; COD MODEM: &amp;quot;, string($SelectParametri/Record[1]/COD_MODEM), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; SIGLA MODEM: &amp;quot;, string($SelectParametri/Record[1]/SIGLA_MODEM),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; TIPOLG PROFILO: &amp;quot;, string($SelectParametri/Record[1]/TIPOLG_PROFILO),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; FLAG VENDIBILITA PTL: &amp;quot;, string($SelectParametri/Record[1]/FLAG_VENDIBILITA_PTL),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; FLAG VENDIBILITA PVC: &amp;quot;, string($SelectParametri/Record[1]/FLAG_VENDIBILITA_PVC))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
