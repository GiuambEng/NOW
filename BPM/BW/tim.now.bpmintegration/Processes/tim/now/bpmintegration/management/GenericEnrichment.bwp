                                tibex:xpdlId="f8eef604-481e-404b-92e4-5314284085f6" variable="GenericEnrichmentOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/GenericEnrichment/" xmlns:tns1="http://www.tim.com/NOW/xsd/GenericEnrichment" version="2.0"&gt;&lt;xsl:param name="Mapper_profilo"/&gt;&lt;xsl:param name="CasoNonGestito"/&gt;&lt;xsl:template name="GenericEnrichmentOut-input" match="/"&gt;&lt;tns:GenericEnrichmentResponse&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CasoNonGestito=false()"&gt;&lt;tns1:GenericEnrichment_Response&gt;&lt;xsl:copy-of select="$Mapper_profilo/tns1:GenericEnrichmentResponse"/&gt;&lt;/tns1:GenericEnrichment_Response&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:GenericEnrichment_Response&gt;&lt;tns1:GenericEnrichmentResponse&gt;&lt;tns1:Key&gt;&lt;xsl:value-of select="&amp;quot;ESITO&amp;quot;"/&gt;&lt;/tns1:Key&gt;&lt;tns1:Value&gt;&lt;xsl:value-of select="&amp;quot;CasoNonGestito&amp;quot;"/&gt;&lt;/tns1:Value&gt;&lt;/tns1:GenericEnrichmentResponse&gt;&lt;/tns1:GenericEnrichment_Response&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns:GenericEnrichmentResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericEnrichment/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper_profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;CasoNonGestito&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericEnrichmentOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$CasoNonGestito=false()&quot;>&#xa;                &lt;tns1:GenericEnrichment_Response>&#xa;                    &lt;xsl:copy-of select=&quot;$Mapper_profilo/tns1:GenericEnrichmentResponse&quot;/>&#xa;                &lt;/tns1:GenericEnrichment_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:GenericEnrichment_Response>&#xa;                    &lt;tns1:GenericEnrichmentResponse>&#xa;                        &lt;tns1:Key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ESITO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Key>&#xa;                        &lt;tns1:Value>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CasoNonGestito&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Value>&#xa;                    &lt;/tns1:GenericEnrichmentResponse>&#xa;                &lt;/tns1:GenericEnrichment_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
