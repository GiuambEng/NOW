                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogOutputParametriProfiloLineaToParametriProfiloLineaOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParametriProfiloLinea.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectParametri&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutputParametriProfiloLinea-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'GenericEnrichment'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'GenericEnrichmentPortType'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ParametriProfiloLinea'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ParametriProfiloLinea.input/tns1:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Log dati recuperati per EnrichmentBande'&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MCR UP: &amp;quot;, string($SelectParametri/Record[1]/MCR_UP), &amp;#xD;&amp;#xA;      &amp;quot; MCR DOWN: &amp;quot;,string($SelectParametri/Record[1]/MCR_DOWN), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; PCR UP: &amp;quot;, string($SelectParametri/Record[1]/PCR_UP), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; PCR DOWN: &amp;quot;, string($SelectParametri/Record[1]/PCR_DOWN), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; ID PROFILO VC: &amp;quot;, string($SelectParametri/Record[1]/ID_PRFL_VC),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; COD MODEM: &amp;quot;, string($SelectParametri/Record[1]/COD_MODEM), &amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; SIGLA MODEM: &amp;quot;, string($SelectParametri/Record[1]/SIGLA_MODEM),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; TIPOLG PROFILO: &amp;quot;, string($SelectParametri/Record[1]/TIPOLG_PROFILO),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; FLAG VENDIBILITA PTL: &amp;quot;, string($SelectParametri/Record[1]/FLAG_VENDIBILITA_PTL),&amp;#xD;&amp;#xA;&amp;#x9;  &amp;quot; FLAG VENDIBILITA PVC: &amp;quot;, string($SelectParametri/Record[1]/FLAG_VENDIBILITA_PVC))&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
