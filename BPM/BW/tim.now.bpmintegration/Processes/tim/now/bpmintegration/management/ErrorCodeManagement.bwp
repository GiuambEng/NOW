                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e76534b5-cf2d-401e-9109-089959fb3397+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdatePPSLAVORAZIONEHD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;TIMSTP_CHIUSURA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CHIUSURA>&#xa;            &lt;ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:idAnagCaus&quot;/>&#xa;            &lt;/ID_ANAG_CAUS>&#xa;            &lt;CAUS_ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:codCausInternoNew)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:codCausInternoNew&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CAUS_ESITO>&#xa;            &lt;DESCR_CAUS_ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:descrCausInternoNew)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:descrCausInternoNew&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_CAUS_ESITO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO), month-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO), day-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO), hours-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO), minutes-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO), xsd:integer(seconds-from-dateTime($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO)))&quot;/>&#xa;            &lt;/TIMSTP_AGGTO_RICH_OLO>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpdatePPSLAVORAZIONEHD-input"
                                    name="UpdatePPSLAVORAZIONEHD"
                                    outputVariable="UpdatePPSLAVORAZIONEHD"
                                    tibex:xpdlId="e76534b5-cf2d-401e-9109-089959fb3397" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
