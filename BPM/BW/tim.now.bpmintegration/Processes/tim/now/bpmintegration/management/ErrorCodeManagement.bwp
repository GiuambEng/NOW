                                tibex:xpdlId="df7d30ea-fd55-48d5-8e6d-60ca14713f64" variable="ReplyRecuperaCausaliValideFault-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" version="2.0"&gt;
    &lt;xsl:template name="ReplyRecuperaCausaliValideFault-input" match="/"&gt;
        &lt;tns:Fault&gt;
            &lt;parameters&gt;
                &lt;ecm:Fault&gt;
                    &lt;ecm:CodiceErrore&gt;
                        &lt;xsl:value-of select="'KO'"/&gt;
                    &lt;/ecm:CodiceErrore&gt;
                    &lt;ecm:MessaggioErrore&gt;
                        &lt;xsl:value-of select="'Codice Causale non disponibile'"/&gt;
                    &lt;/ecm:MessaggioErrore&gt;
                &lt;/ecm:Fault&gt;
            &lt;/parameters&gt;
        &lt;/tns:Fault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ReplyRecuperaCausaliValideFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;ecm:Fault>&#xa;            &lt;ecm:CodiceErrore>&#xa;                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;            &lt;/ecm:CodiceErrore>&#xa;            &lt;ecm:MessaggioErrore>&#xa;                &lt;xsl:value-of select=&quot;'Codice Causale non disponibile'&quot;/>&#xa;            &lt;/ecm:MessaggioErrore>&#xa;        &lt;/ecm:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
