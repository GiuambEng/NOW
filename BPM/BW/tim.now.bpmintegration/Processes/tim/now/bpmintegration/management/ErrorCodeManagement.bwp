                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/ecm:Esito&gt;
            &lt;/parameters&gt;
        &lt;/tns:MonitoraggioCautelareResponse&gt;
    &lt;/xsl:template&gt;
