                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+717cac50-3ee6-414c-bf87-5271fe37fa01+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaCausaliValide.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryCausaliValide-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide.parameters/ecm:TipoLinea) >0&quot;>&#xa;                    &lt;TIPOLG_LINEA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide.parameters/ecm:TipoLinea)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide.parameters/ecm:TipoLinea&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_LINEA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPOLG_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/TIPOLG_LINEA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide.parameters/ecm:Lavorazione) > 0&quot;>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide.parameters/ecm:Lavorazione)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide.parameters/ecm:Lavorazione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FASE>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide.parameters/ecm:Fase&quot;/>&#xa;            &lt;/FASE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide.parameters/ecm:Servizio)>0&quot;>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide.parameters/ecm:Servizio)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide.parameters/ecm:Servizio&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide.parameters/ecm:Servizio)>0&quot;>&#xa;                    &lt;PROVENIENZA>&#xa;                        &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;                    &lt;/PROVENIENZA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PROVENIENZA>&#xa;                        &lt;xsl:value-of select=&quot;'XML'&quot;/>&#xa;                    &lt;/PROVENIENZA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide.parameters/ecm:CodificaOLO_AGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT AC.ID_ANAG_CAUS, AC.DESCR_CAUS_NOW_DG, AC.DESCR_CAUS_OLO, AC.COD_CAUS_INTERNO,&#xd;&#xa;  AC.DESCR_CAUS_INTERNO, AC.COD_CAUS_OLO, AC.COD_CAUS_NOW_DG, ACF.FLAG_ANALISI_CAUS &#xd;&#xa;  FROM ANAG_CAUS_FASE ACF, TIPOLG_LINEA TL,TIPOLG_LAVRZ TLAV, FASE F, ANAG_CAUS AC, TRASCODFC_OFFERTA TRO, OFFERTA O&#xd;&#xa;  WHERE (TL.TIPOLG_LINEA = ? or TL.TIPOLG_LINEA = 'ALL') AND ACF.IDTPLG_LINEA = TL.IDTPLG_LINEA &#xd;&#xa;  AND (TLAV.TIPOLG_LAVRZ = ? or TLAV.TIPOLG_LAVRZ = 'ALL')  AND ACF.IDTPLG_LAVRZ = TLAV.IDTPLG_LAVRZ &#xd;&#xa;  AND F.FASE = ? AND F.ID_FASE = ACF.ID_FASE AND ACF.ID_ANAG_CAUS = AC.ID_ANAG_CAUS AND &#xd;&#xa;  ((O.ID_OFFERTA = ACF.ID_OFFERTA AND O.OFFERTA = 'ALL') OR (TRO.ID_OFFERTA = ACF.ID_OFFERTA AND TRO.NOME_OFFERTA_ESTERNA = ? AND TRO.PROVENIENZA = ?)) AND &#xd;&#xa;  (ACF.CODFC_OLO_AGCOM = ? OR ACF.CODFC_OLO_AGCOM IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LINEA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FASE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_NOW_DG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_NOW_DG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ANALISI_CAUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:reply faultName="Fault"
                                name="ReplyRecuperaCausaliValideFault"
                                operation="RecuperaCausaliValide"
