                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e76534b5-cf2d-401e-9109-089959fb3397+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdatePPSLAVORAZIONEHD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;TIMSTP_CHIUSURA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CHIUSURA>&#xa;            &lt;ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:idAnagCaus&quot;/>&#xa;            &lt;/ID_ANAG_CAUS>&#xa;            &lt;CAUS_ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare.parameters/ecm:codCausInternoNew)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:codCausInternoNew&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CAUS_ESITO>&#xa;            &lt;DESCR_CAUS_ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare.parameters/ecm:descrCausInternoNew)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:descrCausInternoNew&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_CAUS_ESITO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO), month-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO), day-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO), hours-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO), minutes-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO), xsd:integer(seconds-from-dateTime($MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO)))&quot;/>&#xa;            &lt;/TIMSTP_AGGTO_RICH_OLO>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE PPS_LAVRZ_HD SET TIMSTP_CHIUSURA = ?, ID_ANAG_CAUS = ?, CAUS_ESITO=?, &#xa;DESCR_CAUS_ESITO = ? WHERE ID_RICH_OLO = ? AND TIMSTP_AGGTO_RICH_OLO = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_CHIUSURA"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ANAG_CAUS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ESITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_CAUS_ESITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO_RICH_OLO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
