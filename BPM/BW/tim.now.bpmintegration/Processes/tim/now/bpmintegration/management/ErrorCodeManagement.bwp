                &lt;/ecm:TrascodificaCausaleResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns:TrascodificaCausaleResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
