                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3ab36858-5399-4b07-87ad-373c666ca942+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare&quot;/>&#xa;    &lt;xsl:template name=&quot;Select_AnagCausFase_Off-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:idAnagCaus&quot;/>&#xa;            &lt;/ID_ANAG_CAUS>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Select_AnagCausFase_Off-input"
                                    name="Select_AnagCausFase_Off"
                                    outputVariable="Select_AnagCausFase_Off"
                                    tibex:xpdlId="3ab36858-5399-4b07-87ad-373c666ca942" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_AnagCausFase_ControlloOK"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectCodCausIntToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3ab36858-5399-4b07-87ad-373c666ca942+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Select_AnagCausFase_Off-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:idAnagCaus&quot;/>&#xa;            &lt;/ID_ANAG_CAUS>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MonitoraggioCautelare.parameters/ecm:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AC.COD_CAUS_INTERNO, AC.DESCR_CAUS_INTERNO, ACF.ID_OFFERTA &#xa; FROM ANAG_CAUS AC, ANAG_CAUS_FASE ACF&#xa; WHERE AC.ID_ANAG_CAUS = ? AND ACF.ID_ANAG_CAUS = AC.ID_ANAG_CAUS&#xa; AND ACF.ID_OFFERTA = (SELECT O.ID_OFFERTA FROM TRASCODFC_OFFERTA O WHERE O.NOME_OFFERTA_ESTERNA = ? AND O.PROVENIENZA = 'BPM')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAG_CAUS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
