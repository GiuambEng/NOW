                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+717cac50-3ee6-414c-bf87-5271fe37fa01+input&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaCausaliValide&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryCausaliValide-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:TipoLinea) >0&quot;>&#xa;                    &lt;TIPOLG_LINEA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:TipoLinea)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:TipoLinea&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_LINEA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPOLG_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/TIPOLG_LINEA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Lavorazione) > 0&quot;>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Lavorazione)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Lavorazione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FASE>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Fase&quot;/>&#xa;            &lt;/FASE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Servizio)>0&quot;>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Servizio)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaCausaliValide/parameters/ecm:RecuperaCausaliValide/ecm:Servizio&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;   