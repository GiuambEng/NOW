                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEndMonitoraggioCautelare-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ErrorCodeManagement'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ErrorCodeManagementPortype'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'MonitoraggioCautelare'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('MonitoraggioCautelare', 'End')&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.management&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioCautelare&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioCautelare_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioCautelare_&amp;quot;, $MonitoraggioCautelare.parameters/ecm:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/InsertPPSLavorazioneHD&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCausFase_Off&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCaus&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCausFase_Lavrz&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectLavrManStorico_CodDescr&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Insert>&#xa;            &lt;tns1:TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TMSTP_AggRichOLO&quot;/>&#xa;            &lt;/tns1:TIMSTP_AGGTO_RICH_OLO>&#xa;            &lt;tns1:TIMSTP_CHIUSURA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns1:TIMSTP_CHIUSURA>&#xa;            &lt;tns1:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:ID_RICH_OLO>&#xa;            &lt;tns1:ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:idAnagCaus&quot;/>&#xa;            &lt;/tns1:ID_ANAG_CAUS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCaus/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'CAUSALE NON ESISTENTE'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCaus/Record) > 0 and (string-length($Select_AnagCaus/Record[1]/COD_CAUS_INTERNO) = 0 or string-length($Select_AnagCaus/Record[1]/DESCR_CAUS_INTERNO) = 0)&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'DESCRIZIONE ERRATA'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCausFase_Lavrz/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'NON ESISTE CAUSALE PER CAUSALE ORDINE'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCausFase_Off/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'NON ESISTE CAUSALE PER SERVIZIO'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'GENERICO'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:EsitoVerifica=upper-case('IMPROPRIO')&quot;>&#xa;                    &lt;tns1:TIPO_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'Cautelare'&quot;/>&#xa;                    &lt;/tns1:TIPO_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:TIPO_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'Warning'&quot;/>&#xa;                    &lt;/tns1:TIPO_ERRORE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectLavrManStorico_CodDescr/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectLavrManStorico_CodDescr/Record[1]/COD_CAUS_INTERNO&quot;>&#xa;                        &lt;tns1:CAUS_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SelectLavrManStorico_CodDescr/Record[1]/COD_CAUS_INTERNO&quot;/>&#xa;                        &lt;/tns1:CAUS_ESITO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:CAUS_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectLavrManStorico_CodDescr/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectLavrManStorico_CodDescr/Record[1]/DESCR_CAUS_INTERNO&quot;>&#xa;                        &lt;tns1:DESCR_CAUS_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SelectLavrManStorico_CodDescr/Record[1]/DESCR_CAUS_INTERNO&quot;/>&#xa;                        &lt;/tns1:DESCR_CAUS_ESITO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:DESCR_CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:DESCR_CAUS_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:Insert>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperInsert-input"
                                    name="MapperInsert"
                                    outputVariable="MapperInsert"
                                    tibex:xpdlId="bb457383-fd78-410b-bd0d-78fbd821018a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectLavrManStorico_CodDescrToMapperInsert"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperInsertToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/InsertPPSLavorazioneHD&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MonitoraggioCautelare.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCausFase_Off&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCaus&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_AnagCausFase_Lavrz&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectLavrManStorico_CodDescr&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Insert>&#xa;            &lt;tns1:TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:TMSTP_AggRichOLO&quot;/>&#xa;            &lt;/tns1:TIMSTP_AGGTO_RICH_OLO>&#xa;            &lt;tns1:TIMSTP_CHIUSURA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns1:TIMSTP_CHIUSURA>&#xa;            &lt;tns1:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:ID_RICH_OLO>&#xa;            &lt;tns1:ID_ANAG_CAUS>&#xa;                &lt;xsl:value-of select=&quot;$MonitoraggioCautelare.parameters/ecm:idAnagCaus&quot;/>&#xa;            &lt;/tns1:ID_ANAG_CAUS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCaus/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'CAUSALE NON ESISTENTE'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCaus/Record) > 0 and (string-length($Select_AnagCaus/Record[1]/COD_CAUS_INTERNO) = 0 or string-length($Select_AnagCaus/Record[1]/DESCR_CAUS_INTERNO) = 0)&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'DESCRIZIONE ERRATA'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCausFase_Lavrz/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'NON ESISTE CAUSALE PER CAUSALE ORDINE'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Select_AnagCausFase_Off/Record) = 0&quot;>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'NON ESISTE CAUSALE PER SERVIZIO'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CAUS_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'GENERICO'&quot;/>&#xa;                    &lt;/tns1:CAUS_ERRORE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MonitoraggioCautelare.parameters/ecm:EsitoVerifica=upper-case('IMPROPRIO')&quot;>&#xa;                    &lt;tns1:TIPO_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'Cautelare'&quot;/>&#xa;                    &lt;/tns1:TIPO_ERRORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:TIPO_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;'Warning'&quot;/>&#xa;                    &lt;/tns1:TIPO_ERRORE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectLavrManStorico_CodDescr/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectLavrManStorico_CodDescr/Record[1]/COD_CAUS_INTERNO&quot;>&#xa;                        &lt;tns1:CAUS_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SelectLavrManStorico_CodDescr/Record[1]/COD_CAUS_INTERNO&quot;/>&#xa;                        &lt;/tns1:CAUS_ESITO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:CAUS_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectLavrManStorico_CodDescr/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectLavrManStorico_CodDescr/Record[1]/DESCR_CAUS_INTERNO&quot;>&#xa;                        &lt;tns1:DESCR_CAUS_ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SelectLavrManStorico_CodDescr/Record[1]/DESCR_CAUS_INTERNO&quot;/>&#xa;                        &lt;/tns1:DESCR_CAUS_ESITO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:DESCR_CAUS_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:DESCR_CAUS_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:Insert>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
