                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBC_CAUS_COD_SESS/Record) > 0 and string-length(string($JDBC_CAUS_COD_SESS/Record[1]/ID_ANAG_CAUS)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
