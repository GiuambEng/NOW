ice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns1:track_position>&#xa;                        &lt;tns1:ErrorReport>&#xa;                            &lt;tns1:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/StackTrace&quot;/>&#xa;                            &lt;/tns1:StackTrace>&#xa;                            &lt;tns1:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/Msg&quot;/>&#xa;                            &lt;/tns1:Msg>&#xa;                            &lt;tns1:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/ProcessStack&quot;/>&#xa;                            &lt;/tns1:ProcessStack>&#xa;                            &lt;tns1:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                            &lt;/tns1:MsgCode>&#xa;                            &lt;tns1:Data/>&#xa;                        &lt;/tns1:ErrorReport>&#xa;                    &lt;/tns1:ErrorLog>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
