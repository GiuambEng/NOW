                                    sqlStatement="INSERT INTO LAVRZ_MANUALE_STORICO (ID_RICH_OLO,ID_RISORSA,COD_ORDN_OLO,PROGRS_TENTATIVI,COD_CAUS_INTERNO,DESCR_CAUS_INTERNO,ID_ANAG_CAUS&#xd;&#xa;,COD_OLO_NUMERICO,ID_OFFERTA,IDTPLG_LAVRZ,DATA_BLOCCO_LAVRZ,TIPOLG_KO,ID_ANAG_CAUS_FASE,TIMSTP_INSMTO)&#xd;&#xa;VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

