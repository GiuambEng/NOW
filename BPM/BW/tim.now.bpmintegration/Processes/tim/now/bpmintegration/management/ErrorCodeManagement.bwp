&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" version="2.0"&gt;
    &lt;xsl:param name="MonitoraggioCautelare"/&gt;
    &lt;xsl:template name="MonitoraggioCautelareOut-input" match="/"&gt;
        &lt;tns:MonitoraggioCautelareResponse&gt;
            &lt;parameters&gt;
                &lt;ecm:Esito&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$MonitoraggioCautelare/parameters/ecm:MonitoraggioCautelare/ecm:TipoOperazione=upper-case('INSERT')"&gt;
                            &lt;ecm:Codice&gt;
