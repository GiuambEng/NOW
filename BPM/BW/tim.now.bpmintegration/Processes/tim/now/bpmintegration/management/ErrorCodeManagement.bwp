                        &lt;xsl:value-of select="$QueryTrascodificaCausale/Record[1]/DESCR_CAUS_INTERNO"/&gt;
                    &lt;/ecm:DescrizioneCausaleInterna&gt;
                    &lt;ecm:DescrizioneCausaleNowDG&gt;
                        &lt;xsl:value-of select="$QueryTrascodificaCausale/Record[1]/DESCR_CAUS_NOW_DG"/&gt;
