                <bpws:onMessage operation="MonitoraggioCautelare"
                    partnerLink="ErrorCodeManagementPortType"
                    portType="ns1:ErrorCodeManagementPortType"
                    tibex:xpdlId="868b4bda-f998-440a-9283-1be8c65e8d74" variable="MonitoraggioCautelare">
                    <bpws:scope name="scope2">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails4"
                                tibex:faultNameVar="FaultName4" tibex:xpdlId="b2247ce6-dac3-4e41-b31b-4e69be3692e4">
                                <bpws:scope name="scope5">
                                    <bpws:flow name="flow10">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcessToReplyMonitoraggioCautelativo" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:reply faultName="fault"
                                    name="ReplyMonitoraggioCautelativo"
                                    operation="MonitoraggioCautelare"
                                    partnerLink="ErrorCodeManagementPortType"
                                    portType="ns1:ErrorCodeManagementPortType"
                                    tibex:xpdlId="691a6b7e-8f4b-444e-87c3-558a6ecedd23" variable="ReplyMonitoraggioCautelativo-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails4"/&gt;
    &lt;xsl:template name="ReplyMonitoraggioCautelativo-input" match="/"&gt;
        &lt;tns:MonitoraggioCautelareFault&gt;
            &lt;parameters&gt;
                &lt;ecm:Fault&gt;
                    &lt;ecm:CodiceErrore&gt;
                        &lt;xsl:value-of select="$FaultDetails4/MsgCode"/&gt;
                    &lt;/ecm:CodiceErrore&gt;
                    &lt;ecm:MessaggioErrore&gt;
                        &lt;xsl:value-of select="tib:render-xml($FaultDetails4, true(), true())"/&gt;
                    &lt;/ecm:MessaggioErrore&gt;
                &lt;/ecm:Fault&gt;
            &lt;/parameters&gt;
        &lt;/tns:MonitoraggioCautelareFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails4&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyMonitoraggioCautelativo-input&quot; match=&quot;/&quot;>&#xa;        &lt;ecm:Fault>&#xa;            &lt;ecm:CodiceErrore>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails4/MsgCode&quot;/>&#xa;            &lt;/ecm:CodiceErrore>&#xa;            &lt;ecm:MessaggioErrore>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails4, true(), true())&quot;/>&#xa;            &lt;/ecm:MessaggioErrore>&#xa;        &lt;/ecm:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToReplyMonitoraggioCautelativo"/>
                                    </bpws:targets>
                                    </bpws:reply>
                                    <bpws:extensionActivity>
