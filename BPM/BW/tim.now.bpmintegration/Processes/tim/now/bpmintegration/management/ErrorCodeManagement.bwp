                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAG_CAUS, ID_ANAG_CAUS_DONATING&#xa;  FROM APPUSER.CAUS_NOTF_RISC_KO_COD_SESS&#xa;  WHERE COD_SCARTO_DONATING = ? AND AMBITO_SERVIZIO_DONATING = ?&#xa;    AND AMBITO_SERVIZIO_RECIPIENT = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

