    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="TrascodificaCausale" tibex:xpdlId="30a1c3ae-410f-4182-8280-f67b7195dcc5">
                <bpws:onMessage operation="VerificaCongruenzaCausali"
                    partnerLink="ErrorCodeManagementPortType"
                    portType="ns1:ErrorCodeManagementPortType"
                    tibex:xpdlId="1b9e14c5-78b7-4943-a5ee-1e5924e81522" variable="VerificaCongruenzaCausali">
                    <bpws:scope name="VerificaCongruenzaCausali">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="b5533253-5296-4bd2-b13d-6fe14034c694">
                                <bpws:scope name="scope3">
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="LOG_ExceptionToReplyVerCongrCausFault" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:reply faultName="Fault"
                                    name="ReplyVerCongrCausFault"
                                    operation="VerificaCongruenzaCausali"
                                    partnerLink="ErrorCodeManagementPortType"
                                    portType="ns1:ErrorCodeManagementPortType"
                                    tibex:xpdlId="5fe0c063-9312-45d6-8edf-705d95f14d70" variable="ReplyVerCongrCausFault-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/" xmlns:ecm="http://www.tim.com/NOW/xsd/ErrorCodeManagement/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="ReplyVerCongrCausFault-input" match="/"&gt;
        &lt;tns:Fault&gt;
            &lt;parameters&gt;
                &lt;ecm:Fault&gt;
                    &lt;ecm:CodiceErrore&gt;
                        &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                    &lt;/ecm:CodiceErrore&gt;
                    &lt;ecm:MessaggioErrore&gt;
                        &lt;xsl:value-of select="tib:render-xml($FaultDetails)"/&gt;
                    &lt;/ecm:MessaggioErrore&gt;
                &lt;/ecm:Fault&gt;
            &lt;/parameters&gt;
        &lt;/tns:Fault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorCodeManagement/&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyVerCongrCausFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;ecm:Fault>&#xa;            &lt;ecm:CodiceErrore>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;            &lt;/ecm:CodiceErrore>&#xa;            &lt;ecm:MessaggioErrore>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&#xa;            &lt;/ecm:MessaggioErrore>&#xa;        &lt;/ecm:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_ExceptionToReplyVerCongrCausFault"/>
                                    </bpws:targets>
                                    <bpws:correlations/>
                                    </bpws:reply>
                                    <bpws:extensionActivity>
