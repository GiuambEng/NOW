                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ecm=&quot;http://www.tim.com/NOW/xsd/ErrorCodeManagement/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;IdAnagraficaCausaleOut&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_AssignOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ErrorCodeManagement'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ErrorCodeManagementPortType'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TrascodificaCodiceCausale'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperato IdAnagraficaCausale: &amp;quot;, string($IdAnagraficaCausaleOut/ecm:IdAnagraficaCausale))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.management&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TrascodificaCodiceCausale&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TrascodificaCodiceCausale_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
