                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettNGAIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:template name=&quot;MapRichOLODetailNGAAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ParseXmlNGA/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamNGAFTTCAB)&quot;>&#xa;                &lt;tns:MappingCaseRequest>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamNGAFTTCAB/ns0:UserVlan&quot;>&#xa;                        &lt;tns:MappingCaseRequest>&#xa;                            &lt;tns:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNGAIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:ID_RICH_OLO>&#xa;                            &lt;tns:IDTPLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;10&quot;/>&#xa;                            &lt;/tns:IDTPLG_DATO_RICH>&#xa;                            &lt;tns:NOME>&#xa;                                &lt;xsl:value-of select=&quot;upper-case(local-name(ns0:UserVlan_ID))&quot;/>&#xa;                            &lt;/tns:NOME>&#xa;                            &lt;tns:NOTE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNGAIn.input/ns:Note&quot;/>&#xa;                            &lt;/tns:NOTE>&#xa;                            &lt;tns:OPERATORE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNGAIn.input/ns:Operatore&quot;/>&#xa;                            &lt;/tns:OPERATORE>&#xa;                            &lt;tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:PROGRS_TIPOLG_DATO_RICH>&#xa;                            &lt;tns:TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_AGGTO>&#xa;                            &lt;tns:TIMSTP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TIMSTP_INSMTO>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;ns0:UserVlan_ID&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/tns:MappingCaseRequest>&#xa;                        &lt;tns:MappingCaseRequest>&#xa;                            &lt;tns:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNGAIn.input/ns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:ID_RICH_OLO>&#xa;                            &lt;tns:IDTPLG_DATO_RICH>&#xa;                                &lt;xsl:value-of select=&quot;10&quot;/>&#xa;                            &lt;/tns:IDTPLG_DATO_RICH>&#xa;                            &lt;tns:NOME>&#xa;                                &lt;xsl:value-of select=&quot;upper-case(local-name(ns0:CodeVlanSingleTag))&quot;/>&#xa;                            &lt;/tns:NOME>&#xa;                            &lt;tns:NOTE>&#xa;                                &lt;xsl:value-of select=&quot;$RichOLODettNGAIn.input/ns:Note&quot;/>&#xa;                            &lt;/tns:NOTE>&#xa;                            &lt;tns:OPERATORE>&#xa;               