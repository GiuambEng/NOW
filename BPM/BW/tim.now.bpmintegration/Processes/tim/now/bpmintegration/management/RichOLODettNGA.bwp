            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichOLODettNGAIn&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;'tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;RichOLODettNGA&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;CasedataTrackingPortType&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RichOLODettNGA&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Offerta Richiesta: &amp;quot;,$Offerta/Record[1]/OFFERTA,       &amp;quot; - IDFile: &amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDFile,&amp;quot; - ProgrFile: &amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:ProgrRichiestaFile)&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
