                                    expression="$Offerta/Record[1]/OFFERTA=('FWAITALIA1GIGASARDEGNA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Offerta/Record[1]/OFFERTA=('FWAITALIA1GIGASARDEGNA')]]></bpws:transitionCondition>
