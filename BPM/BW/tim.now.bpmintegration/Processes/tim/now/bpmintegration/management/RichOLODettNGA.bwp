                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Offerta/Record[1]/OFFERTA=('FEEDER','SEDEOLT','CANALE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Offerta/Record[1]/OFFERTA=('FEEDER','SEDEOLT','CANALE')]]></bpws:transitionCondition>
                        </bpws:source>
