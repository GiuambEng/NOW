                                    expression="$Offerta/Record[1]/OFFERTA=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
