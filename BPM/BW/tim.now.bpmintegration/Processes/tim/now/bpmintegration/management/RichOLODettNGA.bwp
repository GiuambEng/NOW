                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e05ec567-088c-4745-a2a8-d09f8b168e2a+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichOLODettNGAIn&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaFlussoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperaFlussoFile/Record[1]/FLUSSO='RichSediOLT'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;update ST_SEDIOLTMA_OAO_FL set IDRICHIESTAOLO = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDRichiestaOLO,&amp;quot;' where ID_FILE_PROCSTO_INPUT = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDFile,&amp;quot;' and NUMERO_RECORD = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:ProgrRichiestaFile,&amp;quot;'&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperaFlussoFile/Record[1]/FLUSSO='RichCanaleFeerder'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;update ST_CANALIFEDERMA_OAO_FL set IDRICHIESTAOLO = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDRichiestaOLO,&amp;quot;' where ID_FILE_PROCSTO_INPUT = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDFile,&amp;quot;' and NUMERO_RECORD = '&amp;quot;,$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:ProgrRichiestaFile,&amp;quot;'&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                