            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingCaseRequest&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/RichOLODett&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&lt;xsl:param name=&quot;RichOLODettNGAIn&quot;/>&lt;xsl:template name=&quot;MapRichOLODetailVariazioneNGA-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlNGA/ns0:TipoRichiesta/ns0:Variazione)&quot;>&lt;tns:MappingCaseRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXmlNGA/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTCAB)&quot;>&lt;tns:MappingCaseRequest>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:IDTPLG_DATO_RICH>&lt;xsl:value-of select=&quot;27&quot;/>&lt;/tns:IDTPLG_DATO_RICH>&lt;tns:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($ParseXmlNGA/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTCAB/ns0:CodiceQualita))&quot;/>&lt;/tns:NOME>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:Note&quot;/>&lt;/tns:NOTE>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;$RichOLODettNGAIn/input/ns:RichOLODettNGA_Request/ns:Operatore&quot;/>&lt;/tns:OPERATORE>&lt;tns:PROGRS_TIPOLG_DATO_RICH>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:PROGRS_TIPOLG_DATO_RICH>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$ParseXmlNGA/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTCAB/ns0:Cod