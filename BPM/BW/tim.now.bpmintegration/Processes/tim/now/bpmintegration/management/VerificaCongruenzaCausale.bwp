                   &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI) > 1&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[string-length(CODFC_OLO_AGCOM) > 0]/FLAG_ANALISI_CAUS = &amp;quot;Y&amp;quot;&quot;>&#xa;                                &lt;ecm:VerificaCongruenzaCausaleResponse>&#xa;                                    &lt;ecm:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;IMPROPRIO&amp;quot;&quot;/>&#xa;                                    &lt;/ecm:Esito>&#xa;                                    &lt;xsl:if test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[string-length(CODFC_OLO_AGCOM) > 0]/FLAG_TIMEOUT=&amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;ecm:Flag_timeout>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/ecm:Flag_timeout>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[not(exists(CODFC_OLO_AGCOM)) or string-length(CODFC_OLO_AGCOM) = 0][1]/FLAG_ANALISI_CAUS = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;ecm:VerificaCongruenzaCausaleResponse>&#xa;                                            &lt;ecm:Esito>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;IMPROPRIO&amp;quot;&quot;/>&#xa;                                            &lt;/ecm:Esito>&#xa;                                            &lt;xsl:if test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[not(exists(CODFC_OLO_AGCOM)) or string-length(CODFC_OLO_AGCOM) = 0][1]/FLAG_TIMEOUT = &amp;quot;Y&amp;quot;&quot;>&#xa;                                                &lt;ecm:Flag_timeout>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/ecm:Flag_timeout>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ecm:VerificaCongruenzaCausaleResponse>&#xa;                                            &lt;ecm:Esito>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;SCARTO&amp;quot;&quot;/>&#xa;                                            &lt;/ecm:Esito>&#xa;                                        &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[1]/FLAG_ANALISI_CAUS = &amp;quot;Y&amp;quot;&quot;>&#xa;                                &lt;ecm:VerificaCongruenzaCausaleResponse>&#xa;                                    &lt;ecm:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;IMPROPRIO&amp;quot;&quot;/>&#xa;                                    &lt;/ecm:Esito>&#xa;                                    &lt;xsl:if test=&quot;$JDBCProcedure/outputSet/RESULTSET/APPUSER.TOUTS_CONGRUENZA_CAUSALI[1]/FLAG_TIMEOUT= &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;ecm:Flag_timeout>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/ecm:Flag_timeout>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ecm:VerificaCongruenzaCausaleResponse>&#xa;                                    &lt;ecm:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;SCARTO&amp;quot;&quot;/>&#xa;                                    &lt;/ecm:Esito>&#xa;                                &lt;/ecm:VerificaCongruenzaCausaleResponse>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
