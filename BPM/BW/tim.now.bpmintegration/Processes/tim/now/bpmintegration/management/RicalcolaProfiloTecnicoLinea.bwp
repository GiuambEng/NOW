                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericEnrichment&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectProfiloTecnicoLinea&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RicalcolaProfiloTecnicoLinea_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ProfiloTecnicoLinea) and string-length($Start/tns:ProfiloTecnicoLinea[1])>0&quot;>&lt;xsl:if test=&quot;$Start/tns:ProfiloTecnicoLinea[1]&quot;>&lt;tns:ProfiloTecnicoCalcolato>&lt;xsl:value-of select=&quot;$Start/tns:ProfiloTecnicoLinea[1]&quot;/>&lt;/tns:ProfiloTecnicoCalcolato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($Start/tns:ProfiloTecnicoLinea)) or string-length($Start/tns:ProfiloTecnicoLinea[1])=0) and (not(exists($Start/tns:Caratteristica)) or string-length($Start/tns:Caratteristica[1])=0)&quot;>&lt;xsl:if test=&quot;$Start/tns:ConsistenzaDati/tns1:ProfiloTecnicoLinea&quot;>&lt;tns:ProfiloTecnicoCalcolato>&lt;xsl:value-of select=&quot;$Start/tns:ConsistenzaDati/tns1:ProfiloTecnicoLinea&quot;/>&lt;/tns:ProfiloTecnicoCalcolato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$SelectProfiloTecnicoLinea/Record[1]/PROFILO_TCNC_LINEA&quot;>&lt;tns:ProfiloTecnicoCalcolato>&lt;xsl:value-of select=&quot;$SelectProfiloTecnicoLinea/Record[1]/PROFILO_TCNC_LINEA&quot;/>&lt;/tns:ProfiloTecnicoCalcolato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RicalcolaProfiloTecnicoLinea_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
