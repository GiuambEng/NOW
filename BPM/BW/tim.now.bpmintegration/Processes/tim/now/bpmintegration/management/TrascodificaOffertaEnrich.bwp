                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.ID_OFFERTA, TRIM(UPPER(O.NOME_OFFERTA_CATLG)) AS NOME_OFFERTA_CATLG,O.LNA_LA&#xa;FROM TRASCODFC_OFFERTA TRO, OFFERTA O&#xa;WHERE O.ID_OFFERTA = TRO.ID_OFFERTA AND TRO.NOME_OFFERTA_ESTERNA = ? AND TRO.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_CATLG"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LNA_LA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
