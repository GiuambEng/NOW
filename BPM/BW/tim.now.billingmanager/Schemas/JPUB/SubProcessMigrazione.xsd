<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/xsd/SubProcessMigrazione/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/SubProcessMigrazione/"
	xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1">


	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="Asset" type="Q1:Asset"
					maxOccurs="unbounded" minOccurs="0">
				</element>
				<element name="Richiesta" type="Q1:Richiesta"
					maxOccurs="1" minOccurs="1">
				</element>
				<element name="Lavorazione" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Stato" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="StatoAggiuntivi" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="StatoAggiuntivi"
								type="string">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="FlagAssetMigrati" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="AssetPrincipale" type="Q1:Asset"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="StatoFatturazioneMigrazione"
					maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>
							<element name="StatoFatturazione"
								type="string">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="LavorazioniIndotte" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="TSHA_ULLD" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="TBUNDLE" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="NewBilling" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="ID_RECUPERO_JPUB_MASTER"
						maxOccurs="unbounded" minOccurs="0">
						<complexType>
							<sequence>
								<element name="ID_RECUPERO_JPUB_MASTER"
									type="int" maxOccurs="1" minOccurs="0">
								</element>
								<element name="BDS_ID"
									type="integer" maxOccurs="1" minOccurs="0">
								</element>
							</sequence>
						</complexType>
					</element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="Response" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="Code" type="string"></element>
							<element name="Msg" type="string"></element>
							<element name="NumeriAggiuntivi"
								maxOccurs="unbounded" minOccurs="0">
								<complexType>
									<sequence>
										<element name="Code"
											type="string">
										</element>
										<element name="Msg"
											type="string">
										</element>
										<element name="Identificativo"
											type="string">
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="IDRisorsa" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="IDRichOLO" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="IDDettaglioOrdine" type="int"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="ID_EVENTO_ORDN_NOW_WHLS" type="int" maxOccurs="1" minOccurs="0"></element>
							<element name="ID_EVENTO_STS" type="int" maxOccurs="1" minOccurs="0"></element>
							<element name="Control" type="string" maxOccurs="1" minOccurs="0"></element>
							<element name="Parking" type="string" maxOccurs="1" minOccurs="0"></element>
							<element name="ParkingInvioDRO" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Msg" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="Code" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>