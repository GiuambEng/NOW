<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/DeleteRecord/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/DeleteRecord/"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="Timer" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="Timer" type="string"></element>
						</sequence>
					</complexType>
				</element>
				<element name="BPMRequest" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ID_RICH_OLO" type="string"></element>
							<element name="NP" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="ID_RISORSA" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Asset" maxOccurs="1"
								minOccurs="0" type="pref:Asset">
							</element>
							<element name="Lavorazione" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Richiesta"
								type="pref:Richiesta" maxOccurs="1" minOccurs="0">
							</element>
							<element name="FlagAssetMigrati"
								type="boolean" maxOccurs="1" minOccurs="0">
							</element>
							<element name="LavorazioneIndotte"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="NPSync" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
				<element name="FlagMigrazione" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="FlagOpereSpeciali" type="boolean" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Code" type="string"></element>
				<element name="Message" type="string"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="Timer" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>