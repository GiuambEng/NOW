<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ControlCode/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ControlCode/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="DESCR" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_ORDINE_COMPOSTO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FLAG_CONSUNTIVO" type="int" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_RICH_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FlagControl" type="boolean" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

</schema>