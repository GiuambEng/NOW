<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/">

    <xs:element name="Request" type="tns:RequestType"/>
    
    <xs:complexType name="RequestType">
    	
    	<xs:sequence>
    		<xs:element name="Dati" type="tns:Dati_In_Type"
    			minOccurs="0" maxOccurs="unbounded">
    		</xs:element>
    		<xs:element name="Distretto" type="xs:string" maxOccurs="1"
    			minOccurs="0">
    		</xs:element>
    		<xs:element name="Offerta" type="xs:string" maxOccurs="1"
    			minOccurs="0">
    		</xs:element>
    		<xs:element name="id_rich_olo" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
    	</xs:sequence>
    </xs:complexType>


    <xs:complexType name="Dati_In_Type">
		
			<xs:choice>
				<xs:element name="ATMVC" type="tns:ATMVC_Type"/>
				<xs:element name="GBEVC" type="tns:GBEVC_Type"/>
				<xs:element name="USERVLAN" type="tns:USERVLAN_Type"/>
			</xs:choice>
		
	</xs:complexType>
	
	<xs:complexType name="ATMVC_Type">
		<xs:sequence>
			<xs:element name="VPI" type="xs:string" minOccurs="0"/>
			<xs:element name="VCI" type="xs:string" minOccurs="0"/>
			<xs:element name="TIPOPROFILOVC" type="xs:string" minOccurs="0"/>
			<xs:element name="MCRDOWN" type="xs:string" minOccurs="0"/>
			<xs:element name="MCRUP" type="xs:string" minOccurs="0"/>
			<xs:element name="PCRDOWN" type="xs:string" minOccurs="0"/>
			<xs:element name="PCRUP" type="xs:string" minOccurs="0"/>
			<xs:element name="SCRDOWN" type="xs:string" minOccurs="0"/>
			<xs:element name="SCRUP" type="xs:string" minOccurs="0"/>
			<xs:element name="TIPOBANDACONSEGNA" type="xs:string" minOccurs="0"/>
			<xs:element name="CODICEVP" type="xs:string" minOccurs="0"/>
			<xs:element name="CODICETD" type="xs:string" minOccurs="0"/>
			<xs:element name="TRASPORTO" type="xs:string" minOccurs="0"/>
			<xs:element name="IDPROFILOVC" type="xs:string" minOccurs="0"/>
			<xs:element name="IDRISORSAVC" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="GBEVC_Type">
		<xs:sequence>
			<xs:element name="VPI" type="xs:string" minOccurs="0"/>
			<xs:element name="VCI" type="xs:string" minOccurs="0"/>
			<xs:element name="SVLANCODE" type="xs:string" minOccurs="0"/>
			<xs:element name="CVLANID" type="xs:string" minOccurs="0"/>
			<xs:element name="CODEVLANSINGLETAG" type="xs:string" minOccurs="0"/>
			<xs:element name="PROFILOBMD" type="xs:string" minOccurs="0"/>
			<xs:element name="PROTOCOLLOPILA" type="xs:string" minOccurs="0"/>
			<xs:element name="IPDSLAM" type="xs:string" minOccurs="0"/>
			<xs:element name="TIPOTRASPORTO" type="xs:string" minOccurs="0"/>
			<xs:element name="IPKIT" type="xs:string" minOccurs="0"/>
			<xs:element name="IDRISORSAVC" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="USERVLAN_Type">
		<xs:sequence>
			<xs:element name="USERVLANID" type="xs:string" minOccurs="0"/>
			<xs:element name="SVLANCODE" type="xs:string" minOccurs="0"/>
			<xs:element name="CVLANID" type="xs:string" minOccurs="0"/>
			<xs:element name="CODEVLANSINGLETAG" type="xs:string" minOccurs="0"/>
			<xs:element name="PROFILOBMD" type="xs:string" minOccurs="0"/>
			<xs:element name="BANDAPICCOUP" type="xs:string" minOccurs="0"/>
			<xs:element name="BANDAPICCODOWN" type="xs:string" minOccurs="0"/>
			<xs:element name="TIPOTRASPORTO" type="xs:string" minOccurs="0"/>
			<xs:element name="IDRISORSAUSERVLAN" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
    
   
		
    
	<xs:element name="Response">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CodeArea" type="xs:string"></xs:element>
				<xs:element name="CodeMacroArea" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
