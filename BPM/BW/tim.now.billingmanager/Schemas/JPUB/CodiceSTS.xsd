<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/CodiceSTS/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/CodiceSTS/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="CodeSTS" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Attributo" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="IDRichOLO" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="CodeSTSOutput" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="AttributoOutput" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>