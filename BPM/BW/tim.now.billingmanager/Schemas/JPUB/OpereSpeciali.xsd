<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/OpereSpeciali/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/OpereSpeciali/"
	xmlns:pref="http://xsd.telecomitalia.it/Schema/jpub/"
	xmlns:pref1="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:pref2="http://www.tim.com/NOW/xsd/InvioJPUB/">

	<import schemaLocation="OrdiniCRMWS_Reg_2.23.xsd"
		namespace="http://xsd.telecomitalia.it/Schema/jpub/">
	</import>
	<import schemaLocation="JPUB_XSD_20160401.xsd"
		namespace="http://xsd.telecomitalia.it/Schema/jpubADSL/">
	</import>
	<import schemaLocation="InvioJPUB.xsd" namespace="http://www.tim.com/NOW/xsd/InvioJPUB/"></import>
	<element name="OpereSpecialiRequest">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string"
					maxOccurs="1" minOccurs="1">
				</element>
				<element name="IDContratto" type="int" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="CodiceOrdineOLO" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Offerta" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="DRO" type="date" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="IDOrdineComposto" type="string"
					maxOccurs="1" minOccurs="1">
				</element>
				<element name="IDPreventivo" type="int" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="IDRisorsa" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Staging">
					<complexType>
						<sequence>
							<element name="Operatore" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="CodificaOLOAgicom"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="IDProcsoNoFile" type="int"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="IDDettaglioOrdine" type="int"
								maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="StrutturaRichiesta" type="string"
					maxOccurs="1" minOccurs="1">
				</element>
				<element ref="pref2:SendJPUBRequest" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="OpereSpecialiResponse">
		<complexType>
			<sequence>
				<element ref="pref:REGOLATORIO" maxOccurs="1"
					minOccurs="0">
				</element>
				<element ref="pref1:ORDINI_CRMWS" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Stato" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="ResponseStaging" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ResponseStaging"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="ControlloStaging" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="UpdateGestione" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ID_Rich_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
							<element name="ID_Evento_Ordn_Now_Whls" type="int" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

</schema>