                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.ID_RICH_OLO, T.DESCR_STATO_EVENTO_JPUB, E.ID_ORDINE_COMPOSTO&#xa;FROM EVENTO_JPUB E, TIPOLG_STATO_EVENTO_JPUB T &#xa;WHERE E.ID_ORDINE_COMPOSTO = ?  AND FLAG_CONSUNTIVO=? AND E.IDTPLG_STATO_EVENTO_JPUB = T.IDTPLG_STATO_EVENTO_JPUB ORDER BY ID_EVENTO_ORDN_NOW_WHLS" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE_COMPOSTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_EVENTO_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ORDINE_COMPOSTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
