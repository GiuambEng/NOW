            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLLINEANONATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLDATILINEANONATTIVA'or  upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='NP' or (upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLDATILINEAATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLLINEAATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLDATILINEAATTIVANP' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='ULLLINEAATTIVANP') or (upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='WLRLINEAATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='WLR' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='WLRLINEANONATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='VARIAZIONEWLR' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SLULINEANONATTIVA'or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SLULINEAATTIVA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SLULINEAATTIVANP'  or &#xd;&#xa;upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='VULL'   or&#xd;&#xa;upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='VULLLINEANONATTIVA' or&#xd;&#xa;starts-with($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta,'SHA')) then concat ($Offerta,'REGNP') else if (upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMNGAFTTCAB' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMNGAFTTH' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SEMIBITSTREAMNGAFTTH' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='VULAFTTCAB' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='VULAFTTH'or  upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SEMIVULAFTTH'or  (upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMASIMMETRICOFLAT' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMASIMMETRICOHL' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMASIMMETRICOLITE' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPBASEPLUSFLAT' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPBASEPLUSLITE' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPSPECIALPROFILEFLAT'or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPSPECIALPROFILELITE') or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMGBEASIMMETRICOFLAT' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMSIMMETRICOFLAT' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMSIMMETRICOHL' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMGBESIMMETRICOFLAT' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMATMSIMMETRICO' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='BITSTREAMGBESIMMETRICO' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPNGAFTTCAB' or   upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='EASYIPNGAFTTH' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SEMIEASYIPNGAFTTH' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='FIXEDWIRELESSACCESS' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='FULLGPONPLUSNGA' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='FULLGPONPLUS' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='UBBSEMIGPON' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='SEMIGPON1BPNRR' or upper-case($NomeOffertaIn/parameters/tns:NomeOffertaRequest/tns:Offerta)='FULLGPON1BPNRR' ) then concat($Offerta,'NGAXDSL') else concat($Offerta,'Interfaccia')"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Offerta" name="ControlloOfferta"
                    outputVariable="Offerta"
                    tibex:xpdlId="6a55d3de-94fe-48fa-80eb-56d40a11d288" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLLINEANONATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLDATILINEANONATTIVA'or  upper-case($NomeOffertaIn.parameters/tns:Offerta)='NP' or (upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLDATILINEAATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLLINEAATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLDATILINEAATTIVANP' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='ULLLINEAATTIVANP') or (upper-case($NomeOffertaIn.parameters/tns:Offerta)='WLRLINEAATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='WLR' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='WLRLINEANONATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='VARIAZIONEWLR' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SLULINEANONATTIVA'or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SLULINEAATTIVA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SLULINEAATTIVANP'  or &#xd;&#xa;upper-case($NomeOffertaIn.parameters/tns:Offerta)='VULL'   or&#xd;&#xa;upper-case($NomeOffertaIn.parameters/tns:Offerta)='VULLLINEANONATTIVA' or&#xd;&#xa;starts-with($NomeOffertaIn.parameters/tns:Offerta,'SHA')) then concat ($Offerta,'REGNP') else if (upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMNGAFTTCAB' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMNGAFTTH' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SEMIBITSTREAMNGAFTTH' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='VULAFTTCAB' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='VULAFTTH'or  upper-case($NomeOffertaIn.parameters/tns:Offerta)='SEMIVULAFTTH'or  (upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMASIMMETRICOFLAT' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMASIMMETRICOHL' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMASIMMETRICOLITE' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPBASEPLUSFLAT' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPBASEPLUSLITE' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPSPECIALPROFILEFLAT'or upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPSPECIALPROFILELITE') or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMGBEASIMMETRICOFLAT' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMSIMMETRICOFLAT' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMSIMMETRICOHL' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMGBESIMMETRICOFLAT' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMATMSIMMETRICO' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='BITSTREAMGBESIMMETRICO' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPNGAFTTCAB' or   upper-case($NomeOffertaIn.parameters/tns:Offerta)='EASYIPNGAFTTH' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SEMIEASYIPNGAFTTH' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='FIXEDWIRELESSACCESS' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='FULLGPONPLUSNGA' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='FULLGPONPLUS' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='UBBSEMIGPON' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='SEMIGPON1BPNRR' or upper-case($NomeOffertaIn.parameters/tns:Offerta)='FULLGPON1BPNRR' ) then concat($Offerta,'NGAXDSL') else concat($Offerta,'Interfaccia')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Offerta" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:reply name="Reply" operation="NomeOfferta"
                partnerLink="NomeOffertaPortType"
                portType="ns2:NomeOffertaPortType"
                tibex:xpdlId="ee6bb8df-34a6-4a45-8b0b-9625baff3236" variable="Reply-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NomeOfferta/" xmlns:tns1="http://www.tim.com/NOW/xsd/JPUB_Util" version="2.0"&gt;&lt;xsl:param name="Offerta"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:NomeOffertaResponse&gt;&lt;parameters&gt;&lt;tns1:NomeOffertaResponse&gt;&lt;tns1:NomeOfferta&gt;&lt;xsl:value-of select="$Offerta"/&gt;&lt;/tns1:NomeOfferta&gt;&lt;/tns1:NomeOffertaResponse&gt;&lt;/parameters&gt;&lt;/tns:NomeOffertaResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NomeOfferta/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NomeOffertaResponse>&#xa;            &lt;tns1:NomeOfferta>&#xa;                &lt;xsl:value-of select=&quot;$Offerta&quot;/>&#xa;            &lt;/tns1:NomeOfferta>&#xa;        &lt;/tns1:NomeOffertaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNomeOffertaOutToReply"/>
                </bpws:targets>
            </bpws:reply>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
