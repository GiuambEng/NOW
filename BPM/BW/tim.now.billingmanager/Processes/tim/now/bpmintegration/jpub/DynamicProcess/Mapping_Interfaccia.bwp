                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;StartMapping_Interfaccia&quot;/>&lt;xsl:template name=&quot;LogInterfaccia-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_Interfaccia&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_Interfaccia&amp;quot;&quot;/>&lt;/tns:Service>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartMapping_Interfaccia/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:if test=&quot;$StartMapping_Interfaccia/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StartMapping_Interfaccia/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($StartMapping_Interfaccia/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&lt;xsl:if test=&quot;$StartMapping_Interfaccia/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StartMapping_Interfaccia/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$StartMapping_Interfaccia/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StartMapping_Interfaccia/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start processo dinamico Mapping_Interfaccia', tib:render-xml($StartMapping_Interfaccia/tns1:BPMRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.DynamicProcess'&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_Interfaccia_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapping_Interfaccia_&amp;quot;, $StartMapping_Interfaccia/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($StartMapping_Interfaccia/tns1:BPMRequest))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($StartMapping_Interfaccia/tns1:BPMRequest, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
