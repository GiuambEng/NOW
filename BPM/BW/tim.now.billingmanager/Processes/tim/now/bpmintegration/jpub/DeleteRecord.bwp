                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AssignDelete/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DeleteRecordIn&quot;/>&lt;xsl:template name=&quot;Struttura&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:FlagMigrazione=true()&quot;>&lt;tns:Struttura>&lt;xsl:if test=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TSHAULLD' or $DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' or starts-with($DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUVULL') or starts-with($DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUWLR') or $DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' or ($DeleteRecordIn/parameters/tns1:Request/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $DeleteRecordIn/parameters/tns1:Request/tns1:BPMReque