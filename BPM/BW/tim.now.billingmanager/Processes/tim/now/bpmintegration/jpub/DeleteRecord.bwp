                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AssignDelete/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DeleteRecordIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Struttura&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$DeleteRecordIn.parameters/tns1:FlagMigrazione=true()&quot;>&#xa;                &lt;tns:Struttura>&#xa;                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RISORSA&quot;>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TSHAULLD' or $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' or starts-with($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUVULL') or starts-with($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUWLR') or $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' or ($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUVULL') or starts-with($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario, 'NPSUWLR') or $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine)&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;>&#xa;                                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;/>&#xa;                                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                                                &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                                    &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                                &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta) and $DeleteRecordIn.parameters/tns1:BPMRequest/tns1:FlagAssetMigrati=true()) or string-length($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:LavorazioneIndotte)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:FLAG_CONS>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns:FLAG_CONS>&#xa;                &lt;/tns:Struttura>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Struttura>&#xa;                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;>&#xa;                        &lt;tns:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RICH_OLO&quot;/>&#xa;                        &lt;/tns:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RISORSA&quot;>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:NPSync,'_S'))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:NPSync,'_A')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine &quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine &quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(upper-case($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                            &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot; upper-case($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/IDDettaglioAsset)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/IDDettaglioAsset &quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/IDDettaglioAsset &quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'RACCOLTA')]/IDDettaglioAsset &quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'RACCOLTA')]/IDDettaglioAsset &quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)])&quot;>&#xa;                                            &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                                                &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                                    &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                                &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$DeleteRecordIn.parameters/tns1:FlagOpereSpeciali=true()&quot;>&#xa;                            &lt;tns:FLAG_CONS>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns:FLAG_CONS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:FLAG_CONS>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/tns:FLAG_CONS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Struttura>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Struttura" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssignDelete/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DeleteRecordIn&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Struttura&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;DeleteRecord&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;DeleteRecordPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;DeleteRecord&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$DeleteRecordIn/parameters/tns2:Request/tns2:BPMRequest/tns2:ID_RICH_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$DeleteRecordIn/parameters/tns2:Request/tns2:BPMRequest/tns2:ID_RICH_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Struttura/tns1:ID_RICH_OLO)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('LogAssignProcessoDelete', tib:render-xml($Struttura,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'LogAssignProcessoDelete valori non restituiti'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogAssign-input" name="LogAssign"
                    tibex:xpdlId="aa8fc76c-b66c-428e-99e3-0cd30a9f2989"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToSelectID_EVENTO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssignDelete/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DeleteRecordIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Struttura&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeleteRecord&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeleteRecordPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DeleteRecord&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$DeleteRecordIn.parameters/tns2:BPMRequest/tns2:ID_RICH_OLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$DeleteRecordIn.parameters/tns2:BPMRequest/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Struttura/tns1:ID_RICH_OLO)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('LogAssignProcessoDelete', tib:render-xml($Struttura,true(),true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;'LogAssignProcessoDelete valori non restituiti'&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
