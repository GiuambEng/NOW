                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STRUTTURA_RICH&#xa;  FROM OFFERTA OFF, TRASCODFC_OFFERTA TRAS&#xa;  WHERE OFF.ID_OFFERTA = TRAS.ID_OFFERTA AND TRAS.NOME_OFFERTA_ESTERNA = ?&#xa;  AND TRAS.PROVENIENZA = 'BPM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

