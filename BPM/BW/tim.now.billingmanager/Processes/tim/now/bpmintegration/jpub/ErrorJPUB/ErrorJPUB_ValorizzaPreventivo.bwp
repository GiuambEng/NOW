                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;calcolaPreventivo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDDETT&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornaStatoPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AggiornaStatoPreventivo_Request>&#xa;            &lt;tns:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:STRUTTURA/ID_RICHIESTA_NOW&quot;/>&#xa;            &lt;/tns:IdRichiestaOLO>&#xa;            &lt;tns:idPreventivo>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($ErrorSchemaIn.Input/tns1:STRUTTURA/ID_PREVENTIVO)&quot;/>&#xa;            &lt;/tns:idPreventivo>&#xa;            &lt;tns:NuovoStatoPreventivo>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INACCETTAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns:NuovoStatoPreventivo>&#xa;            &lt;tns:ImportoTotale>&#xa;                &lt;xsl:value-of select=&quot;$calcolaPreventivo.parameters/PreventivoResponse/TOTALE div 100&quot;/>&#xa;            &lt;/tns:ImportoTotale>&#xa;            &lt;xsl:for-each select=&quot;$calcolaPreventivo.parameters/PreventivoResponse/DettaglioResponse&quot;>&#xa;                &lt;tns:DettagliJPUB>&#xa;                    &lt;tns:IdDettaglio>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($SelectIDDETT/Record[COD_ARTICOLO_JPUB = current()/ID_VOCE]/ID_DETT_PREVENTIVO)&quot;/>&#xa;                    &lt;/tns:IdDettaglio>&#xa;                    &lt;tns:ImportoArticolo>&#xa;                        &lt;xsl:value-of select=&quot;IMPORTO div 100&quot;/>&#xa;                    &lt;/tns:ImportoArticolo>&#xa;                &lt;/tns:DettagliJPUB>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:AggiornaStatoPreventivo_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.integration_library"
                        subProcessName="tim.now.integration_library.operespeciali.AggiornaStatoPreventivo" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $ErrorSchemaIn/Input/tns1:ErrorInput/tns1:STRUTTURA, type, ns:PREVENTIVO -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+22cc731a-b83d-4f53-9cac-67ba0d571883+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ErrorSchemaIn&quot;/>&lt;xsl:template name=&quot;SelectIDDETT-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;IDPREVENTIVO>&lt;xsl:value-of select=&quot;xsd:decimal($ErrorSchemaIn/Input/tns1:ErrorInput/tns1:STRUTTURA/ID_PREVENTIVO)&quot;/>&lt;/IDPREVENTIVO>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectIDDETT-input"
                    name="SelectIDDETT" outputVariable="SelectIDDETT"
                    tibex:xpdlId="22cc731a-b83d-4f53-9cac-67ba0d571883" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OutputValorizzaPreventivoToEmpty"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToPreventivo_Consuntivo"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+22cc731a-b83d-4f53-9cac-67ba0d571883+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectIDDETT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDPREVENTIVO>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($ErrorSchemaIn.Input/tns1:STRUTTURA/ID_PREVENTIVO)&quot;/>&#xa;            &lt;/IDPREVENTIVO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT D.QT_ARTICOLO,D.ID_DETT_PREVENTIVO,D.COD_ARTICOLO_JPUB,D.DATAFI_VALID,D.IMPORTO_ARTICOLO,T.DESCR_ARTICOLO_NOW &#xd;&#xa;FROM DETT_PREVENTIVO D, TRASCODFC_ARTICOLI_DTU_JPUB T &#xd;&#xa;WHERE D.COD_ARTICOLO_JPUB= T.COD_ARTICOLO_JPUB AND ID_PREVENTIVO =?&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDPREVENTIVO"/>
                                    <columnMetadata
                                    columnName="QT_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_DETT_PREVENTIVO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_ARTICOLO_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="IMPORTO_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_ARTICOLO_NOW"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
