                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $ErrorSchemaIn/Input/tns:ErrorInput/tns:ORDINE/*, element, ORDINI_CRMWS -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ErrorSchemaIn&quot;/>&lt;xsl:template name=&quot;RenderJPUBXDSL-input&quot; match=&quot;/&quot;>&lt;ORDINI_CRMWS>&lt;xsl:for-each select=&quot;$ErrorSchemaIn/Input/tns:ErrorInput/tns:ORDINE/ORDINI_CRMWS/TESTATA&quot;>&lt;TESTATA>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&lt;/ID_ORD_CRMWS>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&lt;/DATA_DRO>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&lt;/DATA_MSG>&lt;DATA_DES>&lt;xsl:value-of select=&quot;DATA_DES&quot;/>&lt;/DATA_DES>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&lt;/CODICE_PROGETTO>&lt;xsl:if test=&quot;FLAG_ONE_STEP&quot;>&lt;FLAG_ONE_STEP>&lt;xsl:value-of select=&quot;FLAG_ONE_STEP&quot;/>&lt;/FLAG_ONE_STEP>&lt;/xsl:if>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&lt;/CODE_CAUS>&lt;xsl:if test=&quot;CUSTOMER&quot;>&lt;CUSTOMER>&lt;xsl:value-of select=&quot;CUSTOMER&quot;/>&lt;/CUSTOMER>&lt;/xsl:if>&lt;xsl:if test=&quot;SISTEMA_MITTENTE&quot;>&lt;SISTEMA_MITTENTE>&lt;xsl:value-of select=&quot;SISTEMA_MITTENTE&quot;/>&lt;/SISTEMA_MITTENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(FEEDER)&quot;>&lt;FEEDER>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;FEEDER/TIPO_CONTR&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;FEEDER/CODE_CO