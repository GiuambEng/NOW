                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://crmnow.ordinexdsl.jpub.internal.concrete/" xmlns:tns0="http://crmnow.ordinexdsl.jpub.internal/types/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="ParseXmlXDSL"/&gt;
    &lt;xsl:template name="InvokeProxyXdsl-input" match="/"&gt;
        &lt;ns1:OrdineXDSLCRMNOW_ricezione&gt;
            &lt;parameters&gt;
                &lt;tns0:ricezioneElement&gt;
                    &lt;tns0:ID_ORDINE_CRM&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS)"&gt;
                                &lt;xsl:value-of select="$ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS"/&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns0:ID_ORDINE_CRM&gt;
                    &lt;tns0:ORDINE&gt;
                        &lt;ORDINI_CRMWS&gt;
                            &lt;xsl:copy-of select="$ParseXmlXDSL/TESTATA"/&gt;
                        &lt;/ORDINI_CRMWS&gt;
                    &lt;/tns0:ORDINE&gt;
                &lt;/tns0:ricezioneElement&gt;
            &lt;/parameters&gt;
        &lt;/ns1:OrdineXDSLCRMNOW_ricezione&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://crmnow.ordinexdsl.jpub.internal.concrete/&quot; xmlns:tns0=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeProxyXdsl-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_ORDINE_CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns0:ID_ORDINE_CRM>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;ORDINI_CRMWS>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXmlXDSL/TESTATA&quot;/>&#xa;                &lt;/ORDINI_CRMWS>&#xa;            &lt;/tns0:ORDINE>&#xa;        &lt;/tns0:ricezioneElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
