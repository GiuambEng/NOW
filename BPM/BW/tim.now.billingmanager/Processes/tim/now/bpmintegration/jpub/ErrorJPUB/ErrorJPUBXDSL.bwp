                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderJPUBXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;ORDINI_CRMWS>&#xa;            &lt;xsl:for-each select=&quot;$ErrorSchemaIn.Input/tns:ORDINE/ORDINI_CRMWS/TESTATA&quot;>&#xa;                &lt;TESTATA>&#xa;                    &lt;ID_ORD_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/ID_ORD_CRMWS>&#xa;                    &lt;DATA_DRO>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                    &lt;/DATA_DRO>&#xa;                    &lt;DATA_MSG>&#xa;                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                    &lt;/DATA_MSG>&#xa;                    &lt;DATA_DES>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                    &lt;/DATA_DES>&#xa;                    &lt;CODICE_ORDINE_ISP>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                    &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;CODICE_PROGETTO>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                    &lt;/CODICE_PROGETTO>&#xa;                    &lt;xsl:if test=&quot;FLAG_ONE_STEP&quot;>&#xa;                        &lt;FLAG_ONE_STEP>&#xa;                            &lt;xsl:value-of select=&quot;FLAG_ONE_STEP&quot;/>&#xa;                        &lt;/FLAG_ONE_STEP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;CODE_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                    &lt;/CODE_CAUS>&#xa;                    &lt;xsl:if test=&quot;CUSTOMER&quot;>&#xa;                        &lt;CUSTOMER>&#xa;                            &lt;xsl:value-of select=&quot;CUSTOMER&quot;/>&#xa;                        &lt;/CUSTOMER>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;SISTEMA_MITTENTE&quot;>&#xa;                        &lt;SISTEMA_MITTENTE>&#xa;                            &lt;xsl:value-of select=&quot;SISTEMA_MITTENTE&quot;/>&#xa;                        &lt;/SISTEMA_MITTENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(FEEDER)&quot;>&#xa;                            &lt;FEEDER>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/TIPO_CONTR&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/CODE_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/ID_RIS&quot;/>&#xa;                                &lt;/ID_RIS>&#xa;                                &lt;TIPO_AZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/TIPO_AZIONE&quot;/>&#xa;                                &lt;/TIPO_AZIONE>&#xa;                                &lt;CLASSE_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/CLASSE_SERVIZIO&quot;/>&#xa;                                &lt;/CLASSE_SERVIZIO>&#xa;                                &lt;CODE_MACRO_AREA>&#xa;                                    &lt;xsl:value-of select=&quot;FEEDER/CODE_MACRO_AREA&q