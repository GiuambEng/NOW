            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="61311a42-8ca2-4fea-9141-f85b8ac79519" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess4ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StatoFatturazione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:StatoFatturazioneMigrazioneResponse>&lt;tns:Output>&lt;tns:ID_EVENTO_ORDN_NOW>&lt;xsl:value-of select=&quot;$Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls&quot;/>&lt;/tns:ID_EVENTO_ORDN_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y' and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])=0 or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='N')) or ((string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0  or string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 )  and (count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N') and ($Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPON1BPNRR' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIGPON1BPNRR' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='UBBSEMIGPON' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIVULAFTTH'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTH' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICO' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSFLAT' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSLITE' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILEFLAT' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILELITE' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='UBBFULLGPON'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'))&quot;>&lt;tns:StatoFatturazione>&lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&lt;/tns:StatoFatturazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoFatturazione>&lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&lt;/tns:StatoFatturazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]) and  exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY'and azione='A'])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($Start/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine)&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine&quot;>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/tns:StatoFatturazioneMigrazioneResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectGestioneFatturazione-input"
                    name="SelectGestioneFatturazione"
                    outputVariable="SelectGestioneFatturazione"
                    tibex:xpdlId="3d1eace8-232d-40f5-a1c1-cd5d0cf8fd5b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToSelectGestioneFatturazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCallProcess2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3d1eace8-232d-40f5-a1c1-cd5d0cf8fd5b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectGestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]) and  exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'])&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.ID_RICH_OLO, E.ID_RISORSA, E.NUMERO_TENTATIVI, E.ID_EVENTO_ORDN_NOW_WHLS, E.ID_RICH_JPUB, E.TIMSTP_INSMTO_EVENTO, E.CONTENUTO_XML, T.DESCR_STATO_EVENTO_JPUB&#xa;FROM EVENTO_JPUB E, TIPOLG_STATO_EVENTO_JPUB T&#xa;WHERE E.ID_RISORSA = ? AND E.IDTPLG_STATO_EVENTO_JPUB = T.IDTPLG_STATO_EVENTO_JPUB&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_TENTATIVI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_JPUB"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO_EVENTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_XML"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_EVENTO_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogSelectGestioneFatturazione-input"
                    name="LogSelectGestioneFatturazione"
                    tibex:xpdlId="9b840c93-5350-4fc7-bb30-cd78491ad861"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToCallProcess2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess2ToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectGestioneFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectGestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectGestioneFatturazione/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SelectGestioneFatturazione', tib:render-xml($SelectGestioneFatturazione/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;'SelectGestioneFatturazione : Record non trovato'&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="StatoFatturazione"
                    name="StatoFatturazione"
                    outputVariable="StatoFatturazione"
                    tibex:xpdlId="2d1b0486-5d71-4eb9-8a66-c6c3f5b6aa9c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess2ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(exists($SelectGestioneFatturazione/Record) and exists($SelectGestioneFatturazione/Record[DESCR_STATO_EVENTO_JPUB != &quot;FATTURAZIONE_OK&quot;])) then &quot;DA_INVIARE&quot; else &quot;IN_INVIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="StatoFatturazione" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStatoFatturazione-input"
                    name="LogStatoFatturazione"
                    tibex:xpdlId="061d29ca-7ee5-4419-a16e-36b0eec168ad"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStatoFatturazioneToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStatoFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;StatoFatturazioneMigrazioneAttivazione&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('StatoFatturazione', $StatoFatturazione)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Insert_GestioneFatturazione-input"
                    name="Insert_GestioneFatturazione"
                    outputVariable="Insert_GestioneFatturazione"
                    tibex:xpdlId="0d91c1a0-9603-4e83-8769-84eac804d3c8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToInsert_GestioneFatturazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToCallProcess4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0d91c1a0-9603-4e83-8769-84eac804d3c8+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;xsl:param name=&quot;StatoFatturazione&quot;/>&lt;xsl:param name=&quot;SelectStrutturaRichiesta&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Insert_GestioneFatturazione-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TNAKEDCOND' and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOLA') or ($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TCONDNAKED' and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOLNF') or ($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='TBUNDLE')&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;MIGRAZIONE&amp;quot;)&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine)&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)])&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TNAKEDCOND’' and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOLA') or ($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TCONDNAKED’'and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOLNF') or ($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='TBUNDLE') or starts-with($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario,'NPSUVULL') or starts-with($Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario,'NPSUWLR') or $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGVULL' or $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' or ($Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE'  and $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($Start/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]) and  exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;NUMERO_TENTATIVI>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/NUMERO_TENTATIVI>&lt;TIMSTP_INSMTO_EVENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO_EVENTO>&lt;EVENTO_ORDN_NOW_WHLS.NEXTVAL>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls)&quot;>&lt;xsl:value-of select=&quot;$Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/EVENTO_ORDN_NOW_WHLS.NEXTVAL>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y' and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])=0 or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='N')) or ((string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0  or string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 )  and (count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N') and ($Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPON1BPNRR' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIGPON1BPNRR' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='UBBSEMIGPON' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIVULAFTTH'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTH' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICO' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSFLAT' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSLITE' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILEFLAT' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILELITE' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='UBBFULLGPON'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB'or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'))&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_CONSUNTIVO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/FLAG_CONSUNTIVO>&lt;STRUTTURA_OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectStrutturaRichiesta/Record[1]/STRUTTURA_RICH)&quot;>&lt;xsl:value-of select=&quot;$SelectStrutturaRichiesta/Record[1]/STRUTTURA_RICH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STRUTTURA_OFFERTA>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
