                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricizzaEventoOrdnNowWhls/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Sel_EVENTO_ORDN_NOW_WHLS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:StoricizzaEventoOrdnNowWhlsRequest>&#xa;            &lt;DESCR_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE EMISSIONE'&quot;/>&#xa;            &lt;/DESCR_EVENTO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_SISTEMA_DESTNRIO>&#xa;                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;            &lt;/ID_SISTEMA_DESTNRIO>&#xa;            &lt;ID_SISTEMA_MITTENTE>&#xa;                &lt;xsl:value-of select=&quot;15&quot;/>&#xa;            &lt;/ID_SISTEMA_MITTENTE>&#xa;        &lt;/tns3:StoricizzaEventoOrdnNowWhlsRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
