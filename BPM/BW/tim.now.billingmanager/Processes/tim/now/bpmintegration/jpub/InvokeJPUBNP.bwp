                                    <bpws:sources>
                                    <bpws:source linkName="DA_INVIAREAggiuntiviToMapperStatiAggiuntiviNP"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI/*, element, ns:REGOLATORIO -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cde9c426-7857-42cc-a93d-6196266ab3bb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;StartInvokeJPUBNP&quot;/>&lt;xsl:template name=&quot;DA_INVIAREAggiuntivi-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;substring-before($StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&lt;/ID_RICH_OLO>&lt;ID_ORDINE_COMPOSTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE_COMPOSTO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
