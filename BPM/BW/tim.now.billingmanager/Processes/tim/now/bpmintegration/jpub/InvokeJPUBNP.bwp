       &lt;xsl:value-of select=&quot;CODE_HOSTING&quot;/>&#xa;                                        &lt;/CODE_HOSTING>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;ns1:AGG&quot;>&#xa;                                        &lt;AGG>&#xa;                                            &lt;AGGIUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                            &lt;/AGGIUNTIVO>&#xa;                                        &lt;/AGG>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;ns1:STS&quot;>&#xa;                                        &lt;STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ACCESSO>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/REGOLATORIO>&#xa;            &lt;/tns0:ORDINE>&#xa;        &lt;/tns0:ricezioneElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
