                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI/*, element, ns:REGOLATORIO -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartInvokeJPUBNP&quot;/>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;MapperStatiAggiuntiviNP-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($StartInvokeJPUBNP/tns1:STATO_NP[1]/tns1:StatoNumeriAggiuntivi)!='IN_INVIO'  and $Aggiuntivi!=&amp;quot;TRUE&amp;quot;&quot;>&lt;tns:Response_Aggiuntivi>&lt;tns:Code>&lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&lt;/tns:Code>&lt;tns:Msg>&lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&lt;/tns:Msg>&lt;xsl:if test=&quot;$StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&lt;tns:Identificativo>&lt;xsl:value-of select=&quot;$StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&lt;/tns:Identificativo>&lt;/xsl:if>&lt;/tns:Response_Aggiuntivi>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Response_Aggiuntivi>&lt;tns:Code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Code>&lt;tns:Msg>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Msg>&lt;xsl:if test=&quot;$StartInvokeJPUBNP/tns1:ORDINEAGGIUNTIVI[number($index)]/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&