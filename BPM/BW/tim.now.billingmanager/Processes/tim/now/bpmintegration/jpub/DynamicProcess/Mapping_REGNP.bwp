                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;LogNPSYNC-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_REGNP&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_REGNP&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_REGNP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper end&amp;quot;, tib:render-xml($Mapper, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.DynamicProcess'&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Mapping_REGNP_COMPLETED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS)&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'OUT'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="Assign" outputVariable="Variable"
                    tibex:xpdlId="9cabb388-28e0-449c-bafc-098f9c7c8baa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NPSYNCToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns13=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:NPSync>&lt;xsl:for-each select=&quot;$Start/ns13:BPMRequest/ns13:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A']&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo =$Start/ns13:BPMRequest/ns13:Richiesta/IDRisorsa&quot;>&lt;tns:Input>&lt;tns:NP>&lt;xsl:value-of select=&quot;'True'&quot;/>&lt;/tns:NP>&lt;/tns:Input>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Input>&lt;tns:NP>&lt;xsl:value-of select=&quot;'False'&quot;/>&lt;/tns:NP>&lt;/tns:Input>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns:NPSync>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Control" tibex:xpdlId="a0802f36-1139-4f1d-a91b-a3abf9d9925f">
                <bpws:targets>
                    <bpws:target linkName="AssignToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToNPSYNCInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Variable/ns10:Input[ns10:NP='False'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Variable/ns10:Input[ns10:NP='False'])>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToEnd1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
