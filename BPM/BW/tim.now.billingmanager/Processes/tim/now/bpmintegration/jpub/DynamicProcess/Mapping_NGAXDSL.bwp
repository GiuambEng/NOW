                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/MappingNGA_XDSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingXDSL_NGA_ConsistenzaDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendJPUBRequest>&#xa;            &lt;tns1:Stato>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:Stato&quot;/>&#xa;            &lt;/tns1:Stato>&#xa;            &lt;tns1:BPMRequest>&#xa;                &lt;xsl:copy-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta&quot;/>&#xa;                &lt;tns1:Asset>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:AssetCorrelatiCessati[1]/codificaOLOAGCOM&quot;