                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/MappingNGA_XDSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingXDSL_NGA_Accesso-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SendJPUBRequest>&#xa;            &lt;tns:Stato>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Stato&quot;/>&#xa;            &lt;/tns:Stato>&#xa;            &lt;tns:BPMRequest>&#xa;                &lt;tns:Richiesta>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/statoRich