ttaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;CODE_ID_ULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_ID_ULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                            &lt;CODE_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                            &lt;/CODE_DISTR>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/CODE_DISTR>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn.input/tns1:Lavorazione=&amp;quot;CESSAZIONE&amp;quot;  and &amp;#xD;&amp;#xA;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='9' and &amp;#xD;&amp;#xA;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='37' and  $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='52'))&quot;>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; )and&amp;#xD;&amp;#xA;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='9' and &amp;#xD;&amp;#xA;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='37' and $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB!='52'))&quot;>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn.input/tns1:Lavorazione=&amp;quot;CESSAZIONE&amp;quot; and $ModVenditaAccesso = &amp;quot;51&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO!='CT' and&amp;#xD;&amp;#xA;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or &amp;#xD;&amp;#xA;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')) and &amp;#xD;&amp;#xA;(exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) &amp;#xD;&amp;#xA;and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)>0)&quot;>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; ) and $ModVenditaAccesso = &amp;quot;51&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO!='CT' and&amp;#xD;&amp;#xA;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or &amp;#xD;&amp;#xA;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')) and &amp;#xD;&amp;#xA;(exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) &amp;#xD;&amp;#xA;and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)>0)&quot;>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione=&amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo)>0 and (upper-