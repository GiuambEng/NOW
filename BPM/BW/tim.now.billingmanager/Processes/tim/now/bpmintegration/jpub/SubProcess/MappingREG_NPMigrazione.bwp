) > 0&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;QUANTITA>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QUANTITA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor)>0&quot;>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor&quot;/>&lt;/CODE_DONOR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_DONOR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating)>0&quot;>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating&quot;/>&lt;/CODE_DONATING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_DONATING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot; $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo) > 0&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($COD_CAUS/tns3:COD_CAUS_DESTINATARIO)='U2' or upper-case($COD_CAUS/tns3:COD_CAUS_DESTINATARIO)='CT' or upper-case($COD_CAUS/tns3:COD_CAUS_DESTINATARIO)='U3' or upper-case($COD_CAUS/tns3:COD_CAUS_DESTINATARIO)='9'&quot;>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:when>&lt;xsl:when test=&quot;($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE')  and ($JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37') and $ModVenditaAccesso = &amp;quot;51&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;Y&amp;quot; or   upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;S&amp;quot; &quot;>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO='U2'&quot;>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot;)  and ($JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')  and $ModVenditaAccesso = &amp;quot;51&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;Y&amp;quot; or  upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;S&amp;quot; &quot;>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--VERIFICARE!! in caso di migrazione capire dove prendere la componente DTUFONIA, se in Cessazione ho un regolatorio, mentre in attivazione ho un XDSL o GBE-->&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;) and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='N1'&quot;>&lt;FLAG_LA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_LA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_LA>&lt;xsl:value-of select=&quot;$FLAG_LA&quot;/>&lt;/FLAG_LA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns:ACCESSO>&lt;/ns:TESTATA>&lt;/ns:REGOLATORIO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperREG-input" name="MapperREG"
                    outputVariable="MapperREG"
                    tibex:xpdlId="8acda185-90b8-4baf-8367-c11d51f11117" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapperREG"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperREGToCallProcess1"/>
                        <bpws:source linkName="MapperREGToThrow"
                            tibex:faultDetailsVar="MapperREG" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:REGOLATORIO>&#xa;            &lt;ns:TESTATA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($MappingREG_NPIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='TBUNDLE'&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, '-',xsd:string($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/IDDettaglioOrdine))&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TSHAULLD' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOULLD'&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, '-',xsd:string($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI' and azione='D']/IDDettaglioOrdine))&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;DATA_MSG>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/DATA_MSG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists(($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES)) and $MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DES),00,00,00)&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists(($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES))&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES),00,00,00)&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATA_DES>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_DES>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $MappingREG_NPIn.input/tns1:Lavorazione='ATTIVAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ACCESSO>&#xa;                    &lt;xsl:variable name=&quot;FlagMigrazione&quot; select=&quot;if (contains($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo,'VULA')) then 'True' else 'False'&quot;/>&#xa;                    &lt;xsl:variable name=&quot;ModVenditaAccesso&quot; select=&quot;&amp;#xD;&amp;#xA;if(($MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE') and &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   &amp;#xD;&amp;#xA;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  &amp;#xD;&amp;#xA;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;else if(($MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE') and &amp;#xD;&amp;#xA;&amp;#x9;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  &amp;#xD;&amp;#xA;&amp;#x9;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;else if($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE') then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;else if((upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULL&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else &amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;xsl:variable name=&quot;FLAG_LA&quot; select=&quot;if((upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;) and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='N1')&amp;#xD;&amp;#xA;then &amp;quot;&amp;quot; &amp;#xD;&amp;#xA;else if((upper-case($MappingREG_NPIn.input/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) &amp;#xD;&amp;#xA;and $ModVenditaAccesso='51')&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0 and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA; then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else if($ModVenditaAccesso='51')&amp;#x9;&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine&amp;#xD;&amp;#xA;[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0  and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA;then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;)&amp;#xD;&amp;#xA;else &amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;TIPO_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB&quot;/>&#xa;                    &lt;/TIPO_CONTR>&#xa;                    &lt;CODE_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_CONTR&quot;/>&#xa;                    &lt;/CODE_CONTR>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE' and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/CLLI)>0&quot;>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;CODE_PREST_AGG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CODE_PREST_AGG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ID_RIS_PRINC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/ID_RIS_PRINC>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE' and ($COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52') and $FLAG_LA='1'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9'&quot;>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($FLAG_LA!='1' or string-length(tib:trim($FLAG_LA))=0)  and $ModVenditaAccesso='51'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52')&quot;>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')&quot;>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$ModVenditaAccesso='50'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23' &quot;>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:TIPO_FAMIGLIA&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;OPZ_COMM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:OPZ_COMM&quot;/>&#xa;                    &lt;/OPZ_COMM>&#xa;                    &lt;TIPO_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:TIPO_LINEA&quot;/>&#xa;                    &lt;/TIPO_LINEA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37') and exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY'])&quot;>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;SUB_TIPO_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:SUB_TIPO_LINEA&quot;/>&#xa;                    &lt;/SUB_TIPO_LINEA>&#xa;                    &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                    &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;( $MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE') and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;)&quot;>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot; ($MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE') and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&quot;>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE'&quot;>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;&quot;>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE' &quot;>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                            &lt;DATA_INIZIO_NOL>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                            &lt;/DATA_INIZIO_NOL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_INIZIO_NOL>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                            &lt;/DATA_INIZIO_NOL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE='6666'&quot;>&#xa;                            &lt;CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CODE_COMUNE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE)=6&quot;>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;!--RICONTROLLARE MAPPING CAMPO-->&#xa;                    &lt;xsl:choo