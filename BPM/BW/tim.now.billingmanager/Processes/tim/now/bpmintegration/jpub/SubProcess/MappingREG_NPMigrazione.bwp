MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo)='0' or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo)='1'&quot;>&#xa;                                            &lt;FLAG_PERMUTA>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_PERMUTA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine&amp;#xD;&amp;#xA;[nomeAttributo = &amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo)>0 and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quo