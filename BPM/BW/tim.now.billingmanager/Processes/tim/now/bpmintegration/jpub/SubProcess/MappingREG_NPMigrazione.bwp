                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.COD_CONTRATTO&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.PROVENIENZA = ? AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = ?&#xa;AND (CON.ID_TPLG_OPERATORE =? OR (? IS NULL AND CON.ID_TPLG_OPERATORE IS NULL))&#xa;ORDER BY CON.FLAG_NPD desc,CON.TIMSTP_INSMTO desc&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TPLG_OPERATORE1"/>
                                    <columnMetadata
                                    columnName="COD_CONTRATTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
