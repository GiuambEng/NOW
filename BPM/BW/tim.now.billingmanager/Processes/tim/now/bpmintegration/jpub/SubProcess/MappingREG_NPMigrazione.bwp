            <bpws:reply name="MappingREG_NPOut"
                operation="MappingREG_NP"
                partnerLink="MappingREG_NPPortType"
                portType="ns2:MappingREG_NPPortType"
                tibex:xpdlId="c55c7419-7e2b-4d50-9cee-72633d5d5e21" variable="MappingREG_NPOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP" xmlns:tns3="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" version="2.0"&gt;
    &lt;xsl:param name="MapperREG"/&gt;
    &lt;xsl:param name="MapperNP"/&gt;
    &lt;xsl:param name="MappingWLR"/&gt;
    &lt;xsl:template name="MappingREG_NPOut-input" match="/"&gt;
        &lt;tns:MappingREG_NPResponse&gt;
            &lt;output&gt;
                &lt;tns3:MappingREG_NPResponse&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingWLR/tns3:WLR)"&gt;
                            &lt;tns3:WLR&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns3:WLR/tns3:PRINCIPALE)"&gt;
                                        &lt;xsl:copy-of select="$MappingWLR/tns3:WLR/tns3:PRINCIPALE"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns3:WLR/tns3:AGGIUNTIVI)"&gt;
                                        &lt;tns3:AGGIUNTIVI&gt;
                                            &lt;xsl:copy-of select="$MappingWLR/tns3:WLR/tns3:AGGIUNTIVI/ns:REGOLATORIO"/&gt;
                                        &lt;/tns3:AGGIUNTIVI&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns3:WLR/tns3:STS)"&gt;
                                        &lt;tns3:STS&gt;
                                            &lt;xsl:copy-of select="$MappingWLR/tns3:WLR/tns3:STS/ns:REGOLATORIO"/&gt;
                                        &lt;/tns3:STS&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;tns3:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="'True'"/&gt;
                                &lt;/tns3:ControlloStruttura&gt;
                            &lt;/tns3:WLR&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MapperREG)"&gt;
                            &lt;tns3:REGOLATORIO&gt;
                                &lt;ns:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MapperREG/ns:TESTATA"/&gt;
                                &lt;/ns:REGOLATORIO&gt;
                                &lt;tns3:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;False&amp;quot;"/&gt;
                                &lt;/tns3:ControlloStruttura&gt;
                            &lt;/tns3:REGOLATORIO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:NP&gt;
                                &lt;tns3:PRINCIPALE&gt;
                                    &lt;ns:REGOLATORIO&gt;
                                        &lt;xsl:copy-of select="$MapperNP/ns:TESTATA"/&gt;
                                    &lt;/ns:REGOLATORIO&gt;
                                &lt;/tns3:PRINCIPALE&gt;
                                &lt;tns3:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;True&amp;quot;"/&gt;
                                &lt;/tns3:ControlloStruttura&gt;
                            &lt;/tns3:NP&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns3:MappingREG_NPResponse&gt;
            &lt;/output&gt;
        &lt;/tns:MappingREG_NPResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperREG&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperNP&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingREG_NPOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:MappingREG_NPResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingWLR/tns3:WLR)&quot;>&#xa;                    &lt;tns3:WLR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns3:WLR/tns3:PRINCIPALE)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$MappingWLR/tns3:WLR/tns3:PRINCIPALE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns3:WLR/tns3:AGGIUNTIVI)&quot;>&#xa;                                &lt;tns3:AGGIUNTIVI>&#xa;                                    &lt;xsl:copy-of select=&quot;$MappingWLR/tns3:WLR/tns3:AGGIUNTIVI/ns:REGOLATORIO&quot;/>&#xa;                                &lt;/tns3:AGGIUNTIVI>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns3:WLR/tns3:STS)&quot;>&#xa;                                &lt;tns3:STS>&#xa;                                    &lt;xsl:copy-of select=&quot;$MappingWLR/tns3:WLR/tns3:STS/ns:REGOLATORIO&quot;/>&#xa;                                &lt;/tns3:STS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns3:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;'True'&quot;/>&#xa;                        &lt;/tns3:ControlloStruttura>&#xa;                    &lt;/tns3:WLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapperREG)&quot;>&#xa;                    &lt;tns3:REGOLATORIO>&#xa;                        &lt;ns:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MapperREG/ns:TESTATA&quot;/>&#xa;                        &lt;/ns:REGOLATORIO>&#xa;                        &lt;tns3:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;False&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ControlloStruttura>&#xa;                    &lt;/tns3:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:NP>&#xa;                        &lt;tns3:PRINCIPALE>&#xa;                            &lt;ns:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;$MapperNP/ns:TESTATA&quot;/>&#xa;                            &lt;/ns:REGOLATORIO>&#xa;                        &lt;/tns3:PRINCIPALE>&#xa;                        &lt;tns3:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;True&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ControlloStruttura>&#xa;                    &lt;/tns3:NP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:MappingREG_NPResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToMappingREG_NPOut"/>
                    <bpws:target linkName="CallProcessToMappingREG_NPOut"/>
                    <bpws:target linkName="LOG_MapperNPToMappingREG_NPOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:template name=&quot;MapperREG-input&quot; match=&quot;/&quot;>&lt;ns:REGOLATORIO>&lt;ns:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;xsd:string($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='TBUNDLE'&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, '-',xsd:string($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/IDDettaglioOrdine))&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TSHAULLD' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PASSAGGIOULLD'&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, '-',xsd:string($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI' and azione='D']/IDDettaglioOrdine))&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)])&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES)) and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DES),00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES),00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='ATTIVAZIONE'&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ACCESSO>&lt;xsl:variable name=&quot;FlagMigrazione&quot; select=&quot;if (contains($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo,'VULA')) then 'True' else 'False'&quot;/>&lt;xsl:variable name=&quot;ModVenditaAccesso&quot; select=&quot;&amp;#xD;&amp;#xA;if(($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE') and &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   &amp;#xD;&amp;#xA;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  &amp;#xD;&amp;#xA;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;else if(($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE') and &amp;#xD;&amp;#xA;&amp;#x9;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  &amp;#xD;&amp;#xA;&amp;#x9;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;else if($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE') then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;else if((upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULL&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or   upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else &amp;quot;&amp;quot;&quot;/>&lt;xsl:variable name=&quot;FLAG_LA&quot; select=&quot;if((upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;) and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='N1')&amp;#xD;&amp;#xA;then &amp;quot;&amp;quot; &amp;#xD;&amp;#xA;else if((upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) &amp;#xD;&amp;#xA;and $ModVenditaAccesso='51')&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0 and (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA; then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else if($ModVenditaAccesso='51')&amp;#x9;&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine&amp;#xD;&amp;#xA;[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0  and (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA;then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;)&amp;#xD;&amp;#xA;else &amp;quot;&amp;quot;&quot;/>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_CONTR&quot;/>&lt;/CODE_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE' and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/CLLI)>0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_CLLI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_PREST_AGG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_PREST_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&lt;/ID_RIS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&lt;/ID_RIS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ID_RIS_PRINC>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE' and ($COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='14')&quot;>&lt;CODE_GEST_REC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOM&quot;/>&lt;/CODE_GEST_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_GEST_REC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/CODE_GEST_REC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52') and $FLAG_LA='1'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9'&quot;>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_FAMIGLIA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot