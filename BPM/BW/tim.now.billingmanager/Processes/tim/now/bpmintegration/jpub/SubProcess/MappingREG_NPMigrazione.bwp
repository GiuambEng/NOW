                                      &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CAMPO_SERV_IT>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CAMPO_SERV_IT>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo) > 0&quot;>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo) > 0&quot;>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                            &lt;/ns:ACCESSO>&#xa;                        &lt;/ns:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TESTATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:string($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' or (string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'))&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns:ACCESSO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot; or (string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'))&quot;>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;37&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:NP/tns3:COD_CONTR&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;ID_RIS_PRINC>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/ID_RIS_PRINC>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ID_RIS_PRINC>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/ID_RIS_PRINC>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:NP/tns3:OPZ_COMM&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or (string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot;])&quot;>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;SUB_TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:NP/tns3:CODE_COMUNE='6666'&quot;>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:NP/tns3:CODE_COMUNE)=6&quot;>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:NP/tns3:CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_ID_ULLCO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CAMPO_SERV_IT>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CAMPO_SERV_IT>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor)>0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLONOWDonating)>0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codificaOLONOWDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or (string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A')) and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                            &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;xsl:for-each select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns:AGG>&#xa;                                    &lt;AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/AGGIUNTIVO>&#xa;                                &lt;/ns:AGG>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/ns:ACCESSO>&#xa;                    &lt;/ns:TESTATA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperNP-input" name="MapperNP"
                    outputVariable="MapperNP"
                    tibex:xpdlId="e68b679c-152f-4c0a-922e-4fa9a0991a62" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToMapperNP"/>
                        <bpws:target linkName="JDBCQueryToMapperNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperNPToCallProcess"/>
                        <bpws:source linkName="MapperNPToThrow1"
                            tibex:faultDetailsVar="JDBCQueryInvoke" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CONTR&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:REGOLATORIO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:NPSYNCREG)>0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)]&quot;>&#xa;                        &lt;ns:TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns:ACCESSO>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($COD_CONTR/Record)>0&quot;>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;$COD_CONTR/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_PREST_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_PREST_AGG>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_GEST_REC>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/CODE_GEST_REC>&#xa;                                &lt;TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:OPZ_COMM&quot;/>&#xa;                                &lt;/OPZ_COMM>&#xa;                                &lt;TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_LINEA>&#xa;                                &lt;FLAG_NP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_NP>&#xa;                                &lt;SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA>&#xa;                                &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;MOD_VENDITA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;TIPO_AZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_AZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE='6666'&quot;>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE)=6&quot;>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_ID_ULLCO>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CODE_ID_ULLCO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_PERMUTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA>&#xa;                                &lt;FLAG_MIGRAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;FLAG_QUALIFICAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CAMPO_SERV_IT>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CAMPO_SERV_IT>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo) > 0&quot;>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo) > 0&quot;>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                            &lt;/ns:ACCESSO>&#xa;                        &lt;/ns:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TESTATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:string($MappingREG_NPIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' or (string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'))&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns:ACCESSO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot; or (string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'))&quot;>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;37&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:COD_CONTR&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;ID_RIS_PRINC>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/ID_RIS_PRINC>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ID_RIS_PRINC>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/ID_RIS_PRINC>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:OPZ_COMM&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or (string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot;])&quot;>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;SUB_TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE='6666'&quot;>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE)=6&quot;>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:NP/tns3:CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_ID_ULLCO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CAMPO_SERV_IT>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CAMPO_SERV_IT>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor)>0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLONOWDonating)>0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLONOWDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; or (string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A')) and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                            &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;xsl:for-each select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns:AGG>&#xa;                                    &lt;AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/AGGIUNTIVO>&#xa;                                &lt;/ns:AGG>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/ns:ACCESSO>&#xa;                    &lt;/ns:TESTATA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
