            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:template name=&quot;Log_MappingREG_NPIn-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPMigrazione&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Process MappingREG_NP started&amp;quot;,tib:render-xml($MappingREG_NPIn/input/tns1:SendJPUBRequest,true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.SubProcess'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MappingREG_NP_&amp;quot;, $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MappingREG_NP_&amp;quot;, $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($MappingREG_NPIn/input/tns1:SendJPUBRequest))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPIn/input/tns1:SendJPUBRequest, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_MappingREG_NPIn-input"
                    name="Log_MappingREG_NPIn"
                    tibex:xpdlId="7e3fda6d-b168-4fd6-a65c-6d82c78eb1c8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MappingREG_NPInToLog_MappingREG_NPIn"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_MappingREG_NPInToRegolatorio">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Log_MappingREG_NPInToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:Lavorazione!='CESSAZIONE' and   &#xd;&#xa;(upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEAATTIVA' &#xd;&#xa;or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLR' or &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='VARIAZIONEWLR' or &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' &#xd;&#xa;or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')) or &#xd;&#xa;($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE' and  (upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='WLRLINEAATTIVA' or &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='WLR' or &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='WLRLINEANONATTIVA' &#xd;&#xa;or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='VARIAZIONEWLR' or  &#xd;&#xa;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA'&#xd;&#xa; or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($MappingREG_NPIn.input/tns:Lavorazione!='CESSAZIONE' and   
(upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEAATTIVA' 
or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLR' or 
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or 
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='VARIAZIONEWLR' or 
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' 
or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')) or 
($MappingREG_NPIn.input/tns:Lavorazione='CESSAZIONE' and  (upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='WLRLINEAATTIVA' or 
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='WLR' or 
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='WLRLINEANONATTIVA' 
or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='VARIAZIONEWLR' or  
upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA'
 or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA'))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_MappingREG_NPIn-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Process MappingREG_NP started&amp;quot;,tib:render-xml($MappingREG_NPIn.input,true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.SubProcess'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;tns:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingREG_NP_&amp;quot;, $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingREG_NP_&amp;quot;, $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($MappingREG_NPIn.input))) &quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPIn.input, true(), true())&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Regolatorio" tibex:xpdlId="4fb7ed17-6777-48e3-96da-96ead92981a7">
                <bpws:targets>
                    <bpws:target linkName="Log_MappingREG_NPInToRegolatorio"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RegolatorioToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE' and string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/IDRichiestaOLO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$MappingREG_NPIn.input/tns:Lavorazione='CESSAZIONE' and string-length($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/IDRichiestaOLO)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RegolatorioToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;MappingWLR&quot;/>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:template name=&quot;LogMappingWLR-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPMigrazione&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($MappingWLR, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMappingWLR-input"
                    name="LogMappingWLR"
                    tibex:xpdlId="88811b8d-bdc3-4924-becd-e8c8f2b598c4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToLogMappingWLR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMappingREG_NPOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMappingWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MappingWLR, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTipologiaSottolav&quot;/>&#xa;    &lt;xsl:param name=&quot;OLOgenerante&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns3:CodeCausaleRequest>&#xa;                    &lt;tns3:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns3:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($OLOgenerante/Record)>0 and (upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLDNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUSLUNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='CNPCRDAOLO') and $OLOgenerante/Record[1]/LAVORAZIONE='ATTIVAZIONE' and $OLOgenerante/Record[1]/CODIFICAOLOAGCOM='TLC'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='PORTABILITASUCCESSIVA'&quot;>&#xa;                            &lt;tns3:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                            &lt;/tns3:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='RIENTROINTI' and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEANONATTIVA' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEANONATTIVA' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' )and  $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM='TLC'&quot;>&#xa;                            &lt;tns3:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                            &lt;/tns3:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns3:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:ID_Rich_OLO>&#xa;                    &lt;tns3:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta&quot;/>&#xa;                    &lt;/tns3:OFFERTA>&#xa;                    &lt;tns3:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns3:STRUTTURARICHIESTA>&#xa;                    &lt;tns3:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns3:TIPOLOGIAMIGRAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns3:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                            &lt;/tns3:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;tns3:Billing>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns3:Billing>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:CodeCausaleRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:CodeCausaleRequest>&#xa;                    &lt;tns3:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns3:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($OLOgenerante/Record)>0 and (upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLDNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUSLUNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='CNPCRDAOLO') and $OLOgenerante/Record[1]/LAVORAZIONE='ATTIVAZIONE' and $OLOgenerante/Record[1]/CODIFICAOLOAGCOM='TLC'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                        &lt;tns3:PSOTTOLAVORAZ>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                        &lt;/tns3:PSOTTOLAVORAZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns3:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:ID_Rich_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:NPSYNCREG)>0&quot;>&#xa;                            &lt;tns3:OFFERTA>&#xa;                                &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                            &lt;/tns3:OFFERTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns3:OFFERTA>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                            &lt;/tns3:OFFERTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns3:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns3:STRUTTURARICHIESTA>&#xa;                    &lt;tns3:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns3:TIPOLOGIAMIGRAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns3:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                            &lt;/tns3:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns3:CodeCausaleRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="COD_CAUS-input" name="COD_CAUS"
                    outputVariable="COD_CAUS"
                    tibex:xpdlId="ede7c9bc-c6e0-424a-afce-6ddfbda4506d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCOD_CAUS"/>
                        <bpws:target linkName="LogOLOgeneranteToCOD_CAUS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="COD_CAUSToJDBCQueryInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTipologiaSottolav&quot;/>&#xa;    &lt;xsl:param name=&quot;OLOgenerante&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns3:CodeCausaleRequest>&#xa;                    &lt;tns3:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns3:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($OLOgenerante/Record)>0 and (upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLDNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUSLUNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='CNPCRDAOLO') and $OLOgenerante/Record[1]/LAVORAZIONE='ATTIVAZIONE' and $OLOgenerante/Record[1]/CODIFICAOLOAGCOM='TLC'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='PORTABILITASUCCESSIVA'&quot;>&#xa;                            &lt;tns3:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'NORMALE'&quot;/>&#xa;                            &lt;/tns3:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VTRASLOCO' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,'ULL'))&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='RIENTROINTI' and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEANONATTIVA' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEANONATTIVA' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' )and  $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM='TLC'&quot;>&#xa;                            &lt;tns3:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                            &lt;/tns3:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                                &lt;tns3:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns3:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns3:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:ID_Rich_OLO>&#xa;                    &lt;tns3:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta&quot;/>&#xa;                    &lt;/tns3:OFFERTA>&#xa;                    &lt;tns3:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns3:STRUTTURARICHIESTA>&#xa;                    &lt;tns3:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns3:TIPOLOGIAMIGRAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns3:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                            &lt;/tns3:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;tns3:Billing>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns3:Billing>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:CodeCausaleRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:CodeCausaleRequest>&#xa;                    &lt;tns3:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns3:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='TBUNDLE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($OLOgenerante/Record)>0 and (upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUULLDNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='NPSUSLUNP' or upper-case($OLOgenerante/Record[1]/TIPOLOGIASCENARIO)='CNPCRDAOLO') and $OLOgenerante/Record[1]/LAVORAZIONE='ATTIVAZIONE' and $OLOgenerante/Record[1]/CODIFICAOLOAGCOM='TLC'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$OLOgenerante/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                        &lt;tns3:PSCENARIO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                        &lt;/tns3:PSCENARIO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns3:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns3:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                        &lt;tns3:PSOTTOLAVORAZ>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                        &lt;/tns3:PSOTTOLAVORAZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns3:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:ID_Rich_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:NPSYNCREG)>0&quot;>&#xa;                            &lt;tns3:OFFERTA>&#xa;                                &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                            &lt;/tns3:OFFERTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns3:OFFERTA>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                            &lt;/tns3:OFFERTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns3:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns3:STRUTTURARICHIESTA>&#xa;                    &lt;tns3:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns3:TIPOLOGIAMIGRAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns3:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                            &lt;/tns3:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns3:CodeCausaleRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.CODE_CAUSALE" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
