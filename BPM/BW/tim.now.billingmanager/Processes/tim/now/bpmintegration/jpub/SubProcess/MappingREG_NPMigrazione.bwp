                    inputVariable="COD_CONTR-input" name="COD_CONTR"
                    outputVariable="COD_CONTR"
                    tibex:xpdlId="77ada645-7aec-4cf9-8c88-0feb95fea17c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
