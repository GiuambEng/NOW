                portType="ns4:JDBCQueryPortType" tibex:xpdlId="7d059868-eb0a-44eb-9e38-fc4955426253">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/JDBCQuery" version="2.0"&gt;
    &lt;xsl:param name="MappingREG_NPIn"/&gt;
    &lt;xsl:template name="JDBCQueryInvoke-input" match="/"&gt;
        &lt;tns2:JDBCQueryRequest&gt;
            &lt;input&gt;
                &lt;xsl:copy-of select="$MappingREG_NPIn/input/tns1:SendJPUBRequest"/&gt;
            &lt;/input&gt;
        &lt;/tns2:JDBCQueryRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/JDBCQuery&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$MappingREG_NPIn.input&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="COD_CAUSToJDBCQueryInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToThrow"
                        tibex:faultDetailsVar="JDBCQueryInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="JDBCQueryInvokeToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="InvokeToMapperNP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta = &quot;NP&quot; and $MappingREG_NPIn/input/tns:SendJPUBRequest/tns:Lavorazione='ATTIVAZIONE') or (string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:NewBilling)>0 and $MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/codiceRifiuto='A' and $MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta = "NP" and $MappingREG_NPIn.input/tns:Lavorazione='ATTIVAZIONE') or (string-length($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/codiceRifiuto)>0 and string-length($MappingREG_NPIn.input/tns:BPMRequest/tns:NewBilling)>0 and $MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/codiceRifiuto='A' and $MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/offerta='NP')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
