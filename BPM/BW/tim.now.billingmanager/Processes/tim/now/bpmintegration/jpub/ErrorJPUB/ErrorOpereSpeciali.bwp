            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp2:ErrorSchemaPortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp3:OrdineRegolatorioCRMNOW"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType2">
                <plnk:role name="use" portType="ptyp4:OrdineXDSLCRMNOW"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/"/>
            <wsdl:import namespace="http://www.tibco.com/JPUB_REG_internal_abstract/"/>
            <wsdl:import namespace="http://crmnow.ordinexdsl.jpub.internal.concrete/"/>
        </wsdl:definitions>
    </tibex:Types>
