                                <bpws:link name="PreventivoXDSL_NGAToKO"
                                    tibex:label="KO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToOKRetry" tibex:linkType="SUCCESS"/>
                                <bpws:link name="OKRetryToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="KOToCallProcess" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="3ec831f2-c86d-46bc-8a4a-b81e2db31184">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty"/>
                                </bpws:sources>
