                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ErrorSchemaIn&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;Retry-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ErrorOpereSpeciali&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ErrorSchemaPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ErrorSchema&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ID_RICH_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ID_RICH_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;RetryNumero: &amp;quot;, string($index))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Retry-input"
                                    name="Retry"
                                    tibex:xpdlId="db178c90-cff6-4158-abdc-f2233962b5a5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="PreventivoRegolatorioToCallProcess"/>
                                    <bpws:target linkName="KOToCallProcess"/>
                                    <bpws:target linkName="PreventivoXDSL_NGAToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToOKRetry"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;Retry-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorOpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorSchemaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorSchema&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$ErrorSchemaIn.Input/tns1:ID_RICH_OLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;RetryNumero: &amp;quot;, string($index))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Exit='True' or $index=$NumeroTentativi]]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns0=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns01=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Exit&quot;/>&lt;xsl:param name=&quot;PreventivoXDSL_NGA&quot;/>&lt;xsl:param name=&quot;PreventivoRegolatorio&quot;/>&lt;xsl:template name=&quot;MapperErrorOpereSpeciali-input&quot; match=&quot;/&quot;>&lt;tns:ErrorOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Exit='True'&quot;>&lt;tns:ErrorO>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($PreventivoXDSL_NGA/parameters/tns0:ricezioneResponseElement)&quot;>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($PreventivoXDSL_NGA/parameters/tns0:ricezioneResponseElement, true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($PreventivoRegolatorio/parameters/tns01:ricezioneResponseElement,true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ErrorO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ErrorO>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;&amp;quot;Null&amp;quot;&quot;/>&lt;/tns:TRANSACTION_ID>&lt;/tns:ErrorO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ErrorOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperErrorOpereSpeciali-input"
                    name="MapperErrorOpereSpeciali"
                    outputVariable="MapperErrorOpereSpeciali"
                    tibex:xpdlId="63a46cd9-ce90-48c3-a387-2a37fed6ab0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns0=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns01=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PreventivoRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;PreventivoXDSL_NGA.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Exit&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperErrorOpereSpeciali-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ErrorOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Exit='True'&quot;>&#xa;                    &lt;tns:ErrorO>&#xa;                        &lt;tns:TRANSACTION_DATE>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TRANSACTION_DATE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($PreventivoXDSL_NGA.parameters)&quot;>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($PreventivoXDSL_NGA.parameters, true(),true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($PreventivoRegolatorio.parameters,true(),true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:ErrorO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ErrorO>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Null&amp;quot;&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                    &lt;/tns:ErrorO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ErrorOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ErrorSchema="http://www.tim.com/NOW/xsd/ErrorSchema/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ErrorSchema:ErrorOutput" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
