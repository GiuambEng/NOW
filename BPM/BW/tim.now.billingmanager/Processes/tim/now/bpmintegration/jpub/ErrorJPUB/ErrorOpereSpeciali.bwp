                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke
                                inputVariable="PreventivoRegolatorio-input"
                                name="PreventivoRegolatorio"
                                operation="ricezione"
                                outputVariable="PreventivoRegolatorio"
                                partnerLink="OrdineRegolatorioCRMNOW"
                                portType="ns4:OrdineRegolatorioCRMNOW" tibex:xpdlId="728d2154-63f1-4f6f-9ac0-29e6f6a612b7">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;!--START COERCIONS--&gt;
&lt;!-- $ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/*, element, ns:REGOLATORIO --&gt;
&lt;!--END COERCIONS--&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/JPUB_REG_internal_abstract/" xmlns:tns1="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns0="http://crmnow.ordineregolatorio.jpub/types/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="ErrorSchemaIn"/&gt;&lt;xsl:template name="PreventivoRegolatorio-input" match="/"&gt;&lt;tns:OrdineRegolatorioCRMNOW_ricezione&gt;&lt;parameters&gt;&lt;tns0:ricezioneElement&gt;&lt;tns0:ID_ORDINE_CRM&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_RICHIESTA_NOW)"&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns0:ID_ORDINE_CRM&gt;
                                                &lt;!--Verificare--&gt;&lt;tns0:ORDINE&gt;&lt;REGOLATORIO&gt;&lt;PREVENTIVO&gt;&lt;ID_PREVENTIVO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_PREVENTIVO"/&gt;&lt;/ID_PREVENTIVO&gt;&lt;ID_RICHIESTA_NOW&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/ID_RICHIESTA_NOW&gt;&lt;ID_OLO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_OLO"/&gt;&lt;/ID_OLO&gt;&lt;CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/CODICE_ORDINE_OLO"/&gt;&lt;/CODICE_ORDINE_OLO&gt;&lt;ID_RIS&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ID_RIS"/&gt;&lt;/ID_RIS&gt;&lt;TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/TIPO_SERVIZIO"/&gt;&lt;/TIPO_SERVIZIO&gt;&lt;TECNOLOGIA&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/TECNOLOGIA"/&gt;&lt;/TECNOLOGIA&gt;&lt;DATA_DRO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/DATA_DRO"/&gt;&lt;/DATA_DRO&gt;&lt;xsl:if test="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO"&gt;&lt;DATA_INVIO_PREVENTIVO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO"/&gt;&lt;/DATA_INVIO_PREVENTIVO&gt;&lt;/xsl:if&gt;&lt;DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;&lt;/DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:for-each select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:PREVENTIVO/ns:DETTAGLIO"&gt;&lt;DETTAGLIO&gt;&lt;ID_VOCE&gt;&lt;xsl:value-of select="ID_VOCE"/&gt;&lt;/ID_VOCE&gt;&lt;QUANTITA&gt;&lt;xsl:value-of select="QUANTITA"/&gt;&lt;/QUANTITA&gt;&lt;/DETTAGLIO&gt;&lt;/xsl:for-each&gt;&lt;/PREVENTIVO&gt;&lt;/REGOLATORIO&gt;&lt;/tns0:ORDINE&gt;&lt;/tns0:ricezioneElement&gt;&lt;/parameters&gt;&lt;/tns:OrdineRegolatorioCRMNOW_ricezione&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
