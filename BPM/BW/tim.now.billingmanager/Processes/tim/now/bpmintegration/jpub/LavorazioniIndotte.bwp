                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='TSHAULLD' and $LavorazioniIndotteIn.Input/tns:Richiesta/ordine/tipologiaSottolav='PASSAGGIOULLD') or ($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='TBUNDLE' and $LavorazioniIndotteIn.Input/tns:Richiesta/ordine/tipologiaSottolav='TBUNDLE') or starts-with($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario,'NPSUVULL') or starts-with($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario,'NPSUWLR') or $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='NPSUAGGWLR' or  ($LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='VARIAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='VTRASLOCO' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($LavorazioniIndotteIn.Input/tns:Richiesta/offerta,'ULL'))]]></bpws:transitionCondition>
