            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LavorazioniIndotteIn&quot;/>&lt;xsl:template name=&quot;StatoFatturzioneAttivazioneTSHA_UULD-input&quot; match=&quot;/&quot;>&lt;tns:SendJPUBRequest>&lt;tns:Stato>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Stato>&lt;tns:BPMRequest>&lt;xsl:copy-of select=&quot;$LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta&quot;/>&lt;xsl:copy-of select=&quot;$LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Asset&quot;/>&lt;/tns:BPMRequest>&lt;/tns:SendJPUBRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
