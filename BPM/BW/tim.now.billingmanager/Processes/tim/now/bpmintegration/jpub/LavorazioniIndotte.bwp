ioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario,'NPSUVULL') or  starts-with($LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario,'NPSUWLR') or $LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario='NPSUAGGWLR' or ($LavorazioniIndotteIn.Input/tns3:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($LavorazioniIndotteIn.Input/tns3:Richiesta/lavorazione='VARIAZIONE' and $LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario='VTRASLOCO' and $LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($LavorazioniIndotteIn.Input/tns3:Richiesta/offerta,'ULL'))&quot;>&#xa;                &lt;tns1:TSHA_ULLD>&#xa;                    &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                &lt;/tns1:TSHA_ULLD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$LavorazioniIndotteIn.Input/tns3:Richiesta/tipologiaScenario='TBUNDLE'&quot;>&#xa;                &lt;tns1:TBUNDLE>&#xa;                    &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                &lt;/tns1:TBUNDLE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
