                    <bpws:targets>
                        <bpws:target linkName="TipologiaScenarioToCallProcess_TSHAULLDTBUNDLE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToStatoFatturzioneTSHA_UULD">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StatoFatturazioneAttivazioneTSHA_ULLD-TBUNDLEToLavorazioniIndotteTSHA_RU1263CAMBIOTECNOLOGIAFTTHsuFTTH">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(1=2) and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and contains($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/offerta, 'FTTH') and string-length($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo)>0 and contains($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo, 'FTTH')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(1=2) and $LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and contains($LavorazioniIndotteIn.Input/tns:Richiesta/offerta, 'FTTH') and string-length($LavorazioniIndotteIn.Input/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo)>0 and contains($LavorazioniIndotteIn.Input/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo, 'FTTH')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;StatoFatturzioneAttivazioneTSHA_UULD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SendJPUBRequest>&#xa;            &lt;tns:Stato>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns:Stato>&#xa;            &lt;tns:BPMRequest>&#xa;                &lt;xsl:copy-of select=&quot;$LavorazioniIndotteIn.Input/tns:Richiesta&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$LavorazioniIndotteIn.Input/tns:Asset&quot;/>&#xa;            &lt;/tns:BPMRequest>&#xa;        &lt;/tns:SendJPUBRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.SubProcess.StatoFatturazioneMigrazioneAttivazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
