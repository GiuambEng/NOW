            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c5ddaa3-be6d-4836-9844-6f578c4c9ac8+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteTSHA_ULLD-TBUNDLE&quot;/>&#xa;    &lt;xsl:template name=&quot;FatturazioneTSHA_ULLDAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:Code = &amp;quot;OK&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDRichOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDRichOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;IDDETTAGLIOORDINE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDDettaglioOrdine)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:IDDettaglioOrdine&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDDETTAGLIOORDINE>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE/parameters/tns1:Response/tns1:Response[1]/tns1:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FatturazioneTSHA_ULLD-TBUNDLEAtt-input"
                    name="FatturazioneTSHA_ULLD-TBUNDLEAtt"
                    outputVariable="FatturazioneTSHA_ULLD-TBUNDLEAtt"
                    tibex:xpdlId="7c5ddaa3-be6d-4836-9844-6f578c4c9ac8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogLavorazioniIndotteTSHA_UULDToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToLavorazioneIndottaTSHA_ULLDCessazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FatturazioneTSHA_RU1263CAMBIOTECNOLOGIAFTTHsuFTTH">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(1=2) and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and contains($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/offerta, 'FTTH') and string-length($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo)>0 and contains($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo, 'FTTH')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(1=2) and $LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and contains($LavorazioniIndotteIn.Input/tns:Richiesta/offerta, 'FTTH') and string-length($LavorazioniIndotteIn.Input/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo)>0 and contains($LavorazioniIndotteIn.Input/tns:Richiesta/ordine/dettaglioordine[nomeComponente = 'CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo = 'OFFERTA']/valoreAttributo, 'FTTH')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c5ddaa3-be6d-4836-9844-6f578c4c9ac8+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;FatturazioneTSHA_ULLDAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:Code = &amp;quot;OK&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDRichOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDRichOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;IDDETTAGLIOORDINE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDDettaglioOrdine)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:IDDettaglioOrdine&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDDETTAGLIOORDINE>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$LavorazioniIndotteTSHA_ULLD-TBUNDLE.parameters/tns1:Response[1]/tns1:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xd;&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xd;&#xa;WHERE ID_RISORSA = ? AND ID_RICH_OLO = ? AND IDDETTAGLIOORDINE = ? AND ID_EVENTO_ORDN_NOW_WHLS=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteIn&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LavorazioneIndottaTSHA_ULLD-TBUNDLECessazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogLavorazioneIndottaTSHA_ULLDCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LavorazioniIndotte&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LavorazioniIndottePortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LavorazioniIndotte&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$LavorazioniIndotteIn/Input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;LavorazioneIndottaTSHA_ULLDCessazione&amp;quot;, tib:render-xml($LavorazioneIndottaTSHA_ULLD-TBUNDLECessazione/parameters/tns2:Response, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogLavorazioneIndottaTSHA_ULLD-TBUNDLECessazione-input"
                    name="LogLavorazioneIndottaTSHA_ULLD-TBUNDLECessazione"
