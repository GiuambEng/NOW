                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LavorazioniIndotteIn&quot;/>&lt;xsl:param name=&quot;StatoFatturazioneAttivazioneTSHA_ULLD-TBUNDLE&quot;/>&lt;xsl:param name=&quot;StatoFatturazione&quot;/>&lt;xsl:template name=&quot;UpdateRequest-input&quot; match=&quot;/&quot;>&lt;tns1:UpdateRichiestaRequest>&lt;tns1:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns1:IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario='TSHA_ULLD' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav='PASSAGGIOULLD') or ($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario='TBUNDLE' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav='TBUNDLE') or starts-with($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario,'NPSUVULL') or starts-with($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario,'NPSUWLR') or $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario='NPSUAGGWLR' or  ($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipologiaScenario='VTRASLOCO' and $LavorazioniIndotteIn/Input/tns:BPMRequest/tns:Richiesta/tipolog