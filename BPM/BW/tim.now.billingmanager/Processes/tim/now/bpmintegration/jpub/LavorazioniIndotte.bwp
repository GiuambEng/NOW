                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SubProcessMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazioneTSHA_ULLD-TBUNDLE&quot;/>&#xa;    &lt;xsl:template name=&quot;LavorazioneIndottaTSHA_ULLD-TBUNDLECessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;xsl:for-each select=&quot;$LavorazioniIndotteIn.Input/tns2:AssetCorrelatiCessati&quot;>&#xa;                &lt;tns1:Asset>&#xa;                    &lt;xsl:if test=&quot;IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;invariante&quot;>&#xa;                        &lt;invariante>&#xa;                            &lt;xsl:value-of select=&quot;invariante&quot;/>&#xa;                        &lt;/invariante>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;IDRichiestaOLO&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDPrimoOrdine&quot;>&#xa;                        &lt;IDPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;IDPrimoOrdine&quot;/>&#xa;                        &lt;/IDPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;IDContratto&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                    &lt;xsl:if test=&quot;DEC&quot;>&#xa;                        &lt;DEC>&#xa;                            &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                        &lt;/DEC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;statoAsset>&#xa;                        &lt;xsl:value-of select=&quot;statoAsset&quot;/>&#xa;                    &lt;/statoAsset>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;xsl:if test=&quot;numeroTelefoni