                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LavorazioniIndotteIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazioneAttivazioneTSHA_ULLD-TBUNDLE&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:UpdateRichiestaRequest>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$LavorazioniIndotteIn.Input/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='TSHA_ULLD' and $LavorazioniIndotteIn.Input/tns:Richiesta/ordine/tipologiaSottolav='PASSAGGIOULLD') or ($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='TBUNDLE' and $LavorazioniIndotteIn.Input/tns:Richiesta/ordine/tipologiaSottolav='TBUNDLE') or starts-with($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario,'NPSUVULL') or starts-with($LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario,'NPSUWLR') or $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='NPSUAGGVULL'  or $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='NPSUAGGWLR' or  ($LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='ATTIVAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($LavorazioniIndotteIn.Input/tns:Richiesta/lavorazione='VARIAZIONE' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaScenario='VTRASLOCO' and $LavorazioniIndotteIn.Input/tns:Richiesta/tipologiaSottolav='TRASLOCO' and starts-with($LavorazioniIndo