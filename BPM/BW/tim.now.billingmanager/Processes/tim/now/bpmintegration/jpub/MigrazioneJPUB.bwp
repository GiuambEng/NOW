ecedOF"/&gt;&lt;/statoRichiestaPrecedOF&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/statoRichiestaOF"&gt;&lt;statoRichiestaOF&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/statoRichiestaOF"/&gt;&lt;/statoRichiestaOF&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codOperatoreSecondario"&gt;&lt;codOperatoreSecondario&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codOperatoreSecondario"/&gt;&lt;/codOperatoreSecondario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/dataPrevistaAttivazione)"&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/dataPrevistaAttivazione"&gt;&lt;dataPrevistaAttivazione&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/dataPrevistaAttivazione"/&gt;&lt;/dataPrevistaAttivazione&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flgAbilitazGuiManualOF"&gt;&lt;flgAbilitazGuiManualOF&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flgAbilitazGuiManualOF"/&gt;&lt;/flgAbilitazGuiManualOF&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/caratterizzazioneArea"&gt;&lt;caratterizzazioneArea&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/caratterizzazioneArea"/&gt;&lt;/caratterizzazioneArea&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flagMigDel82"&gt;&lt;flagMigDel82&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flagMigDel82"/&gt;&lt;/flagMigDel82&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/oaoSourceB2B"&gt;&lt;oaoSourceB2B&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/oaoSourceB2B"/&gt;&lt;/oaoSourceB2B&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/fasciaOrariaAppuntamento)"&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/fasciaOrariaAppuntamento"&gt;&lt;fasciaOrariaAppuntamento&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/fasciaOrariaAppuntamento"/&gt;&lt;/fasciaOrariaAppuntamento&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flagNewGpon"&gt;&lt;flagNewGpon&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/flagNewGpon"/&gt;&lt;/flagNewGpon&gt;&lt;/xsl:if&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Lavorazione&gt;&lt;xsl:value-of select="'CESSAZIONE'"/&gt;&lt;/tns2:Lavorazione&gt;&lt;xsl:for-each select="$StartMigrazioneJPUB/tns:StatoNP"&gt;&lt;tns2:StatoAggiuntivi&gt;&lt;tns2:StatoAggiuntivi&gt;&lt;xsl:value-of select="tns:StatoNumeriAggiuntivi"/&gt;&lt;/tns2:StatoAggiuntivi&gt;&lt;/tns2:StatoAggiuntivi&gt;&lt;/xsl:for-each&gt;&lt;tns2:FlagAssetMigrati&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:FlagAssetMigrati&gt;&lt;xsl:for-each select="$StatoFatturazioneMigrazione/tns3:Output"&gt;&lt;tns2:StatoFatturazioneMigrazione&gt;&lt;tns2:StatoFatturazione&gt;&lt;xsl:value-of select="tns3:StatoFatturazione"/&gt;&lt;/tns2:StatoFatturazione&gt;&lt;/tns2:StatoFatturazioneMigrazione&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="string-length($StartMigrazioneJPUB/tns:BPMRequest/tns:NewBilling)&gt;0"&gt;&lt;xsl:if test="$StartMigrazioneJPUB/tns:BPMRequest/tns:NewBilling"&gt;&lt;tns2:NewBilling&gt;&lt;xsl:value-of select="$StartMigrazioneJPUB/tns:BPMRequest/tns:NewBilling"/&gt;&lt;/tns2:NewBilling&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$StartMigrazioneJPUB/tns:BPMRequest/tns:ID_RECUPERO_JPUB_MASTER"&gt;&lt;tns2:ID_RECUPERO_JPUB_MASTER&gt;&lt;xsl:if test="tns:ID_RECUPERO_JPUB_MASTER"&gt;&lt;tns2:ID_RECUPERO_JPUB_MASTER&gt;&lt;xsl:value-of select="tns:ID_RECUPERO_JPUB_MASTER"/&gt;&lt;/tns2:ID_RECUPERO_JPUB_MASTER&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:BDS_ID"&gt;&lt;tns2:BDS_ID&gt;&lt;xsl:value-of select="tns:BDS_ID"/&gt;&lt;/tns2:BDS_ID&gt;&lt;/xsl:if&gt;&lt;/tns2:ID_RECUPERO_JPUB_MASTER&gt;&lt;/xsl:for-each&gt;&lt;/tns2:Request&gt;&lt;/parameters&gt;&lt;/tns1:SubProcessMigrazioneRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/SubProcessMigrazione/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazioneMigrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetCorrelatiCessati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($StartMigrazioneJPUB/tns:BPMRequest/tns:NewBilling)>0 and string-length($StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codiceRifiuto)>0 and $StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codiceRifiuto='A'&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:AssetCorrelatiCessati[offerta!='CPS' and string-length(assetBTWhiteList) = 0]&quot;>&#xa;                        &lt;tns2:Asset>&#xa;                            &lt;xsl:if test=&quot;IDAsset&quot;>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                            &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                                &lt;codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                                &lt;/codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                            &lt;xsl:if test=&quot;invariante&quot;>&#xa;                                &lt;invariante>&#xa;                                    &lt;xsl:value-of select=&quot;invariante&quot;/>&#xa;                                &lt;/invariante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;IDRichiestaOLO&quot;>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDPrimoOrdine&quot;>&#xa;                                &lt;IDPrimoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;IDPrimoOrdine&quot;/>&#xa;                                &lt;/IDPrimoOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;IDContratto>&#xa;                                &lt;xsl:value-of select=&quot;IDContratto&quot;/>&#xa;                            &lt;/IDContratto>&#xa;                            &lt;xsl:if test=&quot;DEC&quot;>&#xa;                                &lt;DEC>&#xa;                                    &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                                &lt;/DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;statoAsset>&#xa;                                &lt;xsl:value-of select=&quot;statoAsset&quot;/>&#xa;                            &lt;/statoAsset>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;xsl:if test=&quot;numeroTelefonico&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;numeroTelefonico&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDAssetCRMWS&quot;>&#xa;                                &lt;IDAssetCRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;IDAssetCRMWS&quot;/>&#xa;                                &lt;/IDAssetCRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDAssetDa&quot;>&#xa;                                &lt;IDAssetDa>&#xa;                                    &lt;xsl:value-of select=&quot;IDAssetDa&quot;/>&#xa;                                &lt;/IDAssetDa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DES>&#xa;                                &lt;xsl:value-of select=&quot;DES&quot;/>&#xa;                            &lt;/DES>&#xa;                            &lt;xsl:if test=&quot;ORA_DES&quot;>&#xa;                                &lt;ORA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;ORA_DES&quot;/>&#xa;                                &lt;/ORA_DES>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tipologiaAccesso>&#xa;                                &lt;xsl:value-of select=&quot;tipologiaAccesso&quot;/>&#xa;                            &lt;/tipologiaAccesso>&#xa;                            &lt;xsl:if test=&quot;RO&quot;>&#xa;                                &lt;RO>&#xa;                                    &lt;xsl:value-of select=&quot;RO&quot;/>&#xa;                                &lt;/RO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;offerta>&#xa;                                &lt;xsl:value-of select=&quot;offerta&quot;/>&#xa;                            &lt;/offerta>&#xa;                            &lt;xsl:if test=&quot;lineaRiferimento&quot;>&#xa;                                &lt;lineaRiferimento>&#xa;                                    &lt;xsl:value-of select=&quot;lineaRiferimento&quot;/>&#xa;                                &lt;/lineaRiferimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;complesso&quot;>&#xa;                                &lt;complesso>&#xa;                                    &lt;xsl:value-of select=&quot;complesso&quot;/>&#xa;                                &lt;/complesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;interno&quot;>&#xa;                                &lt;interno>&#xa;                                    &lt;xsl:value-of select=&quot;interno&quot;/>&#xa;                                &lt;/interno>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;piano&quot;>&#xa;                                &lt;piano>&#xa;                                    &lt;xsl:value-of select=&quot;piano&quot;/>&#xa;                                &lt;/piano>&#xa