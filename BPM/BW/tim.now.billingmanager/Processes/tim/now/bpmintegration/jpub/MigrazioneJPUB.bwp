rtMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y' and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='Y'))&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'ATTESA_INVIO_JPUB'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Richiesta.parameters/tns2:Response[1]/tns2:IDRichOLO)>0 and $Richiesta.parameters/tns2:Response[1]/tns2:IDRichOLO='STS'&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;$Stato&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($StatoFatturazione1/tns3:Output[1]/tns3:ID_RISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$StatoFatturazione1/tns3:Output[1]/tns3:ID_RISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;            