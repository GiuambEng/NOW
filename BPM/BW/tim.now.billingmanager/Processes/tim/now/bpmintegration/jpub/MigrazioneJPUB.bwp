                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/SubProcessMigrazione/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione1&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB