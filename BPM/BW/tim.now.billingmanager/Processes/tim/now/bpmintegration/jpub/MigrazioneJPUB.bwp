                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/SubProcessMigrazione/" xmlns:tns2="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" xmlns:tns3="http://www.tim.com/NOW/xsd/JPUB_Util" version="2.0"&gt;&lt;xsl:param name="StartMigrazioneJPUB"/&gt;&lt;xsl:param name="StatoFatturazioneMigrazione"/&gt;&lt;xsl:template name="AssetCorrelatiCessati-input" match="/"&gt;&lt;tns1:SubProcessMigrazioneRequest&gt;&lt;parameters&gt;&lt;tns2:Request&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($StartMigrazioneJPUB/tns:BPMRequest/tns:NewBilling)&gt;0 and string-length($StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codiceRifiuto)&gt;0 and $StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/codiceRifiuto='A'"&gt;&lt;xsl:for-each select="$StartMigrazioneJPUB/tns:BPMRequest/tns:AssetCorrelatiCessati[offerta!='CPS' and string-length(assetBTWhiteList) = 0]"&gt;&lt;tns2:Asset&gt;&lt;xsl:if test="IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="codiceOrdineOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="codiceOrdineTI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="codiceOrdineTI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="IDRichiestaOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="IDRichiestaOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDPrimoO