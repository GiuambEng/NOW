                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+92ba8672-ddf5-48e6-ba03-01418d659ac4+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiCessati.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateGestioneFatturazioneAssetCessati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($AssetCorrelatiCessati.parameters/tns2:Response[$index]/tns2:ParkingInvioDRO)>0  and (count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N')&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'ATTESA_INVIO_DRO_DIFF'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($AssetCorrelatiCessati.parameters/tns2:Response[$index]/tns2:Parking)>0  and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='Y'))&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'ATTESA_INVIO_JPUB'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:Code = &amp;quot;OK&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDRichOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDRichOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDDettaglioOrdine)&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDDettaglioOrdine)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiCessati.parameters/tns2:Response[number($index)]/tns2:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns5:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
