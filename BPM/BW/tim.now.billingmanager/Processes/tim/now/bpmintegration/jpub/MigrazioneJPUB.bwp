                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogUpdateDa_inviareAssetCessatiToThrow"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns7=&quot;http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateDa_inviareAssetCessati&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_AssetCorrelatiCessati&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateDa_inviareAssetCessati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;UpdateDa_inviareAssetCessati&amp;quot;,string($UpdateDa_inviareAssetCessati/noOfUpdates), &amp;quot; record aggiornati.&amp;quot;)&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Errore subProcessMigrazione',$_error/StackTrace,$_error/Msg,$_error/MsgCode,$_error/ProcessStack,$_error_AssetCorrelatiCessati/tns7:ActivityTimedOutException/msg,$_error_AssetCorrelatiCessati/tns7:ActivityTimedOutException/msgCode,$_error_AssetCorrelatiCessati/tns2:Fault/tns2:Msg,$_error_AssetCorrelatiCessati/tns2:Fault/tns2:Code)&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="StatoFatturazioneMigrazione-input"
                    name="StatoFatturazioneMigrazione"
                    outputVariable="StatoFatturazioneMigrazione"
                    tibex:xpdlId="f12cbf55-8a1e-408d-8a1e-7976d5f1ee13"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToStatoFatturazioneMigrazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAssetCorrelatiCessati"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&lt;xsl:template name=&quot;StatoFatturazioneMigrazione-input&quot; match=&quot;/&quot;>&lt;tns:SendJPUBRequest>&lt;tns:Stato>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Stato&quot;/>&lt;/tns:Stato>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest&quot;/>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:StatoNP&quot;/>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:NPTimer&quot;>&lt;tns:NPTimer>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:NPTimer&quot;/>&lt;/tns:NPTimer>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:WLRTimer&quot;>&lt;tns:WLRTimer>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:WLRTimer&quot;/>&lt;/tns:WLRTimer>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:Operespeciali&quot;>&lt;tns:Operespeciali>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Operespeciali&quot;/>&lt;/tns:Operespeciali>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:Asset&quot;/>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:Lavorazione&quot;>&lt;tns:Lavorazione>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Lavorazione&quot;/>&lt;/tns:Lavorazione>&lt;/xsl:if>&lt;/tns:SendJPUBRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.SubProcess.StatoFatturazioneMigrazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="ControlloTLC" tibex:xpdlId="14b5efc0-8d90-4f82-8dc5-b45c95b042a5">
                <bpws:targets>
                    <bpws:target linkName="AnnullamentoToControlloTLC"/>
                    <bpws:target linkName="LogAssetCorrelatiCessatiToControlloTLC"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ControlloTLCToEmpty4">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($StartMigrazioneJPUB/ns11:BPMRequest/ns11:Asset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($StartMigrazioneJPUB/ns11:BPMRequest/ns11:Asset)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlloTLCToCallProcess_TLC">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogMigrazioneTLC-input"
                    name="LogMigrazioneTLC"
                    tibex:xpdlId="82dfe914-d75f-4ca7-b639-2e4b9a1a91c4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlloTLCToCallProcess_TLC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMigrazioneTLCToEmpty7"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMigrazioneTLC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrazioneJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Fatturazione non prevista per ordinativi TLC'&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Annullamento" tibex:xpdlId="ba9d6fc8-f26a-48e3-b97e-a05799bb1866">
                <bpws:targets>
                    <bpws:target linkName="WhileToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToStatoFatturazione1_Annullato">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$StartMigrazioneJPUB/ns11:BPMRequest/ns11:Richiesta/statoRichiestaNOW='ANNULLATO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$StartMigrazioneJPUB/ns11:BPMRequest/ns11:Richiesta/statoRichiestaNOW='ANNULLATO']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="AnnullamentoToControlloTLC">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UpdateRequest-input"
                    name="UpdateRequest" outputVariable="UpdateRequest"
                    tibex:xpdlId="2d5daa5e-4f1d-431c-a533-adf237359975"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateGestioneFatturazioneToCallProcess"/>
                        <bpws:target linkName="EmptyToUpdateRequest"/>
                        <bpws:target linkName="Empty1ToUpdateRequest"/>
                        <bpws:target linkName="CallProcessToUpdateRequest"/>
                        <bpws:target linkName="Empty2ToUpdateRequest"/>
                        <bpws:target linkName="Empty7ToUpdateRequest"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToLogEndMigrazioneJPUB1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione1&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazioneMigrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:UpdateRichiestaRequest>&#xa;            &lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                &lt;tns3:IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IDRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($StartMigrazioneJPUB/tns:BPMRequest/tns:Asset)&quot;>&#xa;                    &lt;xsl:if test=&quot;$StatoFatturazione1/tns3:Output[1]/tns3:ID_EVENTO_ORDN_NOW&quot;>&#xa;                        &lt;tns3:ID_EVENTO_ORDN_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$StatoFatturazione1/tns3:Output[1]/tns3:ID_EVENTO_ORDN_NOW&quot;/>&#xa;                        &lt;/tns3:ID_EVENTO_ORDN_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$StatoFatturazioneMigrazione/tns3:Output[1]/tns3:ID_EVENTO_ORDN_NOW&quot;>&#xa;                        &lt;tns3:ID_EVENTO_ORDN_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$StatoFatturazioneMigrazione/tns3:Output[1]/tns3:ID_EVENTO_ORDN_NOW&quot;/>&#xa;                        &lt;/tns3:ID_EVENTO_ORDN_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:StatoRichiestaNow>&#xa;                &lt;xsl:value-of select=&quot;'INVIATOAFATTURAZIONE'&quot;/>&#xa;            &lt;/tns3:StatoRichiestaNow>&#xa;        &lt;/tns3:UpdateRichiestaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.SubProcess.UpdateRequest" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if($Richiesta/parameters/ns12:Response/ns12:Response[1]/ns12:Code = &quot;OK&quot;) then 'RICEVUTO_ACK' else 'DA_INVIARE'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Stato" name="Assign"
                    outputVariable="Stato"
                    tibex:xpdlId="8bf462eb-065b-4a78-a7f1-8395fdd2b31c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToUpdateGestioneFatturazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Stato='DA_INVIARE'  and  string-length($Richiesta/parameters/ns12:Response/ns12:Response[1]/ns12:Control)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Stato='DA_INVIARE'  and  string-length($Richiesta.parameters/ns12:Response[1]/ns12:Control)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if($Richiesta.parameters/ns12:Response[1]/ns12:Code = &quot;OK&quot;) then 'RICEVUTO_ACK' else 'DA_INVIARE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Stato" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
