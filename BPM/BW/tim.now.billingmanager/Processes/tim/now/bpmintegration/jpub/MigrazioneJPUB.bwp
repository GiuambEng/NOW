                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+92ba8672-ddf5-48e6-ba03-01418d659ac4+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;AssetCorrelatiCessati&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;UpdateGestioneFatturazioneAssetCessati-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($AssetCorrelatiCessati/parameters/tns2:Response/tns2:Response[$index]/tns2:ParkingInvioDRO)>0  and (count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N')&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'ATTESA_INVIO_DRO_DIFF'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($AssetCorrelatiCessati/parameters/tns2:Response/tns2:Response[$index]/tns2:Parking)>0  and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='Y'))&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'ATTESA_INVIO_JPUB'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:when test=&quot;$AssetCorrelatiCessati/parameters/tns2:Response/tns2:Response[number($index)]/tns2:Code = &amp;quot;OK&amp;quot;&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:va