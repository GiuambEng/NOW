                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xa;WHERE ID_RISORSA = ? AND ID_RICH_OLO = ? AND IDDETTAGLIOORDINE = ? AND ID_EVENTO_ORDN_NOW_WHLS=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
