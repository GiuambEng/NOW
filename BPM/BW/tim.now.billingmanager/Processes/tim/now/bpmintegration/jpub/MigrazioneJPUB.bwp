-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDASERVIZIO']/valoreAttributo)='ISDN PRA' or upper-case(dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDASERVIZIO']/valoreAttributo)='ISDNPRA' ) and string-length(dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)=0"&gt;&lt;xsl:for-each select="dettaglioasset[nomeComponente!='ACCESSOWLR']"&gt;&lt;dettaglioasset&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;xsl:if test="IDDettaglioAssetParent"&gt;&lt;IDDettaglioAssetParent&gt;&lt;xsl:value-of select="IDDettaglioAssetParent"/&gt;&lt;/IDDettaglioAssetParent&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDDettaglioAssetRoot"&gt;&lt;IDDettaglioAssetRoot&gt;&lt;xsl:value-of select="IDDettaglioAssetRoot"/&gt;&lt;/IDDettaglioAssetRoot&gt;&lt;/xsl:if&gt;&lt;integrationID&gt;&lt;xsl:value-of select="integrationID"/&gt;&lt;/integrationID&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;IDRisorsa&gt;&lt;xsl:value-of select="IDRisorsa"/&gt;&lt;/IDRisorsa&gt;&lt;nomeComponente&gt;&lt;xsl:value-of select="nomeComponente"/&gt;&lt;/nomeComponente&gt;&lt;xsl:copy-of select="attributidettaglioasset"/&gt;&lt;IDRisorsaNOW&gt;&lt;xsl:value-of select="IDRisorsaNOW"/&gt;&lt;/IDRisorsaNOW&gt;&lt;IDDettaglioAsset&gt;&lt;xsl:value-of select="IDDettaglioAsset"/&gt;&lt;/IDDettaglioAsset&gt;&lt;statoDettaglioAsset&gt;&lt;xsl:value-of select="statoDettaglioAsset"/&gt;&lt;/statoDettaglioAsset&gt;&lt;progressivo&gt;&lt;xsl:value-of select="progressivo"/&gt;&lt;/progressivo&gt;&lt;/dettaglioasset&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="dettaglioasset[nomeComponente='ACCESSOWLR']"&gt;&lt;dettaglioasse