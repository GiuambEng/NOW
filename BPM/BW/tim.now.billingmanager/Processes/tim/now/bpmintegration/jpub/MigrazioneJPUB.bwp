                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartMigrazioneJPUB&quot;/>&lt;xsl:template name=&quot;StatoFatturazione-input&quot; match=&quot;/&quot;>&lt;tns:SendJPUBRequest>&lt;tns:Stato>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Stato&quot;/>&lt;/tns:Stato>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:BPMRequest&quot;/>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:StatoNP&quot;/>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:NPTimer&quot;>&lt;tns:NPTimer>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:NPTimer&quot;/>&lt;/tns:NPTimer>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:WLRTimer&quot;>&lt;tns:WLRTimer>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:WLRTimer&quot;/>&lt;/tns:WLRTimer>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:Operespeciali&quot;>&lt;tns:Operespeciali>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Operespeciali&quot;/>&lt;/tns:Operespeciali>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$StartMigrazioneJPUB/tns:Asset&quot;/>&lt;xsl:if test=&quot;$StartMigrazioneJPUB/tns:Lavorazione&quot;>&lt;tns:Lavorazione>&lt;xsl:value-of select=&quot;$StartMigrazioneJPUB/tns:Lavorazione&quot;/>&lt;/tns:Lavorazione>&lt;/xsl:if>&lt;/tns:SendJPUBRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.SubProcess.StatoFatturazioneMigrazioneAttivazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
