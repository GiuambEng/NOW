                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_EVENTORetryOpereSpeciali&quot;/>&#xa;    &lt;xsl:template name=&quot;Record&quot; match=&quot;/&quot;>&#xa;        &lt;tns:UPDATEGestioneFatturazioneRecord>&#xa;            &lt;tns:Record>&#xa;                &lt;tns:CONTENUTO_XML>&#xa;                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns:ContenutoOpereSpecialiXDSL[1]&quot;/>&#xa;                &lt;/tns:CONTENUTO_XML>&#xa;                &lt;tns:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_AGGTO>&#xa;                &lt;tns:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$SelectID_EVENTORetryOpereSpeciali/Record[1]/ID_RISORSA&quot;/>&#xa;                &lt;/tns:ID_RISORSA>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW &quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;                &lt;tns:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:IDEventoOrdnTimer&quot;/>&#xa;                &lt;/tns:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#