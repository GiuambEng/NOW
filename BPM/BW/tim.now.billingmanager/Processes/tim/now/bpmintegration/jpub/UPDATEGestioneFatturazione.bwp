                    <bpws:source linkName="ControlSTSToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="not(exists($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/tns:SendJPUBRequest/ns5:REGOLATORIO/ns5:TESTATA)) and not(exists($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/tns:SendJPUBRequest/ns5:REGOLATORIO/ns5:PREVENTIVO)) and not(exists($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/tns:SendJPUBRequest/ns6:ORDINI_CRMWS/ns6:TESTATA)) and not(exists($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/tns:SendJPUBRequest/ns6:ORDINI_CRMWS/ns6:PREVENTIVO)) and string-length($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/tns:SendJPUBRequest/tns:BPMRequest/tns:NPSync)=0 and string-length($UPDATEGestioneFatturazioneIn/input/ns12:UPDATEGestioneFatturazioneRequest/ns12:ContenutoSTS)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[not(exists($UPDATEGestioneFatturazioneIn.input/tns:SendJPUBRequest/ns5:REGOLATORIO/ns5:TESTATA)) and not(exists($UPDATEGestioneFatturazioneIn.input/tns:SendJPUBRequest/ns5:REGOLATORIO/ns5:PREVENTIVO)) and not(exists($UPDATEGestioneFatturazioneIn.input/tns:SendJPUBRequest/ns6:ORDINI_CRMWS/ns6:TESTATA)) and not(exists($UPDATEGestioneFatturazioneIn.input/tns:SendJPUBRequest/ns6:ORDINI_CRMWS/ns6:PREVENTIVO)) and string-length($UPDATEGestioneFatturazioneIn.input/tns:SendJPUBRequest/tns:BPMRequest/tns:NPSync)=0 and string-length($UPDATEGestioneFatturazioneIn.input/ns12:ContenutoSTS)>0]]></bpws:transitionCondition>
