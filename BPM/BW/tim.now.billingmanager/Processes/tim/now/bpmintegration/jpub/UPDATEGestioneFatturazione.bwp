                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_EVENTO_ORDN_NOW&quot;/>&#xa;    &lt;xsl:template name=&quot;Record&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:UPDATEGestioneFatturazioneRecord>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta) = &amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;tns2:Record>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoNP&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:ID_RICH_OLO>&#xa;                        &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE))&quot;>&#xa;                                &lt;tns2:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE)&quot;/>&#xa;                                &lt;/tns2:IDDETTAGLIOORDINE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync&quot;>&#xa;                                            &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync&quot;/>&#xa;                                            &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                            &lt;xsl:value-of select=&quot;concat($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;,&amp;quot;1&amp;quot;)&quot;/>&#xa;                                        &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:TIPO_AZIONE&quot;>&#xa;                                    &lt;tns2:TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:TIPO_AZIONE&quot;/>&#xa;                                    &lt;/tns2:TIPO_AZIONE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:CODE_CAUS&quot;>&#xa;                                    &lt;tns2:CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:CODE_CAUS&quot;/>&#xa;                                    &lt;/tns2:CODE_CAUS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Record>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta) = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns2:Record>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync,'_S'))&quot;>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoNP&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoREG)&quot;>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoREG&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0 and string-length($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoSTS)>0&quot;>&#xa;                                        &lt;tns2:CONTENUTO_XML>&#xa;                                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoSTS&quot;/>&#xa;                                        &lt;/tns2:CONTENUTO_XML>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoWLR)&quot;>&#xa;                                        &lt;tns2:CONTENUTO_XML>&#xa;                                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoWLR&quot;/>&#xa;                                        &lt;/tns2:CONTENUTO_XML>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CONTENUTO_XML>&#xa;                                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoWLRAggiuntivi[1]&quot;/>&#xa;                                        &lt;/tns2:CONTENUTO_XML>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0   and not(contains($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync,'_S')) and string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:ID_RICH_OLO>&#xa;                        &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE))&quot;>&#xa;                                &lt;tns2:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE)&quot;/>&#xa;                                &lt;/tns2:IDDETTAGLIOORDINE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync&quot;>&#xa;                                            &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync&quot;/>&#xa;                                            &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                            &lt;xsl:value-of select=&quot;concat($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;,&amp;quot;1&amp;quot;)&quot;/>&#xa;                                        &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:TIPO_AZIONE&quot;>&#xa;                                    &lt;tns2:TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:TIPO_AZIONE&quot;/>&#xa;                                    &lt;/tns2:TIPO_AZIONE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiREG)&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:CODE_CAUS&quot;>&#xa;                                    &lt;tns2:CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:CODE_CAUS&quot;/>&#xa;                                    &lt;/tns2:CODE_CAUS>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Record>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Record>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiXDSL[1])&quot;>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiXDSL[1]&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:CONTENUTO_XML>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:ContenutoXDSL&quot;/>&#xa;                                &lt;/tns2:CONTENUTO_XML>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:TIMSTP_AGGTO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:ID_RICH_OLO>&#xa;                        &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE))&quot;>&#xa;                                &lt;tns2:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE)&quot;/>&#xa;                                &lt;/tns2:IDDETTAGLIOORDINE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:ContenutoOpereSpecialiXDSL[1])&quot;>&#xa;                                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                    &lt;xsl:value-of select=&quot;concat($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;,&amp;quot;1