                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9cbe727b-fc61-4d90-a45b-cd34eb36dfc7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;IDEvento&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;IDDETTAGLIOORDINE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDDETTAGLIOORDINE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)>0&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;TIMSTP_INSMTO_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_EVENTO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IDEvento/IDEventoOrdnNowWhls)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IDEvento/IDEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;DESCR>&#xa;                &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;            &lt;/DESCR>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;            &lt;STRUTTURA_OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;            &lt;/STRUTTURA_OFFERTA>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;CONTENUTO_XML>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:ContenutoSTS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:ContenutoSTS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CONTENUTO_XML>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0, 0, 0, 0, 0, 20)&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:value-of select=&quot;concat($UPDATEGestioneFatturazioneIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO,'-','ST')&quot;/>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;TIPO_AZIONE>&#xa;                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;            &lt;/TIPO_AZIONE>&#xa;            &lt;CODICE_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;'W1'&quot;/>&#xa;            &lt;/CODICE_CAUSALE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EVENTO_JPUB(IDDETTAGLIOORDINE, ID_RISORSA, ID_RICH_OLO, NUMERO_TENTATIVI, TIMSTP_INSMTO_EVENTO, ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_JPUB, IDTPLG_STATO_EVENTO_JPUB,FLAG_CONSUNTIVO,STRUTTURA_OFFERTA,OFFERTA,CONTENUTO_XML, TIMSTP_AGGTO , ID_ORDINE_COMPOSTO,TIPO_AZIONE&#xa;,CODICE_CAUSALE)&#xa;VALUES(?, ?, ?, ?, ?, ?, (S_ID_RICH_JPUB.NEXTVAL), (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_TENTATIVI"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO_EVENTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
