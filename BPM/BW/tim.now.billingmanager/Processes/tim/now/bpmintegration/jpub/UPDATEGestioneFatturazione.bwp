of select=&quot;0&quot;/>&lt;/FLAG_CONSUNTIVO>&lt;STRUTTURA_OFFERTA>&lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&lt;/STRUTTURA_OFFERTA>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta)&quot;>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;CONTENUTO_XML>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns1:ContenutoSTS)&quot;>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns1:ContenutoSTS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_XML>&lt;TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0, 0, 0, 0, 0, 20)&quot;/>&lt;/TIMSTP_AGGTO>&lt;ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO,'-','ST')&quot;/>&lt;/ID_ORDINE_COMPOSTO>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/TIPO_AZIONE>&lt;CODICE_CAUSALE>&lt;xsl:value-of select=&quot;'W1'&quot;/>&lt;/CODICE_CAUSALE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
