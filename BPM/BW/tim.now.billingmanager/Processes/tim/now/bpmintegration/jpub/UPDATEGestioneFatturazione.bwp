              &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'RACCOLTA')]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'RACCOLTA')]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)>0 &quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine)&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$UPDATEGestioneFatturazioneIn.input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Flag_OpereSpeciali=true()&quot;>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
