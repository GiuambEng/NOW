                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9cbe727b-fc61-4d90-a45b-cd34eb36dfc7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UPDATEGestioneFatturazioneIn&quot;/>&lt;xsl:param name=&quot;IDEvento&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneIn/input/tns1:UPDATEGestioneFatturazioneReque