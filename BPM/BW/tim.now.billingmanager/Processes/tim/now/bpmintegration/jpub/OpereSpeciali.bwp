                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCONSUNTIVO&quot;/>&#xa;    &lt;xsl:param name=&quot;Contratto&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioConsuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($OpereSpecialiIn.input/tns2:SendJPUBRequest/tns:REGOLATORIO/tns:PREVENTIVO)&quot;>&#xa;                &lt;tns:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns:REGOLATORIO/tns:PREVENTIVO&quot;/>&#xa;                &lt;/tns:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:REGOLATORIO>&#xa;                    &lt;tns:PREVENTIVO>&#xa;                        &lt;ID_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($OpereSpecialiIn.input/tns1:IDPreventivo)&quot;/>&#xa;                        &lt;/ID_PREVENTIVO>&#xa;                        &lt;ID_RICHIESTA_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/ID_RICHIESTA_NOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($Contratto/Record)>0&quot;>&#xa;                                &lt;ID_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Contratto/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                &lt;/ID_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/ID_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($OpereSpecialiIn.input/tns1:CodiceOrdineOLO)>0&quot;>&#xa;                                &lt;CODICE_ORDINE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:CodiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ID_RIS>&#xa;                            &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:IDRisorsa&quot;/>&#xa;                        &lt;/ID_RIS>&#xa;                        &lt;TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                        &lt;/TIPO_SERVIZIO>&#xa;                        &lt;TECNOLOGIA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/TECNOLOGIA>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime($OpereSpecialiIn.input/tns1:DRO)&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                        &lt;DATA_INVIO_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_INVIO_PREVENTIVO>&#xa;                        &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                        &lt;xsl:for-each select=&quot;$SelectCONSUNTIVO/Record&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&#xa;                                    &lt;tns:DETTAGLIO>&#xa;                                        &lt;ID_VOCE>&#xa;                                            &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                        &lt;/ID_VOCE>&#xa;                                        &lt;QUANTITA>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&#xa;                                        &lt;/QUANTITA>&#xa;                                    &lt;/tns:DETTAGLIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DETTAGLIO>&#xa;                                        &lt;ID_VOCE>&#xa;                                            &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                        &lt;/ID_VOCE>&#xa;                                        &lt;QUANTITA>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&#xa;                                        &lt;/QUANTITA>&#xa;                                    &lt;/tns:DETTAGLIO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:PREVENTIVO>&#xa;                &lt;/tns:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
