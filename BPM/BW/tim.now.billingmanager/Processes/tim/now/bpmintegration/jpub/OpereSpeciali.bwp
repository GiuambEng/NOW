&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.now/NOW/wsdl/abstract/OpereSpeciali/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns1="http://www.tim.com/NOW/xsd/OpereSpeciali/" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:tns2="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns3="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns4="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InvioConsultivoXDSL_NGA"/&gt;&lt;xsl:param name="InvioConsuntivi"/&gt;&lt;xsl:param name="OpereSpecialiIn"/&gt;&lt;xsl:param name="InsertUpdateStaging"/&gt;&lt;xsl:param name="Controllo"/&gt;&lt;xsl:param name="UPDATEGestioneFatturazioneOpereSpeciali"/&gt;&lt;xsl:template name="OpereSpecialiOut-input" match="/"&gt;&lt;tns:OpereSpecialiResponse&gt;&lt;output&gt;&lt;tns1:OpereSpecialiResponse&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsuntivi/ns:PREVENTIVO)"&gt;&lt;ns:REGOLATORIO&gt;&lt;ns:PREVENTIVO&gt;&lt;ID_PREVENTIVO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/ID_PREVENTIVO"/&gt;&lt;/ID_PREVENTIVO&gt;&lt;ID_RICHIESTA_NOW&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/ID_RICHIESTA_NOW&gt;&lt;ID_OLO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/ID_OLO"/&gt;&lt;/ID_OLO&gt;&lt;CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/CODICE_ORDINE_OLO"/&gt;&lt;/CODICE_ORDINE_OLO&gt;&lt;ID_RIS&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/ID_RIS"/&gt;&lt;/ID_RIS&gt;&lt;TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/TIPO_SERVIZIO"/&gt;&lt;/TIPO_SERVIZIO&gt;&lt;TECNOLOGIA&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/TECNOLOGIA"/&gt;&lt;/TECNOLOGIA&gt;&lt;DATA_DRO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/DATA_DRO"/&gt;&lt;/DATA_DRO&gt;&lt;xsl:if test="$InvioConsuntivi/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO"&gt;&lt;DATA_INVIO_PREVENTIVO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO"/&gt;&lt;/DATA_INVIO_PREVENTIVO&gt;&lt;/xsl:if&gt;&lt;DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;&lt;/DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:copy-of select="$InvioConsuntivi/ns:PREVENTIVO/ns:DETTAGLIO"/&gt;&lt;/ns:PREVENTIVO&gt;&lt;/ns:REGOLATORIO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO)"&gt;&lt;ns1:ORDINI_CRMWS&gt;&lt;xsl:for-each select="$InvioConsultivoXDSL_NGA/ns1:PREVENTIVO"&gt;&lt;ns1:PREVENTIVO&gt;&lt;ID_PREVENTIVO&gt;&lt;xsl:value-of select="ID_PREVENTIVO"/&gt;&lt;/ID_PREVENTIVO&gt;&lt;ID_RICHIESTA_NOW&gt;&lt;xsl:value-of select="ID_RICHIESTA_NOW"/&gt;&lt;/ID_RICHIESTA_NOW&gt;&lt;ID_OLO&gt;&lt;xsl:value-of select="ID_OLO"/&gt;&lt;/ID_OLO&gt;&lt;CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="CODICE_ORDINE_OLO"/&gt;&lt;/CODICE_ORDINE_OLO&gt;&lt;ID_RIS&gt;&lt;xsl:value-of select="ID_RIS"/&gt;&lt;/ID_RIS&gt;&lt;TIPO_SERVIZIO&gt;&lt;xsl:value-of select="TIPO_SERVIZIO"/&gt;&lt;/TIPO_SERVIZIO&gt;&lt;TECNOLOGIA&gt;&lt;xsl:value-of select="TECNOLOGIA"/&gt;&lt;/TECNOLOGIA&gt;&lt;DATA_DRO&gt;&lt;xsl:value-of select="DATA_DRO"/&gt;&lt;/DATA_DRO&gt;&lt;xsl:if test="DATA_INVIO_PREVENTIVO"&gt;&lt;DATA_INVIO_PREVENTIVO&gt;&lt;xsl:value-of select="DATA_INVIO_PREVENTIVO"/&gt;&lt;/DATA_INVIO_PREVENTIVO&gt;&lt;/xsl:if&gt;&lt;DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:value-of select="DATA_RICHIESTA_PREVENTIVO"/&gt;&lt;/DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:copy-of select="ns1:DETTAGLIO"/&gt;&lt;/ns1:PREVENTIVO&gt;&lt;/xsl:for-each&gt;&lt;/ns1:ORDINI_CRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:Stato"&gt;&lt;tns1:Stato&gt;&lt;xsl:value-of select="$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:Stato"/&gt;&lt;/tns1:Stato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($InsertUpdateStaging/RESPONSE/tns3:StagingResponse)"&gt;&lt;tns1:ResponseStaging&gt;&lt;tns1:ResponseStaging&gt;&lt;xsl:value-of select="tib:render-xml($InsertUpdateStaging/RESPONSE/tns3:StagingResponse,true(),true())"/&gt;&lt;/tns1:ResponseStaging&gt;&lt;/tns1:ResponseStaging&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Controllo='True'"&gt;&lt;tns1:ControlloStaging&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns1:ControlloStaging&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ControlloStaging&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:ControlloStaging&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Flag_OpereSpeciali=true()"&gt;&lt;xsl:for-each select="$UPDATEGestioneFatturazioneOpereSpeciali/output/tns4:UPDATEGestioneFatturazioneResponse/tns4:PRINCIPALE/tns4:Record"&gt;&lt;tns1:UpdateGestione&gt;&lt;tns1:ID_Rich_OLO&gt;&lt;xsl:value-of select="tns4:ID_RICH_OLO"/&gt;&lt;/tns1:ID_Rich_OLO&gt;&lt;tns1:ID_Evento_Ordn_Now_Whls&gt;&lt;xsl:value-of select="tns4:ID_EVENTO_ORDN_NOW_WHLS"/&gt;&lt;/tns1:ID_Evento_Ordn_Now_Whls&gt;&lt;/tns1:UpdateGestione&gt;&lt;/xsl:for-each&gt;&lt;/xsl:if&gt;&lt;/tns1:OpereSpecialiResponse&gt;&lt;/output&gt;&lt;/tns:OpereSpecialiResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.now/NOW/wsdl/abstract/OpereSpeciali/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertUpdateStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneOpereSpeciali.output&quot;/>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsultivoXDSL_NGA&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;Controllo&quot;/>&#xa;    &lt;xsl:template name=&quot;OpereSpecialiOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:OpereSpecialiResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InvioConsuntivi/ns:PREVENTIVO)&quot;>&#xa;                    &lt;ns:REGOLATORIO>&#xa;                        &lt;ns:PREVENTIVO>&#xa;                            &lt;ID_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/ID_PREVENTIVO&quot;/>&#xa;                            &lt;/ID_PREVENTIVO>&#xa;                            &lt;ID_RICHIESTA_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/ID_RICHIESTA_NOW>&#xa;                            &lt;ID_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/ID_OLO&quot;/>&#xa;                            &lt;/ID_OLO>&#xa;                            &lt;CODICE_ORDINE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/CODICE_ORDINE_OLO&quot;/>&#xa;                            &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/ID_RIS&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;TIPO_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/TIPO_SERVIZIO&quot;/>&#xa;                            &lt;/TIPO_SERVIZIO>&#xa;                            &lt;TECNOLOGIA>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/TECNOLOGIA&quot;/>&#xa;                            &lt;/TECNOLOGIA>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;xsl:if test=&quot;$InvioConsuntivi/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;>&#xa;                                &lt;DATA_INVIO_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;/>&#xa;                                &lt;/DATA_INVIO_PREVENTIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO&quot;/>&#xa;                            &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                            &lt;xsl:copy-of select=&quot;$InvioConsuntivi/ns:PREVENTIVO/ns:DETTAGLIO&quot;/>&#xa;                        &lt;/ns:PREVENTIVO>&#xa;                    &lt;/ns:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO)&quot;>&#xa;                    &lt;ns1:ORDINI_CRMWS>&#xa;                        &lt;xsl:for-each select=&quot;$InvioConsultivoXDSL_NGA/ns1:PREVENTIVO&quot;>&#xa;                            &lt;ns1:PREVENTIVO>&#xa;                                &lt;ID_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;ID_PREVENTIVO&quot;/>&#xa;                                &lt;/ID_PREVENTIVO>&#xa;                                &lt;ID_RICHIESTA_NOW>&#xa;                                    &lt;xsl:value-of select=&quot;ID_RICHIESTA_NOW&quot;/>&#xa;                                &lt;/ID_RICHIESTA_NOW>&#xa;                                &lt;ID_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;ID_OLO&quot;/>&#xa;                                &lt;/ID_OLO>&#xa;                                &lt;CODICE_ORDINE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_ORDINE_OLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_OLO>&#xa;                                &lt;ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;ID_RIS&quot;/>&#xa;                                &lt;/ID_RIS>&#xa;                                &lt;TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_SERVIZIO&quot;/>&#xa;                                &lt;/TIPO_SERVIZIO>&#xa;                                &lt;TECNOLOGIA>&#xa;                                    &lt;xsl:value-of select=&quot;TECNOLOGIA&quot;/>&#xa;                                &lt;/TECNOLOGIA>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                                &lt;xsl:if test=&quot;DATA_INVIO_PREVENTIVO&quot;>&#xa;                                    &lt;DATA_INVIO_PREVENTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_INVIO_PREVENTIVO&quot;/>&#xa;                                    &lt;/DATA_INVIO_PREVENTIVO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_RICHIESTA_PREVENTIVO&quot;/>&#xa;                                &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                                &lt;xsl:copy-of select=&quot;ns1:DETTAGLIO&quot;/>&#xa;                            &lt;/ns1:PREVENTIVO>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/ns1:ORDINI_CRMWS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:Stato&quot;>&#xa;                &lt;tns1:Stato>&#xa;                    &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:Stato&quot;/>&#xa;                &lt;/tns1:Stato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($InsertUpdateStaging.RESPONSE)&quot;>&#xa;                &lt;tns1:ResponseStaging>&#xa;                    &lt;tns1:ResponseStaging>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($InsertUpdateStaging.RESPONSE,true(),true())&quot;/>&#xa;                    &lt;/tns1:ResponseStaging>&#xa;                &lt;/tns1:ResponseStaging>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Controllo='True'&quot;>&#xa;                    &lt;tns1:ControlloStaging>&#xa;                        &lt;xsl:va