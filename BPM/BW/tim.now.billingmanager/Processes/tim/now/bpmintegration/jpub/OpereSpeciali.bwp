            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OpereSpecialiIn&quot;/>&lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&lt;xsl:param name=&quot;SelectCONSUNTIVO&quot;/>&lt;xsl:param name=&quot;Contratto&quot;/>&lt;xsl:template name=&quot;InvioConsultivoXDSL_NGA-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns:ORDINI_CRMWS/tns:PREVENTIVO)&quot;>&lt;tns:ORDINI_CRMWS>&lt;xsl:copy-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns:ORDINI_CRMWS/tns:PREVENTIVO&quot;/>&lt;/tns:ORDINI_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ORDINI_CRMWS>&lt;tns:PREVENTIVO>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:string($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDPreventivo)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_RICHIESTA_NOW>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDRichiestaOLO&quot;/>&lt;/ID_RICHIESTA_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Contratto/Record)>0&quot;>&lt;ID_OLO>&lt;xsl:value-of select=&quot;$Contratto/Record[1]/COD_CONTRATTO&quot;/>&lt;/ID_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_OLO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ID_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:CodiceOrdineOLO)>0&quot;>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:CodiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDRisorsa&quot;/>&lt;/ID_RIS>&lt;TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_SERVIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta=('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;FTTH&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:when>&lt;xsl:when test=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta='VULAFTTCAB' or $OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta='EASYIPNGAFTTCAB'  or $OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta='BITSTREAMNGAFTTCAB'&quot;>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;FTTCAB&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:DRO)&quot;/>&lt;/DATA_DRO>&lt;DATA_INVIO_PREVENTIVO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_INVIO_PREVENTIVO>&lt;DATA_RICHIESTA_PREVENTIVO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_RICHIESTA_PREVENTIVO>&lt;xsl:for-each select=&quot;$SelectCONSUNTIVO/Record&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&lt;tns:DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&lt;/QUANTITA>&lt;/tns:DETTAGLIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&lt;/QUANTITA>&lt;/tns:DETTAGLIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns:PREVENTIVO>&lt;/tns:ORDINI_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InvioConsultivoXDSL_NGA-input"
                    name="InvioConsultivoXDSL_NGA"
                    outputVariable="InvioConsultivoXDSL_NGA"
                    tibex:xpdlId="b6a5e463-155a-41d0-a2ee-b9fd64e27f70" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper_XDSL-NGA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InvioConsultivoXDSL_NGAToCallProcess"/>
                        <bpws:source
                            linkName="InvioConsultivoXDSL_NGAToCallProcess3"
                            tibex:faultDetailsVar="InvioConsultivoXDSL_NGA" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCONSUNTIVO&quot;/>&#xa;    &lt;xsl:param name=&quot;Contratto&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioConsultivoXDSL_NGA-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($OpereSpecialiIn.input/tns2:SendJPUBRequest/tns:ORDINI_CRMWS/tns:PREVENTIVO)&quot;>&#xa;                &lt;tns:ORDINI_CRMWS>&#xa;                    &lt;xsl:copy-of select=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns:ORDINI_CRMWS/tns:PREVENTIVO&quot;/>&#xa;                &lt;/tns:ORDINI_CRMWS>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:ORDINI_CRMWS>&#xa;                    &lt;tns:PREVENTIVO>&#xa;                        &lt;ID_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($OpereSpecialiIn.input/tns1:IDPreventivo)&quot;/>&#xa;                        &lt;/ID_PREVENTIVO>&#xa;                        &lt;ID_RICHIESTA_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/ID_RICHIESTA_NOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($Contratto/Record)>0&quot;>&#xa;                                &lt;ID_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Contratto/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                &lt;/ID_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/ID_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($OpereSpecialiIn.input/tns1:CodiceOrdineOLO)>0&quot;>&#xa;                                &lt;CODICE_ORDINE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:CodiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ID_RIS>&#xa;                            &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:IDRisorsa&quot;/>&#xa;                        &lt;/ID_RIS>&#xa;                        &lt;TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                        &lt;/TIPO_SERVIZIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$OpereSpecialiIn.input/tns1:Offerta=('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&#xa;                                &lt;TECNOLOGIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FTTH&amp;quot;&quot;/>&#xa;                                &lt;/TECNOLOGIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$OpereSpecialiIn.input/tns1:Offerta='VULAFTTCAB' or $OpereSpecialiIn.input/tns1:Offerta='EASYIPNGAFTTCAB'  or $OpereSpecialiIn.input/tns1:Offerta='BITSTREAMNGAFTTCAB'&quot;>&#xa;                                &lt;TECNOLOGIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/TECNOLOGIA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;TECNOLOGIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TECNOLOGIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime($OpereSpecialiIn.input/tns1:DRO)&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                        &lt;DATA_INVIO_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_INVIO_PREVENTIVO>&#xa;                        &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                        &lt;xsl:for-each select=&quot;$SelectCONSUNTIVO/Record&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&#xa;                                    &lt;tns:DETTAGLIO>&#xa;                                        &lt;ID_VOCE>&#xa;                                            &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                        &lt;/ID_VOCE>&#xa;                                        &lt;QUANTITA>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&#xa;                                        &lt;/QUANTITA>&#xa;                                    &lt;/tns:DETTAGLIO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DETTAGLIO>&#xa;                                        &lt;ID_VOCE>&#xa;                                            &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                        &lt;/ID_VOCE>&#xa;                                        &lt;QUANTITA>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&#xa;                                        &lt;/QUANTITA>&#xa;                                    &lt;/tns:DETTAGLIO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:PREVENTIVO>&#xa;                &lt;/tns:ORDINI_CRMWS>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpubADSL="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="jpubADSL:ORDINI_CRMWS" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="REGOLATORIO_XDSL_NGA" tibex:xpdlId="1b2ba95c-b861-4bda-b933-ea91cdbeba55">
                <bpws:targets>
                    <bpws:target linkName="LogStartToEmpty_RISOTTOMESSO"/>
                    <bpws:target linkName="CallProcessToREGOLATORIO_XDSL_NGA"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToInvioConsuntivi_REGOLATORIO">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$OpereSpecialiIn/input/tns:OpereSpecialiRequest/tns:StrutturaRichiesta='REGOLATORIO' or  $OpereSpecialiIn/input/tns:OpereSpecialiRequest/tns:StrutturaRichiesta='NPG' or exists($OpereSpecialiIn/input/tns:OpereSpecialiRequest/tns1:SendJPUBRequest/ns4:REGOLATORIO/ns4:PREVENTIVO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$OpereSpecialiIn.input/tns:StrutturaRichiesta='REGOLATORIO' or  $OpereSpecialiIn.input/tns:StrutturaRichiesta='NPG' or exists($OpereSpecialiIn.input/tns1:SendJPUBRequest/ns4:REGOLATORIO/ns4:PREVENTIVO)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper_XDSL-NGA">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;OpereSpecialiIn&quot;/>&lt;xsl:param name=&quot;InvioConsultivoXDSL_NGA&quot;/>&lt;xsl:template name=&quot;LogInvioConsultivoXDSL_NGA-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO[1], true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInvioConsultivoXDSL_NGA-input"
                    name="LogInvioConsultivoXDSL_NGA"
                    tibex:xpdlId="26d3b275-589f-4a52-a4aa-1e617fb57a80"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvioConsultivoXDSL_NGAToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInvioConsultivoXDSL_NGAToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsultivoXDSL_NGA&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInvioConsultivoXDSL_NGA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO[1], true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="f6c2a4c4-8214-45e8-baea-6020a60bda82">
