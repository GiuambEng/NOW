                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f842eb20-e36b-41ff-b773-abc56f84bd80+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OpereSpecialiIn&quot;/>&lt;xsl:template name=&quot;COD_OFFERTA_JPUB-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta)&quot;>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
