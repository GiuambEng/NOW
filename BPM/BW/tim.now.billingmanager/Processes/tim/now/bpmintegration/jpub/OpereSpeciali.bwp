                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/OpereSpeciali/" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:tns2="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InvioConsuntivi"/&gt;&lt;xsl:param name="OpereSpecialiIn"/&gt;&lt;xsl:param name="SelectIDEVENTO_ORDINE_NOW_WHLS"/&gt;&lt;xsl:param name="InvioConsultivoXDSL_NGA"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:template name="InsertUpdateStaging-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsuntivi/ns1:PREVENTIVO)"&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($InvioConsuntivi,true(),true())"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($InvioConsultivoXDSL_NGA,true(),true())"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/ns1:REGOLATORIO/ns1:PREVENTIVO) or exists($OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/ns2:ORDINI_CRMWS)"&gt;&lt;xsl:if test="$SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_RISORSA"&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_RISORSA"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)&gt;0"&gt;&lt;xsl:if test="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa"&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO"&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_RICH&gt;&lt;xsl:value-of select="tib:timestamp()"/&gt;&lt;/tns1:ID_RICH&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;tns1:OPERATORE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/tns1:OPERATORE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsuntivi/ns1:PREVENTIVO)"&gt;&lt;xsl:if test="$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:value-of select="xsd:int($SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;&lt;/tns1:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns3:Staging/tns3:IDDettaglioOrdine)"&gt;&lt;xsl:if test="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns3:Staging/tns3:IDDettaglioOrdine"&gt;&lt;tns1:IDDETTAGLIOORDINE&gt;&lt;xsl:value-of select="$OpereSpecialiIn/input/tns3:OpereSpecialiRequest/tns3:Staging/tns3:IDDettaglioOrdine"/&gt;&lt;/tns1:IDDETTAGLIOORDINE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsuntivi/ns1:PREVENTIVO)"&gt;&lt;xsl:if test="$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW"&gt;&lt;tns1:ID_ORDINE_COMPOSTO&gt;&lt;xsl:value-of select="$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/tns1:ID_ORDINE_COMPOSTO&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW"&gt;&lt;tns1:ID_ORDINE_COMPOSTO&gt;&lt;xsl:value-of select="$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW"/&gt;&lt;/tns1:ID_ORDINE_COMPOSTO&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:FLAG_CONSUNTIVO&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/tns1:FLAG_CONSUNTIVO&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;
                                                                                                                                                                                                                                                                                                                    &lt;!--Creare variabile globale per ID_PROCSO_NOFILE per Processo di Invio consuntivi in fatturazione--&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDEVENTO_ORDINE_NOW_WHLS&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsultivoXDSL_NGA&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertUpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioConsuntivi/ns1:PREVENTIVO)&quot;>&#xa;                        &lt;tns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvioConsuntivi,true(),true())&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvioConsultivoXDSL_NGA,true(),true())&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($OpereSpecialiIn.input/tns2:SendJPUBRequest/ns1:REGOLATORIO/ns1:PREVENTIVO) or exists($OpereSpecialiIn.input/tns2:SendJPUBRequest/ns2:ORDINI_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;                &lt;/tns1:ID_RICH>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioConsuntivi/ns1:PREVENTIVO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                            &lt;tns1:COD_ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/tns1:COD_ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                            &lt;tns1:COD_ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/tns1:COD_ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SelectIDEVENTO_ORDINE_NOW_WHLS/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                &lt;/tns1:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($OpereSpecialiIn.input/tns3:Staging/tns3:IDDettaglioOrdine)&quot;>&#xa;                        &lt;xsl:if test=&quot;$OpereSpecialiIn.input/tns3:Staging/tns3:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns1:IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:value-of select=&quot;$OpereSpecialiIn.input/tns3:Staging/tns3:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns1:IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioConsuntivi/ns1:PREVENTIVO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                            &lt;tns1:ID_ORDINE_COMPOSTO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsuntivi/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/tns1:ID_ORDINE_COMPOSTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                            &lt;tns1:ID_ORDINE_COMPOSTO>&#xa;                                &lt;xsl:value-of select=&quot;$InvioConsultivoXDSL_NGA/ns2:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/tns1:ID_ORDINE_COMPOSTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns1:FLAG_CONSUNTIVO>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;!--Creare variabile globale per ID_PROCSO_NOFILE per Processo di Invio consuntivi in fatturazione-->&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
