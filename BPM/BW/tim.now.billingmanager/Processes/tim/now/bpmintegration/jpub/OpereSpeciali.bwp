            </bpws:empty>
            <bpws:invoke
                inputVariable="UPDATEGestioneFatturazioneOpereSpeciali-input"
                name="UPDATEGestioneFatturazioneOpereSpeciali"
                operation="UPDATEGestioneFatturazione"
                outputVariable="UPDATEGestioneFatturazioneOpereSpeciali"
                partnerLink="UPDATEGestioneFatturazione"
                portType="ns15:UPDATEGestioneFatturazionePortType" tibex:xpdlId="fb19e860-f3eb-436c-9713-c01255cff750">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/xsd/OpereSpeciali/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/UPDATEGestioneFatturazione/" xmlns:tns3="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="OpereSpecialiIn"/&gt;&lt;xsl:param name="InvioConsuntivi"/&gt;&lt;xsl:param name="InvioConsultivoXDSL_NGA"/&gt;&lt;xsl:template name="UPDATEGestioneFatturazioneOpereSpeciali-input" match="/"&gt;&lt;tns2:UPDATEGestioneFatturazioneRequest&gt;&lt;input&gt;&lt;tns3:UPDATEGestioneFatturazioneRequest&gt;&lt;xsl:copy-of select="$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns:SendJPUBRequest"/&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsuntivi/ns:PREVENTIVO)"&gt;&lt;tns3:ContenutoOpereSpecialiREG&gt;&lt;xsl:value-of select="tib:render-xml($InvioConsuntivi,true(), true())"/&gt;&lt;/tns3:ContenutoOpereSpecialiREG&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO)"&gt;&lt;tns3:ContenutoOpereSpecialiXDSL&gt;&lt;xsl:value-of select="tib:render-xml($InvioConsultivoXDSL_NGA,true(), true())"/&gt;&lt;/tns3:ContenutoOpereSpecialiXDSL&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/tns3:UPDATEGestioneFatturazioneRequest&gt;&lt;/input&gt;&lt;/tns2:UPDATEGestioneFatturazioneRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/UPDATEGestioneFatturazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpecialiIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioConsultivoXDSL_NGA&quot;/>&#xa;    &lt;xsl:template name=&quot;UPDATEGestioneFatturazioneOpereSpeciali-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:UPDATEGestioneFatturazioneRequest>&#xa;            &lt;xsl:copy-of select=&quot;$OpereSpecialiIn.input/tns:SendJPUBRequest&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InvioConsuntivi/ns:PREVENTIVO)&quot;>&#xa;                    &lt;tns3:ContenutoOpereSpecialiREG>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($InvioConsuntivi,true(), true())&quot;/>&#xa;                    &lt;/tns3:ContenutoOpereSpecialiREG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($InvioConsultivoXDSL_NGA/ns1:PREVENTIVO)&quot;>&#xa;                    &lt;tns3:ContenutoOpereSpecialiXDSL>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($InvioConsultivoXDSL_NGA,true(), true())&quot;/>&#xa;                    &lt;/tns3:ContenutoOpereSpecialiXDSL>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:UPDATEGestioneFatturazioneRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToSelectIDEVENTO_ORDINE_NOW_ININVIO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="UPDATEGestioneFatturazioneOpereSpecialiToLogOpereSpecialiOut_DAINVIARE">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$OpereSpecialiIn/input/tns:OpereSpecialiRequest/tns1:SendJPUBRequest/tns1:Stato='DA_INVIARE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$OpereSpecialiIn.input/tns1:SendJPUBRequest/tns1:Stato='DA_INVIARE']]></bpws:transitionCondition>
                    </bpws:source>
