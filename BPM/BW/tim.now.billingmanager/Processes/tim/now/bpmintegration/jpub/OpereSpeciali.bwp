            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OpereSpecialiIn&quot;/>&lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&lt;xsl:param name=&quot;SelectCONSUNTIVO&quot;/>&lt;xsl:param name=&quot;Contratto&quot;/>&lt;xsl:template name=&quot;InvioConsuntivi-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns:REGOLATORIO/tns:PREVENTIVO)&quot;>&lt;tns:REGOLATORIO>&lt;xsl:copy-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns2:SendJPUBRequest/tns:REGOLATORIO/tns:PREVENTIVO&quot;/>&lt;/tns:REGOLATORIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:REGOLATORIO>&lt;tns:PREVENTIVO>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:string($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDPreventivo)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_RICHIESTA_NOW>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDRichiestaOLO&quot;/>&lt;/ID_RICHIESTA_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Contratto/Record)>0&quot;>&lt;ID_OLO>&lt;xsl:value-of select=&quot;$Contratto/Record[1]/COD_CONTRATTO&quot;/>&lt;/ID_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_OLO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ID_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:CodiceOrdineOLO)>0&quot;>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:CodiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:IDRisorsa&quot;/>&lt;/ID_RIS>&lt;TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_SERVIZIO>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($OpereSpecialiIn/input/tns1:OpereSpecialiRequest/tns1:DRO)&quot;/>&lt;/DATA_DRO>&lt;DATA_INVIO_PREVENTIVO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_INVIO_PREVENTIVO>&lt;DATA_RICHIESTA_PREVENTIVO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_RICHIESTA_PREVENTIVO>&lt;xsl:for-each select=&quot;$SelectCONSUNTIVO/Record&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&lt;tns:DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&lt;/QUANTITA>&lt;/tns:DETTAGLIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&lt;/QUANTITA>&lt;/tns:DETTAGLIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns:PREVENTIVO>&lt;/tns:REGOLATORIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InvioConsuntivi-input"
                    name="InvioConsuntivi"
                    outputVariable="InvioConsuntivi"
                    tibex:xpdlId="71ff7de4-2c8e-4a84-8f73-d1cec133603a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
