e($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)='LINEANONFONIA'&quot;>&#xa;                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&#xa;                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='23'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;