                                  &lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                                            &lt;/tns1:NOME_ATTR_VALORE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPOLINEA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NOME_ATTR_VALORE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--TIPO_FAMIGLIA-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_FAMIGLIA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo)&quot;/>&#xa;                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)&quot;/>&#xa;                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;string($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDOfferta)&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;tns1:NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIALINEA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NOME_ATTR_VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPO_FAMIGLIA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NOME_ATTR_VALORE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--MOD_VENDITA-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MOD_VENDITA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo), &amp;quot;DEDICATA&amp;quot;)&quot;>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BANDA DEDICATA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BANDA CONDIVISA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPOBANDACONSEGNA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--COPERTURA_ORARIA-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;COPERTURA_ORARIA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/codiceSLAAssurance&quot;/>&#xa;                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--TIPO_INTERF_PC-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_INTERF_PC&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MODEM&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--CODE_PROFILO_ESTESO-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CODE_PROFILO_ESTESO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MODALITACONSEGNA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;tns1:INIDSISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;$IDSistema&quot;/>&#xa;                &lt;/tns1:INIDSISTEMA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                        &lt;tns1:INAMBITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R&amp;quot;&quot;/>&#xa;                        &lt;/tns1:INAMBITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:INAMBITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;X&amp;quot;&quot;/>&#xa;                        &lt;/tns1:INAMBITO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:INCOD_OFFERTA_JPUB>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                &lt;/tns1:INCOD_OFFERTA_JPUB>&#xa;            &lt;/tns1:inputSet>&#xa;        &lt;/tns1:ProcedureXSD>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
