                                                                                                                                                                                                                                                                                                                                                    &lt;!--OPZ_COMM: l'attributo TRASPORTO è presente per le componenti ATMVC, quale prendo? -->&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_MOD_FAT/Record)&quot;>&lt;tns1:MOD_FAT>&lt;xsl:value-of select=&quot;string($JDBCQuery_MOD_FAT/Record[1]/IDTPLG_PAGAMENTO_ACCS)&quot;/>&lt;/tns1:MOD_FAT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:MOD_FAT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:MOD_FAT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2: