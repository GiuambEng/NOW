                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCCallProcedure&quot;/>&lt;xsl:param name=&quot;JDBCQuery_MOD_FAT&quot;/>&lt;xsl:param name=&quot;JDBCQuery_PROFILO_COMMERCIALE&quot;/>&lt;xsl:param name=&quot;JDBCQuery_ID_OFFERTA&quot;/>&lt;xsl:param name=&quot;JDBCQuery_CODICE_SLA_ASSURANCE&quot;/>&lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&lt;xsl:param name=&quot;JDBCQuery_CONTRATTO&quot;/>&lt;xsl:param name=&quot;CodiceComuneIstat&quot;/>&lt;xsl:param name=&quot;ContractNP&quot;/>&lt;xsl:param name=&quot;AREA_DI_CENTRALE&quot;/>&lt;xsl:template name=&quot;MapperJDBCQueryOut-input&quot; match=&quot;/&quot;>&lt;tns1:JDBCQueryResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:NPSYNCREG)>0 or (string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:NPSync)>0 and not(contains($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:NPSync,'_S')))&quot;>&lt;tns1:NP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ContractNP/Record)>0&quot;>&lt;xsl:if test=&quot;$ContractNP/Record[1]/COD_CONTRATTO&quot;>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;$ContractNP/Record[1]/COD_CONTRATTO&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:OPZ_COMM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&lt;tns1:COD_OFFERTA_JPUB>&lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/tns1:COD_OFFERTA_JPUB>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:TIPO_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') or ($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune)>0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;>&lt;tns1:CODE_COMUNE>&lt;xsl:value-of select=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;/>&lt;/tns1:CODE_COMUNE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;>&lt;tns1:CODE_COMUNE>&lt;xsl:value-of select=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;/>&lt;/tns1:CODE_COMUNE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&lt;tns1:CODE_COMUNE>&lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&lt;/tns1:CODE_COMUNE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:NP>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&lt;tns1:REGOLATORIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&lt;tns1:COD_OFFERTA_JPUB>&lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/tns1:COD_OFFERTA_JPUB>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='9'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='ULLLINEAATTIVANP'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;'52'&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;'50'&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;'51'&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='ULLLINEAATTIVANP'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&lt;/tns1:OPZ_COMM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='37'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='ULLDATILINEAATTIVANP'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&lt;tns1:OPZ_COMM>&lt;xsl:value-of select=&quot;'52'&