                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_OFFERTA&#xa;FROM OFFERTA&#xa;WHERE ID_OFFERTA = ? AND MODO_TRASFERIMENTO = ? AND COD_OFFERTA_JPUB IN ('42', '44', '47', '50', '51')" xsi:type="jdbcPalette:JDBCQueryActivity">
