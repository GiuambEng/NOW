PO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_LINEA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                                    &lt;tns1:CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                                    &lt;/tns1:CODE_COMUNE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:XDSL_NGA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:CODE_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODE_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_FAMIGLIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;47&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='ASSENTE'&quot;>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='PRESENTE'&quot;>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;48&amp;quot;&quot;>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;!--OPZ_COMM: l'attributo TRASPORTO è presente per le componenti ATMVC, quale prendo? -->&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_LINEA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_MOD_FAT/Record)&quot;>&#xa;                                &lt;tns1:MOD_FAT>&#xa;                                    &lt;xsl:value-of select=&quot;string($JDBCQuery_MOD_FAT/Record[1]/IDTPLG_PAGAMENTO_ACCS)&quot;/>&#xa;                                &lt;/tns1:MOD_FAT>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:MOD_FAT>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:MOD_FAT>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                                    &lt;tns1:CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                                    &lt;/tns1:CODE_COMUNE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)=&amp;quot;V&amp;quot; and (($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta = &amp;quot;VULAFTTCAB&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta = &amp;quot;EASYIPNGAFTTCAB&amp;quot;))&quot;>&#xa;                                &lt;tns1:TIPO_MODULAZ>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_MODULAZ>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta = &amp;quot;VULAFTTH&amp;quot;)&quot;>&#xa;                                &lt;tns1:TIPO_MODULAZ>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_MODULAZ>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;starts-with($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO='10' or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot; or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;FAST&amp;quot; or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;ALL&amp;quot;&quot;>&#xa;                                        &lt;tns1:TIPO_MODULAZ>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:TIPO_MODULAZ>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot; or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = 'INTERLEAVED'&quot;>&#xa;                                        &lt;tns1:TIPO_MODULAZ>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:TIPO_MODULAZ>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:TIPO_MODULAZ>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:TIPO_MODULAZ>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_MODULAZ>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_MODULAZ>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICOFLAT' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICOHL' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICO' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMGBESIMMETRICO'&quot;>&#xa;                                &lt;tns1:MOD_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:MOD_ACCESSO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_PROFILO_COMMERCIALE/Record) and string-length($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) > 0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) = &amp;quot;FIXED&amp;quot;&quot;>&#xa;                                        &lt;tns1:MOD_ACCESSO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:MOD_ACCESSO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:MOD_ACCESSO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:MOD_ACCESSO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:MOD_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:MOD_ACCESSO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_ID_OFFERTA/Record)&quot;>&#xa;                                &lt;tns1:TIPO_VALID>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_VALID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_VALID>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_VALID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo) > 0 and string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_INTERF_PC>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_INTERF_PC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_INTERF_PC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_INTERF_PC>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0&quot;>&#xa;                                &lt;tns1:PCR_UP>&#xa;                                    &lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                                &lt;/tns1:PCR_UP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:PCR_UP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:PCR_UP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_PROFILO_COMMERCIALE/Record)&quot;>&#xa;                                &lt;tns1:PCR_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                                &lt;/tns1:PCR_DOWN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:PCR_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:PCR_DOWN>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO) > 0 and ($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;8&amp;quot;)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:CODE_PROFILO_ESTESO>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:CODE_PROFILO_ESTESO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODE_PROFILO_ESTESO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODE_PROFILO_ESTESO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;>&#xa;                                    &lt;tns1:CODICE_SLA_ASSURANCE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;/>&#xa;                                    &lt;/tns1:CODICE_SLA_ASSURANCE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODICE_SLA_ASSURANCE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODICE_SLA_ASSURANCE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;>&#xa;                                    &lt;tns1:COPERTURA_ORARIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;/>&#xa;                                    &lt;/tns1:COPERTURA_ORARIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:COPERTURA_ORARIA>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns1:COPERTURA_ORARIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($AREA_DI_CENTRALE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;>&#xa;                                    &lt;tns1:AREA_DI_CENTRALE>&#xa;                                        &lt;xsl:value-of select=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;/>&#xa;                                    &lt;/tns1:AREA_DI_CENTRALE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:XDSL_NGA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:JDBCQueryResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:JPUB_Util="http://www.tim.com/NOW/xsd/JPUB_Util"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="JPUB_Util:JDBCQueryResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
