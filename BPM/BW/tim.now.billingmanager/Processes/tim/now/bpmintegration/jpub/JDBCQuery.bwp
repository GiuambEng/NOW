                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistema&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:template name=&quot;Procedure&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ProcedureXSD>&#xa;            &lt;tns1:inputSet>&#xa;                &lt;!--TIPO_LINEA-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_LINEA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='23'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;BANDASERVIZIO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;BANDASERVIZIO&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='9'&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;BANDASERVIZIO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;BANDASERVIZIO&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)='LINEANONFONIA'&quot;>&#xa;                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&#xa;                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quo