                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedure&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_MOD_FAT&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_PROFILO_COMMERCIALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_OFFERTA&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CODICE_SLA_ASSURANCE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CONTRATTO&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceComuneIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;ContractNP&quot;/>&#xa;    &lt;xsl:param name=&quot;AREA_DI_CENTRALE&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperJDBCQueryOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:JDBCQueryResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:NPSYNCREG)>0 or (string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:NPSync)>0 and not(contains($JDBCQueryIn.input/tns2:BPMRequest/tns2:NPSync,'_S')))&quot;>&#xa;                    &lt;tns1:NP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:COD_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:COD_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($ContractNP/Record)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$ContractNP/Record[1]/COD_CONTRATTO&quot;>&#xa;                                            &lt;tns1:COD_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;$ContractNP/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                            &lt;/tns1:COD_CONTR>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:COD_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:COD_CONTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:OPZ_COMM>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:OPZ_COMM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:TIPO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:TIPO_LINEA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                                    &lt;tns1:CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                                    &lt;/tns1:CODE_COMUNE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                    &lt;tns1:REGOLATORIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:COD_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:COD_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:COD_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/tns1:COD_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='9'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLLINEAATTIVANP'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;'52'&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;'50'&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;'51'&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLLINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='37'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLDATILINEAATTIVANP'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;'52'&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;'50'&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;'51'&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLDATILINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='52'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='SLULINEAATTIVANP'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns1:OPZ_COMM>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                        &lt;/tns1:OPZ_COMM>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='SLULINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='23'&quot;>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_LINEA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record) and ($JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;9&amp;quot; or $JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;52&amp;quot;)&quot;>&#xa;                                &lt;tns1:SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                &lt;/tns1:SUB_TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:SUB_TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/statoRichiestaNOW='ANNULLATO' and $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[1]/codiceISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;>&#xa;                                            &lt;tns1:CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ISTATComune&quot;/>&#xa;                                            &lt;/tns1:CODE_COMUNE>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                                    &lt;tns1:CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                                    &lt;/tns1:CODE_COMUNE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/lavorazione='CESSAZIONE'  and ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLLINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='SLULINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLDATILINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLLINEAATTIVANP' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLDATILINEAATTIVANP' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='SLULINEAATTIVANP')&quot;>&#xa;                                        &lt;tns1:TIPO_FAMIGLIA>&#xa;                                            &lt;xsl:value-of select=&quot;'56'&quot;/>&#xa;                                        &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLLINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='SLULINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLDATILINEAATTIVA' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLLINEAATTIVANP' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='ULLDATILINEAATTIVANP' or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/offerta='SLULINEAATTIVANP'&quot;>&#xa;                                        &lt;tns1:TIPO_FAMIGLIA>&#xa;                                            &lt;xsl:value-of select=&quot;'56'&quot;/>&#xa;    