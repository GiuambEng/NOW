                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+26217583-5dbd-4c8f-8a79-4aa7eb34aeb7+input&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzazioneEventi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;EVENTI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$Start/ns:ORDINI_CRMWS/ns:TESTATA[exists(ns:EVENTI)]&quot;>&#xa;                &lt;Record>&#xa;                    &lt;TMSP_INSERIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TMSP_INSERIMENTO>&#xa;                    &lt;TIPO_CONTRATTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/TIPO_CONTR)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/TIPO_CONTR&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_CONTRATTO>&#xa;                    &lt;CODE_CONTRATTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/CODE_CONTR)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/CODE_CONTR&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODE_CONTRATTO>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/ID_RIS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/ID_RIS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                    &lt;TIPO_FAMIGLIA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/TIPO_FAMIGLIA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/TIPO_FAMIGLIA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_FAMIGLIA>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/TIPO_AZIONE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/TIPO_AZIONE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                    &lt;UTENZA_RIFERIMENTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/UTENZA_RIF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/UTENZA_RIF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/UTENZA_RIFERIMENTO>&#xa;                    &lt;VELOCITA_BANDA_UP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/VEL_BANDA_UP)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/VEL_BANDA_UP&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/VELOCITA_BANDA_UP>&#xa;                    &lt;VELOCITA_BANDA_DOWN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/VEL_BANDA_DOWN)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/VEL_BANDA_DOWN&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/VELOCITA_BANDA_DOWN>&#xa;                    &lt;FLAG_ESITO_PREQUAL>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/FLAG_ESITO_PREQ)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/FLAG_ESITO_PREQ&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/FLAG_ESITO_PREQUAL>&#xa;                    &lt;CODICE_OL>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/CODE_OL)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/CODE_OL&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OL>&#xa;                    &lt;DONOR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/DONOR)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/DONOR&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DONOR>&#xa;                    &lt;TIPO_NUMERO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/TIPO_NUMERO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/TIPO_NUMERO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_NUMERO>&#xa;                    &lt;PORTABILITA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/PORTABILITA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/PORTABILITA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/PORTABILITA>&#xa;                    &lt;RICARICA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ns:EVENTI/RICARICA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;ns:EVENTI/RICARICA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/RICARICA>&#xa;                    &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../../tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=$Start/tns1:IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;../../tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=$Start/tns1:IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
