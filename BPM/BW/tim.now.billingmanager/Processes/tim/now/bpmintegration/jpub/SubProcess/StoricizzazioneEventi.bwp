                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ef5c30f3-7da1-40c8-979f-1404ea836bfd+input&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzazioneEventi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;TESTATA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$Start/ns:ORDINI_CRMWS/ns:TESTATA&quot;>&#xa;                &lt;Record>&#xa;                    &lt;TMSP_INSERIMENTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/TMSP_INSERIMENTO>&#xa;                    &lt;ID_ORDINE_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/ID_ORDINE_CRMWS>&#xa;                    &lt;DATA_DRO>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                    &lt;/DATA_DRO>&#xa;                    &lt;DATA_MSG>&#xa;                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                    &lt;/DATA_MSG>&#xa;                    &lt;DATA_DES>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                    &lt;/DATA_DES>&#xa;                    &lt;CODE_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                    &lt;/CODE_CAUS>&#xa;                    &lt;CODE_ORDINE_ISP>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                    &lt;/CODE_ORDINE_ISP>&#xa;                    &lt;CODE_PROGETTO>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                    &lt;/CODE_PROGETTO>&#xa;                    &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../../tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=$Start/tns1:IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;../../tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=$Start/tns1:IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
