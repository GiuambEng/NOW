                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6472803-eeea-4ca2-b540-767217434d0a+input&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzazioneEventi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ACCESSOFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$Start/ns1:REGOLATORIO/ns1:TESTATA&quot;>&#xa;                &lt;Record>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns1:ACCESSO[1]/TIPO_CONTR)>0&quot;>&#xa;                            &lt;TIPO_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/TIPO_CONTR&quot;/>&#xa;                            &lt;/TIPO_CONTRATTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_CONTRATTO xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns1:ACCESSO[1]/CODE_CONTR)>0&quot;>&#xa;                            &lt;CODICE_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                            &lt;/CODICE_CONTRATTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_CONTRATTO xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ns1:ACCESSO[1]/CODE_CLLI)>0&quot;>&#xa;                            &lt;CODICE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/CODE_CLLI&quot;/>&#xa;                            &lt;/CODICE_CLLI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_CLLI xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;COD_PRESTAZIONI_AGGIUNTIVE>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/CODE_PREST_AGG&quot;/>&#xa;                    &lt;/COD_PRESTAZIONI_AGGIUNTIVE>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                    &lt;/ID_RISORSA>&#xa;                    &lt;ID_RISORSA_PRINCIPALE>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/ID_RIS_PRINC&quot;/>&#xa;                    &lt;/ID_RISORSA_PRINCIPALE>&#xa;                    &lt;CODICE_GESTORE_REC>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/CODE_GEST_REC&quot;/>&#xa;                    &lt;/CODICE_GESTORE_REC>&#xa;                    &lt;TIPO_FAMIGLIA>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/TIPO_FAMIGLIA&quot;/>&#xa;                    &lt;/TIPO_FAMIGLIA>&#xa;                    &lt;OPZIONE_COMMERCIALE>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/OPZ_COMM&quot;/>&#xa;                    &lt;/OPZIONE_COMMERCIALE>&#xa;                    &lt;TIPO_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;ns1:ACCESSO[1]/TIPO_LINEA&quot;/>&#xa;                    &lt;/TIPO_LINEA>&#xa;                    &lt;FLAG_NP>&#xa;                  