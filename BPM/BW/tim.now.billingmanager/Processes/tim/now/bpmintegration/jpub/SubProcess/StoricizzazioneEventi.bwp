                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="EVENTI-input" name="EVENTI"
                        outputVariable="EVENTI"
                        tibex:xpdlId="26217583-5dbd-4c8f-8a79-4aa7eb34aeb7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
