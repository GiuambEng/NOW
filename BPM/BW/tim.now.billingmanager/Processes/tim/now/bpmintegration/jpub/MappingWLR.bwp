             &lt;/FLAG_PERMUTA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='TRASLOCO' and $Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE'&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAORIGINARIO']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_ID_SLUCO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_ID_SLUCO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_ID_SLUCO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_ID_SLUCO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1') or ($Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&#xa;                                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&#xa;                                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' and $Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;TIPO_CESSAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)&quot;/>&#xa;                                            &lt;/TIPO_CESSAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;TIPO_CESSAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)&quot;/>&#xa;                                            &lt;/TIPO_CESSAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;TIPO_LINEA_NUM_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA_NUM_AGG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $Start/tns:BPMRequest/tns:Richiesta/offerta = &amp;quot;WLRLINEANONATTIVA&amp;quot; and $Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='NORMALE') or ($Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W8' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W9' or &amp;#xD;&amp;#xA;starts-with($Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav, 'CAMBIOTIPOLOGIAWLR') or&amp;#xD;&amp;#xA;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav=('INCREMENTOCANALI', 'DECREMENTOCANALI', 'ATTIVAZIONESTSMULTINUMERO', 'CESSAZIONESTSMULTINUMERO')))&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_HOSTING>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_HOSTING>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_HOSTING>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_HOSTING>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='INCREMENTOBORCHIA' or $Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='DECREMENTOBORCHIA') and ($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='Q' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='R' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='S' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='T')&quot;>&#xa;                                    &lt;tns5:STS>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W2')&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;CODE_STS>&#xa;                                            &lt;xsl:value-of select=&quot;$CodeSTS/tns4:CodeSTSOutput[1]/tns4:AttributoOutput&quot;/>&#xa;                                        &lt;/CODE_STS>&#xa;                                    &lt;/tns5:STS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($CodeSTS/tns4:CodeSTSOutput) and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&#xa;                                    &lt;xsl:for-each select=&quot;$CodeSTS/tns4:CodeSTSOutput&quot;>&#xa;                                        &lt;tns5:STS>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W2')&quot;>&#xa;                                                    &lt;TIPO_AZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                    &lt;/TIPO_AZIONE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_AZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/TIPO_AZIONE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;tns4:AttributoOutput&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/tns5:STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns5:ACCESSO>&#xa;                    &lt;/tns5:TESTATA>&#xa;                    &lt;xsl:for-each select=&quot;$Aggiuntivi/tns1:AggiuntiviWLR&quot;>&#xa;                        &lt;tns5:TESTATA>&#xa;                            &lt;xsl:variable name=&quot;TIPO_LINEA_NUM_AGG&quot; select=&quot;tns1:TIPO_LINEA_NUM_AGG&quot;/>&#xa;                            &lt;xsl:variable name=&quot;FLAG_LINEA_NUM_AGG&quot; select=&quot;tns1:FLAG_LINEA_NUM_AGG&quot;/>&#xa;                            &lt;xsl:variable name=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot; select=&quot;tns1:ID_RIS&quot;/>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;concat($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/lastUpdate&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), hours-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns5:ACCESSO>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                                &lt;CODE_CONTR>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                                &lt;/CODE_CONTR>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_CONTR>&#xa;                                                    &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                                &lt;/CODE_CONTR>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and string-length($Start/tns:BPMRequest/tns:Asset/CLLI)>0&quot;>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/CLLI&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo)>0&quot;>&#xa;                                        &lt;CODE_PREST_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_PREST_AGG>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_PREST_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_PREST_AGG>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns1:ID_RIS)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:ID_RIS&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/numeroTelefonico)>0&quot;>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/numeroTelefonico&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/IDRisorsa)>0&quot;>&#xa;                                                        &lt;ID_RIS_PRINC>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/IDRisorsa&quot;/>&#xa;                                                        &lt;/ID_RIS_PRINC>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ID_RIS_PRINC>&#xa;                                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                        &lt;/ID_RIS_PRINC>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns1:ID_RIS_PRINC)>0&quot;>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:ID_RIS_PRINC&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/IDRisorsa)>0&quot;>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                                &lt;CODE_GEST_REC>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                                &lt;/CODE_GEST_REC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_GEST_REC>&#xa;                                                    &lt;xsl:value-of select=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                                &lt;/CODE_GEST_REC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                                                &lt;CODE_GEST_REC>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                                                &lt;/CODE_GEST_REC>&#xa;        