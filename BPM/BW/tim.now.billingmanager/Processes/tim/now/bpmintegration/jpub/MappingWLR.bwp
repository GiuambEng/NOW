_LINEA_DIREZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;upper-case(tns1:CODICE_FATTTURAZIONE_JPUB)='G'&quot;>&#xa;                                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--OP Trascodifica -->&#xa;                                &lt;MOD_VENDITA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;  or (upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot; and $Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav='DECREMENTOULL')&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Asset)&quot;>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($Start/tns:BPMRequest/tns:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:CODE_COMUNE='6666'&quot;>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:CODE_COMUNE)=6&quot;>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:CODE_COMUNE&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(upper-case(nomeComponente),&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                                &lt;CODE_ID_ULLCO>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(upper-case(nomeComponente),&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/CODE_ID_ULLCO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_ID_ULLCO>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/CODE_ID_ULLCO>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/IDULLCo) > 0&quot;>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDULLCo&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($Start/tns:BPMRequest/tns:Richiesta/ordine/distretto)))&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = false() or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;Y&amp;quot; or $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot; or   upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attrib