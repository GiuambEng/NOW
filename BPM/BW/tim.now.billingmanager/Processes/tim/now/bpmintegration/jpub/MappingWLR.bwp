            <bpws:empty name="STS" tibex:xpdlId="4d9f7d8e-f5d3-4d01-8ad6-2c4dccde5086">
                <bpws:targets>
                    <bpws:target linkName="LogContractToEmpty2"/>
                    <bpws:target linkName="LogContrattopadreToSTS"/>
                    <bpws:target linkName="Empty1ToSTS"/>
                </bpws:targets>
                <bpws:sources>
