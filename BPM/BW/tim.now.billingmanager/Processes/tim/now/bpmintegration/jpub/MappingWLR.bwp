           &lt;TIPO_FAMIGLIA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;upper-case(tns1:CODICE_FATTTURAZIONE_JPUB)='T'&quot;>&#xa;                                                &lt;TIPO_FAMIGLIA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_FAMIGLIA>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_FAMIGLIA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_FAMIGLIA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/OPZ_COMM>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns1:CODICE_FATTTURAZIONE_JPUB)>0&quot;>&#