butiDettaglioOrdine&amp;#xD;&amp;#xA;[nomeAttributo='AGGIUNTIVIISDN']/valoreAttributo!='0' and upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='ISDN' )&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&lt;tns1:ID_RIS_AGGIUNTIVA>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns1:ID_RIS_AGGIUNTIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns1:IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&lt;/tns1:IDDETTAGLIOORDINE>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;>&lt;tns1:CODICE_FATTTURAZIONE_JPUB>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;/>&lt;/tns1:CODICE_FATTTURAZIONE_JPUB>&lt;/xsl:if>&lt;/tns1:AggiuntiviWLR>&lt;/xsl:for-each>&lt;/tns1:Aggiuntivi>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Aggiuntivi" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAccumulateAggiuntiviWLR-input"
                    name="LogAccumulateAggiuntiviWLR"
                    tibex:xpdlId="37f3cf04-608a-4893-ab15-88813967bf16"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AccumulateAggiuntiviWLRToLogAccumulateAggiuntiviWLR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogAccumulateAggiuntiviWLRToMapperWLRAggiuntivi"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Aggiuntivi&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccumulateAggiuntiviWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('AccumulateAggiuntiviWLR',tib:render-xml($Aggiuntivi, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="29c281ac-75fd-4ea6-98e6-688f6b01d683">
                <bpws:targets>
                    <bpws:target linkName="LogStartMappingWLRToEmpty_WLRresubmit"/>
                    <bpws:target linkName="Empty2ToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapperWLRPrincipale">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO']) or exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='DTUAGGIUNTIVO']) or exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO']) or exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='DTUAGGIUNTIVO']) or exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'])]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CodiceSTS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;Aggiuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;CodeSTS&quot;/>&#xa;    &lt;xsl:param name=&quot;Contrattopadre&quot;/>&#xa;    &lt;xsl:param name=&quot;Contract&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperWLRAggiuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($Start/tns5:REGOLATORIO)&quot;>&#xa;                &lt;tns5:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$Start/tns5:REGOLATORIO/tns5:TESTATA&quot;/>&#xa;                &lt;/tns5:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns5:REGOLATORIO>&#xa;                    &lt;tns5:TESTATA>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;concat($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/lastUpdate&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), hours-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns5:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and string-length($Start/tns:BPMRequest/tns:Asset/CLLI)>0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo)>0&quot;>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--RICONTROLLARE IL MAPPING ,SPECIFICHE NON CHIARE( ANCHE PER LA  TESTATA DEGLI AGGIUNTIVI-->&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='I' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='O' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='Q'&quot;>&#xa;                                          