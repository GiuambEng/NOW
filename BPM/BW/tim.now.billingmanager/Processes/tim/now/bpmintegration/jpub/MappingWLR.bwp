                      &lt;QUANTITA>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/QUANTITA>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;QUANTITA>&#xa;                                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                    &lt;/QUANTITA>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;QUANTITA>&#xa;                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                            &lt;/QUANTITA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_ID_SLUCO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_ID_SLUCO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_ID_SLUCO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_ID_SLUCO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1') or ($Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&#xa;                                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&#xa;                                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' and $Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;TIPO_CESSAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)&quot;/>&#xa;                                            &lt;/TIPO_CESSAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;TIPO_CESSAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)&quot;/>&#xa;                                            &lt;/TIPO_CESSAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;TIPO_LINEA_NUM_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA_NUM_AGG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $Start/tns:BPMRequest/tns:Richiesta/offerta = &amp;quot;WLRLINEANONATTIVA&amp;quot; and $Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='NORMALE') or ($Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W8' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W9' or  &amp;#xD;&amp;#xA;starts-with($Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav, 'CAMBIOTIPOLOGIAWLR') or&amp;#xD;&amp;#xA;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav=('INCREMENTOCANALI', 'DECREMENTOCANALI', 'ATTIVAZIONESTSMULTINUMERO', 'CESSAZIONESTSMULTINUMERO')))&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_HOSTING>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_HOSTING>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_HOSTING>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_HOSTING>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='INCREMENTOBORCHIA' or $Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='DECREMENTOBORCHIA') and ($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='Q' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='R' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='S' and $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='T')&quot;>&#xa;                                    &lt;tns4:STS>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W2')&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;CODE_STS>&#xa;                                            &lt;xsl:value-of select=&quot;$CodeSTS/tns3:CodeSTSOutput[1]/tns3:AttributoOutput&quot;/>&#xa;                                        &lt;/CODE_STS>&#xa;                                    &lt;/tns4:STS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($CodeSTS/tns3:CodeSTSOutput) and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&#xa;                                    &lt;xsl:for-each select=&quot;$CodeSTS/tns3:CodeSTSOutput&quot;>&#xa;                                        &lt;tns4:STS>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W2')&quot;>&#xa;                                                    &lt;TIPO_AZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                    &lt;/TIPO_AZIONE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_AZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/TIPO_AZIONE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;tns3:AttributoOutput&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/tns4:STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns4:ACCESSO>&#xa;                    &lt;/tns4:TESTATA>&#xa;                &lt;/tns4:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
