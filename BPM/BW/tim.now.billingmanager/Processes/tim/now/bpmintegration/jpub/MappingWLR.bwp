            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogMapperWLRPrincipale-input"
                    name="LogMapperWLRPrincipale"
                    tibex:xpdlId="08a9bce7-35dd-4bd5-b7b3-70921ac2127f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperWLRPrincipaleToLogMapperWLRPrincipale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMapperWLRPrincipaleToLogEndMappingWLR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogMapperWLRPrincipaleToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente=&quot;STS&quot; and azione=&quot;A&quot;]) and $Start/ns7:BPMRequest/ns7:Richiesta/lavorazione=&quot;ATTIVAZIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente="STS" and azione="A"]) and $Start/ns7:BPMRequest/ns7:Richiesta/lavorazione="ATTIVAZIONE"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperWLRPrincipale&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperWLRPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('MapperWLRPrincipale',tib:render-xml($MapperWLRPrincipale/ns:TESTATA[1], true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="JDBCQueryInvoke-input"
                name="JDBCQueryInvoke" operation="JDBCQuery"
                outputVariable="JDBCQueryInvoke" partnerLink="JDBCQuery"
                portType="ns11:JDBCQueryPortType" tibex:xpdlId="921cf8bb-0f16-46e4-bf8c-b7991ff97d1d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/JDBCQuery" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="JDBCQueryInvoke-input" match="/"&gt;
        &lt;tns2:JDBCQueryRequest&gt;
            &lt;input&gt;
                &lt;tns:SendJPUBRequest&gt;
                    &lt;tns:Stato&gt;
                        &lt;xsl:value-of select="$Start/tns:Stato"/&gt;
                    &lt;/tns:Stato&gt;
                    &lt;xsl:copy-of select="$Start/tns:BPMRequest"/&gt;
                    &lt;xsl:copy-of select="$Start/tns:StatoNP"/&gt;
                    &lt;xsl:if test="$Start/tns:NPTimer"&gt;
                        &lt;tns:NPTimer&gt;
                            &lt;xsl:value-of select="$Start/tns:NPTimer"/&gt;
                        &lt;/tns:NPTimer&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns:SendJPUBRequest&gt;
            &lt;/input&gt;
        &lt;/tns2:JDBCQueryRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/JDBCQuery&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SendJPUBRequest>&#xa;            &lt;tns:Stato>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Stato&quot;/>&#xa;            &lt;/tns:Stato>&#xa;            &lt;xsl:copy-of select=&quot;$Start/tns:BPMRequest&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Start/tns:StatoNP&quot;/>&#xa;            &lt;xsl:if test=&quot;$Start/tns:NPTimer&quot;>&#xa;                &lt;tns:NPTimer>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:NPTimer&quot;/>&#xa;                &lt;/tns:NPTimer>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:SendJPUBRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogStartMappingWLRToJDBCQueryInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="JDBCQueryInvokeToCallProcess1_STS">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(($Start/ns7:BPMRequest/ns7:Richiesta/tipologiaSottolav='INCREMENTOBORCHIA' or $Start/ns7:BPMRequest/ns7:Richiesta/tipologiaSottolav='DECREMENTOBORCHIA') and ($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='Q' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='R' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='S' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='T')) or (exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='STS']) and $Start/ns7:BPMRequest/ns7:Richiesta/lavorazione!=&quot;CESSAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(($Start/ns7:BPMRequest/ns7:Richiesta/tipologiaSottolav='INCREMENTOBORCHIA' or $Start/ns7:BPMRequest/ns7:Richiesta/tipologiaSottolav='DECREMENTOBORCHIA') and ($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='Q' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='R' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='S' and $Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo!='T')) or (exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='STS']) and $Start/ns7:BPMRequest/ns7:Richiesta/lavorazione!="CESSAZIONE")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="JDBCQueryInvokeToCOD_Componentenonpresente">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="COD_CAUS-input"
                    name="COD_CAUS" outputVariable="COD_CAUS"
                    tibex:xpdlId="75890cca-bf69-4334-a924-d15be57a6069"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCOD_CAUS"/>
                        <bpws:target linkName="JDBCQueryInvokeToCOD_Componentenonpresente"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="COD_CAUSToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CodeCausaleRequest>&#xa;            &lt;tns2:PID_SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;            &lt;/tns2:PID_SISTEMA>&#xa;            &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;>&#xa;                &lt;tns2:PSCENARIO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;/>&#xa;                &lt;/tns2:PSCENARIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                &lt;tns2:PSOTTOLAVORAZ>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                &lt;/tns2:PSOTTOLAVORAZ>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:ID_Rich_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:ID_Rich_OLO>&#xa;            &lt;tns2:OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/offerta&quot;/>&#xa;            &lt;/tns2:OFFERTA>&#xa;            &lt;tns2:STRUTTURARICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;            &lt;/tns2:STRUTTURARICHIESTA>&#xa;        &lt;/tns2:CodeCausaleRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.CODE_CAUSALE" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Aggiuntivi"
                    name="AccumulateAggiuntiviWLR"
                    outputVariable="Aggiuntivi"
                    tibex:xpdlId="5f2f8866-9d9d-4e7c-97c1-b65e8f0ed27b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAggToAccumulateAggiuntiviWLR"/>
                        <bpws:target linkName="Empty2ToAccumulateAggiuntiviWLR_KO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AccumulateAggiuntiviWLRToLogAccumulateAggiuntiviWLR"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Aggiuntivi&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='INCREMENTOCANALI' or $Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='DECREMENTOCANALI')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='INCREMENTOCANALI'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUAGGIUNTIVO'])&quot;>&lt;tns1:Aggiuntivi>&lt;xsl:for-each select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUAGGIUNTIVO' and azione='A' ]&quot;>&lt;tns1:AggiuntiviWLR>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;>&lt;tns1:ID_RIS>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;/>&lt;/tns1:ID_RIS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&lt;tns1:ID_RIS_PRINC>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&lt;/tns1:ID_RIS_PRINC>&lt;/xsl