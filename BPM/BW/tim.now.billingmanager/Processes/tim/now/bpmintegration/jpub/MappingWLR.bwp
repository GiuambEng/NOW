                              &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($Start/tns:BPMRequest/tns:Richiesta/ordine/distretto)))&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = false() or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;Y&amp;quot; or $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot; or   upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) =&amp;quot;S&amp;quot; or  upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;N&amp;quot; or $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&#xa;                                        &lt;FLAG_PERMUTA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;FLAG_PERMUTA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_MIGRAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;FLAG_QUALIFICAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='TRASLOCO' and $Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE'&quot;>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAORIGINARIO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                        &lt;CAMPO_SERV_IT>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/CAMPO_SERV_IT>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CAMPO_SERV_IT>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CAMPO_SERV_IT>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                    &lt;CODE_ID_SLUCO>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/CODE_ID_SLUCO>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;>&#xa;                                            &lt;CODE_ID_SLUCO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/IDSLUCo&quot;/>&#xa;                                            &lt;/CODE_ID_SLUCO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;($Start/tns:BPMRequest/tns:Richiesta/lavorazione='ATTIVAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1') or ($Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1')&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&#xa;                                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&#xa;                                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;FLAG_MANTENIMENTO_STS>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                                &lt;xsl:if test=&quot;tns1:TIPO_LINEA_NUM_AGG&quot;>&#xa;                                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                                &lt;CODE_HOSTING>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                &lt;/CODE_HOSTING>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_HOSTING>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/CODE_HOSTING>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;TIPO_CLUSTER>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/TIPO_CLUSTER>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($CodeSTS/tns4:CodeSTSOutput) and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&#xa;                                        &lt;xsl:for-each select=&quot;$CodeSTS/tns4:CodeSTSOutput&quot;>&#xa;                                            &lt;tns5:STS>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='VARIAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='W2')&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                    &lt;xsl:value-of select=&quot;$FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                                &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$TIPO_LINEA_NUM_AGG='1' or $TIPO_LINEA_NUM_AGG='2'&quot;>&#xa;                                                        &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;$NUMEROTELEFONICOAGGIUNTIVO&quot;/>&#xa;                                                        &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                        &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;CODE_STS>&#xa;                                                    &lt;xsl:value-of select=&quot;tns4:AttributoOutput&quot;/>&#xa;                                                &lt;/CODE_STS>&#xa;                                            &lt;/tns5:STS>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns5:ACCESSO>&#xa;                        &lt;/tns5:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns5:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
