oasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)='POTS')&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITALINEE']/valoreAttributo)>0&quot;>&#xa;                                                            &lt;QUANTITA>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITALINEE']/valoreAttributo)&quot;/>&#xa;                                                            &lt;/QUANTITA>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='CANALITOTALI']/valoreAttributo)>0&quot;>&#xa;                                                                    &lt;QUANTITA>&#xa;                                                                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='CANALITOTALI']/valoreAttributo)&quot;/>&#xa;                                                                    &lt;/QUANTITA>&#xa;                                                                &lt;/xsl:when>&#xa;                                                    