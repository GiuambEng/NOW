                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CodiceSTS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Aggiuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;CodeSTS&quot;/>&#xa;    &lt;xsl:param name=&quot;Contrattopadre&quot;/>&#xa;    &lt;xsl:param name=&quot;Contract&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperWLRAggiuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($Start/tns5:REGOLATORIO)&quot;>&#xa;                &lt;tns5:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$Start/tns5:REGOLATORIO/tns5:TESTATA&quot;/>&#xa;                &lt;/tns5:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns5:REGOLATORIO>&#xa;                    &lt;tns5:TESTATA>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;concat($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns:BPMRequest/tns:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/lastUpdate&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), hours-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns:BPMRequest/tns:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), month-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), day-from-date($Start/tns:BPMRequest/tns:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($Start/tns:BPMRequest/tns:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns5:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and string-length($Start/tns:BPMRequest/tns:Asset/CLLI)>0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo)>0&quot;>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Asset/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--RICONTROLLARE IL MAPPING ,SPECIFICHE NON CHIARE( ANCHE PER LA  TESTATA DEGLI AGGIUNTIVI-->&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='I' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='O' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='Q'&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='L' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='P' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='R'&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='S'&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='T'&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='A' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='C' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='D'  or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='E'or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='U'&quot;>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='B'or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='F' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='G'  or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='H'or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='I' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='L'&quot;>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='M'or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='N' or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='Q'  or upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)='P'&quot;>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#