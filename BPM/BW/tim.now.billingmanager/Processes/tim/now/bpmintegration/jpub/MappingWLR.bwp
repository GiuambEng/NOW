oordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;1&amp;quot; or   upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;S&amp;quot; or  upper-case($Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo) = &amp;quot;N&amp;quot; or $Start/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;FLAG_MIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_MIGRAZIONE>&#xa;                    &lt;FLAG_QUALIFICAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:BPMRequest/tns:Richiesta/tipologiaSottolav='TRASLOCO' and $Star