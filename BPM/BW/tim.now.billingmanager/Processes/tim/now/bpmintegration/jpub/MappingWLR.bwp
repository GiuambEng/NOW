    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="e5d9e2a7-a002-4353-871d-8cc928b72076">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="CallProcessToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogFaultMappingWLR-input"
                                name="LogFaultMappingWLR"
                                tibex:xpdlId="e42a6e20-2908-4d0c-a398-025c49799aed"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultMappingWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/Msg, $FaultDetails/MsgCode,$FaultDetails/ActivityName,$FaultDetails/ProcessStack,$FaultDetails/StackTrace)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MappingWLR_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;>&#xa;                                &lt;tns2:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns2:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($Start/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;tns2:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;/>&#xa;                                &lt;/tns2:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLR_&amp;quot;, $Start/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS)&quot;/>&#xa;                                &lt;/tns2:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat('Errore su MappingWLR , id_richiesta: ', $Start/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                        &lt;tns2:ErrorReport>&#xa;                            &lt;tns2:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                            &lt;/tns2:StackTrace>&#xa;                            &lt;tns2:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                            &lt;/tns2:Msg>&#xa;                            &lt;tns2:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                            &lt;/tns2:ProcessStack>&#xa;                            &lt;tns2:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                            &lt;/tns2:MsgCode>&#xa;                            &lt;tns2:Data/>&#xa;                        &lt;/tns2:ErrorReport>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="15d2e4ee-d910-4f1a-aa52-287d9cab1e7c">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
