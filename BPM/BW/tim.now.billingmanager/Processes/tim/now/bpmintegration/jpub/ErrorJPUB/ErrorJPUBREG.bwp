                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:import-schema namespace=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; schema-location=&quot;../../../../../../Schemas/JPUB/OrdiniCRMWS_Reg_2.23.xsd&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE)>0&quot;>&#xa;                &lt;tns0:ricezioneElement>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ErrorSchemaIn.Input/tns:ORDINEAGGIUNTIVI[1]/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns:ORDINEAGGIUNTIVI[1]/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                    &lt;tns0:ORDINE>&#xa;                        &lt;REGOLATORIO>&#xa;                            &lt;xsl:for-each select=&quot;$ErrorSchemaIn.Input/tns:ORDINEAGGIUNTIVI[1]/ns:REGOLATORIO/ns:TESTATA&quot;>&#xa;                                &lt;TESTATA>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                    &lt;DATA_MSG>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                    &lt;/DATA_MSG>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                    &lt;xsl:for-each select=&quot;ns:ACCESSO&quot;>&#xa;                                        &lt;ACCESSO>&#xa;                                            &lt;TIPO_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                                            &lt;/TIPO_CONTR>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CLLI&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                            &lt;CODE_PREST_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_PREST_AGG&quot;/>&#xa;                                            &lt;/CODE_PREST_AGG>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_PRINC&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_GEST_REC&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;OPZ_COMM>&#xa;                                                &lt;xsl:value-of select=&quot;OPZ_COMM&quot;/>&#xa;                                            &lt;/OPZ_COMM>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&