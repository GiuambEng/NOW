                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SetExit&quot;/>&lt;xsl:param name=&quot;InvokeWLR&quot;/>&lt;xsl:param name=&quot;CallJPUBRegolatorio&quot;/>&lt;xsl:param name=&quot;InvokeJPUBNP&quot;/>&lt;xsl:param name=&quot;ErrorSchemaIn&quot;/>&lt;xsl:param name=&quot;Invoke&quot;/>&lt;xsl:template name=&quot;MapperLogErrorJPUBReg-input&quot; match=&quot;/&quot;>&lt;tns:ErrorOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot; &quot;>&lt;tns:ErrorO>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ErrorSchemaIn/Input/tns:ErrorInput/tns:COD_PROCSO_NOFILE)>0&quot;>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($InvokeWLR/parameters/tns0:ricezioneResponseElement, true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($CallJPUBRegolatorio/parameters/tns0:ricezioneResponseElement)&quot;>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($CallJPUBRegolatorio/parameters/tns0:ricezioneResponseElement, true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($InvokeJPUBNP/parameters/tns0:ricezioneResponseElement)&quot;>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBNP/parameters/tns0:ricezioneResponseElement, true(), true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($InvokeWLR/parameters/tns0:ricezioneResponseElement, true(),true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Invoke/parameters/tns0:ricezioneResponseElement)&quot;>&lt;tns:CONTENUTO_RESPONSE_STS>&lt;xsl:value-of select=&quot;tib:render-xml($Invoke/parameters/tns0:ricezioneResponseElement, true(), true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE_STS>&lt;/xsl:if>&lt;/tns:ErrorO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ErrorO>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;&amp;quot;Null&amp;quot;&quot;/>&lt;/tns:TRANSACTION_ID>&lt;xsl:if test=&quot;(string-length($ErrorSchemaIn/Input/tns:ErrorInput/tns:COD_PROCSO_NOFILE)=0 or not(exists($ErrorSchemaIn/Input/tns:ErrorInput/tns:COD_PROCSO_NOFILE))) and exists($ErrorSchemaIn/Input/tns:ErrorInput/tns:ORDINEAGGIUNTIVI) and $InvokeWLR/parameters/tns0:ricezioneResponseElement/tns0:result='OK'&quot;>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:RETURN_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;(string-length($ErrorSchemaIn/Input/tns:ErrorInput/tns:COD_PROCSO_NOFILE)=0 or not(exists($ErrorSchemaIn/Input/tns:ErrorInput/tns:COD_PROCSO_NOFILE))) and exists($ErrorSchemaIn/Input/tns:ErrorInput/tns:ORDINEAGGIUNTIVI) and ($InvokeWLR/parameters/tns0:ricezioneResponseElement/tns0:result/@xsi:nil = true() or not(exists($InvokeWLR/parameters/tns0:ricezioneResponseElement))) &quot;>&lt;tns:TIPO_LAVORAZIONE>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:TIPO_LAVORAZIONE>&lt;/xsl:if>&lt;/tns:ErrorO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ErrorOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperLogErrorJPUBReg-input"
                    name="MapperLogErrorJPUBReg"
                    outputVariable="MapperLogErrorJPUBReg"
                    tibex:xpdlId="af0c8b6e-b2cb-46a0-8059-90ae75efd995" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToMapperLogErrorJPUBReg"/>
