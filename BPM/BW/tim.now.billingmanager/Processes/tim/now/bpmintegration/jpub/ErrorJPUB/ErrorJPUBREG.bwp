                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;CallJPUBRegolatorio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_ORDINE_CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns0:ID_ORDINE_CRM>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA&quot;>&#xa;                        &lt;TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tn