                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;!--START COERCIONS--&gt;
&lt;!-- $ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/*, element, ns:REGOLATORIO --&gt;
&lt;!--END COERCIONS--&gt;&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns0="http://crmnow.ordineregolatorio.jpub/types/" xmlns:tns1="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns1="http://www.tibco.com/JPUB_REG_internal_abstract/" version="2.0"&gt;&lt;xsl:param name="ErrorSchemaIn"/&gt;&lt;xsl:template name="InvokeJPUBNP-input" match="/"&gt;&lt;ns1:OrdineRegolatorioCRMNOW_ricezione&gt;&lt;parameters&gt;&lt;tns0:ricezioneElement&gt;&lt;tns0:ID_ORDINE_CRM&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)"&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns0:ID_ORDINE_CRM&gt;&lt;tns0:ORDINE&gt;&lt;REGOLATORIO&gt;&lt;xsl:for-each select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA"&gt;&lt;TESTATA&gt;&lt;ID_ORD_CRMWS&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS"/&gt;&lt;/ID_ORD_CRMWS&gt;&lt;DATA_DRO&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/DATA_DRO"/&gt;&lt;/DATA_DRO&gt;&lt;DATA_MSG&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/DATA_MSG"/&gt;&lt;/DATA_MSG&gt;&lt;DATA_DES&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/DATA_DES"/&gt;&lt;/DATA_DES&gt;&lt;CODE_CAUS&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/CODE_CAUS"/&gt;&lt;/CODE_CAUS&gt;&lt;CODICE_ORDINE_ISP&gt;&lt;xsl:value-of select="$ErrorSchemaIn/Inpu