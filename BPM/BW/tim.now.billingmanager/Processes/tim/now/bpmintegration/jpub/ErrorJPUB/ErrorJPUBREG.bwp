                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBNP.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;CallJPUBRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeWLR.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SetExit&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperLogErrorJPUBReg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ErrorOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot; &quot;>&#xa;                    &lt;tns:ErrorO>&#xa;                        &lt;tns:TRANSACTION_DATE>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TRANSACTION_DATE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE)>0&quot;>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeWLR.parameters, true(),true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($CallJPUBRegolatorio.parameters)&quot;>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($CallJPUBRegolatorio.parameters, true(),true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($InvokeJPUBNP.parameters)&quot;>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBNP.parameters, true(), true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CONTENUTO_RESPONSE>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeWLR.parameters, true(),true())&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;exists($Invoke.parameters)&quot;>&#xa;                            &lt;tns:CONTENUTO_RESPONSE_STS>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($Invoke.parameters, true(), true())&quot;/>&#xa;                            &lt;/tns:CONTENUTO_RESPONSE_STS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ErrorO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ErrorO>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Null&amp;quot;&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;xsl:if test=&quot;(string-length($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE)=0 or not(exists($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE))) and exists($ErrorSchemaIn.Input/tns:ORDINEAGGIUNTIVI) and $InvokeWLR.parameters/tns0:result='OK'&quot;>&#xa;                            &lt;tns:RETURN_CODE>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns:RETURN_CODE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;(string-length($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE)=0 or not(exists($ErrorSchemaIn.Input/tns:COD_PROCSO_NOFILE))) and exists($ErrorSchemaIn.Input/tns:ORDINEAGGIUNTIVI) and ($InvokeWLR.parameters/tns0:result/@xsi:nil = true() or not(exists($InvokeWLR.parameters))) &quot;>&#xa;                            &lt;tns:TIPO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns:TIPO_LAVORAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ErrorO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ErrorOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ErrorSchema="http://www.tim.com/NOW/xsd/ErrorSchema/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ErrorSchema:ErrorOutput" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SetExit&quot;/>&lt;xsl:param name=&quot;MapperLogErrorJPUBReg&quot;/>&lt;xsl:param name=&quot;NumeriAggiuntivi&quot;/>&lt;xsl:param name=&quot;ErrorSchemaIn&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:template name=&quot;LogMapperLogErrorJPUBReg-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ErrorJPUBREG&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ErrorSchemaPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ErrorSchema&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ID_RICH_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ErrorSchemaIn/Input/tns1:ErrorInput/tns1:ID_RICH_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot; and exists($NumeriAggiuntivi)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;LogMapperErrorJPUBReg NP con Aggiuntivi: &amp;quot;, tib:render-xml($MapperLogErrorJPUBReg/tns1:ErrorO,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot;&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;LogMapperErrorJPUBReg e NP senza Aggiuntivi: &amp;quot;, tib:render-xml($MapperLogErrorJPUBReg/tns1:ErrorO,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;LogMapperErrorJPUBReg: $Exit=Null&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMapperLogErrorJPUBReg-input"
                    name="LogMapperLogErrorJPUBReg"
                    tibex:xpdlId="ae9b1a55-eda9-4709-b654-9f2bf7ed7236"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToErrorSchemaOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SetExit&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperLogErrorJPUBReg&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeriAggiuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperLogErrorJPUBReg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorJPUBREG&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorSchemaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorSchema&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$ErrorSchemaIn.Input/tns1:ID_RICH_OLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot; and exists($NumeriAggiuntivi)&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;LogMapperErrorJPUBReg NP con Aggiuntivi: &amp;quot;, tib:render-xml($MapperLogErrorJPUBReg/tns1:ErrorO,true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$SetExit = &amp;quot;True&amp;quot;&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;LogMapperErrorJPUBReg e NP senza Aggiuntivi: &amp;quot;, tib:render-xml($MapperLogErrorJPUBReg/tns1:ErrorO,true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;LogMapperErrorJPUBReg: $Exit=Null&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="STS"
                    name="Assign" outputVariable="STS"
                    tibex:xpdlId="f3d7274b-a014-495f-bbac-1ff7ab824490" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetExitToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToRepeat"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'N'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="STS" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
