DE_ID_SLUCO&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_ID_SLUCO&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                        &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                        &lt;TIPO_CESSAZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                        &lt;/TIPO_CESSAZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                    &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;        