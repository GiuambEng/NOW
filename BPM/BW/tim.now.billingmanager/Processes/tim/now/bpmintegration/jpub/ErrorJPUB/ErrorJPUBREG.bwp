FLAG_4REFERENTE&gt;&lt;xsl:value-of select="FLAG_4REFERENTE"/&gt;&lt;/FLAG_4REFERENTE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="CODE_HOSTING"&gt;&lt;CODE_HOSTING&gt;&lt;xsl:value-of select="CODE_HOSTING"/&gt;&lt;/CODE_HOSTING&gt;&lt;/xsl:if&gt;&lt;xsl:if test="TIPO_CLUSTER"&gt;&lt;TIPO_CLUSTER&gt;&lt;xsl:value-of select="TIPO_CLUSTER"/&gt;&lt;/TIPO_CLUSTER&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="ns:AGG"&gt;&lt;AGG&gt;&lt;AGGIUNTIVO&gt;&lt;xsl:value-of select="AGGIUNTIVO"/&gt;&lt;/AGGIUNTIVO&gt;&lt;/AGG&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="ns:STS"&gt;&lt;STS&gt;&lt;TIPO_AZIONE&gt;&lt;xsl:value-of select="TIPO_AZIONE"/&gt;&lt;/TIPO_AZIONE&gt;&lt;FLAG_LINEA_NUM_AGG&gt;&lt;xsl:value-of select="FLAG_LINEA_NUM_AGG"/&gt;&lt;/FLAG_LINEA_NUM_AGG&gt;&lt;ID_RIS_AGGIUNTIVA&gt;&lt;xsl:value-of select="ID_RIS_AGGIUNTIVA"/&gt;&lt;/ID_RIS_AGGIUNTIVA&gt;&lt;CODE_STS&gt;&lt;xsl:value-of select="CODE_STS"/&gt;&lt;/CODE_STS&gt;&lt;/STS&gt;&lt;/xsl:for-each&gt;&lt;/ACCESSO&gt;&lt;/xsl:for-each&gt;&lt;/TESTATA&gt;&lt;/xsl:for-each&gt;&lt;/REGOLATORIO&gt;&lt;/tns0:ORDINE&gt;&lt;/tns0:ricezioneElement&gt;&lt;/parameters&gt;&lt;/ns1:OrdineRegolatorioCRMNOW_ricezione&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorSchemaIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUBNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_ORDINE_CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns0:ID_ORDINE_CRM>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA&quot;>&#xa;                        &lt;TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorSchemaIn.Input/tns1:ORDINE/ns: