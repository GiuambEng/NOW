                              &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_COMUNE&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                    &lt;CODE_ID_ULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_ID_ULLCO&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DISTR&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                    &lt;FLAG_PERMUTA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                                    &lt;/FLAG_PERMUTA>&#xa;                                    &lt;FLAG_MIGRAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                                    &lt;/FLAG_MIGRAZIONE>&#xa;                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;ID_RIS_OLD&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                    &lt;QUANTITA>&#xa;                                        &lt;xsl:value-of select=&quot;QUANTITA&quot;/>&#xa;                                    &lt;/QUANTITA>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONOR&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONATING&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                    &lt;xsl:if test=&quot;CODE_ID_SLUCO&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_ID_SLUCO&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                        &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                        &lt;TIPO_CESSAZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                        &lt;/TIPO_CESSAZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                    &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                        &lt;TIPO_LINEA_NUM_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                        &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_4REFERENTE&quot;>&#xa;                                        &lt;FLAG_4REFERENTE>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_4REFERENTE&quot;/>&#xa;                                        &lt;/FLAG_4REFERENTE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;CODE_HOSTING&quot;>&#xa;                                        &lt;CODE_HOSTING>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_HOSTING&quot;/>&#xa;                                        &lt;/CODE_HOSTING>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;ns:AGG&quot;>&#xa;                                        &lt;AGG>&#xa;                                            &lt;AGGIUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                            &lt;/AGGIUNTIVO>&#xa;                                        &lt;/AGG>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;ns:STS&quot;>&#xa;                                        &lt;STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ACCESSO>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/REGOLATORIO>&#xa;            &lt;/tns0:ORDINE>&#xa;        &lt;/tns0:ricezioneElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="EmptyToInvoke"/>
