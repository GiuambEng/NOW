                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricizzaEventoOrdnNowWhls/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&lt;tns:StoricizzaEventoOrdnNowWhlsRequest>&lt;DESCR_EVENTO>&lt;xsl:value-of select=&quot;'FATTURAZIONE EMISSIONE'&quot;/>&lt;/DESCR_EVENTO>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns2:Request/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;ID_SISTEMA_DESTNRIO>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/ID_SISTEMA_DESTNRIO>&lt;ID_SISTEMA_MITTENTE>&lt;xsl:value-of select=&quot;15&quot;/>&lt;/ID_SISTEMA_MITTENTE>&lt;/tns:StoricizzaEventoOrdnNowWhlsRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
