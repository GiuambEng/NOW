                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:param name=&quot;SelectID_EVENTO_ORDN_NOW&quot;/>&lt;xsl:template name=&quot;Record&quot; match=&quot;/&quot;>&lt;tns:UPDATEGestioneFatturazioneRecord>&lt;tns:Record>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoWLRAggiuntivi)&quot;>&lt;tns:CONTENUTO_XML>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoWLRAggiuntivi[1]&quot;/>&lt;/tns:CONTENUTO_XML>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoNP)&quot;>&lt;tns:CONTENUTO_XML>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoNP&quot;/>&lt;/tns:CONTENUTO_XML>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoXDSL)&quot;>&lt;tns:CONTENUTO_XML>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoXDSL&quot;/>&lt;/tns:CONTENUTO_XML>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoWLR)&quot;>&lt;tns:CONTENUTO_XML>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoWLR&quot;/>&lt;/tns:CONTENUTO_XML>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTENUTO_XML>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:ContenutoREG&quot;/>&lt;/tns:CONTENUTO_XML>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_AGGTO>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$SelectID_EVENTO_ORDN_NOW/Record[1]/ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$SelectID_EVENTO_ORDN_NOW/Record[1]/ID_RICH_OLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;xsd:int($SelectID_EVENTO_ORDN_NOW/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&lt;/tns:ID_EVENTO_ORDN_NOW_WHLS>&lt;tns:IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;xsd:int($SelectID_EVENTO_ORDN_NOW/Record[1]/IDDETTAGLIOORDINE)&quot;/>&lt;/tns:IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='TSHAULLD' or $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='TBUNDLE' or starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario, 'NPSUVULL') or starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario, 'NPSUWLR') or $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='NPSUAGGVULL' or $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='NPSUAGGWLR' or ($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/lavorazione='ATTIVAZIONE' and $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='VTRASLOCO' and $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaSottolav='TRASLOCO' and starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/offerta,'ULL'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaScenario='TSHAULLD'&quot;>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO,'-',string($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI' and azione='D']/IDDettaglioOrdine))&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:when>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:Request/lavorazione='ATTIVAZIONE' and $StartUPDATEGestioneFatturazioneMigrazione/tns:Request/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO,'-',string($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI' and azione='D']/IDDettaglioOrdine))&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO,'-',string($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/IDDettaglioOrdine))&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO, '-','1')&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists($StartUPDATEGestioneFatturazioneMigrazione/tns:Request) and $StartUPDATEGestioneFatturazioneMigrazione/tns:FlagAssetMigrati=true()) or string-length($StartUPDATEGestioneFatturazioneMigrazione/tns:LavorazioniIndotte)>0&quot;>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO, '-','1')&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($StartUPDATEGestioneFatturazioneMigrazione/tns:Request/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&lt;/tns:ID_ORDINE_COMPOSTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:TIPO_AZIONE&quot;>&lt;tns:TIPO_AZIONE>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:TIPO_AZIONE&quot;/>&lt;/tns:TIPO_AZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:CODE_CAUS&quot;>&lt;tns:CODE_CAUS>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns:CODE_CAUS&quot;/>&lt;/tns:CODE_CAUS>&lt;/xsl:if>&lt;/tns:Record>&lt;/tns:UPDATEGestioneFatturazioneRecord>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Record" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRecordAssign-input"
                    name="LogRecordAssign"
                    tibex:xpdlId="e06a9a51-82a6-46b7-935e-e8f315b430c9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess3ToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Record&quot;/>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:template name=&quot;LogRecordAssign-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;UPDATEGestioneFatturazioneMigrazione&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;UPDATEGestioneFatturazioneMigrazione&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;UPDATEGestioneFatturazioneMigrazione&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns2:Request/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns2:Request/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Record/tns2:Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Record Assign:', tib:render-xml($Record,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Record Assign:Record non trovati'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UPDATEGestioneFatturazione-input"
                    name="UPDATEGestioneFatturazione"
                    outputVariable="UPDATEGestioneFatturazione"
                    tibex:xpdlId="8180d38d-d25a-4576-900d-d846aa006661" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess3ToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToAssign1_AGGIUNTIVI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:StatoNP)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:StatoNP)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UPDATEGestioneFatturazioneToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8180d38d-d25a-4576-900d-d846aa006661+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Record&quot;/>&lt;xsl:template name=&quot;UPDATEGestioneFatturazione-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Record/tns1:Record&quot;>&lt;Record>&lt;CONTENUTO_XML>&lt;xsl:value-of select=&quot;tns1:CONTENUTO_XML&quot;/>&lt;/CONTENUTO_XML>&lt;ID_ORDINE_COMPOSTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:ID_ORDINE_COMPOSTO)&quot;>&lt;xsl:value-of select=&quot;tns1:ID_ORDINE_COMPOSTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE_COMPOSTO>&lt;TIPO_AZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:TIPO_AZIONE)&quot;>&lt;xsl:value-of select=&quot;tns1:TIPO_AZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPO_AZIONE>&lt;CODICE_CAUSALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CODE_CAUS)&quot;>&lt;xsl:value-of select=&quot;tns1:CODE_CAUS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_CAUSALE>&lt;ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&lt;/ID_RISORSA>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;tns1:ID_RICH_OLO&quot;/>&lt;/ID_RICH_OLO>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;tns1:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;  SET CONTENUTO_XML = ?, TIMSTP_AGGTO = SYSDATE, ID_ORDINE_COMPOSTO = ?,&#xa;  TIPO_AZIONE=?,CODICE_CAUSALE=?&#xa;  WHERE ID_RISORSA = ? AND ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_XML"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE_COMPOSTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_AZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_CAUSALE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CicloAggiuntivi"
                    name="CicloAggiuntivi"
                    outputVariable="CicloAggiuntivi"
                    tibex:xpdlId="14d16a32-6f0d-418b-ad25-bc4f7e01fd90" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToAssign1_AGGIUNTIVI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:Request/ordine/dettaglioordine[upper-case(nomeComponente) = &quot;NUMERIAGGIUNTIVI&quot;]) and $StartUPDATEGestioneFatturazioneMigrazione/ns10:FlagAssetMigrati=true() ) then count($StartUPDATEGestioneFatturazioneMigrazione/ns10:Request/ordine/dettaglioordine[upper-case(nomeComponente) = &quot;NUMERIAGGIUNTIVI&quot;]) else if (exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:Request/ordine/dettaglioordine[upper-case(nomeComponente) = &quot;AGGIUNTIVO&quot;]) and $StartUPDATEGestioneFatturazioneMigrazione/ns10:FlagAssetMigrati=true()) then count($StartUPDATEGestioneFatturazioneMigrazione/ns10:Request/ordine/dettaglioordine[upper-case(nomeComponente) = &quot;AGGIUNTIVO&quot;])   else if(exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:Asset/dettaglioasset[upper-case(nomeComponente) = &quot;NUMERIAGGIUNTIVI&quot;]) and $StartUPDATEGestioneFatturazioneMigrazione/ns10:FlagAssetMigrati=false())   then count($StartUPDATEGestioneFatturazioneMigrazione/ns10:Asset/dettaglioasset[upper-case(nomeComponente) = &quot;NUMERIAGGIUNTIVI&quot;])  else if  (exists($StartUPDATEGestioneFatturazioneMigrazione/ns10:Asset/dettaglioasset[upper-case(nomeComponente) = &quot;AGGIUNTIVO&quot;]) and $StartUPDATEGestioneFatturazioneMigrazione/ns10:FlagAssetMigrati=false()) then count($StartUPDATEGestioneFatturazioneMigrazione/ns10:Asset/dettaglioasset[upper-case(nomeComponente) = &quot;AGGIUNTIVO&quot;]) else 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CicloAggiuntivi" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="35472b23-3de5-4f80-8fb6-41121b9fe792">
                <bpws:targets>
                    <bpws:target linkName="Assign1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess4"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$CicloAggiuntivi" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$CicloAggiuntivi]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery1ToCallProcess5" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess5ToAssign2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign2ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="fc2951a9-0aa9-452a-a13c-bdf0033f14ff">
                                <bpws:sources>
