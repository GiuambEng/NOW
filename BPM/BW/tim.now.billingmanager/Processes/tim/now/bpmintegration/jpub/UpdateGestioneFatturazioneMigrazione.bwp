                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b7c64bec-7358-4f51-83e7-1cad8f502150+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecordAggiuntivi&quot;/>&lt;xsl:template name=&quot;UPDATEGestioneFatturazioneAggiuntivi-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$RecordAggiuntivi/tns1:Record&quot;>&lt;Record>&lt;CONTENUTO_XML>&lt;xsl:value-of select=&quot;tns1:CONTENUTO_XML&quot;/>&lt;/CONTENUTO_XML>&lt;ID_ORDINE_COMPOSTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:ID_ORDINE_COMPOSTO)&quot;>&lt;xsl:value-of select=&quot;tns1:ID_ORDINE_COMPOSTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE_COMPOSTO>&lt;ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&lt;/ID_RISORSA>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;tns1:ID_RICH_OLO&quot;/>&lt;/ID_RICH_OLO>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;tns1:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
