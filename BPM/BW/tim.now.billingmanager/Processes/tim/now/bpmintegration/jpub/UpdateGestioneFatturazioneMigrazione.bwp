                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Record&quot;/>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:param name=&quot;RecordAggiuntivi&quot;/>&lt;xsl:param name=&quot;Evento&quot;/>&lt;xsl:template name=&quot;EndUPDATEGestioneFatturazioneMigrazione-input&quot; match=&quot;/&quot;>&lt;tns:UPDATEGestioneFatturazioneResponse>&lt;tns:PRINCIPALE>&lt;xsl:copy-of select=&quot;$Record/tns:Record&quot;/>&lt;/tns:PRINCIPALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns:StatoNP)&quot;>&lt;tns:AGGIUNTIVI>&lt;xsl:copy-of select=&quot;$RecordAggiuntivi/tns:Record&quot;/>&lt;/tns:AGGIUNTIVI>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Evento/IDEventoOrdnNowWhls&quot;>&lt;tns:IDEventoSTS>&lt;xsl:value-of select=&quot;$Evento/IDEventoOrdnNowWhls&quot;/>&lt;/tns:IDEventoSTS>&lt;/xsl:if>&lt;/tns:UPDATEGestioneFatturazioneResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
