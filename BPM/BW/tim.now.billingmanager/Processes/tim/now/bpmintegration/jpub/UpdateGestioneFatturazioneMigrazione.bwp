            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCUpdate-input" name="JDBCUpdate"
                    outputVariable="JDBCUpdate"
                    tibex:xpdlId="94703603-c373-4fac-bad1-117dbe401394" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToLogEndUPDATEGestioneFatturazioneMigrazione"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+94703603-c373-4fac-bad1-117dbe401394+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:param name=&quot;Evento&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcUpdateActivityInput>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/ordine/dettaglioordine[nomeComponente= &amp;quot;STS&amp;quot; and azione='A'][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;NUMERO_TENTATIVI>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/NUMERO_TENTATIVI>&lt;TIMSTP_INSMTO_EVENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO_EVENTO>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Evento/IDEventoOrdnNowWhls)&quot;>&lt;xsl:value-of select=&quot;$Evento/IDEventoOrdnNowWhls&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;DESCRIZIONE>&lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&lt;/DESCRIZIONE>&lt;FLAG_CONSUNTIVO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/FLAG_CONSUNTIVO>&lt;STRUTTURA_OFFERTA>&lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&lt;/STRUTTURA_OFFERTA>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/offerta)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;CONTENUTO_XML>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:ContenutoWLRSTS)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:ContenutoWLRSTS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_XML>&lt;TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0, 0, 0, 0, 0, 20)&quot;/>&lt;/TIMSTP_AGGTO>&lt;ID_ORDINE_COMPOSTO>&lt;xsl:value-of select=&quot;concat($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO,'-','ST')&quot;/>&lt;/ID_ORDINE_COMPOSTO>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/TIPO_AZIONE>&lt;CODICE_CAUSALE>&lt;xsl:value-of select=&quot;'W1'&quot;/>&lt;/CODICE_CAUSALE>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EVENTO_JPUB(IDDETTAGLIOORDINE, ID_RISORSA, ID_RICH_OLO, NUMERO_TENTATIVI, TIMSTP_INSMTO_EVENTO, ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_JPUB, IDTPLG_STATO_EVENTO_JPUB,FLAG_CONSUNTIVO,STRUTTURA_OFFERTA,OFFERTA,CONTENUTO_XML, TIMSTP_AGGTO , ID_ORDINE_COMPOSTO,TIPO_AZIONE&#xa;,CODICE_CAUSALE)&#xa;VALUES(?, ?, ?, ?, ?, ?, (S_ID_RICH_JPUB.NEXTVAL), (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_TENTATIVI"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO_EVENTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIZIONE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_XML"/>
                                    <PreparedParameters
                                    DataType="93"
