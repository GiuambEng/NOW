                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB &#xa;SET CONTENUTO_XML = ?, TIMSTP_AGGTO = SYSDATE, ID_ORDINE_COMPOSTO = ?&#xa;WHERE ID_RISORSA = ? AND ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ?"
