            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectID_EVENTO_ORDN_NOW-input"
                    name="SelectID_EVENTO_ORDN_NOW"
                    outputVariable="SelectID_EVENTO_ORDN_NOW"
                    tibex:xpdlId="c503e47d-076f-42e1-8207-4791b68a2677" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCallProcess2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c503e47d-076f-42e1-8207-4791b68a2677+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartUPDATEGestioneFatturazioneMigrazione&quot;/>&lt;xsl:template name=&quot;SelectID_EVENTO_ORDN_NOW-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario='TSHAULLD'  or $StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario='TBUNDLE' or starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario, 'NPSUVULL') or starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario, 'NPSUWLR') or $StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario='NPSUAGGVULL' or $StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario='NPSUAGGWLR' or ($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/lavorazione='ATTIVAZIONE' and $StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaSottolav='CAMBIOTECNOLOGIA') or ($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaScenario='VTRASLOCO' and $StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/tipologiaSottolav='TRASLOCO' and starts-with($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/offerta,'ULL'))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($StartUPDATEGestioneFatturazioneMigrazione/tns1:Asset/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Asset/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Asset/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/IDRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$StartUPDATEGestioneFatturazioneMigrazione/tns1:Request/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;FLAG_CONSUNTIVO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/FLAG_CONSUNTIVO>&lt;/tns:jdbcQueryActi