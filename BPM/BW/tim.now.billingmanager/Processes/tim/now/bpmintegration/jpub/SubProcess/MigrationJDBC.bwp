                  &lt;tns1:MOD_FAT>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:MOD_FAT>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                            &lt;tns1:CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                            &lt;/tns1:CODE_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)='V'  and (($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;VULAFTTCAB&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;EASYIPNGAFTTCAB&amp;quot;))&quot;>&#xa;                                &lt;tns1:TIPO_MODULAZ>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_MODULAZ>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;) or ($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;VULAFTTH&amp;quot;)&quot;>&#xa;                                &lt;tns1:TIPO_MODULAZ>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_MODULAZ>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;starts-with($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta, &amp;quot;EASY&amp;quot;) or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO='10'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo='1'      or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;FAST&amp;quot; or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;ALL&amp;quot;&quot;>&#xa;                                        &lt;tns1:TIPO_MODULAZ>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:TIPO_MODULAZ>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo= &amp;qu