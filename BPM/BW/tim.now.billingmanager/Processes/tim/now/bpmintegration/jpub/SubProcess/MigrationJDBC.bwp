                    tibex:xpdlId="c71beaee-8087-4287-8bbf-cb86d191e5b2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlloLavorazioneToMapperJDBCQueryOut"/>
