dure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG=&amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG=&amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO='10'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot; or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;FAST&amp;quot; or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;ALL&amp;quot;&quot;>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot; or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;INTERLEAVED&amp;quot;&quot;>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICOFLAT' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICOHL' or$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMATMSIMMETRICO' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/offerta='BITSTREAMGBESIMMETRICO'&quot;>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0 and string-length($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) = &amp;quot;FIXED&amp;quot;&quot;>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_ID_OFFERTA/Record)>0&quot;>&lt;tns1:TIPO_VALID>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:TIPO_VALID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_VALID>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:TIPO_VALID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo) > 0 and string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&lt;tns1:TIPO_INTERF_PC>&lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&lt;/tns1:TIPO_INTERF_PC>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_INTERF_PC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_INTERF_PC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_PROFILO_COMMERCIALE/Record)&quot;>&lt;tns1:PCR_UP>&lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&lt;/tns1:PCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:PCR_UP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:PCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_PROFILO_COMMERCIALE/Record)&quot;>&lt;tns1:PCR_DOWN>&lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&lt;/tns1:PCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:PCR_DOWN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:PCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO) > 0 and ($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;8&amp;quot;)&quot;>&lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&lt;tns1:CODE_PROFILO_ESTESO>&lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&lt;/tns1:CODE_PROFILO_ESTESO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CODE_PROFILO_ESTESO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:CODE_PROFILO_ESTESO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;>&lt;tns1:CODICE_SLA_ASSURANCE>&lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;/>&lt;/tns1:CODICE_SLA_ASSURANCE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CODICE_SLA_ASSURANCE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:CODICE_SLA_ASSURANCE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;>&lt;tns1:COPERTURA_ORARIA>&lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;/>&lt;/tns1:COPERTURA_ORARIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COPERTURA_ORARIA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:COPERTURA_ORARIA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AREA_DI_CENTRALE/Record)>0&quot;>&lt;xsl:if test=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;>&lt;tns1:AREA_DI_CENTRALE>&lt;xsl:value-of select=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;/>&lt;/tns1:AREA_DI_CENTRALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns1:XDSL_NGA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:JDBCQueryResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
