tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/codiceSLAAssurance)>0&quot;>&#xa;                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/codiceSLAAssurance&quot;/>&#xa;                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/codiceSLAAssurance&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--TIPO_INTERF_PC-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_INTERF_PC&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                            &lt;/tns1:VALORE_DA_TRASCODFCRE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MODEM&amp;quot;&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                &lt;/tns1:SEARCH_KEYS>&#xa;                &lt;!--CODE_PROFILO_ESTESO-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CODE_PROFILO_ESTESO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;tns1:VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;$JD