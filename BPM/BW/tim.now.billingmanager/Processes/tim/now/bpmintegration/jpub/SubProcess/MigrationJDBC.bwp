t/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEANONATTIVA'or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta,'SHA')&quot;>&#xa;                                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIALINEA&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:NOME_ATTR_VALORE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_FAMIGLIA&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:NOME_ATTR_VALORE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;tns1:NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIALINEA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NOME_ATTR_VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;