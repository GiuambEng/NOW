                    tibex:xpdlId="669d3205-5fb3-4497-ad5a-89009a64421c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToProcedureAssign"/>
