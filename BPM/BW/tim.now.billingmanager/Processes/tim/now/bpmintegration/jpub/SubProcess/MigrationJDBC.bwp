 select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta, &amp;quot;EASY&amp;quot;) or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO='10'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo='1'      or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;FAST&amp;quot; or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;ALL&amp;quot;&quot;>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo= &amp;quot;0&amp;quot; or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;MODULAZIONE&amp;quot;]/valoreAttributo) = &amp;quot;INTERLEAVED&amp;quot;&quot;>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_MODULAZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_MODULAZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='BITSTREAMATMSIMMETRICOFLAT' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='BITSTREAMATMSIMMETRICOHL' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='BITSTREAMGBESIMMETRICOFLAT' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='BITSTREAMATMSIMMETRICO' or $JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta='BITSTREAMGBESIMMETRICO'&quot;>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:when>&lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0 and string-length($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/MODELLO_ACCS) = &amp;quot;FIXED&amp;quot;&quot;>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:MOD_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:MOD_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_ID_OFFERTA/Record)>0&quot;>&lt;tns1:TIPO_VALID>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:TIPO_VALID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_VALID>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:TIPO_VALID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)>0  and string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&lt;tns1:TIPO_INTERF_PC>&lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&lt;/tns1:TIPO_INTERF_PC>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_INTERF_PC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:TIPO_INTERF_PC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0&quot;>&lt;tns1:PCR_UP>&lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&lt;/tns1:PCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:PCR_UP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:PCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0&quot;>&lt;tns1:PCR_DOWN>&lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&lt;/tns1:PCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:PCR_DOWN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:PCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO) > 0 and ($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;8&amp;quot;)&quot;>&lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&lt;tns1:CODE_PROFILO_ESTESO>&lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&lt;/tns1:CODE_PROFILO_ESTESO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CODE_PROFILO_ESTESO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:CODE_PROFILO_ESTESO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;>&lt;tns1:CODICE_SLA_ASSURANCE>&lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;/>&lt;/tns1:CODICE_SLA_ASSURANCE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CODICE_SLA_ASSURANCE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:CODICE_SLA_ASSURANCE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;>&lt;tns1:COPERTURA_ORARIA>&lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;/>&lt;/tns1:COPERTURA_ORARIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COPERTURA_ORARIA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:COPERTURA_ORARIA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AREA_DI_CENTRALE/Record)>0&quot;>&lt;xsl:if test=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;>&lt;tns1:AREA_DI_CENTRALE>&lt;xsl:value-of select=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;/>&lt;/tns1:AREA_DI_CENTRALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns1:XDSL_NGA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:JDBCQueryResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperJDBCQueryOutCessazione-input"
                    name="MapperJDBCQueryOutCessazione"
                    outputVariable="MapperJDBCQueryOutCessazione"
                    tibex:xpdlId="bfc82331-6aa3-447d-a8d4-7c1a0b3f512b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlloLavorazioneToMapper_Cessazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToLogJDBCQueryOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedure&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_MOD_FAT&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_PROFILO_COMMERCIALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_OFFERTA&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CODICE_SLA_ASSURANCE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CONTRATTO&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceComuneIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;AREA_DI_CENTRALE&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperJDBCQueryOutCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:JDBCQueryResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEANONATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEANONATTIVA' or   (upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVANP' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVANP') or (upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLR' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEANONATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VARIAZIONEWLR' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEANONATTIVA'or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta,'SHA')&quot;>&#xa;                    &lt;tns1:REGOLATORIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:COD_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:COD_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:COD_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/tns1:COD_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='9'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLLINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='37'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='ULLDATILINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='52'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta='SLULINEAATTIVANP'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGDNDONOROLO']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns1:OPZ_COMM>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                                &lt;/tns1:OPZ_COMM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:OPZ_COMM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='23'&quot;>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_LINEA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record) and ($JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;9&amp;quot; or $JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;52&amp;quot;)&quot;>&#xa;                                &lt;tns1:SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;52&amp;quot;&quot;/>&#xa;                                &lt;/tns1:SUB_TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:SUB_TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                            &lt;tns1:CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                            &lt;/tns1:CODE_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVANP' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVANP' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'&quot;>&#xa;                                        &lt;tns1:TIPO_FAMIGLIA>&#xa;                                            &lt;xsl:value-of select=&quot;'56'&quot;/>&#xa;                                        &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:TIPO_FAMIGLIA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='NP'&quot;>&#xa;                    &lt;tns1:NP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:COD_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:COD_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:COD_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/tns1:COD_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record) and ($JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;9&amp;quot; or $JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;37&amp;quot; or $JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;52&amp;quot;)&quot;>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:OPZ_COMM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_LINEA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_LINEA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;>&#xa;                            &lt;tns1:CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat&quot;/>&#xa;                            &lt;/tns1:CODE_COMUNE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:NP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:XDSL_NGA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                                    &lt;tns1:COD_OFFERTA_JPUB>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/tns1:COD_OFFERTA_JPUB>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&#xa;                                    &lt;tns1:CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns1:CODE_CONTR>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODE_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_FAMIGLIA&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_FAMIGLIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB = &amp;quot;47&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[nomeComponente='ATMVC'][1]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo)='ASSENTE'&quot;>&#xa;                                        &lt;tns1:OPZ_COMM>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;qu