                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;CodiceComuneIstat&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/codiceISTATComune) > 0 and $JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns1:Sede>&#xa;                    &lt;tns1:SedeRipetitiva>&#xa;                        &lt;tns1:CodiceComuneIstat>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/codiceISTATComune&quot;/>&#xa;                        &lt;/tns1:CodiceComuneIstat>&#xa;                    &lt;/tns1:SedeRipetitiva>&#xa;                &lt;/tns1:Sede>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[tipologiaSede = &amp;quot;SEDECLIENTECERT&amp;quot; and string-length(codiceISTATComune) > 0])&quot;>&#xa;                &lt;tns1:Sede>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[tipologiaSede = &amp;quot;SEDECLIENTECERT&amp;quot; and string-length(codiceISTATComune) > 0]&quot;>&#xa;                        &lt;tns1:SedeRipetitiva>&#xa;                            &lt;tns1:CodiceComuneIstat>&#xa;                                &lt;xsl:value-of select=&quot;codiceISTATComune&quot;/>&#xa;                            &lt;/tns1:CodiceComuneIstat>&#xa;                        &lt;/tns1:SedeRipetitiva>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:Sede>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[tipologiaSede = &amp;quot;SEDECLIENTE&amp;quot; and string-length(codiceISTATComune) > 0])&quot;>&#xa;                &lt;tns1:Sede>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/ordine/sede[tipologiaSede = &amp;quot;SEDECLIENTE&amp;quot; and string-length(codiceISTATComune) > 0]&quot;>&#xa;                        &lt;tns1:SedeRipetitiva>&#xa;                            &lt;tns1:CodiceComuneIstat>&#xa;                                &lt;xsl:value-of select=&quot;codiceISTATComune&quot;/>&#xa;                            &lt;/tns1:CodiceComuneIstat>&#xa;                        &lt;/tns1:SedeRipetitiva>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:Sede>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Sede>&#xa;                    &lt;tns1:SedeRipetitiva>&#xa;                        &lt;tns1:CodiceComuneIstat>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;6666&amp;quot;&quot;/>&#xa;                        &lt;/tns1:CodiceComuneIstat>&#xa;                    &lt;/tns1:SedeRipetitiva>&#xa;                &lt;/tns1:Sede>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CodiceComuneIstat" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCCallProcedure-input"
                    name="JDBCCallProcedure"
                    outputVariable="JDBCCallProcedure"
                    tibex:xpdlId="563d4491-6f83-4728-83f8-2d61f19a393b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess4ToJDBCCallProcedure"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCCallProcedureToJDBCQuery_NGAoXDSL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(($JDBCQueryIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = &quot;NGA&quot; or &#xd;&#xa;$JDBCQueryIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = &quot;XDSL&quot;) &#xd;&#xa;and (not(exists($JDBCQueryIn/input/tns:SendJPUBRequest/tns:Lavorazione)) or $JDBCQueryIn/input/tns:SendJPUBRequest/tns:Lavorazione!='CESSAZIONE')) or &#xd;&#xa;((upper-case($JDBCQueryIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/offerta)=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','SEMIVULAFTTH','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMATMSIMMETRICOFLAT','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','BITSTREAMGBESIMMETRICOFLAT','BITSTREAMGBESIMMETRICO','BITSTREAMATMSIMMETRICOHL','FIXEDWIRELESSACCESS','FULLGPONPLUS','FULLGPONPLUSNGA','UBBSEMIGPON','FULLGPON1BPNRR','SEMIGPON1BPNRR')) &#xd;&#xa;and  $JDBCQueryIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(($JDBCQueryIn.input/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = "NGA" or 
$JDBCQueryIn.input/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = "XDSL") 
and (not(exists($JDBCQueryIn.input/tns:Lavorazione)) or $JDBCQueryIn.input/tns:Lavorazione!='CESSAZIONE')) or 
((upper-case($JDBCQueryIn.input/tns:BPMRequest/tns:Asset/offerta)=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','SEMIVULAFTTH','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMATMSIMMETRICOFLAT','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','BITSTREAMGBESIMMETRICOFLAT','BITSTREAMGBESIMMETRICO','BITSTREAMATMSIMMETRICOHL','FIXEDWIRELESSACCESS','FULLGPONPLUS','FULLGPONPLUSNGA','UBBSEMIGPON','FULLGPON1BPNRR','SEMIGPON1BPNRR')) 
and  $JDBCQueryIn.input/tns:Lavorazione='CESSAZIONE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCCallProcedureToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+563d4491-6f83-4728-83f8-2d61f19a393b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Procedure&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCCallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;SEARCH_KEYS>&#xa;                    &lt;xsl:for-each select=&quot;$Procedure/tns1:inputSet/tns1:SEARCH_KEYS&quot;>&#xa;                        &lt;APPUSER.TINS_TRASCODFC_ESTERNA>&#xa;                            &lt;TAG>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TAG&quot;/>&#xa;                            &lt;/TAG>&#xa;                            &lt;VALORE_DA_TRASCODFCRE>&#xa;                                &lt;xsl:value-of select=&quot;tns1:VALORE_DA_TRASCODFCRE&quot;/>&#xa;                            &lt;/VALORE_DA_TRASCODFCRE>&#xa;                            &lt;NOME_ATTR_VALORE>&#xa;                                &lt;xsl:value-of select=&quot;tns1:NOME_ATTR_VALORE&quot;/>&#xa;                            &lt;/NOME_ATTR_VALORE>&#xa;                        &lt;/APPUSER.TINS_TRASCODFC_ESTERNA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/SEARCH_KEYS>&#xa;                &lt;INIDSISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;$Procedure/tns1:inputSet/tns1:INIDSISTEMA&quot;/>&#xa;                &lt;/INIDSISTEMA>&#xa;                &lt;INAMBITO>&#xa;                    &lt;xsl:value-of select=&quot;$Procedure/tns1:inputSet/tns1:INAMBITO&quot;/>&#xa;                &lt;/INAMBITO>&#xa;                &lt;INCOD_OFFERTA_JPUB>&#xa;                    &lt;xsl:value-of select=&quot;$Procedure/tns1:inputSet/tns1:INCOD_OFFERTA_JPUB&quot;/>&#xa;                &lt;/INCOD_OFFERTA_JPUB>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns4:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCCallProcedure"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCCallProcedureActivity"/>
                                    <value
                                    procedureOrFunctionName="QUERY_TRASCODFC_ESTERNA"
                                    schema="APPUSER"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:JDBCCallProcedureActivity">
                                    <preparedParamters
                                    DataType="2003"
                                    DataTypeDisplayValue="APPUSER.TINS_TRASCODFC_ESTERNA"
                                    ParameterName="SEARCH_KEYS" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="2"
                                    DataTypeDisplayValue="NUMBER"
                                    ParameterName="INIDSISTEMA" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="INAMBITO" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="INCOD_OFFERTA_JPUB" ProcedureParamterType="1"/>
                                    <preparedParamters
                                    DataType="2003"
                                    DataTypeDisplayValue="APPUSER.TOUTS_TRASCODFC_ESTERNA"
                                    ParameterName="RESULTSET" ProcedureParamterType="4"/>
                                    <objects name="APPUSER.TIN_TRASCODFC_ESTERNA">
                                    <attributes columnName="TAG"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    <attributes
                                    columnName="VALORE_DA_TRASCODFCRE"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    <attributes
                                    columnName="NOME_ATTR_VALORE"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    </objects>
                                    <objects name="APPUSER.TOUT_TRASCODFC_ESTERNA">
                                    <attributes
                                    columnName="VALORE_TRASCODFCTO"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    <attributes columnName="TAG"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    <attributes
                                    columnName="NOME_ATTR_VALORE"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR"/>
                                    </objects>
                                    <arrays
                                    baseName="APPUSER.TIN_TRASCODFC_ESTERNA"
                                    baseType="2002" name="APPUSER.TINS_TRASCODFC_ESTERNA"/>
                                    <arrays
                                    baseName="APPUSER.TOUT_TRASCODFC_ESTERNA"
                                    baseType="2002" name="APPUSER.TOUTS_TRASCODFC_ESTERNA"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IDSistema&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Procedure&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ProcedureXSD>&#xa;            &lt;tns1:inputSet>&#xa;                &lt;!--TIPO_LINEA-->&#xa;                &lt;tns1:SEARCH_KEYS>&#xa;                    &lt;tns1:TAG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPO_LINEA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TAG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEANONATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEANONATTIVA' or  upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='NP' or (upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVANP' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVANP') or (upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLR'  or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEANONATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VARIAZIONEWLR' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEANONATTIVA'or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta,'SHA')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB='23'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;BANDASERVIZIO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                        