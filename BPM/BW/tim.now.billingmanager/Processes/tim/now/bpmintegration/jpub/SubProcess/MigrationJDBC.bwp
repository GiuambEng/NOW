                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceComuneIstat&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCodiceComuneIstatAssign-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrationJDBC&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($CodiceComuneIstat/tns1:SedeRipetitiva)>0&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;CodiceComuneIstatAssign&amp;quot;,&amp;quot;: &amp;quot;,$CodiceComuneIstat/tns1:SedeRipetitiva[1]/tns1:CodiceComuneIstat )&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'CodiceIstatComune non trovato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Procedure&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogProcedureAssign-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrationJDBC&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Procedure/tns1:inputSet)&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ProcedureAssign&amp;quot;,&amp;quot;: &amp;quot;,tib:render-xml($Procedure/tns1:inputSet,true(), true()) )&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ProcedureAssign  : Nessun valore trovato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogProcedureAssign-input"
                    name="LogProcedureAssign"
                    tibex:xpdlId="c8516d07-16b3-4d83-ae79-abe53a333237"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ProcedureAssignToCallProcess4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess4ToJDBCCallProcedure"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Procedure&quot;/>&#xa;    &lt;xsl:template name=&quot;LogProcedureAssign-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrationJDBC&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Procedure/tns1:inputSet)&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ProcedureAssign&amp;quot;,&amp;quot;: &amp;quot;,tib:render-xml($Procedure/tns1:inputSet,true(), true()) )&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ProcedureAssign  : Nessun valore trovato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="ControlloLavorazione" tibex:xpdlId="e89396e3-b6b6-4846-a8b4-785e7ca97787">
                <bpws:targets>
                    <bpws:target linkName="JDBCCallProcedureToEmpty"/>
                    <bpws:target linkName="AREA_DI_CENTRALEToControlloLavorazione"/>
                    <bpws:target linkName="EmptyToControlloLavorazione"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ControlloLavorazioneToMapperJDBCQueryOut">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlloLavorazioneToMapper_Cessazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$JDBCQueryIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$JDBCQueryIn.input/tns:Lavorazione='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCCallProcedure&quot;/>&lt;xsl:param name=&quot;JDBCQuery_MOD_FAT&quot;/>&lt;xsl:param name=&quot;JDBCQuery_PROFILO_COMMERCIALE&quot;/>&lt;xsl:param name=&quot;JDBCQuery_ID_OFFERTA&quot;/>&lt;xsl:param name=&quot;JDBCQuery_CODICE_SLA_ASSURANCE&quot;/>&lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&lt;xsl:param name=&quot;JDBCQuery_COD_OFFERTA_JPUB&quot;/>&lt;xsl:param name=&quot;JDBCQuery_CONTRATTO&quot;/>&lt;xsl:param name=&quot;CodiceComuneIstat&quot;/>&lt;xsl:param name=&quot;AREA_DI_CENTRALE&quot;/>&lt;xsl:template name=&quot;MapperJDBCQueryOutCessazione-input&quot; match=&quot;/&quot;>&lt;tns1:JDBCQueryResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEANONATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEANONATTIVA' or   (upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLDATILINEAATTIVANP' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVANP') or (upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLR' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEANONATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VARIAZIONEWLR' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEANONATTIVA'or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($JDBCQueryIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:Asset/offerta,'SHA')&quot;>&lt;tns1:REGOLATORIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_CONTRATTO/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;$JDBCQuery_CONTRATTO/Record[1]/COD_CONTRATTO&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COD_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns1:COD_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery_COD_OFFERTA_JPUB/Record)&quot;>&lt;xsl:if test=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;>&lt;tns1:COD_OFFERTA_JPUB>&lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/tns1:COD_OFFERTA_JPUB>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery_COD_OFFERTA_JPU