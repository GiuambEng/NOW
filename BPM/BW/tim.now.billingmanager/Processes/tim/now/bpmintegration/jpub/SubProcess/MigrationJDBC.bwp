                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="JDBCQueryOut" operation="JDBCQuery"
                partnerLink="JDBCQueryPortType"
                portType="ns2:JDBCQueryPortType"
                tibex:xpdlId="16b7aa81-f403-46a3-960c-2388c237d179" variable="JDBCQueryOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/JDBCQuery" xmlns:tns1="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="MapperJDBCQueryOut"/&gt;
    &lt;xsl:param name="MapperJDBCQueryOutCessazione"/&gt;
    &lt;xsl:template name="JDBCQueryOut-input" match="/"&gt;
        &lt;tns3:JDBCQueryResponse&gt;
            &lt;output&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($MapperJDBCQueryOut)"&gt;
                        &lt;tns1:JDBCQueryResponse&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MapperJDBCQueryOut/tns1:REGOLATORIO)"&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOut/tns1:REGOLATORIO"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapperJDBCQueryOut/tns1:XDSL_NGA)"&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOut/tns1:XDSL_NGA"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOut/tns1:NP"/&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns1:JDBCQueryResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns1:JDBCQueryResponse&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MapperJDBCQueryOutCessazione/tns1:REGOLATORIO)"&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOutCessazione/tns1:REGOLATORIO"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapperJDBCQueryOutCessazione/tns1:XDSL_NGA)"&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOutCessazione/tns1:XDSL_NGA"/&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:copy-of select="$MapperJDBCQueryOutCessazione/tns1:NP"/&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns1:JDBCQueryResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/output&gt;
        &lt;/tns3:JDBCQueryResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
