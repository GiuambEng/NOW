a;                                &lt;/tns1:TIPO_VALID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_VALID>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_VALID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/dettaglioasset[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;INTERFACCIA&amp;quot;]/valoreAttributo)>0  and string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:TIPO_INTERF_PC>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;TIPO_INTERF_PC&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:TIPO_INTERF_PC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:TIPO_INTERF_PC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:TIPO_INTERF_PC>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0&quot;>&#xa;                                &lt;tns1:PCR_UP>&#xa;                                    &lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                                &lt;/tns1:PCR_UP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:PCR_UP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:PCR_UP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_PROFILO_COMMERCIALE/Record)>0&quot;>&#xa;                                &lt;tns1:PCR_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;string($JDBCQuery_PROFILO_COMMERCIALE/Record[1]/PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                                &lt;/tns1:PCR_DOWN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:PCR_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:PCR_DOWN>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO) > 0 and ($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;7&amp;quot; or $JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO = &amp;quot;8&amp;quot;)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO)&quot;>&#xa;                                    &lt;tns1:CODE_PROFILO_ESTESO>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCCallProcedure/outputSet/RESULTSET/APPUSER.TOUTS_TRASCODFC_ESTERNA[TAG = &amp;quot;CODE_PROFILO_ESTESO&amp;quot;]/VALORE_TRASCODFCTO&quot;/>&#xa;                                    &lt;/tns1:CODE_PROFILO_ESTESO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODE_PROFILO_ESTESO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODE_PROFILO_ESTESO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;>&#xa;                                    &lt;tns1:CODICE_SLA_ASSURANCE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/OFFERTA_SLA&quot;/>&#xa;                                    &lt;/tns1:CODICE_SLA_ASSURANCE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:CODICE_SLA_ASSURANCE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/tns1:CODICE_SLA_ASSURANCE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery_CODICE_SLA_ASSURANCE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;>&#xa;                                    &lt;tns1:COPERTURA_ORARIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery_CODICE_SLA_ASSURANCE/Record[1]/COPERTURA_ORARIA&quot;/>&#xa;                                    &lt;/tns1:COPERTURA_ORARIA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:COPERTURA_ORARIA>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns1:COPERTURA_ORARIA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($AREA_DI_CENTRALE/Record)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;>&#xa;                                    &lt;tns1:AREA_DI_CENTRALE>&#xa;                                        &lt;xsl:value-of select=&quot;$AREA_DI_CENTRALE/Record[1]/CODICE_AREA_CENTRALE&quot;/>&#xa;                                    &lt;/tns1:AREA_DI_CENTRALE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:XDSL_NGA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:JDBCQueryResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
