                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCQuery_COD_OFFERTA_JPUB"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartJDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MigrationJDBC&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Start MigrationJDBC&amp;quot;,&amp;quot;: &amp;quot;, tib:render-xml($JDBCQueryIn.input))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.SubProcess'&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns3:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns3:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns3:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns3:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MigrationJDBC_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;tns3:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MigrationJDBC_&amp;quot;, $JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns3:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MigrationJDBC__&amp;quot;, $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns3:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                &lt;/tns3:Envelope>&#xa;                &lt;tns3:Playload>&#xa;                    &lt;tns3:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($JDBCQueryIn.input)))&quot;/>&#xa;                    &lt;/tns3:Binary>&#xa;                    &lt;tns3:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($JDBCQueryIn.input, true(), true())&quot;/>&#xa;                    &lt;/tns3:XMLString>&#xa;                &lt;/tns3:Playload>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
