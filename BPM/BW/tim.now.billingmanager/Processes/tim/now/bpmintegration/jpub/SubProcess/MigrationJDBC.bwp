'ULLDATILINEAATTIVANP' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='ULLLINEAATTIVANP') or (upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLR'  or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='WLRLINEANONATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VARIAZIONEWLR' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='CESSAZIONEWLRLINEANONATTIVA')or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEANONATTIVA'or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVA' or upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($JDBCQueryIn.input/tns2:BPMRequest/tns2:Asset/offerta,'SHA')&quot;>&#xa;                                &lt;tns1:INAMBITO>&#xa;                                    &lt;xsl:value-of select=&quot;'R'&quot;/>&#xa;                                &lt;/tns1:INAMBITO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:INAMBITO>&#xa;                                    &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                                &lt;/tns1:INAMBITO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $JDBCQueryIn.input/tns2:BPMRequest/tns2:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                        &lt;tns1:INAMBITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R&amp;quot;&quot;/>&#xa;                        &lt;/tns1:INAMBITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:INAMBITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;X&amp;quot;&quot;/>&#xa;                        &lt;/tns1:INAMBITO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:INCOD_OFFERTA_JPUB>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQuery_COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                &lt;/tns1:INCOD_OFFERTA_JPUB>&#xa;            &lt;/tns1:inputSet>&#xa;        &lt;/tns1:ProcedureXSD>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
