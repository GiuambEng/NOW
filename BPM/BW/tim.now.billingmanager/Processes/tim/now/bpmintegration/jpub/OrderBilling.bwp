                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogStartREGToIdentificativi"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiRegolatorio&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Start Processo Order Billing: invio esiti regolatorio: &amp;quot;, tib:render-xml($InvioEsitiRegolatorio.parameters, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEsitoOrdiniNonInVoloREG1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiRegolatorio&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot;&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Codice scarto per ordini non in volo = OK &amp;quot;, $InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO)&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Codice scarto per ordini non in volo = KO &amp;quot;, $InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO)&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogEsitoOrdiniNonInVoloREG1-input"
                                    name="LogEsitoOrdiniNonInVoloREG1"
                                    tibex:xpdlId="b486a484-95fe-4798-912d-4c9e8bea1133"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="NewIdEventoToLogEsitoOrdiniNonInVoloREG1"/>
                                    <bpws:target linkName="EmptyToLogEsitoOrdiniNonInVoloREG1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogEsitoOrdiniNonInVoloREG1ToSelectID_RICH_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogEsitoOrdiniNonInVoloREG1ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($SelectInfoRequestReg/Record)>1 or contains($InvioEsitiRegolatorio/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS,'_R') or contains($InvioEsitiRegolatorio/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS,'_A') or contains($InvioEsitiRegolatorio/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS,'_S') or substring-after($InvioEsitiRegolatorio/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS,'-')='ST'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($SelectInfoRequestReg/Record)>1 or contains($InvioEsitiRegolatorio.parameters/tns:TESTATA/@IDORDCRMWS,'_R') or contains($InvioEsitiRegolatorio.parameters/tns:TESTATA/@IDORDCRMWS,'_A') or contains($InvioEsitiRegolatorio.parameters/tns:TESTATA/@IDORDCRMWS,'_S') or substring-after($InvioEsitiRegolatorio.parameters/tns:TESTATA/@IDORDCRMWS,'-')='ST']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEsitoOrdiniNonInVoloREG1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiRegolatorio&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot;&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Codice scarto per ordini non in volo = OK &amp;quot;, $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO)&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Codice scarto per ordini non in volo = KO &amp;quot;, $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO)&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
