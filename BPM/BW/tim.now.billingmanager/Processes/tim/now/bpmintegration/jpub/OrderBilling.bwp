                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;Stato&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIdEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlTracking&quot;/>&#xa;    &lt;xsl:param name=&quot;DonatingReg&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_EVENTOReg&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Tracciamento_Request>&#xa;            &lt;tns5:TIPO_OP>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE'&quot;/>&#xa;            &lt;/tns5:TIPO_OP>&#xa;            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIdEvento/OUTPUT/tns4:Output/tns4:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;tns5:strutturaRichiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_S')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'_S')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_A')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'_A')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_R')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'_R')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'-')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ControlTracking='True'&quot;>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$DonatingReg/tns6:StatoRequest&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($StatoOrdine)>0&quot;>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$Stato&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;'fgfg'&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;IDRichiestaLocalizzatore>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;/tns5:strutturaRichiesta>&#xa;            &lt;tns5:RiemissioneFatturazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ControlTracking='True'&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectID_EVENTOReg/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery1/Record)>0&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery1/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-')&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                                &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                                &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:FlagRicezione>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:FlagRicezione>&#xa;            &lt;/tns5:RiemissioneFatturazione>&#xa;        &lt;/tns5:Tracciamento_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
