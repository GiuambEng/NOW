                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),TIMSTP_AGGTO=?&#xa;WHERE ID_ORDINE_COMPOSTO = ? AND FLAG_CONSUNTIVO=? AND IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xa;  " xsi:type="jdbcPalette:JDBCUpdateActivity">

