                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DonatingReg-input"
                                    name="DonatingReg"
                                    outputVariable="DonatingReg"
                                    tibex:xpdlId="5ceba9ff-5a4b-428f-8271-b37df432729f"
