                                    <bpws:sources>
                                    <bpws:source linkName="UpdateOrdiniInVoloREGToStatoREg">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdateOrdiniInVoloREGToRisottomissioneReplyREG_RetryperKO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$InvioEsitiRegolatorio/parameters/tns:ESITI/tns:NOTIFICA/@CODESCARTO != &quot;0&quot; and $SelectOrdiniInVoloREG/Record[1]/NUMERO_TENTATIVI &lt; $MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$InvioEsitiRegolatorio.parameters/tns:NOTIFICA/@CODESCARTO != "0" and $SelectOrdiniInVoloREG/Record[1]/NUMERO_TENTATIVI < $MaxRetry]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ed3c4f57-07de-4b73-a32a-1d6c1abc8a28+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateOrdiniInVoloREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_OK&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),TIMSTP_AGGTO=?&#xa;WHERE ID_RICH_OLO = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InsertStagingFatturazioneOK_REG-input"
                                name="InsertStagingFatturazioneOK_REG"
                                operation="InsertUpdateStaging"
                                outputVariable="InsertStagingFatturazioneOK_REG"
                                partnerLink="StagingProcessManager"
                                portType="ns15:InsertUpdateStagingPortType" tibex:xpdlId="92f58ddf-0fe3-4118-abe5-2008b3e9e9ed">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.openaccess.it/wholesale/manager/billingEsiti/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="ID_PROCSO_NO_FILEOrderBilling"/&gt;&lt;xsl:param name="InvioEsitiRegolatorio"/&gt;&lt;xsl:template name="InsertStagingFatturazioneOK_REG-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingIn&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODEDETTSCARTO"&gt;&lt;tns1:COD_DETT_SCARTO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODEDETTSCARTO"/&gt;&lt;/tns1:COD_DETT_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_S')"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-')"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;)"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_R')"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_R&amp;quot;)"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="not(contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'pvm:'))"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="'EVENTJPUB'"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:when&gt;&lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;)"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="substring-before($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;)"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@CODICEORDINEISP"&gt;&lt;tns1:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@CODICEORDINEISP"/&gt;&lt;/tns1:COD_ORDN_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@CODICEPROGETTO"&gt;&lt;tns1:COD_PRGT&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@CODICEPROGETTO"/&gt;&lt;/tns1:COD_PRGT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO"&gt;&lt;tns1:COD_SCARTO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO"/&gt;&lt;/tns1:COD_SCARTO&gt;&lt;/xsl:if&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($InvioEsitiRegolatorio/parameters/tns2:ESITI)"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATADES"&gt;&lt;tns1:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATADES"/&gt;&lt;/tns1:DATA_ESPLETAMENTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATAMSG"&gt;&lt;tns1:DATA_MESSAGGIO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATAMSG"/&gt;&lt;/tns1:DATA_MESSAGGIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATADRO"&gt;&lt;tns1:DATA_RICEZIONE_ORDN&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@DATADRO"/&gt;&lt;/tns1:DATA_RICEZIONE_ORDN&gt;&lt;/xsl:if&gt;&lt;tns1:ID_RICH_JPUB_RISPOSTE&gt;&lt;xsl:value-of select="xsd:integer(tib:timestamp())"/&gt;&lt;/tns1:ID_RICH_JPUB_RISPOSTE&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@IDRISORSA"&gt;&lt;tns1:ID_RISORSA_IN_ERRORE&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@IDRISORSA"/&gt;&lt;/tns1:ID_RISORSA_IN_ERRORE&gt;&lt;/xsl:if&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@NOMEATTRIBINERRORE"&gt;&lt;tns1:NOME_ATTR_IN_ERRORE&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@NOMEATTRIBINERRORE"/&gt;&lt;/tns1:NOME_ATTR_IN_ERRORE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@OLELABOK"&gt;&lt;tns1:OL_ELABORATO_OK&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@OLELABOK"/&gt;&lt;/tns1:OL_ELABORATO_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@TAGINERRORE"&gt;&lt;tns1:TAG_IN_ERRORE&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@TAGINERRORE"/&gt;&lt;/tns1:TAG_IN_ERRORE&gt;&lt;/xsl:if&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;tns1:DESCR&gt;&lt;xsl:value-of select="&amp;quot;Esito ignorato per ordine gia fatturato OK&amp;quot;"/&gt;&lt;/tns1:DESCR&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) and not(contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'-ST'))"&gt;&lt;tns1:IDDETTAGLIOORDINE&gt;&lt;xsl:value-of select="xsd:int(substring-after($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;))"/&gt;&lt;/tns1:IDDETTAGLIOORDINE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;&lt;tns1:ID_ORDINE_COMPOSTO&gt;&lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;&lt;/tns1:ID_ORDINE_COMPOSTO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot;"&gt;&lt;tns1:FLAG_CONSUNTIVO&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/tns1:FLAG_CONSUNTIVO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:FLAG_CONSUNTIVO&gt;&lt;xsl:value-of select="'0'"/&gt;&lt;/tns1:FLAG_CONSUNTIVO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:StagingIn&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="&amp;quot;STAG_JPUB_IN&amp;quot;"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ID_PROCSO_NO_FILEOrderBilling"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NO_FILEOrderBilling&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagingFatturazioneOK_REG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingIn>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODEDETTSCARTO&quot;>&#xa;                    &lt;tns1:COD_DETT_SCARTO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODEDETTSCARTO&quot;/>&#xa;                    &lt;/tns1:COD_DETT_SCARTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_S')&quot;>&#xa;                        &lt;tns1:COD_ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:COD_ID_ORDN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-')&quot;>&#xa;                        &lt;tns1:COD_ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:COD_ID_ORDN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R')&quot;>&#xa;                        &lt;tns1:COD_ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_R&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:COD_ID_ORDN>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;not(contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'pvm:'))&quot;>&#xa;                                &lt;tns1:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;'EVENTJPUB'&quot;/>&#xa;                                &lt;/tns1:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;)&quot;>&#xa;                                &lt;tns1:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;)&quot;/>&#xa;                                &lt;/tns1:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                                    &lt;tns1:COD_ID_ORDN>&#xa;                                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                    &lt;/tns1:COD_ID_ORDN>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@CODICEORDINEISP&quot;>&#xa;                    &lt;tns1:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@CODICEORDINEISP&quot;/>&#xa;                    &lt;/tns1:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@CODICEPROGETTO&quot;>&#xa;                    &lt;tns1:COD_PRGT>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@CODICEPROGETTO&quot;/>&#xa;                    &lt;/tns1:COD_PRGT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO&quot;>&#xa;                    &lt;tns1:COD_SCARTO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO&quot;/>&#xa;                    &lt;/tns1:COD_SCARTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvioEsitiRegolatorio.parameters)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATADES&quot;>&#xa;                    &lt;tns1:DATA_ESPLETAMENTO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATADES&quot;/>&#xa;                    &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATAMSG&quot;>&#xa;                    &lt;tns1:DATA_MESSAGGIO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATAMSG&quot;/>&#xa;                    &lt;/tns1:DATA_MESSAGGIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATADRO&quot;>&#xa;                    &lt;tns1:DATA_RICEZIONE_ORDN>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@DATADRO&quot;/>&#xa;                    &lt;/tns1:DATA_RICEZIONE_ORDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_RICH_JPUB_RISPOSTE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(tib:timestamp())&quot;/>&#xa;                &lt;/tns1:ID_RICH_JPUB_RISPOSTE>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@IDRISORSA&quot;>&#xa;                    &lt;tns1:ID_RISORSA_IN_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@IDRISORSA&quot;/>&#xa;                    &lt;/tns1:ID_RISORSA_IN_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@NOMEATTRIBINERRORE&quot;>&#xa;                    &lt;tns1:NOME_ATTR_IN_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@NOMEATTRIBINERRORE&quot;/>&#xa;                    &lt;/tns1:NOME_ATTR_IN_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@OLELABOK&quot;>&#xa;                    &lt;tns1:OL_ELABORATO_OK>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@OLELABOK&quot;/>&#xa;                    &lt;/tns1:OL_ELABORATO_OK>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@TAGINERRORE&quot;>&#xa;                    &lt;tns1:TAG_IN_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@TAGINERRORE&quot;/>&#xa;                    &lt;/tns1:TAG_IN_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;tns1:DESCR>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Esito ignorato per ordine gia fatturato OK&amp;quot;&quot;/>&#xa;                &lt;/tns1:DESCR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) and not(contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'-ST'))&quot;>&#xa;                        &lt;tns1:IDDETTAGLIOORDINE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(substring-after($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;))&quot;/>&#xa;                        &lt;/tns1:IDDETTAGLIOORDINE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns1:ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns1:ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot;&quot;>&#xa;                        &lt;tns1:FLAG_CONSUNTIVO>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/tns1:FLAG_CONSUNTIVO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:FLAG_CONSUNTIVO>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/tns1:FLAG_CONSUNTIVO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:StagingIn>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_IN&amp;quot;&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_NO_FILEOrderBilling&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
