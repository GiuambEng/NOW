                            <bpws:invoke
                                inputVariable="NewIdEvento-input"
                                name="NewIdEvento"
                                operation="ID_Evento_Ordn_Now"
                                outputVariable="NewIdEvento"
                                partnerLink="SubProcessIDEvento"
                                portType="ns52:ID_Evento_Ordn_NowPortType" tibex:xpdlId="8b2c3175-f649-4f1f-bab4-fcac91f8f139">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ID_Evento_Ordn_Now/" xmlns:tns4="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.openaccess.it/wholesale/manager/billingEsiti/" version="2.0"&gt;
    &lt;xsl:param name="InvioEsitiRegolatorio"/&gt;
    &lt;xsl:param name="SelectOrdiniNonInVoloREG"/&gt;
    &lt;xsl:param name="SelectOrdiniInVoloREG"/&gt;
    &lt;xsl:template name="NewIdEvento-input" match="/"&gt;
        &lt;tns5:ID_Evento_Ordn_NowInput&gt;
            &lt;INPUT&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_R&amp;quot;) or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;) or  not(contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'pvm:'))"&gt;
                        &lt;tns4:Input&gt;
                            &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;xsl:value-of select="xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                            &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                            &lt;tns4:IDRichOLO&gt;
                                &lt;xsl:value-of select="$SelectOrdiniNonInVoloREG/Record[1]/ID_RICH_OLO"/&gt;
                            &lt;/tns4:IDRichOLO&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="1"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="0"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:FlagRiemissione&gt;
                                &lt;xsl:value-of select="true()"/&gt;
                            &lt;/tns4:FlagRiemissione&gt;
                            &lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;
                                &lt;tns4:ID_ORDN_CRMWS&gt;
                                    &lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                                &lt;/tns4:ID_ORDN_CRMWS&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SelectOrdiniNonInVoloREG/Record[1]/ID_RISORSA"&gt;
                                &lt;tns4:IDRisorsa&gt;
                                    &lt;xsl:value-of select="$SelectOrdiniNonInVoloREG/Record[1]/ID_RISORSA"/&gt;
                                &lt;/tns4:IDRisorsa&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:Input&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns4:Input&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                        &lt;xsl:value-of select="xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                        &lt;xsl:value-of select="xsd:int($SelectOrdiniInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:IDRichOLO&gt;
                                &lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                            &lt;/tns4:IDRichOLO&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="1"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="0"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:FlagRiemissione&gt;
                                &lt;xsl:value-of select="true()"/&gt;
                            &lt;/tns4:FlagRiemissione&gt;
                            &lt;xsl:if test="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;
                                &lt;tns4:ID_ORDN_CRMWS&gt;
                                    &lt;xsl:value-of select="$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                                &lt;/tns4:ID_ORDN_CRMWS&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:Input&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/INPUT&gt;
        &lt;/tns5:ID_Evento_Ordn_NowInput&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Evento_Ordn_Now/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloREG&quot;/>&#xa;    &lt;xsl:template name=&quot;NewIdEvento-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_R&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;) or  not(contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'pvm:'))&quot;>&#xa;                &lt;tns4:Input>&#xa;                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                    &lt;tns4:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloREG/Record[1]/ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns4:IDRichOLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:FlagRiemissione>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns4:FlagRiemissione>&#xa;                    &lt;xsl:if test=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                        &lt;tns4:ID_ORDN_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                        &lt;/tns4:ID_ORDN_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelectOrdiniNonInVoloREG/Record[1]/ID_RISORSA&quot;>&#xa;                        &lt;tns4:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloREG/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/tns4:IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:Input>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:Input>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                            &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloREG/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                            &lt;