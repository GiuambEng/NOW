                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIdEvento&quot;/>&#xa;    &lt;xsl:template name=&quot;DonatingReg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DonatingRequest>&#xa;            &lt;xsl:if test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                &lt;tns4:ID_ORDN_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                &lt;/tns4:ID_ORDN_CRMWS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO&quot;>&#xa;                &lt;tns4:CODE_SCARTO>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO&quot;/>&#xa;                &lt;/tns4:CODE_SCARTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelectOrdiniNonInVoloREG/Record[1]/ID_RICH_OLO&quot;>&#xa;                &lt;tns4:IDRichOLO>&#xa;                    &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloREG/Record[1]/ID_RICH_OLO&quot;/>&#xa;                &lt;/tns4:IDRichOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'_R') or contains($InvioEsitiRegolatorio/parameters/tns2:ES