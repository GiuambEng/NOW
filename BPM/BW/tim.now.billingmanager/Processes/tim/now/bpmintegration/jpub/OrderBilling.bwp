                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a610a628-a24b-4e31-8f72-98d7a0fae5b3+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectID_RICH_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_OK'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SelectID_RICH_OLO/Record[substring-after(ID_ORDINE_COMPOSTO,'-')='ST'])&quot;>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;concat($SelectID_RICH_OLO/Record[1]/ID_RICH_OLO ,'-','ST')&quot;/>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SelectID_RICH_OLO/Record[contains(ID_ORDINE_COMPOSTO,'_S')])&quot;>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;concat($SelectID_RICH_OLO/Record[1]/ID_RICH_OLO ,'_S')&quot;/>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SelectID_RICH_OLO/Record[contains(ID_ORDINE_COMPOSTO,'_A')])&quot;>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;concat($SelectID_RICH_OLO/Record[1]/ID_RICH_OLO ,'_A')&quot;/>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;concat($SelectID_RICH_OLO/Record[1]/ID_RICH_OLO ,'_R')&quot;/>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;            &lt;DESCR_STATO>&#xa;                &lt;xsl:value-of select=&quot;'IN_ATTESA_CHIUSURA'&quot;/>&#xa;            &lt;/DESCR_STATO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
