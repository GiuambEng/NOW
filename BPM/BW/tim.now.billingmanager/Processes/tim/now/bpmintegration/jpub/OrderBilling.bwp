                            <bpws:invoke
                                inputVariable="LogAccessiUtentiRegolatorio-input"
                                name="LogAccessiUtentiRegolatorio"
                                operation="NewOperation"
                                outputVariable="LogAccessiUtentiRegolatorio"
                                partnerLink="LogAccessiUtenti"
                                portType="ns26:ServiceSecurity" tibex:xpdlId="e753d744-bc50-4bb4-8919-700cfba60a83">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns5="http://www.example.org/ServicesSecurityData" xmlns:ns1="www.tim.now.HeaderConnection" xmlns:tns6="http://www.example.com/namespaces/tns/1564740682912" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="GetContextREG"/&gt;
    &lt;xsl:param name="log_level"/&gt;
    &lt;xsl:param name="log_name"/&gt;
    &lt;xsl:param name="GetLocalIP"/&gt;
    &lt;xsl:template name="LogAccessiUtentiRegolatorio-input" match="/"&gt;
        &lt;tns4:NewOperationRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:LoggerSecurityInput&gt;
                    &lt;tns5:LogInfo&gt;
                        &lt;tns5:LoggerName&gt;
                            &lt;xsl:value-of select="$log_name"/&gt;
                        &lt;/tns5:LoggerName&gt;
                        &lt;tns5:Application&gt;
                            &lt;xsl:value-of select="&amp;quot;tim.now.billingmanager.application&amp;quot;"/&gt;
                        &lt;/tns5:Application&gt;
                        &lt;tns5:LogLevel&gt;
                            &lt;xsl:value-of select="$log_level"/&gt;
                        &lt;/tns5:LogLevel&gt;
                        &lt;tns5:ServiceName&gt;
                            &lt;xsl:value-of select="&amp;quot;NOW_JPUBFatturazioneOrdini&amp;quot;"/&gt;
                        &lt;/tns5:ServiceName&gt;
                        &lt;tns5:Operation&gt;
                            &lt;xsl:value-of select="&amp;quot;InvioEsitiRegolatorio&amp;quot;"/&gt;
                        &lt;/tns5:Operation&gt;
                        &lt;tns5:JMS&gt;
                            &lt;xsl:value-of select="false()"/&gt;
                        &lt;/tns5:JMS&gt;
                    &lt;/tns5:LogInfo&gt;
                    &lt;tns5:InputDataUserLog&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value) &gt; 0"&gt;
                                &lt;xsl:if test="$GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value"&gt;
                                    &lt;tns5:APPLICAZIONE_CLIENT&gt;
                                        &lt;xsl:value-of select="$GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value"/&gt;
                                    &lt;/tns5:APPLICAZIONE_CLIENT&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:APPLICAZIONE_CLIENT&gt;
                                    &lt;xsl:value-of select="&amp;quot;AggiornamentoConsistenza&amp;quot;"/&gt;
                                &lt;/tns5:APPLICAZIONE_CLIENT&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:COD_FUNZIONE&gt;
                            &lt;xsl:value-of select="&amp;quot;Monitoraggio Staging Interfacce NOW&amp;quot;"/&gt;
                        &lt;/tns5:COD_FUNZIONE&gt;
                        &lt;tns5:COD_PROFILO&gt;
                            &lt;xsl:value-of select="&amp;quot;M2M&amp;quot;"/&gt;
                        &lt;/tns5:COD_PROFILO&gt;
                        &lt;xsl:if test="$GetContextREG/ns1:remoteaddress"&gt;
                            &lt;tns5:HOSTNAME_CLIENT&gt;
                                &lt;xsl:value-of select="$GetContextREG/ns1:remoteaddress"/&gt;
                            &lt;/tns5:HOSTNAME_CLIENT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$GetContextREG/ns1:remoteaddress"&gt;
                            &lt;tns5:IP_CLIENT&gt;
                                &lt;xsl:value-of select="$GetContextREG/ns1:remoteaddress"/&gt;
                            &lt;/tns5:IP_CLIENT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$GetLocalIP/tns6:IPAddress"&gt;
                            &lt;tns5:IP_SERVER&gt;
                                &lt;xsl:value-of select="$GetLocalIP/tns6:IPAddress"/&gt;
                            &lt;/tns5:IP_SERVER&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns5:OS_USER&gt;
                            &lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;
                        &lt;/tns5:OS_USER&gt;
                        &lt;tns5:SERVER_NAME&gt;
                            &lt;xsl:value-of select="bw:getHostName()"/&gt;
                        &lt;/tns5:SERVER_NAME&gt;
                        &lt;tns5:COD_INTRFC&gt;
                            &lt;xsl:value-of select="&amp;quot;ID033&amp;quot;"/&gt;
                        &lt;/tns5:COD_INTRFC&gt;
                        &lt;tns5:SESSION_ID&gt;
                            &lt;xsl:value-of select="concat('ESITO_JPUB',$_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;
                        &lt;/tns5:SESSION_ID&gt;
                        &lt;tns5:TIPO_OPERAZIONE&gt;
                            &lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;
                        &lt;/tns5:TIPO_OPERAZIONE&gt;
                        &lt;tns5:SISTEMA_CHIAMANTE&gt;
                            &lt;xsl:value-of select="&amp;quot;M2M_JPUB&amp;quot;"/&gt;
                        &lt;/tns5:SISTEMA_CHIAMANTE&gt;
                    &lt;/tns5:InputDataUserLog&gt;
                &lt;/tns5:LoggerSecurityInput&gt;
            &lt;/parameters&gt;
        &lt;/tns4:NewOperationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns5=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns1=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContextREG&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccessiUtentiRegolatorio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:LoggerSecurityInput>&#xa;            &lt;tns5:LogInfo>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUBFatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns5:ServiceName>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiRegolatorio&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:JMS>&#xa;            &lt;/tns5:LogInfo>&#xa;            &lt;tns5:InputDataUserLog>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value&quot;>&#xa;                            &lt;tns5:APPLICAZIONE_CLIENT>&#xa;                                &lt;xsl:value-of select=&quot;$GetContextREG/ns1:DinamicHeaders/ns1:Headers[ns1:Name = &amp;quot;SoapAction&amp;quot;]/ns1:Value&quot;/>&#xa;                            &lt;/tns5:APPLICAZIONE_CLIENT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:APPLICAZIONE_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoConsistenza&amp;quot;&quot;/>&#xa;                        &lt;/tns5:APPLICAZIONE_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Monitoraggio Staging Interfacce NOW&amp;quot;&quot;/>&#xa;                &lt;/tns5:COD_FUNZIONE>&#xa;                &lt;tns5:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;M2M&amp;quot;&quot;/>&#xa;                &lt;/tns5:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContextREG/ns1:remoteaddress&quot;>&#xa;                    &lt;tns5:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContextREG/ns1:remoteaddress&quot;/>&#xa;                    &lt;/tns5:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContextREG/ns1:remoteaddress&quot;>&#xa;                    &lt;tns5:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContextREG/ns1:remoteaddress&quot;/>&#xa;                    &lt;/tns5:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns6:IPAddress&quot;>&#xa;                    &lt;tns5:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns6:IPAddress&quot;/>&#xa;                    &lt;/tns5:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns5:OS_USER>&#xa;                &lt;tns5:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns5:SERVER_NAME>&#xa;                &lt;tns5:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ID033&amp;quot;&quot;/>&#xa;                &lt;/tns5:COD_INTRFC>&#xa;                &lt;tns5:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('ESITO_JPUB',$_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns5:SESSION_ID>&#xa;                &lt;tns5:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns5:TIPO_OPERAZIONE>&#xa;                &lt;tns5:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;M2M_JPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:SISTEMA_CHIAMANTE>&#xa;            &lt;/tns5:InputDataUserLog>&#xa;        &lt;/tns5:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GetLocalIPToLogAccessiUtentiRegolatorio"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="LogAccessiUtentiRegolatorioToLogStartREG"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectOrdiniNonInVoloREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiRegolatorio&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectOrdiniNonInVoloREG/Record)&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectOrdiniNonInVoloREG: &amp;quot;, tib:render-xml($SelectOrdiniNonInVoloREG/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SelectOrdiniNonInVoloREG: nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogSelectOrdiniNonInVoloREG-input"
                                    name="LogSelectOrdiniNonInVoloREG"
                                    tibex:xpdlId="7d99df6b-383a-4246-ab0e-b96c2229e016"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectNumero_TentativiToLogSelectNumero_Tentativi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogSelectOrdiniNonInVoloREGToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($SelectOrdiniNonInVoloREG/Record[IDTPLG_STATO_EVENTO_JPUB = 5])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($SelectOrdiniNonInVoloREG/Record[IDTPLG_STATO_EVENTO_JPUB = 5])]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogSelectOrdiniNonInVoloREGToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
