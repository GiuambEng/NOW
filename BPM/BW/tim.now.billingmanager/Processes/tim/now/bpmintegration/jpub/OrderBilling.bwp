                                    outputVariable="UpdateOrdiniInVoloREG"
                                    tibex:xpdlId="ed3c4f57-07de-4b73-a32a-1d6c1abc8a28" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogOK_REGOrdiniInVoloToJDBCUpdate"/>
