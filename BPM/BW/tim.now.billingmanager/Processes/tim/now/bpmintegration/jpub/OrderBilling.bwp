                                    <bpws:source linkName="TracciamentoXDSLToReplyXDSL"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIdEventoXDSL.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlTracking&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_EVENTO&quot;/>&#xa;    &lt;xsl:param name=&quot;Donating&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciamentoXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Tracciamento_Request>&#xa;            &lt;tns5:TIPO_OP>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE'&quot;/>&#xa;            &lt;/tns5:TIPO_OP>&#xa;            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIdEventoXDSL.OUTPUT/tns4:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;tns5:strutturaRichiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS,'-')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ControlTracking='True'&quot;>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$Donating/tns6:StatoRequest&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;'fgfg'&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;IDRichiestaLocalizzatore>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;/tns5:strutturaRichiesta>&#xa;            &lt;tns5:RiemissioneFatturazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ControlTracking='True'&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectID_EVENTO/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-')&quot;>&#xa;                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                                &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                                &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:FlagRicezione>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:FlagRicezione>&#xa;            &lt;/tns5:RiemissioneFatturazione>&#xa;        &lt;/tns5:Tracciamento_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.integration_library"
                                    subProcessName="tim.now.integration_library.tracciamento.Tracciamento_SubPro" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogTracciamentoAssenteXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiXDSL&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Tracciamento non gestito per OL  in Volo &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogTracciamentoAssenteXDSL-input"
                                    name="LogTracciamentoAssenteXDSL"
                                    tibex:xpdlId="302249e5-a3bb-46fa-abfb-95f275c6a6dc"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="TracciamentoXDSLToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogTracciamentoAssenteXDSLToReplyXDSL"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogTracciamentoAssenteXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiXDSL&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Tracciamento non gestito per OL  in Volo &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Ordini_Consuntivi" tibex:xpdlId="959a8568-9274-4703-b170-e1f439c64b02">
                                <bpws:targets>
                                    <bpws:target linkName="LogStatoXDSLToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Ordini_ConsuntiviToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Ordini_ConsuntiviToEmpty4">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$InvioEsitiXDSL/parameters/tns:ESITI/tns:NOTIFICA/@CATEGORIA='PREV' or not(contains($InvioEsitiXDSL/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS, &quot;pvm:&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$InvioEsitiXDSL.parameters/tns:NOTIFICA/@CATEGORIA='PREV' or not(contains($InvioEsitiXDSL.parameters/tns:TESTATA/@IDORDCRMWS, "pvm:"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
