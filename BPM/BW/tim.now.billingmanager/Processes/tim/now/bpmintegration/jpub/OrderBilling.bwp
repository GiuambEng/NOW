                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIdEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;Stato&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlTracking&quot;/>&#xa;    &lt;xsl:param name=&quot;DonatingReg&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_EVENTOReg&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Tracciamento_Request>&#xa;            &lt;tns5:TIPO_OP>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE'&quot;/>&#xa;            &lt;/tns5:TIPO_OP>&#xa;            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIdEvento.OUTPUT/tns4:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;tns5:strutturaRichiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_S')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'_S')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_A')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'_A')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'_R')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-')&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'-')&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of