                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="GetContextREG"
                                    outputVariable="GetContextREG"
                                    tibex:xpdlId="7499aa83-5eaf-41ba-b681-d1f7c2c6d8dd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToGetContext"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GetContextREGToGetLocalIP"/>
                                    </bpws:sources>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.getContext"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
