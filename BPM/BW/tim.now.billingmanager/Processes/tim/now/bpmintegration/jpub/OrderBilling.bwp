                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4dd581ee-3388-496d-af01-6b429f9260e9+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloREG&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloREG&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateEsitoReg-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-') or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;) or $InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot;&quot;>&#xa;                &lt;tns4:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$SelectOrdiniNonInVoloREG/Record[IDTPLG_STATO_EVENTO_JPUB!=5]&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                                &lt;xsl:value-of select=&quot;'FATTURAZIONE_OK'&quot;/>&#xa;                            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                            &lt;TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/TIMSTP_AGGTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot; or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;>&#xa;                                    &lt;ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORDINE_COMPOSTO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA=&amp;quot