                                    sqlStatement="SELECT NUMERO_TENTATIVI, IDTPLG_STATO_EVENTO_JPUB, ID_RICH_OLO, ID_EVENTO_ORDN_NOW_WHLS&#xa;FROM EVENTO_JPUB&#xa;WHERE ID_RICH_OLO = ? AND FLAG_CONSUNTIVO=? AND IDTPLG_STATO_EVENTO_JPUB IN (3,1)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

