                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.ID_RICH_OLO, T.DESCR_STATO_EVENTO_JPUB, E.ID_ORDINE_COMPOSTO&#xd;&#xa;FROM EVENTO_JPUB E, TIPOLG_STATO_EVENTO_JPUB T &#xd;&#xa;WHERE E.ID_RICH_OLO = ? AND E.IDTPLG_STATO_EVENTO_JPUB = T.IDTPLG_STATO_EVENTO_JPUB ORDER BY ID_EVENTO_ORDN_NOW_WHLS" xsi:type="jdbcPalette:JDBCQueryActivity">

