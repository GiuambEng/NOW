                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($InvioEsitiRegolatorio.parameters/tns:NOTIFICA/@CODESCARTO = "0" and count($SelectID_RICH_OLO/Record) > 1 and count($SelectID_RICH_OLO/Record) > 20) and $InvioEsitiRegolatorio.parameters/tns:NOTIFICA/@CATEGORIA!="PREV"]]></bpws:transitionCondition>
