                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+42493168-409c-45f4-89bb-8eb9bab19291+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateOrdiniNonInVoloREG2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IN_ATTESA_CHIUSURA&amp;quot;&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
