                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a0327752-ba8a-4ebd-9410-f7b803ca7ce5+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateEsito-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                &lt;tns4:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$SelectOrdiniNonInVoloXDSL/Record[IDTPLG_STATO_EVENTO_JPUB !=5]&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                                &lt;xsl:value-of select=&quot;'FATTURAZIONE_OK'&quot;/>&#xa;                            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                            &lt;TIMSTP_AGGTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/TIMSTP_AGGTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                    &lt;ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORDINE_COMPOSTO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                    &lt;ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORDINE_COMPOSTO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_CONSUNTIVO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_CONSUNTIVO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                            &lt;ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&#xa;                            &lt;/ID_RICH_OLO>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns4:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$SelectOrdiniInVoloXDSL/Record[IDT