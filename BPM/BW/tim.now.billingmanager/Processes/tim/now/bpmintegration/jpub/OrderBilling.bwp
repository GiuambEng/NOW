                                portType="ns52:ID_Evento_Ordn_NowPortType" tibex:xpdlId="00adad0a-9249-4fb7-bc54-f7d31228c52e">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ID_Evento_Ordn_Now/" xmlns:tns4="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/" xmlns:tns2="http://www.openaccess.it/wholesale/manager/billingEsiti/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="InvioEsitiXDSL"/&gt;
    &lt;xsl:param name="SelectOrdiniNonInVoloXDSL"/&gt;
    &lt;xsl:param name="SelectOrdiniInVoloXDSL"/&gt;
    &lt;xsl:template name="NewIdEventoXDSL-input" match="/"&gt;
        &lt;tns5:ID_Evento_Ordn_NowInput&gt;
            &lt;INPUT&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="contains($InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) or not(contains($InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'pvm:'))"&gt;
                        &lt;tns4:Input&gt;
                            &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;xsl:value-of select="xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                            &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                            &lt;tns4:IDRichOLO&gt;
                                &lt;xsl:value-of select="$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RICH_OLO"/&gt;
                            &lt;/tns4:IDRichOLO&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="1"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="0"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:FlagRiemissione&gt;
                                &lt;xsl:value-of select="true()"/&gt;
                            &lt;/tns4:FlagRiemissione&gt;
                            &lt;xsl:if test="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;
                                &lt;tns4:ID_ORDN_CRMWS&gt;
                                    &lt;xsl:value-of select="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                                &lt;/tns4:ID_ORDN_CRMWS&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RISORSA"&gt;
                                &lt;tns4:IDRisorsa&gt;
                                    &lt;xsl:value-of select="$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RISORSA"/&gt;
                                &lt;/tns4:IDRisorsa&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:Input&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns4:Input&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                        &lt;xsl:value-of select="xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                        &lt;xsl:value-of select="xsd:int($SelectOrdiniInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:IDRichOLO&gt;
                                &lt;xsl:value-of select="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                            &lt;/tns4:IDRichOLO&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'"&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="1"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:FlagConsuntivo&gt;
                                        &lt;xsl:value-of select="0"/&gt;
                                    &lt;/tns4:FlagConsuntivo&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns4:FlagRiemissione&gt;
                                &lt;xsl:value-of select="true()"/&gt;
                            &lt;/tns4:FlagRiemissione&gt;
                            &lt;xsl:if test="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"&gt;
                                &lt;tns4:ID_ORDN_CRMWS&gt;
                                    &lt;xsl:value-of select="$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS"/&gt;
                                &lt;/tns4:ID_ORDN_CRMWS&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:Input&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/INPUT&gt;
        &lt;/tns5:ID_Evento_Ordn_NowInput&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Evento_Ordn_Now/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniInVoloXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;NewIdEventoXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;-&amp;quot;) or not(contains($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS,'pvm:'))&quot;>&#xa;                &lt;tns4:Input>&#xa;                    &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                    &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                    &lt;tns4:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns4:IDRichOLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:FlagRiemissione>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns4:FlagRiemissione>&#xa;                    &lt;xsl:if test=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                        &lt;tns4:ID_ORDN_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                        &lt;/tns4:ID_ORDN_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RISORSA&quot;>&#xa;                        &lt;tns4:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/tns4:IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:Input>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:Input>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                            &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniNonInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                            &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectOrdiniInVoloXDSL/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                            &lt;/tns4:ID_EVENTO_NOW_ORDN_WHLS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns4:IDRichOLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InvioEsitiXDSL.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:FlagConsuntivo>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/tns4:FlagConsuntivo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:FlagRiemissione>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns4:FlagRiemissione>&#xa;                    &lt;xsl:if test=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                        &lt;tns4:ID_ORDN_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                        &lt;/tns4:ID_ORDN_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:Input>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="LogInsertStagingXDSLToNewIdEventoXDSL"/>
                                    <bpws:target linkName="CallProcessToNewIdEventoXDSL"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="NewIdEventoXDSLToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="NewIdEventoXDSLToLogEsitoOrdiniNonInVoloXDSL1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($InvioEsitiXDSL/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS, &quot;-&quot;) or not(contains($InvioEsitiXDSL/parameters/tns:ESITI/tns:TESTATA/@IDORDCRMWS, &quot;pvm:&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($InvioEsitiXDSL.parameters/tns:TESTATA/@IDORDCRMWS, "-") or not(contains($InvioEsitiXDSL.parameters/tns:TESTATA/@IDORDCRMWS, "pvm:"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c5cb9f0e-a91a-4c12-a972-3133083e8ed6+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;substring-before($InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'-')&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectInfoRequest-input"
                                    name="SelectInfoRequest"
                                    outputVariable="SelectInfoRequest"
                                    tibex:xpdlId="c5cb9f0e-a91a-4c12-a972-3133083e8ed6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToSelectInfoRequest"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectInfoRequestToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c5cb9f0e-a91a-4c12-a972-3133083e8ed6+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;substring-before($InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS,'-')&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.CODIFICAOLOAGCOM,D.AZIONE,D.NOMECOMPONENTE,R.IDRICHIESTAOLO,R.LAVORAZIONE,ATT.NOMEATTRIBUTO,ATT.VALOREATTRIBUTO &#xd;&#xa;FROM BDS_1_CASEDATA_RICHIESTA R,BDS_1_CASEDATA_ORDINE O,&#xd;&#xa;BDS_1_CASEDATA_DETTAGLIOORDINE D,BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATT&#xd;&#xa;WHERE R.BDS_ID=O.RICHIESTA_ORDINE_BDSID AND O.BDS_ID=D.ORDINE_DETTAGLIOORDINE_BDSID AND D.BDS_ID=ATT.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID &#xd;&#xa;  AND R.LAVORAZIONE='MIGRAZIONE' AND R.CODIFICAOLOAGCOM='TLC' AND  D.AZIONE='D' AND D.NOMECOMPONENTE LIKE 'CONSISTENZA%' &#xd;&#xa;  AND R.IDRICHIESTAOLO=? AND ATT.NOMEATTRIBUTO='CODIFICAOLOAGCOMDONATING' AND ATT.VALOREATTRIBUTO!='TLC'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="AZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectInfoRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectInfoRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiXDSL&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectInfoRequest/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectInfoRequest: &amp;quot;, tib:render-xml($SelectInfoRequest, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SelectInfoRequest: nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogSelectInfoRequest-input"
                                    name="LogSelectInfoRequest"
                                    tibex:xpdlId="9482c275-1ab3-4137-bb4c-d69584ee1a17"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectInfoRequestToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogSelectInfoRequestToInsertStagingFatturazioneXDSL"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;log_name&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectInfoRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectInfoRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrderBilling&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW_JPUB_FatturazioneOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InvioEsitiXDSL&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiXDSL.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectInfoRequest/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectInfoRequest: &amp;quot;, tib:render-xml($SelectInfoRequest, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SelectInfoRequest: nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$log_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOrdiniNonInVoloXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;Donating-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DonatingRequest>&#xa;            &lt;xsl:if test=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;>&#xa;                &lt;tns4:ID_ORDN_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                &lt;/tns4:ID_ORDN_CRMWS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO&quot;>&#xa;                &lt;tns4:CODE_SCARTO>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitiXDSL/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO&quot;/>&#xa;                &lt;/tns4:CODE_SCARTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RICH_OLO&quot;>&#xa;                &lt;tns4:IDRichOLO>&#xa;                    &lt;xsl:value-of select=&quot;$SelectOrdiniNonInVoloXDSL/Record[1]/ID_RICH_OLO&quot;/>&#xa;                &lt;/tns4:IDRichOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:DonatingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Donating-input"
                                    name="Donating"
                                    outputVariable="Donating"
                                    tibex:xpdlId="b72515ae-20c2-4944-a60d-b5c5c6bac1be"
