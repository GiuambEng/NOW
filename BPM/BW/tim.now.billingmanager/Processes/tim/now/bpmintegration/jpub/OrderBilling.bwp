                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2b0ca4e6-2b68-4e3c-8017-ba673f814dbf+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectOrdiniNonInVoloREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot;&quot;>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
