                    &lt;/TIMSTP_AGGTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot; or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;>&#xa;                                    &lt;ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORDINE_COMPOSTO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot; or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;>&#xa;                                    &lt;ID_ORDINE_COMPOSTO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORDINE_COMPOSTO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-') or $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot; or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_CONSUNTIVO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '-')  or $InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA=&amp;quot;PREV&amp;quot; or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, '_R') or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_A&amp;quot;) or contains($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS, &amp;quot;_S&amp;quot;)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_CONSUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                            &lt;/FLAG_CONSUNTIVO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_CONSUNTIVO xsi:nil=&quot;true&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                            &lt;ID_RICH_OLO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_RICH_OLO>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns4:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),TIMSTP_AGGTO=?&#xa;WHERE (ID_ORDINE_COMPOSTO = ? OR ? is null) AND (FLAG_CONSUNTIVO=? or ? is null) &#xa;AND ID_EVENTO_ORDN_NOW_WHLS=? AND ID_RICH_OLO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE_COMPOSTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE_COMPOSTO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InsertStagingControlcodeFatturazioneReg-input"
                                name="InsertStagingControlcodeFatturazioneReg"
                                operation="InsertUpdateStaging"
                                outputVariable="InsertStagingControlcodeFatturazioneReg"
