                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NUMERO_TENTATIVI, IDTPLG_STATO_EVENTO_JPUB, ID_RICH_OLO, ID_EVENTO_ORDN_NOW_WHLS,ID_RISORSA&#xd;&#xa;FROM EVENTO_JPUB&#xd;&#xa;WHERE ID_ORDINE_COMPOSTO = ? AND FLAG_CONSUNTIVO=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE_COMPOSTO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>
                                    <columnMetadata
                                    columnName="NUMERO_TENTATIVI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDTPLG_STATO_EVENTO_JPUB"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6bd2fb9-212c-422d-82d2-83500fc784db+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_RICH_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateOrdiniNonInVoloREG1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot; and  exists($SelectID_RICH_OLO/Record[substring-after(ID_ORDINE_COMPOSTO,'-')='ST' and DESCR_STATO_EVENTO_JPUB!='IN_ATTESA_CHIUSURA' ]) and substring-after($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS,'-')='1'&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'FATTURAZIONE_OK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_OK&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio/parameters/tns2:ESITI/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpdateOrdiniNonInVoloREG1-input"
                                    name="UpdateOrdiniNonInVoloREG1"
                                    outputVariable="UpdateOrdiniNonInVoloREG1"
                                    tibex:xpdlId="a6bd2fb9-212c-422d-82d2-83500fc784db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectID_RICH_OLOToUpdateOrdiniNonInVoloREG1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UPDATE_OKToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdateOrdiniNonInVoloREG1ToRisottomissioneReplyREG_RetryperKO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$InvioEsitiRegolatorio/parameters/tns:ESITI/tns:NOTIFICA/@CODESCARTO != &quot;0&quot; and $SelectOrdiniNonInVoloREG/Record[1]/NUMERO_TENTATIVI &lt; $MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$InvioEsitiRegolatorio.parameters/tns:NOTIFICA/@CODESCARTO != "0" and $SelectOrdiniNonInVoloREG/Record[1]/NUMERO_TENTATIVI < $MaxRetry]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6bd2fb9-212c-422d-82d2-83500fc784db+input&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectID_RICH_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateOrdiniNonInVoloREG1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot; and  exists($SelectID_RICH_OLO/Record[substring-after(ID_ORDINE_COMPOSTO,'-')='ST' and DESCR_STATO_EVENTO_JPUB!='IN_ATTESA_CHIUSURA' ]) and substring-after($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS,'-')='1'&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'FATTURAZIONE_OK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CODESCARTO = &amp;quot;0&amp;quot;&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_OK&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiRegolatorio.parameters/tns2:TESTATA/@IDORDCRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvioEsitiRegolatorio.parameters/tns2:NOTIFICA/@CATEGORIA='PREV'&quot;>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
