                            <bpws:reply faultName="fault" name="ReplyKO"
                                operation="BPM_Fatturazione"
                                partnerLink="BPM_callJPub"
                                portType="ns14:BPM_callJPub"
                                tibex:xpdlId="4625a9ba-7890-4b4d-908f-9b3e7e511b78" variable="ReplyKO-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/BPM_callJPub/" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns4="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions" version="2.0"&gt;
    &lt;xsl:param name="SendMessageJPUB"/&gt;
    &lt;xsl:param name="_error_SendMessageJPUB"/&gt;
    &lt;xsl:template name="ReplyKO-input" match="/"&gt;
        &lt;tns5:BPM_FatturazioneFault&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($SendMessageJPUB/parameters/tns1:SendJPUBResponse/tns1:code)"&gt;
                        &lt;tns1:BPMFault&gt;
                            &lt;tns1:code&gt;
                                &lt;xsl:value-of select="$SendMessageJPUB/parameters/tns1:SendJPUBResponse/tns1:code"/&gt;
                            &lt;/tns1:code&gt;
                            &lt;tns1:msg&gt;
                                &lt;xsl:value-of select="$SendMessageJPUB/parameters/tns1:SendJPUBResponse/tns1:msg"/&gt;
                            &lt;/tns1:msg&gt;
                        &lt;/tns1:BPMFault&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:when test="exists($_error_SendMessageJPUB/tns1:SendJPUBFault)"&gt;
                        &lt;tns1:BPMFault&gt;
                            &lt;tns1:code&gt;
                                &lt;xsl:value-of select="$_error_SendMessageJPUB/tns1:SendJPUBFault/tns1:code"/&gt;
                            &lt;/tns1:code&gt;
                            &lt;tns1:msg&gt;
                                &lt;xsl:value-of select="$_error_SendMessageJPUB/tns1:SendJPUBFault/tns1:msg"/&gt;
                            &lt;/tns1:msg&gt;
                        &lt;/tns1:BPMFault&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:when test="exists($_error_SendMessageJPUB/tns4:ActivityTimedOutException)"&gt;
                        &lt;tns1:BPMFault&gt;
                            &lt;tns1:code&gt;
                                &lt;xsl:value-of select="$_error_SendMessageJPUB/tns4:ActivityTimedOutException/msgCode"/&gt;
                            &lt;/tns1:code&gt;
                            &lt;tns1:msg&gt;
                                &lt;xsl:value-of select="$_error_SendMessageJPUB/tns4:ActivityTimedOutException/msg"/&gt;
                            &lt;/tns1:msg&gt;
                        &lt;/tns1:BPMFault&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns1:BPMFault&gt;
                            &lt;tns1:code&gt;
                                &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                            &lt;/tns1:code&gt;
                            &lt;tns1:msg&gt;
                                &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                            &lt;/tns1:msg&gt;
                        &lt;/tns1:BPMFault&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns5:BPM_FatturazioneFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_callJPub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns4=&quot;http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_SendMessageJPUB&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SendMessageJPUB.parameters/tns1:code)&quot;>&#xa;                &lt;tns1:BPMFault>&#xa;                    &lt;tns1:code>&#xa;                        &lt;xsl:value-of select=&quot;$SendMessageJPUB.parameters/tns1:code&quot;/>&#xa;                    &lt;/tns1:code>&#xa;                    &lt;tns1:msg>&#xa;                        &lt;xsl:value-of select=&quot;$SendMessageJPUB.parameters/tns1:msg&quot;/>&#xa;                    &lt;/tns1:msg>&#xa;                &lt;/tns1:BPMFault>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($_error_SendMessageJPUB/tns1:SendJPUBFault)&quot;>&#xa;                &lt;tns1:BPMFault>&#xa;                    &lt;tns1:code>&#xa;                        &lt;xsl:value-of select=&quot;$_error_SendMessageJPUB/tns1:SendJPUBFault/tns1:code&quot;/>&#xa;                    &lt;/tns1:code>&#xa;                    &lt;tns1:msg>&#xa;                        &lt;xsl:value-of select=&quot;$_error_SendMessageJPUB/tns1:SendJPUBFault/tns1:msg&quot;/>&#xa;                    &lt;/tns1:msg>&#xa;                &lt;/tns1:BPMFault>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($_error_SendMessageJPUB/tns4:ActivityTimedOutException)&quot;>&#xa;                &lt;tns1:BPMFault>&#xa;               