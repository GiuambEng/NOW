                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83062a73-eaee-4b7f-8e76-558516cde026+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectStrutturaRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectStrutturaRichiesta-input"
                                    name="SelectStrutturaRichiesta"
                                    outputVariable="SelectStrutturaRichiesta"
                                    tibex:xpdlId="83062a73-eaee-4b7f-8e76-558516cde026" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToSelectStrutturaRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectStrutturaRichiestaToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83062a73-eaee-4b7f-8e76-558516cde026+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectStrutturaRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STRUTTURA_RICH&#xa;  FROM OFFERTA OFF, TRASCODFC_OFFERTA TRAS&#xa;  WHERE OFF.ID_OFFERTA = TRAS.ID_OFFERTA AND TRAS.NOME_OFFERTA_ESTERNA = ?&#xa;  AND TRAS.PROVENIENZA = 'BPM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_RICH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStrutturaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectStrutturaRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JPUB_Fatturazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CallJPub&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_Fatturazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStrutturaRichiesta/Record)>0&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectStrutturaRichiesta&amp;quot;, $SelectStrutturaRichiesta/Record[1]/STRUTTURA_RICH)&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'SelectStrutturaRichiesta:Record non trovato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogSelectStrutturaRichiesta-input"
