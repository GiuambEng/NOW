                                    expression="if ($SendMessageJPUB.parameters/tns1:code = &quot;OK&quot;) then &quot;RICEVUTO_ACK&quot; else &quot;DA_INVIARE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
