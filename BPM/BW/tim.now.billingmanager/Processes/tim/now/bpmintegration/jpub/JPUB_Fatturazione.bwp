true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0  and not(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S')))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_A')&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;) or exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)])&quot;>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDDETTAGLIOORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine)&quot;>&lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDDETTAGLIOORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Sel_EVENTO_ORDN_NOW_WHLS/I