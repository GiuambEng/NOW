                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_EVENTO_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="SendMessageJPUB-input"
                                name="SendMessageJPUB"
                                operation="SendJPUB"
                                outputVariable="SendMessageJPUB"
                                partnerLink="SendMessageJPUB"
                                portType="ns15:SendJPUB" tibex:xpdlId="8631b249-47c0-4fa6-b1f2-36d0825fb276">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" version="2.0"&gt;&lt;xsl:param name="SelectFromGestioneFatturazione"/&gt;&lt;xsl:param name="StatoFatturazione"/&gt;&lt;xsl:param name="BPM_Fatturazione"/&gt;&lt;xsl:param name="Oscuramento"/&gt;&lt;xsl:template name="SendMessageJPUB-input" match="/"&gt;&lt;tns:SendJPUBRequest&gt;&lt;parameters&gt;&lt;tns1:SendJPUBRequest&gt;&lt;xsl:choose&gt;&lt;xsl:when test="(string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)&gt;0 and upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y' and (count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])=0 or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='N')) or ((string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)&gt;0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)&gt;0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='SPECIALPRICE']/valoreAttributo)&gt;0 or (($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARI