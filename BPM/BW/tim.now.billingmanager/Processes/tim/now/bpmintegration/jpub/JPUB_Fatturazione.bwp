                                    <bpws:targets>
                                    <bpws:target linkName="LogAssignStatoToUpdate_GestioneFatturazione"/>
                                    <bpws:target linkName="EmptyToUpdate_GestioneFatturazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Update_GestioneFatturazioneToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9954a8bc-67b6-4bfa-96ea-ffeea78395a7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_GestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 or (($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione='CESSAZIONE' or $BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione='VARIAZIONE')and (string-length($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 or string-length($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0)))  and(count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N') and ($BPM_Fatturazione.parameters/tns1:Richiesta/offerta='FULLGPON1BPNRR' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='SEMIGPON1BPNRR' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='UBBSEMIGPON' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='VULAFTTH' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='SEMIVULAFTTH'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMNGAFTTH' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICO' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPNGAFTTH'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPBASEPLUSFLAT' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPBASEPLUSLITE' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPSPECIALPROFILEFLAT' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPSPECIALPROFILELITE' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='FULLGPONPLUSNGA' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='FULLGPONPLUS' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='UBBFULLGPON'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPNGAFTTCAB'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='VULAFTTCAB')&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'ATTESA_INVIO_DRO_DIFF'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and &amp;#xD;&amp;#xA;upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y') and &amp;#xD;&amp;#xA;(count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='Y'))&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'ATTESA_INVIO_JPUB'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoFatturazione='DA_INVIARE' and string-length($SendMessageJPUB.parameters/tns1:IDRichOLO)>0&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0 and contains($BPM_Fatturazione.parameters/tns1:NPSync,'_A')&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0 and not(contains($BPM_Fatturazione.parameters/tns1:NPSync,'_S')))  and (string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0)&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0  and not(contains($BPM_Fatturazione.parameters/tns1:NPSync,'_S')))&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($BPM_Fatturazione.parameters/tns1:NPSync,'_A')&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;) or exists($BPM_Fatturazione.parameters/tns1:AssetRicarica)&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)])&quot;>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;NUMBERPORTABILITY&amp;quot;][1]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),TIMSTP_AGGTO=SYSDATE&#xa;WHERE ID_RISORSA = ? AND ID_RICH_OLO = ? AND IDDETTAGLIOORDINE = ? AND ID_EVENTO_ORDN_NOW_WHLS=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1a851ccf-f238-4916-9353-d5370790b836+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StatoFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStrutturaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_GestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S'))&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_A')&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)])&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;NUMBERPORTABILITY&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)])&quot;>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_A')&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S')))  and (string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0)&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;TIMSTP_INSMTO_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_EVENTO>&#xa;            &lt;EVENTO_ORDN_NOW_WHLS.NEXTVAL>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/EVENTO_ORDN_NOW_WHLS.NEXTVAL>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Flag_OpereSpeciali=true() or (string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S')))&quot;>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'IN_INVIO'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Flag_OpereSpeciali=true()&quot;>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/FLAG_CONSUNTIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and not(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S'))&quot;>&#xa;                    &lt;STRUTTURA_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;                    &lt;/STRUTTURA_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STRUTTURA_OFFERTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectStrutturaRichiesta/Record[1]/STRUTTURA_RICH)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectStrutturaRichiesta/Record[1]/STRUTTURA_RICH&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STRUTTURA_OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_S')&quot;>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                    &lt;/OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;OFFERTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
