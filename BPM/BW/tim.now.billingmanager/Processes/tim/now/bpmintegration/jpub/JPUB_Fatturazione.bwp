                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateDA_INVIAREToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0686ccab-be76-415e-a2ac-8c72ac7c38b7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPM_Fatturazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStatoDA_INVIARE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0 and contains($BPM_Fatturazione.parameters/tns1:NPSync,'_A')&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0 and not(contains($BPM_Fatturazione.parameters/tns1:NPSync,'_S')))  and (string-length($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0)&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0  and not(contains($BPM_Fatturazione.parameters/tns1:NPSync,'_S')))&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($BPM_Fatturazione.parameters/tns1:NPSync,'_A')&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($BPM_Fatturazione.parameters/tns1:NPSync)>0&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='STS' and azione='A'][1]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                            &lt;IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;RACCOLTA&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente, &amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine)&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[nomeComponente, &amp;quot;NUMBERPORTABILITY&amp;quot;]/IDDettaglioOrdine&quot;/>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/IDDETTAGLIOORDINE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Sel_EVENTO_ORDN_NOW_WHLS/IDEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xa;WHERE ID_RICH_OLO = ? AND ID_RISORSA = ? AND IDDETTAGLIOORDINE = ? AND ID_EVENTO_ORDN_NOW_WHLS=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
