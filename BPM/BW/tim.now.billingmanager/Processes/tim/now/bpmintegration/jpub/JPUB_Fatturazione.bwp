                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaScenario, &quot;DONOROLO&quot;) and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM!='TLC') or ( $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione = &quot;ATTIVAZIONE&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta =&quot;NPG&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/tipoComunicazioneNP = &quot;PORTIN&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM = &quot;TLC&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonor = &quot;TLC&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonating != &quot;TLC&quot; and $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/flagDelibera103 = &quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(contains($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/tipologiaScenario, "DONOROLO") and $BPM_Fatturazione.parameters/tns1:Richiesta/codificaOLOAGCOM!='TLC') or ( $BPM_Fatturazione.parameters/tns1:Richiesta/lavorazione = "ATTIVAZIONE" and $BPM_Fatturazione.parameters/tns1:Richiesta/strutturaRichiesta ="NPG" and $BPM_Fatturazione.parameters/tns1:Richiesta/tipoComunicazioneNP = "PORTIN" and $BPM_Fatturazione.parameters/tns1:Richiesta/codificaOLOAGCOM = "TLC" and $BPM_Fatturazione.parameters/tns1:Richiesta/codificaOLOAGCOMDonor = "TLC" and $BPM_Fatturazione.parameters/tns1:Richiesta/codificaOLOAGCOMDonating != "TLC" and $BPM_Fatturazione.parameters/tns1:Richiesta/flagDelibera103 = "Y")]]></bpws:transitionCondition>
