                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9954a8bc-67b6-4bfa-96ea-ffeea78395a7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StatoFatturazione&quot;/>&lt;xsl:param name=&quot;BPM_Fatturazione&quot;/>&lt;xsl:param name=&quot;Sel_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;xsl:param name=&quot;SendMessageJPUB&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Update_GestioneFatturazione-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 or (($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE')and (string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0 or string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0)))  and(count($Oscuramento/Record[COD_AGESP='R1I-25-0071'])=0 or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='R1I-25-0071']/FLAG_OSCURMENTO='N') and ($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPON1BPNRR' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIGPON1BPNRR' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='UBBSEMIGPON' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIVULAFTTH'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTH' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICOFLAT'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMGBESIMMETRICO' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSFLAT' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSLITE' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILEFLAT' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILELITE' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS' or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='UBBFULLGPON'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB'or $BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB')&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'ATTESA_INVIO_DRO_DIFF'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and &amp;#xD;&amp;#xA;upper-case($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y') and &amp;#xD;&amp;#xA;(count($Oscuramento/Record[COD_AGESP='T1PRJ0001672'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001672']/FLAG_OSCURMENTO='Y'))&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'ATTESA_INVIO_JPUB'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoFatturazione='DA_INVIARE' and string-length($SendMessageJPUB/parameters/tns1:SendJPUBResponse/tns1:IDRichOLO)>0&quot;>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;'RICEVUTO_ACK'&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_STATO_EVENTO_JPUB>&lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&lt;/DESCR_STATO_EVENTO_JPUB>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync)>0 and contains($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1:NPSync,'_A')&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BPM_Fatturazione/parameters/tns1:BPMRequest/tns1: