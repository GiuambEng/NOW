                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.ID_RICH_OLO, E.ID_RISORSA, E.NUMERO_TENTATIVI, E.ID_EVENTO_ORDN_NOW_WHLS, E.ID_RICH_JPUB, E.TIMSTP_INSMTO_EVENTO, E.CONTENUTO_XML, T.DESCR_STATO_EVENTO_JPUB&#xa;FROM EVENTO_JPUB E, TIPOLG_STATO_EVENTO_JPUB T&#xa;WHERE E.ID_RISORSA = ? AND E.IDTPLG_STATO_EVENTO_JPUB = T.IDTPLG_STATO_EVENTO_JPUB" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_TENTATIVI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_JPUB"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO_EVENTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
