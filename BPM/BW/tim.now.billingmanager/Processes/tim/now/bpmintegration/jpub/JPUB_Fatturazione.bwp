a/offerta='FULLGPONPLUSNGA' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='FULLGPONPLUS' or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='UBBFULLGPON'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='EASYIPNGAFTTCAB'or $BPM_Fatturazione.parameters/tns1:Richiesta/offerta='VULAFTTCAB'))&quot;>&#xa;                    &lt;tns1:Stato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Stato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SelectFromGestioneFatturazione/Record) and exists($SelectFromGestioneFatturazione/Record[DESCR_STATO_EVENTO_JPUB !=&amp;quot;FATTURAZIONE_OK&amp;quot;])&quot;>&#xa;                    &lt;tns1:Stato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Stato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Stato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN_INVIO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Stato>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$BPM_Fatturazione.parameters&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($BPM_Fatturazione.parameters/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;AGGIUNTIVO&amp;quot;])&quot;>&#xa;                    &lt;tns1:StatoNP>&#xa;                        &lt;tns1:StatoNumeriAggiuntivi>&#xa;                            &lt;xsl:value-of select=&quot;$StatoFatturazione&quot;/>&#xa;                        &lt;/tns1:StatoNumeriAggiuntivi>&#xa;                    &lt;/tns1:StatoNP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$BPM_Fatturazione.parameters/tns1:Flag_OpereSpeciali = true()&quot;>&#xa;                    &lt;tns1:Operespeciali>&#xa;                        &lt;xsl:value-of select=&quot;'OpereSpeciali'&quot;/>&#xa;                    &lt;/tns1:Operespeciali>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:SendJPUBRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
