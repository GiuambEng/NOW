NE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($Start/tns1:BPMRequest/tns1:NewBilling)>0 and $Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;QUANTITA>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QUANTITA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor) > 0&quot;>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor&quot;/>&lt;/CODE_DONOR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONOR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating) > 0&quot;>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating&quot;/>&lt;/CODE_DONATING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONATING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;FLAG_LA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_LA>&lt;TIPO_LINEA_NUM_AGG>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/TIPO_LINEA_NUM_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&lt;CODE_HOSTING>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/CODE_HOSTING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_HOSTING>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_HOSTING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CodeSTS/tns3:CodeSTSOutput)>0&quot;>&lt;xsl:for-each select=&quot;$CodeSTS/tns3:CodeSTSOutput&quot;>&lt;tns:STS>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/TIPO_AZIONE>&lt;FLAG_LINEA_NUM_AGG>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_LINEA_NUM_AGG>&lt;ID_RIS_AGGIUNTIVA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ID_RIS_AGGIUNTIVA>&lt;CODE_STS>&lt;xsl:value-of select=&quot;tns3:AttributoOutput&quot;/>&lt;/CODE_STS>&lt;/tns:STS>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ACCESSO>&lt;/tns:TESTATA>&lt;/tns:REGOLATORIO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
