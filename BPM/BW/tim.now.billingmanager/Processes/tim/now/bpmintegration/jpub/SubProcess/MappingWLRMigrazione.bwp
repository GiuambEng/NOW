                    tibex:label="Aggiuntivi" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="LogMapperWLRPrincipaleToLogEndMappingWLR" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link
                    name="LogAccumulateAggiuntiviWLRToMapperWLRAggiuntivi" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="MapperWLRAggiuntiviToLogMapperWLRAggiuntivi" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="LogMapperWLRAggiuntiviToLogEndMappingWLR" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBCQueryInvokeToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToCOD_CAUS" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelectTipologiaSottolavToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryInvokeToCOD_CAUS" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogStartMappingWLRToCallProcess_STS"
