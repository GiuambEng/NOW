NTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                    &lt;FLAG_LA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_LA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' and $Start/tns1:Lavorazione='CESSAZIONE' &quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI') and upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX' &quot;>&#xa;                                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_LINEA_NUM_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA_NUM_AGG>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                    &lt;CODE_HOSTING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_HOSTING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_HOSTING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_HOSTING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot; upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($CodeSTS/tns3:CodeSTSOutput)>0 and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$CodeSTS/tns3:CodeSTSOutput&quot;>&#xa;                                &lt;tns:STS>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                    &lt;ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                    &lt;CODE_STS>&#xa;                                        &lt;xsl:value-of select=&quot;tns3:AttributoOutput&quot;/>&#xa;                                    &lt;/CODE_STS>&#xa;                                &lt;/tns:STS>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:ACCESSO>&#xa;            &lt;/tns:TESTATA>&#xa;        &lt;/tns:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogMapperWLRPrincipale-input"
                    name="LogMapperWLRPrincipale"
                    tibex:xpdlId="08a9bce7-35dd-4bd5-b7b3-70921ac2127f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperWLRPrincipaleToLogMapperWLRPrincipale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMapperWLRPrincipaleToLogEndMappingWLR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogMapperWLRPrincipaleToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente=&quot;STS&quot; and azione=&quot;A&quot;]) and $Start/ns7:Lavorazione=&quot;ATTIVAZIONE&quot;) or (string-length($Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto)>0 and string-length($Start/ns7:BPMRequest/ns7:NewBilling)>0 and $Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto='A' and exists($Start/ns7:BPMRequest/ns7:Asset/dettaglioasset[nomeComponente='STS'  and statoDettaglioAsset='ATTIVO']) )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente="STS" and azione="A"]) and $Start/ns7:Lavorazione="ATTIVAZIONE") or (string-length($Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto)>0 and string-length($Start/ns7:BPMRequest/ns7:NewBilling)>0 and $Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto='A' and exists($Start/ns7:BPMRequest/ns7:Asset/dettaglioasset[nomeComponente='STS'  and statoDettaglioAsset='ATTIVO']) )]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperWLRPrincipale&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperWLRPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('MapperWLRPrincipale',tib:render-xml($MapperWLRPrincipale, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="COD_CAUS-input"
                    name="COD_CAUS" outputVariable="COD_CAUS"
                    tibex:xpdlId="75890cca-bf69-4334-a924-d15be57a6069"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCOD_CAUS"/>
                        <bpws:target linkName="JDBCQueryInvokeToCOD_CAUS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="COD_CAUSToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTipologiaSottolav&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns2:CodeCausaleRequest>&#xa;                    &lt;tns2:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns2:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                &lt;tns2:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                &lt;/tns2:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns2:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns2:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='RIENTROINTI' and ($Start/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEANONATTIVA' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEANONATTIVA' or $Start/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH')and  $Start/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM='TLC'&quot;>&#xa;                            &lt;tns2:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                            &lt;/tns2:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;>&#xa;                                &lt;tns2:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;/>&#xa;                                &lt;/tns2:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                                &lt;tns2:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns2:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns2:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_Rich_OLO>&#xa;                    &lt;tns2:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/offerta&quot;/>&#xa;                    &lt;/tns2:OFFERTA>&#xa;                    &lt;tns2:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns2:STRUTTURARICHIESTA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $Start/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns2:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                            &lt;/tns2:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($Start/tns1:BPMRequest/tns1:NewBilling)>0 and ($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;tns2:Billing>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns2:Billing>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:CodeCausaleRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:CodeCausaleRequest>&#xa;                    &lt;tns2:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;                    &lt;/tns2:PID_SISTEMA>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                        &lt;tns2:PSCENARIO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                        &lt;/tns2:PSCENARIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                        &lt;tns2:PSOTTOLAVORAZ>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                        &lt;/tns2:PSOTTOLAVORAZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_Rich_OLO>&#xa;                    &lt;tns2:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/offerta&quot;/>&#xa;                    &lt;/tns2:OFFERTA>&#xa;                    &lt;tns2:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns2:STRUTTURARICHIESTA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns2:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                            &lt;/tns2:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns2:CodeCausaleRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.CODE_CAUSALE" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Aggiuntivi"
                    name="AccumulateAggiuntiviWLR"
                    outputVariable="Aggiuntivi"
                    tibex:xpdlId="5f2f8866-9d9d-4e7c-97c1-b65e8f0ed27b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAccumulateAggiuntiviWLR"/>
                        <bpws:target linkName="CallProcessToAccumulateAggiuntiviWLR1_KO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AccumulateAggiuntiviWLRToLogAccumulateAggiuntiviWLR"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Aggiuntivi&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns5:Aggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='AGGIUNTIVO']&quot;>&#xa;                        &lt;tns5:AggiuntiviWLR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:ID_RIS>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;!--APRIRE OP ALLA GOVERNANCE PER VALORIZZAZIONE ID_RISORSA DELL'AGGIUNTIVO-->&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&#xa;                                    &lt;tns5:ID_RIS_PRINC>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns5:ID_RIS_PRINC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI') and upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                    &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                    &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                    &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                    &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                    &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                    &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI' ) and upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                    &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                    &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='NUMAGGIUNTIVI']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)='PBX' ) or ($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='AGGIUNTIVIISDN']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)='ISDN' )&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:ID_RIS_AGGIUNTIVA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns5:IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                            &lt;/tns5:IDDETTAGLIOORDINE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;>&#xa;                                        &lt;tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                            &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns5:AggiuntiviWLR>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns5:Aggiuntivi>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO'])&quot;>&#xa;                        &lt;tns5:Aggiuntivi>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='AGGIUNTIVO'and attributiDettaglioOrdine[nomeAttributo='STATO']/valoreAttributo='ATTIVO']&quot;>&#xa;                                &lt;tns5:AggiuntiviWLR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;!--APRIRE OP ALLA GOVERNANCE PER VALORIZZAZIONE ID_RISORSA DELL'AGGIUNTIVO-->&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:ID_RIS_PRINC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI') and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI' ) and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='NUMAGGIUNTIVI']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='PBX' ) or $Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='AGGIUNTIVIISDN']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='ISDN'&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns5:IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/tns5:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns5:AggiuntiviWLR>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns5:Aggiuntivi>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'])&quot;>&#xa;                        &lt;tns5:Aggiuntivi>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUPRENOTAZIONEAGGIUNTIVO'and attributiDettaglioOrdine[nomeAttributo='STATOAGGIUNTIVO']/valoreAttributo='ATTIVO' ]&quot;>&#xa;                                &lt;tns5:AggiuntiviWLR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;!--APRIRE OP ALLA GOVERNANCE PER VALORIZZAZIONE ID_RISORSA DELL'AGGIUNTIVO-->&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:ID_RIS_PRINC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI') and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI' ) and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='NUMAGGIUNTIVI']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='PBX' ) or $Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='AGGIUNTIVIISDN']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='ISDN'&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns5:IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/tns5:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns5:AggiuntiviWLR>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns5:Aggiuntivi>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Aggiuntivi>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUAGGIUNTIVO'and attributiDettaglioOrdine[nomeAttributo='STATOAGGIUNTIVO']/valoreAttributo='ATTIVO']&quot;>&#xa;                                &lt;tns5:AggiuntiviWLR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='TELAGGIUNTIVO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;!--APRIRE OP ALLA GOVERNANCE PER VALORIZZAZIONE ID_RISORSA DELL'AGGIUNTIVO-->&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:ID_RIS_PRINC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI') and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns5:TIPO_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/tns5:TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRA MULTI' or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo) = 'BRAMULTI' ) and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo) = 'ISDN'&quot;>&#xa;                                            &lt;tns5:FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                            &lt;/tns5:FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='NUMAGGIUNTIVI']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='PBX' ) or $Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='AGGIUNTIVIISDN']/valoreAttributo!='0' and upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='ISDN'&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns5:IDDETTAGLIOORDINE>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/tns5:IDDETTAGLIOORDINE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;>&#xa;                                                &lt;tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo&quot;/>&#xa;                                                &lt;/tns5:CODICE_FATTTURAZIONE_JPUB>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns5:AggiuntiviWLR>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns5:Aggiuntivi>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
