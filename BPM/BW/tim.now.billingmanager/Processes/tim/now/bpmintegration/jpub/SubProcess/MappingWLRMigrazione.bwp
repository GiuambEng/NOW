                       &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_DONOR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_DONOR>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                            &lt;CODE_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/CODE_DONATING>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_DONATING>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_ID_SLUCO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_ID_SLUCO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;>&#xa;                                &lt;CODE_ID_SLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;/>&#xa;                                &lt;/CODE_ID_SLUCO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_ID_SLUCO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_ID_SLUCO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='ATTIVAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='U2'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($Start/tns1:Lavorazione='CESSAZIONE') and (upper-case($Start/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($Start/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($Start/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($Start/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;) and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1'&quot;>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(upper-case($Start/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($Start/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($Start/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;) and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1'&quot;>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                    &lt;CODE_HOSTING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_HOSTING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_HOSTING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_HOSTING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CodeSTS/tns3:CodeSTSOutput) and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$CodeSTS/tns3:CodeSTSOutput&quot;>&#xa;                                &lt;tns:STS>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                    &lt;ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                    &lt;CODE_STS>&#xa;                                        &lt;xsl:value-of select=&quot;tns3:AttributoOutput&quot;/>&#xa;                                    &lt;/CODE_STS>&#xa;                                &lt;/tns:STS>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:ACCESSO>&#xa;            &lt;/tns:TESTATA>&#xa;            &lt;xsl:for-each select=&quot;$Aggiuntivi/tns5:AggiuntiviWLR&quot;>&#xa;                &lt;tns:TESTATA>&#xa;                    &lt;xsl:variable name=&quot;TIPO_LINEA_NUM_AGG&quot; select=&quot;tns5:TIPO_LINEA_NUM_AGG&quot;/>&#xa;                    &lt;xsl:variable name=&quot;FLAG_LINEA_NUM_AGG&quot; select=&quot;tns5:FLAG_LINEA_NUM_AGG&quot;/>&#xa;                    &lt;xsl:variable name=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot; select=&quot;tns5:ID_RIS&quot;/>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($Start/tns1:BPMRequest/tns1:NewBilling)>0 and ($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string($Start/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_MSG>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                    &lt;/DATA_MSG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and exists($Start/tns1:BPMRequest/tns1:Asset/DES)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), 00,00,00)&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;CODE_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&#xa;                    &lt;/CODE_CAUS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:ACCESSO>&#xa;                        &lt;TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_CONTR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>