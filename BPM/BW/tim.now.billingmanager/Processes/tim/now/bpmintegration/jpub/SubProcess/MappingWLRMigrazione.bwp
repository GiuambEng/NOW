                <bpws:link name="EmptyToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogContrattopadreToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToAccumulateAggiuntiviWLR" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="l" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Assign1ToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToMapperWLRPrincipale" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="CallProcessToAccumulateAggiuntiviWLR1_KO"
                    tibex:label="KO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogMapperWLRPrincipaleToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogMapperWLRAggiuntiviToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToLogEndMappingWLR" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToControllo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Empty1ToMapperWLRPrincipale" tibex:linkType="SUCCESSWITHCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="84f0f442-a532-4d82-9658-da4018213a9b"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ControlloAggiuntivi-input"
                    name="ControlloAggiuntivi"
                    tibex:xpdlId="2c168078-f2b9-4928-854f-9cc8ba262634" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogEndMappingWLRToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperWLRAggiuntivi&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperWLRPrincipale&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;ControlloAggiuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:MappingREG_WLRResponse>&#xa;            &lt;tns2:WLR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapperWLRPrincipale)&quot;>&#xa;                        &lt;tns2:PRINCIPALE>&#xa;                            &lt;tns:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;$MapperWLRPrincipale/tns:TESTATA&quot;/>&#xa;                            &lt;/tns:REGOLATORIO>&#xa;                        &lt;/tns2:PRINCIPALE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapperWLRAggiuntivi)&quot;>&#xa;                        &lt;tns2:AGGIUNTIVI>&#xa;                            &lt;tns:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;$MapperWLRAggiuntivi/tns:TESTATA&quot;/>&#xa;                            &lt;/tns:REGOLATORIO>&#xa;                        &lt;/tns2:AGGIUNTIVI>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exists($Mapper)&quot;>&#xa;                    &lt;tns2:STS>&#xa;                        &lt;tns:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$Mapper/tns:TESTATA&quot;/>&#xa;                        &lt;/tns:REGOLATORIO>&#xa;                    &lt;/tns2:STS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:WLR>&#xa;        &lt;/tns2:MappingREG_WLRResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStartMappingWLR-input"
                    name="LogStartMappingWLR"
                    tibex:xpdlId="8e1b7baa-4641-4e6f-91e7-b2834f0450da"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartMappingWLRToCallProcess_STS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Start/ns7:Lavorazione!='CESSAZIONE' and exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='STS'])) or (string-length($Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto)>0 and string-length($Start/ns7:BPMRequest/ns7:NewBilling)>0 and $Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto='A' and exists($Start/ns7:BPMRequest/ns7:Asset/dettaglioasset[nomeComponente='STS'  and statoDettaglioAsset='ATTIVO']))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Start/ns7:Lavorazione!='CESSAZIONE' and exists($Start/ns7:BPMRequest/ns7:Richiesta/ordine/dettaglioordine[nomeComponente='STS'])) or (string-length($Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto)>0 and string-length($Start/ns7:BPMRequest/ns7:NewBilling)>0 and $Start/ns7:BPMRequest/ns7:Richiesta/codiceRifiuto='A' and exists($Start/ns7:BPMRequest/ns7:Asset/dettaglioasset[nomeComponente='STS'  and statoDettaglioAsset='ATTIVO']))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartMappingWLRToJDBCQueryInvoke_ComponenteSTSnonpresente">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartMappingWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Process MappingWLRMigrazione started&amp;quot;,tib:render-xml($Start,true(),true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogEndMappingWLR-input"
                    name="LogEndMappingWLR"
                    tibex:xpdlId="2f2b6f87-60f7-4a3f-881e-83ff30ee870b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMapperWLRPrincipaleToLogEndMappingWLR"/>
                        <bpws:target linkName="LogMapperWLRAggiuntiviToLogEndMappingWLR"/>
                        <bpws:target linkName="CallProcess1ToLogEndMappingWLR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEndMappingWLRToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEndMappingWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Process MappingWLRMigrazione end.&amp;quot;&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub.SubProcess'&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns4:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns4:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns4:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns4:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MappingWLRMigrazione_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLRMigrazione_&amp;quot;, $Start/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingWLRMigrazione_&amp;quot;, $Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'OUT'&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CodiceSTS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:param name=&quot;CodeSTS&quot;/>&lt;xsl:param name=&quot;Contrattopadre&quot;/>&lt;xsl:param name=&quot;Contract&quot;/>&lt;xsl:template name=&quot;MapperWLRPrincipale-input&quot; match=&quot;/&quot;>&lt;tns:REGOLATORIO>&lt;tns:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($Start/tns1:BPMRequest/tns1:NewBilling)>0 and ($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;xsd:string($Start/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and exists($Start/tns1:BPMRequest/tns1:Asset/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR'&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'WI'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE'&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&lt;/TIPO_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&lt;/CODE_CONTR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&lt;/CODE_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&lt;/CODE_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and string-length($Start/tns1:BPMRequest/tns1:Asset/CLLI)>0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_CLLI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/d