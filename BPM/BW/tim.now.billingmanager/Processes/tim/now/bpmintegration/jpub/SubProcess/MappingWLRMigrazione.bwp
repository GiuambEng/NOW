ESSAZIONE&amp;quot;&quot;>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Asset)&quot;>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($Start/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:CODE_COMUNE='6666'&quot;>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:CODE_COMUNE)=6&quot;>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns2:JDBCQueryResponse/tns2:REGOLATORIO/tns2:CODE_COMUNE&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(upper-case(nomeComponente),&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;CODE_ID_ULLCO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(upper-case(nomeComponente),&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&lt;/CODE_ID_ULLCO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ID_ULLCO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_ULLCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo) > 0&quot;>&lt;CODE_ID_ULLCO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo&quot;/>&lt;/CODE_ID_ULLCO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ID_ULLCO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_ULLCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&lt;CODE_DISTR>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($Start/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&lt;/CODE_DISTR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DISTR>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/CODE_DISTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_PERMUTA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA>&lt;FLAG_MIGRAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_MIGRAZIONE>&lt;FLAG_QUALIFICAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_QUALIFICAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;QUANTITA>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QUANTITA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor) > 0&quot;>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonor&quot;/>&lt;/CODE_DONOR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONOR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating) > 0&quot;>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOMDonating&quot;/>&lt;/CODE_DONATING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONATING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ID_SLUCO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_SLUCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='ATTIVAZIONE' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='U2'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo)>0&quot;>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='FLAGMANTENIMENTOSTS']/valoreAttributo&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;FLAG_LA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_LA>&lt;xsl:if test=&quot;tns5:TIPO_LINEA_NUM_AGG&quot;>&lt;TIPO_LINEA_NUM_AGG>&lt;xsl:value-of select=&quot;tns5:TIPO_LINEA_NUM_AGG&quot;/>&lt;/TIPO_LINEA_NUM_AGG>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&lt;CODE_HOSTING>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/CODE_HOSTING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_HOSTING>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_HOSTING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:Lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CodeSTS/tns3:CodeSTSOutput)>0 and  $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='1' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='U2' and $COD_CAUS/tns2:COD_CAUS_DESTINATARIO!='0Z'&quot;>&lt;xsl:for-each select=&quot;$CodeSTS/tns3:CodeSTSOutput&quot;>&lt;tns:STS>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/TIPO_AZIONE>&lt;FLAG_LINEA_NUM_AGG>&lt;xsl:value-of select=&quot;$FLAG_LINEA_NUM_AGG&quot;/>&lt;/FLAG_LINEA_NUM_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;$TIPO_LINEA_NUM_AGG='1' or $TIPO_LINEA_NUM_AGG='2'&quot;>&lt;ID_RIS_AGGIUNTIVA>&lt;xsl:value-of select=&quot;$NUMEROTELEFONICOAGGIUNTIVO&quot;/>&lt;/ID_RIS_AGGIUNTIVA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_AGGIUNTIVA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ID_RIS_AGGIUNTIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_STS>&lt;xsl:value-of select=&quot;tns3:AttributoOutput&quot;/>&lt;/CODE_STS>&lt;/tns:STS>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ACCESSO>&lt;/tns:TESTATA>&lt;/xsl:for-each>&lt;/tns:REGOLATORIO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
