                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CodiceSTS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;CodeSTS&quot;/>&#xa;    &lt;xsl:param name=&quot;Contrattopadre&quot;/>&#xa;    &lt;xsl:param name=&quot;Contract&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperWLRPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REGOLATORIO>&#xa;            &lt;tns:TESTATA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($Start/tns1:BPMRequest/tns1:NewBilling)>0 and ($Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $Start/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string($Start/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;concat($Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;DATA_MSG>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/DATA_MSG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and exists($Start/tns1:BPMRequest/tns1:Asset/DES)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), month-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), day-from-date($Start/tns1:BPMRequest/tns1:Asset/DES), 00,00,00)&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($Start/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($Start/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATA_DES>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_DES>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR'&quot;>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;'WI'&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$COD_CAUS/tns2:COD_CAUS_DESTINATARIO&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:ACCESSO>&#xa;                    &lt;TIPO_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;41&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_CONTR>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns2:REGOLATORIO/tns2:COD_CONTR&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and string-length($Start/tns1:BPMRequest/tns1:Asset/CLLI)>0&quot;>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo)>0&quot;>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE'  &quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo)>0&quot;>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODEPRESTAGG']/valoreAttributo&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR'&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Asset/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/ordine/numTelPrincipale)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='NPSUAGGWLR' and $Start/tns1:Lavorazione='CESSAZIONE' &quot;>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Contrattopadre/Record/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:Lavorazione='CESSAZIONE' and ($COD_CAUS/tns2:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns2:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazio