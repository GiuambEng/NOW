                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns1="http://www.tibco.com/JPUB_REG_internal_abstract/" xmlns:tns0="http://crmnow.ordineregolatorio.jpub/types/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="DynamicProcess"/&gt;
    &lt;xsl:template name="JPUBReg-input" match="/"&gt;
        &lt;ns1:OrdineRegolatorioCRMNOW_ricezione&gt;
            &lt;parameters&gt;
                &lt;tns0:ricezioneElement&gt;
                    &lt;tns0:ID_ORDINE_CRM&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS)"&gt;
                                &lt;xsl:value-of select="$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns0:ID_ORDINE_CRM&gt;
                    &lt;tns0:ORDINE&gt;
                        &lt;REGOLATORIO&gt;
                            &lt;xsl:for-each select="$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA"&gt;
                                &lt;TESTATA&gt;
                                    &lt;ID_ORD_CRMWS&gt;
                                        &lt;xsl:value-of select="ID_ORD_CRMWS"/&gt;
                                    &lt;/ID_ORD_CRMWS&gt;
                                    &lt;DATA_DRO&gt;
                                        &lt;xsl:value-of select="DATA_DRO"/&gt;
                                    &lt;/DATA_DRO&gt;
                                    &lt;DATA_MSG&gt;
                                        &lt;xsl:value-of select="DATA_MSG"/&gt;
                                    &lt;/DATA_MSG&gt;
                                    &lt;DATA_DES&gt;
                                        &lt;xsl:value-of select="DATA_DES"/&gt;
                                    &lt;/DATA_DES&gt;
                                    &lt;CODE_CAUS&gt;
                                        &lt;xsl:value-of select="CODE_CAUS"/&gt;
                                    &lt;/CODE_CAUS&gt;
                                    &lt;CODICE_ORDINE_ISP&gt;
                                        &lt;xsl:value-of select="CODICE_ORDINE_ISP"/&gt;
                                    &lt;/CODICE_ORDINE_ISP&gt;
                                    &lt;CODICE_PROGETTO&gt;
                                        &lt;xsl:value-of select="CODICE_PROGETTO"/&gt;
                                    &lt;/CODICE_PROGETTO&gt;
                                    &lt;xsl:for-each select="ns2:ACCESSO"&gt;
                                        &lt;ACCESSO&gt;
                                            &lt;TIPO_CONTR&gt;
                                                &lt;xsl:value-of select="TIPO_CONTR"/&gt;
                                            &lt;/TIPO_CONTR&gt;
                                            &lt;CODE_CONTR&gt;
                                                &lt;xsl:value-of select="CODE_CONTR"/&gt;
                                            &lt;/CODE_CONTR&gt;
                                            &lt;CODE_CLLI&gt;
                                                &lt;xsl:value-of select="CODE_CLLI"/&gt;
                                            &lt;/CODE_CLLI&gt;
                                            &lt;CODE_PREST_AGG&gt;
                                                &lt;xsl:value-of select="CODE_PREST_AGG"/&gt;
                                            &lt;/CODE_PREST_AGG&gt;
                                            &lt;ID_RIS&gt;
                                                &lt;xsl:value-of select="ID_RIS"/&gt;
                                            &lt;/ID_RIS&gt;
                                            &lt;ID_RIS_PRINC&gt;
                                                &lt;xsl:value-of select="ID_RIS_PRINC"/&gt;
                                            &lt;/ID_RIS_PRINC&gt;
                                            &lt;CODE_GEST_REC&gt;
                                                &lt;xsl:value-of select="CODE_GEST_REC"/&gt;
                                            &lt;/CODE_GEST_REC&gt;
                                            &lt;TIPO_FAMIGLIA&gt;
                                                &lt;xsl:value-of select="TIPO_FAMIGLIA"/&gt;
                                            &lt;/TIPO_FAMIGLIA&gt;
                                            &lt;OPZ_COMM&gt;
                                                &lt;xsl:value-of select="OPZ_COMM"/&gt;
                                            &lt;/OPZ_COMM&gt;
                                            &lt;TIPO_LINEA&gt;
                                                &lt;xsl:value-of select="TIPO_LINEA"/&gt;
                                            &lt;/TIPO_LINEA&gt;
                                            &lt;FLAG_NP&gt;
                                                &lt;xsl:value-of select="FLAG_NP"/&gt;
                                            &lt;/FLAG_NP&gt;
                                            &lt;SUB_TIPO_LINEA&gt;
                                                &lt;xsl:value-of select="SUB_TIPO_LINEA"/&gt;
                                            &lt;/SUB_TIPO_LINEA&gt;
                                            &lt;SUB_TIPO_LINEA_RESIDENZIALE&gt;
                                                &lt;xsl:value-of select="SUB_TIPO_LINEA_RESIDENZIALE"/&gt;
                                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE&gt;
                                            &lt;SUB_TIPO_LINEA_DIREZIONE&gt;
                                                &lt;xsl:value-of select="SUB_TIPO_LINEA_DIREZIONE"/&gt;
                                            &lt;/SUB_TIPO_LINEA_DIREZIONE&gt;
                                            &lt;MOD_VENDITA_ACCESSO&gt;
                                                &lt;xsl:value-of select="MOD_VENDITA_ACCESSO"/&gt;
                                            &lt;/MOD_VENDITA_ACCESSO&gt;
                                            &lt;TIPO_AZIONE&gt;
                                                &lt;xsl:value-of select="TIPO_AZIONE"/&gt;
                                            &lt;/TIPO_AZIONE&gt;
                                            &lt;DATA_INIZIO_NOL&gt;
                                                &lt;xsl:value-of select="DATA_INIZIO_NOL"/&gt;
                                            &lt;/DATA_INIZIO_NOL&gt;
                                            &lt;CODE_COMUNE&gt;
                                                &lt;xsl:value-of select="CODE_COMUNE"/&gt;
                                            &lt;/CODE_COMUNE&gt;
                                            &lt;CODE_ID_ULLCO&gt;
                                                &lt;xsl:value-of select="CODE_ID_ULLCO"/&gt;
                                            &lt;/CODE_ID_ULLCO&gt;
                                            &lt;CODE_DISTR&gt;
                                                &lt;xsl:value-of select="CODE_DISTR"/&gt;
                                            &lt;/CODE_DISTR&gt;
                                            &lt;FLAG_PERMUTA&gt;
                                                &lt;xsl:value-of select="FLAG_PERMUTA"/&gt;
                                            &lt;/FLAG_PERMUTA&gt;
                                            &lt;FLAG_MIGRAZIONE&gt;
                                                &lt;xsl:value-of select="FLAG_MIGRAZIONE"/&gt;
                                            &lt;/FLAG_MIGRAZIONE&gt;
                                            &lt;FLAG_QUALIFICAZIONE&gt;
                                                &lt;xsl:value-of select="FLAG_QUALIFICAZIONE"/&gt;
                                            &lt;/FLAG_QUALIFICAZIONE&gt;
                                            &lt;ID_RIS_OLD&gt;
                                                &lt;xsl:value-of select="ID_RIS_OLD"/&gt;
                                            &lt;/ID_RIS_OLD&gt;
                                            &lt;CODICE_QUALITA&gt;
                                                &lt;xsl:value-of select="CODICE_QUALITA"/&gt;
                                            &lt;/CODICE_QUALITA&gt;
                                            &lt;CODICE_DELIVERY&gt;
                                                &lt;xsl:value-of select="CODICE_DELIVERY"/&gt;
                                            &lt;/CODICE_DELIVERY&gt;
                                            &lt;CAMPO_SERV_IT&gt;
                                                &lt;xsl:value-of select="CAMPO_SERV_IT"/&gt;
                                            &lt;/CAMPO_SERV_IT&gt;
                                            &lt;QUANTITA&gt;
                                                &lt;xsl:value-of select="QUANTITA"/&gt;
                                            &lt;/QUANTITA&gt;
                                            &lt;CODE_DONOR&gt;
                                                &lt;xsl:value-of select="CODE_DONOR"/&gt;
                                            &lt;/CODE_DONOR&gt;
                                            &lt;CODE_DONATING&gt;
                                                &lt;xsl:value-of select="CODE_DONATING"/&gt;
                                            &lt;/CODE_DONATING&gt;
                                            &lt;xsl:if test="CODE_ID_SLUCO"&gt;
                                                &lt;CODE_ID_SLUCO&gt;
                                                    &lt;xsl:value-of select="CODE_ID_SLUCO"/&gt;
                                                &lt;/CODE_ID_SLUCO&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;FLAG_MANTENIMENTO_STS&gt;
                                                &lt;xsl:value-of select="FLAG_MANTENIMENTO_STS"/&gt;
                                            &lt;/FLAG_MANTENIMENTO_STS&gt;
                                            &lt;xsl:if test="FLAG_PERMUTA_ARMADIO"&gt;
                                                &lt;FLAG_PERMUTA_ARMADIO&gt;
                                                    &lt;xsl:value-of select="FLAG_PERMUTA_ARMADIO"/&gt;
                                                &lt;/FLAG_PERMUTA_ARMADIO&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="TIPO_CESSAZIONE"&gt;
                                                &lt;TIPO_CESSAZIONE&gt;
                                                    &lt;xsl:value-of select="TIPO_CESSAZIONE"/&gt;
                                                &lt;/TIPO_CESSAZIONE&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="FLAG_NP_SUCCESSIVA_PURA"&gt;
                                                &lt;FLAG_NP_SUCCESSIVA_PURA&gt;
                                                    &lt;xsl:value-of select="FLAG_NP_SUCCESSIVA_PURA"/&gt;
                                                &lt;/FLAG_NP_SUCCESSIVA_PURA&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;FLAG_LA&gt;
                                                &lt;xsl:value-of select="FLAG_LA"/&gt;
                                            &lt;/FLAG_LA&gt;
                                            &lt;xsl:if test="TIPO_LINEA_NUM_AGG"&gt;
                                                &lt;TIPO_LINEA_NUM_AGG&gt;
                                                    &lt;xsl:value-of select="TIPO_LINEA_NUM_AGG"/&gt;
                                                &lt;/TIPO_LINEA_NUM_AGG&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:for-each select="ns2:AGG"&gt;
                                                &lt;AGG&gt;
                                                    &lt;AGGIUNTIVO&gt;
                                                        &lt;xsl:value-of select="AGGIUNTIVO"/&gt;
                                                    &lt;/AGGIUNTIVO&gt;
                                                &lt;/AGG&gt;
                                            &lt;/xsl:for-each&gt;
                                            &lt;xsl:for-each select="ns2:STS"&gt;
                                                &lt;STS&gt;
                                                    &lt;TIPO_AZIONE&gt;
                                                        &lt;xsl:value-of select="TIPO_AZIONE"/&gt;
                                                    &lt;/TIPO_AZIONE&gt;
                                                    &lt;FLAG_LINEA_NUM_AGG&gt;
                                                        &lt;xsl:value-of select="FLAG_LINEA_NUM_AGG"/&gt;
                                                    &lt;/FLAG_LINEA_NUM_AGG&gt;
                                                    &lt;ID_RIS_AGGIUNTIVA&gt;
                                                        &lt;xsl:value-of select="ID_RIS_AGGIUNTIVA"/&gt;
                                                    &lt;/ID_RIS_AGGIUNTIVA&gt;
                                                    &lt;CODE_STS&gt;
                                                        &lt;xsl:value-of select="CODE_STS"/&gt;
                                                    &lt;/CODE_STS&gt;
                                                &lt;/STS&gt;
                                            &lt;/xsl:for-each&gt;
                                        &lt;/ACCESSO&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/TESTATA&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/REGOLATORIO&gt;
                    &lt;/tns0:ORDINE&gt;
                &lt;/tns0:ricezioneElement&gt;
            &lt;/parameters&gt;
        &lt;/ns1:OrdineRegolatorioCRMNOW_ricezione&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;JPUBReg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_ORDINE_CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns0:ID_ORDINE_CRM>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA&quot;>&#xa;                        &lt;TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                            &lt;xsl:for-each select=&quot;ns2:ACCESSO&quot;>&#xa;                                &lt;ACCESSO>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_PREST_AGG&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;ID_RIS&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                    &lt;ID_RIS_PRINC>&#xa;                                        &lt;xsl:value-of select=&quot;ID_RIS_PRINC&quot;/>&#xa;                                    &lt;/ID_RIS_PRINC>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_GEST_REC&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                    &lt;OPZ_COMM>&#xa;                                        &lt;xsl:value-of select=&quot;OPZ_COMM&quot;/>&#xa;                                    &lt;/OPZ_COMM>&#xa;                                    &lt;TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                                    &lt;/TIPO_LINEA>&#xa;                                    &lt;FLAG_NP>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_NP&quot;/>&#xa;                                    &lt;/FLAG_NP>&#xa;                                    &lt;SUB_TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA>&#xa;                                    &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                        &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                    &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                                    &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_COMUNE&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                    &lt;CODE_ID_ULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_ID_ULLCO&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DISTR&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                    &lt;FLAG_PERMUTA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                                    &lt;/FLAG_PERMUTA>&#xa;                                    &lt;FLAG_MIGRAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                                    &lt;/FLAG_MIGRAZIONE>&#xa;                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;ID_RIS_OLD&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                    &lt;QUANTITA>&#xa;                                        &lt;xsl:value-of select=&quot;QUANTITA&quot;/>&#xa;                                    &lt;/QUANTITA>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONOR&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONATING&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                    &lt;xsl:if test=&quot;CODE_ID_SLUCO&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_ID_SLUCO&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                        &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                        &lt;TIPO_CESSAZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                        &lt;/TIPO_CESSAZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                    &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                        &lt;TIPO_LINEA_NUM_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                        &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;ns2:AGG&quot;>&#xa;                                        &lt;AGG>&#xa;                                            &lt;AGGIUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                            &lt;/AGGIUNTIVO>&#xa;                                        &lt;/AGG>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;ns2:STS&quot;>&#xa;                                        &lt;STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ACCESSO>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/REGOLATORIO>&#xa;            &lt;/tns0:ORDINE>&#xa;        &lt;/tns0:ricezioneElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
