                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponseError-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ErrorJPUBXDSL/Output/tns4:ErrorOutput/tns4:ErrorO/tns4:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:ErrorO/tns4:TRANSACTION_ID='Null'&quot;>&#xa;                &lt;tns2:SendJPUBResponse>&#xa;                    &lt;tns2:code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns2:code>&#xa;                    &lt;tns2:msg>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns2:msg>&#xa;                    &lt;xsl:if test=&quot;exists($ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:NumeriAggiuntivi)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:NumeriAggiuntivi&quot;>&#xa;                            &lt;tns2:Response_Aggiuntivi>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;tns4:code&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                                &lt;tns2:msg>&#xa;                                    &lt;xsl:value-of select=&quot;tns4:msg&quot;/>&#xa;                                &lt;/tns2:msg>&#xa;                                &lt;tns2:Identificativo>&#xa;                                    &lt;xsl:value-of select=&quot;tns4:identificativo&quot;/>&#xa;                                &lt;/tns2:Identificativo>&#xa;                            &lt;/tns2:Response_Aggiuntivi>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;(string-length($InvokeJPUB_WLR/tns2:IDRichOLO)>0 and  $InvokeJPUB_WLR/tns2:IDRichOLO='XX') or (string-length($ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:ErrorO/tns4:RETURN_CODE)>0)&quot;>&#xa;                        &lt;tns2:IDRichOLO>&#xa;                            &lt;xsl:value-of select=&quot;'STS'&quot;/>&#xa;                        &lt;/tns2:IDRichOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:Control>&#xa;                        &lt;xsl:value-of select=&quot;'Aggiornamento eseguito'&quot;/>&#xa;                    &lt;/tns2:Control>&#xa;                &lt;/tns2:SendJPUBResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:SendJPUBResponse>&#xa;                    &lt;tns2:code>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns2:code>&#xa;                    &lt;tns2:msg>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns2:msg>&#xa;                    &lt;xsl:if test=&quot;exists($ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:NumeriAggiuntivi)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ErrorJPUBREG/Output/tns4:ErrorOutput/tns4:NumeriAggiuntivi&quot;>&#xa;                            &lt;tns2:Response_Aggiuntivi>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;tns4:code&quo