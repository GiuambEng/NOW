                                        &lt;codiceSLAAssurance&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceSLAAssurance"/&gt;
                                        &lt;/codiceSLAAssurance&gt;
                                    &lt;/xsl:if&gt;
