                                    portType="ns14:ErrorSchemaPortType" tibex:xpdlId="1863dbb0-a54f-4c85-91c2-88f0f7d3a014">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" version="2.0"&gt;
    &lt;xsl:param name="DynamicProcess"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:template name="ErrorJPUBXDSL-input" match="/"&gt;
        &lt;tns4:ErrorSchemaRequest&gt;
            &lt;Input&gt;
                &lt;tns5:ErrorInput&gt;
                    &lt;tns5:ORDINE&gt;
                        &lt;xsl:copy-of select="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS"/&gt;
                    &lt;/tns5:ORDINE&gt;
                    &lt;tns5:ID_RICH_OLO&gt;
                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                    &lt;/tns5:ID_RICH_OLO&gt;
                &lt;/tns5:ErrorInput&gt;
            &lt;/Input&gt;
        &lt;/tns4:ErrorSchemaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorJPUBXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ErrorInput>&#xa;            &lt;tns5:ORDINE>&#xa;                &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS&quot;/>&#xa;            &lt;/tns5:ORDINE>&#xa;            &lt;tns5:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns5:ID_RICH_OLO>&#xa;        &lt;/tns5:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
