                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStagingJPUB_OUT&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUBNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ErrorInput>&#xa;            &lt;tns4:ORDINE>&#xa;                &lt;ns2:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                &lt;/ns2:REGOLATORIO>&#xa;            &lt;/tns4:ORDINE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true() or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                    &lt;tns4:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                &lt;tns4:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns4:ID_RICH_OLO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns4:COD_PROCSO_NOFILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns4:COD_PROCSO_NOFILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEReg&quot;/>&#xa;            &lt;/tns4:ID_ESEC_PROCSO_NOFILE>&#xa;            &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns4:STATO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingJPUB_