                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBNP&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperResponseError&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:Stato='IN_INVIO' or $StartSubProcessMigrazione.parameters/tns1:StatoFatturazioneMigrazione[number($index)]/tns1:StatoFatturazione='IN_INVIO'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ControlloResponse='True'&quot;>&#xa;                        &lt;tns2:SendJPUBResponse>&#xa;                            &lt;tns2:code>&#xa;                                &lt;xsl:value-of select=&quot;$MapperResponseError/tns2:code&quot;/>&#xa;                            &lt;/tns2:code>&#xa;                            &lt;tns2:msg>&#xa;                                &lt;xsl:value-of select=&quot;$MapperResponseError/tns2:msg&quot;/>&#xa;                            &lt;/tns2:msg>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD)>0 or string-length($StartSubProcessMigrazione.parameters/tns1:TBUNDLE)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TBUNDLE='ATTIVAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;>&#xa;                                                        &lt;tns2:IDRisorsa>&#xa;                                                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                                        &lt;/tns2:IDRisorsa>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns2:IDRisorsa>&#xa;                                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                                    &lt;/tns2:IDRisorsa>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;>&#xa;                                                        &lt;tns2:IDRisorsa>&#xa;                                                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;/>&#xa;                                                        &lt;/tns2:IDRisorsa>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns2:IDRisorsa>&#xa;                                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                                    &lt;/tns2:IDRisorsa>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;>&#xa;                                                &lt;tns2:IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                                &lt;/tns2:IDRisorsa>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns2:IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns2:IDRisorsa>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;>&#xa;                                                &lt;tns2:IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                                &lt;/tns2:IDRisorsa>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns2:IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns2:IDRisorsa>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;>&#xa;                                                &lt;tns2:IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;/>&#xa;                                                &lt;/tns2:IDRisorsa>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns2:IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns2:IDRisorsa>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MapperResponseError/tns2:IDRichOLO)>0   and $MapperResponseError/tns2:IDRichOLO='STS'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MapperResponseError/tns2:IDRichOLO&quot;>&#xa;                                        &lt;tns2:IDRichOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$MapperResponseError/tns2:IDRichOLO&quot;/>&#xa;                                        &lt;/tns2:IDRichOLO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDRichOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns2:IDRichOLO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:IDDETTAGLIOORDINE)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;>&#xa;                                        &lt;tns2:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;/>&#xa;                                        &lt;/tns2:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                                    &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                                    &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns2:SendJPUBResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:SendJPUBResponse>&#xa;                            &lt;tns2:code>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns2:code>&#xa;                            &lt;tns2:msg>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns2:msg>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($InvokeJPUB_WLR/tns2:Response_Aggiuntivi)&quot;>&#xa;                                    &lt;xsl:for-each select=&quot;$InvokeJPUB_WLR/tns2:Response_Aggiuntivi&quot;>&#xa;                                        &lt;tns2:Response_Aggiuntivi>&#xa;                                            &lt;tns2:code>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:code&quot;/>&#xa;                                            &lt;/tns2:code>&#xa;                                            &lt;tns2:msg>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:msg&quot;/>&#xa;                                            &lt;/tns2:msg>&#xa;                                            &lt;tns2:Identificativo>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:Identificativo&quot;/>&#xa;                                            &lt;/tns2:Identificativo>&#xa;                                        &lt;/tns2:Response_Aggiuntivi>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($InvokeJPUBNP/tns2:Response_Aggiuntivi)&quot;>&#xa;                                    &lt;xsl:for-each select=&quot;$InvokeJPUBNP/tns2:Response_Aggiuntivi&quot;>&#xa;                                        &lt;tns2:Response_Aggiuntivi>&#xa;                                            &lt;tns2:code>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:code&quot;/>&#xa;                                            &lt;/tns2:code>&#xa;                                            &lt;tns2:msg>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:msg&quot;/>&#xa;                                            &lt;/tns2:msg>&#xa;                                            &lt;tns2:Identificativo>&#xa;                                                &lt;xsl:value-of select=&quot;tns2:Identificativo&quot;/>&#xa;                                            &lt;/tns2:Identificativo>&#xa;                                        &lt;/tns2:Response_Aggiuntivi>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns2:IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RISORSA&quot;/>&#xa;                            &lt;/tns2:IDRisorsa>&#xa;                            &lt;tns2:IDRichOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:IDRichOLO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:IDDETTAGLIOORDINE)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;>&#xa;                                        &lt;tns2:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;/>&#xa;                                        &lt;/tns2:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                                    &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                                    &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns2:SendJPUBResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:SendJPUBResponse>&#xa;                    &lt;tns2:code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&#xa;                    &lt;/tns2:code>&#xa;                    &lt;tns2:msg>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&#xa;                    &lt;/tns2:msg>&#xa;                    &lt;tns2:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RISORSA&quot;/>&#xa;                    &lt;/tns2:IDRisorsa>&#xa;                    &lt;tns2:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns2:IDRichOLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:IDDETTAGLIOORDINE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;>&#xa;                                &lt;tns2:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;/>&#xa;                                &lt;/tns2:IDDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&#xa;                            &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and upper-case($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y'&quot;>&#xa;                        &lt;tns2:Parking>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns2:Parking>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;(string-length($StartSubProcessMigrazione.parameters/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($StartSubProcessMigrazione.parameters/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($StartSubProcessMigrazione.parameters/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0) and ($StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='FULLGPON1BPNRR' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='SEMIGPON1BPNRR' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='UBBSEMIGPON' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='VULAFTTH' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='SEMIVULAFTTH'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='BITSTREAMNGAFTTH' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='BITSTREAMGBESIMMETRICOFLAT'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='BITSTREAMGBESIMMETRICO' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPNGAFTTH'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPBASEPLUSFLAT' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPBASEPLUSLITE' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPSPECIALPROFILEFLAT' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPSPECIALPROFILELITE' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='FULLGPONPLUSNGA' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='FULLGPONPLUS' or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='UBBFULLGPON'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='BITSTREAMNGAFTTCAB'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='EASYIPNGAFTTCAB'or $StartSubProcessMigrazione.parameters/tns1:Asset[$index]/offerta='VULAFTTCAB')&quot;>&#xa;                        &lt;tns2:ParkingInvioDRO>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns2:ParkingInvioDRO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:SendJPUBResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:InvioJPUB="http://www.tim.com/NOW/xsd/InvioJPUB/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="InvioJPUB:SendJPUBResponse" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InsertStagingJPUB_OUT-input"
                                name="InsertStagingJPUB_OUT"
                                operation="InsertUpdateStaging"
                                outputVariable="InsertStagingJPUB_OUT"
                                partnerLink="InsertUpdateStagingPortType"
                                portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="a6dcb09b-45ad-4484-b51e-6d66a3ca07ba">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="DynamicProcess"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazione"/&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEReg"/&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEXDSL"/&gt;
    &lt;xsl:template name="InsertStagingJPUB_OUT-input" match="/"&gt;
        &lt;tns4:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO, true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:MappingNGA_XDSLResponse)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS,true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                        &lt;tns5:CONTENUTO_REQUEST&gt;
                                            &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO,true(), true())"/&gt;
                                        &lt;/tns5:CONTENUTO_REQUEST&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns5:CONTENUTO_REQUEST&gt;
                                            &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:WLR/tns:AGGIUNTIVI,true(), true())"/&gt;
                                        &lt;/tns5:CONTENUTO_REQUEST&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:MappingNGA_XDSLResponse)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:ID_RICH&gt;
                            &lt;xsl:value-of select="tib:timestamp()"/&gt;
                        &lt;/tns5:ID_RICH&gt;
                        &lt;tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                        &lt;tns5:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RICH&gt;
                        &lt;tns5:OPERATORE&gt;
                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/operatore"/&gt;
                        &lt;/tns5:OPERATORE&gt;
                        &lt;tns5:COD_ID_ORDN&gt;
                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                        &lt;/tns5:COD_ID_ORDN&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR"&gt;
                                    &lt;tns5:COD_CONTRATTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR"/&gt;
                                    &lt;/tns5:COD_CONTRATTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"&gt;
                                    &lt;tns5:COD_CONTRATTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"/&gt;
                                    &lt;/tns5:COD_CONTRATTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:NP)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"&gt;
                                    &lt;tns5:COD_CONTRATTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"/&gt;
                                    &lt;/tns5:COD_CONTRATTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"&gt;
                                    &lt;tns5:COD_CONTRATTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR"/&gt;
                                    &lt;/tns5:COD_CONTRATTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:WLR)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"&gt;
                                            &lt;tns5:COD_GESTORE&gt;
                                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"/&gt;
                                            &lt;/tns5:COD_GESTORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"&gt;
                                            &lt;tns5:COD_GESTORE&gt;
                                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"/&gt;
                                            &lt;/tns5:COD_GESTORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD)&gt;0 or string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE)&gt;0"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE='ATTIVAZIONE'"&gt;
                                        &lt;tns5:COD_GESTORE&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/codificaOLOAGCOM"/&gt;
                                        &lt;/tns5:COD_GESTORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"&gt;
                                            &lt;tns5:COD_GESTORE&gt;
                                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"/&gt;
                                            &lt;/tns5:COD_GESTORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()"&gt;
                                &lt;tns5:COD_GESTORE&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/codificaOLOAGCOM"/&gt;
                                &lt;/tns5:COD_GESTORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()"&gt;
                                &lt;tns5:COD_GESTORE&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/codificaOLOAGCOM"/&gt;
                                &lt;/tns5:COD_GESTORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"&gt;
                                    &lt;tns5:COD_GESTORE&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"/&gt;
                                    &lt;/tns5:COD_GESTORE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                            &lt;xsl:value-of select="$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                        &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                    &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                    &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:MappingNGA_XDSLResponse)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                    &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                    &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                    &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                    &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                    &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                    &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:FLAG_CONSUNTIVO&gt;
                            &lt;xsl:value-of select="'0'"/&gt;
                        &lt;/tns5:FLAG_CONSUNTIVO&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="(string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD)&gt;0 and ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione!='ATTIVAZIONE' and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/tipologiaSottolav!='CAMBIOTECNOLOGIA')) or string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE)&gt;0"&gt;
                                    &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                                    &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="($StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true() and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione='ATTIVAZIONE')"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEANONATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEANONATTIVA'or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='NP'or &amp;#xD;&amp;#xA;(upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEAATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEAATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEAATTIVANP' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEAATTIVANP') &amp;#xD;&amp;#xA;or (upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLRLINEAATTIVA' or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLR'&amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLRLINEANONATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VARIAZIONEWLR' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')&amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEANONATTIVA'or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEAATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta,'SHA')"&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEXDSL"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEANONATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEANONATTIVA'or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='NP'or &amp;#xD;&amp;#xA;(upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEAATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEAATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLDATILINEAATTIVANP' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='ULLLINEAATTIVANP') &amp;#xD;&amp;#xA;or (upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLRLINEAATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLRLINEANONATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='WLRL' or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VARIAZIONEWLR' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' &amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')&amp;#xD;&amp;#xA;or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEANONATTIVA'or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEAATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VULL'   or&amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta)='VULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;starts-with($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta,'SHA')"&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEXDSL"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='VULLLINEANONATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLLINEANONATTIVA' or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLDATILINEANONATTIVA'or &amp;#xD;&amp;#xA;(upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLLINEAATTIVA' or &amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLDATILINEAATTIVANP'&amp;#xD;&amp;#xA; or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='ULLLINEAATTIVANP') &amp;#xD;&amp;#xA; or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='WLRLINEAATTIVA' or &amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='VARIAZIONEWLR' or  upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='WLR' or&amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEAATTIVA' &amp;#xD;&amp;#xA; or upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEANONATTIVA'or &amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='SLULINEANONATTIVA'or &amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='SLULINEAATTIVA' or &amp;#xD;&amp;#xA; upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='SLULINEAATTIVANP'  or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='VULL' or&amp;#xD;&amp;#xA;starts-with($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta,'SHA') or &amp;#xD;&amp;#xA;upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta)='NP'"&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEXDSL"/&gt;
                                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns4:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagingJPUB_OUT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO, true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS,true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)&quot;>&#xa;                                &lt;tns5:CONTENUTO_REQUEST>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO,true(), true())&quot;/>&#xa;                                &lt;/tns5:CONTENUTO_REQUEST>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:CONTENUTO_REQUEST>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:WLR/tns:AGGIUNTIVI,true(), true())&quot;/>&#xa;                                &lt;/tns5:CONTENUTO_REQUEST>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;                &lt;/tns5:ID_RICH>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RICH>&#xa;                &lt;tns5:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/operatore&quot;/>&#xa;                &lt;/tns5:OPERATORE>&#xa;                &lt;tns5:COD_ID_ORDN>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:COD_ID_ORDN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                            &lt;tns5:COD_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                            &lt;/tns5:COD_CONTRATTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                            &lt;tns5:COD_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                            &lt;/tns5:COD_CONTRATTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                            &lt;tns5:COD_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                            &lt;/tns5:COD_CONTRATTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                            &lt;tns5:COD_CONTRATTO>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA/ns1:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                            &lt;/tns5:COD_CONTRATTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)&quot;>&#xa;                                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;>&#xa;                                    &lt;tns5:COD_GESTORE>&#xa;                                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;/>&#xa;                                    &lt;/tns5:COD_GESTORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;>&#xa;                                    &lt;tns5:COD_GESTORE>&#xa;                                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;/>&#xa;                                    &lt;/tns5:COD_GESTORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD)>0 or string-length($StartSubProcessMigrazione.parameters/tns1:TBUNDLE)>0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TBUNDLE='ATTIVAZIONE'&quot;>&#xa;                                &lt;tns5:COD_GESTORE>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/tns5:COD_GESTORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;>&#xa;                                    &lt;tns5:COD_GESTORE>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/tns5:COD_GESTORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                        &lt;tns5:COD_GESTORE>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns5:COD_GESTORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                        &lt;tns5:COD_GESTORE>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns5:COD_GESTORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;>&#xa;                            &lt;tns5:COD_GESTORE>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/tns5:COD_GESTORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:valu