                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns5=&quot;http://schemas.tibco.com/bw/plugins/jdbc/5.0/jdbcExceptions&quot; xmlns:tns6=&quot;http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_UpdateDA_INVIARE_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEDaInviareRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_UPDATEDaInviareRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_JDBCUpdate1&quot;/>&#xa;    &lt;xsl:template name=&quot;FaultUpdateDA_INVIARE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_JDBCUpdate1)&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat($_error_JDBCUpdate1/tns5:JDBCConnectionNotFoundException/msg, $_error_JDBCUpdate1/tns5:JDBCConnectionNotFoundException/msgCode,$_error_JDBCUpdate1/tns5:JDBCConnectionNotFoundException/jdbcConnection,$_error_JDBCUpdate1/tns5:InvalidTimeZoneException/msg,$_error_JDBCUpdate1/tns5:InvalidTimeZoneException/msgCode,$_error_JDBCUpdate1/tns5:JDBCSQLException/msg,$_error_JDBCUpdate1/tns5:JDBCSQLException/msgCode,$_error_JDBCUpdate1/tns5:LoginTimedOutException/msg,$_error_JDBCUpdate1/tns5:LoginTimedOutException/msgCode,$_error_JDBCUpdate1/tns5:InvalidSQLTypeException/msg,$_error_JDBCUpdate1/tns5:InvalidSQLTypeException/msgCode,$_error_JDBCUpdate1/tns6:ActivityTimedOutException/msg,$_error_JDBCUpdate1/tns6:ActivityTimedOutException/msgCode)&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEDaInviareRegolatorio)&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($_error_UPDATEDaInviareRegolatorio, true(), true())&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($_error_UpdateDA_INVIARE_XDSL, true(), true())&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;  