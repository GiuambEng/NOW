                            <bpws:invoke inputVariable="Invoke-input"
                                name="Invoke"
                                operation="InsertUpdateStaging"
                                outputVariable="Invoke"
                                partnerLink="InsertUpdateStagingPortType"
                                portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="4b33e201-63a0-4ddb-835e-2cc0db555fb9">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="DynamicProcess"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazione"/&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEReg"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns4:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;tns5:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO, true(), true())"/&gt;
                        &lt;/tns5:CONTENUTO_REQUEST&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)"&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS"&gt;
                                    &lt;tns5:ID_RISORSA&gt;
                                        &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/tns5:ID_RISORSA&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:ID_RICH&gt;
                            &lt;xsl:value-of select="tib:timestamp()"/&gt;
                        &lt;/tns5:ID_RICH&gt;
                        &lt;tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                        &lt;tns5:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RICH&gt;
                        &lt;tns5:OPERATORE&gt;
                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/operatore"/&gt;
                        &lt;/tns5:OPERATORE&gt;
                        &lt;tns5:COD_ID_ORDN&gt;
                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                        &lt;/tns5:COD_ID_ORDN&gt;
                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_CONTR"&gt;
                            &lt;tns5:COD_CONTRATTO&gt;
                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_CONTR"/&gt;
                            &lt;/tns5:COD_CONTRATTO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($DynamicProcess/tns:WLR)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)"&gt;
                                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"&gt;
                                            &lt;tns5:COD_GESTORE&gt;
                                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"/&gt;
                                            &lt;/tns5:COD_GESTORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"&gt;
                                            &lt;tns5:COD_GESTORE&gt;
                                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC"/&gt;
                                            &lt;/tns5:COD_GESTORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()"&gt;
                                &lt;tns5:COD_GESTORE&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/codificaOLOAGCOM"/&gt;
                                &lt;/tns5:COD_GESTORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"&gt;
                                    &lt;tns5:COD_GESTORE&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/codificaOLOAGCOM"/&gt;
                                    &lt;/tns5:COD_GESTORE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$UPDATEGestioneFatturazione/tns:IDEventoSTS"&gt;
                            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;xsl:value-of select="$UPDATEGestioneFatturazione/tns:IDEventoSTS"/&gt;
                            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"&gt;
                            &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;xsl:value-of select="$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                            &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns5:FLAG_CONSUNTIVO&gt;
                            &lt;xsl:value-of select="'0'"/&gt;
                        &lt;/tns5:FLAG_CONSUNTIVO&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns4:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;tns5:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO, true(), true())&quot;/>&#xa;                &lt;/tns5:CONTENUTO_REQUEST>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;                &lt;/tns5:ID_RICH>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RICH>&#xa;                &lt;tns5:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/operatore&quot;/>&#xa;                &lt;/tns5:OPERATORE>&#xa;                &lt;tns5:COD_ID_ORDN>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:COD_ID_ORDN>&#xa;                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                    &lt;tns5:COD_CONTRATTO>&#xa;                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                    &lt;/tns5:COD_CONTRATTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO)&quot;>&#xa;                                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;>&#xa;                                    &lt;tns5:COD_GESTORE>&#xa;                                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;/>&#xa;                                    &lt;/tns5:COD_GESTORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;>&#xa;                                    &lt;tns5:COD_GESTORE>&#xa;                                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO[1]/ns1:TESTATA[1]/ns1:ACCESSO[1]/CODE_GEST_REC&quot;/>&#xa;                                    &lt;/tns5:COD_GESTORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                        &lt;tns5:COD_GESTORE>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns5:COD_GESTORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;>&#xa;                            &lt;tns5:COD_GESTORE>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/tns5:COD_GESTORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:IDEventoSTS&quot;>&#xa;                    &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:IDEventoSTS&quot;/>&#xa;                    &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                    &lt;tns5:ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/tns5:ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                &lt;/tns5:FLAG_CONSUNTIVO>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEReg&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="LogInsertStagingJPUB_OUTToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToScope"/>
                                    <bpws:source
                                    linkName="InvokeToCallProcess"
                                    tibex:faultDetailsVar="Invoke" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultInsertStaging per STS',$_error/StackTrace,$_error/Msg,$_error/FullClass,$_error/Class,$_error/ProcessStack,$_error/MsgCode)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcess-input"
                                    name="CallProcess"
                                    tibex:xpdlId="258279d6-1969-4079-b990-c4fc62a50e13"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultInsertStaging per STS',$_error/StackTrace,$_error/Msg,$_error/FullClass,$_error/Class,$_error/ProcessStack,$_error/MsgCode)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCUpdate-input"
                                    name="JDBCUpdate"
                                    outputVariable="JDBCUpdate"
                                    tibex:xpdlId="fd6378e3-d0df-480d-8a54-e2c255bea1d7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToJDBCUpdate"/>
                                    <bpws:target linkName="LogFaultInsertStagingJPUB_OUTToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToControlloInsert"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fd6378e3-d0df-480d-8a54-e2c255bea1d7+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RICH_OLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:IDEventoSTS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:IDEventoSTS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="Property"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xa;WHERE ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricizzazioneEventi/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;StoricizzazioneEventi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                    &lt;ns:ORDINI_CRMWS>&#xa;                        &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA&quot;/>&#xa;                    &lt;/ns:ORDINI_CRMWS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns4:IDRichiestaOLO>&#xa;            &lt;xsl:for-each select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                &lt;tns4:ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:if test=&quot;tns1:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                        &lt;tns4:ID_RECUPERO_JPUB_MASTER>&#xa;                            &lt;xsl:value-of select=&quot;tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/tns4:ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:BDS_ID&quot;>&#xa;                        &lt;tns4:BDS_ID>&#xa;                            &lt;xsl:value-of select=&quot;tns1:BDS_ID&quot;/>&#xa;                        &lt;/tns4:BDS_ID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:ID_RECUPERO_JPUB_MASTER>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale)&quot;>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAsset&quot;>&#xa;                        &lt;tns4:IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAsset&quot;/>&#xa;                        &lt;/tns4:IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/IDAsset&quot;>&#xa;                        &lt;tns4:IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/IDAsset&quot;/>&#xa;                        &lt;/tns4:IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($DynamicProcess/tns:WLR/tns:STS)&quot;>&#xa;                &lt;tns4:STS>&#xa;                    &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:STS/ns1:REGOLATORIO&quot;/>&#xa;                &lt;/tns4:STS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
