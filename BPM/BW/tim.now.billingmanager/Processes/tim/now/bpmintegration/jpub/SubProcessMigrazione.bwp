                                    expression="$ControlloChiamataJpub='True' or $ControlloChiamataJpub='False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ControlloChiamataJpub='True' or $ControlloChiamataJpub='False']]></bpws:transitionCondition>
                                    </bpws:source>
