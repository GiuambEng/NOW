                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ErrorJPUBREG.Output/ns9:ErrorO/ns9:TRANSACTION_ID = "Null"]]></bpws:transitionCondition>
                                    </bpws:source>
