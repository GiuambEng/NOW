TORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE&quot;>&#xa;                        &lt;tns:TIPO_AZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE&quot;/>&#xa;                        &lt;/tns:TIPO_AZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:NP/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:NP/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;>&#xa;                        &lt;tns:CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/tns:CODE_CAUS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$StartSubProcessMigrazio