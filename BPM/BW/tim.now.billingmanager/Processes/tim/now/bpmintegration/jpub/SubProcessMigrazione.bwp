                                        &lt;/localita&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/numeroCivico"&gt;
                                        &lt;numeroCivico&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/numeroCivico"/&gt;
                                        &lt;/numeroCivico&gt;
