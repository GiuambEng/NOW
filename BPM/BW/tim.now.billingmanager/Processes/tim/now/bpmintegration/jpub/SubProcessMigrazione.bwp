                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateStagingOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultUpdateStagingOK',$_error/Msg, $_error/MsgCode,$_error/StackTrace,$_error/FullClass,$_error/ProcessStack,$_error/Class)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogFaultUpdateStagingOK-input"
                                    name="LogFaultUpdateStagingOK"
                                    tibex:xpdlId="0700aeb1-defe-47db-8d5a-4c33d3a97cd0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateStagingOKToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToControlloUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateStagingOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultUpdateStagingOK',$_error/Msg, $_error/MsgCode,$_error/StackTrace,$_error/FullClass,$_error/ProcessStack,$_error/Class)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="ControlloStaging" tibex:xpdlId="92025ac9-e970-40ec-81a4-a61bbd88b085">
                                <bpws:targets>
                                    <bpws:target linkName="logRisottomissioneToEmpty3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ControlloStagingToEmpty3">
