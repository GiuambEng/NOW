                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+18fc6711-e2e6-429f-98ee-eebf68860c23+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record&quot;>&#xa;                &lt;Record>&#xa;                    &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;                    &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_RICH_OLO&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>

                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="Property"
                                    sqlStatement="UPDATE EVENTO_JPUB&#xa;SET IDTPLG_STATO_EVENTO_JPUB = (SELECT IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?)&#xa;WHERE ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

