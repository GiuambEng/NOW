                            <bpws:invoke
                                inputVariable="NomeOfferta-input"
                                name="NomeOfferta"
                                operation="NomeOfferta"
                                outputVariable="NomeOfferta"
                                partnerLink="NomeOfferta"
                                portType="ns4:NomeOffertaPortType" tibex:xpdlId="d79d4dff-1aec-4969-bda9-88df15daa2a3">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/NomeOfferta/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:template name="NomeOfferta-input" match="/"&gt;
        &lt;tns4:NomeOffertaRequest&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='CESSAZIONE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE='CESSAZIONE'"&gt;
                        &lt;tns:NomeOffertaRequest&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO)&gt;0"&gt;
                                    &lt;tns:IDRichOLO&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO"/&gt;
                                    &lt;/tns:IDRichOLO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:IDRichOLO&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                                    &lt;/tns:IDRichOLO&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns:Offerta&gt;
                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta"/&gt;
                            &lt;/tns:Offerta&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione"&gt;
                                &lt;tns:Lavorazione&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione"/&gt;
                                &lt;/tns:Lavorazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:NomeOffertaRequest&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:when test="(exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()) or  ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()) or ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE='ATTIVAZIONE' )"&gt;
                        &lt;tns:NomeOffertaRequest&gt;
                            &lt;tns:IDRichOLO&gt;
                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                            &lt;/tns:IDRichOLO&gt;
                            &lt;tns:Offerta&gt;
                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta"/&gt;
                            &lt;/tns:Offerta&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione"&gt;
                                &lt;tns:Lavorazione&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione"/&gt;
                                &lt;/tns:Lavorazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:NomeOffertaRequest&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:NomeOffertaRequest&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO)&gt;0"&gt;
                                    &lt;tns:IDRichOLO&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO"/&gt;
                                    &lt;/tns:IDRichOLO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:IDRichOLO&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                                    &lt;/tns:IDRichOLO&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns:Offerta&gt;
                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta"/&gt;
                            &lt;/tns:Offerta&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione"&gt;
                                &lt;tns:Lavorazione&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione"/&gt;
                                &lt;/tns:Lavorazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:NomeOffertaRequest&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns4:NomeOffertaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/NomeOfferta/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;NomeOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='CESSAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TBUNDLE='CESSAZIONE'&quot;>&#xa;                &lt;tns:NomeOffertaRequest>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO)>0&quot;>&#xa;                            &lt;tns:IDRichOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:IDRichOLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:IDRichOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:IDRichOLO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:NomeOffertaRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()) or  ($StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()) or ($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TBUNDLE='ATTIVAZIONE' )&quot;>&#xa;                &lt;tns:NomeOffertaRequest>&#xa;                    &lt;tns:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:IDRichOLO>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:NomeOffertaRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:NomeOffertaRequest>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO)>0&quot;>&#xa;                            &lt;tns:IDRichOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:IDRichOLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:IDRichOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:IDRichOLO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:NomeOffertaRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
