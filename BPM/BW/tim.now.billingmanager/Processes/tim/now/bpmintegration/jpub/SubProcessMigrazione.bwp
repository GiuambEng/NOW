                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/descrizioneVia"&gt;
                                        &lt;descrizioneVia&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/descrizioneVia"/&gt;
                                        &lt;/descrizioneVia&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/localita"&gt;
                                        &lt;localita&gt;
