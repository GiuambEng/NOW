                            <bpws:invoke
                                inputVariable="UpdateStagingOK-input"
                                name="UpdateStagingOK"
                                operation="InsertUpdateStaging"
                                outputVariable="UpdateStagingOK"
                                partnerLink="InsertUpdateStagingPortType"
                                portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="633697b9-5302-468b-9434-b44998027a70">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns0="http://crmnow.ordineregolatorio.jpub/types/" xmlns:tns01="http://crmnow.ordinexdsl.jpub.internal/types/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEReg"/&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEXDSL"/&gt;
    &lt;xsl:param name="InsertStagingJPUB_OUT"/&gt;
    &lt;xsl:param name="InvokeJPUBXDSL"/&gt;
    &lt;xsl:param name="JPUBReg"/&gt;
    &lt;xsl:template name="UpdateStagingOK-input" match="/"&gt;
        &lt;tns4:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($JPUBReg/parameters/tns0:ricezioneResponseElement)"&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="tib:render-xml($JPUBReg/parameters/tns0:ricezioneResponseElement, true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="tib:render-xml($InvokeJPUBXDSL/parameters/tns01:ricezioneResponseElement,true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                        &lt;tns5:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RISPOSTA&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingJPUB_OUT/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($JPUBReg/parameters/tns0:ricezioneResponseElement)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$ID_PROCSO_NOFILEXDSL"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns4:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tns01=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingJPUB_OUT.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JPUBReg.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagingOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JPUBReg.parameters)&quot;>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($JPUBReg.parameters, true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBXDSL.parameters,true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RISPOSTA>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JPUBReg.parameters)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEReg&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEXDSL&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
