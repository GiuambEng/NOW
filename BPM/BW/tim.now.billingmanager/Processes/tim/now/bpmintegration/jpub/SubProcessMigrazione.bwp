                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStagingJPUB_OUT.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUB_WLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ErrorInput>&#xa;            &lt;xsl:if test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                &lt;tns4:ORDINE>&#xa;                    &lt;ns2:REGOLATORIO>&#xa;                        &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                    &lt;/ns2:REGOLATORIO>&#xa;                &lt;/tns4:ORDINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                            &lt;tns4:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns4:ID_RICH_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                &lt;tns4:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                    &lt;tns4:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                    &lt;tns4:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                &lt;tns4:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns4:ID_RICH_OLO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns4:COD_PROCSO_NOFILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns4:COD_PROCSO_NOFILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEReg&quot;/>&#xa;            &lt;/tns4:ID_ESEC_PROCSO_NOFILE>&#xa;            &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns4:STATO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns4:STATO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($DynamicProcess/tns:WLR/tns:STS)&quot;>&#xa;                &lt;tns4:ORDINEAGGIUNTIVI>&#xa;                    &lt;ns2:REGOLATORIO>&#xa;                        &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                    &lt;/ns2:REGOLATORIO>&#xa;                &lt;/tns4:ORDINEAGGIUNTIVI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$StartSubProcessMigrazione.parameters/tns1:StatoAggiuntivi&quot;>&#xa;                &lt;tns4:STATO_NP>&#xa;                    &lt;tns4:StatoNumeriAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;tns1:StatoAggiuntivi&quot;/>&#xa;                    &lt;/tns4:StatoNumeriAggiuntivi>&#xa;                &lt;/tns4:STATO_NP>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                    &lt;tns4:AGGIUNTIVIWLR>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns4:AGGIUNTIVIWLR>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns4:OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.RESPONSE/tns5:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns4:OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke.RESPONSE/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns4:WLRTimer>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke.RESPONSE/tns5:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns4:WLRTimer>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
