ommissioning>&lt;xsl:value-of select=&quot;decommissioning&quot;/>&lt;/decommissioning>&lt;/xsl:if>&lt;xsl:if test=&quot;assetBTWhiteList&quot;>&lt;assetBTWhiteList>&lt;xsl:value-of select=&quot;assetBTWhiteList&quot;/>&lt;/assetBTWhiteList>&lt;/xsl:if>&lt;xsl:if test=&quot;statoDisAsset&quot;>&lt;statoDisAsset>&lt;xsl:value-of select=&quot;statoDisAsset&quot;/>&lt;/statoDisAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;exOperatoreRete&quot;>&lt;exOperatoreRete>&lt;xsl:value-of select=&quot;exOperatoreRete&quot;/>&lt;/exOperatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;flagDelibera103&quot;>&lt;flagDelibera103>&lt;xsl:value-of select=&quot;flagDelibera103&quot;/>&lt;/flagDelibera103>&lt;/xsl:if>&lt;xsl:if test=&quot;codiceOperatoreReturning&quot;>&lt;codiceOperatoreReturning>&lt;xsl:value-of select=&quot;codiceOperatoreReturning&quot;/>&lt;/codiceOperatoreReturning>&lt;/xsl:if>&lt;xsl:if test=&quot;bonificaMacroarea&quot;>&lt;bonificaMacroarea>&lt;xsl:value-of select=&quot;bonificaMacroarea&quot;/>&lt;/bonificaMacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;idRisorsaOpenFiber&quot;>&lt;idRisorsaOpenFiber>&lt;xsl:value-of select=&quot;idRisorsaOpenFiber&quot;/>&lt;/idRisorsaOpenFiber>&lt;/xsl:if>&lt;xsl:if test=&quot;identificativoDelPop&quot;>&lt;identificativoDelPop>&lt;xsl:value-of select=&quot;identificativoDelPop&quot;/>&lt;/identificativoDelPop>&lt;/xsl:if>&lt;xsl:if test=&quot;caratterizzazioneAccesso&quot;>&lt;caratterizzazioneAccesso>&lt;xsl:value-of select=&quot;caratterizzazioneAccesso&quot;/>&lt;/caratterizzazioneAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;flagPortato&quot;>&lt;flagPortato>&lt;xsl:value-of select=&quot;flagPortato&quot;/>&lt;/flagPortato>&lt;/xsl:if>&lt;xsl:if test=&quot;caratterizzazioneArea&quot;>&lt;caratterizzazioneArea>&lt;xsl:value-of select=&quot;caratterizzazioneArea&quot;/>&lt;/caratterizzazioneArea>&lt;/xsl:if>&lt;xsl:if test=&quot;versioningClusterComune&quot;>&lt;versioningClusterComune>&lt;xsl:value-of select=&quot;versioningClusterComune&quot;/>&lt;/versioningClusterComune>&lt;/xsl:if>&lt;xsl:if test=&quot;codAddressSedeCliente&quot;>&lt;codAddressSedeCliente>&lt;xsl:value-of select=&quot;codAddressSedeCliente&quot;/>&lt;/codAddressSedeCliente>&lt;/xsl:if>&lt;xsl:if test=&quot;flagMigDel82&quot;>&lt;flagMigDel82>&lt;xsl:value-of select=&quot;flagMigDel82&quot;/>&lt;/flagMigDel82>&lt;/xsl:if>&lt;xsl:if test=&quot;modelServPerValidazioni&quot;>&lt;modelServPerValidazioni>&lt;xsl:value-of select=&quot;modelServPerValidazioni&quot;/>&lt;/modelServPerValidazioni>&lt;/xsl:if>&lt;xsl:if test=&quot;codOperatoreSecondario&quot;>&lt;codOperatoreSecondario>&lt;xsl:value-of select=&quot;codOperatoreSecondario&quot;/>&lt;/codOperatoreSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;descOperatoreSecondario&quot;>&lt;descOperatoreSecondario>&lt;xsl:value-of select=&quot;descOperatoreSecondario&quot;/>&lt;/descOperatoreSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;modelServPerValidOld&quot;>&lt;modelServPerValidOld>&lt;xsl:value-of select=&quot;modelServPerValidOld&quot;/>&lt;/modelServPerValidOld>&lt;/xsl:if>&lt;xsl:if test=&quot;ontOperatore&quot;>&lt;ontOperatore>&lt;xsl:value-of select=&quot;ontOperatore&quot;/>&lt;/ontOperatore>&lt;/xsl:if>&lt;xsl:if test=&quot;flagIU&quot;>&lt;flagIU>&lt;xsl:value-of select=&quot;flagIU&quot;/>&lt;/flagIU>&lt;/xsl:if>&lt;xsl:if test=&quot;codiceOrdineOF&quot;>&lt;codiceOrdineOF>&lt;xsl:value-of select=&quot;codiceOrdineOF&quot;/>&lt;/codiceOrdineOF>&lt;/xsl:if>&lt;/tns2:AssetCorrelatiCessati>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:NewBilling)>0&quot;>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:NewBilling&quot;>&lt;tns2:NewBilling>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:NewBilling&quot;/>&lt;/tns2:NewBilling>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:ID_RECUPERO_JPUB_MASTER&quot;>&lt;tns2:ID_RECUPERO_JPUB_MASTER>&lt;xsl:if test=&quot;tns1:ID_RECUPERO_JPUB_MASTER&quot;>&lt;tns2:ID_RECUPERO_JPUB_MASTER>&lt;xsl:value-of select=&quot;tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&lt;/tns2:ID_RECUPERO_JPUB_MASTER>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:BDS_ID&quot;>&lt;tns2:BDS_ID>&lt;xsl:value-of select=&quot;tns1:BDS_ID&quot;/>&lt;/tns2:BDS_ID>&lt;/xsl:if>&lt;/tns2:ID_RECUPERO_JPUB_MASTER>&lt;/xsl:for-each>&lt;/tns2:BPMRequest>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione&quot;>&lt;tns2:Lavorazione>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione&quot;/>&lt;/tns2:Lavorazione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()&quot;>&lt;tns2:LavorazioniIndotteAttivazione>&lt;xsl:value-of select=&quot;'Indotte'&quot;/>&lt;/tns2:LavorazioniIndotteAttivazione>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati&quot;>&lt;tns2:FlagAssetMigrati>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati&quot;/>&lt;/tns2:FlagAssetMigrati>&lt;/xsl:if>&lt;/tns2:SendJPUBRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DynamicProcess-input"
                                    name="DynamicProcess"
                                    outputVariable="DynamicProcess"
                                    tibex:xpdlId="bbbd7a40-2c5f-4f51-8c32-97755332a073"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToCallProcess4"/>
                                    <bpws:source
                                    linkName="DynamicProcessToLogFaultDynamicProcess_Error"
                                    tibex:faultDetailsVar="DynamicProcess" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;DynamicProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:SendJPUBRequest>&#xa;            &lt;tns2:Stato>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns2:Stato>&#xa;            &lt;tns2:BPMRequest>&#xa;                &lt;tns2:Richiesta>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                        &lt;/statoRichiestaPrecedNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaOLO&quot;>&#xa;                        &lt;statoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaOLO&quot;/>&#xa;                        &lt;/statoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                        &lt;statoRichiestaPrecedOLO>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                        &lt;/statoRichiestaPrecedOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/sottostatoLavorManuale&quot;>&#xa;                        &lt;sottostatoLavorManuale>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/sottostatoLavorManuale&quot;/>&#xa;                        &lt;/sottostatoLavorManuale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileInput&quot;>&#xa;                        &lt;IDFileInput>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileInput&quot;/>&#xa;                        &lt;/IDFileInput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileOutput&quot;>&#xa;                        &lt;IDFileOutput>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileOutput&quot;/>&#xa;                        &lt;/IDFileOutput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;canaleRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/canaleRichiesta&quot;/>&#xa;                    &lt;/canaleRichiesta>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                            &lt;lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/lavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;!--&quot;[Bug 44211][SM_11060] EVO C06 2023: Implementazione logica per scenario NPSUWRL CESSAZIONE Aggiuntivi WLR&quot;-->&#xa;                                &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[1]/dettaglioasset[nomeComponente='AGGIUNTIVO']/nomeComponente)>0 and $StartSubProcessMigrazione.parameters/tns1:Richiesta/tipologiaScenario='NPSUWLR' and $StartSubProcessMigrazione.parameters/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;lavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                                    &lt;/lavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;lavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                                    &lt;/lavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/progressivoRichiestaFile&quot;>&#xa;    