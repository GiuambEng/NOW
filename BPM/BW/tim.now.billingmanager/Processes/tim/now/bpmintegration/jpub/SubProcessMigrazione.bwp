                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&lt;xsl:template name=&quot;DynamicProcess-input&quot; match=&quot;/&quot;>&lt;tns2:SendJPUBRequest>&lt;tns2:Stato>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns2:Stato>&lt;tns2:BPMRequest>&lt;tns2:Richiesta>&lt;created>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/statoRichiestaNOW&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/statoRichiestaPrecedNOW&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/statoRichiestaPrecedNOW&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xs