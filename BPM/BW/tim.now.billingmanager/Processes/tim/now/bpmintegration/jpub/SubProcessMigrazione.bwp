                                    <tibex:expression
                                    expression="$ErrorJPUBXDSL/Output/ns9:ErrorOutput/ns9:ErrorO/ns9:TRANSACTION_ID = &quot;Null&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
