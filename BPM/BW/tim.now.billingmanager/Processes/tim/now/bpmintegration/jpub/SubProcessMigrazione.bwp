                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Update staging per STS'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:invoke
                                    inputVariable="Invoke1-input"
                                    name="Invoke1"
                                    operation="InsertUpdateStaging"
                                    outputVariable="Invoke1"
                                    partnerLink="InsertUpdateStagingPortType"
                                    portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="11afac3c-e722-477c-9cf7-8159763a422a">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" version="2.0"&gt;
    &lt;xsl:param name="ErrorJPUBREG"/&gt;
    &lt;xsl:param name="InsertStagingJPUB_OUT"/&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="Invoke"/&gt;
    &lt;xsl:param name="ID_PROCSO_NOFILEReg"/&gt;
    &lt;xsl:template name="Invoke1-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_DATE)&gt;0"&gt;
                                &lt;xsl:if test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:CONTENUTO_RESPONSE"&gt;
                                    &lt;tns4:CONTENUTO_RESPONSE&gt;
                                        &lt;xsl:value-of select="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:CONTENUTO_RESPONSE"/&gt;
                                    &lt;/tns4:CONTENUTO_RESPONSE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns4:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                &lt;tns4:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="concat('Chiamata a JPUB non riuscita',$FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/ProcessStack,$FaultDetails/StackTrace)"/&gt;
                                &lt;/tns4:DESCR_ERRORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns4:DESCR_ERRORE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="12"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="11"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                    &lt;/tns4:StagingOut&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStagingJPUB_OUT/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStagingJPUB_OUT/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($Invoke/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ID_PROCSO_NOFILEReg"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                                    &lt;/ns1:STATO_ESEC&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                                    &lt;/ns1:STATO_ESEC&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'ERROR'"/&gt;
                                    &lt;/ns1:LOG_LEVEL&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'INFO'"/&gt;
                                    &lt;/ns1:LOG_LEVEL&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;
                                    &lt;/ns1:LOG_MESSAGE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                                    &lt;/ns1:LOG_MESSAGE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingJPUB_OUT.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILEReg&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_DATE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:CONTENUTO_RESPONSE&quot;>&#xa;                            &lt;tns4:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:CONTENUTO_RESPONSE&quot;/>&#xa;                            &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                        &lt;tns4:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;concat('Chiamata a JPUB non riuscita',$FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/ProcessStack,$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns4:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns4:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;            &lt;/tns4:StagingOut>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns4:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagingJPUB_OUT.RESPONSE/tns4:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Invoke.RESPONSE/tns4:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILEReg&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:STATO_ESEC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                            &lt;/ns1:STATO_ESEC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                            &lt;/ns1:LOG_LEVEL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                            &lt;/ns1:LOG_LEVEL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns1:LOG_MESSAGE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns1:LOG_MESSAGE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
