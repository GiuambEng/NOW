                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartSubProcessMigrazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('StartMigrazioneSubProcess',tib:render-xml($StartSubProcessMigrazione/parameters/tns1:Request, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub'&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Operation>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                                        &lt;tns4:BusinessID>&#xa;                                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/tns4:BusinessID>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                            &lt;tns4:BusinessID>&#xa;                                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns4:BusinessID>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()&quot;>&#xa;                                &lt;tns4:BusinessID>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:BusinessID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()&quot;>&#xa;                                &lt;tns4:BusinessID>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:BusinessID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns4:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns4:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                                        &lt;tns4:trackID>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                        &lt;/tns4:trackID>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns4:trackID>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO)&quot;/>&#xa;                                        &lt;/tns4:trackID>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()&quot;>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()&quot;>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MigrazioneSubProcess_&amp;quot;, $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;                &lt;tns4:Playload>&#xa;                    &lt;tns4:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($StartSubProcessMigrazione/parameters/tns1:Request)))&quot;/>&#xa;                    &lt;/tns4:Binary>&#xa;                    &lt;tns4:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($StartSubProcessMigrazione/parameters/tns1:Request, true(), true())&quot;/>&#xa;                    &lt;/tns4:XMLString>&#xa;                &lt;/tns4:Playload>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogStartSubProcessMigrazione-input"
                                    name="LogStartSubProcessMigrazione"
                                    tibex:xpdlId="8c44789f-81c3-44f7-a0cf-ee9546b2511c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToInvoke">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartSubProcessMigrazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('StartMigrazioneSubProcess',tib:render-xml($StartSubProcessMigrazione.parameters, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.jpub'&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Operation>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                                        &lt;tns4:BusinessID>&#xa;                                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/tns4:BusinessID>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                            &lt;tns4:BusinessID>&#xa;                                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns4:BusinessID>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                                &lt;tns4:BusinessID>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:BusinessID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                                &lt;tns4:BusinessID>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:BusinessID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns4:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns4:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE'&quot;>&#xa;                                        &lt;tns4:trackID>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                        &lt;/tns4:trackID>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns4:trackID>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO)&quot;/>&#xa;                                        &lt;/tns4:trackID>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true()&quot;>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()&quot;>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;SubProcessMigrazione_&amp;quot;, $StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MigrazioneSubProcess_&amp;quot;, $StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns4:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;                &lt;tns4:Playload>&#xa;                    &lt;tns4:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($StartSubProcessMigrazione.parameters)))&quot;/>&#xa;                    &lt;/tns4:Binary>&#xa;                    &lt;tns4:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($StartSubProcessMigrazione.parameters, true(), true())&quot;/>&#xa;                    &lt;/tns4:XMLString>&#xa;                &lt;/tns4:Playload>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
