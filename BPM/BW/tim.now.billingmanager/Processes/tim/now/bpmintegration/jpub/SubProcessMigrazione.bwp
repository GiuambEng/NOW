                                &lt;disaggregato&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/disaggregato"/&gt;
                                &lt;/disaggregato&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/exDisaggregato"&gt;
                                &lt;exDisaggregato&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/exDisaggregato"/&gt;
                                &lt;/exDisaggregato&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/FFACQKO"&gt;
                                &lt;FFACQKO&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/FFACQKO"/&gt;
                                &lt;/FFACQKO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/idProgressivoNotificheFF"&gt;
                                &lt;idProgressivoNotificheFF&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/idProgressivoNotificheFF"/&gt;
                                &lt;/idProgressivoNotificheFF&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/idTplgCautelare"&gt;
                                &lt;idTplgCautelare&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/idTplgCautelare"/&gt;
                                &lt;/idTplgCautelare&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/rendezVous"&gt;
                                &lt;rendezVous&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/rendezVous"/&gt;
                                &lt;/rendezVous&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/cambioTecnologia"&gt;
                                &lt;cambioTecnologia&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/cambioTecnologia"/&gt;
                                &lt;/cambioTecnologia&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:Richiesta&gt;
                        &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati"&gt;
                            &lt;tns4:FlagAssetMigrati&gt;
                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati"/&gt;
                            &lt;/tns4:FlagAssetMigrati&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true()"&gt;
                                &lt;tns4:LavorazioneIndotte&gt;
                                    &lt;xsl:value-of select="'Indotte'"/&gt;
                                &lt;/tns4:LavorazioneIndotte&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns4:BPMRequest&gt;
                    &lt;tns4:FlagMigrazione&gt;
                        &lt;xsl:value-of select="true()"/&gt;
                    &lt;/tns4:FlagMigrazione&gt;
                &lt;/tns4:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns5:DeleteRecordRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DeleteRecord/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDeleteRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;tns4:BPMRequest>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;>&#xa;                                    &lt;tns4:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/IDRisorsa&quot;/>&#xa;                                    &lt;/tns4:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;>&#xa;                                    &lt;tns4:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/tns4:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/tns4:ID_RISORSA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($StartSubProcessMigrazione.parameters/tns1:AssetPrincipale)&quot;>&#xa;                        &lt;tns4:Asset>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAsset&quot;>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceOrdineOLO&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceOrdineTI&quot;>&#xa;                                &lt;codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceOrdineTI&quot;/>&#xa;                                &lt;/codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/invariante&quot;>&#xa;                                &lt;invariante>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/invariante&quot;/>&#xa;                                &lt;/invariante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/created&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/lastUpdate&quot;>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/lastUpdate&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDRichiestaOLO&quot;>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDPrimoOrdine&quot;>&#xa;                                &lt;IDPrimoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDPrimoOrdine&quot;/>&#xa;                                &lt;/IDPrimoOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;IDContratto>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDContratto&quot;/>&#xa;                            &lt;/IDContratto>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/DEC&quot;>&#xa;                                &lt;DEC>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/DEC&quot;/>&#xa;                                &lt;/DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;statoAsset>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/statoAsset&quot;/>&#xa;                            &lt;/statoAsset>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/numeroTelefonico&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/numeroTelefonico&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAssetCRMWS&quot;>&#xa;                                &lt;IDAssetCRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAssetCRMWS&quot;/>&#xa;                                &lt;/IDAssetCRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAssetDa&quot;>&#xa;                                &lt;IDAssetDa>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/IDAssetDa&quot;/>&#xa;                                &lt;/IDAssetDa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DES>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/DES&quot;/>&#xa;                            &lt;/DES>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/ORA_DES&quot;>&#xa;                                &lt;ORA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/ORA_DES&quot;/>&#xa;                                &lt;/ORA_DES>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tipologiaAccesso>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/tipologiaAccesso&quot;/>&#xa;                            &lt;/tipologiaAccesso>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/RO&quot;>&#xa;                                &lt;RO>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/RO&quot;/>&#xa;                                &lt;/RO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;offerta>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/offerta&quot;/>&#xa;                            &lt;/offerta>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/lineaRiferimento&quot;>&#xa;                                &lt;lineaRiferimento>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/lineaRiferimento&quot;/>&#xa;                                &lt;/lineaRiferimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/complesso&quot;>&#xa;                                &lt;complesso>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/complesso&quot;/>&#xa;                                &lt;/complesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/interno&quot;>&#xa;                                &lt;interno>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/interno&quot;/>&#xa;                                &lt;/interno>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/piano&quot;>&#xa;                                &lt;piano>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/piano&quot;/>&#xa;                                &lt;/piano>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/scala&quot;>&#xa;                                &lt;scala>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/scala&quot;/>&#xa;                                &lt;/scala>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:copy-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/dettaglioasset&quot;/>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/DESPrimoOrdine&quot;>&#xa;                                &lt;DESPrimoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/DESPrimoOrdine&quot;/>&#xa;                                &lt;/DESPrimoOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/CAP&quot;>&#xa;                                &lt;CAP>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/CAP&quot;/>&#xa;                                &lt;/CAP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceISTATComune&quot;>&#xa;                                &lt;codiceISTATComune>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceISTATComune&quot;/>&#xa;                                &lt;/codiceISTATComune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceISTATProvincia&quot;>&#xa;                                &lt;codiceISTATProvincia>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceISTATProvincia&quot;/>&#xa;                                &lt;/codiceISTATProvincia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceToponomastica&quot;>&#xa;                                &lt;codiceToponomastica>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/codiceToponomastica&quot;/>&#xa;                                &lt;/codiceToponomastica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/comune&quot;>&#xa;                                &lt;comune>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/comune&quot;/>&#xa;                                &lt;/comune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/descrPartToponomastica&quot;>&#xa;                                &lt;descrPartToponomastica>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/descrPartToponomastica&quot;/>&#xa;                                &lt;/descrPartToponomastica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/descrizioneVia&quot;>&#xa;                                &lt;descrizioneVia>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/descrizioneVia&quot;/>&#xa;                                &lt;/descrizioneVia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/localita&quot;>&#xa;                                &lt;localita>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/localita&quot;/>&#xa;                                &lt;/localita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/numeroCivico&quot;>&#xa;                                &lt;numeroCivico>&#xa;                                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:AssetPrincipale/numeroCivico&quot;/>&#xa;                                &lt;/numeroCivico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asse