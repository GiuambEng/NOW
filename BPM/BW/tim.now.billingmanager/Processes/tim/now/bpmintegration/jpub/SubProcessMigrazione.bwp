                            <bpws:empty name="ControlloStato" tibex:xpdlId="48cb088a-8aad-4504-a89b-f98b9e60ec50">
                                <bpws:targets>
                                    <bpws:target linkName="ControlloStagingToEmpty3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty3ToAggiornamentoStato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ControlloChiamataJpub='True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ControlloChiamataJpub='True']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty3ToAccumulate1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
