                                    <bpws:invoke
                                    inputVariable="ErrorJPUBREG-input"
                                    name="ErrorJPUBREG"
                                    operation="ErrorSchema"
                                    outputVariable="ErrorJPUBREG"
                                    partnerLink="ErrorJPUBREG"
                                    portType="ns14:ErrorSchemaPortType" tibex:xpdlId="1bc2e230-528b-43cb-b907-34050d848f18">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/" xmlns:tns4="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" xmlns:tns2="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="DynamicProcess"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazione"/&gt;
    &lt;xsl:param name="InvokeJPUB_WLR"/&gt;
    &lt;xsl:template name="ErrorJPUBREG-input" match="/"&gt;
        &lt;tns5:ErrorSchemaRequest&gt;
            &lt;Input&gt;
                &lt;tns4:ErrorInput&gt;
                    &lt;tns4:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="concat($_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;
                    &lt;/tns4:TRANSACTION_ID&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO)"&gt;
                            &lt;xsl:if test="$DynamicProcess/tns:REGOLATORIO/tns:ControlloStruttura"&gt;
                                &lt;tns4:RETURN_CODE&gt;
                                    &lt;xsl:value-of select="$DynamicProcess/tns:REGOLATORIO/tns:ControlloStruttura"/&gt;
                                &lt;/tns4:RETURN_CODE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$DynamicProcess/tns:NP/tns:ControlloStruttura"&gt;
                                &lt;tns4:RETURN_CODE&gt;
                                    &lt;xsl:value-of select="$DynamicProcess/tns:NP/tns:ControlloStruttura"/&gt;
                                &lt;/tns4:RETURN_CODE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta = &amp;quot;NP&amp;quot; or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta='NP') and ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione='ATTIVAZIONE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE')"&gt;
                            &lt;tns4:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;NPG&amp;quot;"/&gt;
                            &lt;/tns4:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;
                            &lt;/tns4:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($DynamicProcess/tns:REGOLATORIO)"&gt;
                            &lt;tns4:ORDINE&gt;
                                &lt;ns1:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA"/&gt;
                                &lt;/ns1:REGOLATORIO&gt;
                            &lt;/tns4:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($DynamicProcess/tns:NP/tns:PRINCIPALE)"&gt;
                            &lt;tns4:ORDINE&gt;
                                &lt;ns1:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA"/&gt;
                                &lt;/ns1:REGOLATORIO&gt;
                            &lt;/tns4:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)"&gt;
                            &lt;tns4:ORDINE&gt;
                                &lt;ns1:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA"/&gt;
                                &lt;/ns1:REGOLATORIO&gt;
                            &lt;/tns4:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:ID_RICH_OLO&gt;
                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                    &lt;/tns4:ID_RICH_OLO&gt;
                    &lt;xsl:if test="string-length($InvokeJPUB_WLR/tns2:IDRichOLO)&gt;0 and $InvokeJPUB_WLR/tns2:IDRichOLO='XX'"&gt;
                        &lt;tns4:COD_PROCSO_NOFILE&gt;
                            &lt;xsl:value-of select="'STS'"/&gt;
                        &lt;/tns4:COD_PROCSO_NOFILE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:for-each select="$UPDATEGestioneFatturazione/tns:AGGIUNTIVI/tns:Record"&gt;
                        &lt;tns4:NP&gt;
                            &lt;tns4:ID_RISORSA&gt;
                                &lt;xsl:value-of select="tns:ID_RISORSA"/&gt;
                            &lt;/tns4:ID_RISORSA&gt;
                            &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;xsl:value-of select="tns:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                            &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS&gt;
                            &lt;xsl:if test="tns:IDDETTAGLIOORDINE"&gt;
                                &lt;tns4:IDDETTAGLIOORDINE&gt;
                                    &lt;xsl:value-of select="tns:IDDETTAGLIOORDINE"/&gt;
                                &lt;/tns4:IDDETTAGLIOORDINE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns4:NP&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:if test="exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)"&gt;
                        &lt;xsl:for-each select="$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO"&gt;
                            &lt;tns4:AGGIUNTIVIWLR&gt;
                                &lt;ns1:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="ns1:TESTATA"/&gt;
                                &lt;/ns1:REGOLATORIO&gt;
                            &lt;/tns4:AGGIUNTIVIWLR&gt;
                        &lt;/xsl:for-each&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="($StartSubProcessMigrazione/parameters/tns1:Request/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:TBUNDLE='ATTIVAZIONE' ) or&amp;#xD;&amp;#xA;(exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta) and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:FlagAssetMigrati=true()) or  ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:LavorazioniIndotte=true() and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione!='ATTIVAZIONE'&amp;#xD;&amp;#xA;and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/tipologiaSottolav!='CAMBIOTECNOLOGIA')"&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta"&gt;
                                &lt;tns4:OFFERTA&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/offerta"/&gt;
                                &lt;/tns4:OFFERTA&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta"&gt;
                                &lt;tns4:OFFERTA&gt;
                                    &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/offerta"/&gt;
                                &lt;/tns4:OFFERTA&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:WLRTimer&gt;
                        &lt;xsl:value-of select="''"/&gt;
                    &lt;/tns4:WLRTimer&gt;
                &lt;/tns4:ErrorInput&gt;
            &lt;/Input&gt;
        &lt;/tns5:ErrorSchemaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorJPUBREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ErrorInput>&#xa;            &lt;tns4:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns4:TRANSACTION_ID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:REGOLATORIO/tns:ControlloStruttura&quot;>&#xa;                        &lt;tns4:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:REGOLATORIO/tns:ControlloStruttura&quot;/>&#xa;                        &lt;/tns4:RETURN_CODE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$DynamicProcess/tns:NP/tns:ControlloStruttura&quot;>&#xa;                        &lt;tns4:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$DynamicProcess/tns:NP/tns:ControlloStruttura&quot;/>&#xa;                        &lt;/tns4:RETURN_CODE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($StartSubProcessMigrazione.parameters/tns1:Richiesta/offerta = &amp;quot;NP&amp;quot; or $StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/offerta='NP') and ($StartSubProcessMigrazione.parameters/tns1:Lavorazione='ATTIVAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE')&quot;>&#xa;                    &lt;tns4:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;                    &lt;/tns4:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/tns4:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:REGOLATORIO)&quot;>&#xa;                    &lt;tns4:ORDINE>&#xa;                        &lt;ns1:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:REGOLATORIO/ns1:REGOLATORIO/ns1:TESTATA&quot;/>&#xa;                        &lt;/ns1:REGOLATORIO>&#xa;                    &lt;/tns4:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:PRINCIPALE)&quot;>&#xa;                    &lt;tns4:ORDINE>&#xa;                        &lt;ns1:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:NP/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA&quot;/>&#xa;                        &lt;/ns1:REGOLATORIO>&#xa;                    &lt;/tns4:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                    &lt;tns4:ORDINE>&#xa;                        &lt;ns1:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$DynamicProcess/tns:WLR/tns:PRINCIPALE/ns1:REGOLATORIO/ns1:TESTATA&quot;/>&#xa;                        &lt;/ns1:REGOLATORIO>&#xa;                    &lt;/tns4:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns4:ID_RICH_OLO>&#xa;            &lt;xsl:if test=&quot;string-length($InvokeJPUB_WLR/tns2:IDRichOLO)>0 and $InvokeJPUB_WLR/tns2:IDRichOLO='XX'&quot;>&#xa;                &lt;tns4:COD_PROCSO_NOFILE>&#xa;                    &lt;xsl:value-of select=&quot;'STS'&quot;/>&#xa;                &lt;/tns4:COD_PROCSO_NOFILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$UPDATEGestioneFatturazione/tns:AGGIUNTIVI/tns:Record&quot;>&#xa;                &lt;tns4:NP>&#xa;                    &lt;tns4:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&#xa;                    &lt;/tns4:ID_RISORSA>&#xa;                    &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:if test=&quot;tns:IDDETTAGLIOORDINE&quot;>&#xa;                        &lt;tns4:IDDETTAGLIOORDINE>&#xa;                            &lt;xsl:value-of select=&quot;tns:IDDETTAGLIOORDINE&quot;/>&#xa;                        &lt;/tns4:IDDETTAGLIOORDINE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:NP>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns1:REGOLATORIO&quot;>&#xa;                    &lt;tns4:AGGIUNTIVIWLR>&#xa;                        &lt;ns1:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;ns1:TESTATA&quot;/>&#xa;                        &lt;/ns1:REGOLATORIO>&#xa;                    &lt;/tns4:AGGIUNTIVIWLR>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($StartSubProcessMigrazione.parameters/tns1:TSHA_ULLD='ATTIVAZIONE' or $StartSubProcessMigrazione.parameters/tns1:TBUNDLE='ATTIVAZIONE' ) or&amp;#xD;&amp;#xA;(exists($StartSubProcessMigrazione.parameters/tns1:Richiesta) and $StartSubProcessMigrazione.parameters/tns1:FlagAssetMigrati=true()) or  ($StartSubProcessMigrazione.parameters/tns1:LavorazioniIndotte=true() and $StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione!='ATTIVAZIONE'&amp;#xD;&amp;#xA;and $StartSubProcessMigrazione.parameters/tns1:Richiesta/tipologiaSottolav!='CAMBIOTECNOLOGIA')&quot;>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/offerta&quot;>&#xa;                        &lt;tns4:OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/offerta&quot;/>&#xa;                        &lt;/tns4:OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/offerta&quot;>&#xa;                        &lt;tns4:OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Asset[number($index)]/offerta&quot;/>&#xa;                        &lt;/tns4:OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:WLRTimer>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns4:WLRTimer>&#xa;        &lt;/tns4:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
