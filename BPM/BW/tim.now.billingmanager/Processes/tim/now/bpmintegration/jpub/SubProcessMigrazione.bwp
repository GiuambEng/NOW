                                    </bpws:invoke>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogErrorJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices/>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogErrorJPUB-input"
                                    name="LogErrorJPUB"
                                    tibex:xpdlId="46f6ce83-f2ee-4096-9457-b4b391bd6c27"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess12ToInvoke4_XDSLNGA">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcess12ToInvoke5_REGOLATORIONPG">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="(((string-length($StartSubProcessMigrazione/parameters/tns:Request/tns:TSHA_ULLD)>0 and $StartSubProcessMigrazione/parameters/tns:Request/tns:TSHA_ULLD='ATTIVAZIONE') or (string-length($StartSubProcessMigrazione/parameters/tns:Request/tns:TBUNDLE)>0 and $StartSubProcessMigrazione/parameters/tns:Request/tns:TBUNDLE='ATTIVAZIONE')&#xd;&#xa;or (($StartSubProcessMigrazione/parameters/tns:Request/tns:LavorazioniIndotte=true() and &#xd;&#xa;(string-length($StartSubProcessMigrazione/parameters/tns:Request/tns:TSHA_ULLD)=0 and &#xd;&#xa;string-length($StartSubProcessMigrazione/parameters/tns:Request/tns:TBUNDLE)=0))) or &#xd;&#xa;(exists($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta) and $StartSubProcessMigrazione/parameters/tns:Request/tns:FlagAssetMigrati=true())) &#xd;&#xa;and (upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLLINEANONATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLDATILINEANONATTIVA' &#xd;&#xa;or (upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLDATILINEAATTIVA' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLLINEAATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLDATILINEAATTIVANP' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='ULLLINEAATTIVANP') or &#xd;&#xa;(upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='WLRLINEAATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='VARIAZIONEWLR' or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='WLR' or&#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')&#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='SLULINEANONATTIVA'or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='SLULINEAATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='SLULINEAATTIVANP'  or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='VULL'   or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='NP' or&#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta)='VULLLINEANONATTIVA' or&#xd;&#xa; starts-with($StartSubProcessMigrazione/parameters/tns:Request/tns:Richiesta/offerta,'SHA'))) or &#xd;&#xa; (($StartSubProcessMigrazione/parameters/tns:Request/tns:Lavorazione='CESSAZIONE') and &#xd;&#xa; (upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='VULLLINEANONATTIVA' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLLINEANONATTIVA' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLDATILINEANONATTIVA'&#xd;&#xa;or (upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLDATILINEAATTIVA' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLLINEAATTIVA' or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLDATILINEAATTIVANP' &#xd;&#xa;or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='ULLLINEAATTIVANP') or&#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='WLRLINEAATTIVA' or  upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='WLR' or&#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='WLRLINEANONATTIVA' or &#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='VARIAZIONEWLR' or &#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEAATTIVA' &#xd;&#xa; or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEANONATTIVA'&#xd;&#xa; or upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='SLULINEANONATTIVA'or &#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='SLULINEAATTIVA' or &#xd;&#xa; upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='SLULINEAATTIVANP'  or &#xd;&#xa;upper-case($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta)='VULL' or&#xd;&#xa;starts-with($StartSubProcessMigrazione/parameters/tns:Request/tns:Asset[number($index)]/offerta,'SHA')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(((string-length($StartSubProcessMigrazione.parameters/tns:TSHA_ULLD)>0 and $StartSubProcessMigrazione.parameters/tns:TSHA_ULLD='ATTIVAZIONE') or (string-length($StartSubProcessMigrazione.parameters/tns:TBUNDLE)>0 and $StartSubProcessMigrazione.parameters/tns:TBUNDLE='ATTIVAZIONE')
or (($StartSubProcessMigrazione.parameters/tns:LavorazioniIndotte=true() and 
(string-length($StartSubProcessMigrazione.parameters/tns:TSHA_ULLD)=0 and 
string-length($StartSubProcessMigrazione.parameters/tns:TBUNDLE)=0))) or 
(exists($StartSubProcessMigrazione.parameters/tns:Richiesta) and $StartSubProcessMigrazione.parameters/tns:FlagAssetMigrati=true())) 
and (upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLLINEANONATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLDATILINEANONATTIVA' 
or (upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLDATILINEAATTIVA' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLLINEAATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLDATILINEAATTIVANP' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='ULLLINEAATTIVANP') or 
(upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='WLRLINEAATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='VARIAZIONEWLR' or upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='WLR' or
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA')
or upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='SLULINEANONATTIVA'or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='SLULINEAATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='SLULINEAATTIVANP'  or 
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='VULL'   or upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='NP' or
upper-case($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta)='VULLLINEANONATTIVA' or
 starts-with($StartSubProcessMigrazione.parameters/tns:Richiesta/offerta,'SHA'))) or 
 (($StartSubProcessMigrazione.parameters/tns:Lavorazione='CESSAZIONE') and 
 (upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='VULLLINEANONATTIVA' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLLINEANONATTIVA' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLDATILINEANONATTIVA'
or (upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLDATILINEAATTIVA' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLLINEAATTIVA' or 
upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLDATILINEAATTIVANP' 
or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='ULLLINEAATTIVANP') or
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='WLRLINEAATTIVA' or  upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='WLR' or
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='WLRLINEANONATTIVA' or 
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='VARIAZIONEWLR' or 
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEAATTIVA' 
 or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='CESSAZIONEWLRLINEANONATTIVA'
 or upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='SLULINEANONATTIVA'or 
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='SLULINEAATTIVA' or 
 upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='SLULINEAATTIVANP'  or 
upper-case($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta)='VULL' or
starts-with($StartSubProcessMigrazione.parameters/tns:Asset[number($index)]/offerta,'SHA')))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

