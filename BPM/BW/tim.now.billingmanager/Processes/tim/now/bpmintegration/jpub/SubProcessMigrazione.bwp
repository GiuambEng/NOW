s2:Identificativo&quot;/>&lt;/tns2:Identificativo>&lt;/tns2:Response_Aggiuntivi>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns2:IDRisorsa>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RISORSA&quot;/>&lt;/tns2:IDRisorsa>&lt;tns2:IDRichOLO>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns2:IDRichOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:IDDETTAGLIOORDINE)&quot;>&lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;>&lt;tns2:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;/>&lt;/tns2:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns2:SendJPUBResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:SendJPUBResponse>&lt;tns2:code>&lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&lt;/tns2:code>&lt;tns2:msg>&lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente&amp;quot;&quot;/>&lt;/tns2:msg>&lt;tns2:IDRisorsa>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RISORSA&quot;/>&lt;/tns2:IDRisorsa>&lt;tns2:IDRichOLO>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_RICH_OLO&quot;/>&lt;/tns2:IDRichOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record/tns:IDDETTAGLIOORDINE)&quot;>&lt;xsl:if test=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;>&lt;tns2:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:IDDETTAGLIOORDINE&quot;/>&lt;/tns2:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS)&quot;>&lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazione/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)>0 and upper-case($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGPNRRDRGZERO']/valoreAttributo)='Y'&quot;>&lt;tns2:Parking>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns2:Parking>&lt;/xsl:if>&lt;xsl:if test=&quot;(string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BANDOPUBBLICO']/valoreAttributo)>0 or string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIRETTOINFRATEL']/valoreAttributo)>0 or string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='SPECIALPRICE']/valoreAttributo)>0) and ($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='FULLGPON1BPNRR' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='SEMIGPON1BPNRR' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='UBBSEMIGPON' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='VULAFTTH' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='SEMIVULAFTTH'or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='BITSTREAMNGAFTTH' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='BITSTREAMGBEASIMMETRICOFLAT'or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='BITSTREAMGBESIMMETRICOFLAT'or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='BITSTREAMGBESIMMETRICO' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='EASYIPNGAFTTH'or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='EASYIPBASEPLUSFLAT' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='EASYIPBASEPLUSLITE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='EASYIPSPECIALPROFILEFLAT' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='EASYIPSPECIALPROFILELITE' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='FULLGPONPLUSNGA' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='FULLGPONPLUS' or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='UBBFULLGPON'or $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[$index]/offerta='BITSTREAMNGAFTTCAB'or $StartSubProce