                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUPDATEGestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazionePortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SubProcessMigrazione&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/MsgCode,$_error/Class,$_error/FullClass,$_error/StackTrace,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InvokeDeleteRecord-input"
                                name="InvokeDeleteRecord"
                                operation="DeleteRecord"
                                outputVariable="InvokeDeleteRecord"
                                partnerLink="DeleteRecord"
                                portType="ns7:DeleteRecordPortType" tibex:xpdlId="c6999480-bc3f-45b7-abde-4cc8c5663902">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/DeleteRecord/" xmlns:tns4="http://www.tim.com/NOW/xsd/DeleteRecord/" xmlns:tns1="http://www.tim.com/NOW/xsd/SubProcessMigrazione/" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="StartSubProcessMigrazione"/&gt;
    &lt;xsl:template name="InvokeDeleteRecord-input" match="/"&gt;
        &lt;tns5:DeleteRecordRequest&gt;
            &lt;parameters&gt;
                &lt;tns4:Request&gt;
                    &lt;tns4:BPMRequest&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione='CESSAZIONE'"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRisorsa)&gt;0"&gt;
                                        &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRisorsa"&gt;
                                            &lt;tns4:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[number($index)]/IDRisorsa"/&gt;
                                            &lt;/tns4:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns4:ID_RISORSA&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                                        &lt;/tns4:ID_RISORSA&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRisorsa)&gt;0"&gt;
                                        &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRisorsa"&gt;
                                            &lt;tns4:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRisorsa"/&gt;
                                            &lt;/tns4:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns4:ID_RISORSA&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/IDRichiestaOLO"/&gt;
                                        &lt;/tns4:ID_RISORSA&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale)"&gt;
                                &lt;tns4:Asset&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAsset"&gt;
                                        &lt;IDAsset&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAsset"/&gt;
                                        &lt;/IDAsset&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;codiceOrdineOLO&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceOrdineOLO"/&gt;
                                    &lt;/codiceOrdineOLO&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceOrdineTI"&gt;
                                        &lt;codiceOrdineTI&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceOrdineTI"/&gt;
                                        &lt;/codiceOrdineTI&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;codificaOLOAGCOM&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codificaOLOAGCOM"/&gt;
                                    &lt;/codificaOLOAGCOM&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/invariante"&gt;
                                        &lt;invariante&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/invariante"/&gt;
                                        &lt;/invariante&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;created&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/created"/&gt;
                                    &lt;/created&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/lastUpdate"&gt;
                                        &lt;lastUpdate&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/lastUpdate"/&gt;
                                        &lt;/lastUpdate&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;operatore&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/operatore"/&gt;
                                    &lt;/operatore&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDRichiestaOLO"&gt;
                                        &lt;IDRichiestaOLO&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDRichiestaOLO"/&gt;
                                        &lt;/IDRichiestaOLO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDPrimoOrdine"&gt;
                                        &lt;IDPrimoOrdine&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDPrimoOrdine"/&gt;
                                        &lt;/IDPrimoOrdine&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;IDContratto&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDContratto"/&gt;
                                    &lt;/IDContratto&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/DEC"&gt;
                                        &lt;DEC&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/DEC"/&gt;
                                        &lt;/DEC&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;statoAsset&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/statoAsset"/&gt;
                                    &lt;/statoAsset&gt;
                                    &lt;IDRisorsa&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDRisorsa"/&gt;
                                    &lt;/IDRisorsa&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/numeroTelefonico"&gt;
                                        &lt;numeroTelefonico&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/numeroTelefonico"/&gt;
                                        &lt;/numeroTelefonico&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAssetCRMWS"&gt;
                                        &lt;IDAssetCRMWS&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAssetCRMWS"/&gt;
                                        &lt;/IDAssetCRMWS&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAssetDa"&gt;
                                        &lt;IDAssetDa&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/IDAssetDa"/&gt;
                                        &lt;/IDAssetDa&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;DES&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/DES"/&gt;
                                    &lt;/DES&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/ORA_DES"&gt;
                                        &lt;ORA_DES&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/ORA_DES"/&gt;
                                        &lt;/ORA_DES&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tipologiaAccesso&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/tipologiaAccesso"/&gt;
                                    &lt;/tipologiaAccesso&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/RO"&gt;
                                        &lt;RO&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/RO"/&gt;
                                        &lt;/RO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;offerta&gt;
                                        &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/offerta"/&gt;
                                    &lt;/offerta&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/lineaRiferimento"&gt;
                                        &lt;lineaRiferimento&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/lineaRiferimento"/&gt;
                                        &lt;/lineaRiferimento&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/complesso"&gt;
                                        &lt;complesso&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/complesso"/&gt;
                                        &lt;/complesso&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/interno"&gt;
                                        &lt;interno&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/interno"/&gt;
                                        &lt;/interno&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/piano"&gt;
                                        &lt;piano&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/piano"/&gt;
                                        &lt;/piano&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/scala"&gt;
                                        &lt;scala&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/scala"/&gt;
                                        &lt;/scala&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:copy-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/dettaglioasset"/&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/DESPrimoOrdine"&gt;
                                        &lt;DESPrimoOrdine&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/DESPrimoOrdine"/&gt;
                                        &lt;/DESPrimoOrdine&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/CAP"&gt;
                                        &lt;CAP&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/CAP"/&gt;
                                        &lt;/CAP&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceISTATComune"&gt;
                                        &lt;codiceISTATComune&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceISTATComune"/&gt;
                                        &lt;/codiceISTATComune&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceISTATProvincia"&gt;
                                        &lt;codiceISTATProvincia&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceISTATProvincia"/&gt;
                                        &lt;/codiceISTATProvincia&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceToponomastica"&gt;
                                        &lt;codiceToponomastica&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/codiceToponomastica"/&gt;
                                        &lt;/codiceToponomastica&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/comune"&gt;
                                        &lt;comune&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/comune"/&gt;
                                        &lt;/comune&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/descrPartToponomastica"&gt;
                                        &lt;descrPartToponomastica&gt;
                                            &lt;xsl:value-of select="$StartSubProcessMigrazione/parameters/tns1:Request/tns1:AssetPrincipale/descrPartToponomastica"/&gt;
                                        &lt;/descrPartToponomastica&gt;
