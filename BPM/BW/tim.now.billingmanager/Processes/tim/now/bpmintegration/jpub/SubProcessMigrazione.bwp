                                    <tibex:activityExtension
                                    inputVariable="UpdateDA_INVIARE_XDSL-input"
                                    name="UpdateDA_INVIARE_XDSL"
                                    outputVariable="UpdateDA_INVIARE_XDSL"
                                    tibex:xpdlId="18fc6711-e2e6-429f-98ee-eebf68860c23" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Invoke4ToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToCallProcess13"/>
                                    <bpws:source
                                    linkName="JDBCUpdateToCallProcess15"
