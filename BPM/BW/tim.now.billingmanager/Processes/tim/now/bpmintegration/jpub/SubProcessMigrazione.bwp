                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SubProcessMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartSubProcessMigrazione.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;UPDATEGestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:UPDATEGestioneFatturazioneMigrazioneRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                    &lt;tns:ContenutoNP>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO,true(), true())&quot;/>&#xa;                    &lt;/tns:ContenutoNP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS)&quot;>&#xa;                    &lt;tns:ContenutoXDSL>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS,true(),true())&quot;/>&#xa;                    &lt;/tns:ContenutoXDSL>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:NP/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DynamicProcess/tns:NP/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                        &lt;tns:ContenutoAggiuntivi>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml(.,true(),true())&quot;/>&#xa;                        &lt;/tns:ContenutoAggiuntivi>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                    &lt;tns:ContenutoWLR>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO, true(),true())&quot;/>&#xa;                    &lt;/tns:ContenutoWLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DynamicProcess/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                        &lt;tns:ContenutoWLRAggiuntivi>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml(., true(),true())&quot;/>&#xa;                        &lt;/tns:ContenutoWLRAggiuntivi>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($DynamicProcess/tns:WLR/tns:STS)&quot;>&#xa;                    &lt;tns:ContenutoWLRSTS>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($DynamicProcess/tns:WLR/tns:STS/ns2:REGOLATORIO, true(),true())&quot;/>&#xa;                    &lt;/tns:ContenutoWLRSTS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:Request>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione='ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;>&#xa;                            &lt;lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/lavorazione&quot;/>&#xa;                            &lt;/lavorazione>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;>&#xa;                            &lt;lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Lavorazione&quot;/>&#xa;                            &lt;/lavorazione>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/progressivoRichiestaFile&quot;>&#xa;                    &lt;progressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/progressivoRichiestaFile&quot;/>&#xa;                    &lt;/progressivoRichiestaFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/strutturaRichiesta&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/tipoRichiesta&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codiceOrdineOLO&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartSubProcessMigrazione.parameters/tns1:Richiesta/codiceOrdineOLOPadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                