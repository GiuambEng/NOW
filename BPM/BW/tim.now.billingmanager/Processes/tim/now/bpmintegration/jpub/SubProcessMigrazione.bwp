                                                                                                                                        &lt;!--&quot;[Bug 44211][SM_11060] EVO C06 2023: Implementazione logica per scenario NPSUWRL CESSAZIONE Aggiuntivi WLR&quot;-->&lt;xsl:when test=&quot;string-length($StartSubProcessMigrazione/parameters/tns1:Request/tns1:Asset[1]/dettaglioasset[nomeComponente='AGGIUNTIVO']/nomeComponente)>0 and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/tipologiaScenario='NPSUWLR' and $StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/tns1:Request/tns1:Richiesta/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$StartSubProcessMigrazione/parameters/t