xsl:for-each&gt;&lt;xsl:for-each select="ns:STS"&gt;&lt;STS&gt;&lt;TIPO_AZIONE&gt;&lt;xsl:value-of select="TIPO_AZIONE"/&gt;&lt;/TIPO_AZIONE&gt;&lt;FLAG_LINEA_NUM_AGG&gt;&lt;xsl:value-of select="FLAG_LINEA_NUM_AGG"/&gt;&lt;/FLAG_LINEA_NUM_AGG&gt;&lt;ID_RIS_AGGIUNTIVA&gt;&lt;xsl:value-of select="ID_RIS_AGGIUNTIVA"/&gt;&lt;/ID_RIS_AGGIUNTIVA&gt;&lt;CODE_STS&gt;&lt;xsl:value-of select="CODE_STS"/&gt;&lt;/CODE_STS&gt;&lt;/STS&gt;&lt;/xsl:for-each&gt;&lt;/ACCESSO&gt;&lt;/xsl:for-each&gt;&lt;/TESTATA&gt;&lt;/xsl:for-each&gt;&lt;/REGOLATORIO&gt;&lt;/tns0:ORDINE&gt;&lt;/tns0:ricezioneElement&gt;&lt;/parameters&gt;&lt;/ns1:OrdineRegolatorioCRMNOW_ricezione&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:import-schema namespace=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; schema-location=&quot;../../../../../Schemas/JPUB/OrdiniCRMWS_Reg_2.23.xsd&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_ORDINE_CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:ORDINEAGGIUNTIVI[1]/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:ORDINEAGGIUNTIVI[1]/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns0:ID_ORDINE_CRM>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:ORDINEAGGIUNTIVI/ns:REGOLATORIO/ns:TESTATA&quot;>&#xa;                        &lt;TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                            &lt;xsl:for-each select=&quot;ns:ACCESSO&quot;>&#xa;                                &lt;ACCESSO>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_PREST_AGG&quot;/>&#xa;                                    &lt;/CODE_PREST