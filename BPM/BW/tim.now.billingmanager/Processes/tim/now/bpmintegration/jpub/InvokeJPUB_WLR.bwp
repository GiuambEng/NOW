                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:import-schema namespace=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; schema-location=&quot;../../../../../Schemas/JPUB/OrdiniCRMWS_Reg_2.23.xsd&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUBNumberWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns:RETURN_CODE)>0 and exists($Start/tns:ORDINEAGGIUNTIVI/ns1:REGOLATORIO)&quot;>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:ORDINEAGGIUNTIVI[1]/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:ORDINEAGGIUNTIVI[1]/ns1:REGOLATORIO/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns:ORDINE/ns1:REGOLATORIO)&quot;>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &