                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="MappingNGA_XDSLInvoke"/&gt;
    &lt;xsl:template name="ErrorJPUBXDSL-input" match="/"&gt;
        &lt;tns6:ErrorSchemaRequest&gt;
            &lt;Input&gt;
                &lt;tns5:ErrorInput&gt;
                    &lt;tns5:TRANSACTION_DATE&gt;
                        &lt;xsl:value-of select="xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))"/&gt;
                    &lt;/tns5:TRANSACTION_DATE&gt;
                    &lt;tns5:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="concat($_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;
                    &lt;/tns5:TRANSACTION_ID&gt;
                    &lt;tns5:ORDINE&gt;
                        &lt;xsl:copy-of select="$MappingNGA_XDSLInvoke/output/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS"/&gt;
                    &lt;/tns5:ORDINE&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
                                &lt;tns5:ID_RICH_OLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                                &lt;/tns5:ID_RICH_OLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')"&gt;
                                    &lt;tns5:ID_RICH_OLO&gt;
                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')"/&gt;
                                    &lt;/tns5:ID_RICH_OLO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="not(contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS, 'pvm:'))"&gt;
                                            &lt;tns5:ID_RICH_OLO&gt;
                                                &lt;xsl:value-of select="'EVENTJPUB'"/&gt;
                                            &lt;/tns5:ID_RICH_OLO&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                                &lt;tns5:ID_RICH_OLO&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                                &lt;/tns5:ID_RICH_OLO&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns5:ErrorInput&gt;
            &lt;/Input&gt;
        &lt;/tns6:ErrorSchemaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorJPUBXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ErrorInput>&#xa;            &lt;tns5:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;            &lt;/tns5:TRANSACTION_DATE>&#xa;            &lt;tns5:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns5:TRANSACTION_ID>&#xa;            &lt;tns5:ORDINE>&#xa;                &lt;xsl:copy-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS&quot;/>&#xa;            &lt;/tns5:ORDINE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                        &lt;tns5:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns5:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;>&#xa;                            &lt;tns5:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&#xa;                            &lt;/tns5:ID_RICH_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;not(contains($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS, 'pvm:'))&quot;>&#xa;                                    &lt;tns5:ID_RICH_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;'EVENTJPUB'&quot;/>&#xa;                                    &lt;/tns5:ID_RICH_OLO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                        &lt;tns5:ID_RICH_OLO>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                        &lt;/tns5:ID_RICH_OLO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="Empty2ToErrorJPUBXDSL"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ErrorJPUBXDSLToUpdateDA_INVIARE_TRANSACTIONIDNull">
