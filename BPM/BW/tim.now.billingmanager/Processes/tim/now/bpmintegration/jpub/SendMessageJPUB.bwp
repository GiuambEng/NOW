                            &lt;/tns:ContenutoREG&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($Mapper)"&gt;
                            &lt;xsl:if test="$Mapper/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE"&gt;
                                &lt;tns:TIPO_AZIONE&gt;
                                    &lt;xsl:value-of select="$Mapper/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE"/&gt;
                                &lt;/tns:TIPO_AZIONE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$Mapper1/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE"&gt;
                                &lt;tns:TIPO_AZIONE&gt;
                                    &lt;xsl:value-of select="$Mapper1/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE"/&gt;
                                &lt;/tns:TIPO_AZIONE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($Mapper)"&gt;
                            &lt;xsl:if test="$Mapper/ns2:TESTATA[1]/CODE_CAUS"&gt;
                                &lt;tns:CODE_CAUS&gt;
                                    &lt;xsl:value-of select="$Mapper/ns2:TESTATA[1]/CODE_CAUS"/&gt;
                                &lt;/tns:CODE_CAUS&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$Mapper1/ns2:TESTATA[1]/CODE_CAUS"&gt;
                                &lt;tns:CODE_CAUS&gt;
                                    &lt;xsl:value-of select="$Mapper1/ns2:TESTATA[1]/CODE_CAUS"/&gt;
                                &lt;/tns:CODE_CAUS&gt;
