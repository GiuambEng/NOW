            <bpws:invoke inputVariable="Invoke1-input" name="Invoke1"
                operation="MappingREG_NP" outputVariable="Invoke1"
                partnerLink="MappingREG_NP"
                portType="ns158:MappingREG_NPPortType" tibex:xpdlId="a07241a4-ea0f-4e6a-b2d2-5eba1a477cd7">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:template name="Invoke1-input" match="/"&gt;
        &lt;tns2:MappingREG_NPRequest&gt;
            &lt;input&gt;
                &lt;tns3:SendJPUBRequest&gt;
                    &lt;tns3:Stato&gt;
                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Stato"/&gt;
                    &lt;/tns3:Stato&gt;
                    &lt;tns3:BPMRequest&gt;
                        &lt;tns3:Richiesta&gt;
                            &lt;created&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/created"/&gt;
                            &lt;/created&gt;
                            &lt;lastUpdate&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lastUpdate"/&gt;
                            &lt;/lastUpdate&gt;
                            &lt;operatore&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatore"/&gt;
                            &lt;/operatore&gt;
                            &lt;IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                            &lt;/IDRichiestaOLO&gt;
                            &lt;statoRichiestaNOW&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW"/&gt;
                            &lt;/statoRichiestaNOW&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW"&gt;
                                &lt;statoRichiestaPrecedNOW&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW"/&gt;
                                &lt;/statoRichiestaPrecedNOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO"&gt;
                                &lt;statoRichiestaOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO"/&gt;
                                &lt;/statoRichiestaOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO"&gt;
                                &lt;statoRichiestaPrecedOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO"/&gt;
                                &lt;/statoRichiestaPrecedOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/sottostatoLavorManuale"&gt;
                                &lt;sottostatoLavorManuale&gt;
