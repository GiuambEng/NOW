/IDCorrelazione&quot;/>&#xa;                                &lt;/IDCorrelazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/totaleRichiestePacchetto&quot;>&#xa;                                &lt;totaleRichiestePacchetto>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                                &lt;/totaleRichiestePacchetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/tipoPacchetto&quot;>&#xa;                                &lt;tipoPacchetto>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/tipoPacchetto&quot;/>&#xa;                                &lt;/tipoPacchetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDPacchettoNOW&quot;>&#xa;                                &lt;IDPacchettoNOW>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDPacchettoNOW&quot;/>&#xa;                                &lt;/IDPacchettoNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/contenutoXML&quot;>&#xa;                                &lt;contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/contenutoXML&quot;/>&#xa;                                &lt;/contenutoXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/note&quot;>&#xa;                                &lt;note>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/note&quot;/>&#xa;                                &lt;/note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine)&quot;>&#xa;                                &lt;ordine>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/offertaCatalogo&quot;>&#xa;                                        &lt;offertaCatalogo>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/offertaCatalogo&quot;/>&#xa;                                        &lt;/offertaCatalogo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DAC&quot;>&#xa;                                        &lt;DAC>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DAC&quot;/>&#xa;                                        &lt;/DAC>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DACRimodulata&quot;>&#xa;                                        &lt;DACRimodulata>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DACRimodulata&quot;/>&#xa;                                        &lt;/DACRimodulata>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DAD&quot;>&#xa;                                        &lt;DAD>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DAD&quot;/>&#xa;                                        &lt;/DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DPP&quot;>&#xa;                                        &lt;DPP>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DPP&quot;/>&#xa;                                        &lt;/DPP>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DUVO&quot;>&#xa;                                        &lt;DUVO>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/DUVO&quot;/>&#xa;                                        &lt;/DUVO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dataChiusuraOrdine&quot;>&#xa;                                        &lt;dataChiusuraOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dataChiusuraOrdine&quot;/>&#xa;                                        &lt;/dataChiusuraOrdine>&#xa;                                    &lt;/xsl:if>&#xa;    