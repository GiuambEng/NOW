                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDConsuntivo"/&gt;
                                        &lt;/IDConsuntivo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/noteAltreLavorazioni"&gt;
                                        &lt;noteAltreLavorazioni&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/noteAltreLavorazioni"/&gt;
                                        &lt;/noteAltreLavorazioni&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codicePacchettoNOW"&gt;
                                        &lt;codicePacchettoNOW&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codicePacchettoNOW"/&gt;
                                        &lt;/codicePacchettoNOW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/assetTarget"/&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatoreRete"&gt;
                                        &lt;operatoreRete&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatoreRete"/&gt;
                                        &lt;/operatoreRete&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/transactionIDLocator"&gt;
                                        &lt;transactionIDLocator&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/transactionIDLocator"/&gt;
                                        &lt;/transactionIDLocator&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagNumAggiuntive"&gt;
                                        &lt;flagNumAggiuntive&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagNumAggiuntive"/&gt;
                                        &lt;/flagNumAggiuntive&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDAnagraficaCausaleGUI"&gt;
                                        &lt;IDAnagraficaCausaleGUI&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDAnagraficaCausaleGUI"/&gt;
                                        &lt;/IDAnagraficaCausaleGUI&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns6:Richiesta&gt;
                            &lt;/tns6:BPMRequest&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Operespeciali)&gt;0"&gt;
                            &lt;tns6:FlagOpereSpeciali&gt;
                                &lt;xsl:value-of select="true()"/&gt;
                            &lt;/tns6:FlagOpereSpeciali&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns6:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns5:DeleteRecordRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DeleteRecord/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/DeleteRecord/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DeleteRecord-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO) or exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS)&quot;>&#xa;                    &lt;tns6:Timer>&#xa;                        &lt;tns6:Timer>&#xa;                            &lt;xsl:value-of select=&quot;'Timer per Risottomissione o Invio'&quot;/>&#xa;                        &lt;/tns6:Timer>&#xa;                    &lt;/tns6:Timer>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;tns6:BPMRequest>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '-')&quot;>&#xa;                                        &lt;tns6:ID_RICH_OLO>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&#xa;                                        &lt;/tns6:ID_RICH_OLO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_A')&quot;>&#xa;                                                &lt;tns6:ID_RICH_OLO>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')&quot;/>&#xa;                                                &lt;/tns6:ID_RICH_OLO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns6:ID_RICH_OLO>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R')&quot;/>&#xa;                                                &lt;/tns6:ID_RICH_OLO>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')&quot;/>&#xa;                                &lt;/tns6:ID_RICH_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns6:BPMRequest>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS)&quot;>&#xa;                    &lt;tns6:BPMRequest>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;tns6:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&#xa;                                &lt;/tns6:ID_RICH_OLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')&quot;/>&#xa;                                &lt;/tns6:ID_RICH_OLO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns6:BPMRequest>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns6:BPMRequest>&#xa;                        &lt;tns6:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns6:ID_RICH_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0 and contains($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync,'_A')&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                    &lt;tns6:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns6:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0 and not(contains($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync,'_S')))  and (string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                    &lt;tns6:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns6:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;>&#xa;                                    &lt;tns6:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/tns6:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns6:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns6:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW='ANNULLATO' or string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:Asset>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDAsset&quot;>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;codiceOrdineOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/codiceOrdineOLO>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/codiceOrdineTI&quot;>&#xa;                                        &lt;codiceOrdineTI>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/codiceOrdineTI&quot;/>&#xa;                                        &lt;/codiceOrdineTI>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;codificaOLOAGCOM>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/codificaOLOAGCOM>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/invariante&quot;>&#xa;                                        &lt;invariante>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/invariante&quot;/>&#xa;                                        &lt;/invariante>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDRichiestaOLO&quot;>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDPrimoOrdine&quot;>&#xa;                                        &lt;IDPrimoOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDPrimoOrdine&quot;/>&#xa;                                        &lt;/IDPrimoOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;IDContratto>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDContratto&quot;/>&#xa;                                    &lt;/IDContratto>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/DEC&quot;>&#xa;                                        &lt;DEC>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/DEC&quot;/>&#xa;                                        &lt;/DEC>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;statoAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/statoAsset&quot;/>&#xa;                                    &lt;/statoAsset>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/numeroTelefonico&quot;>&#xa;                                        &lt;numeroTelefonico>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/numeroTelefonico&quot;/>&#xa;                                        &lt;/numeroTelefonico>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDAssetCRMWS&quot;>&#xa;                                        &lt;IDAssetCRMWS>&#xa;                                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDAssetCRMWS&quot;/>&#xa;                                        &lt;/IDAssetCRMWS>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDAssetDa&quot;>&#xa;                                        &lt;IDAssetDa>&#xa;                                            &lt;xsl:value-of