                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:UPDATEGestioneFatturazioneRequest&gt;
            &lt;/input&gt;
        &lt;/tns5:UPDATEGestioneFatturazioneRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
