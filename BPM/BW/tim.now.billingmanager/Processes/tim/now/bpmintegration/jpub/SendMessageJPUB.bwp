                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingNumeroPrincipale.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInsertStagingNumeroPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InsertStagingNumeroPrincipale: &amp;quot;, tib:render-xml($InsertStagingNumeroPrincipale.RESPONSE))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="MappingREG_NPInvoke-input"
                name="MappingREG_NPInvoke" operation="MappingREG_NP"
                outputVariable="MappingREG_NPInvoke"
                partnerLink="MappingREG_NP"
                portType="ns158:MappingREG_NPPortType" tibex:xpdlId="a89e78c7-3c0e-4ed4-bae4-6791547212aa">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns5="http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:template name="MappingREG_NPInvoke-input" match="/"&gt;
        &lt;tns5:MappingREG_NPRequest&gt;
            &lt;input&gt;
                &lt;tns3:SendJPUBRequest&gt;
                    &lt;tns3:Stato&gt;
                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Stato"/&gt;
                    &lt;/tns3:Stato&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                            &lt;tns3:BPMRequest&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta"/&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset"/&gt;
                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Flag_OpereSpeciali"&gt;
                                    &lt;tns3:Flag_OpereSpeciali&gt;
                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Flag_OpereSpeciali"/&gt;
                                    &lt;/tns3:Flag_OpereSpeciali&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:AssetCorrelatiAttivi"/&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:AssetCorrelatiCessati"/&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:AssetCorrelatiVariati"/&gt;
                                &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:AssetRicarica"/&gt;
                                &lt;xsl:if test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0"&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync"&gt;
                                        &lt;tns3:NPSync&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync"/&gt;
                                        &lt;/tns3:NPSync&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:DataInizioNol)"&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:DataInizioNol"&gt;
                                        &lt;tns3:DataInizioNol&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:DataInizioNol"/&gt;
                                        &lt;/tns3:DataInizioNol&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NewBilling)&gt;0"&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NewBilling"&gt;
                                        &lt;tns3:NewBilling&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NewBilling"/&gt;
                                        &lt;/tns3:NewBilling&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:for-each select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:ID_RECUPERO_JPUB_MASTER"&gt;
                                    &lt;tns3:ID_RECUPERO_JPUB_MASTER&gt;
                                        &lt;xsl:if test="tns3:ID_RECUPERO_JPUB_MASTER"&gt;
                                            &lt;tns3:ID_RECUPERO_JPUB_MASTER&gt;
                                                &lt;xsl:value-of select="tns3:ID_RECUPERO_JPUB_MASTER"/&gt;
                                            &lt;/tns3:ID_RECUPERO_JPUB_MASTER&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="tns3:BDS_ID"&gt;
                                            &lt;tns3:BDS_ID&gt;
                                                &lt;xsl:value-of select="tns3:BDS_ID"/&gt;
                                            &lt;/tns3:BDS_ID&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:ID_RECUPERO_JPUB_MASTER&gt;
                                &lt;/xsl:for-each&gt;
                            &lt;/tns3:BPMRequest&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)"&gt;
                            &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS"/&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:StatoNP"/&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer"&gt;
                        &lt;tns3:NPTimer&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer"/&gt;
                        &lt;/tns3:NPTimer&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:WLRTimer"&gt;
                        &lt;tns3:WLRTimer&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:WLRTimer"/&gt;
                        &lt;/tns3:WLRTimer&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Operespeciali"&gt;
                        &lt;tns3:Operespeciali&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Operespeciali"/&gt;
                        &lt;/tns3:Operespeciali&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Asset"/&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Lavorazione"&gt;
                        &lt;tns3:Lavorazione&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Lavorazione"/&gt;
                        &lt;/tns3:Lavorazione&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:LavorazioniIndotteAttivazione"&gt;
                        &lt;tns3:LavorazioniIndotteAttivazione&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:LavorazioniIndotteAttivazione"/&gt;
                        &lt;/tns3:LavorazioniIndotteAttivazione&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:RecordAssetIndottoCessato"/&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:FlagAssetMigrati"&gt;
                        &lt;tns3:FlagAssetMigrati&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:FlagAssetMigrati"/&gt;
                        &lt;/tns3:FlagAssetMigrati&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:IDEventoOrdnTimer"&gt;
                        &lt;tns3:IDEventoOrdnTimer&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:IDEventoOrdnTimer"/&gt;
                        &lt;/tns3:IDEventoOrdnTimer&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPSYNCREG"&gt;
                        &lt;tns3:NPSYNCREG&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPSYNCREG"/&gt;
                        &lt;/tns3:NPSYNCREG&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns3:SendJPUBRequest&gt;
            &lt;/input&gt;
        &lt;/tns5:MappingREG_NPRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns5=&quot;http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingREG_NPInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SendJPUBRequest>&#xa;            &lt;tns3:Stato>&#xa;                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:Stato&quot;/>&#xa;            &lt;/tns3:Stato>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;tns3:BPMRequest>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset&quot;/>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Flag_OpereSpeciali&quot;>&#xa;                            &lt;tns3:Flag_OpereSpeciali>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Flag_OpereSpeciali&quot;/>&#xa;                            &lt;/tns3:Flag_OpereSpeciali>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:AssetCorrelatiAttivi&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:AssetCorrelatiCessati&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:AssetCorrelatiVariati&quot;/>&#xa;                        &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:AssetRicarica&quot;/>&#xa;                        &lt;xsl:if test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync&quot;>&#xa;                                &lt;tns3:NPSync>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync&quot;/>&#xa;                                &lt;/tns3:NPSync>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:DataInizioNol)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:DataInizioNol&quot;>&#xa;                                &lt;tns3:DataInizioNol>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:DataInizioNol&quot;/>&#xa;                                &lt;/tns3:DataInizioNol>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NewBilling)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:NewBilling&quot;>&#xa;                                &lt;tns3:NewBilling>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:NewBilling&quot;/>&#xa;                                &lt;/tns3:NewBilling>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                            &lt;tns3:ID_RECUPERO_JPUB_MASTER>&#xa;                                &lt;xsl:if test=&quot;tns3:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                                    &lt;tns3:ID_RECUPERO_JPUB_MASTER>&#xa;                                        &lt;xsl:value-of select=&quot;tns3:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                                    &lt;/tns3:ID_RECUPERO_JPUB_MASTER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns3:BDS_ID&quot;>&#xa;                                    &lt;tns3:BDS_ID>&#xa;                                        &lt;xsl:value-of select=&quot;tns3:BDS_ID&quot;/>&#xa;                                    &lt;/tns3:BDS_ID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns3:ID_RECUPERO_JPUB_MASTER>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns3:BPMRequest>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters/tns3:StatoNP&quot;/>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:NPTimer&quot;>&#xa;                &lt;tns3:NPTimer>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:NPTimer&quot;/>&#xa;                &lt;/tns3:NPTimer>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:WLRTimer&quot;>&#xa;                &lt;tns3:WLRTimer>&#xa;                    &lt;xsl:value-of sel