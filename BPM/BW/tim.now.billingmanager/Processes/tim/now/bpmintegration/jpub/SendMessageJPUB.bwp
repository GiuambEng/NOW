                                <bpws:reply name="ReplyJPUBCatch"
                                    operation="SendJPUB"
                                    partnerLink="SendJPUB"
                                    portType="ns1:SendJPUB"
                                    tibex:xpdlId="74e4267b-00b1-45ec-91a5-9bcb250749d4" variable="ReplyJPUBCatch-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns2="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" version="2.0"&gt;
    &lt;xsl:param name="ErrorJPUBXDSL"/&gt;
    &lt;xsl:param name="ErrorJPUBREG"/&gt;
    &lt;xsl:param name="ErrorOpereSpeciali"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:param name="InvokeJPUB_WLR"/&gt;
    &lt;xsl:template name="ReplyJPUBCatch-input" match="/"&gt;
        &lt;tns6:SendJPUBResponse&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$ErrorJPUBXDSL/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorOpereSpeciali/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null'"&gt;
                        &lt;tns3:SendJPUBResponse&gt;
                            &lt;tns3:code&gt;
                                &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                            &lt;/tns3:code&gt;
                            &lt;tns3:msg&gt;
                                &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                            &lt;/tns3:msg&gt;
                            &lt;xsl:if test="exists($ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:NumeriAggiuntivi)"&gt;
                                &lt;xsl:for-each select="$ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:NumeriAggiuntivi"&gt;
                                    &lt;tns3:Response_Aggiuntivi&gt;
                                        &lt;tns3:code&gt;
                                            &lt;xsl:value-of select="tns2:code"/&gt;
                                        &lt;/tns3:code&gt;
                                        &lt;tns3:msg&gt;
                                            &lt;xsl:value-of select="tns2:msg"/&gt;
                                        &lt;/tns3:msg&gt;
                                        &lt;tns3:Identificativo&gt;
                                            &lt;xsl:value-of select="tns2:identificativo"/&gt;
                                        &lt;/tns3:Identificativo&gt;
                                    &lt;/tns3:Response_Aggiuntivi&gt;
                                &lt;/xsl:for-each&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns3:IDRisorsa&gt;
                                &lt;xsl:value-of select="'X'"/&gt;
                            &lt;/tns3:IDRisorsa&gt;
                            &lt;xsl:if test="(string-length($InvokeJPUB_WLR/tns3:IDRichOLO)&gt;0 and  $InvokeJPUB_WLR/tns3:IDRichOLO='XX') or (string-length($ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:RETURN_CODE)&gt;0)"&gt;
                                &lt;tns3:IDRichOLO&gt;
                                    &lt;xsl:value-of select="'Accesso Inviato'"/&gt;
                                &lt;/tns3:IDRichOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="exists($UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS)"&gt;
                                &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                                    &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                        &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                                    &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns3:SendJPUBResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns3:SendJPUBResponse&gt;
                            &lt;tns3:code&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns3:code&gt;
                            &lt;tns3:msg&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns3:msg&gt;
                            &lt;xsl:if test="exists($ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:NumeriAggiuntivi)"&gt;
                                &lt;xsl:for-each select="$ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:NumeriAggiuntivi"&gt;
                                    &lt;tns3:Response_Aggiuntivi&gt;
                                        &lt;tns3:code&gt;
                                            &lt;xsl:value-of select="tns2:code"/&gt;
                                        &lt;/tns3:code&gt;
                                        &lt;tns3:msg&gt;
                                            &lt;xsl:value-of select="tns2:msg"/&gt;
                                        &lt;/tns3:msg&gt;
                                        &lt;tns3:Identificativo&gt;
                                            &lt;xsl:value-of select="tns2:identificativo"/&gt;
                                        &lt;/tns3:Identificativo&gt;
                                    &lt;/tns3:Response_Aggiuntivi&gt;
                                &lt;/xsl:for-each&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="exists($UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS)"&gt;
                                &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                                    &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                        &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                                    &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns3:SendJPUBResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns6:SendJPUBResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBXDSL.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorOpereSpeciali.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyJPUBCatch-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ErrorJPUBXDSL.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorOpereSpeciali.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null'&quot;>&#xa;                &lt;tns3:SendJPUBResponse>&#xa;                    &lt;tns3:code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns3:code>&#xa;                    &lt;tns3:msg>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns3:msg>&#xa;                    &lt;xsl:if test=&quot;exists($ErrorJPUBREG.Output/tns2:NumeriAggiuntivi)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ErrorJPUBREG.Output/tns2:NumeriAggiuntivi&quot;>&#xa;                            &lt;tns3:Response_Aggiuntivi>&#xa;                                &lt;tns3:code>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:code&quot;/>&#xa;                                &lt;/tns3:code>&#xa;                                &lt;tns3:msg>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:msg&quot;/>&#xa;                                &lt;/tns3:msg>&#xa;                                &lt;tns3:Identificativo>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:identificativo&quot;/>&#xa;                                &lt;/tns3:Identificativo>&#xa;                            &lt;/tns3:Response_Aggiuntivi>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns3:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                    &lt;/tns3:IDRisorsa>&#xa;                    &lt;xsl:if test=&quot;(string-length($InvokeJPUB_WLR/tns3:IDRichOLO)>0 and  $InvokeJPUB_WLR/tns3:IDRichOLO='XX') or (string-length($ErrorJPUBREG.Output/tns2:ErrorO/tns2:RETURN_CODE)>0)&quot;>&#xa;                        &lt;tns3:IDRichOLO>&#xa;                            &lt;xsl:value-of select=&quot;'Accesso Inviato'&quot;/>&#xa;                        &lt;/tns3:IDRichOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                            &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                            &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:SendJPUBResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:SendJPUBResponse>&#xa;                    &lt;tns3:code>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns3:code>&#xa;                    &lt;tns3:msg>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns3:msg>&#xa;                    &lt;xsl:if test=&quot;exists($ErrorJPUBREG.Output/tns2:NumeriAggiuntivi)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ErrorJPUBREG.Output/tns2:NumeriAggiuntivi&quot;>&#xa;                            &lt;tns3:Response_Aggiuntivi>&#xa;                                &lt;tns3:code>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:code&quot;/>&#xa;                                &lt;/tns3:code>&#xa;                                &lt;tns3:msg>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:msg&quot;/>&#xa;                                &lt;/tns3:msg>&#xa;                                &lt;tns3:Identificativo>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:identificativo&quot;/>&#xa;                                &lt;/tns3:Identificativo>&#xa;                            &lt;/tns3:Response_Aggiuntivi>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                            &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                            &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:SendJPUBResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="Empty8ToReplyJPUBCatch"/>
                                    <bpws:target linkName="CallProcess1ToReplyJPUBCatch"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ReplyToExit"/>
                                    </bpws:sources>
                                </bpws:reply>
                                <bpws:invoke
                                    inputVariable="UpdateStaging-input"
                                    name="UpdateStaging"
                                    operation="InsertUpdateStaging"
                                    outputVariable="UpdateStaging"
                                    partnerLink="StagingProcessManager"
                                    portType="ns24:InsertUpdateStagingPortType" tibex:xpdlId="0e50634f-06ea-4b65-a06d-97880a296b15">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns6="http://www.tim.com/NOW/xsd/ErrorSchema/" version="2.0"&gt;
    &lt;xsl:param name="InsertStagingNumeroPrincipale"/&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:param name="SendMessageJPUB_XDSL"/&gt;
    &lt;xsl:param name="ErrorOpereSpeciali"/&gt;
    &lt;xsl:param name="ErrorJPUBXDSL"/&gt;
    &lt;xsl:param name="ErrorJPUBREG"/&gt;
    &lt;xsl:param name="FaultDetails1"/&gt;
    &lt;xsl:param name="ParseStaging"/&gt;
    &lt;xsl:template name="UpdateStaging-input" match="/"&gt;
        &lt;tns7:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_DATE)&gt;0"&gt;
                                &lt;xsl:if test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"&gt;
                                    &lt;tns5:CONTENUTO_RESPONSE&gt;
                                        &lt;xsl:value-of select="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"/&gt;
                                    &lt;/tns5:CONTENUTO_RESPONSE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="string-length($ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_DATE)&gt;0"&gt;
                                &lt;xsl:if test="$ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"&gt;
                                    &lt;tns5:CONTENUTO_RESPONSE&gt;
                                        &lt;xsl:value-of select="$ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"/&gt;
                                    &lt;/tns5:CONTENUTO_RESPONSE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="string-length($ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_DATE)&gt;0"&gt;
                                &lt;xsl:if test="$ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"&gt;
                                    &lt;tns5:CONTENUTO_RESPONSE&gt;
                                        &lt;xsl:value-of select="$ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:CONTENUTO_RESPONSE"/&gt;
                                    &lt;/tns5:CONTENUTO_RESPONSE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null'"&gt;
                                &lt;tns5:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="concat('Chiamata con JPUB non riuscita',$FaultDetails1/ActivityName, $FaultDetails1/Msg,$FaultDetails1/MsgCode,$FaultDetails1/ProcessStack,$FaultDetails1/StackTrace)"/&gt;
                                &lt;/tns5:DESCR_ERRORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns5:DESCR_ERRORE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null'"&gt;
                                &lt;tns5:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="12"/&gt;
                                &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="11"/&gt;
                                &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RISPOSTA&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns3:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaProcesso&gt;
                        &lt;ns3:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaOperazione&gt;
                        &lt;ns3:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($ParseStaging/tns5:LogResponse)"&gt;
                                    &lt;xsl:if test="$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns3:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns3:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns3:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns3:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($ParseStaging/tns5:LogResponse)"&gt;
                                    &lt;ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($ParseStaging/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))"/&gt;
                                    &lt;/ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))"/&gt;
                                    &lt;/ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO) or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot; or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPNG&amp;quot;"&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_XDSL"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null'"&gt;
                                    &lt;ns3:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                                    &lt;/ns3:STATO_ESEC&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                                    &lt;/ns3:STATO_ESEC&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns3:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TMSP_FINE_ELAB&gt;
                        &lt;/ns3:EsecuzioneNOFileProcessato&gt;
                        &lt;ns3:LogFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null'"&gt;
                                    &lt;ns3:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'ERROR'"/&gt;
                                    &lt;/ns3:LOG_LEVEL&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'INFO'"/&gt;
                                    &lt;/ns3:LOG_LEVEL&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorOpereSpeciali/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL/Output/tns6:ErrorOutput/tns6:ErrorO/tns6:TRANSACTION_ID='Null'"&gt;
                                    &lt;ns3:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;
                                    &lt;/ns3:LOG_MESSAGE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                                    &lt;/ns3:LOG_MESSAGE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns3:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TIMSTP_INSMTO&gt;
                        &lt;/ns3:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns7:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingNumeroPrincipale.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBXDSL.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorOpereSpeciali.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_DATE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;>&#xa;                            &lt;tns5:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;/>&#xa;                            &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_DATE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;>&#xa;                            &lt;tns5:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;/>&#xa;                            &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_DATE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorJPUBREG.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;>&#xa;                            &lt;tns5:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorJPUBREG.Output/tns6:ErrorO/tns6:CONTENUTO_RESPONSE&quot;/>&#xa;                            &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null'&quot;>&#xa;                        &lt;tns5:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;concat('Chiamata con JPUB non riuscita',$FaultDetails1/ActivityName, $FaultDetails1/Msg,$FaultDetails1/MsgCode,$FaultDetails1/ProcessStack,$FaultDetails1/StackTrace)&quot;/>&#xa;                        &lt;/tns5:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns5:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null'&quot;>&#xa;                        &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                        &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RISPOSTA>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns3:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaProcesso>&#xa;                &lt;ns3:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaOperazione>&#xa;                &lt;ns3:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseStaging/tns5:LogResponse)&quot;>&#xa;                            &lt;xsl:if test=&quot;$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns3:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns3:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns3:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns3:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseStaging/tns5:LogResponse)&quot;>&#xa;                            &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($ParseStaging/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO) or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot; or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_XDSL&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null'&quot;>&#xa;                            &lt;ns3:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/ns3:STATO_ESEC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                            &lt;/ns3:STATO_ESEC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns3:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TMSP_FINE_ELAB>&#xa;                &lt;/ns3:EsecuzioneNOFileProcessato>&#xa;                &lt;ns3:LogFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null'&quot;>&#xa;                            &lt;ns3:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                            &lt;/ns3:LOG_LEVEL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                            &lt;/ns3:LOG_LEVEL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorOpereSpeciali.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns6:ErrorO/tns6:TRANSACTION_ID = &amp;quot;Null&amp;quot; or $ErrorJPUBXDSL.Output/tns6:ErrorO/tns6:TRANSACTION_ID='Null'&quot;>&#xa;                            &lt;ns3:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns3:LOG_MESSAGE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns3:LOG_MESSAGE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns3:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TIMSTP_INSMTO>&#xa;                &lt;/ns3:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="FaultErrorREGToInvoke"/>
                                    <bpws:target linkName="LogControlloXDSLToUpdateStaging"/>
                                    <bpws:target linkName="LogControlloRegToUpdateStaging"/>
                                    <bpws:target linkName="Empty11ToUpdateStaging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateStagingToCallProcess"/>
                                    <bpws:source
                                    linkName="UpdateStagingToCallProcess1"
                                    tibex:faultDetailsVar="UpdateStaging" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                </bpws:invoke>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;UpdateStaging&amp;quot;, tib:render-xml($UpdateStaging/RESPONSE/tns2:StagingResponse, true(),true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogUpdateStaging-input"
                                    name="LogUpdateStaging"
                                    tibex:xpdlId="92390d06-c10d-4eb9-80ae-4a1595b51da8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateStagingToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogUpdateStagingToEmpty8"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns5:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns5:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;UpdateStaging&amp;quot;, tib:render-xml($UpdateStaging.RESPONSE, true(),true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/MsgCode,$_error/Class,$_error/FullClass,$_error/StackTrace,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogFaultUpdateStaging-input"
                                    name="LogFaultUpdateStaging"
                                    tibex:xpdlId="fdee6e41-d751-4c57-a305-eafa208dbd3b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateStagingToCallProcess1"/>
                                    <bpws:target linkName="InvokeToLogFaultUpdateStaging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToReply"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/MsgCode,$_error/Class,$_error/FullClass,$_error/StackTrace,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:reply name="Reply"
                                    operation="SendJPUB"
                                    partnerLink="SendJPUB"
                                    portType="ns1:SendJPUB"
                                    tibex:xpdlId="fd7a09a2-a254-4712-936f-d5a7a75bd5f1" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns2="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" version="2.0"&gt;
    &lt;xsl:param name="ErrorJPUBREG"/&gt;
    &lt;xsl:param name="ErrorJPUBXDSL"/&gt;
    &lt;xsl:param name="ErrorOpereSpeciali"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:param name="InvokeJPUB_WLR"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns6:SendJPUBResponse&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$ErrorJPUBXDSL/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorOpereSpeciali/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID='Null'"&gt;
                        &lt;tns3:SendJPUBResponse&gt;
                            &lt;tns3:code&gt;
                                &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                            &lt;/tns3:code&gt;
                            &lt;tns3:msg&gt;
                                &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                            &lt;/tns3:msg&gt;
                            &lt;tns3:IDRisorsa&gt;
                                &lt;xsl:value-of select="'X'"/&gt;
                            &lt;/tns3:IDRisorsa&gt;
                            &lt;xsl:if test="(string-length($InvokeJPUB_WLR/tns3:IDRichOLO)&gt;0 and  $InvokeJPUB_WLR/tns3:IDRichOLO='XX') or (string-length($ErrorJPUBREG/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:RETURN_CODE)&gt;0)"&gt;
                                &lt;tns3:IDRichOLO&gt;
                                    &lt;xsl:value-of select="'Accesso Inviato'"/&gt;
                                &lt;/tns3:IDRichOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="exists($UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS)"&gt;
                                &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                                    &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                        &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                                    &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns3:SendJPUBResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns3:SendJPUBResponse&gt;
                            &lt;tns3:code&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns3:code&gt;
                            &lt;tns3:msg&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns3:msg&gt;
                            &lt;xsl:if test="exists($UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS)"&gt;
                                &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                                    &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                        &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                                    &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns3:SendJPUBResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns6:SendJPUBResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBXDSL.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorOpereSpeciali.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ErrorJPUBXDSL.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorJPUBREG.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null' or $ErrorOpereSpeciali.Output/tns2:ErrorO/tns2:TRANSACTION_ID='Null'&quot;>&#xa;                &lt;tns3:SendJPUBResponse>&#xa;                    &lt;tns3:code>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns3:code>&#xa;                    &lt;tns3:msg>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA, OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;                    &lt;/tns3:msg>&#xa;                    &lt;tns3:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                    &lt;/tns3:IDRisorsa>&#xa;                    &lt;xsl:if test=&quot;(string-length($InvokeJPUB_WLR/tns3:IDRichOLO)>0 and  $InvokeJPUB_WLR/tns3:IDRichOLO='XX') or (string-length($ErrorJPUBREG.Output/tns2:ErrorO/tns2:RETURN_CODE)>0)&quot;>&#xa;                        &lt;tns3:IDRichOLO>&#xa;                            &lt;xsl:value-of select=&quot;'Accesso Inviato'&quot;/>&#xa;                        &lt;/tns3:IDRichOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                            &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                            &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:SendJPUBResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:SendJPUBResponse>&#xa;                    &lt;tns3:code>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns3:code>&#xa;                    &lt;tns3:msg>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns3:msg>&#xa;                    &lt;xsl:if test=&quot;exists($UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                            &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                            &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:SendJPUBResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToReply"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ReplyToExit1"/>
                                    </bpws:sources>
                                </bpws:reply>
                                <bpws:empty name="Empty8" tibex:xpdlId="7f73e9a0-ec78-48a2-832f-7a921a8aaa3e">
                                    <bpws:targets>
                                    <bpws:target linkName="LogUpdateStagingToEmpty8"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Empty8ToReplyJPUBCatch">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty8ToInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($MappingREG_NPInvoke/output/tns3:MappingREG_NPResponse/tns3:WLR/tns3:STS) and  string-length($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($MappingREG_NPInvoke.output/tns3:WLR/tns3:STS) and  string-length($SendJPUBIn.parameters/tns1:BPMRequest/tns1:NPSync)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                </bpws:empty>
                                <bpws:invoke
                                    inputVariable="Invoke-input"
                                    name="Invoke"
                                    operation="InsertUpdateStaging"
                                    outputVariable="Invoke"
                                    partnerLink="StagingProcessManager"
                                    portType="ns24:InsertUpdateStagingPortType" tibex:xpdlId="89b1695f-b7c8-49b4-b345-877f25f6ecac">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns6="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" version="2.0"&gt;
    &lt;xsl:param name="ErrorJPUBREG"/&gt;
    &lt;xsl:param name="FaultDetails1"/&gt;
    &lt;xsl:param name="Stag"/&gt;
    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns2:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns6:StagingRequest&gt;
                    &lt;tns6:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_DATE)&gt;0"&gt;
                                &lt;xsl:if test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:CONTENUTO_RESPONSE_STS"&gt;
                                    &lt;tns6:CONTENUTO_RESPONSE&gt;
                                        &lt;xsl:value-of select="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:CONTENUTO_RESPONSE_STS"/&gt;
                                    &lt;/tns6:CONTENUTO_RESPONSE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns6:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns6:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                &lt;tns6:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="concat('Chiamata con JPUB non riuscita',$FaultDetails1/ActivityName, $FaultDetails1/Msg,$FaultDetails1/MsgCode,$FaultDetails1/ProcessStack,$FaultDetails1/StackTrace)"/&gt;
                                &lt;/tns6:DESCR_ERRORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns6:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns6:DESCR_ERRORE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                &lt;tns6:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="12"/&gt;
                                &lt;/tns6:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns6:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="11"/&gt;
                                &lt;/tns6:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns6:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns6:TIMSTP_RISPOSTA&gt;
                    &lt;/tns6:StagingOut&gt;
                    &lt;tns6:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns6:StagingType&gt;
                    &lt;tns6:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                                    &lt;/ns1:STATO_ESEC&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:STATO_ESEC&gt;
                                        &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                                    &lt;/ns1:STATO_ESEC&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'ERROR'"/&gt;
                                    &lt;/ns1:LOG_LEVEL&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:LOG_LEVEL&gt;
                                        &lt;xsl:value-of select="'INFO'"/&gt;
                                    &lt;/ns1:LOG_LEVEL&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$ErrorJPUBREG/Output/tns5:ErrorOutput/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;"&gt;
                                    &lt;ns1:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;
                                    &lt;/ns1:LOG_MESSAGE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:LOG_MESSAGE&gt;
                                        &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                                    &lt;/ns1:LOG_MESSAGE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns6:LoggerIn&gt;
                &lt;/tns6:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns2:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Stag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUBREG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:StagingRequest>&#xa;            &lt;tns6:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_DATE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:CONTENUTO_RESPONSE_STS&quot;>&#xa;                            &lt;tns6:CONTENUTO_RESPONSE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:CONTENUTO_RESPONSE_STS&quot;/>&#xa;                            &lt;/tns6:CONTENUTO_RESPONSE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                        &lt;tns6:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;concat('Chiamata con JPUB non riuscita',$FaultDetails1/ActivityName, $FaultDetails1/Msg,$FaultDetails1/MsgCode,$FaultDetails1/ProcessStack,$FaultDetails1/StackTrace)&quot;/>&#xa;                        &lt;/tns6:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                        &lt;tns6:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                        &lt;/tns6:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                        &lt;/tns6:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns6:TIMSTP_RISPOSTA>&#xa;            &lt;/tns6:StagingOut>&#xa;            &lt;tns6:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns6:StagingType>&#xa;            &lt;tns6:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Stag.RESPONSE/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:STATO_ESEC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                            &lt;/ns1:STATO_ESEC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                            &lt;/ns1:LOG_LEVEL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:LOG_LEVEL>&#xa;                                &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                            &lt;/ns1:LOG_LEVEL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ErrorJPUBREG.Output/tns5:ErrorO/tns5:TRANSACTION_ID = &amp;quot;Null&amp;quot;&quot;>&#xa;                            &lt;ns1:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML NON INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns1:LOG_MESSAGE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/ns1:LOG_MESSAGE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns6:LoggerIn>&#xa;        &lt;/tns6:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
