            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:template name=&quot;DettaglioAsset&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputDettaglio>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:AssetCorrelatiVariati/dettaglioasset[nomeComponente='ATMVC' and statoDettaglioAsset='ATTIVO']&quot;>&#xa;                &lt;tns:DettaglioAsset>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                        &lt;IDDettaglioAssetParent>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                        &lt;/IDDettaglioAssetParent>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                        &lt;IDDettaglioAssetRoot>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                        &lt;/IDDettaglioAssetRoot>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;xsl:copy-of select=&quot;attributidettaglioasset&quot;/>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                    &lt;IDDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                    &lt;/IDDettaglioAsset>&#xa;                    &lt;statoDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                    &lt;/statoDettaglioAsset>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/tns:DettaglioAsset>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:InputDettaglio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DettaglioAsset" name="CountDettaglio"
                    outputVariable="DettaglioAsset"
                    tibex:xpdlId="24e2316b-338b-4083-8d01-ee99039985b1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty4ToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToMappingNGA_XDSLInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Assign1ToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($DettaglioAsset/tns3:DettaglioAsset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($DettaglioAsset/tns3:DettaglioAsset)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DettaglioAsset&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputDettaglio>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:AssetCorrelatiVariati/dettaglioasset[nomeComponente='ATMVC' and statoDettaglioAsset='ATTIVO']&quot;>&#xa;                &lt;tns:DettaglioAsset>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                        &lt;IDDettaglioAssetParent>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                        &lt;/IDDettaglioAssetParent>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                        &lt;IDDettaglioAssetRoot>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                        &lt;/IDDettaglioAssetRoot>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;xsl:copy-of select=&quot;attributidettaglioasset&quot;/>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                    &lt;IDDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                    &lt;/IDDettaglioAsset>&#xa;                    &lt;statoDettaglioAsset>&#xa;                        &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                    &lt;/statoDettaglioAsset>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/tns:DettaglioAsset>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:InputDettaglio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DettaglioAsset" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
