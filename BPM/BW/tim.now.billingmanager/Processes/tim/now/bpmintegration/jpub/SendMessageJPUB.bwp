    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:param name="SendMessageJPUB_XDSL"/&gt;
    &lt;xsl:template name="OpereSpeciali-input" match="/"&gt;
        &lt;tns5:OpereSpecialiRequest&gt;
            &lt;input&gt;
                &lt;tns1:OpereSpecialiRequest&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                            &lt;tns1:IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
