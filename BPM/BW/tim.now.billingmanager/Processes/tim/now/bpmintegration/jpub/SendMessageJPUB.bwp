                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Stag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStagingNumeroPrincipale.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUB_WLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:ErrorInput>&#xa;            &lt;xsl:if test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0&quot;>&#xa;                &lt;tns7:RETURN_CODE>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns7:RETURN_CODE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO)&quot;>&#xa;                &lt;tns7:ORDINE>&#xa;                    &lt;ns2:REGOLATORIO>&#xa;                        &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                    &lt;/ns2:REGOLATORIO>&#xa;                &lt;/tns7:ORDINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                        &lt;tns7:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns7:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')&quot;>&#xa;                            &lt;tns7:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')&quot;/>&#xa;                            &lt;/tns7:ID_RICH_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns7:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&#xa;                            &lt;/tns7:ID_RICH_OLO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns7:COD_PROCSO_NOFILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns7:COD_PROCSO_NOFILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns7:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;            &lt;/tns7:ID_ESEC_PROCSO_NOFILE>&#xa;            &lt;xsl:if test=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns7:STATO>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns7:STATO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:STS)&quot;>&#xa;                    &lt;tns7:ORDINEAGGIUNTIVI>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns7:ORDINEAGGIUNTIVI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:StatoNP&quot;>&#xa;                &lt;tns7:STATO_NP>&#xa;                    &lt;tns7:StatoNumeriAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;tns3:StatoNumeriAggiuntivi&quot;/>&#xa;                    &lt;/tns7:StatoNumeriAggiuntivi>&#xa;                &lt;/tns7:STATO_NP>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                        &lt;tns7:AGGIUNTIVIWLR>&#xa;                            &lt;ns2:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;ns2:TESTATA&quot;/>&#xa;                            &lt;/ns2:REGOLATORIO>&#xa;                        &lt;/tns7:AGGIUNTIVIWLR>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns7:OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns7:OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns7:WLRTimer>&#xa;                    &lt;xsl:value-of select=&quot;$Stag.RESPONSE/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns7:WLRTimer>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns7:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
