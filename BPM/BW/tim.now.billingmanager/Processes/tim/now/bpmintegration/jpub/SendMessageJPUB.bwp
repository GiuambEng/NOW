                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/Identificativi_Processi&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Identificativi&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Identificativi_Processi>&#xa;            &lt;tns2:ID_Process_Instance>&#xa;                &lt;xsl:value-of select=&quot;concat(string(tib:timestamp()), $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/tns2:ID_Process_Instance>&#xa;            &lt;tns2:Codice_Processo>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;JPUB_REG&amp;quot;&quot;/>&#xa;            &lt;/tns2:Codice_Processo>&#xa;        &lt;/tns2:Identificativi_Processi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Identificativi" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:reply name="SendJPubOut2" operation="SendJPUB"
                partnerLink="SendJPUB" portType="ns1:SendJPUB"
                tibex:xpdlId="e62cecfd-a552-40c3-9940-a9558eae6b19" variable="SendJPubOut2-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" version="2.0"&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:template name="SendJPubOut2-input" match="/"&gt;
        &lt;tns2:SendJPUBResponse&gt;
            &lt;parameters&gt;
                &lt;tns3:SendJPUBResponse&gt;
                    &lt;tns3:code&gt;
                        &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                    &lt;/tns3:code&gt;
                    &lt;tns3:msg&gt;
                        &lt;xsl:value-of select="&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente.&amp;quot;"/&gt;
                    &lt;/tns3:msg&gt;
                    &lt;xsl:if test="exists($UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS)"&gt;
                        &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                            &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                            &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;
                        &lt;/xsl:if&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns3:SendJPUBResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns2:SendJPUBResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:template name=&quot;SendJPubOut2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SendJPUBResponse>&#xa;            &lt;tns3:code>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;            &lt;/tns3:code>&#xa;            &lt;tns3:msg>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Esiste un ordine già in fatturazione sulla stessa ID_RISORSA OL verrà parcheggiato e inviato successivamente.&amp;quot;&quot;/>&#xa;            &lt;/tns3:msg>&#xa;            &lt;xsl:if test=&quot;exists($UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS)&quot;>&#xa;                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                    &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                    &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:SendJPUBResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToSendJPubOut2"/>
                    <bpws:target linkName="CallProcessToSendJPubOut2"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:invoke
                inputVariable="InsertStagingNumeroPrincipale-input"
                name="InsertStagingNumeroPrincipale"
                operation="InsertUpdateStaging"
                outputVariable="InsertStagingNumeroPrincipale"
                partnerLink="StagingProcessManager"
                portType="ns24:InsertUpdateStagingPortType" tibex:xpdlId="e70ac7f6-7e7d-42ed-a9e2-1fe51e2aa301">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="SendMessageJPUB_XDSL"/&gt;
    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:param name="MappingREG_NPInvoke"/&gt;
    &lt;xsl:param name="MappingNGA_XDSLInvoke"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="JDBC_CODFC_OLO"/&gt;
    &lt;xsl:param name="Mapper1"/&gt;
    &lt;xsl:template name="InsertStagingNumeroPrincipale-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($Mapper1)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($Mapper1,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0 and exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Mapper)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($Mapper,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO, true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO, true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA)"&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO, true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:CONTENUTO_REQUEST&gt;
                                    &lt;xsl:value-of select="tib:render-xml($MappingNGA_XDSLInvoke/output/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS, true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_REQUEST&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="(upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) and (upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta) = &amp;quot;REGOLATORIO&amp;quot; or upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta) = &amp;quot;NPG&amp;quot;)"&gt;
                                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDRisorsa"&gt;
                                            &lt;tns5:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDRisorsa"/&gt;
                                            &lt;/tns5:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0 and contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync,'_A')"&gt;
                                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"&gt;
                                                    &lt;tns5:ID_RISORSA&gt;
                                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"/&gt;
                                                    &lt;/tns5:ID_RISORSA&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0   and not(contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync,'_S'))    and  string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&gt;0"&gt;
                                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"&gt;
                                                    &lt;tns5:ID_RISORSA&gt;
                                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"/&gt;
                                                    &lt;/tns5:ID_RISORSA&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa)&gt;0"&gt;
                                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa"&gt;
                                                    &lt;tns5:ID_RISORSA&gt;
                                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa"/&gt;
                                                    &lt;/tns5:ID_RISORSA&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
