                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO)"&gt;
                            &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/CODE_CAUS"&gt;
