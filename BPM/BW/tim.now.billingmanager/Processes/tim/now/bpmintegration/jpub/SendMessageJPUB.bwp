                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUPDATEGestioneFatturazioneInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/MsgCode,$_error/Class,$_error/FullClass,$_error/StackTrace,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdateStagingOK-input"
                name="UpdateStagingOK" operation="InsertUpdateStaging"
                outputVariable="UpdateStagingOK"
                partnerLink="StagingProcessManager"
                portType="ns24:InsertUpdateStagingPortType" tibex:xpdlId="a4799b11-29f7-45b2-997d-ef1bab0e158a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns0="http://crmnow.ordineregolatorio.jpub/types/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns01="http://crmnow.ordinexdsl.jpub.internal/types/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="InvokeJPUBNumberPortability"/&gt;
    &lt;xsl:param name="InvokeJPUBRegolatorio"/&gt;
    &lt;xsl:param name="InvokeJPUBXDSL"/&gt;
    &lt;xsl:param name="InsertStagingNumeroPrincipale"/&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:param name="SendMessageJPUB_XDSL"/&gt;
    &lt;xsl:param name="ParseStaging"/&gt;
    &lt;xsl:template name="UpdateStagingOK-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($InvokeJPUBNumberPortability/parameters/tns0:ricezioneResponseElement)"&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="tib:render-xml($InvokeJPUBNumberPortability/parameters/tns0:ricezioneResponseElement,true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($InvokeJPUBRegolatorio/parameters/tns0:ricezioneResponseElement)"&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="tib:render-xml($InvokeJPUBRegolatorio/parameters/tns0:ricezioneResponseElement,true(), true())"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns5:CONTENUTO_RESPONSE&gt;
                                    &lt;xsl:value-of select="tib:render-xml($InvokeJPUBXDSL/parameters/tns01:ricezioneResponseElement/tns01:result, true(),true())"/&gt;
                                &lt;/tns5:CONTENUTO_RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns5:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns5:DESCR_ERRORE&gt;
                        &lt;tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                        &lt;tns5:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RISPOSTA&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns3:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaProcesso&gt;
                        &lt;ns3:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaOperazione&gt;
                        &lt;ns3:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($ParseStaging/tns5:LogResponse)"&gt;
                                    &lt;xsl:if test="$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns3:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns3:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns3:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns3:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($ParseStaging/tns5:LogResponse)"&gt;
                                    &lt;ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($ParseStaging/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))"/&gt;
                                    &lt;/ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingNumeroPrincipale/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))"/&gt;
                                    &lt;/ns3:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO) or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;"&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_XDSL"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns3:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns3:STATO_ESEC&gt;
                            &lt;ns3:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TMSP_FINE_ELAB&gt;
                        &lt;/ns3:EsecuzioneNOFileProcessato&gt;
                        &lt;ns3:LogFileProcessato&gt;
                            &lt;ns3:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns3:LOG_LEVEL&gt;
                            &lt;ns3:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns3:LOG_MESSAGE&gt;
                            &lt;ns3:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TIMSTP_INSMTO&gt;
                        &lt;/ns3:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns01=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingNumeroPrincipale.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBRegolatorio.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBNumberPortability.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUBXDSL.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagingOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvokeJPUBNumberPortability.parameters)&quot;>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBNumberPortability.parameters,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($InvokeJPUBRegolatorio.parameters)&quot;>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBRegolatorio.parameters,true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvokeJPUBXDSL.parameters/tns01:result, true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns5:DESCR_ERRORE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RISPOSTA>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns3:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaProcesso>&#xa;                &lt;ns3:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaOperazione>&#xa;                &lt;ns3:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseStaging/tns5:LogResponse)&quot;>&#xa;                            &lt;xsl:if test=&quot;$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns3:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseStaging/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns3:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns3:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns3:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseStaging/tns5:LogResponse)&quot;>&#xa;                            &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($ParseStaging/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingNumeroPrincipale.RESPONSE/tns5:LogResponse/ns3:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO) or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_XDSL&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns3:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns3:STATO_ESEC>&#xa;                    &lt;ns3:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TMSP_FINE_ELAB>&#xa;                &lt;/ns3:EsecuzioneNOFileProcessato>&#xa;                &lt;ns3:LogFileProcessato>&#xa;                    &lt;ns3:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns3:LOG_LEVEL>&#xa;                    &lt;ns3:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns3:LOG_MESSAGE>&#xa;                    &lt;ns3:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TIMSTP_INSMTO>&#xa;                &lt;/ns3:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty3ToUpdateStagingOK"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateStagingOKToCallProcess"/>
                    <bpws:source
                        linkName="UpdateStagingOKToCallProcess1"
                        tibex:faultDetailsVar="UpdateStagingOK" tibex:faultNameVar="FaultName">
