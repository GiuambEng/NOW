/DATA_INIZIO_NOL>&lt;TIPO_SLA>&lt;xsl:value-of select=&quot;TIPO_SLA&quot;/>&lt;/TIPO_SLA>&lt;OFFERTA_SLA>&lt;xsl:value-of select=&quot;OFFERTA_SLA&quot;/>&lt;/OFFERTA_SLA>&lt;COPERTURA_ORARIA>&lt;xsl:value-of select=&quot;COPERTURA_ORARIA&quot;/>&lt;/COPERTURA_ORARIA>&lt;/SLA>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;ns:USER_VLAN&quot;>&lt;USER_VLAN>&lt;ID_RIS>&lt;xsl:value-of select=&quot;ID_RIS&quot;/>&lt;/ID_RIS>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;ID_RIS_OLD&quot;/>&lt;/ID_RIS_OLD>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&lt;/TIPO_AZIONE>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&lt;/DATA_INIZIO_NOL>&lt;PCR_UP>&lt;xsl:value-of select=&quot;PCR_UP&quot;/>&lt;/PCR_UP>&lt;PCR_DOWN>&lt;xsl:value-of select=&quot;PCR_DOWN&quot;/>&lt;/PCR_DOWN>&lt;ID_RIS_RACCOLTA>&lt;xsl:value-of select=&quot;ID_RIS_RACCOLTA&quot;/>&lt;/ID_RIS_RACCOLTA>&lt;ID_CVLAN>&lt;xsl:value-of select=&quot;ID_CVLAN&quot;/>&lt;/ID_CVLAN>&lt;CODE_IDBRE_DSLAM>&lt;xsl:value-of select=&quot;CODE_IDBRE_DSLAM&quot;/>&lt;/CODE_IDBRE_DSLAM>&lt;xsl:copy-of select=&quot;COS&quot;/>&lt;xsl:if test=&quot;PROFILO_CVLAN&quot;>&lt;PROFILO_CVLAN xsi:type=&quot;xsd:string&quot;>&lt;xsl:value-of select=&quot;PROFILO_CVLAN&quot;/>&lt;/PROFILO_CVLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&lt;TIPO_CLUSTER>&lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&lt;/TIPO_CLUSTER>&lt;/xsl:if>&lt;xsl:if test=&quot;FTTH_ONLY&quot;>&lt;FTTH_ONLY>&lt;xsl:value-of select=&quot;FTTH_ONLY&quot;/>&lt;/FTTH_ONLY>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAG_MULTICAST&quot;>&lt;FLAG_MULTICAST>&lt;xsl:value-of select=&quot;FLAG_MULTICAST&quot;/>&lt;/FLAG_MULTICAST>&lt;/xsl:if>&lt;/USER_VLAN>&lt;/xsl:for-each>&lt;/ACCESSO>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TESTATA>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OpereSpeciali/output/tns1:OpereSpecialiResponse/ns:ORDINI_CRMWS/ns:PREVENTIVO)&quot;>&lt;xsl:for-each select=&quot;$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns:ORDINI_CRMWS/ns:PREVENTIVO&quot;>&lt;PREVENTIVO>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;ID_PREVENTIVO&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_RICHIESTA_NOW>&lt;xsl:value-of select=&quot;ID_RICHIESTA_NOW&quot;/>&lt;/ID_RICHIESTA_NOW>&lt;ID_OLO>&lt;xsl:value-of select=&quot;ID_OLO&quot;/>&lt;/ID_OLO>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;CODICE_ORDINE_OLO&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;ID_RIS>&lt;xsl:value-of select=&quot;ID_RIS&quot;/>&lt;/ID_RIS>&lt;TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;TIPO_SERVIZIO&quot;/>&lt;/TIPO_SERVIZIO>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;TECNOLOGIA&quot;/>&lt;/TECNOLOGIA>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&lt;/DATA_DRO>&lt;xsl:if test=&quot;DATA_INVIO_PREVENTIVO&quot;>&lt;DATA_INVIO_PREVENTIVO>&lt;xsl:value-of select=&quot;DATA_INVIO_PREVENTIVO&quot;/>&lt;/DATA_INVIO_PREVENTIVO>&lt;/xsl:if>&lt;DATA_RICHIESTA_PREVENTIVO>&lt;xsl:value-of select=&quot;DATA_RICHIESTA_PREVENTIVO&quot;/>&lt;/DATA_RICHIESTA_PREVENTIVO>&lt;xsl:for-each select=&quot;ns:DETTAGLIO&quot;>&lt;DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;ID_VOCE&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;QUANTITA&quot;/>&lt;/QUANTITA>&lt;/DETTAGLIO>&lt;/xsl:for-each>&lt;/PREVENTIVO>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ORDINI_CRMWS>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
