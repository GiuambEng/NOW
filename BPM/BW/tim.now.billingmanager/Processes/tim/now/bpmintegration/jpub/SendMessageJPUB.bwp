                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns0:ID_ORDINE_CRM&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns0:ID_ORDINE_CRM&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW)"&gt;
                                        &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns0:ID_ORDINE_CRM&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns0:ORDINE&gt;
                        &lt;REGOLATORIO&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP)"&gt;
                                    &lt;xsl:for-each select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA"&gt;
                                        &lt;TESTATA&gt;
                                            &lt;ID_ORD_CRMWS&gt;
                                                &lt;xsl:value-of select="ID_ORD_CRMWS"/&gt;
                                            &lt;/ID_ORD_CRMWS&gt;
                                            &lt;DATA_DRO&gt;
                                                &lt;xsl:value-of select="DATA_DRO"/&gt;
                                            &lt;/DATA_DRO&gt;
                                            &lt;DATA_MSG&gt;
                                                &lt;xsl:value-of select="DATA_MSG"/&gt;
                                            &lt;/DATA_MSG&gt;
                                            &lt;DATA_DES&gt;
                                                &lt;xsl:value-of select="DATA_DES"/&gt;
                                            &lt;/DATA_DES&gt;
                                            &lt;CODE_CAUS&gt;
                                                &lt;xsl:value-of select="CODE_CAUS"/&gt;
                                            &lt;/CODE_CAUS&gt;
                                            &lt;CODICE_ORDINE_ISP&gt;
                                                &lt;xsl:value-of select="CODICE_ORDINE_ISP"/&gt;
                                            &lt;/CODICE_ORDINE_ISP&gt;
                                            &lt;CODICE_PROGETTO&gt;
                                                &lt;xsl:value-of select="CODICE_PROGETTO"/&gt;
                                            &lt;/CODICE_PROGETTO&gt;
                                            &lt;xsl:for-each select="ns2:ACCESSO"&gt;
                                                &lt;ACCESSO&gt;
                                                    &lt;TIPO_CONTR&gt;
                                                        &lt;xsl:value-of select="TIPO_CONTR"/&gt;
                                                    &lt;/TIPO_CONTR&gt;
                                                    &lt;CODE_CONTR&gt;
                                                        &lt;xsl:value-of select="CODE_CONTR"/&gt;
                                                    &lt;/CODE_CONTR&gt;
                                                    &lt;CODE_CLLI&gt;
                                                        &lt;xsl:value-of select="CODE_CLLI"/&gt;
                                                    &lt;/CODE_CLLI&gt;
                                                    &lt;CODE_PREST_AGG&gt;
                                                        &lt;xsl:value-of select="CODE_PREST_AGG"/&gt;
                                                    &lt;/CODE_PREST_AGG&gt;
                                                    &lt;ID_RIS&gt;
                                                        &lt;xsl:value-of select="ID_RIS"/&gt;
                                                    &lt;/ID_RIS&gt;
                                                    &lt;ID_RIS_PRINC&gt;
                                                        &lt;xsl:value-of select="ID_RIS_PRINC"/&gt;
                                                    &lt;/ID_RIS_PRINC&gt;
                                                    &lt;CODE_GEST_REC&gt;
                                                        &lt;xsl:value-of select="CODE_GEST_REC"/&gt;
                                                    &lt;/CODE_GEST_REC&gt;
                                                    &lt;TIPO_FAMIGLIA&gt;
                                                        &lt;xsl:value-of select="TIPO_FAMIGLIA"/&gt;
                                                    &lt;/TIPO_FAMIGLIA&gt;
                                                    &lt;OPZ_COMM&gt;
                                                        &lt;xsl:value-of select="OPZ_COMM"/&gt;
                                                    &lt;/OPZ_COMM&gt;
                                                    &lt;TIPO_LINEA&gt;
                                                        &lt;xsl:value-of select="TIPO_LINEA"/&gt;
                                                    &lt;/TIPO_LINEA&gt;
                                                    &lt;FLAG_NP&gt;
                                                        &lt;xsl:value-of select="FLAG_NP"/&gt;
                                                    &lt;/FLAG_NP&gt;
                                                    &lt;SUB_TIPO_LINEA&gt;
                                                        &lt;xsl:value-of select="SUB_TIPO_LINEA"/&gt;
                                                    &lt;/SUB_TIPO_LINEA&gt;
                                                    &lt;SUB_TIPO_LINEA_RESIDENZIALE&gt;
                                                        &lt;xsl:value-of select="SUB_TIPO_LINEA_RESIDENZIALE"/&gt;
                                                    &lt;/SUB_TIPO_LINEA_RESIDENZIALE&gt;
                                                    &lt;SUB_TIPO_LINEA_DIREZIONE&gt;
                                                        &lt;xsl:value-of select="SUB_TIPO_LINEA_DIREZIONE"/&gt;
                                                    &lt;/SUB_TIPO_LINEA_DIREZIONE&gt;
                                                    &lt;MOD_VENDITA_ACCESSO&gt;
                                                        &lt;xsl:value-of select="MOD_VENDITA_ACCESSO"/&gt;
                                                    &lt;/MOD_VENDITA_ACCESSO&gt;
                                                    &lt;TIPO_AZIONE&gt;
                                                        &lt;xsl:value-of select="TIPO_AZIONE"/&gt;
                                                    &lt;/TIPO_AZIONE&gt;
                                                    &lt;DATA_INIZIO_NOL&gt;
                                                        &lt;xsl:value-of select="DATA_INIZIO_NOL"/&gt;
                                                    &lt;/DATA_INIZIO_NOL&gt;
                                                    &lt;CODE_COMUNE&gt;
                                                        &lt;xsl:value-of select="CODE_COMUNE"/&gt;
                                                    &lt;/CODE_COMUNE&gt;
                                                    &lt;CODE_ID_ULLCO&gt;
                                                        &lt;xsl:value-of select="CODE_ID_ULLCO"/&gt;
                                                    &lt;/CODE_ID_ULLCO&gt;
                                                    &lt;CODE_DISTR&gt;
                                                        &lt;xsl:value-of select="CODE_DISTR"/&gt;
                                                    &lt;/CODE_DISTR&gt;
                                                    &lt;FLAG_PERMUTA&gt;
                                                        &lt;xsl:value-of select="FLAG_PERMUTA"/&gt;
                                                    &lt;/FLAG_PERMUTA&gt;
                                                    &lt;FLAG_MIGRAZIONE&gt;
                                                        &lt;xsl:value-of select="FLAG_MIGRAZIONE"/&gt;
                                                    &lt;/FLAG_MIGRAZIONE&gt;
                                                    &lt;FLAG_QUALIFICAZIONE&gt;
                                                        &lt;xsl:value-of select="FLAG_QUALIFICAZIONE"/&gt;
                                                    &lt;/FLAG_QUALIFICAZIONE&gt;
                                                    &lt;ID_RIS_OLD&gt;
                                                        &lt;xsl:value-of select="ID_RIS_OLD"/&gt;
                                                    &lt;/ID_RIS_OLD&gt;
                                                    &lt;CODICE_QUALITA&gt;
                                                        &lt;xsl:value-of select="CODICE_QUALITA"/&gt;
                                                    &lt;/CODICE_QUALITA&gt;
                                                    &lt;CODICE_DELIVERY&gt;
                                                        &lt;xsl:value-of select="CODICE_DELIVERY"/&gt;
                                                    &lt;/CODICE_DELIVERY&gt;
                                                    &lt;CAMPO_SERV_IT&gt;
                                                        &lt;xsl:value-of select="CAMPO_SERV_IT"/&gt;
                                                    &lt;/CAMPO_SERV_IT&gt;
                                                    &lt;QUANTITA&gt;
                                                        &lt;xsl:value-of select="QUANTITA"/&gt;
                                                    &lt;/QUANTITA&gt;
                                                    &lt;CODE_DONOR&gt;
                                                        &lt;xsl:value-of select="CODE_DONOR"/&gt;
                                                    &lt;/CODE_DONOR&gt;
                                                    &lt;CODE_DONATING&gt;
                                                        &lt;xsl:value-of select="CODE_DONATING"/&gt;
                                                    &lt;/CODE_DONATING&gt;
                                                    &lt;xsl:if test="CODE_ID_SLUCO"&gt;
                                                        &lt;CODE_ID_SLUCO&gt;
                                                            &lt;xsl:value-of select="CODE_ID_SLUCO"/&gt;
                                                        &lt;/CODE_ID_SLUCO&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;FLAG_MANTENIMENTO_STS&gt;
                                                        &lt;xsl:value-of select="FLAG_MANTENIMENTO_STS"/&gt;
                                                    &lt;/FLAG_MANTENIMENTO_STS&gt;
                                                    &lt;xsl:if test="FLAG_PERMUTA_ARMADIO"&gt;
                                                        &lt;FLAG_PERMUTA_ARMADIO&gt;
                                                            &lt;xsl:value-of select="FLAG_PERMUTA_ARMADIO"/&gt;
                                                        &lt;/FLAG_PERMUTA_ARMADIO&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:if test="TIPO_CESSAZIONE"&gt;
                                                        &lt;TIPO_CESSAZIONE&gt;
                                                            &lt;xsl:value-of select="TIPO_CESSAZIONE"/&gt;
                                                        &lt;/TIPO_CESSAZIONE&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:if test="FLAG_NP_SUCCESSIVA_PURA"&gt;
                                                        &lt;FLAG_NP_SUCCESSIVA_PURA&gt;
                                                            &lt;xsl:value-of select="FLAG_NP_SUCCESSIVA_PURA"/&gt;
                                                        &lt;/FLAG_NP_SUCCESSIVA_PURA&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;FLAG_LA&gt;
                                                        &lt;xsl:value-of select="FLAG_LA"/&gt;
                                                    &lt;/FLAG_LA&gt;
                                                    &lt;xsl:if test="TIPO_LINEA_NUM_AGG"&gt;
                                                        &lt;TIPO_LINEA_NUM_AGG&gt;
                                                            &lt;xsl:value-of select="TIPO_LINEA_NUM_AGG"/&gt;
                                                        &lt;/TIPO_LINEA_NUM_AGG&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:if test="FLAG_4REFERENTE"&gt;
                                                        &lt;FLAG_4REFERENTE&gt;
                                                            &lt;xsl:value-of select="FLAG_4REFERENTE"/&gt;
                                                        &lt;/FLAG_4REFERENTE&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:if test="CODE_HOSTING"&gt;
                                                        &lt;CODE_HOSTING&gt;
                                                            &lt;xsl:value-of select="CODE_HOSTING"/&gt;
                                                        &lt;/CODE_HOSTING&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:if test="TIPO_CLUSTER"&gt;
                                                        &lt;TIPO_CLUSTER&gt;
                                                            &lt;xsl:value-of select="TIPO_CLUSTER"/&gt;
                                                        &lt;/TIPO_CLUSTER&gt;
                                                    &lt;/xsl:if&gt;
                                                    &lt;xsl:for-each select="ns2:AGG"&gt;
                                                        &lt;AGG&gt;
                                                            &lt;AGGIUNTIVO&gt;
                                                                &lt;xsl:value-of select="AGGIUNTIVO"/&gt;
                                                            &lt;/AGGIUNTIVO&gt;
                                                        &lt;/AGG&gt;
                                                    &lt;/xsl:for-each&gt;
                                                    &lt;xsl:for-each select="ns2:STS"&gt;
                                                        &lt;STS&gt;
                                                            &lt;TIPO_AZIONE&gt;
                                                                &lt;xsl:value-of select="TIPO_AZIONE"/&gt;
                                                            &lt;/TIPO_AZIONE&gt;
                                                            &lt;FLAG_LINEA_NUM_AGG&gt;
                                                                &lt;xsl:value-of select="FLAG_LINEA_NUM_AGG"/&gt;
                                                            &lt;/FLAG_LINEA_NUM_AGG&gt;
                                                            &lt;ID_RIS_AGGIUNTIVA&gt;
                                                                &lt;xsl:value-of select="ID_RIS_AGGIUNTIVA"/&gt;
                                                            &lt;/ID_RIS_AGGIUNTIVA&gt;
                                                            &lt;CODE_STS&gt;
                                                                &lt;xsl:value-of select="CODE_STS"/&gt;
                                                            &lt;/CODE_STS&gt;
                                                        &lt;/STS&gt;
                                                    &lt;/xsl:for-each&gt;
                                                &lt;/ACCESSO&gt;
                                            &lt;/xsl:for-each&gt;
                                        &lt;/TESTATA&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO)"&gt;
                                    &lt;PREVENTIVO&gt;
                                        &lt;ID_PREVENTIVO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_PREVENTIVO"/&gt;
                                        &lt;/ID_PREVENTIVO&gt;
                                        &lt;ID_RICHIESTA_NOW&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;
                                        &lt;/ID_RICHIESTA_NOW&gt;
                                        &lt;ID_OLO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_OLO"/&gt;
                                        &lt;/ID_OLO&gt;
                                        &lt;CODICE_ORDINE_OLO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/CODICE_ORDINE_OLO"/&gt;
                                        &lt;/CODICE_ORDINE_OLO&gt;
                                        &lt;ID_RIS&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RIS"/&gt;
                                        &lt;/ID_RIS&gt;
                                        &lt;TIPO_SERVIZIO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/TIPO_SERVIZIO"/&gt;
                                        &lt;/TIPO_SERVIZIO&gt;
                                        &lt;TECNOLOGIA&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/TECNOLOGIA"/&gt;
                                        &lt;/TECNOLOGIA&gt;
                                        &lt;DATA_DRO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/DATA_DRO"/&gt;
                                        &lt;/DATA_DRO&gt;
                                        &lt;xsl:if test="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/DATA_INVIO_PREVENTIVO"&gt;
                                            &lt;DATA_INVIO_PREVENTIVO&gt;
                                                &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/DATA_INVIO_PREVENTIVO"/&gt;
                                            &lt;/DATA_INVIO_PREVENTIVO&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;DATA_RICHIESTA_PREVENTIVO&gt;
                                            &lt;xsl:value-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;
                                        &lt;/DATA_RICHIESTA_PREVENTIVO&gt;
                                        &lt;xsl:for-each select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO/ns2:DETTAGLIO"&gt;
                                            &lt;DETTAGLIO&gt;
                                                &lt;ID_VOCE&gt;
                                                    &lt;xsl:value-of select="ID_VOCE"/&gt;
                                                &lt;/ID_VOCE&gt;
                                                &lt;QUANTITA&gt;
                                                    &lt;xsl:value-of select="QUANTITA"/&gt;
                                                &lt;/QUANTITA&gt;
                                            &lt;/DETTAGLIO&gt;
                                        &lt;/xsl:for-each&gt;
                                    &lt;/PREVENTIVO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/REGOLATORIO&gt;
                    &lt;/tns0:ORDINE&gt;
                &lt;/tns0:ricezioneElement&gt;
            &lt;/parameters&gt;
        &lt;/ns1:OrdineRegolatorioCRMNOW_ricezione&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpeciali.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUBNumberPortability-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP)&quot;>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($OpereSpeciali.output/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$OpereSpeciali.output/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;>&#xa;                                &lt;TESTATA>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                    &lt;DATA_MSG>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                    &lt;/DATA_MSG>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot