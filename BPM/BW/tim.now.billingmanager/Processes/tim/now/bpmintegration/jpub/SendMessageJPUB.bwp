                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+afa78675-3bca-46be-8c40-4914da613737+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;OpereSpeciali&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:param name=&quot;Update&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateDA_INVIARE_REG-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($Update/output/tns:UPDATEGestioneFatturazioneResponse)&quot;>&#xa;                &lt;tns6:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$Update/output/tns:UPDATEGestioneFatturazioneResponse/tns:PRINCIPALE/tns:Record&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                            &lt;ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_RICH_OLO&quot;/>&#xa;                            &lt;/ID_RICH_OLO>&#xa;                            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns6:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Flag_OpereSpeciali=true()&quot;>&#xa;                &lt;tns6:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$OpereSpeciali/output/tns1:OpereSpecialiResponse/tns1:UpdateGestione&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                            &lt;ID_RICH_OLO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(tns1:ID_Rich_OLO)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:ID_Rich_OLO&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_RICH_OLO>&#xa;                            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(tns1:ID_Evento_Ordn_Now_Whls)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:ID_Evento_Ordn_Now_Whls&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns6:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns6:jdbcUpdateActivityInput>&#xa;                    &lt;xsl:for-each select=&quot;$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:PRINCIPALE/tns:Record&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;                            &lt;ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_RICH_OLO&quot;/>&#xa;                            &lt;/ID_RICH_OLO>&#xa;                            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;/Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns6:jdbcUpdateActivityInput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
