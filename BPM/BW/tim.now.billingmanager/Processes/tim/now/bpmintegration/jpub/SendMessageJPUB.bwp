ot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns5:ID_ORDINE_COMPOSTO>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns5:ID_ORDINE_COMPOSTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns5:ID_ORDINE_COMPOSTO>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns5:ID_ORDINE_COMPOSTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns5:ID_ORDINE_COMPOSTO>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns5:ID_ORDINE_COMPOSTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                &lt;/tns5:FLAG_CONSUNTIVO>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns3:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaProcesso>&#xa;                &lt;ns3:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaOperazione>&#xa;                &lt;ns3:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO) or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$SendMessageJPUB_XDSL&quot;/>&#xa;                            &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns3:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns3:STATO_ESEC>&#xa;                    &lt;ns3:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns3:EsecuzioneNOFileProcessato>&#xa;                &lt;ns3:LogFileProcessato>&#xa;                    &lt;ns3:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns3:LOG_LEVEL>&#xa;                    &lt;ns3:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns3:LOG_MESSAGE>&#xa;                    &lt;ns3:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TIMSTP_INSMTO>&#xa;                &lt;/ns3:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
