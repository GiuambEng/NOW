                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:ns1=&quot;http://www.tibco.com/JPUB_REG_internal_abstract/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpeciali.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJPUBRegolatorio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO)&quot;>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns0:ID_ORDINE_CRM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($OpereSpeciali.output/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$OpereSpeciali.output/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns0:ID_ORDINE_CRM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns0:ORDINE>&#xa;                &lt;REGOLATORIO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Mapper1)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$Mapper1/ns2:TESTATA&quot;>&#xa;                                &lt;TESTATA>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                    &lt;DATA_MSG>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                    &lt;/DATA_MSG>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                    &lt;xsl:for-each select=&quot;ns2:ACCESSO&quot;>&#xa;                                        &lt;ACCESSO>&#xa;                                            &lt;TIPO_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                                            &lt;/TIPO_CONTR>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CLLI&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                            &lt;CODE_PREST_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_PREST_AGG&quot;/>&#xa;                                            &lt;/CODE_PREST_AGG>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_PRINC&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_GEST_REC&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;OPZ_COMM>&#xa;                                                &lt;xsl:value-of select=&quot;OPZ_COMM&quot;/>&#xa;                                            &lt;/OPZ_COMM>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&#xa;                                            &lt;FLAG_NP>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_NP&quot;/>&#xa;                                            &lt;/FLAG_NP>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;DATA_INIZIO_NOL>&#xa;                                                &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                                            &lt;/DATA_INIZIO_NOL>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_ID_ULLCO&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                            &lt;CODE_DISTR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_DISTR&quot;/>&#xa;                                            &lt;/CODE_DISTR>&#xa;                                            &lt;FLAG_PERMUTA>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA>&#xa;                                            &lt;FLAG_MIGRAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                                            &lt;/FLAG_MIGRAZIONE>&#xa;                                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_OLD&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                            &lt;CODICE_QUALITA>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                                            &lt;/CODICE_QUALITA>&#xa;                                            &lt;CODICE_DELIVERY>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                                            &lt;/CODICE_DELIVERY>&#xa;                                            &lt;CAMPO_SERV_IT>&#xa;                                                &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                                            &lt;/CAMPO_SERV_IT>&#xa;                                            &lt;QUANTITA>&#xa;                                                &lt;xsl:value-of select=&quot;QUANTITA&quot;/>&#xa;                                            &lt;/QUANTITA>&#xa;                                            &lt;CODE_DONOR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_DONOR&quot;/>&#xa;                                            &lt;/CODE_DONOR>&#xa;                                            &lt;CODE_DONATING>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_DONATING&quot;/>&#xa;                                            &lt;/CODE_DONATING>&#xa;                                            &lt;xsl:if test=&quot;CODE_ID_SLUCO&quot;>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;CODE_ID_SLUCO&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                            &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                    &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                                &lt;TIPO_CESSAZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                                &lt;/TIPO_CESSAZIONE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;FLAG_LA>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                            &lt;/FLAG_LA>&#xa;                                            &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                                &lt;TIPO_LINEA_NUM_AGG>&#xa;                                                    &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                                &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;FLAG_4REFERENTE&quot;>&#xa;                                                &lt;FLAG_4REFERENTE>&#xa;                                                    &lt;xsl:value-of select=&quot;FLAG_4REFERENTE&quot;/>&#xa;                                                &lt;/FLAG_4REFERENTE>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CODE_HOSTING&quot;>&#xa;                                                &lt;CODE_HOSTING>&#xa;                                                    &lt;xsl:value-of select=&quot;CODE_HOSTING&quot;/>&#xa;                                                &lt;/CODE_HOSTING>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&#xa;                                                &lt;TIPO_CLUSTER>&#xa;                                                    &lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&#xa;                                                &lt;/TIPO_CLUSTER>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:for-each select=&quot;ns2:AGG&quot;>&#xa;                                                &lt;AGG>&#xa;                                                    &lt;AGGIUNTIVO>&#xa;                                                        &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                                    &lt;/AGGIUNTIVO>&#xa;                                                &lt;/AGG>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;ns2:STS&quot;>&#xa;                                                &lt;STS>&#xa;                                                    &lt;TIPO_AZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                                    &lt;/TIPO_AZIONE>&#xa;                                                    &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                        &lt;xsl:value-of select=&quot;FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                                    &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                                    &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                        &lt;xsl:value-of select=&quot;ID_RIS_AGGIUNTIVA&quot;/>&#xa;                                                    &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;CODE_STS>&#xa;                                                        &lt;xsl:value-of select=&quot;CODE_STS&quot;/>&#xa;                                                    &lt;/CODE_STS>&#xa;                                                &lt;/STS>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ACCESSO>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/TESTATA>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$Mapper/ns2:TESTATA&quot;>&#xa;                                &lt;TESTATA>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                    &lt;DATA_MSG>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                    &lt;/DATA_MSG>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                    &lt;xsl:for-each select=&quot;ns2:ACCESSO&quot;>&#xa;                                        &lt;ACCESSO>&#xa;                                            &lt;TIPO_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                                            &lt;/TIPO_CONTR>&#xa;                                            &lt;CODE_CONTR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CONTR&quot;/>&#xa;                                            &lt;/CODE_CONTR>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_CLLI&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                            &lt;CODE_PREST_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_PREST_AGG&quot;/>&#xa;                                            &lt;/CODE_PREST_AGG>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                            &lt;ID_RIS_PRINC>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_PRINC&quot;/>&#xa;                                            &lt;/ID_RIS_PRINC>&#xa;                                            &lt;CODE_GEST_REC>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_GEST_REC&quot;/>&#xa;                                            &lt;/CODE_GEST_REC>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                            &lt;OPZ_COMM>&#xa;                                                &lt;xsl:value-of select=&quot;OPZ_COMM&quot;/>&#xa;                                            &lt;/OPZ_COMM>&#xa;                                            &lt;TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                                            &lt;/TIPO_LINEA>&#xa;                                            &lt;FLAG_NP>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_NP&quot;/>&#xa;                                            &lt;/FLAG_NP>&#xa;                                            &lt;SUB_TIPO_LINEA>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA>&#xa;                                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;DATA_INIZIO_NOL>&#xa;                                                &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                                            &lt;/DATA_INIZIO_NOL>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_ID_ULLCO&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                            &lt;CODE_DISTR>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_DISTR&quot;/>&#xa;                                            &lt;/CODE_DISTR>&#xa;                                            &lt;FLAG_PERMUTA>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA>&#xa;                                            &lt;FLAG_MIGRAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                                            &lt;/FLAG_MIGRAZIONE>&#xa;                                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_OLD&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                            &lt;CODICE_QUALITA>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                                            &lt;/CODICE_QUALITA>&#xa;                                            &lt;CODICE_DELIVERY>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                                            &lt;/CODICE_DELIVERY>&#xa;                                            &lt;CAMPO_SERV_IT>&#xa;                                                &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                       