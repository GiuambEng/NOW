                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC']) and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:AssetCorrelatiVariati) and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:AssetCorrelatiVariati[1]/dettaglioasset[nomeComponente='ATMVC']/attributidettaglioasset[nomeAttributo='IDPROFILOVC']/valoreAttributo) and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='ATMVC']/attributidettaglioasset[nomeAttributo='IDPROFILOVC']/valoreAttributo)]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ControlComponente" name="Assign"
                    outputVariable="ControlComponente"
                    tibex:xpdlId="733b5441-c482-4579-b6f9-4d1ff3a39042" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
