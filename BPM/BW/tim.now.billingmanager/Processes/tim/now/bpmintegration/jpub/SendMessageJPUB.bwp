                                    expression="exists($OpereSpeciali/output/tns5:OpereSpecialiResponse/ns3:REGOLATORIO/ns3:PREVENTIVO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($OpereSpeciali.output/ns3:REGOLATORIO/ns3:PREVENTIVO)]]></bpws:transitionCondition>
                                    </bpws:source>
