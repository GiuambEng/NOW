            <bpws:empty name="Empty13" tibex:xpdlId="3b6f2e03-b22a-44cf-94e0-9c915fc0e5aa">
                <bpws:targets>
                    <bpws:target linkName="LogFaultMappingNGA_XDSLInvokeToEmpty13"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty13ToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty13ToThrow1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($SendJPUBIn.parameters/tns1:BPMRequest/tns1:NewBilling)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty14" tibex:xpdlId="f176676d-a3a9-45bb-a511-ef5376267153">
                <bpws:targets>
                    <bpws:target linkName="LogMappingREG_NPInvokeToEmpty14"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty14ToInvoke1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty14ToSync">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
