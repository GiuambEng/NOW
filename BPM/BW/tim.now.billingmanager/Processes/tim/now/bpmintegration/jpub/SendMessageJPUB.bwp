                                &lt;tns:TIPO_AZIONE&gt;
                                    &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE"/&gt;
