                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceRifiuto"&gt;
                                &lt;codiceRifiuto&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceRifiuto"/&gt;
                                &lt;/codiceRifiuto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/routingNumber"&gt;
                                &lt;routingNumber&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/routingNumber"/&gt;
                                &lt;/routingNumber&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/progressivoEmissioneDTU"&gt;
                                &lt;progressivoEmissioneDTU&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/progressivoEmissioneDTU"/&gt;
