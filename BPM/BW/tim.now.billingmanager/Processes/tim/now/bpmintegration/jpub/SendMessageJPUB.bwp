                            &lt;/tns1:IDRichiestaOLO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW"/&gt;
                            &lt;/tns1:IDRichiestaOLO&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDContratto)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDContratto"&gt;
                                &lt;tns1:IDContratto&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDContratto"/&gt;
                                &lt;/tns1:IDContratto&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO"&gt;
                        &lt;tns1:CodiceOrdineOLO&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO"/&gt;
                        &lt;/tns1:CodiceOrdineOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/offerta"&gt;
                        &lt;tns1:Offerta&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/offerta"/&gt;
                        &lt;/tns1:Offerta&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/DRO)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/DRO"&gt;
                                &lt;tns1:DRO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/DRO"/&gt;
                                &lt;/tns1:DRO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:IDOrdineComposto&gt;
                        &lt;xsl:value-of select="concat($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)"/&gt;
                    &lt;/tns1:IDOrdineComposto&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDPreventivo)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDPreventivo"&gt;
                                &lt;tns1:IDPreventivo&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDPreventivo"/&gt;
                                &lt;/tns1:IDPreventivo&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"&gt;
                        &lt;tns1:IDRisorsa&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"/&gt;
                        &lt;/tns1:IDRisorsa&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns1:Staging&gt;
                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatore"&gt;
                            &lt;tns1:Operatore&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatore"/&gt;
                            &lt;/tns1:Operatore&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codificaOLOAGCOM"&gt;
                            &lt;tns1:CodificaOLOAgicom&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codificaOLOAGCOM"/&gt;
                            &lt;/tns1:CodificaOLOAgicom&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot; or exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO)"&gt;
                                &lt;tns1:IDProcsoNoFile&gt;
                                    &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                                &lt;/tns1:IDProcsoNoFile&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns1:IDProcsoNoFile&gt;
                                    &lt;xsl:value-of select="$SendMessageJPUB_XDSL"/&gt;
                                &lt;/tns1:IDProcsoNoFile&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO) or exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO)"&gt;
                                &lt;tns1:IDDettaglioOrdine&gt;
                                    &lt;xsl:value-of select="1"/&gt;
                                &lt;/tns1:IDDettaglioOrdine&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="(upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)"&gt;
                                &lt;tns1:IDDettaglioOrdine&gt;
                                    &lt;xsl:value-of select="1"/&gt;
                                &lt;/tns1:IDDettaglioOrdine&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="upper-case($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;"&gt;
                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset"&gt;
                                    &lt;tns1:IDDettaglioOrdine&gt;
                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset"/&gt;
                                    &lt;/tns1:IDDettaglioOrdine&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine"&gt;
                                    &lt;tns1:IDDettaglioOrdine&gt;
                                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine"/&gt;
                                    &lt;/tns1:IDDettaglioOrdine&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns1:Staging&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta)&gt;0"&gt;
                            &lt;tns1:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta"/&gt;
                            &lt;/tns1:StrutturaRichiesta&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns1:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest"/&gt;
                &lt;/tns1:OpereSpecialiRequest&gt;
            &lt;/input&gt;
        &lt;/tns5:OpereSpecialiRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns5=&quot;http://www.tim.now/NOW/wsdl/abstract/OpereSpeciali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_XDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;OpereSpeciali-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:OpereSpecialiRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;tns1:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns1:IDRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;tns1:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                    &lt;/tns1:IDRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                    &lt;/tns1:IDRichiestaOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDContratto)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDContratto&quot;>&#xa;                        &lt;tns1:IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDContratto&quot;/>&#xa;                        &lt;/tns1:IDContratto>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns1:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns1:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/offerta&quot;>&#xa;                &lt;tns1:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/offerta&quot;/>&#xa;                &lt;/tns1:Offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/DRO)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/DRO&quot;>&#xa;                        &lt;tns1:DRO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/DRO&quot;/>&#xa;                        &lt;/tns1:DRO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:IDOrdineComposto>&#xa;                &lt;xsl:value-of select=&quot;concat($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;            &lt;/tns1:IDOrdineComposto>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDPreventivo)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDPreventivo&quot;>&#xa;                        &lt;tns1:IDPreventivo>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDPreventivo&quot;/>&#xa;                        &lt;/tns1:IDPreventivo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;>&#xa;                &lt;tns1:IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;/>&#xa;                &lt;/tns1:IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Staging>&#xa;                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/operatore&quot;>&#xa;                    &lt;tns1:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/operatore&quot;/>&#xa;                    &lt;/tns1:Operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns1:CodificaOLOAgicom>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns1:CodificaOLOAgicom>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot; or exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO)&quot;>&#xa;                        &lt;tns1:IDProcsoNoFile>&#xa;                            &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                        &lt;/tns1:IDProcsoNoFile>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:IDProcsoNoFile>&#xa;                            &lt;xsl:value-of select=&quot;$SendMessageJPUB_XDSL&quot;/>&#xa;                        &lt;/tns1:IDProcsoNoFile>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO) or exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO)&quot;>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) or (upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot; and upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;>&#xa;                            &lt;tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioAsset&quot;/>&#xa;                            &lt;/tns1:IDDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;>&#xa;                            &lt;tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns1:IDDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:Staging>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta)>0&quot;>&#xa;                    &lt;tns1:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns1:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns1:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters&quot;/>&#xa;        &lt;/tns1:OpereSpecialiRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogStartToInvoke_OpereSpeciali"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="OpereSpecialiToCallProcess"/>
                    <bpws:source linkName="OpereSpecialiToEmpty"
                        tibex:faultDetailsVar="OpereSpeciali" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:throw faultName="ns122:DefaultFault"
                faultVariable="Throw1-input" name="Throw1" tibex:xpdlId="59c393b4-d6a1-476c-a6ac-2302b81c9b0e">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Throw1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;'Errore nei sottoprocessi MappingREG_NP o MappingNGA_XDSL o Sottoprocesso UPDATEGestioneFatturazione. Record eliminati'&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;'Errore nei sottoprocessi MappingREG_NP o MappingNGA_XDSL o Sottoprocesso UPDATEGestioneFatturazione. Record eliminati'&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns2:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="DeleteRecordToThrow1"/>
                    <bpws:target linkName="Empty13ToThrow1"/>
                    <bpws:target linkName="Empty19ToThrow1"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:empty name="Empty" tibex:xpdlId="f9378121-80b8-49f7-95d4-6298d1a7cf22">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToEmpty"/>
                    <bpws:target linkName="CallProcess2ToEmpty"/>
                    <bpws:target linkName="OpereSpecialiToEmpty"/>
                    <bpws:target linkName="Empty13ToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEmpty19">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="DeleteRecord-input"
                name="DeleteRecord" operation="DeleteRecord"
                outputVariable="DeleteRecord" partnerLink="DeleteRecord"
                portType="ns164:DeleteRecordPortType" tibex:xpdlId="c4b039dd-598a-42e3-a5bd-f352ce956557">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/DeleteRecord/" xmlns:tns6="http://www.tim.com/NOW/xsd/DeleteRecord/" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:template name="DeleteRecord-input" match="/"&gt;
        &lt;tns5:DeleteRecordRequest&gt;
            &lt;parameters&gt;
                &lt;tns6:Request&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO) or exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS)"&gt;
                            &lt;tns6:Timer&gt;
                                &lt;tns6:Timer&gt;
                                    &lt;xsl:value-of select="'Timer per Risottomissione o Invio'"/&gt;
                                &lt;/tns6:Timer&gt;
                            &lt;/tns6:Timer&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)"&gt;
                            &lt;tns6:BPMRequest&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA)"&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '-')"&gt;
                                                &lt;tns6:ID_RICH_OLO&gt;
                                                    &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')"/&gt;
                                                &lt;/tns6:ID_RICH_OLO&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:choose&gt;
                                                    &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_A')"&gt;
                                                        &lt;tns6:ID_RICH_OLO&gt;
                                                            &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')"/&gt;
                                                        &lt;/tns6:ID_RICH_OLO&gt;
                                                    &lt;/xsl:when&gt;
                                                    &lt;xsl:otherwise&gt;
                                                        &lt;tns6:ID_RICH_OLO&gt;
                                                            &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R')"/&gt;
                                                        &lt;/tns6:ID_RICH_OLO&gt;
                                                    &lt;/xsl:otherwise&gt;
                                                &lt;/xsl:choose&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns6:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')"/&gt;
                                        &lt;/tns6:ID_RICH_OLO&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns6:BPMRequest&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS)"&gt;
                            &lt;tns6:BPMRequest&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA)"&gt;
                                        &lt;tns6:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS,'-')"/&gt;
                                        &lt;/tns6:ID_RICH_OLO&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns6:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')"/&gt;
                                        &lt;/tns6:ID_RICH_OLO&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns6:BPMRequest&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns6:BPMRequest&gt;
                                &lt;tns6:ID_RICH_OLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                                &lt;/tns6:ID_RICH_OLO&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0 and contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync,'_A')"&gt;
                                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"&gt;
                                            &lt;tns6:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"/&gt;
                                            &lt;/tns6:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="(string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0 and not(contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync,'_S')))  and (string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)&gt;0)"&gt;
                                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"&gt;
                                            &lt;tns6:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo"/&gt;
                                            &lt;/tns6:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa)&gt;0"&gt;
                                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"&gt;
                                            &lt;tns6:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"/&gt;
                                            &lt;/tns6:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
                                            &lt;tns6:ID_RISORSA&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                                            &lt;/tns6:ID_RISORSA&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW='ANNULLATO' or string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0"/&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns6:Asset&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAsset"&gt;
                                                &lt;IDAsset&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAsset"/&gt;
                                                &lt;/IDAsset&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;codiceOrdineOLO&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceOrdineOLO"/&gt;
                                            &lt;/codiceOrdineOLO&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceOrdineTI"&gt;
                                                &lt;codiceOrdineTI&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceOrdineTI"/&gt;
                                                &lt;/codiceOrdineTI&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;codificaOLOAGCOM&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codificaOLOAGCOM"/&gt;
                                            &lt;/codificaOLOAGCOM&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/invariante"&gt;
                                                &lt;invariante&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/invariante"/&gt;
                                                &lt;/invariante&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;created&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/created"/&gt;
                                            &lt;/created&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/lastUpdate"&gt;
                                                &lt;lastUpdate&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/lastUpdate"/&gt;
                                                &lt;/lastUpdate&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;operatore&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/operatore"/&gt;
                                            &lt;/operatore&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDRichiestaOLO"&gt;
                                                &lt;IDRichiestaOLO&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDRichiestaOLO"/&gt;
                                                &lt;/IDRichiestaOLO&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDPrimoOrdine"&gt;
                                                &lt;IDPrimoOrdine&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDPrimoOrdine"/&gt;
                                                &lt;/IDPrimoOrdine&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;IDContratto&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDContratto"/&gt;
                                            &lt;/IDContratto&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/DEC"&gt;
                                                &lt;DEC&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/DEC"/&gt;
                                                &lt;/DEC&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;statoAsset&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/statoAsset"/&gt;
                                            &lt;/statoAsset&gt;
                                            &lt;IDRisorsa&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDRisorsa"/&gt;
                                            &lt;/IDRisorsa&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/numeroTelefonico"&gt;
                                                &lt;numeroTelefonico&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/numeroTelefonico"/&gt;
                                                &lt;/numeroTelefonico&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAssetCRMWS"&gt;
                                                &lt;IDAssetCRMWS&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAssetCRMWS"/&gt;
                                                &lt;/IDAssetCRMWS&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAssetDa"&gt;
                                                &lt;IDAssetDa&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAssetDa"/&gt;
                                                &lt;/IDAssetDa&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;DES&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/DES"/&gt;
                                            &lt;/DES&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/ORA_DES"&gt;
                                                &lt;ORA_DES&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/ORA_DES"/&gt;
                                                &lt;/ORA_DES&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;tipologiaAccesso&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/tipologiaAccesso"/&gt;
                                            &lt;/tipologiaAccesso&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/RO"&gt;
                                                &lt;RO&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/RO"/&gt;
                                                &lt;/RO&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;offerta&gt;
                                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/offerta"/&gt;
                                            &lt;/offerta&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/lineaRiferimento"&gt;
                                                &lt;lineaRiferimento&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/lineaRiferimento"/&gt;
                                                &lt;/lineaRiferimento&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/complesso"&gt;
                                                &lt;complesso&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/complesso"/&gt;
                                                &lt;/complesso&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/interno"&gt;
                                                &lt;interno&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/interno"/&gt;
                                                &lt;/interno&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/piano"&gt;
                                                &lt;piano&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/piano"/&gt;
                                                &lt;/piano&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/scala"&gt;
                                                &lt;scala&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/scala"/&gt;
                                                &lt;/scala&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:copy-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/dettaglioasset"/&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/DESPrimoOrdine"&gt;
                                                &lt;DESPrimoOrdine&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/DESPrimoOrdine"/&gt;
                                                &lt;/DESPrimoOrdine&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/CAP"&gt;
                                                &lt;CAP&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/CAP"/&gt;
                                                &lt;/CAP&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceISTATComune"&gt;
                                                &lt;codiceISTATComune&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceISTATComune"/&gt;
                                                &lt;/codiceISTATComune&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceISTATProvincia"&gt;
                                                &lt;codiceISTATProvincia&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceISTATProvincia"/&gt;
                                                &lt;/codiceISTATProvincia&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceToponomastica"&gt;
                                                &lt;codiceToponomastica&gt;
                                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/codiceToponomastica"/&gt;
                                                &lt;/codiceToponomastica&gt;
                                            &lt;/xsl:if&gt;
