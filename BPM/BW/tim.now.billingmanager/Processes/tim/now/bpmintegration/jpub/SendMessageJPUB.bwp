                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SendJPUBRequest>&#xa;            &lt;tns3:Stato>&#xa;                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:Stato&quot;/>&#xa;            &lt;/tns3:Stato>&#xa;            &lt;tns3:BPMRequest>&#xa;                &lt;tns3:Richiesta>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                        &lt;/statoRichiestaPrecedNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO&quot;>&#xa;                        &lt;statoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO&quot;/>&#xa;                        &lt;/statoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                        &lt;statoRichiestaPrecedOLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                        &lt;/statoRichiestaPrecedOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/sottostatoLavorManuale&quot;>&#xa;                        &lt;sottostatoLavorManuale>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/sottostatoLavorManuale&quot;/>&#xa;                        &lt;/sottostatoLavorManuale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDFileInput&quot;>&#xa;                        &lt;IDFileInput>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDFileInput&quot;/>&#xa;                        &lt;/IDFileInput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns