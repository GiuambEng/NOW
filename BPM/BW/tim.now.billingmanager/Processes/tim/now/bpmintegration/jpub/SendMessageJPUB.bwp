            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NPSync>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A']&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo=$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;>&#xa;                        &lt;tns:Input>&#xa;                            &lt;tns:NP>&#xa;                                &lt;xsl:value-of select=&quot;'True'&quot;/>&#xa;                            &lt;/tns:NP>&#xa;                        &lt;/tns:Input>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Input>&#xa;                            &lt;tns:NP>&#xa;                                &lt;xsl:value-of select=&quot;'False'&quot;/>&#xa;                            &lt;/tns:NP>&#xa;                        &lt;/tns:Input>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:NPSync>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Variable" name="Assign1"
                    outputVariable="Variable"
                    tibex:xpdlId="1fb212ba-0701-4408-8093-1168ada01f9e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlNPToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToNPSync">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Variable/tns3:Input[tns3:NP='False'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Variable/tns3:Input[tns3:NP='False'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Assign1ToEmpty16">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NPSync>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A']&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo=$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRisorsa&quot;>&#xa;                        &lt;tns:Input>&#xa;                            &lt;tns:NP>&#xa;                                &lt;xsl:value-of select=&quot;'True'&quot;/>&#xa;                            &lt;/tns:NP>&#xa;                        &lt;/tns:Input>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Input>&#xa;                            &lt;tns:NP>&#xa;                                &lt;xsl:value-of select=&quot;'False'&quot;/>&#xa;                            &lt;/tns:NP>&#xa;                        &lt;/tns:Input>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:NPSync>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty6" tibex:xpdlId="7e720d39-d70a-4b19-aa96-155e8cbc5dd3">
                <bpws:targets>
                    <bpws:target linkName="LogInsertStagingNumeroPrincipaleToEmpty6"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty6ToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty6ToScope">
                        <tibex:DesignExpression>
                            <tibex:expression expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[true()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="Stag-input" name="Stag"
                operation="InsertUpdateStaging" outputVariable="Stag"
                partnerLink="StagingProcessManager"
                portType="ns24:InsertUpdateStagingPortType" tibex:xpdlId="eac2b707-a019-4d1d-ae22-0425b7d60d45">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="MappingREG_NPInvoke"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:param name="JDBC_CODFC_OLO"/&gt;
    &lt;xsl:param name="SendMessageJPUB_REG"/&gt;
    &lt;xsl:template name="Stag-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns5:StagingRequest&gt;
                    &lt;tns5:StagingOut&gt;
                        &lt;tns5:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS,true(),true())"/&gt;
                        &lt;/tns5:CONTENUTO_REQUEST&gt;
                        &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS"&gt;
                            &lt;tns5:ID_RISORSA&gt;
                                &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS"/&gt;
                            &lt;/tns5:ID_RISORSA&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns5:ID_RICH&gt;
                            &lt;xsl:value-of select="tib:timestamp()"/&gt;
                        &lt;/tns5:ID_RICH&gt;
                        &lt;tns5:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns5:ID_STATO_ELAB_STAG&gt;
                        &lt;tns5:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns5:TIMSTP_RICH&gt;
                        &lt;tns5:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns5:OPERATORE&gt;
                        &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
                            &lt;tns5:COD_ID_ORDN&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                            &lt;/tns5:COD_ID_ORDN&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) &gt; 0"&gt;
                                        &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR"&gt;
                                            &lt;tns5:COD_CONTRATTO&gt;
                                                &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR"/&gt;
                                            &lt;/tns5:COD_CONTRATTO&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) &gt; 0"&gt;
                                        &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR"&gt;
                                            &lt;tns5:COD_CONTRATTO&gt;
                                                &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR"/&gt;
                                            &lt;/tns5:COD_CONTRATTO&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM"&gt;
                            &lt;tns5:COD_GESTORE&gt;
                                &lt;xsl:value-of select="$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM"/&gt;
                            &lt;/tns5:COD_GESTORE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"&gt;
                            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;xsl:value-of select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:IDEventoSTS"/&gt;
                            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS"&gt;
                            &lt;tns5:ID_ORDINE_COMPOSTO&gt;
                                &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                            &lt;/tns5:ID_ORDINE_COMPOSTO&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns5:FLAG_CONSUNTIVO&gt;
                            &lt;xsl:value-of select="'0'"/&gt;
                        &lt;/tns5:FLAG_CONSUNTIVO&gt;
                    &lt;/tns5:StagingOut&gt;
                    &lt;tns5:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_JPUB_OUT&amp;quot;"/&gt;
                    &lt;/tns5:StagingType&gt;
                    &lt;tns5:LoggerIn&gt;
                        &lt;ns3:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaProcesso&gt;
                        &lt;ns3:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns3:TipologiaOperazione&gt;
                        &lt;ns3:EsecuzioneNOFileProcessato&gt;
                            &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                            &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                            &lt;ns3:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns3:STATO_ESEC&gt;
                            &lt;ns3:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns3:EsecuzioneNOFileProcessato&gt;
                        &lt;ns3:LogFileProcessato&gt;
                            &lt;ns3:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;
                            &lt;/ns3:LOG_LEVEL&gt;
                            &lt;ns3:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns3:LOG_MESSAGE&gt;
                            &lt;ns3:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TIMSTP_INSMTO&gt;
                        &lt;/ns3:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODFC_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:template name=&quot;Stag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;tns5:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:WLR/tns:STS,true(),true())&quot;/>&#xa;                &lt;/tns5:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS&quot;>&#xa;                    &lt;tns5:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS&quot;/>&#xa;                    &lt;/tns5:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;                &lt;/tns5:ID_RICH>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RICH>&#xa;                &lt;tns5:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns5:OPERATORE>&#xa;                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:COD_ID_ORDN>&#xa;                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:COD_ID_ORDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns5:COD_GESTORE>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns5:COD_GESTORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;>&#xa;                    &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:IDEventoSTS&quot;/>&#xa;                    &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                    &lt;tns5:ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/tns5:ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                &lt;/tns5:FLAG_CONSUNTIVO>&#xa;            &lt;/tns5:StagingOut>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;STAG_JPUB_OUT&amp;quot;&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns3:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaProcesso>&#xa;                &lt;ns3:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns3:TipologiaOperazione>&#xa;                &lt;ns3:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns3:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$SendMessageJPUB_REG&quot;/>&#xa;                    &lt;/ns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns3:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns3:STATO_ESEC>&#xa;                    &lt;ns3:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns3:EsecuzioneNOFileProcessato>&#xa;                &lt;ns3:LogFileProcessato>&#xa;                    &lt;ns3:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns3:LOG_LEVEL>&#xa;                    &lt;ns3:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns3:LOG_MESSAGE>&#xa;                    &lt;ns3:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns3:TIMSTP_INSMTO>&#xa;                &lt;/ns3:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty6ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="StagToCallProcess1"/>
                    <bpws:source
                        linkName="StagToLogFaultInsertStagingNumeroPrincipale"
