            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricizzazioneEventi/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;StoricizzazioneEventi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLInvoke/output/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                    &lt;ns:ORDINI_CRMWS>&#xa;                        &lt;xsl:for-each select=&quot;$MappingNGA_XDSLInvoke/output/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA&quot;>&#xa;                            &lt;ns:TESTATA>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                                &lt;DATA_MSG>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                &lt;/DATA_MSG>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                                &lt;xsl:if test=&quot;CUSTOMER&quot;>&#xa;                                    &lt;CUSTOMER>&#xa;                                        &lt;xsl:value-of select=&quot;CUSTOMER&quot;/>&#xa;                                    &lt;/CUSTOMER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(ns:ACCESSO)&quot;>&#xa;                                        &lt;xsl:copy-of select=&quot;ns:ACCESSO&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:copy-of select=&quot;ns:EVENTI&quot;/>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns:TESTATA>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/ns:ORDINI_CRMWS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                &lt;tns5:IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:IDRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                &lt;tns5:ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:if test=&quot;tns3:ID_RECUPERO_JPUB_MASTER&quot;>&#xa;                        &lt;tns5:ID_RECUPERO_JPUB_MASTER>&#xa;                            &lt;xsl:value-of select=&quot;tns3:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/tns5:ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns3:BDS_ID&quot;>&#xa;                        &lt;tns5:BDS_ID>&#xa;                            &lt;xsl:value-of select=&quot;tns3:BDS_ID&quot;/>&#xa;                        &lt;/tns5:BDS_ID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:ID_RECUPERO_JPUB_MASTER>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAsset&quot;>&#xa;                &lt;tns5:IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Asset/IDAsset&quot;/>&#xa;                &lt;/tns5:IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper1)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$Mapper1&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$Mapper&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS)&quot;>&#xa;                &lt;tns5:STS>&#xa;                    &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO&quot;/>&#xa;                &lt;/tns5:STS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
