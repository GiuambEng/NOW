                                    tibex:xpdlId="0a2a15b7-43b5-4381-89d4-c9fd58594866"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogErrorJPUBToEmpty2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogErrorJPUBToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta = &quot;REGOLATORIO&quot; or exists($SendJPUBIn/parameters/tns1:SendJPUBRequest/ns3:REGOLATORIO/ns3:TESTATA) or exists($SendJPUBIn/parameters/tns1:SendJPUBRequest/ns3:REGOLATORIO/ns3:PREVENTIVO) or $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta =&quot;NPG&quot; or $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta =&quot;NPNG&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta = "REGOLATORIO" or exists($SendJPUBIn.parameters/ns3:REGOLATORIO/ns3:TESTATA) or exists($SendJPUBIn.parameters/ns3:REGOLATORIO/ns3:PREVENTIVO) or $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta ="NPG" or $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta ="NPNG"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogErrorJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails1, true(), true())&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope/>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:invoke
                                    inputVariable="ErrorJPUBREG-input"
                                    name="ErrorJPUBREG"
                                    operation="ErrorSchema"
                                    outputVariable="ErrorJPUBREG"
                                    partnerLink="ErrorJPUBREG"
                                    portType="ns96:ErrorSchemaPortType" tibex:xpdlId="9136d491-e0b5-4f67-9ca6-5a9976d840a4">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="MappingREG_NPInvoke"/&gt;
    &lt;xsl:param name="UPDATEGestioneFatturazioneInvoke"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="InvokeJPUB_WLR"/&gt;
    &lt;xsl:param name="Mapper1"/&gt;
    &lt;xsl:template name="ErrorJPUBREG-input" match="/"&gt;
        &lt;tns6:ErrorSchemaRequest&gt;
            &lt;Input&gt;
                &lt;tns5:ErrorInput&gt;
                    &lt;tns5:TRANSACTION_DATE&gt;
                        &lt;xsl:value-of select="xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))"/&gt;
                    &lt;/tns5:TRANSACTION_DATE&gt;
                    &lt;tns5:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="concat($_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;
                    &lt;/tns5:TRANSACTION_ID&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO)"&gt;
                            &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/tns:ControlloStruttura"&gt;
                                &lt;tns5:RETURN_CODE&gt;
                                    &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/tns:ControlloStruttura"/&gt;
                                &lt;/tns5:RETURN_CODE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:ControlloStruttura"&gt;
                                &lt;tns5:RETURN_CODE&gt;
                                    &lt;xsl:value-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:ControlloStruttura"/&gt;
                                &lt;/tns5:RETURN_CODE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync,'_S')"&gt;
                                    &lt;tns5:TIPO_LAVORAZIONE&gt;
                                        &lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;
                                    &lt;/tns5:TIPO_LAVORAZIONE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns5:TIPO_LAVORAZIONE&gt;
                                        &lt;xsl:value-of select="&amp;quot;NPG&amp;quot;"/&gt;
                                    &lt;/tns5:TIPO_LAVORAZIONE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA) and string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer) &gt; 0"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;NPG&amp;quot;"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA) and string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer) = 0"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="&amp;quot;NPG&amp;quot;"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($Mapper1)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$Mapper1/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($Mapper)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$Mapper/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
                                &lt;tns5:ID_RICH_OLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                                &lt;/tns5:ID_RICH_OLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-') or contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R') or contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_A') or contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_S')"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')"&gt;
                                            &lt;tns5:ID_RICH_OLO&gt;
                                                &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')"/&gt;
                                            &lt;/tns5:ID_RICH_OLO&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')"&gt;
                                                    &lt;tns5:ID_RICH_OLO&gt;
                                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')"/&gt;
                                                    &lt;/tns5:ID_RICH_OLO&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')"&gt;
                                                    &lt;tns5:ID_RICH_OLO&gt;
                                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')"/&gt;
                                                    &lt;/tns5:ID_RICH_OLO&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;tns5:ID_RICH_OLO&gt;
                                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R')"/&gt;
                                                    &lt;/tns5:ID_RICH_OLO&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS"&gt;
                                        &lt;tns5:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                        &lt;/tns5:ID_RICH_OLO&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$InvokeJPUB_WLR/tns3:IDRichOLO='XX' or (string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:NPSync)&gt;0 and exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS))"&gt;
                        &lt;tns5:COD_PROCSO_NOFILE&gt;
                            &lt;xsl:value-of select="'STS'"/&gt;
                        &lt;/tns5:COD_PROCSO_NOFILE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:StatoNP)"&gt;
                            &lt;tns5:STATO&gt;
                                &lt;xsl:value-of select="&amp;quot;AGGIUNTIVO&amp;quot;"/&gt;
                            &lt;/tns5:STATO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:StatoNP)"&gt;
                            &lt;xsl:for-each select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot;]"&gt;
                                &lt;tns5:AGGIUNTIVI&gt;
                                    &lt;xsl:value-of select="&amp;quot;X&amp;quot;"/&gt;
                                &lt;/tns5:AGGIUNTIVI&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:for-each select="$UPDATEGestioneFatturazioneInvoke/output/tns:UPDATEGestioneFatturazioneResponse/tns:AGGIUNTIVI/tns:Record"&gt;
                        &lt;tns5:NP&gt;
                            &lt;tns5:ID_RISORSA&gt;
                                &lt;xsl:value-of select="tns:ID_RISORSA"/&gt;
                            &lt;/tns5:ID_RISORSA&gt;
                            &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                                &lt;xsl:value-of select="tns:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                            &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS&gt;
                            &lt;xsl:if test="tns:IDDETTAGLIOORDINE"&gt;
                                &lt;tns5:IDDETTAGLIOORDINE&gt;
                                    &lt;xsl:value-of select="tns:IDDETTAGLIOORDINE"/&gt;
                                &lt;/tns5:IDDETTAGLIOORDINE&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns5:NP&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS)"&gt;
                            &lt;tns5:ORDINEAGGIUNTIVI&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINEAGGIUNTIVI&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:for-each select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:StatoNP"&gt;
                        &lt;tns5:STATO_NP&gt;
                            &lt;tns5:StatoNumeriAggiuntivi&gt;
                                &lt;xsl:value-of select="tns3:StatoNumeriAggiuntivi"/&gt;
                            &lt;/tns5:StatoNumeriAggiuntivi&gt;
                        &lt;/tns5:STATO_NP&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:if test="exists($MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI)"&gt;
                        &lt;xsl:for-each select="$MappingREG_NPInvoke/output/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO"&gt;
                            &lt;tns5:AGGIUNTIVIWLR&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="ns2:TESTATA"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:AGGIUNTIVIWLR&gt;
                        &lt;/xsl:for-each&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/offerta"&gt;
                        &lt;tns5:OFFERTA&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/offerta"/&gt;
                        &lt;/tns5:OFFERTA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:WLRTimer"&gt;
                        &lt;tns5:WLRTimer&gt;
                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:WLRTimer"/&gt;
                        &lt;/tns5:WLRTimer&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns5:ErrorInput&gt;
            &lt;/Input&gt;
        &lt;/tns6:ErrorSchemaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJPUB_WLR&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorJPUBREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ErrorInput>&#xa;            &lt;tns5:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;            &lt;/tns5:TRANSACTION_DATE>&#xa;            &lt;tns5:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns5:TRANSACTION_ID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/tns:ControlloStruttura&quot;>&#xa;                        &lt;tns5:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/tns:ControlloStruttura&quot;/>&#xa;                        &lt;/tns5:RETURN_CODE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:ControlloStruttura&quot;>&#xa;                        &lt;tns5:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:ControlloStruttura&quot;/>&#xa;                        &lt;/tns5:RETURN_CODE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync,'_S')&quot;>&#xa;                            &lt;tns5:TIPO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                            &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TIPO_LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;                            &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA) and string-length($SendJPUBIn.parameters/tns3:NPTimer) > 0&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA) and string-length($SendJPUBIn.parameters/tns3:NPTimer) = 0&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper1)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$Mapper1/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$Mapper/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                        &lt;tns5:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns5:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-') or contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R') or contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_A') or contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_S')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;>&#xa;                                    &lt;tns5:ID_RICH_OLO>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'-')&quot;/>&#xa;                                    &lt;/tns5:ID_RICH_OLO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')&quot;>&#xa;                                            &lt;tns5:ID_RICH_OLO>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_S')&quot;/>&#xa;                                            &lt;/tns5:ID_RICH_OLO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')&quot;>&#xa;                                            &lt;tns5:ID_RICH_OLO>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_A')&quot;/>&#xa;                                            &lt;/tns5:ID_RICH_OLO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns5:ID_RICH_OLO>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS,'_R')&quot;/>&#xa;                                            &lt;/tns5:ID_RICH_OLO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                &lt;tns5:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                &lt;/tns5:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InvokeJPUB_WLR/tns3:IDRichOLO='XX' or (string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0 and exists($MappingREG_NPInvoke.output/tns:WLR/tns:STS))&quot;>&#xa;                &lt;tns5:COD_PROCSO_NOFILE>&#xa;                    &lt;xsl:value-of select=&quot;'STS'&quot;/>&#xa;                &lt;/tns5:COD_PROCSO_NOFILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:StatoNP)&quot;>&#xa;                    &lt;tns5:STATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AGGIUNTIVO&amp;quot;&quot;/>&#xa;                    &lt;/tns5:STATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:StatoNP)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMERIAGGIUNTIVI&amp;quot;]&quot;>&#xa;                        &lt;tns5:AGGIUNTIVI>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;X&amp;quot;&quot;/>&#xa;                        &lt;/tns5:AGGIUNTIVI>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:AGGIUNTIVI/tns:Record&quot;>&#xa;                &lt;tns5:NP>&#xa;                    &lt;tns5:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&#xa;                    &lt;/tns5:ID_RISORSA>&#xa;                    &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:if test=&quot;tns:IDDETTAGLIOORDINE&quot;>&#xa;                        &lt;tns5:IDDETTAGLIOORDINE>&#xa;                            &lt;xsl:value-of select=&quot;tns:IDDETTAGLIOORDINE&quot;/>&#xa;                        &lt;/tns5:IDDETTAGLIOORDINE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:NP>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:STS)&quot;>&#xa;                    &lt;tns5:ORDINEAGGIUNTIVI>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:STS/ns2:REGOLATORIO/ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINEAGGIUNTIVI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$SendJPUBIn.parameters/tns3:StatoNP&quot;>&#xa;                &lt;tns5:STATO_NP>&#xa;                    &lt;tns5:StatoNumeriAggiuntivi>&#xa;                        &lt;xsl:value-of select=&quot;tns3:StatoNumeriAggiuntivi&quot;/>&#xa;                    &lt;/tns5:StatoNumeriAggiuntivi>&#xa;                &lt;/tns5:STATO_NP>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                &lt;xsl:for-each select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                    &lt;tns5:AGGIUNTIVIWLR>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;ns2:TESTATA&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:AGGIUNTIVIWLR>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/offerta&quot;>&#xa;                &lt;tns5:OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/offerta&quot;/>&#xa;                &lt;/tns5:OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:WLRTimer&quot;>&#xa;                &lt;tns5:WLRTimer>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:WLRTimer&quot;/>&#xa;                &lt;/tns5:WLRTimer>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
