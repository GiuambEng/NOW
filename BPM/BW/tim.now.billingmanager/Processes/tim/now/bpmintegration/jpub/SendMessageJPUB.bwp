                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagAttesaDesospOLO"&gt;
                                &lt;flagAttesaDesospOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagAttesaDesospOLO"/&gt;
                                &lt;/flagAttesaDesospOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagDeliveryExposed"&gt;
                                &lt;flagDeliveryExposed&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/flagDeliveryExposed"/&gt;
                                &lt;/flagDeliveryExposed&gt;
