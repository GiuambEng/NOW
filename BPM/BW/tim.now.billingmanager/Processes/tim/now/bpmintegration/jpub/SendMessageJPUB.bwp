                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/UPDATEGestioneFatturazione/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:UPDATEGestioneFatturazioneRequest>&#xa;            &lt;xsl:copy-of select=&quot;$SendJPUBIn.parameters&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                    &lt;tns:ContenutoREG>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&#xa;                    &lt;/tns:ContenutoREG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ContenutoREG>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Mapper1, true(), true())&quot;/>&#xa;                    &lt;/tns:ContenutoREG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Mapper/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE&quot;>&#xa;                        &lt;tns:TIPO_AZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/ns2:TESTATA[1]/ns2:ACCESSO[1]/TIPO_AZIONE&quot;/>&#xa;                        &lt;/tns:TIPO_AZIONE>&#xa;                   