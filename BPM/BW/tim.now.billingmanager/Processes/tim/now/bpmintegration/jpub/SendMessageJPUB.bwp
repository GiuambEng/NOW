                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateStagingOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/MsgCode,$_error/Class,$_error/FullClass,$_error/StackTrace,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="ControlloChiamata" tibex:xpdlId="a7f048c3-7a86-4720-926a-2a5a971d0ba3">
                <bpws:targets>
                    <bpws:target linkName="LogOpereSpecialiToEmpty3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty3ToParseStaging_false">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$OpereSpeciali/output/tns5:OpereSpecialiResponse/tns5:ControlloStaging=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$OpereSpeciali.output/tns5:ControlloStaging=false()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlloChiamataToScope_true">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="ControlNP" tibex:xpdlId="670946df-f887-45db-a137-030224ea1672">
                <bpws:targets>
                    <bpws:target linkName="Empty5ToControlNP"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ControlNPToEmpty15">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlNPToAssign1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEAATTIVANP' or $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEAATTIVANP'  or $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='ULLDATILINEAATTIVANP') and $SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and exists($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY']) and exists($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY']/azione='A')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEAATTIVANP' or $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEAATTIVANP'  or $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/offerta='ULLDATILINEAATTIVANP') and $SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY']) and exists($SendJPUBIn.parameters/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY']/azione='A')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="NPSync-input" name="NPSync"
                operation="MappingREG_NP" outputVariable="NPSync"
                partnerLink="MappingREG_NP"
                portType="ns158:MappingREG_NPPortType" tibex:xpdlId="1fda23a0-20a7-4b20-9413-0f5b27b54858">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:template name="NPSync-input" match="/"&gt;
        &lt;tns2:MappingREG_NPRequest&gt;
            &lt;input&gt;
                &lt;tns3:SendJPUBRequest&gt;
                    &lt;tns3:Stato&gt;
                        &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:Stato"/&gt;
                    &lt;/tns3:Stato&gt;
                    &lt;tns3:BPMRequest&gt;
                        &lt;tns3:Richiesta&gt;
                            &lt;created&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/created"/&gt;
                            &lt;/created&gt;
                            &lt;lastUpdate&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lastUpdate"/&gt;
                            &lt;/lastUpdate&gt;
                            &lt;operatore&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/operatore"/&gt;
                            &lt;/operatore&gt;
                            &lt;IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                            &lt;/IDRichiestaOLO&gt;
                            &lt;statoRichiestaNOW&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaNOW"/&gt;
                            &lt;/statoRichiestaNOW&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW"&gt;
                                &lt;statoRichiestaPrecedNOW&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedNOW"/&gt;
                                &lt;/statoRichiestaPrecedNOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO"&gt;
                                &lt;statoRichiestaOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaOLO"/&gt;
                                &lt;/statoRichiestaOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO"&gt;
                                &lt;statoRichiestaPrecedOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/statoRichiestaPrecedOLO"/&gt;
                                &lt;/statoRichiestaPrecedOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/sottostatoLavorManuale"&gt;
                                &lt;sottostatoLavorManuale&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/sottostatoLavorManuale"/&gt;
                                &lt;/sottostatoLavorManuale&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDFileInput"&gt;
                                &lt;IDFileInput&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDFileInput"/&gt;
                                &lt;/IDFileInput&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDFileOutput"&gt;
                                &lt;IDFileOutput&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDFileOutput"/&gt;
                                &lt;/IDFileOutput&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ambito"&gt;
                                &lt;ambito&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/ambito"/&gt;
                                &lt;/ambito&gt;
                            &lt;/xsl:if&gt;
                            &lt;canaleRichiesta&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/canaleRichiesta"/&gt;
                            &lt;/canaleRichiesta&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione"&gt;
                                &lt;lavorazione&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/lavorazione"/&gt;
                                &lt;/lavorazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/progressivoRichiestaFile"&gt;
                                &lt;progressivoRichiestaFile&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/progressivoRichiestaFile"/&gt;
                                &lt;/progressivoRichiestaFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;strutturaRichiesta&gt;
                                &lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;
                            &lt;/strutturaRichiesta&gt;
                            &lt;tipoRichiesta&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/tipoRichiesta"/&gt;
                            &lt;/tipoRichiesta&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"&gt;
                                &lt;IDRisorsa&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRisorsa"/&gt;
                                &lt;/IDRisorsa&gt;
                            &lt;/xsl:if&gt;
                            &lt;codificaOLOAGCOM&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codificaOLOAGCOM"/&gt;
                            &lt;/codificaOLOAGCOM&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codificaOLONOW"&gt;
                                &lt;codificaOLONOW&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codificaOLONOW"/&gt;
                                &lt;/codificaOLONOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO"&gt;
                                &lt;codiceOrdineOLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLO"/&gt;
                                &lt;/codiceOrdineOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLOTarget"&gt;
                                &lt;codiceOrdineOLOTarget&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLOTarget"/&gt;
                                &lt;/codiceOrdineOLOTarget&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLOPadre"&gt;
                                &lt;codiceOrdineOLOPadre&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineOLOPadre"/&gt;
                                &lt;/codiceOrdineOLOPadre&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineTI"&gt;
                                &lt;codiceOrdineTI&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineTI"/&gt;
                                &lt;/codiceOrdineTI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineTITarget"&gt;
                                &lt;codiceOrdineTITarget&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceOrdineTITarget"/&gt;
                                &lt;/codiceOrdineTITarget&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceProgetto"&gt;
                                &lt;codiceProgetto&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceProgetto"/&gt;
                                &lt;/codiceProgetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;dataInvioRichiesta&gt;
                                &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/dataInvioRichiesta"/&gt;
                            &lt;/dataInvioRichiesta&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDAnagraficaCausale"&gt;
                                &lt;IDAnagraficaCausale&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDAnagraficaCausale"/&gt;
                                &lt;/IDAnagraficaCausale&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDCorrelazione"&gt;
                                &lt;IDCorrelazione&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDCorrelazione"/&gt;
                                &lt;/IDCorrelazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/totaleRichiestePacchetto"&gt;
                                &lt;totaleRichiestePacchetto&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/totaleRichiestePacchetto"/&gt;
                                &lt;/totaleRichiestePacchetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/tipoPacchetto"&gt;
                                &lt;tipoPacchetto&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/tipoPacchetto"/&gt;
                                &lt;/tipoPacchetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDPacchettoNOW"&gt;
                                &lt;IDPacchettoNOW&gt;
