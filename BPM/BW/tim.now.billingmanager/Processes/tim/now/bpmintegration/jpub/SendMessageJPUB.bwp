                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpeciali.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLInvoke.output&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderJPUBXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;ORDINI_CRMWS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA&quot;>&#xa;                        &lt;TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                            &lt;xsl:if test=&quot;FLAG_ONE_STEP&quot;>&#xa;                                &lt;FLAG_ONE_STEP>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_ONE_STEP&quot;/>&#xa;                                &lt;/FLAG_ONE_STEP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;xsl:if test=&quot;CUSTOMER&quot;>&#xa;                                &lt;CUSTOMER>&#xa;                                    &lt;xsl:value-of select=&quot;CUSTOMER&quot;/>&#xa;                                &lt;/CUSTOMER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;SISTEMA_MITTENTE&quot;>&#xa;                                &lt;SISTEMA_MITTENTE>&#xa;                                    &lt;xsl:value-of select=&quot;SISTEMA_MITTENTE&quot;/>&#xa;                                &lt;/SISTEMA_MITTENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(ns:FEEDER)&quot;>&#xa;                                    &lt;FEEDER>&#xa;                                        &lt;TIPO_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/TIPO_CONTR&quot;/>&#xa;                                        &lt;/TIPO_CONTR>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/CODE_CONTR&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/ID_RIS&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/TIPO_AZIONE&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                        &lt;CLASSE_SERVIZIO>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/CLASSE_SERVIZIO&quot;/>&#xa;                                        &lt;/CLASSE_SERVIZIO>&#xa;                                        &lt;CODE_MACRO_AREA>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/CODE_MACRO_AREA&quot;/>&#xa;                                        &lt;/CODE_MACRO_AREA>&#xa;                                        &lt;PRIMO_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/PRIMO_CLLI&quot;/>&#xa;                                        &lt;/PRIMO_CLLI>&#xa;                                        &lt;NEXT_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/NEXT_CLLI&quot;/>&#xa;                                        &lt;/NEXT_CLLI>&#xa;                                        &lt;KIT_CONS>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/KIT_CONS&quot;/>&#xa;                                        &lt;/KIT_CONS>&#xa;                                        &lt;ID_VLAN_OLO>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/ID_VLAN_OLO&quot;/>&#xa;                                        &lt;/ID_VLAN_OLO>&#xa;                                        &lt;BANDA>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/BANDA&quot;/>&#xa;                                        &lt;/BANDA>&#xa;                                        &lt;TIPO_TRASP>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/TIPO_TRASP&quot;/>&#xa;                                        &lt;/TIPO_TRASP>&#xa;                                        &lt;AS_NUMBER>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/AS_NUMBER&quot;/>&#xa;                                        &lt;/AS_NUMBER>&#xa;                                        &lt;IP_SESSIONE_EBGP>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/IP_SESSIONE_EBGP&quot;/>&#xa;                                        &lt;/IP_SESSIONE_EBGP>&#xa;                                        &lt;QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/QUALITA&quot;/>&#xa;                                        &lt;/QUALITA>&#xa;                                        &lt;CODE_ORDINE_TIM>&#xa;                                            &lt;xsl:value-of select=&quot;ns:FEEDER/CODE_ORDINE_TIM&quot;/>&#xa;                                        &lt;/CODE_ORDINE_TIM>&#xa;                                    &lt;/FEEDER>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists(ns:CANALE)&quot;>&#xa;                                    &lt;CANALE>&#xa;                                        &lt;TIPO_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/TIPO_CONTR&quot;/>&#xa;                                        &lt;/TIPO_CONTR>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/CODE_CONTR&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/ID_RIS&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/TIPO_AZIONE&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                        &lt;xsl:if test=&quot;ns:CANALE/CLLI_FEEDER&quot;>&#xa;                                            &lt;CLLI_FEEDER>&#xa;                                                &lt;xsl:value-of select=&quot;ns:CANALE/CLLI_FEEDER&quot;/>&#xa;                                            &lt;/CLLI_FEEDER>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns:CANALE/CLLI_SEDE_OLT&quot;>&#xa;                                            &lt;CLLI_SEDE_OLT>&#xa;                                                &lt;xsl:value-of select=&quot;ns:CANALE/CLLI_SEDE_OLT&quot;/>&#xa;                                            &lt;/CLLI_SEDE_OLT>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;CODE_MACRO_AREA>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/CODE_MACRO_AREA&quot;/>&#xa;                                        &lt;/CODE_MACRO_AREA>&#xa;                                        &lt;xsl:if test=&quot;ns:CANALE/IP_SORGENTE&quot;>&#xa;                                            &lt;IP_SORGENTE>&#xa;                                                &lt;xsl:value-of select=&quot;ns:CANALE/IP_SORGENTE&quot;/>&#xa;                                            &lt;/IP_SORGENTE>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns:CANALE/IP_MULTICAST&quot;>&#xa;                                            &lt;IP_MULTICAST>&#xa;                                                &lt;xsl:value-of select=&quot;ns:CANALE/IP_MULTICAST&quot;/>&#xa;                                            &lt;/IP_MULTICAST>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;BANDA_NOMINALE>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/BANDA_NOMINALE&quot;/>&#xa;                                        &lt;/BANDA_NOMINALE>&#xa;                                        &lt;FLAG_PRIMO_CANALE>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/FLAG_PRIMO_CANALE&quot;/>&#xa;                                        &lt;/FLAG_PRIMO_CANALE>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/ID_RIS_OLD&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                        &lt;CODE_ORDINE_TIM>&#xa;                                            &lt;xsl:value-of select=&quot;ns:CANALE/CODE_ORDINE_TIM&quot;/>&#xa;                                        &lt;/CODE_ORDINE_TIM>&#xa;                                    &lt;/CANALE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists(ns:OLT)&quot;>&#xa;                                    &lt;OLT>&#xa;                                        &lt;TIPO_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:OLT/TIPO_CONTR&quot;/>&#xa;                                        &lt;/TIPO_CONTR>&#xa;                                        &lt;CODE_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;ns:OLT/CODE_CONTR&quot;/>&#xa;                                        &lt;/CODE_CONTR>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;ns:OLT/ID_RIS&quot;/>&#xa;                           