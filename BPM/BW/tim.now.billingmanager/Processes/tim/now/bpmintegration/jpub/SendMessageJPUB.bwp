                    <bpws:invoke inputVariable="InvokeJPUBXDSL-input"
                        name="InvokeJPUBXDSL" operation="ricezione"
                        outputVariable="InvokeJPUBXDSL"
                        partnerLink="OrdineXDSLCRMNOW1"
                        portType="ns121:OrdineXDSLCRMNOW" tibex:xpdlId="731cd713-a6a2-4216-b16b-a71fbcd35316">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns3="http://crmnow.ordinexdsl.jpub.internal.concrete/" xmlns:tns0="http://crmnow.ordinexdsl.jpub.internal/types/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" version="2.0"&gt;
    &lt;xsl:param name="ParseXmlXDSL"/&gt;
    &lt;xsl:param name="MappingNGA_XDSLInvoke"/&gt;
    &lt;xsl:template name="InvokeJPUBXDSL-input" match="/"&gt;
        &lt;ns3:OrdineXDSLCRMNOW_ricezione&gt;
            &lt;parameters&gt;
                &lt;tns0:ricezioneElement&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingNGA_XDSLInvoke/output/tns:MappingNGA_XDSLResponse/ns:ORDINI_CRMWS/ns:TESTATA)"&gt;
                            &lt;tns0:ID_ORDINE_CRM&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS)"&gt;
                                        &lt;xsl:value-of select="$ParseXmlXDSL/TESTATA[1]/ID_ORD_CRMWS"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/tns0:ID_ORDINE_CRM&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
