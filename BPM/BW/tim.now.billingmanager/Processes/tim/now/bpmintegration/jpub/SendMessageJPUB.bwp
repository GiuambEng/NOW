                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty12ToStoricizzazioneEventi">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($SendJPUBIn/parameters/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
