t/tns:MappingREG_NPResponse/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO&quot;>&#xa;                        &lt;tns7:AGGIUNTIVIWLR>&#xa;                            &lt;ns2:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;ns2:TESTATA&quot;/>&#xa;                            &lt;/ns2:REGOLATORIO>&#xa;                        &lt;/tns7:AGGIUNTIVIWLR>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns7:OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns7:OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                &lt;tns7:WLRTimer>&#xa;                    &lt;xsl:value-of select=&quot;$Stag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                &lt;/tns7:WLRTimer>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns7:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
