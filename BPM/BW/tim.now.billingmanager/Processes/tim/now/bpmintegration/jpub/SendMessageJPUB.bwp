ameters/tns3:NPSYNCREG&quot;>&#xa;                &lt;tns3:NPSYNCREG>&#xa;                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:NPSYNCREG&quot;/>&#xa;                &lt;/tns3:NPSYNCREG>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:SendJPUBRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
