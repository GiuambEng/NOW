                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateDA_INVIARE_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogControlloXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UpdateDA_INVIARE_XDSL)&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(string($UpdateDA_INVIARE_XDSL/noOfUpdates), &amp;quot; record aggiornati con DA_INVIARE per TRANSACTION_ID = Null.&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Messaggio verso JPUB XDSL - NGA eseguito con successo.&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogControlloXDSL-input"
                                    name="LogControlloXDSL"
                                    tibex:xpdlId="aff1c352-c408-49b5-812f-888613e3813e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ErrorJPUBXDSLToLogControlloXDSL"/>
                                    <bpws:target linkName="UpdateDA_INVIARE_XDSLToLogControlloXDSL"/>
                                    <bpws:target linkName="Empty3ToLogControlloXDSL"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogControlloXDSLToUpdateStaging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateDA_INVIARE_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:template name=&quot;LogControlloXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendMessageJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendJPUB&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                    &lt;tns2:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                    &lt;/tns2:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($UpdateDA_INVIARE_XDSL)&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(string($UpdateDA_INVIARE_XDSL/noOfUpdates), &amp;quot; record aggiornati con DA_INVIARE per TRANSACTION_ID = Null.&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Messaggio verso JPUB XDSL - NGA eseguito con successo.&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:invoke
                                    inputVariable="ErrorOpereSpeciali-input"
                                    name="ErrorOpereSpeciali"
                                    operation="ErrorSchema"
                                    outputVariable="ErrorOpereSpeciali"
                                    partnerLink="ErrorOpereSpeciali"
                                    portType="ns96:ErrorSchemaPortType" tibex:xpdlId="9036a645-7016-44fe-8e79-95bd4e4bfb70">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/" xmlns:tns5="http://www.tim.com/NOW/xsd/ErrorSchema/" xmlns:tns3="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:ns2="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:tns1="http://www.tim.com/NOW/xsd/OpereSpeciali/" version="2.0"&gt;
    &lt;xsl:param name="SendJPUBIn"/&gt;
    &lt;xsl:param name="OpereSpeciali"/&gt;
    &lt;xsl:template name="ErrorOpereSpeciali-input" match="/"&gt;
        &lt;tns6:ErrorSchemaRequest&gt;
            &lt;Input&gt;
                &lt;tns5:ErrorInput&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;XDSL&amp;quot; or   $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NGA&amp;quot;"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'XDSL'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'NPG'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'REGOLATORIO'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO) and string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer) &gt; 0"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'NPG'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO) and string-length($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:NPTimer) = 0"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'REGOLATORIO'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO)"&gt;
                            &lt;tns5:TIPO_LAVORAZIONE&gt;
                                &lt;xsl:value-of select="'XDSL'"/&gt;
                            &lt;/tns5:TIPO_LAVORAZIONE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO)"&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns2:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns2:REGOLATORIO/ns2:PREVENTIVO"/&gt;
                                &lt;/ns2:REGOLATORIO&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:ORDINE&gt;
                                &lt;ns:ORDINI_CRMWS&gt;
                                    &lt;xsl:copy-of select="$OpereSpeciali/output/tns1:OpereSpecialiResponse/ns:ORDINI_CRMWS/ns:PREVENTIVO"/&gt;
                                &lt;/ns:ORDINI_CRMWS&gt;
                            &lt;/tns5:ORDINE&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest)"&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"&gt;
                                &lt;tns5:ID_RICH_OLO&gt;
                                    &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO"/&gt;
                                &lt;/tns5:ID_RICH_OLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO)"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')"&gt;
                                    &lt;tns5:ID_RICH_OLO&gt;
                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')"/&gt;
                                    &lt;/tns5:ID_RICH_OLO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW"&gt;
                                        &lt;tns5:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;
                                        &lt;/tns5:ID_RICH_OLO&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="contains($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')"&gt;
                                    &lt;tns5:ID_RICH_OLO&gt;
                                        &lt;xsl:value-of select="substring-before($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')"/&gt;
                                    &lt;/tns5:ID_RICH_OLO&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW"&gt;
                                        &lt;tns5:ID_RICH_OLO&gt;
                                            &lt;xsl:value-of select="$SendJPUBIn/parameters/tns3:SendJPUBRequest/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW"/&gt;
                                        &lt;/tns5:ID_RICH_OLO&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns5:ErrorInput&gt;
            &lt;/Input&gt;
        &lt;/tns6:ErrorSchemaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/ErrorSchema/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OpereSpeciali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpereSpeciali.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorOpereSpeciali-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ErrorInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;XDSL&amp;quot; or   $SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO) and string-length($SendJPUBIn.parameters/tns3:NPTimer) > 0&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO) and string-length($SendJPUBIn.parameters/tns3:NPTimer) = 0&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO)&quot;>&#xa;                    &lt;tns5:TIPO_LAVORAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                    &lt;/tns5:TIPO_LAVORAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($OpereSpeciali.output/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns2:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$OpereSpeciali.output/ns2:REGOLATORIO/ns2:PREVENTIVO&quot;/>&#xa;                        &lt;/ns2:REGOLATORIO>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:ORDINE>&#xa;                        &lt;ns:ORDINI_CRMWS>&#xa;                            &lt;xsl:copy-of select=&quot;$OpereSpeciali.output/ns:ORDINI_CRMWS/ns:PREVENTIVO&quot;/>&#xa;                        &lt;/ns:ORDINI_CRMWS>&#xa;                    &lt;/tns5:ORDINE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                    &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                        &lt;tns5:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns5:ID_RICH_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')&quot;>&#xa;                            &lt;tns5:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW,'-')&quot;/>&#xa;                            &lt;/tns5:ID_RICH_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;>&#xa;                                &lt;tns5:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                                &lt;/tns5:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')&quot;>&#xa;                            &lt;tns5:ID_RICH_OLO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW,'-')&quot;/>&#xa;                            &lt;/tns5:ID_RICH_OLO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;>&#xa;                                &lt;tns5:ID_RICH_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:PREVENTIVO[1]/ID_RICHIESTA_NOW&quot;/>&#xa;                                &lt;/tns5:ID_RICH_OLO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:ErrorInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
