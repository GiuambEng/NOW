                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($SendJPUBIn/parameters/tns3:SendJPUBRequest/ns2:REGOLATORIO) or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta = &amp;quot;NPG&amp;quot;"&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_REG"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns3:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$SendMessageJPUB_XDSL"/&gt;
                                    &lt;/ns3:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns3:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns3:STATO_ESEC&gt;
                            &lt;ns3:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns3:EsecuzioneNOFileProcessato&gt;
                        &lt;ns3:LogFileProcessato&gt;
                            &lt;ns3:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;
                            &lt;/ns3:LOG_LEVEL&gt;
                            &lt;ns3:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns3:LOG_MESSAGE&gt;
                            &lt;ns3:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns3:TIMSTP_INSMTO&gt;
                        &lt;/ns3:LogFileProcessato&gt;
                    &lt;/tns5:LoggerIn&gt;
                &lt;/tns5:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendJPUBIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;UPDATEGestioneFatturazioneInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB_REG&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODFC_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagingNumeroPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper1)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Mapper1,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0 and exists($MappingREG_NPInvoke.output/tns:WLR/tns:STS)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:WLR/tns:STS,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Mapper,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI,true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO, true(),true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO, true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA)&quot;>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO, true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS, true(), true())&quot;/>&#xa;                        &lt;/tns5:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) and (upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta) = &amp;quot;REGOLATORIO&amp;quot; or upper-case($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/strutturaRichiesta) = &amp;quot;NPG&amp;quot;)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDRisorsa&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0 and contains($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync,'_A')&quot;>&#xa;                                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:ID_RISORSA>&#xa;                                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMERIAGGIUNTIVI' and IDDettaglioOrdineParent=IDDettaglioOrdineRoot and azione='A'][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:ID_RISORSA>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync)>0   and not(contains($SendJPUBIn.parameters/tns3:BPMRequest/tns3:NPSync,'_S'))    and  string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                            &lt;tns5:ID_RISORSA>&#xa;                                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)][1]/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns5:ID_RISORSA>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa&quot;>&#xa;                                            &lt;tns5:ID_RISORSA>&#xa;                                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                                            &lt;/tns5:ID_RISORSA>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                                            &lt;tns5:ID_RISORSA>&#xa;                                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/tns5:ID_RISORSA>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;tns5:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/tns5:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/ID_RIS)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/ID_RIS&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/ID_RIS&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/ID_RIS)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/ID_RIS&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/ID_RIS&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA/ns:ACCESSO)&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/ID_RIS&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:EVENTI/ID_RIS&quot;>&#xa;                                    &lt;tns5:ID_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:EVENTI/ID_RIS&quot;/>&#xa;                                    &lt;/tns5:ID_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;                &lt;/tns5:ID_RICH>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns5:TIMSTP_RICH>&#xa;                &lt;tns5:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns5:OPERATORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/tns3:BPMRequest)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns5:COD_ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$SendJPUBIn.parameters/tns3:BPMRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns5:COD_ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SendJPUBIn.parameters/ns2:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_R')&quot;>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, &amp;quot;_R&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_A')&quot;>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, &amp;quot;_A&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, '_S')&quot;>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, &amp;quot;_S&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns2:REGOLATORIO/ns2:TESTATA[1]/ID_ORD_CRMWS, &amp;quot;-&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;not(contains($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS, 'pvm:'))&quot;>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;'EVENTJPUB'&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:COD_ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($SendJPUBIn.parameters/ns:ORDINI_CRMWS/ns:TESTATA[1]/ID_ORD_CRMWS, &amp;quot;-&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:COD_ID_ORDN>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:AGGIUNTIVI/ns2:REGOLATORIO[1]/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:WLR/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:REGOLATORIO)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:REGOLATORIO/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPInvoke.output/tns:NP/tns:PRINCIPALE/ns2:REGOLATORIO/ns2:TESTATA[1]/ns2:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/CODE_CONTR)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VP/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/CODE_CONTR)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:VLAN/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:EVENTI/CODE_CONTR)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:EVENTI/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:EVENTI/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR&quot;>&#xa;                                    &lt;tns5:COD_CONTRATTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLInvoke.output/ns:ORDINI_CRMWS/ns:TESTATA[1]/ns:ACCESSO[1]/CODE_CONTR&quot;/>&#xa;                                    &lt;/tns5:COD_CONTRATTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns5:COD_GESTORE>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODFC_OLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns5:COD_GESTORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;$UPDATEGestioneFatturazioneInvoke.output/tns:PRINCIPALE/tns:Record[1]/tns:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                &lt;/tns5:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:whe