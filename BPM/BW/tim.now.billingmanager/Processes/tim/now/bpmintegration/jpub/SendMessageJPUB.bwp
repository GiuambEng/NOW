;                                    &lt;tns3:Asset>&#xa;                                        &lt;xsl:if test=&quot;IDAsset&quot;>&#xa;                                            &lt;IDAsset>&#xa;                                                &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                            &lt;/IDAsset>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;codiceOrdineOLO>&#xa;                                            &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                                        &lt;/codiceOrdineOLO>&#xa;                                        &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                                            &lt;codiceOrdineTI>&#xa;                                                &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                                            &lt;/codiceOrdineTI>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;codificaOLOAGCOM>&#xa;                                            &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                                        &lt;/codificaOLOAGCOM>&#xa;                                        &lt;xsl:if test=&quot;invariante&quot;>&#xa;                                            &lt;invariante>&#xa;                                                &lt;xsl:value-of select=&quot;invariante&quot;/>&#xa;                                            &lt;/invariante>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;