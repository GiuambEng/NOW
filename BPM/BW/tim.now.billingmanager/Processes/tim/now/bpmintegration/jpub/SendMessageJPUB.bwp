                                &lt;/IDAnagraficaCausaleGUI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$SendJPUBIn/parameters/tns3:SendJPUBRequest/tns3:BPMRequest/tns3:Richiesta/codiceRifiutoDonating"&gt;
                                &lt;codiceRifiutoDonating&gt;
