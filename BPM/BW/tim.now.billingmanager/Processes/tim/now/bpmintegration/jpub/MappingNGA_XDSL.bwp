                                    columnName="PCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
