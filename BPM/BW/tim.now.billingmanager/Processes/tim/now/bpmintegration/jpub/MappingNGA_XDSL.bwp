                                               &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ATMVC&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo,'.')&quot;>&#xa;                                                            &lt;MCR_UP>&#xa;                                                                &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo,'.')&quot;/>&#xa;                                                            &lt;/MCR_UP>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;MCR_UP>&#xa;                                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                            &lt;/MCR_UP>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MCR_UP>&#xa;                                  