;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;6&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;        &lt;/tns15:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
