                                <tibex:activityExtension
                                    name="AccumulateVC"
                                    outputVariable="AccumulateVC"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="3420a932-9e7d-42fb-9b82-65fbac10ac1d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperVCToAccumulateVC"/>
                                    </bpws:targets>
