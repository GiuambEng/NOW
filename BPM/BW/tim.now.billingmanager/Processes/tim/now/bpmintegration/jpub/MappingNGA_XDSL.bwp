A_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='GUI' and ($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'  or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'  or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' ) and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETTM']/valoreAttributo)>0&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'VF'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns1:FEEDER>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_CONTR>