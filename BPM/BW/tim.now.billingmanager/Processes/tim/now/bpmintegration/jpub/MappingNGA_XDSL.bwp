                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO BO_TOOL_RECUPERO_JPUB_COS&#xa;  (TMSP_INSERIMENTO,TIPO_COS,BANDA_PICCO_UP,BANDA_PICCO_DOWN,ID_RECUPERO_JPUB_MASTER,ID_RISORSA)&#xa;  VALUES&#xa;  (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_INSERIMENTO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="TIPO_COS"/>

                                    <PreparedParameters
