taglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo) ]/attributidettaglioasset[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='ASSENTE'&quot;>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente=&amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo=$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo =$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo)]/attributidettaglioasset[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='PRESENTE'&quot;>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48' or upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;ASSENTE&amp;quot;&quot;>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;PRESENTE&amp;quot;&quot;>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPO_TRASP>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_TRASP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--controllare condizioni per la valorizzazione del tag-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with(upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta), &amp;quot;EASYIPBASEPLUS&amp;quot;) or  starts-with(upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta), &amp;quot;BITSTREAMATM&amp;quot;)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;PRESENTE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;1&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;2&amp;quot; or $JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;3&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MOD_FAT_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_FAT_TRASP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;MOD_FAT_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_FAT_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;MOD_FAT_TRASP>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/MOD_FAT_TRASP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot; or $JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                    &lt;KIT_CONS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/KIT_CONS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;KIT_CONS>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/KIT_CONS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODE_IDBRE_DSLAM>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/CODE_IDBRE_DSLAM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO)>0&quot;>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:VC>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperVC-input"
                                    name="MapperVC"
                                    outputVariable="MapperVC"
                                    tibex:xpdlId="b817d441-ca3d-46a0-913c-e54130d61c54" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToMapperVC"/>
                                    <bpws:target linkName="LogJDBCQuery_TIPO_TRASPORTOToMapperVC"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperVCToAccumulateVC"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CLASSE_SERV&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPCR_UP&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:VC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente=&amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo=$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and &amp;#xD;&amp;#xA;&amp;#x9;attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and &amp;#xD;&amp;#xA;&amp;#x9;attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/azione='A'&quot;>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/azione='D'&quot;>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione ='VARIAZIONE' and starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,'BITSTREAMATM') and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;RICHIESTAMONITORAGGIO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;RICHIESTAMONITORAGGIO&amp;quot;]/valoreAttributo)='SI'&quot;>&#xa;                            &lt;FLAG_MONITORAGGIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MONITORAGGIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MONITORAGGIO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MONITORAGGIO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_MONITORAGGIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/FLAG_MONITORAGGIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DATA_INIZIO_NOL>&#xa;                &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;            &lt;/DATA_INIZIO_NOL>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery_CLASSE_SERV/Record) > 0&quot;>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery_CLASSE_SERV/Record[1]/VALORE_TRASCODFCTO&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectPCR_UP/Record/PCR_UP)&quot;>&#xa;                            &lt;PCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string(xsd:integer($SelectPCR_UP/Record[1]/PCR_UP))&quot;/>&#xa;                            &lt;/PCR_UP_VC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/PCR_UP_VC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[no