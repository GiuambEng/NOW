xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;6&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                    &lt;BANDA_PICCO_UP>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6_MAX)&quot;/>&#xa;                    &lt;/BANDA_PICCO_UP>&#xa;                    &lt;BANDA_PICCO_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;/COS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery_ID_PROFILO_BMD/Record[string-length(PROFILO)>0])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery_ID_PROFILO_BMD/Record[1]/PROFILO&quot;>&#xa;                        &lt;PROFILO_CVLAN xsi:type=&quot;xsd:string&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery_ID_PROFILO_BMD/Record[1]/PROFILO&quot;/>&#xa;                        &lt;/PROFILO_CVLAN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;TIPO_CLUSTER>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/TIPO_CLUSTER>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;FTTH_ONLY>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/FTTH_ONLY>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo = ('SI','Y')&quot;>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:USER_VLAN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
