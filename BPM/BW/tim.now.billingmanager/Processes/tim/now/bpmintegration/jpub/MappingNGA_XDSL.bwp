                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT VALORE_TRASCODFCTO&#xd;&#xa;FROM TRASCODFC_ESTERNA&#xd;&#xa;WHERE VALORE_DA_TRASCODFCRE = ? AND ID_SISTEMA = ? AND TAG = ? AND AMBITO = ? AND COD_OFFERTA_JPUB = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
