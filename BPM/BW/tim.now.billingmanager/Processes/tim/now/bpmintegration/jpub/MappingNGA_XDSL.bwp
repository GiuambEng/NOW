s1:Richiesta/offerta,&amp;quot;SEMIBITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,&amp;quot;VULA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,&amp;quot;SEMIVULA&amp;quot;) or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIEASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo =&amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMSIMMETRICO' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMSIMMETRICOFLAT' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMSIMMETRICOHL'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIADELIVERY&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                            &lt;TECNOLOGIA>&#xa;                                                                &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIADELIVERY&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                            &lt;/TECNOLOGIA>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;TECNOLOGIA>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                            &lt;/TECNOLOGIA>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIADELIVERY&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;TECNOLOGIADELIVERY&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TECNOLOGIA>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TECNOLOGIA>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMASIMMETRICOFLAT' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMASIMMETRICOHL' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMATMASIMMETRICOLITE'&quot;>&#xa;                                            &lt;TECNOLOGIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&#xa;                                            &lt;/TECNOLOGIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TECNOLOGIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TECNOLOGIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;TIPO_PROVENIENZA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/TIPO_PROVENIENZA>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/numeroTelefonico) > 0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA='3'&quot;>&#xa;                                                    &lt;UTENZA_RIF>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/UTENZA_RIF>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;UTENZA_RIF>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/numeroTelefonico&quot;/>&#xa;                                                    &lt;/UTENZA_RIF>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;UTENZA_RIF>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/UTENZA_RIF>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta=('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','BITSTREAMNGAFTTCAB','VULAFTTH','SEMIVULAFTTH','VULAFTTCAB','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&#xa;                                            &lt;OPZ_CONTRATTUALE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/OPZ_CONTRATTUALE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;F1&amp;quot;&quot;>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;I&amp;quot;&quot;>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;F1&amp;quot;&quot;>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;I&amp;quot;&quot;>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;OPZ_CONTRATTUALE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;OPZ_CONTRATTUALE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/OPZ_CONTRATTUALE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'VULA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'SEMIVULA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'BITSTREAMNGA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'SEMIBITSTREAMNGA') or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTCAB' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='SEMIEASYIPNGAFTTH'&quot;>&#xa;                                                    &lt;ID_RIS_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/ID_RIS_OLD>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD)>0&quot;>&#xa;                                                            &lt;ID_RIS_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD&quot;/>&#xa;                                                            &lt;/ID_RIS_OLD>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ID_RIS_OLD>&#xa;                                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                            &lt;/ID_RIS_OLD>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'VULA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'SEMIVULA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'BITSTREAMNGA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, 'SEMIBITSTREAMNGA') or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTCAB' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='SEMIEASYIPNGAFTTH'&quot;>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD)>0&quot;>&#xa;                                                    &lt;ID_RIS_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD&quot;/>&#xa;                                                    &lt;/ID_RIS_OLD>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ID_RIS_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/ID_RIS_OLD>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/CLLI) > 0&quot;>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_CLLI>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;N.A.&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_CLLI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta='FWA'  and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;PROFILO_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/PROFILO_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta='FWA'  and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;PROFILO_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/PROFILO_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0 and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta!='BITSTREAMGBESIMMETRICOFLAT'&quot;>&#xa;                                            &lt;PROFILO_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/PROFILO_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nom