                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToAccumulateUSERVLAN"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns15=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bf8b48c4-6bcc-4716-833a-df27090b2fbb+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperUSERVLAN&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns15:jdbcUpdateActivityInput>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/