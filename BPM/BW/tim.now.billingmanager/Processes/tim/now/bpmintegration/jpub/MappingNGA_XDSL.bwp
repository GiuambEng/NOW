            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1628761014610&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:param name=&quot;Tipo_azione&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;SelectCOD_MODEM&quot;/>&lt;xsl:param name=&quot;MapperVC&quot;/>&lt;xsl:param name=&quot;AccumulateVC&quot;/>&lt;xsl:param name=&quot;AccumulateUSERVLAN&quot;/>&lt;xsl:param name=&quot;RecuperaAreaRaccoltaInvoke&quot;/>&lt;xsl:param name=&quot;SelectProfiloCommerciale&quot;/>&lt;xsl:param name=&quot;OLOGenerante&quot;/>&lt;xsl:param name=&quot;FLAG_ADESIONE_4APP&quot;/>&lt;xsl:param name=&quot;DATA_COMUNE_COINVESTITO&quot;/>&lt;xsl:param name=&quot;DatiVerificaControlliONESTEP&quot;/>&lt;xsl:param name=&quot;FLAG_PRIMO_CANALE_OLT&quot;/>&lt;xsl:param name=&quot;FLAG_PRIMO_CANALE_FE&quot;/>&lt;xsl:param name=&quot;FeederSuccessivi&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;USERVLAN&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/ns1:ORDINI_CRMWS)&quot;>&lt;xsl:copy-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/ns1:ORDINI_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:ORDINI_CRMWS>&lt;ns1:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)] ) or exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='CBTSATMSIMM' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($OLOGenerante/Record)>0 and exists($OLOGenerante/Record/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLOGenerante/Record/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), hours-from-dateTime($OLOGenerante/Record[1]/ORA_DES), minutes-from-dateTime($OLOGenerante/Record[1]/ORA_DES), xsd:int(seconds-from-dateTime($OLOGenerante/Record[1]/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='DATAINIZIORICARICA']/valoreAttributo)&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VP&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav) = &amp;quot;VARIAZIONETDKIT&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CARATTERISTICAVP']/valoreAttributo)= ('SPECIAL','STANDARD')&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'39'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CARATTERISTICAVP']/valoreAttributo)='LITE')&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'6'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'39'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VP&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav) = &amp;quot;VARIAZIONECARATTERISTICA&amp;quot;&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'38'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='GUI' and ($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'  or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'  or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' ) and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETTM']/valoreAttributo)>0&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'VF'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='SEDEOLT'&quot;>&lt;ns1:OLT>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&lt;/CODE_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBReque