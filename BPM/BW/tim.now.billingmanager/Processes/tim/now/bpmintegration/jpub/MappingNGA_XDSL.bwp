                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPO_TRASPORTO&#xa;FROM ANAG_VP&#xa;WHERE COD_VP = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

