                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateVC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns12:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns12:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($AccumulateVC)&quot;>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($AccumulateVC, true(), true())&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Le componente ATMVC non è presente.&amp;quot;&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMapperVC-input" name="LogMapperVC"
                    tibex:xpdlId="a288e2f0-9230-46c6-9944-3dcd09cdc280"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToLogMapperVC"/>
                        <bpws:target linkName="ControlToLogMapperVC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMapperVCToNumeroCicloAssign">
