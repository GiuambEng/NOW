;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/PCR_DOWN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PCR_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/PCR_DOWN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo)>0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                    &lt;ID_RIS_RACCOLTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS_RACCOLTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo)>0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                    &lt;ID_RIS_RACCOLTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS_RACCOLTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RIS_RACCOLTA>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ID_RIS_RACCOLTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo) > 0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                    &lt;ID_CVLAN>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_CVLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo) > 0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                    &lt;ID_CVLAN>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_CVLAN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_CVLAN>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/ID_CVLAN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery_DSLAM_TYPE/Record) > 0&quot;>&#xa;                    &lt;CODE_IDBRE_DSLAM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery_DSLAM_TYPE/Record[1]/DSLAM_TYPE&quot;/>&#xa;                    &lt;/CODE_IDBRE_DSLAM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODE_IDBRE_DSLAM>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CODE_IDBRE_DSLAM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--Verificare se il DSLAM_TYPE lo devo prendere dalla componente USERVLAN  nel caso dei simmetrici-->&#xa;            &lt;xsl:if test=&quot;exists($JDBCQuery_ID_PROFILO_BMD/Record)&quot;>&#xa;                &lt;COS>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                    &lt;BANDA_PICCO_UP>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2_MAX)&quot;/>&#xa;                    &lt;/BANDA_PICCO_UP>&#xa;                    &lt;BANDA_PICCO_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                    &lt;BANDA_PICCO_UP>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP3_MAX)&quot;/>&#xa;                    &lt;/BANDA_PICCO_UP>&#xa;                    &lt;BANDA_PICCO_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP3)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                    &lt;BANDA_PICCO_UP>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5_MAX)&quot;/>&#xa;                    &lt;/BANDA_PICCO_UP>&#xa;                    &lt;BANDA_PICCO_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;6&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                    &lt;BANDA_PICCO_UP>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6_MAX)&quot;/>&#xa;                    &lt;/BANDA_PICCO_UP>&#xa;                    &lt;BANDA_PICCO_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6)&quot;/>&#xa;                    &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;/COS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery_ID_PROFILO_BMD/Record[string-length(PROFILO)>0])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery_ID_PROFILO_BMD/Record[1]/PROFILO&quot;>&#xa;                        &lt;PROFILO_CVLAN xsi:type=&quot;xsd:string&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery_ID_PROFILO_BMD/Record[1]/PROFILO&quot;/>&#xa;                        &lt;/PROFILO_CVLAN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;TIPO_CLUSTER>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/TIPO_CLUSTER>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;FTTH_ONLY>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/FTTH_ONLY>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo = ('SI','Y')&quot;>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:USER_VLAN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperUSERVLAN-input"
                                    name="MapperUSERVLAN"
                                    outputVariable="MapperUSERVLAN"
                                    tibex:xpdlId="0db6b697-3f72-4517-b6de-8f9684a9a3b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogJDBCQuery_DSLAM_TYPEToMapperUSERVLAN"/>
                                    <bpws:target linkName="EmptyToMapperUSERVLAN"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperUSERVLANToAccumulateUSERVLAN">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="MapperUSERVLANToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBCQuery_ID_PROFILO_BMD/Record)>0 and string-length($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:NewBilling)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($JDBCQuery_ID_PROFILO_BMD/Record)>0 and string-length($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:NewBilling)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_DSLAM_TYPE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperUSERVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:USER_VLAN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='VARIAZIONETAGGING' and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;TAGGED&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset&amp;#xD;&amp;#xA;&amp;#x9;[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo =$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo, '/')&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo, '/')&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                     