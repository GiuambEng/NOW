                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CLASSE_SERV&quot;/>&#xa;    &lt;xsl:template name=&quot;LogJDBCQuery_CLASSE_SERV-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns12:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns12:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns12:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns12:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery_CLASSE_SERV/Record)&quot;>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;$JDBCQuery_CLASSE_SERV: &amp;quot;,  tib:render-xml($JDBCQuery_CLASSE_SERV/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;$JDBCQuery_CLASSE_SERV non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&