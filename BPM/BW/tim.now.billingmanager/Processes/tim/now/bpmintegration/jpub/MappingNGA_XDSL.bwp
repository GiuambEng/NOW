                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns15=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d7e711aa-10a8-46b8-9cc5-4405eb4839c7+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectPCR_UP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns15:jdbcQueryActivityInput>&#xa;            &lt;ID_PRFL_VC>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]&amp;#xD;&amp;#xA;[(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and &amp;#xD;&amp;#xA;&amp;#x9;attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDPROFILOVC&amp;quot;]/valoreAttributo)&quot;/>&#xa;            &lt;