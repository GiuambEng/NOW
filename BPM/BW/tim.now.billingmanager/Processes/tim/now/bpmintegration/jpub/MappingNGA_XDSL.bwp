                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1628761014610&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;FeederSuccessivi&quot; match=&quot;/&quot;>&#xa;        &lt;tns:FeederSuccessivi>&#xa;            &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;FEEDERSUCCESSIVO&amp;quot; and azione='A']&quot;>&#xa;                &lt;tns:FeederSuccessivo>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;>&#xa;                        &lt;tns:ID_RIS>&#xa;                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                        &lt;/tns:ID_RIS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CLLIFEEDERSUCCESSIVO']/valoreAttributo&quot;>&#xa;                        &lt;tns:NEXT_CLLI>&#xa;                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CLLIFEEDERSUCCESSIVO']/valoreAttributo&quot;/>&#xa;                        &lt;/tns:NEXT_CLLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:FeederSuccessivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:FeederSuccessivi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
