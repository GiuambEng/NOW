                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;resultSet>&lt;Record>&lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_COS']/value)&quot;>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_COS']/value&quot;/>&lt;/TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElement/column[name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='CARATTERISTICAVLAN']/value)&quot;>&lt;CARATTERISTICALVAN>&lt;xsl:value-of select=&quot;$currentElement/column[name='CARATTERISTICAVLAN']/value&quot;/>&lt;/CARATTERISTICALVAN>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElement/column[name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='BMC_LIGHT']/value)&quot;>&lt;BMC_LIGHT>&lt;xsl:value-of select=&quot;$currentElement/column[name='BMC_LIGHT']/value&quot;/>&lt;/BMC_LIGHT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_BANDA']/value)&quot;>&lt;TIPO_BANDA>&lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_BANDA']/value&quot;/>&lt;/TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_TRASPORTO']/value)&quot;>&lt;TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_TRASPORTO']/value&quot;/>&lt;/TIPO_TRASPORTO>&lt;/xsl:if>&lt;SVLANCODE>&lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and attributiDettaglioOrdine/nomeAttributo='SVLANCODE' and attributiDettaglioOrdine/valoreAttributo=$currentElement/column[name='SVLANCODE']/value]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo, &amp;quot;/&amp;quot;)&quot;/>&lt;/SVLANCODE>&lt;/Record>&lt;/resultSet>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="823bb43a-ddf9-482d-81b3-52c63507c84d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;resultSet>&#xa;            &lt;Record>&#xa;                &lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_COS']/value)&quot;>&#xa;                    &lt;TIPO_COS>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_COS']/value&quot;/>&#xa;                    &lt;/TIPO_COS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($currentElement/column[name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='CARATTERISTICAVLAN']/value)&quot;>&#xa;                    &lt;CARATTERISTICALVAN>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/column[name='CARATTERISTICAVLAN']/value&quot;/>&#xa;                    &lt;/CARATTERISTICALVAN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($currentElement/column[name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='BMC_LIGHT']/value)&quot;>&#xa;                    &lt;BMC_LIGHT>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/column[name='BMC_LIGHT']/value&quot;/>&#xa;                    &lt;/BMC_LIGHT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_BANDA']/value)&quot;>&#xa;                    &lt;TIPO_BANDA>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_BANDA']/value&quot;/>&#xa;                    &lt;/TIPO_BANDA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($currentElement/column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElement/column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElement/column[name='TIPO_TRASPORTO']/value)&quot;>&#xa;                    &lt;TIPO_TRASPORTO>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/column[name='TIPO_TRASPORTO']/value&quot;/>&#xa;                    &lt;/TIPO_TRASPORTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;SVLANCODE>&#xa;                    &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and attributiDettaglioOrdine/nomeAttributo='SVLANCODE' and attributiDettaglioOrdine/valoreAttributo=$currentElement/column[name='SVLANCODE']/value]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo, &amp;quot;/&amp;quot;)&quot;/>&#xa;                &lt;/SVLANCODE>&#xa;            &lt;/Record>&#xa;        &lt;/resultSet>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="resultSet" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="USERVLAN"
                    name="CalculateUserVlan" outputVariable="USERVLAN"
                    tibex:xpdlId="8e62f553-810c-489c-8c5a-e0e8e2a8cfec" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperUSERVLAToCalculateUserVlan"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CalculateUserVlanToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;USERVLAN&quot; match=&quot;/&quot;>&lt;resultSet>&lt;xsl:variable name=&quot;minIDSVLANCODE&quot; select=&quot;min($Accumulate/resultSet/Record/SVLANCODE)&quot;/>&lt;xsl:for-each select=&quot;$Accumulate/resultSet/Record[SVLANCODE=$minIDSVLANCODE]&quot;>&lt;Record>&lt;xsl:if test=&quot;TIPO_COS&quot;>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&lt;/TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;CARATTERISTICALVAN&quot;>&lt;CARATTERISTICALVAN>&lt;xsl:value-of select=&quot;CARATTERISTICALVAN&quot;/>&lt;/CARATTERISTICALVAN>&lt;/xsl:if>&lt;xsl:if test=&quot;BMC_LIGHT&quot;>&lt;BMC_LIGHT>&lt;xsl:value-of select=&quot;BMC_LIGHT&quot;/>&lt;/BMC_LIGHT>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO_BANDA&quot;>&lt;TIPO_BANDA>&lt;xsl:value-of select=&quot;TIPO_BANDA&quot;/>&lt;/TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO_TRASPORTO&quot;>&lt;TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;TIPO_TRASPORTO&quot;/>&lt;/TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;SVLANCODE&quot;>&lt;SVLANCODE>&lt;xsl:value-of select=&quot;SVLANCODE&quot;/>&lt;/SVLANCODE>&lt;/xsl:if>&lt;/Record>&lt;/xsl:for-each>&lt;/resultSet>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
