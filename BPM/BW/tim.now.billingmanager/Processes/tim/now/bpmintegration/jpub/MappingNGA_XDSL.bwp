pingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48' or upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente=&amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo=$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and &amp;#xD;&amp;#xA;&amp;#x9;attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo) ]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo)='DEDICATA'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente=&amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo=$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and &amp;#xD;&amp;#xA;&amp;#x9;attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo = &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N']&amp;#xD;&amp;#xA;[number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo) ]/attributidettaglioasset[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='ASSENTE'&quot;>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente=&amp;quot;ATMVC&amp;quot;][(attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo=$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo) or (attributidettaglioasset[nomeAttributo='DLCI']/valoreAttributo =$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo)]/attributidettaglioasset[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo)='PRESENTE'&quot;>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48' or upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;ASSENTE&amp;quot;&quot;>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;PRESENTE&amp;quot;&quot;>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPO_TRASP>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_TRASP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--controllare condizioni per la valorizzazione del tag-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta), &amp;quot;EASYIPBASEPLUS&amp;quot;) or  starts-with(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta), &amp;quot;BITSTREAMATM&amp;quot;)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TRASPORTO&amp;quot;]/valoreAttributo) = &amp;quot;PRESENTE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;1&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;2&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;3&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_FAT_TRASP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT_TRASP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MOD_FAT_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_FAT_TRASP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;MOD_FAT_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_FAT_TRASP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;MOD_FAT_TRASP>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/MOD_FAT_TRASP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                    &lt;KIT_CONS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot; and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/KIT_CONS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;KIT_CONS>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/KIT_CONS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODE_IDBRE_DSLAM>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/CODE_IDBRE_DSLAM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO)>0&quot;>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:VC>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
