                                    sqlStatement="SELECT * FROM APPUSER.bds_1_casedata_assoczncnlfdrlt WHERE IDASSETFEEDER = (SELECT IDASSET FROM APPUSER.BDS_1_CASEDATA_ASSET WHERE IDRISORSA  = ? AND OFFERTA = 'FEEDER')" xsi:type="jdbcPalette:JDBCQueryActivity">
