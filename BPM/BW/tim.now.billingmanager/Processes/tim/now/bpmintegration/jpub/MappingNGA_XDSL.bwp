                  &lt;/PRIMO_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;PRIMO_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;'-'&quot;/>&#xa;                                        &lt;/PRIMO_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:NEXT_CLLI)>0&quot;>&#xa;                                        &lt;NEXT_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;tns:NEXT_CLLI&quot;/>&#xa;                                        &lt;/NEXT_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;NEXT_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/NEXT_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETDKIT']/valoreAttributo)>0&quot;>&#xa;                                        &lt;KIT_CONS>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;/>&#xa;                                        &lt;/KIT_CONS