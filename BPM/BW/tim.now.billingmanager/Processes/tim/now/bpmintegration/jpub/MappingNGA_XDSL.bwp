                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta='FWA'  and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;VELDOWN&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;PCR_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo = &amp;quot;VELDOWN&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/PCR_DOWN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta='FWA'  and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;VELDOWN&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;PCR_DOWN>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;VELDOWN&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/PCR_DOWN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when te