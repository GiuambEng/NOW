                                    expression="exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;]) or exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
