                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $Count]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQuery_ID_PROFILO_BMDToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery_DSLAM_TYPEToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_ID_PROFILO_BMDToControlloOfferta" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_DSLAM_TYPEToMapperUSERVLAN" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart1ToEmpty"
                                    tibex:label="PROFILOBMD ASSENTE" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="MapperUSERVLANToAccumulateUSERVLAN" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="EmptyToJDBCQuery_DSLAM_GBE"
                                    tibex:label="GBE" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToMapperUSERVLAN" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="MapperUSERVLANToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateToAccumulateUSERVLAN" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="b361abaa-8e34-4feb-a7c9-0cc091360dc4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &quot;PROFILOBMD&quot;]/valoreAttributo) and $MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &quot;PROFILOBMD&quot;]/valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;) or (exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &quot;PROFILOBMD&quot;]/valoreAttributo) and $MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = &quot;PROFILOBMD&quot;]/valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "USERVLAN"and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = "PROFILOBMD"]/valoreAttributo) and $MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "USERVLAN"and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = "PROFILOBMD"]/valoreAttributo != "ATTRIBUTO IN ELIMINAZIONE") or (exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "GBEVC"and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = "PROFILOBMD"]/valoreAttributo) and $MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "GBEVC"and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo = "PROFILOBMD"]/valoreAttributo != "ATTRIBUTO IN ELIMINAZIONE")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
