est=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FAMIGLIAVLAN']/valoreAttributo)>0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FAMIGLIAVLAN']/valoreAttributo = '1'&quot;>&lt;QUALITA>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;QUALITA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codiceOrdineTI)>0&quot;>&lt;CODE_ORDINE_TIM>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/codiceOrdineTI&quot;/>&lt;/CODE_ORDINE_TIM>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineTI)>0&quot;>&lt;CODE_ORDINE_TIM>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineTI&quot;/>&lt;/CODE_ORDINE_TIM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_ORDINE_TIM>&lt;xsl:value-of select=&quot;'-'&quot;/>&lt;/CODE_ORDINE_TIM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns1:FEEDER>&lt;/ns1:TESTATA>&lt;/xsl:for-each>&lt;/ns1:ORDINI_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
