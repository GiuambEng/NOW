xD;&amp;#xA;or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIVULAFTTH')&amp;#xD;&amp;#xA;and (string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MERCATO']/valoreAttributo)>0 or &amp;#xD;&amp;#xA;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='MERCATO']/valoreAttributo)>0)&amp;#xD;&amp;#xA;and (count($Oscuramento/Record[COD_AGESP='T1PRJ0063400'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0063400'])>0 and ($Oscuramento/Record[COD_AGESP='T1PRJ0063400']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0063400']/FLAG_OSCURMENTO='N')))&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;>&#xa;                                                    &lt;EX_TIPO_CLUSTER>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/EX_TIPO_CLUSTER>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;>&#xa;                                                    &lt;EX_TIPO_CLUSTER>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/EX_TIPO_CLUSTER>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($AccumulateVC) and not(exists($Tipo_azione/tns4:TIPO_AZIONE))  and string-length($Tipo_azione/tns4:TIPO_AZIONE)=0&quot;>&#xa;                                            &lt;xsl:copy-of select=&quot;$AccumulateVC/ns1:VC&quot;/>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(not(exists($Tipo_azione/tns4:TIPO_AZIONE))  and string-length($Tipo_azione/tns4:TIPO_AZIONE)=0) and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILELITE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILEFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSLITE' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSFLAT' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='FIXEDWIRELESSACCESS' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='UBBSEMIGPON' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='FULLGPON1BPNRR' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='SEMIGPON1BPNRR')&quot;>&#xa;                                            &lt;ns1:SLA>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; and  ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH') and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav = 'CAMBIOSLA'&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; and  ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH')&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; and $COD_CAUS/tns4:COD_CAUS_DESTINATARIO!='47'&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;DATA_INIZIO_NOL>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                                &lt;/DATA_INIZIO_NOL>&#xa;                                                &lt;TIPO_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_SLA>&#xa;                                                &lt;!--Verificare 0 -   BASE -> se &lt;Tipo SLA> è null&#xa;2- SLA PREMIUM -> se  &lt;Tipo SLA> = 2-->&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE)>0&quot;>&#xa;                                                        &lt;OFFERTA_SLA>&#xa;                                                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE&quot;/>&#xa;                                                        &lt;/OFFERTA_SLA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;OFFERTA_SLA>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                        &lt;/OFFERTA_SLA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA)>0&quot;>&#xa;                                                        &lt;COPERTURA_ORARIA>&#xa;                                                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA&quot;/>&#xa;                                                        &lt;/COPERTURA_ORARIA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;COPERTURA_ORARIA>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                        &lt;/COPERTURA_ORARIA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ns1:SLA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($AccumulateUSERVLAN/ns1:USER_VLAN) and (not(exists($Tipo_azione/tns4:TIPO_AZIONE))  and string-length($Tipo_azione/tns4:TIPO_AZIONE)=0) or ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and &amp;#xD;&amp;#xA;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='VARIAZIONETAGGING')&quot;>&#xa;                                            &lt;xsl:copy-of select=&quot;$AccumulateUSERVLAN/ns1:USER_VLAN&quot;/>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns1:ACCESSO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns1:TESTATA>&#xa;                    &lt;xsl:for-each select=&quot;$FeederSuccessivi/tns:FeederSuccessivo&quot;>&#xa;                        &lt;ns1:TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='CBTSATMSIMM' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($OLOGenerante/Record)>0 and exists($OLOGenerante/Record/DES)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($OLOGenerante/Record/ORA_DES)&quot;>&#xa;                                                    &lt;DATA_DES>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), hours-from-dateTime($OLOGenerante/Record[1]/ORA_DES), minutes-from-dateTime($OLOGenerante/Record[1]/ORA_DES), xsd:int(seconds-from-dateTime($OLOGenerante/Record[1]/ORA_DES)))&quot;/>&#xa;                                                    &lt;/DATA_DES>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DATA_DES>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), 00,00,00)&quot;/>&#xa;                                                    &lt;/DATA_DES>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='DATAINIZIORICARICA']/valoreAttributo)&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='GUI' and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'  or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'  or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' ) and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETTM']/valoreAttributo)>0&quot;>&#xa;                                            &lt;CODE_CAUS>&#xa;                                                &lt;xsl:value-of select=&quot;'VF'&quot;/>&#xa;                                            &lt;/CODE_CAUS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_CAUS>&#xa;                                                &lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                            &lt;/CODE_CAUS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns1:FEEDER>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns:ID_RIS)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;tns:ID_RIS&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CLASSE_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                &lt;/CLASSE_SERVIZIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEMACROAREA']/valoreAttributo)>0&quot;>&#xa;                                        &lt;CODE_MACRO_AREA>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='