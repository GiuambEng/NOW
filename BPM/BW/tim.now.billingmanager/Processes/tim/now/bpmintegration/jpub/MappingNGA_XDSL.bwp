                                    name="CallProcessToJDBCQuery_TIPO_TRASPORTO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_TIPO_Cessazione"
                                    tibex:label="Cessazione" tibex:linkType="SUCCESSWITHCONDITION"/>
