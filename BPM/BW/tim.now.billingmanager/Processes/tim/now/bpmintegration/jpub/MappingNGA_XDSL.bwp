                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente='ATMVC' and azione!='N'])]]></bpws:condition>
