tarts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='BANDAMCR']/valoreAttributo&quot;/>&#xa;                                            &lt;/MCR_VP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;TIPO_PROVENIENZA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/TIPO_PROVENIENZA>&#xa;                                    &lt;OPZ_CONTRATTUALE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZARACCOLTA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&#xa;                                                    &lt;ID_RIS_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZARACCOLTA']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                                                    &lt;/ID_RIS_OLD>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ID_RIS_OLD>&#xa;                                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                    &lt;/ID_RIS_OLD>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns1:VP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VLANNGA' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VLANVULA'  or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VLAN'&quot;>&#xa;                                &lt;ns1:VLAN>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                              