']/valoreAttributo&quot;/>&#xa;                                                &lt;/FTTH_ONLY>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FTTHONLY']/valoreAttributo)>0 and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FTTHONLY']/valoreAttributo !='ATTRIBUTO IN ELIMINAZIONE'&quot;>&#xa;                                            &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FTTHONLY']/valoreAttributo&quot;>&#xa;                                                &lt;FTTH_ONLY>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FTTHONLY']/valoreAttributo&quot;/>&#xa;                                                &lt;/FTTH_ONLY>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and  string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, 'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERVLAN']/valoreAttributo)>0) or ((string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERVLAN']/valoreAttributo)>0) and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERVLAN']/valoreAttributo !='ATTRIBUTO IN ELIMINAZIONE'))&quot;>&#xa;                                            &lt;FTTH_ONLY>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/FTTH_ONLY>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='RACCOLTAVLANNGA']/attributidettaglioasset[nomeAttributo='CARATTERISTICAVLAN']/valoreAttributo)= 'DRG FTTH'&quot;>&#xa;                                            &lt;CARATT_DRG>&#xa;                                                &lt;xsl:value-of select=&quot;'FH'&quot;/>&#xa;                                            &lt;/CARATT_DRG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='RACCOLTAVLANNGA']/attributidettaglioasset[nomeAttributo='CARATTERISTICAVLAN']/valoreAttributo)= 'DRG OPZIONE ZERO'&quot;>&#xa;                                            &lt;CARATT_DRG>&#xa;                                                &lt;xsl:value-of select=&quot;'OZ'&quot;/>&#xa;                                            &lt;/CARATT_DRG>&#xa;                                        &lt;/xsl:when>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns1:VLAN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                &lt;ns1:EVENTI>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;UTENZA_RIF>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/UTENZA_RIF>&#xa;                                    &lt;VEL_BANDA_UP>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/VEL_BANDA_UP>&#xa;                                    &lt;VEL_BANDA_DOWN>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/VEL_BANDA_DOWN>&#xa;                                    &lt;FLAG_ESITO_PREQ>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/FLAG_ESITO_PREQ>&#xa;                                    &lt;CODE_OL>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODE_OL>&#xa;                                    &lt;DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/DONOR>&#xa;                                    &lt;TIPO_NUMERO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/TIPO_NUMERO>&#xa;                                    &lt;PORTABILITA>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/PORTABILITA>&#xa;                                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOTIPOLOGIARICARICA']/valoreAttributo&quot;>&#xa;                                        &lt;RICARICA>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOTIPOLOGIARICARICA']/valoreAttributo&quot;/>&#xa;                                        &lt;/RICARICA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns1:EVENTI>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns1:ACCESSO>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa) > 0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                    &lt;OPZ_COMM>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:OPZ_COMM&quot;/>&#xa;                                    &lt;/OPZ_COMM>&#xa;                                    &lt;TIPO_LINEA>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA&quot;/>&#xa;                                    &lt;/TIPO_LINEA>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta !=&amp;quot;NGA&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTCAB&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTH&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;SEMIVULAFTTH&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT&quot;/>&#xa;                                            &lt;/MOD_FAT>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_FAT>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;47&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;48&amp;quot;&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;2&amp;quot;&quot;>&#xa;                                                    &lt;TIPO_MOD_FAT>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                    &lt;/TIPO_MOD_FAT>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_MOD_FAT>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TIPO_MOD_FAT>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_MOD_FAT>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                    &lt;TIPO_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_TRASP>&#xa;                                    &lt;MOD_FAT_TRASP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_FAT_TRASP>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                            &lt;DATA_INIZIO_NOL>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                            &lt;/DATA_INIZIO_NOL>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_INIZIO_NOL>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                            &lt;/DATA_INIZIO_NOL>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;ID_RIS_LOTTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/ID_RIS_LOTTO>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke.Output/tns3:CodeArea) > 0&quot;>&#xa;                                            &lt;CODE_AREA>&#xa;                                                &lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke.Output/tns3:CodeArea&quot;/>&#xa;                                            &lt;/CODE_AREA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_AREA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_AREA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke.Output/tns3:CodeMacroArea) > 0&quot;>&#xa;                                            &lt;CODE_MACRO_AREA>&#xa;                                                &lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke.Output/tns3:CodeMacroArea&quot;/>&#xa;                                            &lt;/CODE_MACRO_AREA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_MACRO_AREA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_MACRO_AREA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;KIT_CONS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/KIT_CONS>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_COMUNE=&amp;quot;6666&amp;quot;&quot;>&#xa;                                            &lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;CODE_ID_ULLCO xsi:type=&quot;xsd:string&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($SelectProfiloCommerciale/Record)>0&quot;>&#xa;                                            &lt;BANDA_SIMM>&#xa;                                                &lt;xsl:value-of select=&quot;string(xsd:integer($SelectProfiloCommerciale/Record[1]/PROFILO_COMMERCIALE_DOWN))&quot;/>&#xa;                                            &lt;/BANDA_SIMM>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;BANDA_SIMM>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/BANDA_SIMM>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;TIPO_PROT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_PROT>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns