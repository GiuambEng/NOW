            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FeederSuccessivi&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFeederSUCC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns12:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns12:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns12:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;FEEDERSUCCESSIVO costruiti: &amp;quot;, tib:render-xml($FeederSuccessivi, true(), true()))&quot;/>&#xa;                &lt;/tns12:Message>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogFeederSUCC-input"
                    name="LogFeederSUCC"
                    tibex:xpdlId="1e37e814-a020-4193-b4d8-b4901b4e1fb6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FeederSUCCToGenericLogger1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogFeederSUCCToMapper1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;FeederSuccessivi&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFeederSUCC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns12:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns12:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns12:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;FEEDERSUCCESSIVO costruiti: &amp;quot;, tib:render-xml($FeederSuccessivi, true(), true()))&quot;/>&#xa;                &lt;/tns12:Message>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
