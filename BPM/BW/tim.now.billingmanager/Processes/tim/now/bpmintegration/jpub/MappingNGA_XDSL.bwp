            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="8630479f-5c8d-48fd-bb08-c020af1830e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FEEDERSUCCESSIVIToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToAssign">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8630479f-5c8d-48fd-bb08-c020af1830e7+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP WHERE COD_AGESP in ('R1I-22-0330','T1PRJ0001733','T1PRJ0020752', 'T1PRJ0063400')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/FiltredUserVlan/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&lt;xsl:template name=&quot;FiltredUserVlan&quot; match=&quot;/&quot;>&lt;tns11:Element>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/caratterizzazioneAccesso = 'DRG OPZIONE ZERO')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='A']&quot;>&lt;tns11:SVLANCODE>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/tns11:SVLANCODE>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']&quot;>&lt;tns11:SVLANCODE>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/tns11:SVLANCODE>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='MIGRAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M')]&quot;>&lt;tns11:SVLANCODE>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M')]/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/tns11:SVLANCODE>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M','N')]&quot;>&lt;tns11:SVLANCODE>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M','N')]/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/tns11:SVLANCODE>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns11:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FiltredUserVlan"
                    name="FilterUserVlan"
                    outputVariable="FiltredUserVlan"
                    tibex:xpdlId="2af28350-b17d-49b1-a8b8-4a1e045df18a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FilterUserVlanToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($FiltredUserVlan/ns52:SVLANCODE[1])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($FiltredUserVlan/ns52:SVLANCODE[1])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FilterUserVlanToMapper1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/FiltredUserVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;FiltredUserVlan&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:Element>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/caratterizzazioneAccesso = 'DRG OPZIONE ZERO')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='A']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='MIGRAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M')]/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M','N')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione=('A','M','N')]/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns11:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
