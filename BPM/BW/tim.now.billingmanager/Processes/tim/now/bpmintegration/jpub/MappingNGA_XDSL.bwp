;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo)='LD'&quot;>&#xa;                                                    &lt;TIPO_TRASP>&#xa;                                                        &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                                    &lt;/TIPO_TRASP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_TRASP>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_TRASP>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='TRASPORTO']/valoreAttributo)='L1'&quot;>&#xa;                                                    &lt;TIPO_TRASP>&#xa;                                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                                    &lt;/TIPO_TRASP>&#xa;                                                &lt