                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1628761014610&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaAreaRaccoltaInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;Tipo_azione&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCOD_MODEM&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperVC&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateVC&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateUSERVLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProfiloCommerciale&quot;/>&#xa;    &lt;xsl:param name=&quot;OLOGenerante&quot;/>&#xa;    &lt;xsl:param name=&quot;FLAG_ADESIONE_4APP&quot;/>&#xa;    &lt;xsl:param name=&quot;DATA_COMUNE_COINVESTITO&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliONESTEP&quot;/>&#xa;    &lt;xsl:param name=&quot;FLAG_PRIMO_CANALE_OLT&quot;/>&#xa;    &lt;xsl:param name=&quot;FLAG_PRIMO_CANALE_FE&quot;/>&#xa;    &lt;xsl:param name=&quot;FeederSuccessivi&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;USERVLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/ns1:ORDINI_CRMWS)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$MappingNGA_XDSLIn.input/ns1:ORDINI_CRMWS&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:ORDINI_CRMWS>&#xa;                    &lt;ns1:TESTATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)] ) or exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='CBTSATMSIMM' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='INTERNAL'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($OLOGenerante/Record)>0 and exists($OLOGenerante/Record/DES)&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($OLOGenerante/Record/ORA_DES)&quot;>&#xa;                                                &lt;DATA_DES>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), hours-from-dateTime($OLOGenerante/Record[1]/ORA_DES), minutes-from-dateTime($OLOGenerante/Record[1]/ORA_DES), xsd:int(seconds-from-dateTime($OLOGenerante/Record[1]/ORA_DES)))&quot;/>&#xa;                                                &lt;/DATA_DES>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;DATA_DES>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($OLOGenerante/Record[1]/DES), month-from-dateTime($OLOGenerante/Record[1]/DES), day-from-dateTime($OLOGenerante/Record[1]/DES), 00,00,00)&quot;/>&#xa;                                                &lt;/DATA_DES>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='DATAINIZIORICARICA']/valoreAttributo)&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VP&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav) = &amp;quot;VARIAZIONETDKIT&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CARATTERISTICAVP']/valoreAttributo)= ('SPECIAL','STANDARD')&quot;>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'39'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CARATTERISTICAVP']/valoreAttributo)='LITE')&quot;>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'39'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VP&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav) = &amp;quot;VARIAZIONECARATTERISTICA&amp;quot;&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;'38'&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:AssetRicarica)&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/canaleRichiesta='GUI' and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB'  or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB'  or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' ) and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICETTM']/valoreAttributo)>0&quot;>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'VF'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SEDEOLT'&quot;>&#xa;                                &lt;ns1:OLT>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa) > 0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSOSEDEOLT')]/attributiDettaglioOrdine[nomeAttributo='CLLICENTRALE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;CLLI_FEEDER>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSOSEDEOLT')]/attributiDettaglioOrdine[nomeAttributo='CLLICENTRALE']/valoreAttributo&quot;/>&#xa;                                            &lt;/CLLI_FEEDER>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CLLI_FEEDER>&#xa;                                                &lt;xsl:value-of select=&quot;'-'&quot;/>&#xa;                                            &lt;/CLLI_FEEDER>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CLLICENTRALE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;CLLI_OLT>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CLLICENTRALE']/valoreAttributo&quot;/>&#xa;                                            &lt;/CLLI_OLT>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CLLI_OLT>&#xa;                                                &lt;xsl:value-of select=&quot;'-'&quot;/>&#xa;                                            &lt;/CLLI_OLT>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDA']/valoreAttributo)>0&quot;>&#xa;                                            &lt;BANDA>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BANDA']/valoreAttributo&quot;/>&#xa;                                            &lt;/BANDA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;BANDA>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/BANDA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;CLASSE_SERVIZIO>&#xa;                                        &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;       