                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_DSLAM_TYPE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperUSERVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:USER_VLAN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='VARIAZIONETAGGING' and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;TAGGED&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset&amp;#xD;&amp;#xA;&amp;#x9;[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo =$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo, '/')&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo, '/')&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[nomeAttributo='VCI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAVC']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'][attributidettaglioasset[nomeAttributo='USERVLANID']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'][attributidettaglioasset[nomeAttributo='USERVLANID']/valoreAttributo=$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo, '/')&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'][attributidettaglioasset[nomeAttributo='USERVLANID']/valoreAttributo=$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo, '/')&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'][attributidettaglioasset[nomeAttributo='USERVLANID']/valoreAttributo=$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN'and azione!='N'][number($index)]/attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo]/attributidettaglioasset[nomeAttributo='IDRISORSAUSERVLAN']/valoreAttributo