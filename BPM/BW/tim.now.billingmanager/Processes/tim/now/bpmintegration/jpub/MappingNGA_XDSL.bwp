                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATA_INIZIO_VAL&#xa;FROM CATALG_OFF_COM_COINV&#xa;WHERE ID_CONTRATTO_OFFERTA_CATLG IN (SELECT ID_CONTRATTO_OFFERTA_CATLG&#xa;FROM CONTRATTO_OFFERTA_CATLG&#xa;WHERE ID_CONTRATTO = ? AND ID_OFFERTA = ?)&#xa;AND COD_COMUNE IN (SELECT COD_COMUNE&#xa;FROM COMUNE_O_LOCALITA&#xa;WHERE COD_ISTAT_COMUNE = ?)&#xa;AND DATA_INIZIO_VAL &lt; SYSDATE AND DATA_FINE_VAL > SYSDATE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDCONTRATTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDOFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ISTATCOMUNE"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_VAL"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
