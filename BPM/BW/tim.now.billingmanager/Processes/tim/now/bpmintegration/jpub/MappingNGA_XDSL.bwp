    &lt;xsl:param name="MappingNGA_XDSLIn"/&gt;
    &lt;xsl:template name="RecuperaAreaRaccoltaInvoke-input" match="/"&gt;
        &lt;tns15:RecuperaAreaRaccoltaRequest&gt;
            &lt;input&gt;
                &lt;tns3:Request&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;])"&gt;
