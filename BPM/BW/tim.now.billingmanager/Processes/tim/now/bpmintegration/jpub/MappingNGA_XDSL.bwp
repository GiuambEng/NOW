                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PCR_UP,PCR_DOWN,MCR_DOWN,MCR_UP,SCR_DOWN,SCR_UP FROM PROFILO_VC WHERE ID_PRFL_VC=?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
