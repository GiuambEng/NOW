                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:tns=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;calcolaPreventivo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPreventivo&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornaStatoPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AggiornaStatoPreventivo_Request>&#xa;            &lt;tns:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$MapperPreventivo/PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;            &lt;/tns:IdRichiestaOLO>&#xa;            &lt;tns:idPreventivo>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($MapperPreventivo/PREVENTIVO/ID_PREVENTIVO)&quot;/>&#xa;            &lt;/tns:idPreventivo>&#xa;            &lt;tns:NuovoStatoPreventivo>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INACCETTAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns:NuovoStatoPreventivo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&#xa;                    &lt;tns:ImportoTotale>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns:ImportoTotale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ImportoTotale>&#xa;                        &lt;xsl:value-of select=&quot;$calcolaPreventivo.parameters/PreventivoResponse/TOTALE div 100&quot;/>&#xa;                    &lt;/tns:ImportoTotale>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapperPreventivo/PREVENTIVO/DETTAGLIO&quot;>&#xa;                        &lt;tns:DettagliJPUB>&#xa;                            &lt;tns:IdDettaglio>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($Sele