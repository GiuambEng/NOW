                                    expression="($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')]]></bpws:transitionCondition>
