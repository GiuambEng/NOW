se>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
