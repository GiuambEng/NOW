            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:tns=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperPreventivo&quot;/>&lt;xsl:param name=&quot;calcolaPreventivo&quot;/>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:param name=&quot;SelectPreventivo&quot;/>&lt;xsl:template name=&quot;AggiornaStatoPreventivo-input&quot; match=&quot;/&quot;>&lt;tns:AggiornaStatoPreventivo_Request>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$MapperPreventivo/PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&lt;/tns:IdRichiestaOLO>&lt;tns:idPreventivo>&lt;xsl:value-of select=&quot;xsd:decimal($MapperPreventivo/PREVENTIVO/ID_PREVENTIVO)&quot;/>&lt;/tns:idPreventivo>&lt;tns:NuovoStatoPreventivo>&lt;xsl:value-of select=&quot;&amp;quot;INACCETTAZIONE&amp;quot;&quot;/>&lt;/tns:NuovoStatoPreventivo>&lt;xsl:choose>&lt;xsl:when test=&quot;($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&lt;tns:ImportoTotale>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:ImportoTotale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ImportoTotale>&lt;xsl:value-of select=&quot;$calcolaPreventivo/parameters/regCRMWS:OPERESPECIALIResponse/PreventivoResponse/TOTALE div 100&quot;/>&lt;/tns:ImportoTotale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&lt;xsl:for-each select=&quot;$MapperPreventivo/PREVENTIVO/DETTAGLIO&quot;>&lt;tns:DettagliJPUB>&lt;tns:IdDettaglio>&lt;xsl:value-of select=&quot;xsd:integer($SelectPreventivo/Record[COD_ARTICOLO_JPUB = current()/ID_VOCE]/ID_DETT_PREVENTIVO)&quot;/>&lt;/tns:IdDettaglio>&lt;tns:ImportoArticolo>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:ImportoArticolo>&lt;/tns:DettagliJPUB>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$calcolaPreventivo/parameters/regCRMWS:OPERESPECIALIResponse/PreventivoResponse/DettaglioResponse&quot;>&lt;tns:DettagliJPUB>&lt;tns:IdDettaglio>&lt;xsl:value-of select=&quot;xsd:integer($SelectPreventivo/Record[COD_ARTICOLO_JPUB = current()/ID_VOCE]/ID_DETT_PREVENTIVO)&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:IdDettaglio>&lt;tns:ImportoArticolo>&lt;xsl:value-of select=&quot;IMPORTO div 100&quot;/>&lt;/tns:ImportoArticolo>&lt;/tns:DettagliJPUB>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:AggiornaStatoPreventivo_Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="AggiornaStatoPreventivo-input"
