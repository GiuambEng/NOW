                    tibex:xpdlId="08860abe-af92-4a2f-84d2-3b9aa4c5a068" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="COD_OFFERTA_JPUBToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="COD_OFFERTA_JPUBToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/IDConsuntivo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/IDConsuntivo)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+08860abe-af92-4a2f-84d2-3b9aa4c5a068+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_OFFERTA_JPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.COD_OFFERTA_JPUB&#xa;FROM OFFERTA O, TRASCODFC_OFFERTA TRO&#xa;WHERE O.ID_OFFERTA = TRO.ID_OFFERTA AND TRO.NOME_OFFERTA_ESTERNA = ? AND TRO.PROVENIENZA = 'BPM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="COD_OFFERTA_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9afaaa51-96b1-436c-a69f-0ab82ecd36d3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:template name=&quot;SelectPreventivo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_PREVENTIVO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/IDPreventivo)&quot;>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/IDPreventivo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PREVENTIVO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectPreventivo-input"
                    name="SelectPreventivo"
                    outputVariable="SelectPreventivo"
                    tibex:xpdlId="9afaaa51-96b1-436c-a69f-0ab82ecd36d3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="COD_OFFERTA_JPUBToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectPreventivoToCallProcess3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9afaaa51-96b1-436c-a69f-0ab82ecd36d3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_PREVENTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/IDPreventivo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns1:Request/tns1:Richiesta/IDPreventivo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_PREVENTIVO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT D.QT_ARTICOLO,D.ID_DETT_PREVENTIVO,D.COD_ARTICOLO_JPUB,D.DATAFI_VALID,D.IMPORTO_ARTICOLO,T.DESCR_ARTICOLO_NOW &#xa;FROM DETT_PREVENTIVO D, TRASCODFC_ARTICOLI_DTU_JPUB T &#xa;WHERE D.COD_ARTICOLO_JPUB= T.COD_ARTICOLO_JPUB AND ID_PREVENTIVO =?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PREVENTIVO"/>
                                    <columnMetadata
                                    columnName="QT_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_DETT_PREVENTIVO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_ARTICOLO_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="IMPORTO_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_ARTICOLO_NOW"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:param name=&quot;SelectPreventivo&quot;/>&lt;xsl:template name=&quot;LOGSelectPreventivo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'ValorizzaPreventivoPortType'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectPreventivo/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;SelectPreventivo&amp;quot;, tib:render-xml($SelectPreventivo/Record[1], true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;SelectPreventivo Record non trovato&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOGSelectPreventivo-input"
                    name="LOGSelectPreventivo"
                    tibex:xpdlId="2db32e0b-01ad-4057-9fec-073932c3401a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectPreventivoToCallProcess3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOGSelectPreventivoToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPreventivo&quot;/>&#xa;    &lt;xsl:template name=&quot;LOGSelectPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ValorizzaPreventivoPortType'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectPreventivo/Record)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectPreventivo&amp;quot;, tib:render-xml($SelectPreventivo/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SelectPreventivo Record non trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&lt;xsl:param name=&quot;SelectPreventivo&quot;/>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:param name=&quot;Contract&quot;/>&lt;xsl:param name=&quot;SelectConsuntivo&quot;/>&lt;xsl:template name=&quot;MapperPreventivo-input&quot; match=&quot;/&quot;>&lt;tns:OPERESPECIALI>&lt;PREVENTIVO>&lt;ID_PREVENTIVO>&lt;xsl:value-of select=&quot;xsd:string($ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDPreventivo)&quot;/>&lt;/ID_PREVENTIVO>&lt;ID_RICHIESTA_NOW>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICHIESTA_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Contract/Record)>0&quot;>&lt;ID_OLO>&lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&lt;/ID_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_OLO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ID_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_OLO>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS>&lt;xsl:choose>&lt;xsl:when test=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/offerta = 'UBBSEMIGPON'&quot;>&lt;TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&lt;/TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/offerta=('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;FTTH&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:when>&lt;xsl:when test=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/offerta='VULAFTTCAB' or $ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/offerta='EASYIPNGAFTTCAB'  or $ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/offerta='BITSTREAMNGAFTTCAB'&quot;>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;FTTCAB&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TECNOLOGIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TECNOLOGIA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;DATA_RICHIESTA_PREVENTIVO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_RICHIESTA_PREVENTIVO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDConsuntivo)&quot;>&lt;FLAG_PREVENTIVO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FLAG_PREVENTIVO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_PREVENTIVO>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_PREVENTIVO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$SelectPreventivo/Record&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&lt;DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QT_ARTICOLO)&quot;/>&lt;/QUANTITA>&lt;/DETTAGLIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QT_ARTICOLO)*100&quot;/>&lt;/QUANTITA>&lt;/DETTAGLIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$SelectConsuntivo/Record&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&lt;DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&lt;/QUANTITA>&lt;/DETTAGLIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DETTAGLIO>&lt;ID_VOCE>&lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&lt;/ID_VOCE>&lt;QUANTITA>&lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&lt;/QUANTITA>&lt;/DETTAGLIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/PREVENTIVO>&lt;/tns:OPERESPECIALI>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperPreventivo-input"
                    name="MapperPreventivo"
                    outputVariable="MapperPreventivo"
                    tibex:xpdlId="a7caf14d-55d3-4987-8fa3-a5099d82e7f9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapperPreventivo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperPreventivoToLogMapperPreventivo">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_OFFERTA_JPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;Contract&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectConsuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:OPERESPECIALI>&#xa;            &lt;PREVENTIVO>&#xa;                &lt;ID_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDPreventivo)&quot;/>&#xa;                &lt;/ID_PREVENTIVO>&#xa;                &lt;ID_RICHIESTA_NOW>&#xa;                    &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/ID_RICHIESTA_NOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Contract/Record)>0&quot;>&#xa;                        &lt;ID_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                        &lt;/ID_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_OLO>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/ID_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;CODICE_ORDINE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;ID_RIS>&#xa;                    &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDRisorsa&quot;/>&#xa;                &lt;/ID_RIS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta = 'UBBSEMIGPON'&quot;>&#xa;                        &lt;TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_SERVIZIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;TIPO_SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$COD_OFFERTA_JPUB/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                        &lt;/TIPO_SERVIZIO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta=('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&#xa;                        &lt;TECNOLOGIA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FTTH&amp;quot;&quot;/>&#xa;                        &lt;/TECNOLOGIA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta='VULAFTTCAB' or $ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta='EASYIPNGAFTTCAB'  or $ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/offerta='BITSTREAMNGAFTTCAB'&quot;>&#xa;                        &lt;TECNOLOGIA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/TECNOLOGIA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;TECNOLOGIA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/TECNOLOGIA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;DATA_DRO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:dateTime($ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/DRO)&quot;/>&#xa;                &lt;/DATA_DRO>&#xa;                &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDConsuntivo)&quot;>&#xa;                        &lt;FLAG_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_PREVENTIVO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;FLAG_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_PREVENTIVO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:for-each select=&quot;$SelectPreventivo/Record&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;ID_VOCE>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                &lt;/ID_VOCE>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:integer(QT_ARTICOLO)&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;ID_VOCE>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                &lt;/ID_VOCE>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:integer(QT_ARTICOLO)*100&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:for-each select=&quot;$SelectConsuntivo/Record&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;DESCR_ARTICOLO_NOW='QUOTAFISSA'&quot;>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;ID_VOCE>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                &lt;/ID_VOCE>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;ID_VOCE>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ARTICOLO_JPUB&quot;/>&#xa;                                &lt;/ID_VOCE>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:integer(QTA_ARTICOLO)*100&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/PREVENTIVO>&#xa;        &lt;/tns:OPERESPECIALI>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:crmws.entity.classes_3.0="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="crmws.entity.classes_3.0:OPERESPECIALI" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Scope" tibex:group="none" tibex:xpdlId="fa695cce-9a48-4cbe-a2d2-ec4a9868334e">
                <bpws:targets>
                    <bpws:target linkName="LogInsertStagingToScope"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ScopeToUpdateStaging">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($calcolaPreventivo/parameters/ns8:OPERESPECIALIResponse/PreventivoResponse)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($calcolaPreventivo.parameters/PreventivoResponse)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ScopeToExit">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails1" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:faultHandlers>
                    <bpws:catchAll tibex:faultDetailsVar="FaultDetails1"
                        tibex:faultNameVar="FaultName1" tibex:xpdlId="812138d2-e315-413e-af39-d821a85e1cff">
                        <bpws:scope name="scope2">
                            <bpws:flow name="flow3">
                                <bpws:links>
                                    <bpws:link
                                    name="CallProcessToInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ErrorJPUB_ValorizzaPreventivoToCallProcess1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogErrorJPUB_ValorizzaPreventivoToInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdateStagingOK_KOToReply" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:param name=&quot;FaultDetails1&quot;/>&lt;xsl:template name=&quot;LogFaultcalcolaPreventivo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'ValorizzaPreventivoPortType'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn/Input/tns2:ValorizzaPreventivoRequest/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Fault Invoke calcolaPreventivo&amp;quot;,$FaultDetails1/StackTrace,$FaultDetails1/MsgCode,$FaultDetails1/Msg,$FaultDetails1/ActivityName,$FaultDetails1/ProcessStack)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogFaultcalcolaPreventivo-input"
                                    name="LogFaultcalcolaPreventivo"
                                    tibex:xpdlId="abf527cc-eb05-42d5-8b90-5047494080ef"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValorizzaPreventivoIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultcalcolaPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.billingmanager.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ValorizzaPreventivoPortType'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ValorizzaPreventivo&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ValorizzaPreventivoIn.Input/tns2:Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                &lt;/tns:MsgCode>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Fault Invoke calcolaPreventivo&amp;quot;,$FaultDetails1/StackTrace,$FaultDetails1/MsgCode,$FaultDetails1/Msg,$FaultDetails1/ActivityName,$FaultDetails1/ProcessStack)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:invoke
                                    inputVariable="ErrorJPUB_ValorizzaPreventivo-input"
                                    name="ErrorJPUB_ValorizzaPreventivo"
                                    operation="ErrorSchema"
                                    outputVariable="ErrorJPUB_ValorizzaPreventivo"
                                    partnerLink="ErrorJPUB_ValorizzaPreventivo"
