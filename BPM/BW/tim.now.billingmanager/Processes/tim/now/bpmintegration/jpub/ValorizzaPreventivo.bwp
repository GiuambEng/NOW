                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:tns=&quot;http://www.example.org/OpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperPreventivo&quot;/>&lt;xsl:param name=&quot;calcolaPreventivo&quot;/>&lt;xsl:param name=&quot;ValorizzaPreventivoIn&quot;/>&lt;xsl:param name=&quot;SelectConsuntivo&quot;/>&lt;xsl:template name=&quot;AggiornaConsuntivo-input&quot; match=&quot;/&quot;>&lt;tns:AggiornaConsuntivo_Request>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$MapperPreventivo/PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&lt;/tns:IdRichiestaOLO>&lt;tns:idConsuntivo>&lt;xsl:value-of select=&quot;xsd:decimal($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/IDConsuntivo)&quot;/>&lt;/tns:idConsuntivo>&lt;xsl:choose>&lt;xsl:when test=&quot;($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&lt;tns:ImportoTotale>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:ImportoTotale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ImportoTotale>&lt;xsl:value-of select=&quot;$calcolaPreventivo/parameters/regCRMWS:OPERESPECIALIResponse/PreventivoResponse/TOTALE div 100&quot;/>&lt;/tns:ImportoTotale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = 'REGOLATORIO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO') or ($ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/strutturaRichiesta = ('XDSL','NGA') and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'TIPOOPA']/valoreAttributo = 'NO' and $ValorizzaPreventivoIn/Input/tns1:ValorizzaPreventivoRequest/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = 'DTUOPERESPECIALI']/attributiDettaglioOrdine[nomeAttributo = 'CONTRIBUTOCLIENTE']/valoreAttributo = 'NO')&quot;>&lt;xsl:for-each select=&quot;$MapperPreventivo/PREVENTIVO/DETTAGLIO&quot;>&lt;tns:DettagliJPUB>&lt;tns:IdDettaglio>&lt;xsl:value-of select=&quot;xsd:integer($SelectConsuntivo/Record[COD_ARTICOLO_JPUB = current()/ID_VOCE]/ID_DETT_CONSUNTIVO)&quot;/>&lt;/tns:IdDettaglio>&lt;tns:ImportoArticolo>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:ImportoArticolo>&lt;/tns:DettagliJPUB>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$calcolaPreventivo/parameters/regCRMWS:OPERESPECIALIResponse/PreventivoResponse/DettaglioResponse&amp;#xD;&amp;#xA;&quot