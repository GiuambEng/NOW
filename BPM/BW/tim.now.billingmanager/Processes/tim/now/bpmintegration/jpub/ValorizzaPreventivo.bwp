&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="id_procso_no_file"/&gt;&lt;xsl:param name="MapperPreventivo"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:GenericStaging&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperPreventivo/PREVENTIVO, true(),true())"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="$MapperPreventivo/PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;tns1:ID_RICH_JPUB&gt;&lt;xsl:value-of select="tib:timestamp()"/&gt;&lt;/tns1:ID_RICH_JPUB&gt;&lt;tns1:ID_PREVENTIVO&gt;&lt;xsl:value-of select="xsd:int($MapperPreventivo/PREVENTIVO/ID_PREVENTIVO)"/&gt;&lt;/tns1:ID_PREVENTIVO&gt;&lt;tns1:ID_RICH_NOW&gt;&lt;xsl:value-of select="$MapperPreventivo/PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/tns1:ID_RICH_NOW&gt;&lt;tns1:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$MapperPreventivo/PREVENTIVO/CODICE_ORDINE_OLO"/&gt;&lt;/tns1:COD_ORDN_OLO&gt;&lt;tns1:COD_OFFERTA_JPUB&gt;&lt;xsl:value-of select="xsd:int($MapperPreventivo/PREVENTIVO/TIPO_SERVIZIO)"/&gt;&lt;/tns1:COD_OFFERTA_JPUB&gt;&lt;tns1:FLAG_PREVENTIVO&gt;&lt;xsl:value-of select="$MapperPreventivo/PREVENTIVO/FLAG_PREVENTIVO"/&gt;&lt;/tns1:FLAG_PREVENTIVO&gt;&lt;/tns1:GenericStaging&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_JPUB_VLRZ_PRVCNS_NOFL'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;