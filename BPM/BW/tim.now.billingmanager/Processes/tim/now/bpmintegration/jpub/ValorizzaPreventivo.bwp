l:value-of select="'12'"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ErrorJPUB_ValorizzaPreventivo/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:TRANSACTION_ID)&gt;0"/&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$ErrorJPUB_ValorizzaPreventivo/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:CONTENUTO_RESPONSE"&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="$ErrorJPUB_ValorizzaPreventivo/Output/tns2:ErrorOutput/tns2:ErrorO/tns2:CONTENUTO_RESPONSE"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RISPOSTA&gt;&lt;/tns1:GenericStaging&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_JPUB_VLRZ_PRVCNS_NOFL'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$id_procso_no_file"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ErrorJPUB_ValorizzaPreventivo/Output/tns2:ErrorOutput