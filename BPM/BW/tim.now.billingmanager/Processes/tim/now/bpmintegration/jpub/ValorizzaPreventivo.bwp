                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ErrorSchema/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorJPUB_ValorizzaPreventivo.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;id_procso_no_file&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagingOK_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:GenericStaging>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUB_ValorizzaPreventivo.Output/tns2:ErrorO/tns2:DESCRIZIONE_ERRORE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ErrorJPUB_ValorizzaPreventivo.Output/tns2:ErrorO/tns2:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns1:DESCR_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$ErrorJPUB_ValorizzaPreventivo.Output/tns2:ErrorO/tns2:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns1:DESCR_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ErrorJPUB_ValorizzaPreventivo.Output/tns2:ErrorO/tns2:TRANSACTION_ID)>0 &quot;>&#xa;                        &lt;tns1:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;'Chiamata  s