&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ValorizzaPreventivo/" xmlns:tns1="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0" version="2.0"&gt;&lt;xsl:param name="calcolaPreventivo"/&gt;&lt;xsl:template name="ReplyKO-input" match="/"&gt;&lt;tns:ValorizzaPreventivoResponse&gt;&lt;Output&gt;&lt;tns1:ValorizzaPreventivoResponse&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;tns1:RESPONSE_DATE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:RESPONSE_DATE&gt;&lt;tns1:RETURN_CODE&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/tns1:RETURN_CODE&gt;&lt;tns1:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$calcolaPreventivo/parameters/regCRMWS:OPERESPECIALIResponse/PreventivoResponse/ERRORE/TYPE_ERROR"/&gt;&lt;/tns1:DESCRIZIONE_ERRORE&gt;&lt;/tns1:ValorizzaPreventivoResponse&gt;&lt;/Output&gt;&lt;/tns:ValorizzaPreventivoResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ValorizzaPreventivo/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;calcolaPreventivo.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ValorizzaPreventivoResponse>&#xa;            &lt;tns1:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns1:TRANSACTION_ID>&#xa;            &lt;tns1:RESPONSE_DATE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns1:RESPONSE_DATE>&#xa;            &lt;tns1:RETURN_CODE>&#xa;                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;            &lt;/tns1:RETURN_CODE>&#xa;            &lt;tns1:DESCRIZIONE_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$calcolaPreventivo.parameters/PreventivoResponse/ERRORE/TYPE_ERROR&quot;/>&#xa;            &lt;/tns1:DESCRIZIONE_ERRORE>&#xa;        &lt;/tns1:ValorizzaPreventivoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
