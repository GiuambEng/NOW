                    </bpws:source>
                    <bpws:source linkName="EmptyToAggiornaStatoPreventivo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MapperPreventivo/PREVENTIVO/FLAG_PREVENTIVO = &quot;0&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
