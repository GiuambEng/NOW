                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               &lt;!--Ricontrollare nel caso di CESSAZIONE-->&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot;   and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta=('VULAFTTH','SEMIVULAFTTH','VULAFTTCAB','FULLGPONPLUS')&quot;>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot;   and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo) = &amp;quot;DOUBLETAG&amp;quot;&quot;>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-