        &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery_ID_PROFILO_BMD/Record)&quot;>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;$JDBCQuery_ID_PROFILO_BMD: &amp;quot;,  tib:render-xml($JDBCQuery_ID_PROFILO_BMD/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;$JDBCQuery_ID_PROFILO_BMD non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogJDBCQuery_ID_PROFILO_BMD-input"
