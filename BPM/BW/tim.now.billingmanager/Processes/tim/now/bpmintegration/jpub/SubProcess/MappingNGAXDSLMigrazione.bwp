                    <bpws:sources>
                        <bpws:source linkName="COD_CAUSToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE' and ($JDBCQueryInvoke/output/ns19:JDBCQueryResponse/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='8' or $JDBCQueryInvoke/output/ns19:JDBCQueryResponse/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='14')) or (not($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE') and exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/IDOfferta) and ($JDBCQueryInvoke/output/ns19:JDBCQueryResponse/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='8' or $JDBCQueryInvoke/output/ns19:JDBCQueryResponse/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='14'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($MappingNGA_XDSLIn.input/tns:Lavorazione='CESSAZIONE' and ($JDBCQueryInvoke.output/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='8' or $JDBCQueryInvoke.output/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='14')) or (not($MappingNGA_XDSLIn.input/tns:Lavorazione='CESSAZIONE') and exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/IDOfferta) and ($JDBCQueryInvoke.output/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='8' or $JDBCQueryInvoke.output/ns19:XDSL_NGA/ns19:TIPO_FAMIGLIA='14'))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="COD_CAUSToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTipologiaSottolav&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                &lt;tns4:CodeCausaleRequest>&#xa;                    &lt;tns4:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;JPUB&amp;quot;&quot;/>&#xa;                    &lt;/tns4:PID_SISTEMA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;>&#xa;                                &lt;tns4:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASCENARIO&quot;/>&#xa;                                &lt;/tns4:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;>&#xa;                                &lt;tns4:PSCENARIO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario&quot;/>&#xa;                                &lt;/tns4:PSCENARIO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='RIENTROINTI' and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='ULLLINEANONATTIVA' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SLULINEANONATTIVA' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH') and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM='TLC'&quot;>&#xa;                            &lt;tns4:PSOTTOLAVORAZ>&#xa;                                &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                            &lt;/tns4:PSOTTOLAVORAZ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($SelectTipologiaSottolav/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;>&#xa;                                &lt;tns4:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectTipologiaSottolav/Record[1]/TIPOLOGIASOTTOLAV&quot;/>&#xa;                                &lt;/tns4:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                                &lt;tns4:PSOTTOLAVORAZ>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                                &lt;/tns4:PSOTTOLAVORAZ>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:ID_Rich_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns4:ID_Rich_OLO>&#xa;                    &lt;tns4:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta&quot;/>&#xa;                    &lt;/tns4:OFFERTA>&#xa;                    &lt;tns4:STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                    &lt;/tns4:STRUTTURARICHIESTA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA'&quot;>&#xa;                            &lt;tns4:LAVORAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                            &lt;/tns4:LAVORAZIONE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns4:CodeCausaleRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:CodeCausaleRequest>&#xa;                    &lt;tns4:PID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;JPUB&amp;quot;&quot;/>&#xa;                    &lt;/tns4:PID_SISTEMA>&#xa;                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaScenario&quot;>&#xa;                        &lt;tns4:PSCENARIO>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaScenario&quot;/>&#xa;                        &lt;/tns4:PSCENARIO>&#xa;                    &lt;/xsl:if>&#xa;  