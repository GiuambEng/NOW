BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                                    &lt;tns12:BusinessID>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/tns12:BusinessID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns12:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns12:EventType>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;tns12:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingNGA_XDSLMigrazione_&amp;quot;, $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns12:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns12:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;MappingNGA_XDSLMigrazione_&amp;quot;, $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns12:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns12:Identifier>&#xa;                    &lt;tns12:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns12:track_position>&#xa;                    &lt;tns12:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns12:Timestamp>&#xa;                &lt;/tns12:Envelope>&#xa;                &lt;tns12:Playload>&#xa;                    &lt;tns12:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($MappingNGA_XDSLIn.input)))&quot;/>&#xa;                    &lt;/tns12:Binary>&#xa;                    &lt;tns12:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MappingNGA_XDSLIn.input, true(), true())&quot;/>&#xa;                    &lt;/tns12:XMLString>&#xa;                &lt;/tns12:Playload>&#xa;            &lt;/tns12:ActiveLoggerServices>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
