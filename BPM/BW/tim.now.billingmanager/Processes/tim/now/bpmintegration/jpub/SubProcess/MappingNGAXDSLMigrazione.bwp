;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' and (starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;BITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;SEMIBITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;VULA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;SEMIVULA&amp;quot;) or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='FULLGPONPLUSNGA' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='FULLGPONPLUS')&quot;>&#xa;                                    &lt;CODE_OL>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_OL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;BITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;SEMIBITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;VULA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;SEMIVULA&amp;quot;) or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS'&quot;>&#xa;                                    &lt;CODE_OL>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_OL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&#xa;                                            &lt;CODE_OL>&#xa;                              