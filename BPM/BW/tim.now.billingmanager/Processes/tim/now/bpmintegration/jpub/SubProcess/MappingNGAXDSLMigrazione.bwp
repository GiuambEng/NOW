   &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;KIT_CONS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]/attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/KIT_CONS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;KIT_CONS>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/KIT_CONS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;KIT_CONS>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/KIT_CONS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo) = &amp;quot;DEDICATA&amp;quot;   or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;KIT_CONS>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/KIT_CONS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;KIT_CONS>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/KIT_CONS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;KIT_CONS>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/KIT_CONS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODE_IDBRE_DSLAM>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/CODE_IDBRE_DSLAM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO)>0&quot;>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODE_PROFILO_ESTESO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CODE_PROFILO_ESTESO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:VC>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
