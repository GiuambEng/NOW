            <bpws:invoke
                inputVariable="RecuperaAreaRaccoltaInvoke-input"
                name="RecuperaAreaRaccoltaInvoke"
                operation="RecuperaAreaRaccolta"
                outputVariable="RecuperaAreaRaccoltaInvoke"
                partnerLink="RecuperaAreaRaccolta"
                portType="ns18:RecuperaAreaRaccoltaPortType" tibex:xpdlId="951452d5-8609-41d9-a4b0-f1277eb1cc99">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/RecuperaAreaRaccolta/" xmlns:tns3="http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/" version="2.0"&gt;
    &lt;xsl:param name="MappingNGA_XDSLIn"/&gt;
    &lt;xsl:template name="RecuperaAreaRaccoltaInvoke-input" match="/"&gt;
        &lt;tns6:RecuperaAreaRaccoltaRequest&gt;
            &lt;input&gt;
                &lt;tns3:Request&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;])"&gt;
                                    &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;]"&gt;
                                        &lt;tns3:Dati&gt;
                                            &lt;tns3:USERVLAN&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:SVLANCODE&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:SVLANCODE&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:CODEVLANSINGLETAG&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:CODEVLANSINGLETAG&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/tns3:USERVLAN&gt;
                                        &lt;/tns3:Dati&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;])"&gt;
                                    &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]"&gt;
                                        &lt;tns3:Dati&gt;
                                            &lt;tns3:ATMVC&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:TIPOBANDACONSEGNA&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:TIPOBANDACONSEGNA&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:CODICEVP&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:CODICEVP&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:CODICETD&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:CODICETD&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/tns3:ATMVC&gt;
                                        &lt;/tns3:Dati&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;GBEVC&amp;quot;]"&gt;
                                        &lt;tns3:Dati&gt;
                                            &lt;tns3:GBEVC&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:SVLANCODE&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:SVLANCODE&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;xsl:if test="attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"&gt;
                                                    &lt;tns3:CODEVLANSINGLETAG&gt;
                                                        &lt;xsl:value-of select="attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"/&gt;
                                                    &lt;/tns3:CODEVLANSINGLETAG&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/tns3:GBEVC&gt;
                                        &lt;/tns3:Dati&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;])"&gt;
                            &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;]"&gt;
                                &lt;tns3:Dati&gt;
                                    &lt;tns3:USERVLAN&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:SVLANCODE&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:SVLANCODE&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:CODEVLANSINGLETAG&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:CODEVLANSINGLETAG&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:USERVLAN&gt;
                                &lt;/tns3:Dati&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;])"&gt;
                            &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;]"&gt;
                                &lt;tns3:Dati&gt;
                                    &lt;tns3:ATMVC&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:TIPOBANDACONSEGNA&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:TIPOBANDACONSEGNA&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:CODICEVP&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:CODICEVP&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:CODICETD&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:CODICETD&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:ATMVC&gt;
                                &lt;/tns3:Dati&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:for-each select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;]"&gt;
                                &lt;tns3:Dati&gt;
                                    &lt;tns3:GBEVC&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:SVLANCODE&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:SVLANCODE&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"&gt;
                                            &lt;tns3:CODEVLANSINGLETAG&gt;
                                                &lt;xsl:value-of select="attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo"/&gt;
                                            &lt;/tns3:CODEVLANSINGLETAG&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:GBEVC&gt;
                                &lt;/tns3:Dati&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'"&gt;
                            &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/distretto"&gt;
                                &lt;tns3:Distretto&gt;
                                    &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/distretto"/&gt;
                                &lt;/tns3:Distretto&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto"&gt;
                                &lt;tns3:Distretto&gt;
                                    &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto"/&gt;
                                &lt;/tns3:Distretto&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'"&gt;
                            &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta"&gt;
                                &lt;tns3:Offerta&gt;
                                    &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta"/&gt;
                                &lt;/tns3:Offerta&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta"&gt;
                                &lt;tns3:Offerta&gt;
                                    &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta"/&gt;
                                &lt;/tns3:Offerta&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO)&gt;0"&gt;
                                    &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO"&gt;
                                        &lt;tns3:id_rich_olo&gt;
                                            &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRichiestaOLO"/&gt;
                                        &lt;/tns3:id_rich_olo&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO"&gt;
                                        &lt;tns3:id_rich_olo&gt;
                                            &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO"/&gt;
                                        &lt;/tns3:id_rich_olo&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO"&gt;
                                &lt;tns3:id_rich_olo&gt;
                                    &lt;xsl:value-of select="$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO"/&gt;
