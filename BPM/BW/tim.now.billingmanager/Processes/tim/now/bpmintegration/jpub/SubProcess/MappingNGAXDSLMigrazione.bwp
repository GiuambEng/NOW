appingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                        &lt;/EX_TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; or $MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' ) and exists($AccumulateVC)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$AccumulateVC/ns1:VC&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILEFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSLITE' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILELITE')&quot;>&#xa;                                    &lt;ns1:SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                                                &lt;TIPO_AZIONE>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                &lt;/TIPO_AZIONE>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;TIPO_AZIONE>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                                &lt;/TIPO_AZIONE>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;TIPO_AZIONE>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                        &lt;/TIPO_AZIONE>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                        &lt;TIPO_SLA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE)>0&quot;>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA)>0&quot;>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns1:SLA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILEFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSLITE' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPBASEPLUSFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPSPECIALPROFILELITE')&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns1:SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                        &lt;TIPO_SLA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE)>0&quot;>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA)>0&quot;>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns1:SLA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; or $MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' ) and exists($AccumulateUSERVLAN/ns1:USER_VLAN)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$AccumulateUSERVLAN/ns1:USER_VLAN&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns1:ACCESSO>&#xa;                    &lt;/ns1:TESTATA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:ORDINI_CRMWS>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpubADSL="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="jpubADSL:ORDINI_CRMWS" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="eae5fa69-308f-444b-946d-5ef636d2574e">
                <bpws:targets>
                    <bpws:target linkName="EmptyToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogMapperVC"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+3420a932-9e7d-42fb-9b82-65fbac10ac1d" version="2.0"> <xsl:template name="AccumulateVC" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateVC"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;=$NumeroCicloATMVC" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <=$NumeroCicloATMVC]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery_CLASSE_SERVToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCQuery_TIPO_TRASPORTOToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToJDBCQuery_TIPO_TRASPORTO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_TIPO_Cessazione"
                                    tibex:label="Cessazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MapperVCToAccumulateVC" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery1ToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToMapperVC" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_TIPO_TRASPORTOToMapperVC" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCQuery_CLASSE_SERVToGenericLogger1"
                                    tibex:label="ATMVC non ATTIVA" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GenericLogger1ToAccumulateVC" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="520f545e-74a8-463f-bd39-5a77b59b03ab">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateVC"
                                    outputVariable="AccumulateVC"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="3420a932-9e7d-42fb-9b82-65fbac10ac1d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperVCToAccumulateVC"/>
                                    <bpws:target linkName="GenericLogger1ToAccumulateVC"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperVC</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
