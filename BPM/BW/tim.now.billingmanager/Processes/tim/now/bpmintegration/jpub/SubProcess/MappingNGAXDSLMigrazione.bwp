                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;NonAttiva-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns12:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns12:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns12:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATMVC in asset non attiva&amp;quot;&quot;/>&#xa;                &lt;/tns12:Message>&#xa;                &lt;tns12:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;][$index], true(), true())&quot;/>&#xa;                &lt;/tns12:Payload>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;])) then count($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;]) else if(exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;])) then count($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;]) else 0"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="NumeroCiclo" name="NumeroCicloAssign"
                    outputVariable="NumeroCiclo"
                    tibex:xpdlId="6156a4ff-e1f9-4bf1-952c-4fd3ebd5fdf2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToNumeroCicloAssign_ATTIVAZIONE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NumeroCicloAssignToWhile1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;])) then count($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;]) else if(exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;])) then count($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;]) else 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="NumeroCiclo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="f621183b-6632-49a3-884c-acda53f8fea9">
                <bpws:targets>
                    <bpws:target linkName="NumeroCicloAssignToWhile1"/>
                    <bpws:target linkName="AssignToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToLogMapperUSERVLAN"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+746cd0e9-7780-4b61-9a18-05780226099f" version="2.0"> <xsl:template name="AccumulateUSERVLAN" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateUSERVLAN"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $NumeroCiclo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $NumeroCiclo]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQuery_ID_PROFILO_BMDToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery_DSLAM_TYPEToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="LogJDBCQuery_ID_PROFILO_BMDToJDBCQuery_DSLAM_TYPE" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogJDBCQuery_DSLAM_TYPEToMapperUSERVLAN" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToJDBCQuery_DSLAM_TYPE"
                                    tibex:label="PROFILOBMD ASSENTE" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="MapperUSERVLANToAccumulateUSERVLAN" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="MapperUSERVLANToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateToAccumulateUSERVLAN" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery_DSLAM_TYPEToGenericLogger1"
                                    tibex:label="GBEVC o USERVLAN non ATTIVA" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GenericLogger1ToAccumulateUSERVLAN" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="b361abaa-8e34-4feb-a7c9-0cc091360dc4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:Lavorazione!='CESSAZIONE' and ((exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;]&#xd;&#xa;[number($index)]/attributiDettaglioOrdine[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo) and $MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;USERVLAN&quot;]&#xd;&#xa;[number($index)]/attributiDettaglioOrdine[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;) or &#xd;&#xa;(exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;]&#xd;&#xa;[number($index)]/attributiDettaglioOrdine[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo) and $MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;GBEVC&quot;]&#xd;&#xa;[number($index)]/attributiDettaglioOrdine[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo != &quot;ATTRIBUTO IN ELIMINAZIONE&quot;))) or &#xd;&#xa;($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:Lavorazione='CESSAZIONE' and &#xd;&#xa;(exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/dettaglioasset[nomeComponente = &quot;USERVLAN&quot;]&#xd;&#xa; [number($index)]/attributidettaglioasset[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo) or &#xd;&#xa;exists($MappingNGA_XDSLIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/dettaglioasset[nomeComponente = &quot;GBEVC&quot;]&#xd;&#xa; [number($index)]/attributidettaglioasset[nomeAttributo=&quot;PROFILOBMD&quot;]/valoreAttributo)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($MappingNGA_XDSLIn.input/tns:Lavorazione!='CESSAZIONE' and ((exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "USERVLAN"]
[number($index)]/attributiDettaglioOrdine[nomeAttributo="PROFILOBMD"]/valoreAttributo) and $MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "USERVLAN"]
[number($index)]/attributiDettaglioOrdine[nomeAttributo="PROFILOBMD"]/valoreAttributo != "ATTRIBUTO IN ELIMINAZIONE") or 
(exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "GBEVC"]
[number($index)]/attributiDettaglioOrdine[nomeAttributo="PROFILOBMD"]/valoreAttributo) and $MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = "GBEVC"]
[number($index)]/attributiDettaglioOrdine[nomeAttributo="PROFILOBMD"]/valoreAttributo != "ATTRIBUTO IN ELIMINAZIONE"))) or 
($MappingNGA_XDSLIn.input/tns:Lavorazione='CESSAZIONE' and 
(exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Asset/dettaglioasset[nomeComponente = "USERVLAN"]
 [number($index)]/attributidettaglioasset[nomeAttributo="PROFILOBMD"]/valoreAttributo) or 
exists($MappingNGA_XDSLIn.input/tns:BPMRequest/tns:Asset/dettaglioasset[nomeComponente = "GBEVC"]
 [number($index)]/attributidettaglioasset[nomeAttributo="PROFILOBMD"]/valoreAttributo)))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery_DSLAM_TYPE">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateUSERVLAN"
                                    outputVariable="AccumulateUSERVLAN"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="746cd0e9-7780-4b61-9a18-05780226099f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperUSERVLANToAccumulateUSERVLAN"/>
                                    <bpws:target linkName="JDBCUpdateToAccumulateUSERVLAN"/>
                                    <bpws:target linkName="GenericLogger1ToAccumulateUSERVLAN"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperUSERVLAN</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fcaba5e1-9617-439f-92b8-242ac8d7619f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery_ID_PROFILO_BMD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;ID_PROFILO_BMD>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_PROFILO_BMD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_PROFILO_BMD>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ID_PROFILO_BMD>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_PROFILO_BMD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;GBEVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOBMD&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_PROFILO_BMD>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery_ID_PROFILO_BMD-input"
                                    name="JDBCQuery_ID_PROFILO_BMD"
