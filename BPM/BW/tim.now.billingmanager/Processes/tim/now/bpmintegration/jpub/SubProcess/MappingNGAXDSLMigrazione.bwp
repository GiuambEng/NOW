            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&lt;xsl:param name=&quot;AccumulateVC&quot;/>&lt;xsl:param name=&quot;AccumulateUSERVLAN&quot;/>&lt;xsl:param name=&quot;RecuperaAreaRaccoltaInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:param name=&quot;SelectCOD_MODEM&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;DatiVerificaControlliONESTEP&quot;/>&lt;xsl:param name=&quot;DATA_COMUNE_COINVESTITO&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;CalculateUserVlan&quot;/>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;JDBCQueryRICH_OLO_DETT&quot;/>&lt;xsl:template name=&quot;MapperNGA_XDSL-input&quot; match=&quot;/&quot;>&lt;ns1:ORDINI_CRMWS>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and (exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]) and exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A']))&quot;>&lt;ns1:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)] )&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;ns1:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&lt;/CODE_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/IDRisorsa) > 0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/IDRisorsa&quot;/>&lt;/ID_RIS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ID_RIS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA&quot;/>&lt;/TIPO_FAMIGLIA>&lt;OPZ_COMM>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:OPZ_COMM&quot;/>&lt;/OPZ_COMM>&lt;TIPO_LINEA>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:TIPO_LINEA&quot;/>&lt;/TIPO_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta !=&amp;quot;NGA&amp;quot; and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTCAB&amp;quot; and  $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTH&amp;quot;&quot;>&lt;MOD_FAT>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT&quot;/>&lt;/MOD_FAT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MOD_FAT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_FAT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;47&amp;quot; or $JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;48&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;2&amp;quot;&quot;>&lt;TIPO_MOD_FAT>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/TIPO_MOD_FAT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_MOD_FAT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_MOD_FAT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_MOD_FAT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_MOD_FAT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;MOD_VENDITA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_VENDITA_ACCESSO>&lt;TIPO_TRASP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_TRASP>&lt;MOD_FAT_TRASP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_FAT_TRASP>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset)&quot;>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RIS_LOTTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ID_RIS_LOTTO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke/Output/tns3:Response/tns3:CodeArea) > 0&quot;>&lt;CODE_AREA>&lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke/Output/tns3:Response/tns3:CodeArea&quot;/>&lt;/CODE_AREA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_AREA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_AREA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke/Output/tns3:Response/tns3:CodeMacroArea) > 0&quot;>&lt;CODE_MACRO_AREA>&lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke/Output/tns3:Response/tns3:CodeMacroArea&quot;/>&lt;/CODE_MACRO_AREA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_MACRO_AREA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_MACRO_AREA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;KIT_CONS>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/KIT_CONS>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_COMUNE=&amp;quot;6666&amp;quot;&quot;>&lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_COMUNE&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_ID_ULLCO xsi:type=&quot;xsd:string&quot;>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_ID_ULLCO>&lt;BANDA_SIMM>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/BANDA_SIMM>&lt;TIPO_PROT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_PROT>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIEASYIPNGAFTTH'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot; or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;2&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;2&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;6&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;5&amp;quot;&quot;>&lt;CONSEGNA_EASYIP>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/CONSEGNA_EASYIP>&lt;/xsl:when>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITAC