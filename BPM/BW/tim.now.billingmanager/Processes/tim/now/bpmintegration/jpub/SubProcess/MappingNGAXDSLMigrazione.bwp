                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_CLASSE_SERV&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPCR_UP&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:VC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'  and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDRISORSAVC&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A'&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FLAG_MONITORAGGIO>&#xa;                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;            &lt;/FLAG_MONITORAGGIO>&#xa;            &lt;DATA_INIZIO_NOL>&#xa;                &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;            &lt;/DATA_INIZIO_NOL>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48'&quot;>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery_CLASSE_SERV/Record) > 0&quot;>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery_CLASSE_SERV/Record[1]/VALORE_TRASCODFCTO&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CLASSE_SERV>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/CLASSE_SERV>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectPCR_UP/Record/PCR_UP)&quot;>&#xa;                            &lt;PCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string(xsd:integer($SelectPCR_UP/Record[1]/PCR_UP))&quot;/>&#xa;                            &lt;/PCR_UP_VC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/PCR_UP_VC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo) and string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo,',')&quot;>&#xa;                            &lt;PCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo,',')&quot;/>&#xa;                            &lt;/PCR_UP_VC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo,'.')&quot;>&#xa;                                    &lt;PCR_UP_VC>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo,'.')&quot;/>&#xa;                                    &lt;/PCR_UP_VC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;PCR_UP_VC>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRUP&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/PCR_UP_VC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PCR_UP_VC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/PCR_UP_VC>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectPCR_UP/Record/PCR_DOWN)&quot;>&#xa;                            &lt;PCR_DOWN_VC>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string(xsd:integer($SelectPCR_UP/Record[1]/PCR_DOWN))&quot;/>&#xa;                            &lt;/PCR_DOWN_VC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;PCR_DOWN_VC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/PCR_DOWN_VC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo, ',')&quot;>&#xa;                            &lt;PCR_DOWN_VC>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo,',')&quot;/>&#xa;                            &lt;/PCR_DOWN_VC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo, '.')&quot;>&#xa;                                    &lt;PCR_DOWN_VC>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo,'.')&quot;/>&#xa;                                    &lt;/PCR_DOWN_VC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;PCR_DOWN_VC>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PCRDOWN&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/PCR_DOWN_VC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PCR_DOWN_VC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/PCR_DOWN_VC>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48' or $JDBCQuery_CLASSE_SERV/Record[1]/VALORE_TRASCODFCTO='1'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($SelectPCR_UP/Record/MCR_UP)&quot;>&#xa;                                    &lt;MCR_UP_VC>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(xsd:integer($SelectPCR_UP/Record[1]/MCR_UP))&quot;/>&#xa;                                    &lt;/MCR_UP_VC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MCR_UP_VC>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/MCR_UP_VC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;MCR_UP_VC>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/MCR_UP_VC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB='48' or $JDBCQuery_CLASSE_SERV/Record[1]/VALORE_TRASCODFCTO='1'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo,',')&quot;>&#xa;                                    &lt;MCR_UP_VC>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;][number($index)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MCRUP&amp;quot;]/valoreAttributo,',')&quot;/>&#xa;                                    &lt;/MCR_UP_VC>&#xa;                                &lt;/xsl:when>&#xa;     