curamento/Record[COD_AGESP='T1PRJ0063400']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0063400']/FLAG_OSCURMENTO='N')))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;>&#xa;                                            &lt;EX_TIPO_CLUSTER>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                            &lt;/EX_TIPO_CLUSTER>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;>&#xa;                                            &lt;EX_TIPO_CLUSTER>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo&quot;/>&#xa;                                            &lt;/EX_TIPO_CLUSTER>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;) and exists($AccumulateVC)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$AccumulateVC/ns1:VC&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILEFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSLITE' and  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPBASEPLUSFLAT' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta!='EASYIPSPECIALPROFILELITE')&quot;>&#xa;                                    &lt;ns1:SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;-&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                        &lt;TIPO_SLA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_SLA>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE)>0&quot;>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODICE_SLA_ASSURANCE&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;OFFERTA_SLA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/OFFERTA_SLA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA)>0&quot;>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COPERTURA_ORARIA&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;COPERTURA_ORARIA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/COPERTURA_ORARIA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns1:SLA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or  $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot; ) and exists($AccumulateUSERVLAN/ns1:USER_VLAN)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$AccumulateUSERVLAN/ns1:USER_VLAN&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns1:ACCESSO>&#xa;                    &lt;/ns1:TESTATA>&#xa;                    &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY'and azione='A']&quot;>&#xa;                        &lt;ns1:TESTATA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)] )&quot;>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists(../ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;ns1:EVENTI>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA&quot;/>&#xa;                                &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;TIPO_AZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_AZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA)='POTS' or upper-case($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA)='ISDN'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(../../../tns1:Asset/numeroTelefonico)>0&quot;>&#xa;                                                &lt;UTENZA_RIF>&#xa;                                                    &lt;xsl:value-of select=&quot;../../../tns1:Asset/numeroTelefonico&quot;/>&#xa;                                                &lt;/UTENZA_RIF>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;UTENZA_RIF>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/UTENZA_RIF>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;UTENZA_RIF>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/UTENZA_RIF>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;VEL_BANDA_UP>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/VEL_BANDA_UP>&#xa;                                &lt;VEL_BANDA_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/VEL_BANDA_DOWN>&#xa;                                &lt;FLAG_ESITO_PREQ>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/FLAG_ESITO_PREQ>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(../codiceOrdineOLO)>0&quot;>&#xa;                                        &lt;CODE_OL>&#xa;                                            &lt;xsl:value-of select=&quot;../codiceOrdineOLO&quot;/>&#xa;                                        &lt;/CODE_OL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_OL>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_OL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR'][1]/valoreAttributo)='TLC'&quot;>&#xa;                                                &lt;DONOR>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/DONOR>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;DONOR>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/DONOR>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(attributiDettaglioOrdine[nomeAttributo='TIPOLINEANP']/valoreAttributo) and string-length(attributiDettaglioOrdine[nomeAttributo='TIPOLINEANP'][1]/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo='TIPOLINEANP'][1]/valoreAttributo='1' or attributiDettaglioOrdine[nomeAttributo='TIPOLINEANP'][1]/valoreAttributo='2' or attributiDettaglioOrdine[nomeAttributo='TIPOLINEANP'][1]/valoreAttributo='3'&quot;>&#xa;                                                &lt;TIPO_NUMERO>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_NUMERO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;TIPO_NUMERO>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/TIPO_NUMERO>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_NUMERO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_NUMERO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='PORTABILITASUCCESSIVA']/valoreAttributo)>0&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='PORTABILITASUCCESSIVA']/valoreAttributo)='Y'&quot;>&#xa;                                                &lt;PORTABILITA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/PORTABILITA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='PORTABILITASUCCESSIVA']/valoreAttributo)='N'&quot;>&#xa;                                                &lt;PORTABILITA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/PORTABILITA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;PORTABILITA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/PORTABILITA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;PORTABILITA>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/PORTABILITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns1:EVENTI>&#xa;                        &lt;/ns1:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:TESTATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:string($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[1]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:LavorazioniIndotteAttivazione)>0&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, string($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[azione='D' and attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSET']/valoreAttributo=string(../../../tns1:Asset/IDAsset)]/IDDettaglioOrdine))&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)] )&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO))&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' and exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), hours-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES), minutes-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0 and $MappingNGA_XDSLIn.input/tns1:Lavorazione='ATTIVAZIONE'&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/codiceProgetto) > 0 and $MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto)>0 and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='MIGRAZIONEDEL82'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$DatiVerificaControlliONESTEP/Record[1]/VALORE='Y'&quot;>&#xa;                                    &lt;FLAG_ONE_STEP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_ONE_STEP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_ONE_STEP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_ONE_STEP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='MIGRAZIONEDEL82'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;count($JDBCQueryRICH_OLO_DETT/Record[NOME='DN'])>0&quot;>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'D9'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CAUS>&#xa;                                            &lt;xsl:value-of select=&quot;'D8'&quot;/>&#xa;                                        &lt;/CODE_CAUS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns4:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns1:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_CONTR&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDRisorsa) > 0&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:OPZ_COMM&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;BITSTREAMNGAFTTH&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;BITSTREAMNGAFTTCAB&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;VULAFTTCAB&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;VULAFTTH&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta !=&amp;quot;SEMIVULAFTTH&amp;quot;&quot;>&#xa;                                            &lt;MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT&quot;/>&#xa;                                            &lt;/MOD_FAT>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/MOD_FAT>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/strutturaRichiesta !=&amp;quot;NGA&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTCAB&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;VULAFTTH&amp;quot; and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta !=&amp;quot;SEMIVULAFTTH&amp;quot;&quot;>&#xa;                                    &lt;MOD_FAT>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT&quot;/>&#xa;                                    &lt;/MOD_FAT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MOD_FAT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_FAT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;47&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;48&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_FAT = &amp;quot;2&amp;quot;&quot;>&#xa;                                            &lt;TIPO_MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_MOD_FAT>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_MOD_FAT>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_MOD_FAT>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_MOD_FAT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_MOD_FAT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_TRASP>&#xa;                            &lt;MOD_FAT_TRASP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_FAT_TRASP>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto)>0 and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:NewBilling)>0 and ($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='A' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceRifiuto='D'&quot;>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine)&quot;>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ID_RIS_LOTTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/ID_RIS_LOTTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke.Output/tns3:CodeArea) > 0&quot;>&#xa;                                    &lt;CODE_AREA>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke.Output/tns3:CodeArea&quot;/>&#xa;                                    &lt;/CODE_AREA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_AREA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_AREA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($RecuperaAreaRaccoltaInvoke.Output/tns3:CodeMacroArea) > 0&quot;>&#xa;                                    &lt;CODE_MACRO_AREA>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperaAreaRaccoltaInvoke.Output/tns3:CodeMacroArea&quot;/>&#xa;                                    &lt;/CODE_MACRO_AREA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_MACRO_AREA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_MACRO_AREA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;KIT_CONS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/KIT_CONS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_COMUNE=&amp;quot;6666&amp;quot;&quot;>&#xa;                                    &lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_COMUNE xsi:type=&quot;xsd:string&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_COMUNE&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_ID_ULLCO xsi:type=&quot;xsd:string&quot;>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                    &lt;BANDA_SIMM>&#xa;                                        &lt;xsl:value-of select=&quot;string(xsd:integer($JDBCQuery/Record[1]/PROFILO_COMMERCIALE_DOWN))&quot;/>&#xa;                                    &lt;/BANDA_SIMM>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;BANDA_SIMM>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/BANDA_SIMM>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;TIPO_PROT>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_PROT>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo) =0 and not(exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo))&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/offerta='SEMIEASYIPNGAFTTH'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot; or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;2&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;2&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;6&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;5&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;6&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;7&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCE