                                             &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;CONSEGNA_EASYIP>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/CONSEGNA_EASYIP>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;0&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;2&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;3&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;6&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;4&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;5&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;6&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;MODALITACONSEGNA&amp;quot;]/valoreAttributo = &amp;quot;7&amp;quot;&quot;>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CONSEGNA_EASYIP>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                            &lt;/CONSEGNA_EASYIP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CONSEGNA_EASYIP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CONSEGNA_EASYIP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--CONSEGNA_EASYIP: verificare nuova valorizzazione del campo per EIPUBB-->&#xa;                            &lt;TIPO_MODULAZ>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_MODULAZ&quot;/>&#xa;                            &lt;/TIPO_MODULAZ>&#xa;                            &lt;MOD_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:MOD_ACCESSO&quot;/>&#xa;                            &lt;/MOD_ACCESSO>&#xa;                            &lt;TIPO_VALID>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_VALID>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;SPLITTER&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;][1]/valoreAttributo)>0&quot;>&#xa;                                    &lt;FLAG_SPLITTER>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;SPLITTER&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;][1]/valoreAttributo&quot;/>&#xa;                                    &lt;/FLAG_SPLITTER>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_SPLITTER>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_SPLITTER>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;42&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;44&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;]/valoreAttributo) and  string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;MODEM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;FLAG_MODEM>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_MODEM>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_MODEM>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_MODEM>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MODEM>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MODEM>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;42&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;44&amp;quot;) and exists($SelectCOD_MODEM/Record/COD_MODEM) and $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA='14'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE' and string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='MODEM']/attributidettaglioasset[nomeAttributo='CODICE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='MODEM']/attributidettaglioasset[nomeAttributo='CODICE']/valoreAttributo)='M00'&quot;>&#xa;                                                    &lt;TIPO_INTERF_PC>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TIPO_INTERF_PC>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='MODEM']/attributidettaglioasset[nomeAttributo='CODICE']/valoreAttributo)='M01'&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC)>0&quot;>&#xa;                                                            &lt;TIPO_INTERF_PC>&#xa;                                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC&quot;/>&#xa;                                                            &lt;/TIPO_INTERF_PC>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;TIPO_INTERF_PC>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                            &lt;/TIPO_INTERF_PC>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_INTERF_PC>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TIPO_INTERF_PC>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='MODEM']/attributiDettaglioOrdine[nomeAttributo='CODICE']/valoreAttributo)>0&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='MODEM']/attributiDettaglioOrdine[nomeAttributo='CODICE']/valoreAttributo)='M01'&quot;>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC)>0&quot;>&#xa;                                                                    &lt;TIPO_INTERF_PC>&#xa;                                                                        &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC&quot;/>&#xa;                                                                    &lt;/TIPO_INTERF_PC>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;TIPO_INTERF_PC>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                                    &lt;/TIPO_INTERF_PC>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='MODEM']/attributiDettaglioOrdine[nomeAttributo='CODICE']/valoreAttributo)='M00'&quot;>&#xa;                                                            &lt;TIPO_INTERF_PC>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                            &lt;/TIPO_INTERF_PC>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;TIPO_INTERF_PC>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                            &lt;/TIPO_INTERF_PC>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;TIPO_INTERF_PC>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/TIPO_INTERF_PC>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;42&amp;quot; or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:COD_OFFERTA_JPUB = &amp;quot;44&amp;quot;) and exists($SelectCOD_MODEM/Record/COD_MODEM) and($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA='7' or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA='8' or $JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_FAMIGLIA='10')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC)>0&quot;>&#xa;                                            &lt;TIPO_INTERF_PC>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_INTERF_PC&quot;/>&#xa;                                            &lt;/TIPO_INTERF_PC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_INTERF_PC>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_INTERF_PC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_INTERF_PC>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_INTERF_PC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;BITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;SEMIBITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,&amp;quot;VULA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,&amp;quot;SEMIVULA&amp;quot;) or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='SEMIEASYIPNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUS' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='FULLGPONPLUSNGA'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo =&amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                            &lt;TECNOLOGIA>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo =&amp;quot;TECNOLOGIA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                            &lt;/TECNOLOGIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TECNOLOGIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TECNOLOGIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta,&amp;quot;BITSTREAMATM&amp;quot;)&quot;>&#xa;                                    &lt;TECNOLOGIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&#xa;                                    &lt;/TECNOLOGIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TECNOLOGIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TECNOLOGIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;TIPO_PROVENIENZA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_PROVENIENZA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/numeroTelefonico) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:TIPO_LINEA='3'&quot;>&#xa;                                            &lt;UTENZA_RIF>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/UTENZA_RIF>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;UTENZA_RIF>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/numeroTelefonico&quot;/>&#xa;                                            &lt;/UTENZA_RIF>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;UTENZA_RIF>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/UTENZA_RIF>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='BITSTREAMNGAFTTCAB' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH')&quot;>&#xa;                                    &lt;OPZ_CONTRATTUALE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;F1&amp;quot;&quot;>&#xa;                                            &lt;OPZ_CONTRATTUALE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/OPZ_CONTRATTUALE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo) = &amp;quot;I&amp;quot;&quot;>&#xa;                                            &lt;OPZ_CONTRATTUALE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/OPZ_CONTRATTUALE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;OPZ_CONTRATTUALE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/OPZ_CONTRATTUALE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;OPZ_CONTRATTUALE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/OPZ_CONTRATTUALE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, 'VULA') or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, 'BITSTREAMNGA') or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTCAB' or   $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='EASYIPNGAFTTH'&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD)>0&quot;>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsaOLD&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS_OLD>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/ID_RIS_OLD>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;'N.A.'&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;PROFILO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/PROFILO_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;PROFILO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/PROFILO_ACCESSO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;PCR_UP>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:PCR_UP&quot;/>&#xa;                            &lt;/PCR_UP>&#xa;                            &lt;PCR_DOWN>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:PCR_DOWN&quot;/>&#xa;                            &lt;/PCR_DOWN>&#xa;                            &lt;CODE_PROFILO_ESTESO>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&#xa;                            &lt;/CODE_PROFILO_ESTESO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;BITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;VULA&amp;quot;)&quot;>&#xa;                                    &lt;CODE_OL>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_OL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&#xa;                                            &lt;CODE_OL>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                            &lt;/CODE_OL>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_OL>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/CODE_OL>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--Ricontrollare nel caso di CESSAZIONE-->&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB' )&quot;>&#xa;                                    &lt;TIPO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo) = &amp;quot;DOUBLETAG&amp;quot;&quot;>&#xa;                                            &lt;TIPO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;UNTAGGED&amp;quot;&quot;>&#xa;                                            &lt;MOD_TAG>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_TAG>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_TAG>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_TAG>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MOD_TAG>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_TAG>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_UP_VC))>0&quot;>&#xa;                                    &lt;MCR_UP>&#xa;                                        &lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_UP_VC&quot;/>&#xa;                                    &lt;/MCR_UP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MCR_UP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MCR_UP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_DOWN_VC))>0&quot;>&#xa;                                    &lt;MCR_DOWN>&#xa;                                        &lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_DOWN_VC&quot;/>&#xa;                                    &lt;/MCR_DOWN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;MCR_DOWN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/MCR_DOWN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&#xa;                                    &lt;FLAG_4REFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/FLAG_4REFERENTE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='OPZIONEDINAMICA']/valoreAttributo)>0&quot;>&#xa;                                    &lt;DINAMICO>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='OPZIONEDINAMICA']/valoreAttributo)&quot;/>&#xa;                                    &lt;/DINAMICO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo&quot;>&#xa;                                        &lt;ONU_CAB>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo&quot;/>&#xa;                                        &lt;/ONU_CAB>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUINDIRIZZOCERT']/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUINDIRIZZOCERT']/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo&quot;>&#xa;                                        &lt;ONU_CAB>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUINDIRIZZOCERT']/attributiDettaglioOrdine[nomeAttributo='CCLIONU']/valoreAttributo&quot;/>&#xa;                                        &lt;/ONU_CAB>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACPE']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACPE']/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CPE>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIACPE']/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CPE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='FLAGINTERVENTO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='FLAGINTERVENTO']/valoreAttributo&quot;>&#xa;                                        &lt;FLAG_INTERVENTO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOFWA']/attributiDettaglioOrdine[nomeAttributo='FLAGINTERVENTO']/valoreAttributo&quot;/>&#xa;                                        &lt;/FLAG_INTERVENTO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(((string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='QUALIFICA']/valoreAttributo)>0) and ($COD_CAUS/tns4:COD_CAUS_DESTINATARIO='U2'or $COD_CAUS/tns4:COD_CAUS_DESTINATARIO='0Z')) or (count($DatiVerificaControlliONESTEP/Record) > 0 and upper-case($DatiVerificaControlliONESTEP/Record[1]/VALORE) = (&amp;quot;Y&amp;quot;,&amp;quot;SI&amp;quot;))) and $MappingNGA_XDSLIn.input/tns1:Lavorazione !=&amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/offerta=('BITSTREAMGBEASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMNGAFTTCAB','VULAFTTCAB','EASYIPNGAFTTCAB') and (count($DatiVerificaControlliONESTEP/Record) > 0 and upper-case($DatiVerificaControlliONESTEP/Record[1]/VALORE) = (&amp;quot;Y&amp;quot;,&amp;quot;SI&amp;quot;))&quot;>&#xa;                                            &lt;FLAG_QUALIFICA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(upper-case($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='QUALIFICA']/valoreAttributo)='SI') and ((string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATICOLLAUDO']/attri