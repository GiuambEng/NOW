]/attributidettaglioasset[nomeAttributo = 'TIPOLOGIACLUSTERVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'TIPOLOGIACLUSTERVLAN']/valoreAttributo&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'TIPOLOGIACLUSTERVLAN']/valoreAttributo&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;TIPO_CLUSTER>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERVLAN&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/TIPO_CLUSTER>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FTTHONLY']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FTTHONLY']/valoreAttributo&quot;>&#xa;                                &lt;FTTH_ONLY>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FTTHONLY']/valoreAttributo&quot;/>&#xa;                                &lt;/FTTH_ONLY>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;FTTH_ONLY>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FTTHONLY&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/FTTH_ONLY>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FLAGMULTICAST']/valoreAttributo)>0 and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FLAGMULTICAST']/valoreAttributo = ('SI','Y')&quot;>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;USERVLAN&amp;quot;][$index]/attributidettaglioasset[nomeAttributo = 'FLAGMULTICAST']/valoreAttributo)>0&quot;>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;and azione!='N'][$index]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMULTICAST&amp;quot;]/valoreAttributo = ('SI','Y')&quot;>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;FLAG_MULTICAST>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MULTICAST>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:USER_VLAN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
