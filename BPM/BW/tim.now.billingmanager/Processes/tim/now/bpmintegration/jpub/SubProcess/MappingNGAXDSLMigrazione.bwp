            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/FiltredUserVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:template name=&quot;FiltredUserVlan&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:Element>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/caratterizzazioneAccesso='DRG OPZIONE ZERO'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'])>0&quot;>&#xa;                                    &lt;tns11:SVLANCODE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN']/attributidettaglioasset[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                                    &lt;/tns11:SVLANCODE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/caratterizzazioneAccesso = 'DRG OPZIONE ZERO')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='A']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='MIGRAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and (azione='A' or azione='M')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and (azione='A' or azione='M')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns11:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FiltredUserVlan"
                    name="FiltredUserVlan"
                    outputVariable="FiltredUserVlan"
                    tibex:xpdlId="b22aec48-ab44-4321-bb43-c385b4e5d47b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($FiltredUserVlan/tns1:SVLANCODE[1])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($FiltredUserVlan/tns1:SVLANCODE[1])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FiltredUserVlanToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/FiltredUserVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;FiltredUserVlan&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:Element>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/caratterizzazioneAccesso='DRG OPZIONE ZERO'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN'])>0&quot;>&#xa;                                    &lt;tns11:SVLANCODE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente='USERVLAN']/attributidettaglioasset[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                                    &lt;/tns11:SVLANCODE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/caratterizzazioneAccesso = 'DRG OPZIONE ZERO')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='A']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and azione='D']&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='MIGRAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and (azione='A' or azione='M')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN' and (azione='A' or azione='M')]&quot;>&#xa;                            &lt;tns11:SVLANCODE>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;  string-join(&amp;#xD;&amp;#xA;    $MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='SVLANCODE']/valoreAttributo,&amp;#xD;&amp;#xA;    &amp;quot;', '&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  &amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&#xa;                            &lt;/tns11:SVLANCODE>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns11:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="FiltredUserVlan" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SQLDirect-input"
                    name="SQLDirect" outputVariable="SQLDirect"
                    tibex:xpdlId="5300c48a-99ba-41f2-a932-f0a9eac3f22a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogFiltredUserVlanToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5300c48a-99ba-41f2-a932-f0a9eac3f22a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FiltredUserVlan&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT TIPO_COS, CARATTERISTICAVLAN, BMC_LIGHT, TIPO_BANDA, TIPO_TRASPORTO, COD_VLAN as SVLANCODE FROM ANAG_VLAN WHERE COD_VLAN IN(&amp;quot;,string($FiltredUserVlan),&amp;quot;) AND CARATTERISTICAVLAN='DRG OPZIONE ZERO'&amp;quot;)&quot;/>&lt;/statement>&lt;/tns2:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    timeout="10" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="addb9de3-f15e-44ea-a71a-4bfcf122afc6">
                <bpws:targets>
                    <bpws:target linkName="LogSQLDirectToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToCallProcess"/>
                </bpws:sources>
                <bpws:sequence name="sequence2" tibex:group="iterate">
                    <bpws:assign name="GroupInit2"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+c386671e-22ed-42d5-b42c-93ee30cd472f" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$SQLDirect/unknownResultset/row" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SQLDirect/unknownResultset/row)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns29:Iterate_Current_Element_row"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow4">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart2ToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart2"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="96fd9196-45ed-4fda-b125-d922d2cb9c5d" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToMapper"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SQLDirect/unknownResultset/row)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="c386671e-22ed-42d5-b42c-93ee30cd472f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
