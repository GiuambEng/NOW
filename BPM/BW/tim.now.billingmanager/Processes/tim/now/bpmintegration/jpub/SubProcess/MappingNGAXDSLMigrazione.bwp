                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP WHERE COD_AGESP in ('R1I-22-0330','T1PRJ0001733','T1PRJ0020752', 'T1PRJ0063400')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
