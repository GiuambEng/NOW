gNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;PROFILO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/PROFILO_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;PROFILO_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/PROFILO_ACCESSO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;PCR_UP>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:PCR_UP&quot;/>&#xa;                            &lt;/PCR_UP>&#xa;                            &lt;PCR_DOWN>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:PCR_DOWN&quot;/>&#xa;                            &lt;/PCR_DOWN>&#xa;                            &lt;CODE_PROFILO_ESTESO>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&#xa;                            &lt;/CODE_PROFILO_ESTESO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                     