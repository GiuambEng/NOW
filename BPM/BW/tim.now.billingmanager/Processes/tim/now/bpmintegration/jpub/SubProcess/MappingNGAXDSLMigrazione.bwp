                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7266daec-ad83-4709-a48f-0dd359600034+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperUSERVLAN&quot;/>&#xa;    &lt;xsl:template name=&quot;COS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcUpdateActivityInput>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP2)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP3_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP3)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP5)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;            &lt;Record>&#xa;                &lt;TMSP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TMSP_INSERIMENTO>&#xa;                &lt;TIPO_COS>&#xa;                    &lt;xsl:value-of select=&quot;6&quot;/>&#xa;                &lt;/TIPO_COS>&#xa;                &lt;BANDA_PICCO_UP>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6_MAX)&quot;/>&#xa;                &lt;/BANDA_PICCO_UP>&#xa;                &lt;BANDA_PICCO_DOWN>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery_ID_PROFILO_BMD/Record[1]/BP6)&quot;/>&#xa;                &lt;/BANDA_PICCO_DOWN>&#xa;                &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:ID_RECUPERO_JPUB_MASTER[tns1:BDS_ID=../tns1:Asset/IDAsset]/tns1:ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$MapperUSERVLAN/ID_RIS&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;            &lt;/Record>&#xa;        &lt;/tns6:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
