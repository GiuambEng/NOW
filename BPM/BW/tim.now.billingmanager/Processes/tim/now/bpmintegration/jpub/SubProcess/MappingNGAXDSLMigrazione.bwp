p;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;UNTAGGED&amp;quot;&quot;>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and (starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;EASY&amp;quot;) or starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;SEMIEASY&amp;quot;)) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_UP_VC))>0&quot;>&lt;MCR_UP>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_UP_VC&quot;/>&lt;/MCR_UP>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) or starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;SEMIEASY&amp;quot;))and string-length(string($AccumulateVC/ns1:VC[1]/MCR_UP_VC))>0&quot;>&lt;MCR_UP>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_UP_VC&quot;/>&lt;/MCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_UP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and (starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;EASY&amp;quot;) or starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta, &amp;quot;SEMIEASY&amp;quot;)) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_DOWN_VC))>0&quot;>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_DOWN_VC&quot;/>&lt;/MCR_DOWN>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) or starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;SEMIEASY&amp;quot;)) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_DOWN_VC))>0&quot;>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_DOWN_VC&quot;/>&lt;/MCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='MIGRAZIONEDEL82' and exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUPOLICYCONTATTO'])>0 and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUINTERVENTOSEDECLIENTE']/attributiDettaglioOrdine[nomeAttributo='CODICEESITO']/valoreAttributo=('01','02','03','04')&quot;>&lt;FLAG_4REFERENTE>&lt;xsl:value-of select=&quot