                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns3:Request&gt;
            &lt;/input&gt;
        &lt;/tns6:RecuperaAreaRaccoltaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/RecuperaAreaRaccolta/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecuperaAreaRaccolta/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaAreaRaccoltaInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;])&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;USERVLAN&amp;quot;]&quot;>&#xa;                                &lt;tns3:Dati>&#xa;                                    &lt;tns3:USERVLAN>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:SVLANCODE>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:SVLANCODE>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:CODEVLANSINGLETAG>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:CODEVLANSINGLETAG>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns3:USERVLAN>&#xa;                                &lt;/tns3:Dati>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;])&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;ATMVC&amp;quot;]&quot;>&#xa;                                &lt;tns3:Dati>&#xa;                                    &lt;tns3:ATMVC>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:TIPOBANDACONSEGNA>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:TIPOBANDACONSEGNA>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:CODICEVP>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:CODICEVP>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:CODICETD>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:CODICETD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns3:ATMVC>&#xa;                                &lt;/tns3:Dati>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente = &amp;quot;GBEVC&amp;quot;]&quot;>&#xa;                                &lt;tns3:Dati>&#xa;                                    &lt;tns3:GBEVC>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:SVLANCODE>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:SVLANCODE>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;>&#xa;                                            &lt;tns3:CODEVLANSINGLETAG>&#xa;                                                &lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:CODEVLANSINGLETAG>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns3:GBEVC>&#xa;                                &lt;/tns3:Dati>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;])&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;]&quot;>&#xa;                        &lt;tns3:Dati>&#xa;                            &lt;tns3:USERVLAN>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                    &lt;tns3:SVLANCODE>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/tns3:SVLANCODE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;>&#xa;                                    &lt;tns3:CODEVLANSINGLETAG>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODEVLANSINGLETAG&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/tns3:CODEVLANSINGLETAG>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns3:USERVLAN>&#xa;                        &lt;/tns3:Dati>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;])&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ATMVC&amp;quot;]&quot;>&#xa;                        &lt;tns3:Dati>&#xa;                            &lt;tns3:ATMVC>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo&quot;>&#xa;                                    &lt;tns3:TIPOBANDACONSEGNA>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOBANDACONSEGNA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/tns3:TIPOBANDACONSEGNA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo&quot;>&#xa;                                    &lt;tns3:CODICEVP>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEVP&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/tns3:CODICEVP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICETD&amp;quot;]/valoreAttributo&quot;>&#xa;                                    &lt;tns3:CODICETD>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[n