                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_DSLAM_TYPE&quot;/>&#xa;    &lt;xsl:template name=&quot;LogJDBCQuery_DSLAM_TYPE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:CW_BUS_MESSAGE>&#xa;            &lt;tns12:GenericLogger>&#xa;                &lt;tns12:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns12:Application>&#xa;                &lt;tns12:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Process>&#xa;                &lt;tns12:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSLPortType&amp;quot;&quot;/>&#xa;                &lt;/tns12:Service>&#xa;                &lt;tns12:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingNGA_XDSL&amp;quot;&quot;/>&#xa;                &lt;/tns12:Operation>&#xa;                &lt;xsl:if test=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                    &lt;tns12:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns12:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery_DSLAM_TYPE/Record)&quot;>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;$JDBCQuery_DSLAM_TYPE: &amp;quot;,  tib:render-xml($JDBCQuery_DSLAM_TYPE/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns12:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;$JDBCQuery_DSLAM_TYPE non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns12:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns12:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns12:LoggerName>&#xa;                &lt;tns12:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns12:LogLevel>&#xa;                &lt;tns12:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns12:LogJMS>&#xa;            &lt;/tns12:GenericLogger>&#xa;        &lt;/tns12:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingNGA_XDSLIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_DSLAM_TYPE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery_ID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperUSERVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:USER_VLAN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAVC']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAVC']/valoreAttributo, &amp;quot;/&amp;quot;)&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAVC']/valoreAttributo, '/')&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente =&amp;quot;GBEVC&amp;quot;][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAVC']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente ='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAUSERVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente ='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAUSERVLAN']/valoreAttributo, &amp;quot;/&amp;quot;)&quot;>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;tib:substring-after-last($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente ='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAUSERVLAN']/valoreAttributo, '/')&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[nomeComponente ='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo = 'IDRISORSAUSERVLAN']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='VARIAZIONETAGGING' and upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;TAGGED&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset&amp;#xD;&amp;#xA;&amp;#x9;[nomeComponente='GBEVC'][attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo = $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='GBEVC'][number($index)]/attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo and attributidettaglioasset[n