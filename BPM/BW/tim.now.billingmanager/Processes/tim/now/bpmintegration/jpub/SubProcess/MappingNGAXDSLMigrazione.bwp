tring-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&lt;PROFILO_ACCESSO>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&lt;/PROFILO_ACCESSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PROFILO_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/PROFILO_ACCESSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;PCR_UP>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:PCR_UP&quot;/>&lt;/PCR_UP>&lt;PCR_DOWN>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:PCR_DOWN&quot;/>&lt;/PCR_DOWN>&lt;CODE_PROFILO_ESTESO>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns4:JDBCQueryResponse/tns4:XDSL_NGA/tns4:CODE_PROFILO_ESTESO&quot;/>&lt;/CODE_PROFILO_ESTESO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo)>0&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;BITSTREAMNGA&amp;quot;) or starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta, &amp;quot;VULA&amp;quot;)&quot;>&lt;CODE_OL>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_OL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&lt;CODE_OL>&lt;xsl:value-of select=&quot;$MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODE_OL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_OL>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_OL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--Ricontrollare nel caso di CESSAZIONE-->&lt;xsl:choose>&lt;xsl:when test=&quot;($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTH' or $MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta='VULAFTTCAB' )&quot;>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo) = &amp;quot;DOUBLETAG&amp;quot;&quot;>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN1TAGGING&amp;quot;]/valoreAttributo) = &amp;quot;UNTAGGED&amp;quot;&quot;>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MOD_TAG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_TAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_UP_VC))>0&quot;>&lt;MCR_UP>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_UP_VC&quot;/>&lt;/MCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_UP>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MCR_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/offerta, &amp;quot;EASY&amp;quot;) and string-length(string($AccumulateVC/ns1:VC[1]/MCR_DOWN_VC))>0&quot;>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;$AccumulateVC/ns1:VC[1]/MCR_DOWN_VC&quot;/>&lt;/MCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MCR_DOWN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&lt;FLAG_4REFERENTE>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAG_4REFERENTE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='OPZIONEDINAMICA']/valoreAttributo)>0&quot;>&lt;DINAMICO>&lt;xsl:value-of select=&quot;upper-case($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='OPZIONEDINAMICA']/valoreAttributo)&quot;/>&lt;/DINAMICO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingNGA_XDSLIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponent