                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;AggiuntiviNP&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/ns:REGOLATORIO)&quot;>&#xa;                &lt;ns:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA&quot;/>&#xa;                &lt;/ns:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:REGOLATORIO>&#xa;                    &lt;xsl:if test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NPSync)=0&quot;>&#xa;                        &lt;ns:TESTATA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;$COD_CAUS/tns:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns:ACCESSO>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:COD_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_PREST_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_PREST_AGG>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioAssetParent = IDDettaglioAssetRoot]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioAssetParent = IDDettaglioAssetRoot]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ID_RIS_PRINC>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                &lt;/ID_RIS_PRINC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                                &lt;CODE_GEST_REC>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/CODE_GEST_REC>&#xa;                                &lt;TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:OPZ_COMM&quot;/>&#xa;                                &lt;/OPZ_COMM>&#xa;                                &lt;TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_LINEA>&#xa;                                &lt;FLAG_NP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_NP>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot; &quot;>&#xa;                                                &lt;SUB_TIPO_LINEA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&#xa;                                                &lt;/SUB_TIPO_LINEA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;SUB_TIPO_LINEA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&#xa;                                                &lt;/SUB_TIPO_LINEA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;SUB_TIPO_LINEA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/SUB_TIPO_LINEA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;MOD_VENDITA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE='6666'&quot;>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE)=6&quot;>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo) > 0&quot;>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_PERMUTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA>&#xa;                                &lt;FLAG_MIGRAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;FLAG_QUALIFICAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CAMPO_SERV_IT>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CAMPO_SERV_IT>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$COD_CAUS/tns:COD_CAUS_DESTINATARIO='1' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                            &lt;/ns:ACCESSO>&#xa;                        &lt;/ns:TESTATA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$AggiuntiviNP/tns2:AggiuntiviWLR&quot;>&#xa;                        &lt;ns:TESTATA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:NPSync)>0&quot;>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:NPSync&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_ORD_CRMWS>&#xa;                                        &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,'-','1')&quot;/>&#xa;                                    &lt;/ID_ORD_CRMWS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DRO>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DRO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DATA_DES>&#xa;                                                &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                            &lt;/DATA_DES>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CAUS>&#xa;                                        &lt;xsl:value-of select=&quot;$COD_CAUS/tns:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                    &lt;/CODE_CAUS>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_ORDINE_ISP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_PROGETTO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_PROGETTO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns:ACCESSO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                        &lt;TIPO_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_CONTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_CONTR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;37&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_CONTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:COD_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_CLLI>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CODE_PREST_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_PREST_AGG>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns2:ID_RIS)>0&quot;>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;tns2:ID_RIS&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/ID_RIS>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(tns2:ID_RIS_PRINC)>0&quot;>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;tns2:ID_RIS_PRINC&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_PRINC>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/ID_RIS_PRINC>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                                &lt;CODE_GEST_REC>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/CODE_GEST_REC>&#xa;                                &lt;TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:OPZ_COMM&quot;/>&#xa;                                &lt;/OPZ_COMM>&#xa;                                &lt;TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/TIPO_LINEA>&#xa;                                &lt;FLAG_NP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_NP>&#xa;                                &lt;SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;53&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA>&#xa;                                &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;MOD_VENDITA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;TIPO_AZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                        &lt;/TIPO_AZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:DataInizioNol)&quot;>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:DataInizioNol&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_INIZIO_NOL>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                        &lt;/DATA_INIZIO_NOL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE='6666'&quot;>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE)=6&quot;>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;CODE_COMUNE>&#xa;                                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                                &lt;/CODE_COMUNE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo) > 0&quot;>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_ID_ULLCO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_ID_ULLCO>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DISTR>&#xa;                                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                        &lt;/CODE_DISTR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_PERMUTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA>&#xa;                                &lt;FLAG_MIGRAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;FLAG_QUALIFICAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ID_RIS_OLD>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                        &lt;/ID_RIS_OLD>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_QUALITA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_QUALITA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODICE_DELIVERY>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODICE_DELIVERY>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;CAMPO_SERV_IT>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CAMPO_SERV_IT>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor) > 0&quot;>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonor&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONOR>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONOR>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating) > 0&quot;>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codificaOLOAGCOMDonating&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_DONATING>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/CODE_DONATING>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$COD_CAUS/tns:COD_CAUS_DESTINATARIO='1' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                    &lt;TIPO_CESSAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                    &lt;/TIPO_CESSAZIONE>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                            &lt;/ns:ACCESSO>&#xa;                        &lt;/ns:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="JDBCQueryInvoke-input"
                name="JDBCQueryInvoke" operation="JDBCQuery"
                outputVariable="JDBCQueryInvoke" partnerLink="JDBCQuery"
                portType="ns4:JDBCQueryPortType" tibex:xpdlId="c71298b3-93f4-4a99-a4e6-49ce6d94ebfe">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/JDBCQuery" version="2.0"&gt;&lt;xsl:param name="MappingREG_NPIn"/&gt;&lt;xsl:template name="JDBCQueryInvoke-input" match="/"&gt;&lt;tns1:JDBCQueryRequest&gt;&lt;input&gt;&lt;xsl:copy-of select="$MappingREG_NPIn/input/tns:SendJPUBRequest"/&gt;&lt;/input&gt;&lt;/tns1:JDBCQueryRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/JDBCQuery&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$MappingREG_NPIn.input&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToJDBCQueryInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="JDBCQueryInvokeToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="JDBCQueryInvokeToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = &quot;NPG&quot; or (exists($MappingREG_NPIn/input/tns:SendJPUBRequest/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:NPTimer) > 0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/strutturaRichiesta = "NPG" or (exists($MappingREG_NPIn.input/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn.input/tns:NPTimer) > 0)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="JDBCQueryInvokeToThrow"
                        tibex:faultDetailsVar="JDBCQueryInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="JDBCQueryInvokeToMapper1_NPNG">
