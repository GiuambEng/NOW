                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0048031f-a8b5-4d74-8ea0-7ae1c1f8f8ac+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;PROVENIENZA>&lt;xsl:value-of select=&quot;'BPM'&quot;/>&lt;/PROVENIENZA>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;DATAFI_ASSOCZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_ASSOCZ_VALID>&lt;DATAINZ_ASSOCZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAINZ_ASSOCZ_VALID>&lt;DATAFI_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_VALID>&lt;DATAINZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAINZ_VALID>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM)&quot;>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;DESCRIPTION>&lt;xsl:value-of select=&quot;'Active'&quot;/>&lt;/DESCRIPTION>&lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="COD_CONTR-input" name="COD_CONTR"
                    outputVariable="COD_CONTR"
                    tibex:xpdlId="0048031f-a8b5-4d74-8ea0-7ae1c1f8f8ac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NPSYNCToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0048031f-a8b5-4d74-8ea0-7ae1c1f8f8ac+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;'Active'&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;            &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;            &lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.COD_CONTRATTO&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.PROVENIENZA = ? AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = ?&#xa;AND (CON.ID_TPLG_OPERATORE =? OR (? IS NULL AND CON.ID_TPLG_OPERATORE IS NULL))&#xa;ORDER BY CON.FLAG_NPD desc,CON.TIMSTP_INSMTO desc&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TPLG_OPERATORE1"/>
                                    <columnMetadata
                                    columnName="COD_CONTRATTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:template name=&quot;AggiuntiviNP&quot; match=&quot;/&quot;>&lt;tns1:Aggiuntivi>&lt;xsl:for-each select=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and azione='A']&quot;>&lt;tns1:AggiuntiviWLR>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&lt;tns1:ID_RIS>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns1:ID_RIS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&lt;tns1:ID_RIS_PRINC>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&lt;/tns1:ID_RIS_PRINC>&lt;/xsl:if>&lt;/xsl:if>&lt;tns1:IDDETTAGLIOORDINE>&lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&lt;/tns1:IDDETTAGLIOORDINE>&lt;/tns1:AggiuntiviWLR>&lt;/xsl:for-each>&lt;/tns1:Aggiuntivi>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="AggiuntiviNP" name="AssignNPAgg"
                    outputVariable="AggiuntiviNP"
                    tibex:xpdlId="9edd6b0f-fcf0-4d67-b174-b5f3059d8967" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssignNPAgg"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToMapperNP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiuntiviNP&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Aggiuntivi>&#xa;            &lt;xsl:for-each select=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMERIAGGIUNTIVI&amp;quot; and azione='A']&quot;>&#xa;                &lt;tns1:AggiuntiviWLR>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&#xa;                                &lt;tns1:ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns1:ID_RIS>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;>&#xa;                            &lt;tns1:ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                            &lt;/tns1:ID_RIS_PRINC>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                    &lt;/tns1:IDDETTAGLIOORDINE>&#xa;                &lt;/tns1:AggiuntiviWLR>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:Aggiuntivi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="AggiuntiviNP" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="AGG" tibex:xpdlId="bb648a30-30d8-49f3-9450-8ea22eafb83a">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryInvokeToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
