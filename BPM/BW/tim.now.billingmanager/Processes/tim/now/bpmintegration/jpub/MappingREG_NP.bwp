ose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB&amp;#xD;&amp;#xA;&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_CONTR&amp;#xD;&amp;#xA;&quot;/>&lt;/CODE_CONTR>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_CLLI>&lt;CODE_PREST_AGG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_PREST_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>