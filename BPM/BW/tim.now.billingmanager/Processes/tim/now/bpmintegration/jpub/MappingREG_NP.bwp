               &lt;/xsl:choose>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;SUB_TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&amp;#xD;&amp;#xA;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&a