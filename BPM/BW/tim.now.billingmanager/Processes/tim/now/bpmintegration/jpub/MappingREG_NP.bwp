                        <bpws:target linkName="MappingREG_NPInToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_MappingREG_NPInToRegolatorio">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Log_MappingREG_WLR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEAATTIVA' or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLR' or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='VARIAZIONEWLR' or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA') or (exists($MappingREG_NPIn/input/tns:SendJPUBRequest/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:WLRTimer)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEAATTIVA' or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLR' or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='WLRLINEANONATTIVA' or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='VARIAZIONEWLR' or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta)='CESSAZIONEWLRLINEANONATTIVA') or (exists($MappingREG_NPIn.input/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn.input/tns:WLRTimer)>0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_MappingREG_NPIn-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Process MappingREG_NP started.&amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
