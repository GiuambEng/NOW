ioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0 and (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA; then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else if($ModVenditaAccesso='51')&amp;#x9;&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine&amp;#xD;&amp;#xA;[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0  and (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y')) &amp;#xD;&amp;#xA;then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else &amp;quot;&amp;quot;&quot;/>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of 