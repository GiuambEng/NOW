t/tns1:Richiesta/ordine/tipologiaQualita) > 0&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&amp;#xD;&amp;#xA;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&amp;#xD;&amp;#xA;&quot;>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&amp;#xD;&amp;#xA;&quot;>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CAMPO_SERV_IT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;QUANTITA>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QUANTITA>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/CODE_DONOR>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&