                <bpws:link name="MapperNPNGToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToMappingREG_NPOut" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="MappingREG_NPIn"
                operation="MappingREG_NP"
                partnerLink="MappingREG_NPPortType"
                portType="ns2:MappingREG_NPPortType"
                tibex:xpdlId="97551375-7158-4ccb-ad50-60da675da28c" variable="MappingREG_NPIn">
                <bpws:sources>
                    <bpws:source linkName="MappingREG_NPInToCallProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="MappingREG_NPOut"
                operation="MappingREG_NP"
                partnerLink="MappingREG_NPPortType"
                portType="ns2:MappingREG_NPPortType"
                tibex:xpdlId="c55c7419-7e2b-4d50-9cee-72633d5d5e21" variable="MappingREG_NPOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP" xmlns:tns1="http://www.tim.com/NOW/xsd/JPUB_Util" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns2="http://www.tim.com/NOW/xsd/InvioJPUB/" version="2.0"&gt;
    &lt;xsl:param name="MapperREG"/&gt;
    &lt;xsl:param name="MapperNP"/&gt;
    &lt;xsl:param name="MappingWLR"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="MappingREG_NPIn"/&gt;
    &lt;xsl:param name="MapperNPNG"/&gt;
    &lt;xsl:template name="MappingREG_NPOut-input" match="/"&gt;
        &lt;tns:MappingREG_NPResponse&gt;
            &lt;output&gt;
                &lt;tns1:MappingREG_NPResponse&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($MappingREG_NPIn/input/tns2:SendJPUBRequest/tns2:NPSYNCREG)&gt;0 or (string-length($MappingREG_NPIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:NPSync)&gt;0 and contains($MappingREG_NPIn/input/tns2:SendJPUBRequest/tns2:BPMRequest/tns2:NPSync,'_R'))"&gt;
                            &lt;tns1:NP&gt;
                                &lt;tns1:PRINCIPALE&gt;
                                    &lt;ns:REGOLATORIO&gt;
                                        &lt;xsl:copy-of select="$Mapper/ns:TESTATA"/&gt;
                                    &lt;/ns:REGOLATORIO&gt;
                                &lt;/tns1:PRINCIPALE&gt;
                                &lt;tns1:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;False&amp;quot;"/&gt;
                                &lt;/tns1:ControlloStruttura&gt;
                            &lt;/tns1:NP&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MappingWLR/tns1:WLR)"&gt;
                            &lt;tns1:WLR&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns1:WLR/tns1:PRINCIPALE)"&gt;
                                        &lt;xsl:copy-of select="$MappingWLR/tns1:WLR/tns1:PRINCIPALE"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns1:WLR/tns1:AGGIUNTIVI)"&gt;
                                        &lt;tns1:AGGIUNTIVI&gt;
                                            &lt;xsl:copy-of select="$MappingWLR/tns1:WLR/tns1:AGGIUNTIVI/ns:REGOLATORIO"/&gt;
                                        &lt;/tns1:AGGIUNTIVI&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MappingWLR/tns1:WLR/tns1:STS)"&gt;
                                        &lt;tns1:STS&gt;
                                            &lt;xsl:copy-of select="$MappingWLR/tns1:WLR/tns1:STS/ns:REGOLATORIO"/&gt;
                                        &lt;/tns1:STS&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;tns1:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="'True'"/&gt;
                                &lt;/tns1:ControlloStruttura&gt;
                            &lt;/tns1:WLR&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MapperNPNG)"&gt;
                            &lt;tns1:REGOLATORIO&gt;
                                &lt;ns:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MapperNPNG/ns:TESTATA"/&gt;
                                &lt;/ns:REGOLATORIO&gt;
                                &lt;tns1:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;False&amp;quot;"/&gt;
                                &lt;/tns1:ControlloStruttura&gt;
                            &lt;/tns1:REGOLATORIO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="exists($MapperREG)"&gt;
                            &lt;tns1:REGOLATORIO&gt;
                                &lt;ns:REGOLATORIO&gt;
                                    &lt;xsl:copy-of select="$MapperREG/ns:TESTATA"/&gt;
                                &lt;/ns:REGOLATORIO&gt;
                                &lt;tns1:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;False&amp;quot;"/&gt;
                                &lt;/tns1:ControlloStruttura&gt;
                            &lt;/tns1:REGOLATORIO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:NP&gt;
                                &lt;tns1:PRINCIPALE&gt;
                                    &lt;ns:REGOLATORIO&gt;
                                        &lt;xsl:copy-of select="$MapperNP/ns:TESTATA"/&gt;
                                    &lt;/ns:REGOLATORIO&gt;
                                &lt;/tns1:PRINCIPALE&gt;
                                &lt;tns1:ControlloStruttura&gt;
                                    &lt;xsl:value-of select="&amp;quot;True&amp;quot;"/&gt;
                                &lt;/tns1:ControlloStruttura&gt;
                            &lt;/tns1:NP&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns1:MappingREG_NPResponse&gt;
            &lt;/output&gt;
        &lt;/tns:MappingREG_NPResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.now/NOW/wsdl/abstract/MappingREG_NP&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperREG&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperNP&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingWLR&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperNPNG&quot;/>&#xa;    &lt;xsl:template name=&quot;MappingREG_NPOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:MappingREG_NPResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns2:NPSYNCREG)>0 or (string-length($MappingREG_NPIn.input/tns2:BPMRequest/tns2:NPSync)>0 and contains($MappingREG_NPIn.input/tns2:BPMRequest/tns2:NPSync,'_R'))&quot;>&#xa;                    &lt;tns1:NP>&#xa;                        &lt;tns1:PRINCIPALE>&#xa;                            &lt;ns:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;$Mapper/ns:TESTATA&quot;/>&#xa;                            &lt;/ns:REGOLATORIO>&#xa;                        &lt;/tns1:PRINCIPALE>&#xa;                        &lt;tns1:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;False&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ControlloStruttura>&#xa;                    &lt;/tns1:NP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MappingWLR/tns1:WLR)&quot;>&#xa;                    &lt;tns1:WLR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns1:WLR/tns1:PRINCIPALE)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$MappingWLR/tns1:WLR/tns1:PRINCIPALE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns1:WLR/tns1:AGGIUNTIVI)&quot;>&#xa;                                &lt;tns1:AGGIUNTIVI>&#xa;                                    &lt;xsl:copy-of select=&quot;$MappingWLR/tns1:WLR/tns1:AGGIUNTIVI/ns:REGOLATORIO&quot;/>&#xa;                                &lt;/tns1:AGGIUNTIVI>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingWLR/tns1:WLR/tns1:STS)&quot;>&#xa;                                &lt;tns1:STS>&#xa;                                    &lt;xsl:copy-of select=&quot;$MappingWLR/tns1:WLR/tns1:STS/ns:REGOLATORIO&quot;/>&#xa;                                &lt;/tns1:STS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;'True'&quot;/>&#xa;                        &lt;/tns1:ControlloStruttura>&#xa;                    &lt;/tns1:WLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapperNPNG)&quot;>&#xa;                    &lt;tns1:REGOLATORIO>&#xa;                        &lt;ns:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MapperNPNG/ns:TESTATA&quot;/>&#xa;                        &lt;/ns:REGOLATORIO>&#xa;                        &lt;tns1:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;False&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ControlloStruttura>&#xa;                    &lt;/tns1:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapperREG)&quot;>&#xa;                    &lt;tns1:REGOLATORIO>&#xa;                        &lt;ns:REGOLATORIO>&#xa;                            &lt;xsl:copy-of select=&quot;$MapperREG/ns:TESTATA&quot;/>&#xa;                        &lt;/ns:REGOLATORIO>&#xa;                        &lt;tns1:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;False&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ControlloStruttura>&#xa;                    &lt;/tns1:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:NP>&#xa;                        &lt;tns1:PRINCIPALE>&#xa;                            &lt;ns:REGOLATORIO>&#xa;                                &lt;xsl:copy-of select=&quot;$MapperNP/ns:TESTATA&quot;/>&#xa;                            &lt;/ns:REGOLATORIO>&#xa;                        &lt;/tns1:PRINCIPALE>&#xa;                        &lt;tns1:ControlloStruttura>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;True&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ControlloStruttura>&#xa;                    &lt;/tns1:NP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:MappingREG_NPResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToMappingREG_NPOut"/>
                    <bpws:target linkName="CallProcessToMappingREG_NPOut"/>
                    <bpws:target linkName="LOG_MapperNPToMappingREG_NPOut"/>
                    <bpws:target linkName="CallProcessToMappingREG_NPOut1"/>
                    <bpws:target linkName="GenericLoggerToMappingREG_NPOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:template name=&quot;MapperREG-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO)&quot;>&lt;ns:REGOLATORIO>&lt;xsl:copy-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO/ns:TESTATA&quot;/>&lt;/ns:REGOLATORIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:REGOLATORIO>&lt;ns:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)])&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' or $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE') and $MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP'&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'N1'&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ACCESSO>&lt;xsl:variable name=&quot;ModVenditaAccesso&quot; select=&quot;if((upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) and ($JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37' or $JDBCQueryInvoke/output/tns3:JDBCQueryResponse/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23'))&amp;#xD;&amp;#xA;&amp;#x9;then if(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest