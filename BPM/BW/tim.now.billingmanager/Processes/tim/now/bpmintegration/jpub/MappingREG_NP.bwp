                 &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--Aperta un ISSUE -->&#xa;                            &lt;!--CHIEDERE A GOVERNANCE-->&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='17'&quot;>&#xa;                                    &lt;FLAG_MIGRAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_MIGRAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='17'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BITRATE']/valoreAttributo)&amp;lt;800 &quot;>&#xa;                                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='BITRATE']/valoreAttributo)>=800 &quot;>&#xa;                                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BITRATE']/valoreAttributo)&amp;lt;800&quot;>&#xa;                                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='BITRATE']/valoreAttributo)>=800&quot;>&#xa;                                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_QUALIFICAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE'  and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='TRASLOCO'&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAORIGINARIO']/valoreAttributo&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_RIS_OLD>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                    &lt;/ID_RIS_OLD>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_QUALITA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_QUALITA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODICE_DELIVERY>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODICE_DELIVERY>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CAMPOSERVIZIOIT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CAMPO_SERV_IT>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CAMPO_SERV_IT>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonor)>0&quot;>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonor&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonating)>0&quot;>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOMDonating&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot; upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDSLUCo&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;CODE_ID_SLUCO>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/CODE_ID_SLUCO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and ($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37') and $ModVenditaAccesso = &amp;quot;51&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or   $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;S&amp;quot; &quot;>&#xa;                                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and ($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')  and $ModVenditaAccesso = &amp;quot;51&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or  $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot;]/valoreAttributo = &amp;quot;S&amp;quot; &quot;>&#xa;                                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                &lt;TIPO_CESSAZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIANP']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                &lt;/TIPO_CESSAZIONE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;>&#xa;                                                &lt;TIPO_CESSAZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUFONIA']/attributiDettaglioOrdine[nomeAttributo='TIPOCESSAZIONE']/valoreAttributo&quot;/>&#xa;                                                &lt;/TIPO_CESSAZIONE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='N1'&quot;>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;$FLAG_LA&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='ATTIVAZIONE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaSottolav='NORMALE' and &amp;#xD;&amp;#xA;($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;ULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;SLULINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;SLULINEANONATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;ULLLINEANONATTIVANP&amp;quot; or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta = &amp;quot;ULLDATILINEANONATTIVANP&amp;quot;)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;FLAG_4REFERENTE>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/FLAG_4REFERENTE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;TIPO_CLUSTER>&#xa;                                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLOGIACLUSTERCOMUNE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns:ACCESSO>&#xa;                    &lt;/ns:TESTATA>&#xa;                &lt;/ns:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiuntiviWLR/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:param name=&quot;AggiuntiviNP&quot;/>&lt;xsl:template name=&quot;MapperNP-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO)&quot;>&lt;ns:REGOLATORIO>&lt;xsl:copy-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO/ns:TESTATA&quot;/>&lt;/ns:REGOLATORIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:REGOLATORIO>&lt;xsl:if test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:NPSync)=0&quot;>&lt;ns:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/CODE_CAUS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$COD_CAUS/tns:COD_CAUS_DESTINATARIO&quot;/>&lt;/CODE_CAUS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:COD_CONTR&quot;/>&lt;/CODE_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_CLLI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_PREST_AGG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_PREST_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioOrdineParent = IDDettaglioOrdineRoot]/attributiDettaglioOrdine[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioAssetParent = IDDettaglioAssetRoot]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)&quot;>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/dettaglioasset[upper-case(nomeComponente) = &amp;quot;NUMBERPORTABILITY&amp;quot; and IDDettaglioAssetParent = IDDettaglioAssetRoot]/attributidettaglioasset[upper-case(nomeAttributo) = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&lt;CODE_GEST_REC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/CODE_GEST_REC>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_FAMIGLIA>&lt;OPZ_COMM>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:OPZ_COMM&quot;/>&lt;/OPZ_COMM>&lt;TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_LINEA>&lt;FLAG_NP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_NP>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot; &quot;>&lt;SUB_TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;55&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;SUB_TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;SUB_TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;SUB_TIPO_LINEA_RESIDENZIALE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA_RESIDENZIALE>&lt;SUB_TIPO_LINEA_DIREZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA_DIREZIONE>&lt;MOD_VENDITA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD