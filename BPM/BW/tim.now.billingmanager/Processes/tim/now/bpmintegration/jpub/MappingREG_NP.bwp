                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/ns:REGOLATORIO)&quot;>&#xa;                &lt;ns:REGOLATORIO>&#xa;                    &lt;xsl:copy-of select=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA&quot;/>&#xa;                &lt;/ns:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:REGOLATORIO>&#xa;                    &lt;ns:TESTATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)])&quot;>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO, &amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;DATA_DES>&#xa;                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                        &lt;/DATA_DES>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' or $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE') and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP'&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;'N1'&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CAUS/tns3:COD_CAUS_DESTINATARIO&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns:ACCESSO>&#xa;                            &lt;xsl:variable name=&quot;ModVenditaAccesso&quot; select=&quot;if((upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) and ($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23'))&amp;#xD;&amp;#xA;&amp;#x9;then if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else &amp;quot;&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;else if((upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;)&amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;50&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else if(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;then &amp;quot;51&amp;quot;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else &amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;xsl:variable name=&quot;FLAG_LA&quot; select=&quot;if(($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione=&amp;quot;VARIAZIONE&amp;quot; and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP') or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='N1')) then &amp;quot;&amp;quot;&amp;#xD;&amp;#xA;else if (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = (&amp;quot;VARIAZIONE&amp;quot;, &amp;quot;CESSAZIONE&amp;quot;)&amp;#xD;&amp;#xA;and $ModVenditaAccesso='51') &amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0 and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or &amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/&amp;#xD;&amp;#xA;attributidettaglioasset[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y'))&amp;#xD;&amp;#xA; then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else if($ModVenditaAccesso='51')&amp;#x9;&amp;#xD;&amp;#xA;then &amp;#xD;&amp;#xA;(if(string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine&amp;#xD;&amp;#xA;[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)>0  and (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='S' or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FATTURAZIONELA&amp;quot;]/valoreAttributo)='Y')) &amp;#xD;&amp;#xA;then &amp;quot;1&amp;quot; else &amp;quot;&amp;quot;) &amp;#xD;&amp;#xA;else &amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_CONTR&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/CLLI)>0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot; upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa) > 0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ID_RIS>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                            &lt;/ID_RIS>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE' and ($COD_CAUS/tns3:COD_CAUS_DESTINATARIO='1' or $COD_CAUS/tns3:COD_CAUS_DESTINATARIO='14')&quot;>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_GEST_REC>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                                    &lt;/CODE_GEST_REC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52') and $FLAG_LA='1'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9'&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$FLAG_LA!='1' and $ModVenditaAccesso='51'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52')&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37')&quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$ModVenditaAccesso='50'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23' &quot;>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;56&amp;quot;&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TIPO_FAMIGLIA>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:TIPO_FAMIGLIA&quot;/>&#xa;                                            &lt;/TIPO_FAMIGLIA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_FAMIGLIA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:OPZ_COMM&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:TIPO_LINEA&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37') and exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY'])&quot;>&#xa;                                    &lt;FLAG_NP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_NP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;FLAG_NP>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/FLAG_NP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;SUB_TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:SUB_TIPO_LINEA&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot; (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;) and ($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='9' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='52' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='37' or $JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:COD_OFFERTA_JPUB='23')&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;&quot;>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                    &lt;MOD_VENDITA_ACCESSO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                    &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULL&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEAATTIVANP&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;50&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLLINEANONATTIVA&amp;quot; or   upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;ULLDATILINEANONATTIVA&amp;quot;  or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;SLULINEANONATTIVA&amp;quot; or upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;VULLLINEANONATTIVA&amp;quot;&quot;>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;51&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='CESSAZIONE'  and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP'&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione='VARIAZIONE' and $MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/tipologiaScenario='VDECREMENTONP'&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; &amp;#xD;&amp;#xA;or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;#xD;&amp;#xA;&amp;quot;VARIAZIONE&amp;quot; and ($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='DECREMENTOULL' or &amp;#xD;&amp;#xA;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav='DECREMENTOSLU'))&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_INIZIO_NOL>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                    &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE='6666'&quot;>&#xa;                                    &lt;CODE_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/CODE_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE)=6&quot;>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns3:REGOLATORIO/tns3:CODE_COMUNE&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_COMUNE>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/CODE_COMUNE>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;!--RICONTROLLARE MAPPING CAMPO-->&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot; upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo) > 0&quot;>&#xa;                                    &lt;CODE_ID_ULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/IDULLCo&quot;/>&#xa;                                    &lt;/CODE_ID_ULLCO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/dettaglioasset[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo = &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_ID_ULLCO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/CODE_ID_ULLCO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;) or (upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;CESSAZIONE&amp;quot; and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/statoRichiestaNOW) = &amp;quot;ANNULLATO&amp;quot;)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                            &lt;CODE_DISTR>&#xa;                                                &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                            &lt;/CODE_DISTR>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;CODE_DISTR>&#xa;                                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                            &lt;/CODE_DISTR>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;CODE_DISTR>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/CODE_DISTR>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot; and &amp;#xD;&