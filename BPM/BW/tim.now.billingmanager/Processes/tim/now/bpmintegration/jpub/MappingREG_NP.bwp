                <bpws:targets>
                    <bpws:target linkName="Log_MappingREG_NPInToRegolatorio"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapperNP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($MappingREG_NPIn/input/tns:SendJPUBRequest/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:NPTimer) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($MappingREG_NPIn.input/ns3:REGOLATORIO/ns3:TESTATA) and string-length($MappingREG_NPIn.input/tns:NPTimer) > 0]]></bpws:transitionCondition>
