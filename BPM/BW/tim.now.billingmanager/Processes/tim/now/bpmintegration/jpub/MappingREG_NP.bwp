                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMappingREG_NPOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;MappingWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MappingWLR/tns2:WLR, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&lt;tns1:CodeCausaleRequest>&lt;tns1:PID_SISTEMA>&lt;xsl:value-of select=&quot;'JPUB'&quot;/>&lt;/tns1:PID_SISTEMA>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;>&lt;tns1:PSCENARIO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;/>&lt;/tns1:PSCENARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;>&lt;tns1:PSOTTOLAVORAZ>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;/>&lt;/tns1:PSOTTOLAVORAZ>&lt;/xsl:if>&lt;tns1:ID_Rich_OLO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns1:ID_Rich_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:NPSYNCREG)>0&quot;>&lt;tns1:OFFERTA>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/tns1:OFFERTA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:OFFERTA>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/offerta&quot;/>&lt;/tns1:OFFERTA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&lt;/tns1:STRUTTURARICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE'&quot;>&lt;tns1:TIPOLOGIAMIGRAZIONE>&lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&lt;/tns1:TIPOLOGIAMIGRAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPOLOGIAMIGRAZIONE>&lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&lt;/tns1:TIPOLOGIAMIGRAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:CodeCausaleRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="COD_CAUS-input" name="COD_CAUS"
                    outputVariable="COD_CAUS"
                    tibex:xpdlId="ede7c9bc-c6e0-424a-afce-6ddfbda4506d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RegolatorioToCallProcess1_Name"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToJDBCQueryInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;COD_CAUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CodeCausaleRequest>&#xa;            &lt;tns1:PID_SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'JPUB'&quot;/>&#xa;            &lt;/tns1:PID_SISTEMA>&#xa;            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;>&#xa;                &lt;tns1:PSCENARIO>&#xa;                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/tipologiaScenario&quot;/>&#xa;                &lt;/tns1:PSCENARIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                &lt;tns1:PSOTTOLAVORAZ>&#xa;                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                &lt;/tns1:PSOTTOLAVORAZ>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:ID_Rich_OLO>&#xa;                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:ID_Rich_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns:NPSYNCREG)>0&quot;>&#xa;                    &lt;tns1:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                    &lt;/tns1:OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/offerta&quot;/>&#xa;                    &lt;/tns1:OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:STRUTTURARICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;            &lt;/tns1:STRUTTURARICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;tns1:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Asset/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns1:TIPOLOGIAMIGRAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:TIPOLOGIAMIGRAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns:BPMRequest/tns:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MIGRAZIONEINTRAOLO']/valoreAttributo)&quot;/>&#xa;                    &lt;/tns1:TIPOLOGIAMIGRAZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:CodeCausaleRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.bpmintegration.jpub.CODE_CAUSALE" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="NPSYNC" tibex:xpdlId="ce4758ad-6252-4094-9d91-c55490a514a1">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryInvokeToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapperREG1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="NPSYNCToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:NPSYNCREG)>0 or string-length($MappingREG_NPIn/input/tns:SendJPUBRequest/tns:BPMRequest/tns:NPSync)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($MappingREG_NPIn.input/tns:NPSYNCREG)>0 or string-length($MappingREG_NPIn.input/tns:BPMRequest/tns:NPSync)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:param name=&quot;JDBCQueryInvoke&quot;/>&lt;xsl:param name=&quot;COD_CAUS&quot;/>&lt;xsl:param name=&quot;COD_CONTR&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;ns:REGOLATORIO>&lt;xsl:for-each select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)]&quot;>&lt;ns:TESTATA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;../../../tns1:NPSync&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;concat($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_ORD_CRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&lt;/DATA_DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&lt;/DATA_MSG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&lt;/DATA_DES>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_DES>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_DES>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/CODE_CAUS>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                    &lt;!--verificare valorizzazione nel caso di NP Sincronizzata-->&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_PROGETTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&lt;/TIPO_CONTR>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0&quot;>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:COD_CONTR&quot;/>&lt;/CODE_CONTR>&lt;/xsl:when>&lt;xsl:when test=&quot;count($COD_CONTR/Record)>0&quot;>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$COD_CONTR/Record[1]/COD_CONTRATTO&quot;/>&lt;/CODE_CONTR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/CODE_CONTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&lt;/CODE_CLLI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_CLLI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_CLLI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_PREST_AGG>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_PREST_AGG>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&lt;ID_RIS>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/ID_RIS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS>&lt;/xsl:otherwise>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                    &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_PRINC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ID_RIS_PRINC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_GEST_REC>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/CODE_GEST_REC>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_FAMIGLIA>&lt;OPZ_COMM>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:OPZ_COMM&quot;/>&lt;/OPZ_COMM>&lt;TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/TIPO_LINEA>&lt;FLAG_NP>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_NP>&lt;SUB_TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA>&lt;SUB_TIPO_LINEA_RESIDENZIALE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA_RESIDENZIALE>&lt;SUB_TIPO_LINEA_DIREZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/SUB_TIPO_LINEA_DIREZIONE>&lt;MOD_VENDITA_ACCESSO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/MOD_VENDITA_ACCESSO>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/TIPO_AZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0 and exists(../../../tns1:DataInizioNol)&quot;>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;../../../tns1:DataInizioNol&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset)&quot;>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&lt;/DATA_INIZIO_NOL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:CODE_COMUNE='6666'&quot;>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:CODE_COMUNE)=6&quot;>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;$JDBCQueryInvoke/output/tns:JDBCQueryResponse/tns:NP/tns:CODE_COMUNE&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_COMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_COMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODE_ID_ULLCO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CODE_ID_ULLCO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&lt;CODE_DISTR>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&lt;/CODE_DISTR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DISTR>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/CODE_DISTR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_PERMUTA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA>&lt;FLAG_MIGRAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_MIGRAZIONE>&lt;FLAG_QUALIFICAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_QUALIFICAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RIS_OLD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_QUALITA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_QUALITA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_DELIVERY>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODICE_DELIVERY>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CAMPO_SERV_IT>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/CAMPO_SERV_IT>&lt;QUANTITA>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/QUANTITA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo) > 0&quot;>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&lt;/CODE_DONOR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONOR>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONOR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo) > 0&quot;>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo&quot;/>&lt;/CODE_DONATING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODE_DONATING>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/CODE_DONATING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_MANTENIMENTO_STS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_MANTENIMENTO_STS>&lt;FLAG_PERMUTA_ARMADIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_PERMUTA_ARMADIO>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns:COD_CAUS_DESTINATARIO='1'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&lt;FLAG_NP_SUCCESSIVA_PURA>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FLAG_NP_SUCCESSIVA_PURA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_NP_SUCCESSIVA_PURA>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FLAG_NP_SUCCESSIVA_PURA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;FLAG_LA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/FLAG_LA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(../referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&lt;FLAG_4REFERENTE>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAG_4REFERENTE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_4REFERENTE>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_4REFERENTE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:ACCESSO>&lt;/ns:TESTATA>&lt;/xsl:for-each>&lt;/ns:REGOLATORIO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Mapper-input" name="Mapper"
                    outputVariable="Mapper"
                    tibex:xpdlId="770eddad-be09-47fd-928f-57c85d60755e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                        <bpws:source linkName="MapperToThrow"
                            tibex:faultDetailsVar="Mapper" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JPUB_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CAUS&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_CONTR&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:REGOLATORIO>&#xa;            &lt;xsl:for-each select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY' and azione='A' and (attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo!=../../IDRisorsa)]&quot;>&#xa;                &lt;ns:TESTATA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0&quot;>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;../../../tns1:NPSync&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= &amp;quot;NUMBERPORTABILITY&amp;quot;] )&quot;>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;concat($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO,&amp;quot;-&amp;quot;, &amp;quot;1&amp;quot;)&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/DRO)&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;DATA_MSG>&#xa;                        &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lastUpdate&quot;/>&#xa;                    &lt;/DATA_MSG>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), hours-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), minutes-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/ORA_DES)))&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DATA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), month-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), day-from-date($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/DES), 00,00,00)&quot;/>&#xa;                                    &lt;/DATA_DES>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;CODE_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/CODE_CAUS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;!--verificare valorizzazione nel caso di NP Sincronizzata-->&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto) > 0&quot;>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:ACCESSO>&#xa;                        &lt;TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_CONTR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0&quot;>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:COD_CONTR&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;count($COD_CONTR/Record)>0&quot;>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;$COD_CONTR/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI) > 0&quot;>&#xa;                                &lt;CODE_CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/CLLI&quot;/>&#xa;                                &lt;/CODE_CLLI>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_CLLI>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CODE_PREST_AGG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/CODE_PREST_AGG>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                                &lt;ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                                &lt;/ID_RIS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_RIS>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;!--Controllare se l'attributo NUMEROTELEFONICO  è corretto. da specifiche è indicato NumeroTelefonicoNP-->&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo)>0&quot;>&#xa;                                &lt;ID_RIS_PRINC>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/valoreAttributo&quot;/>&#xa;                                &lt;/ID_RIS_PRINC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_RIS_PRINC>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/ID_RIS_PRINC>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CODE_GEST_REC>&#xa;                            &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/CODE_GEST_REC>&#xa;                        &lt;TIPO_FAMIGLIA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_FAMIGLIA>&#xa;                        &lt;OPZ_COMM>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:OPZ_COMM&quot;/>&#xa;                        &lt;/OPZ_COMM>&#xa;                        &lt;TIPO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_LINEA>&#xa;                        &lt;FLAG_NP>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_NP>&#xa;                        &lt;SUB_TIPO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;54&amp;quot;&quot;/>&#xa;                        &lt;/SUB_TIPO_LINEA>&#xa;                        &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                        &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                        &lt;MOD_VENDITA_ACCESSO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/MOD_VENDITA_ACCESSO>&#xa;                        &lt;TIPO_AZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                        &lt;/TIPO_AZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(../../../tns1:NPSync)>0 and exists(../../../tns1:DataInizioNol)&quot;>&#xa;                                &lt;DATA_INIZIO_NOL>&#xa;                                    &lt;xsl:value-of select=&quot;../../../tns1:DataInizioNol&quot;/>&#xa;                                &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset)&quot;>&#xa;                                &lt;DATA_INIZIO_NOL>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:string(xsd:dateTime($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Asset/DESPrimoOrdine))&quot;/>&#xa;                                &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;DATA_INIZIO_NOL>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:string(current-dateTime())&quot;/>&#xa;                                &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE='6666'&quot;>&#xa;                                &lt;CODE_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/CODE_COMUNE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE)=6&quot;>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;$JDBCQueryInvoke.output/tns:NP/tns:CODE_COMUNE&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;CODE_COMUNE>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/CODE_COMUNE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CODE_ID_ULLCO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/CODE_ID_ULLCO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto) > 0&quot;>&#xa;                                &lt;CODE_DISTR>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, xsd:string(xsd:int($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                &lt;/CODE_DISTR>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_DISTR>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/CODE_DISTR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;FLAG_PERMUTA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_PERMUTA>&#xa;                        &lt;FLAG_MIGRAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_MIGRAZIONE>&#xa;                        &lt;FLAG_QUALIFICAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_QUALIFICAZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa)>0&quot;>&#xa;                                &lt;ID_RIS_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                &lt;/ID_RIS_OLD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ID_RIS_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                                &lt;/ID_RIS_OLD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita) > 0&quot;>&#xa;                                &lt;CODICE_QUALITA>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaQualita)&quot;/>&#xa;                                &lt;/CODICE_QUALITA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_QUALITA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_QUALITA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery) > 0&quot;>&#xa;                                &lt;CODICE_DELIVERY>&#xa;                                    &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/codiceDelivery&quot;/>&#xa;                                &lt;/CODICE_DELIVERY>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODICE_DELIVERY>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODICE_DELIVERY>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CAMPO_SERV_IT>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/CAMPO_SERV_IT>&#xa;                        &lt;QUANTITA>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/QUANTITA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo) > 0&quot;>&#xa;                                &lt;CODE_DONOR>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&#xa;                                &lt;/CODE_DONOR>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_DONOR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_DONOR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo) > 0&quot;>&#xa;                                &lt;CODE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONATING']/valoreAttributo&quot;/>&#xa;                                &lt;/CODE_DONATING>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CODE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/CODE_DONATING>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;FLAG_MANTENIMENTO_STS>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_MANTENIMENTO_STS>&#xa;                        &lt;FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot; and $COD_CAUS/tns:COD_CAUS_DESTINATARIO='1'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/ordine/tipologiaSottolav)='PORTABILITASUCCESSIVA' and upper-case($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/offerta) = &amp;quot;NP&amp;quot;&quot;>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;FLAG_LA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/FLAG_LA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(../referente[tipoReferenteOrdine='REFERENTEONFIELD'])&quot;>&#xa;                                &lt;FLAG_4REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/FLAG_4REFERENTE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;FLAG_4REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/FLAG_4REFERENTE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns:ACCESSO>&#xa;                &lt;/ns:TESTATA>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;MappingREG_NPIn&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MappingREG_NPIn/input/tns1:SendJPUBRequest/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMapper-input" name="LogMapper"
                    tibex:xpdlId="f567607a-3b97-472d-a197-5e4421daf6d4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMappingREG_NPOut1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MappingREG_NPIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NPPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MappingREG_NP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/tns1:BPMRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns:REGOLATORIO/ns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$MappingREG_NPIn.input/ns1:ORDINI_CRMWS/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
