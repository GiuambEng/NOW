<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<definitions
	xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"
	xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/JPUB_ValorizzaPreventivo_internal_concrete/"
	xmlns:ns0="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns="http://schemas.xmlsoap.org/wsdl/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="PreventivoWS2"
	targetNamespace="http://www.tim.com/NOW/wsdl/concrete/JPUB_ValorizzaPreventivo_internal_concrete/">
	<types>
		<xsd:schema
			xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
			xmlns:xs="http://www.w3.org/2001/XMLSchema"
			targetNamespace="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
			elementFormDefault="unqualified" attributeFormDefault="unqualified">

			<xsd:element name="OPERESPECIALI">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="PREVENTIVO"
							type="regCRMWS:PREVENTIVO" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OPERESPECIALIResponse">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="PreventivoResponse"
							type="regCRMWS:PreventivoResponse" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:complexType name="PreventivoResponse">
				<xsd:sequence>
					<xsd:element name="ID_PREVENTIVO"
						type="regCRMWS:idPreventivo" />
					<xsd:element name="ID_RICHIESTA_NOW"
						type="regCRMWS:idRichiestaNow" />
					<xsd:element name="ID_OLO" type="regCRMWS:codeContr" />
					<xsd:element name="CODICE_ORDINE_OLO"
						type="regCRMWS:codiceOrdineOlo" />
					<xsd:element name="ID_RIS" type="regCRMWS:idRisorsa" />
					<xsd:element name="TIPO_SERVIZIO"
						type="regCRMWS:enumTipoContr" />
					<xsd:element name="TECNOLOGIA"
						type="regCRMWS:enumTipoTec" />
					<xsd:element name="DATA_DRO" type="xsd:dateTime" />
					<xsd:element name="DATA_RICHIESTA_PREVENTIVO"
						type="xsd:dateTime" />
					<xsd:element name="FLAG_PREVENTIVO"
						type="regCRMWS:enumFlagPrev" />
					<xsd:element name="DETTAGLIO" type="regCRMWS:DETTAGLIO"
						maxOccurs="unbounded" />
					<xsd:element name="DATA_INVIO_PREVENTIVO"
						type="xsd:dateTime" />
					<xsd:element name="TOTALE" type="regCRMWS:EuroTypeImp" />
					<xsd:element name="DettaglioResponse"
						type="regCRMWS:DettaglioResponse" maxOccurs="unbounded" />
					<xsd:element name="ERRORE" type="regCRMWS:ERRORE"
						maxOccurs="1" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="DettaglioResponse">
				<xsd:sequence>
					<xsd:element name="ID_VOCE" type="regCRMWS:enumIdVoce" />
					<xsd:element name="QUANTITA" type="regCRMWS:quantita" />
					<xsd:element name="DESCRIZIONE"
						type="regCRMWS:string30" />
					<xsd:element name="IMPORTO" type="regCRMWS:EuroTypeImp" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="ERRORE">
				<xsd:sequence>
					<xsd:element name="TYPE_ERROR"
						type="regCRMWS:enumTypeError" />
					<xsd:element name="CODE_ERROR" type="xsd:string" />
					<xsd:element name="DETTAGLIO" type="xsd:string" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:element name="FAULT">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="ErrorCode" type="xsd:string" />
						<xsd:element name="MSGErrore" type="xsd:string" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:simpleType name="EuroTypeImp">
				<xsd:restriction base="xsd:integer" />
			</xsd:simpleType>
			<xsd:simpleType name="string30">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="0" />
					<xsd:maxLength value="30" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="enumTypeError">
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="0" />
					<xsd:enumeration value="1" />
					<xsd:enumeration value="2" />
					<xsd:enumeration value="3" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:complexType name="PREVENTIVO">
				<xsd:sequence>
					<xsd:element name="ID_PREVENTIVO"
						type="regCRMWS:idPreventivo" />
					<xsd:element name="ID_RICHIESTA_NOW"
						type="regCRMWS:idRichiestaNow" />
					<xsd:element name="ID_OLO" type="regCRMWS:codeContr" />
					<xsd:element name="CODICE_ORDINE_OLO"
						type="regCRMWS:codiceOrdineOlo" />
					<xsd:element name="ID_RIS" type="regCRMWS:idRisorsa" />
					<xsd:element name="TIPO_SERVIZIO"
						type="regCRMWS:enumTipoContr" />
					<xsd:element name="TECNOLOGIA"
						type="regCRMWS:enumTipoTec" />
					<xsd:element name="DATA_DRO" type="xsd:dateTime" />
					<xsd:element name="DATA_RICHIESTA_PREVENTIVO"
						type="xsd:dateTime" />
					<xsd:element name="FLAG_PREVENTIVO"
						type="regCRMWS:enumFlagPrev" />
					<xsd:element name="DETTAGLIO" type="regCRMWS:DETTAGLIO"
						maxOccurs="unbounded" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="DETTAGLIO">
				<xsd:sequence>
					<xsd:element name="ID_VOCE" type="regCRMWS:enumIdVoce" />
					<xsd:element name="QUANTITA" type="regCRMWS:quantita" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:simpleType name="strNoSpace">
				<xsd:restriction base="xsd:string">
					<xsd:whiteSpace value="preserve" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="idPreventivo">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="1" />
					<xsd:maxLength value="20" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="idRichiestaNow">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="1" />
					<xsd:maxLength value="20" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="codeContr">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="1" />
					<xsd:maxLength value="6" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="codiceOrdineOlo">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="1" />
					<xsd:maxLength value="30" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="enumTipoContr">
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="7" />
					<xsd:enumeration value="9" />
					<xsd:enumeration value="17" />
					<xsd:enumeration value="23" />
					<xsd:enumeration value="37" />
					<xsd:enumeration value="41" />
					<xsd:enumeration value="42" />
					<xsd:enumeration value="44" />
					<xsd:enumeration value="47" />
					<xsd:enumeration value="48" />
					<xsd:enumeration value="50" />
					<xsd:enumeration value="51" />
					<xsd:enumeration value="52" />
					<xsd:enumeration value="54" />
					<xsd:enumeration value="55" />
					<xsd:enumeration value="56" />
					<xsd:enumeration value="60" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="enumFlagPrev">
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="0" />
					<xsd:enumeration value="1" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="enumIdVoce">
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="1" />
					<xsd:enumeration value="2" />
					<xsd:enumeration value="3" />
					<xsd:enumeration value="4" />
					<xsd:enumeration value="5" />
					<xsd:enumeration value="6" />
					<xsd:enumeration value="7" />
					<xsd:enumeration value="8" />
					<xsd:enumeration value="9" />
					<xsd:enumeration value="10" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="quantita">
				<xsd:restriction base="xsd:integer">
					<xsd:minInclusive value="0" />
					<xsd:maxInclusive value="999999" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="enumTipoTec">
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="" />
					<xsd:enumeration value="FTTH" />
					<xsd:enumeration value="FTTCAB" />
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:simpleType name="idRisorsa">
				<xsd:restriction base="regCRMWS:strNoSpace">
					<xsd:minLength value="1" />
					<xsd:maxLength value="30" />
				</xsd:restriction>
			</xsd:simpleType>

		</xsd:schema>
	</types>
	<message name="OPERESPECIALI">
		<part name="parameters" element="ns0:OPERESPECIALI" />
	</message>
	<message name="OPERESPECIALIResponse">
		<part name="parameters" element="ns0:OPERESPECIALIResponse" />
	</message>
	<message name="Fault">
		<part name="parameters" element="ns0:FAULT" />
	</message>
	<portType name="PreventivoWS">
		<operation name="calcolaPreventivo">
			<input name="OPERESPECIALI" message="ns:OPERESPECIALI" />
			<output name="OPERESPECIALIResponse"
				message="ns:OPERESPECIALIResponse" />
			<fault name="Fault" message="ns:Fault" />
		</operation>
	</portType>
	<binding name="JPUBValorizzaPreventivo_SOAPService"
		type="ns:PreventivoWS">
		<soap:binding style="document"
			transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" />
		<jms:binding messageFormat="text" />
		<operation name="calcolaPreventivo">
			<soap:operation soapAction="calcolaPreventivo"
				style="document" />
			<input>
				<soap:body parts="parameters" use="literal" />
			</input>
			<output>
				<soap:body parts="parameters" use="literal" />
			</output>
			<fault name="Fault">
				<soap:fault name="Fault" use="literal" />
			</fault>
		</operation>
	</binding>
	<service name="PreventivoWS2">
		<port name="PreventivoWS2SOAP"
			binding="ns:JPUBValorizzaPreventivo_SOAPService">
			<soap:address />
			<jms:connectionFactory>SSLQueueConnectionFactory
			</jms:connectionFactory>
			<jms:targetAddress destination="queue">tim.now.bpmintegration.externalproxy.JPUB.preventivo
			</jms:targetAddress>
		</port>
	</service>
</definitions>
