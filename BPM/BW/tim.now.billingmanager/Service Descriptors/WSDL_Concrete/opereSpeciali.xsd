<xs:schema xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<!--Modificato per kit X9 2016-->
	<xs:element name="OPERESPECIALI">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="PREVENTIVO"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="PREVENTIVO">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_PREVENTIVO" type="idPreventivo"/>
				<xs:element name="ID_RICHIESTA_NOW" type="idRichiestaNow"/>
				<xs:element name="ID_OLO" type="codeContr"/>
				<xs:element name="CODICE_ORDINE_OLO" type="codiceOrdineOlo"/>
				<xs:element name="TIPO_SERVIZIO" type="enumTipoContr"/>
				<xs:element name="DATA_DRO" type="xs:dateTime"/>
				<xs:element name="DATA_INVIO_PREVENTIVO" type="xs:dateTime"/>
				<xs:element name="DATA_RICHIESTA_PREVENTIVO" type="xs:dateTime"/>
				<xs:element name="FLAG_PREVENTIVO" type="enumFlagPrev"/>
				<xs:element name="TOTALE" type="EuroTypeImp"/>
				<xs:element ref="DETTAGLIO" maxOccurs="unbounded"/>
				<xs:element ref="ERRORE" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DETTAGLIO">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_VOCE" type="enumIdVoce"/>
				<xs:element name="DESCRIZIONE" type="string30"/>
				<xs:element name="IMPORTO" type="EuroTypeImp"/>
				<xs:element name="QUANTITA" type="quantita"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ERRORE">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TYPE_ERROR" type="enumTypeError"/>
				<xs:element name="CODE_ERROR" type="xs:string"/>
				<xs:element name="DETTAGLIO" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="strNoSpace">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="string30">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="0"/>
			<xs:maxLength value="30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idPreventivo">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idRichiestaNow">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codeContr">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codiceOrdineOlo">
		<xs:restriction base="strNoSpace">
			<xs:minLength value="1"/>
			<xs:maxLength value="30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumTipoContr">
		<xs:restriction base="strNoSpace">
			<xs:enumeration value="7"/>
			<xs:enumeration value="8"/>
			<xs:enumeration value="9"/>
			<xs:enumeration value="17"/>
			<xs:enumeration value="23"/>
			<xs:enumeration value="37"/>
			<xs:enumeration value="41"/>
			<xs:enumeration value="43"/>
			<xs:enumeration value="52"/>
			<xs:enumeration value="38"/>
			<xs:enumeration value="42"/>
			<xs:enumeration value="43"/>
			<xs:enumeration value="44"/>
			<xs:enumeration value="47"/>
			<xs:enumeration value="48"/>
			<xs:enumeration value="49"/>
			<xs:enumeration value="50"/>
			<xs:enumeration value="51"/>
			<xs:enumeration value="53"/>
			<xs:enumeration value="58"/>
			<xs:enumeration value="59"/>
			<xs:enumeration value="60"/>
			
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumFlagPrev">
		<xs:restriction base="xs:string">
			<xs:enumeration value="0"/>
			<xs:enumeration value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumIdVoce">
		<xs:restriction base="strNoSpace">
			<xs:enumeration value=""/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="8"/>
			<xs:enumeration value="9"/>
			<xs:enumeration value="10"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="quantita">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="999999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EuroTypeImp">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumTypeError">
		<xs:restriction base="strNoSpace">
			<xs:enumeration value="0"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
