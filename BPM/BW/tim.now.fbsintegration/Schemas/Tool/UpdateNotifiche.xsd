<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/UpdateNotifiche" xmlns:tns="http://www.example.org/UpdateNotifiche" elementFormDefault="qualified">

   <element name="ReinvioNotificaMigDel82Request">
    <complexType>
      <sequence>
			<element name="IdRichiestaOlo" type="string"/>
			<element name="TipologiaNotifica" type="string"/>
			<element name="TipologiaOLODestinatario" maxOccurs="1" minOccurs="0" type="string"/>
			<element name="IDTracciamento" type="string"/>
			<element name="IDNotifica" type="string" minOccurs="0"/>
      </sequence>
    </complexType>
</element>
<element name="ReinviaNotificaMigDel82Response">
    <complexType>
      <sequence>
				<element minOccurs="0" name="IdNotifica" type="int" />
                <element name="IdAnagraficaCausaleGUI" type="int" maxOccurs="1" minOccurs="0" />
                <element name="Esito" type="tns:output" />
      </sequence>
    </complexType>
</element>
<element name="ReinviaNotificaMigDel82Fault">
    <complexType>
      <sequence>
        <element maxOccurs="1" minOccurs="1" name="Codice" type="string"/>
        <element maxOccurs="1" minOccurs="0" name="Descrizione" type="string"/>
      </sequence>
    </complexType>
</element>
	<complexType name="output">
		<sequence>
			<element name="Codice" type="string"/>
			<element minOccurs="0" name="Descrizione" type="string"/>
		</sequence>
	</complexType>
</schema>