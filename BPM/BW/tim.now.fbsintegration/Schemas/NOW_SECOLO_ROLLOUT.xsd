<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" elementFormDefault="qualified">
	<element name="RequestVerificaRollout">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="CodificaOloNumerico" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="Offerta" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="Lavorazione" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="CodiceIstatComune" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="FlagReferente" type="boolean" minOccurs="0" maxOccurs="1"/>
				<element name="FlagClienteFinale" type="boolean" minOccurs="0" maxOccurs="1"/>
				<element name="CodiceOrdineOLO" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseVerificaRollout">
		<complexType>
			<sequence>
				<element name="TOKENIZZAZIONE_RECAPITI" minOccurs="0" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="SI"/>
							<enumeration value="NO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="TOKENIZZAZIONE" minOccurs="0" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="C2PLUS"/>
							<enumeration value="D420"/>
						</restriction>
					</simpleType>
				</element>
				<element name="ESITO" minOccurs="1" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="RETURN_CODE" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="operationRequest">
		<complexType>
			<sequence>
				<element name="in" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="operationResponse">
		<complexType>
			<sequence>
				<element name="out" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>
