<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ReinvioNotifica" xmlns:tns="http://www.example.org/ReinvioNotifica" elementFormDefault="qualified">

    <element name="Request">
    	<complexType>
    		<sequence>
    		<element name="Account" type="string"></element>
    			<element name="Request" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="IDTracciamento" type="string"></element>
    						<element name="TipologiaOLODestinatario" type="string"></element>
    						<element name="CodificaOLOAgicomDestinatario" type="string"></element>
    						<element name="TipologiaNotifica" type="string"></element>
    						<element name="UpdateInsert" type="string"></element>
    						<element name="IDNotifica" type="string" minOccurs="0"></element>
    							<element name="IDRichiestaOLO" type="string"
    				maxOccurs="1" minOccurs="0"></element>
    				<element name="IDentificativo" type="integer"
    				maxOccurs="1" minOccurs="0"></element>
    				
    					</sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>
    <element name="Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:esito"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="esito">
		<sequence>
		
			<element name="Esito" type="tns:output"/>
			<element name="Risposta" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="output">
		<sequence>
			<element name="Codice" type="string"/>
			<element minOccurs="0" name="Descrizione" type="string"/>
		</sequence>
	</complexType>
</schema>