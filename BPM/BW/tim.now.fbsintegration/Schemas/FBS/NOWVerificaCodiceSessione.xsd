<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:tns="http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/">
<xsd:element name="Request">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="tns:VerificaCodiceSessione"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="Response">
        <xsd:complexType>
            <xsd:sequence>
						<xsd:element name="ID_NOTIFICA" type="xsd:string"/>
						<xsd:element name="ESITO" type="xsd:string"/>
						<xsd:element name="CODICE_MOTIVAZIONE" type="xsd:string" minOccurs="0"/>
						<xsd:element name="MOTIVAZIONE" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <!-- SimpleTypes START -->
    <xsd:element name="VerificaCodiceSessione">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="CODICE_OPERATORE_RECIPIENT" type="tns:string3TYPE"/>
                <xsd:element name="CODICE_OPERATORE_WHS" type="tns:string3TYPE"/>
                <xsd:element name="CODICE_ORDINE_WHS" type="tns:string18TYPE"/>
                <xsd:element name="ID_NOTIFICA" type="tns:string255TYPE"/>
                <xsd:element name="DATA_NOTIFICA" type="tns:string255TYPE"/>
                <xsd:element name="CODICE_SESSIONE" type="tns:string50TYPE"/>
                <xsd:element name="NOTE" type="tns:string255TYPE" minOccurs="0"/>
                <xsd:element name="COR" type="tns:string12TYPE"/>
                <xsd:element name="DN1" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN2" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN3" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN4" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN5" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN6" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN7" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN8" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN9" type="tns:string12TYPE" minOccurs="0"/>
                <xsd:element name="DN10" type="tns:string12TYPE" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:simpleType name="flagYNTYPE">
    	<xsd:restriction base="xsd:string">
    		<xsd:pattern value="Y|N"/>
    	</xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="string255TYPE">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="255"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="string18TYPE">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="31"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="string3TYPE">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="3"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="string12TYPE">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="12"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="string50TYPE">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="tipoAckTYPE">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
