         &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:CODICE_MOTIVAZIONE&quot;>&#xa;                    &lt;sm:CODICE_MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:CODICE_MOTIVAZIONE&quot;/>&#xa;                    &lt;/sm:CODICE_MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:MOTIVAZIONE&quot;>&#xa;                    &lt;sm:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:MOTIVAZIONE&quot;/>&#xa;                    &lt;/sm:MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($WHS_StatusUpdateMig.in/tns:DATA_PREVISTA_ATTIVAZIONE)&quot;>&#xa;                    &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:DATA_PREVISTA_ATTIVAZIONE&quot;>&#xa;                        &lt;sm:DATA_PREVISTA_ATTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                        &lt;/sm:DATA_PREVISTA_ATTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($WHS_StatusUpdateMig.in/tns:ORARIO_APPUNTAMENTO)&quot;>&#xa;                    &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:ORARIO_APPUNTAMENTO&quot;>&#xa;                        &lt;sm:ORARIO_APPUNTAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:ORARIO_APPUNTAMENTO&quot;/>&#xa;                        &lt;/sm:ORARIO_APPUNTAMENTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:ID_BUILDING&quot;>&#xa;                    &lt;sm:ID_BUILDING>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:ID_BUILDING&quot;/>&#xa;                    &lt;/sm:ID_BUILDING>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:FLAG_DESOSPENSIONE&quot;>&#xa;                    &lt;sm:FLAG_DESOSPENSIONE>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:FLAG_DESOSPENSIONE&quot;/>&#xa;                    &lt;/sm:FLAG_DESOSPENSIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:NOTE&quot;>&#xa;                    &lt;sm:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:NOTE&quot;/>&#xa;                    &lt;/sm:NOTE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH)&quot;>&#xa;                    &lt;sm:SERVIZIO_FTTH>&#xa;                        &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:GPON_DI_ATTESTAZIONE&quot;>&#xa;                            &lt;sm:GPON_DI_ATTESTAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:GPON_DI_ATTESTAZIONE&quot;/>&#xa;                            &lt;/sm:GPON_DI_ATTESTAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:ID_SERVIZIO&quot;>&#xa;                            &lt;sm:ID_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:ID_SERVIZIO&quot;/>&#xa;                            &lt;/sm:ID_SERVIZIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:PIN_INTERVENTO_A_VUOTO&quot;>&#xa;                            &lt;sm:PIN_INTERVENTO_A_VUOTO>&#xa;                                &lt;xsl:value-of select=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:PIN_INTERVENTO_A_VUOTO&quot;/>&#xa;                            &lt;/sm:PIN_INTERVENTO_A_VUOTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZIO_FTTH/tns:VLAN&quot;>&#xa;                            &lt;sm:VLAN>&#xa;                                &lt;sm:USER_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:USER_VLAN&quot;/>&#xa;                                &lt;/sm:USER_VLAN>&#xa;                                &lt;sm:SERVICE_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:SERVICE_VLAN&quot;/>&#xa;                                &lt;/sm:SERVICE_VLAN>&#xa;                                &lt;sm:CUSTOMER_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CUSTOMER_VLAN&quot;/>&#xa;                                &lt;/sm:CUSTOMER_VLAN>&#xa;                            &lt;/sm:VLAN>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/sm:SERVIZIO_FTTH>&#xa;                &lt;/xsl:if>&#xa;                &lt;sm:SERVIZI_OPZIONALI>&#xa;                    &lt;xsl:copy-of select=&quot;$WHS_StatusUpdateMig.in/tns:SERVIZI_OPZIONALI/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$WHS_StatusUpdateMig/in/tns:WHS_StatusUpdateMig_Req/tns:SERVIZI_OPZIONALI/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$WHS_StatusUpdateMig/in/tns:WHS_StatusUpdateMig_Req/tns:SERVIZI_OPZIONALI/node()&quot;/>&#xa;                &lt;/sm:SERVIZI_OPZIONALI>&#xa;            &lt;/sm:WHS_StatusUpdateMig_Request>&#xa;        &lt;/sm:ReceiveFBSRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
