                   &lt;sm:TIPOLOGIA_APPARATO>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:TIPOLOGIA_APPARATO&quot;/>&#xa;                                &lt;/sm:TIPOLOGIA_APPARATO>&#xa;                                &lt;sm:ESITO_RITIRO_APPARATO>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:ESITO_RITIRO_APPARATO&quot;/>&#xa;                                &lt;/sm:ESITO_RITIRO_APPARATO>&#xa;                                &lt;xsl:if test=&quot;ns0:CODICE_MOTIVAZIONE_RITIRO&quot;>&#xa;                                    &lt;sm:CODICE_MOTIVAZIONE_RITIRO>&#xa;                                        &lt;xsl:value-of select=&quot;ns0:CODICE_MOTIVAZIONE_RITIRO&quot;/>&#xa;                                    &lt;/sm:CODICE_MOTIVAZIONE_RITIRO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns0:MOTIVAZIONE_RITIRO&quot;>&#xa;                                    &lt;sm:MOTIVAZIONE_RITIRO>&#xa;                                        &lt;xsl:value-of select=&quot;ns0:MOTIVAZIONE_RITIRO&quot;/>&#xa;                                    &lt;/sm:MOTIVAZIONE_RITIRO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns0:ID_APPARATO&quot;>&#xa;                                    &lt;sm:ID_APPARATO>&#xa;                                        &lt;xsl:value-of select=&quot;ns0:ID_APPARATO&quot;/>&#xa;                                    &lt;/sm:ID_APPARATO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/sm:item>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/sm:APPARATO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($OF_StatusUpdate_OpenStream.Input/ns0:request/ns0:VLAN)&quot;>&#xa;                    &lt;sm:VLAN>&#xa;                        &lt;xsl:for-each select=&quot;$OF_StatusUpdate_OpenStream.Input/ns0:request/