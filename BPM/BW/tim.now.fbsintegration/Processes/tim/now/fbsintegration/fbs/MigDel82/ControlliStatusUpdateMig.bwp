                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0320dc06-f66f-4a0d-8550-69bb500072f1+input&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AnagCow-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;cod_cow>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_REC&quot;/>&lt;/cod_cow>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select cod_cow from anag_cow where cod_cow=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_cow"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_COW"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogAnagCow-input"
                    name="LogAnagCow"
                    tibex:xpdlId="228da2da-fc1b-4c68-8861-d5d0927061f0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AnagCowToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogAnagCowToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;AnagCow&quot;/>&lt;xsl:template name=&quot;LogAnagCow-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'StatusUpdateMig'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output AnagCow : ',tib:render-xml($AnagCow))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCow&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Del82EventiIn&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:param name=&quot;BdsConf&quot;/>&lt;xsl:param name=&quot;RicalcoloDacRimodulata&quot;/>&lt;xsl:param name=&quot;DataAttiv&quot;/>&lt;xsl:param name=&quot;DataNotifica2&quot;/>&lt;xsl:param name=&quot;DataNotifica20&quot;/>&lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagCow/Record)=0&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not(substring($Start/tns1:OLO_N2Request/tns1:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns1:OLO_N2Request/tns1:CODICE_ORDINE_REC, 1, 3)=$Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_REC)&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Richiesta/Record)=0&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_WHS='FOP')&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Del82EventiIn/Record[1]/COUNT>0&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns1:OLO_N2Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns1:OLO_N2Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and not($Richiesta/Record[1]/STATORICHIESTANOW=('SOSPESOD82','SOSPESOACD82') and $BdsConf/Record[1]/COUNT=0)&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='1' and ($Richiesta/Record[1]/STATORICHIESTAOLO=('ACCETTATOKO','ACQUISITOKO','ESPLETATOKO','ESPLETATO','INVIATO','INANNULLAMENTO','ESPLETAMENTOTECNICOKO') or $Richiesta/Record[1]/STATORICHIESTANOW=('INANNULLAMENTOSUDELIVERYD82','INANNULLAMENTOACSUDELIVERYD82','INANNULLAMENTOTIMEOUTSUDELIVERYD82') or (string-length(string($RicalcoloDacRimodulata))>0 and tib:compare-dateTime(current-dateTime(), $RicalcoloDacRimodulata)>-1))&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1)>0 and string(number($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))=0&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A05_INT_7'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE, $DataNotifica2/parameters/tns0:Response/tns0:outputDate)&amp;lt;1 or tib:compare-date($DataNotifica20/parameters/tns0:Response/tns0:outputDate, $Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE)&amp;lt;1)&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($DataAttiv/parameters/tns0:Response/tns0:outputDate, $Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE)=1)&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO))=0&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A05_INT_8'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO))>0 and not(substring(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO),1,8)=('08:30:00','10:30:00','13:00:00','15:00:00'))&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_15'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns1:ESITO>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Controlli-input" name="Controlli"
                    outputVariable="Controlli"
                    tibex:xpdlId="3d3a6836-2cba-4e5c-9f3b-3487bc37a6d9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToControlli"/>
                        <bpws:target linkName="GenericLoggerToControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlliToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DataAttiv.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DataNotifica2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DataNotifica20.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagCow&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Del82EventiIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ParametroOre&quot;/>&#xa;    &lt;xsl:param name=&quot;BdsConf&quot;/>&#xa;    &lt;xsl:param name=&quot;RicalcoloDacRimodulata&quot;/>&#xa;    &lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($AnagCow/Record)=0&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(substring($Start/tns1:OLO_N2Request/tns1:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns1:OLO_N2Request/tns1:CODICE_ORDINE_REC, 1, 3)=$Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_REC)&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($Richiesta/Record)=0&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not($Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_WHS='FOP')&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Del82EventiIn/Record[1]/COUNT>0&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns1:OLO_N2Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns1:OLO_N2Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and not($Richiesta/Record[1]/STATORICHIESTANOW=('SOSPESOD82','SOSPESOACD82') and $BdsConf/Record[1]/COUNT=0)&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='1' and ($Richiesta/Record[1]/STATORICHIESTAOLO=('ACCETTATOKO','ACQUISITOKO','ESPLETATOKO','ESPLETATO','INVIATO','INANNULLAMENTO','ESPLETAMENTOTECNICOKO') or $Richiesta/Record[1]/STATORICHIESTANOW=('INANNULLAMENTOSUDELIVERYD82','INANNULLAMENTOACSUDELIVERYD82','INANNULLAMENTOTIMEOUTSUDELIVERYD82') or (string-length(string($RicalcoloDacRimodulata))>0 and tib:compare-dateTime(current-dateTime(), $RicalcoloDacRimodulata)>-1))&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1)>0 and string(number($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns1:OLO_N2Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))=0&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A05_INT_7'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE, $DataNotifica2.parameters/tns0:outputDate)&amp;lt;1 or tib:compare-date($DataNotifica20.parameters/tns0:outputDate, $Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE)&amp;lt;1)&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($DataAttiv.parameters/tns0:outputDate, $Start/tns1:OLO_N2Request/tns1:DATA_PREVISTA_ATTIVAZIONE)=1)&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO))=0&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A05_INT_8'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:OLO_N2Request/tns1:AZIONE='0' and string-length(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO))>0 and not(substring(string($Start/tns1:OLO_N2Request/tns1:ORARIO_APPUNTAMENTO),1,8)=('08:30:00','10:30:00','13:00:00','15:00:00'))&quot;>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_15'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Rec_StatusUpdateMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                &lt;/tns1:Rec_StatusUpdateMig_Resp>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecipientMigrationServiceSchema.xsd="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecipientMigrationServiceSchema.xsd:Rec_StatusUpdateMig_Resp" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Richiesta-input"
                    name="Richiesta" outputVariable="Richiesta"
                    tibex:xpdlId="c6aa3438-d2a0-4938-aa19-951d6cb53a55" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAnagCowToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RichiestaToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c6aa3438-d2a0-4938-aa19-951d6cb53a55+input&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:CODICE_ORDINE_REC&quot;/>&lt;/CODICEORDINEOLO>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N2Request/tns1:CODICE_OPERATORE_REC&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select r.IDRICHIESTAOLO, r.STATORICHIESTANOW, r.STATORICHIESTAOLO, r.IDANAGRAFICACAUSALE, o.DACRIMODULATA from BDS_1_CASEDATA_RICHIESTA r, BDS_1_CASEDATA_ORDINE o where r.IDRICHIESTAOLO = o.IDRICHIESTAOLO and r.LAVORAZIONE='MIGRAZIONE' and r.TIPOLOGIASOTTOLAV='MIGRAZIONEDEL82' and r.CODICEORDINEOLO=? and r.CODIFICAOLOAGCOM=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINEOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="IDANAGRAFICACAUSALE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DACRIMODULATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRichiesta-input"
                    name="LogRichiesta"
                    tibex:xpdlId="bed1ed98-12ac-4a7a-8999-5b297c46d721"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RichiestaToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRichiestaToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'StatusUpdateMig'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output Richiesta : ',tib:render-xml($Richiesta))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Del82EventiIn-input"
                    name="Del82EventiIn" outputVariable="Del82EventiIn"
                    tibex:xpdlId="a0605c05-760f-4924-a621-d888b21916bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Del82EventiInToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
