            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="195ed2bd-f770-409e-bd6a-798a23868a68" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogControlliToEnd"/>
                        <bpws:target linkName="LogAnagCausaleToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AnagCausale&quot;/>&lt;xsl:param name=&quot;Controlli&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Rec_StatusUpdateMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Controlli/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;$Controlli/tns1:ESITO&quot;/>&lt;/tns1:ESITO>&lt;xsl:if test=&quot;$Controlli/tns1:ESITO='1'&quot;>&lt;xsl:if test=&quot;$AnagCausale/Record[1]/COD_CAUS_OLO&quot;>&lt;tns1:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCausale/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns1:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Controlli/tns1:ESITO='1'&quot;>&lt;xsl:if test=&quot;$AnagCausale/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCausale/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns1:Rec_StatusUpdateMig_Resp>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
