                    <bpws:targets>
                        <bpws:target linkName="ParseXmlRichiestaToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ToolGenNotfUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlRichiesta&quot;/>&lt;xsl:param name=&quot;JDBCQueryTracciamento&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:ToolGenNotfRecuperoTracciatoOutput>&lt;xsl:copy-of select=&quot;$ParseXmlRichiesta&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($JDBCQueryTracciamento/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)) > 0&quot;>&lt;tns1:IDEventoOrdineNOW>&lt;xsl:value-of select=&quot;xsd:int($JDBCQueryTracciamento/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&lt;/tns1:IDEventoOrdineNOW>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns1:ToolGenNotfRecuperoTracciatoOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
