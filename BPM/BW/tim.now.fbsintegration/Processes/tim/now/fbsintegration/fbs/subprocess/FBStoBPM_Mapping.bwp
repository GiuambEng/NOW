                <bpws:link name="LogInputToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapComponentiToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="OscuramentoToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToMapComponenti" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckFlagIUToCheckAggiuntiviApparati" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckAggiuntiviApparatiToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CountAggiuntiviToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapApparatiToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapApparati2ToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogApparatiToMapComponenti" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
