                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20250731122921PLT&quot; xmlns:tns1=&quot;http://www.example.org/ReinvioNotifica&quot; xmlns:tns4=&quot;http://xmlns.example.com/ToolNotifiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;PPS_GENERA_NOTIFICHE_DEL82&quot;/>&#xa;    &lt;xsl:param name=&quot;RigeneraReinvioNotifica&quot;/>&#xa;    &lt;xsl:param name=&quot;RigeneraReinvioNotificaRientri&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($PPS_GENERA_NOTIFICHE_DEL82/Record)>0&quot;>&#xa;                &lt;tns1:Response>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RigeneraReinvioNotifica/tns1:Esito) and exists($RigeneraReinvioNotificaRientri/tns1:Esito)&quot;>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;xsl:copy-of select=&quot;$RigeneraReinvioNotifica/tns1:Esito/tns1:Esito&quot;/>&#xa;                                &lt;tns1:Risposta>&#xa;                                    &lt;xsl:value-of select=&quot;concat('RigeneraReinvioNotifica:', $RigeneraReinvioNotifica/tns1:Esito/tns1:Risposta,'|          |','RigeneraReinvioNotificaRientri:',  $RigeneraReinvioNotificaRientri/tns1:Esito/tns1:Risposta)&quot;/>&#xa;                                &lt;/tns1:Risposta>&#xa;                            &lt;/tns1:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($RigeneraReinvioNotifica/tns1:Esito)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$RigeneraReinvioNotifica/tns1:Esito&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:copy-of select=&quot;$RigeneraReinvioNotificaRientri/tns1:Esito&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Response>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Esito>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                        &lt;/tns1:Esito>&#xa;                        &lt;tns1:Risposta>&#xa;                            &lt;xsl:value-of select=&quot;concat('Record non trovati su PPS_GENERA_NOTIFICHE_DEL82 per Account: ',$get.parameters/tns4:account)&quot;/>&#xa;                        &lt;/tns1:Risposta>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/tns1:Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20250731122921PLT" xmlns:tns1="http://www.example.org/ReinvioNotifica" xmlns:tns4="http://xmlns.example.com/ToolNotifiche/parameters" version="2.0"&gt;
    &lt;xsl:param name="get"/&gt;
