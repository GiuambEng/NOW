                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ACCOUNT"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDENTIFICATIVO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
