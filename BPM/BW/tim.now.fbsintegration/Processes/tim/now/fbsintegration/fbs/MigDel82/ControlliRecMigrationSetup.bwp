            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Controlli-input"
                    name="Controlli" outputVariable="Controlli"
                    tibex:xpdlId="1ca3bb35-07cf-4b39-8e19-9f5af8a773fd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogPrgtToControlli"/>
                        <bpws:target linkName="GenericLoggerToControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlliToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCow&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:param name=&quot;CheckDN&quot;/>&lt;xsl:param name=&quot;Prgt&quot;/>&lt;xsl:param name=&quot;Del82EventiI&quot;/>&lt;xsl:param name=&quot;ClusterAccesso&quot;/>&lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagCow/Record[COD_COW=$Start/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC])=0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not(substring($Start/tns:OLO_N1Request/tns:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns:OLO_N1Request/tns:CODICE_ORDINE_REC, 1, 3)=$Start/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC)&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Richiesta/Record[1]/COUNT>0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A08_INT_1'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns:OLO_N1Request/tns:CODICE_OPERATORE_WHS='FOP')&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Del82EventiI/Record[1]/COUNT>0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns:OLO_N1Request/tns:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns:OLO_N1Request/tns:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns:OLO_N1Request/tns:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH)>0 and string(number($Start/tns:OLO_N1Request/tns:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH))='NaN'&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_6'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string(number($Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($AnagCow/Record[COD_COW=$Start/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COW])=0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_9'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COS=('012','015','019','020','022','023','018','021'))&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_10'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckDN='NaN'&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_11'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Prgt/Record[1]/COUNT=0 and string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_PROGETTO_SPECIALE)>0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_12'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($AnagCow/Record[COD_COW=$Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO])=0 and string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO)>0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_13'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:FULL_GPON_PLUS='SI'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(exists($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH) and string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:FLAG_S)=0) or exists($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH)&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:ESITO>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_14'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;not(substring(string($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:ORARIO_APPUNTAMENTO),1,8)=('08:30:00','10:30:00','13:00:00','15:00:00')) and string-length(string($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:ORARIO_APPUNTAMENTO))>0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_15'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:NUMERO_TELEFONICO_PRINCIPALE_LINEA)>0 and string(number($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:NUMERO_TELEFONICO_PRINCIPALE_LINEA))='NaN'&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_16'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:SLA_PREMIUM_ASSURANCE)>0 and not($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:SLA_PREMIUM_ASSURANCE=('D','E','F','G'))) or (string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE)>0 and not($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE=('D','E','F','G'))) or (string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE)>0 and not($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE=('D','E','F','G')))&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'B05_INT_1'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO)>0 and count($ClusterAccesso/Record)=0&quot;>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:ESITO>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_22'&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Rec_MigrationSetup_Resp>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:DATA_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:ESITO>&lt;/tns:Rec_MigrationSetup_Resp>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
