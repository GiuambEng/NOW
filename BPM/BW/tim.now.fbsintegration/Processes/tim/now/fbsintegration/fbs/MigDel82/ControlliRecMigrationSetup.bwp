                        <bpws:source linkName="ClusterAccessoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+05dacc98-92a3-4668-a5fd-5d6ecd48d6d6+input&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ClusterAccesso-input&quot; match=&quot;/&quot;>&lt;tns7:jdbcQueryActivityInput>&lt;CLUSTER_ACCESSO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CLUSTER_ACCESSO>&lt;/tns7:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select CLUSTER_ACCESSO &#xa;from CLUSTER_ACCESSO &#xa;where CLUSTER_ACCESSO=? and SYSDATE BETWEEN DATA_INIZIO_VALIDITA AND DATA_FINE_VALIDITA" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CLUSTER_ACCESSO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CLUSTER_ACCESSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCluster-input"
                    name="LogCluster"
                    tibex:xpdlId="7435dce5-3c91-4930-a789-b8702cbf7b40"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ClusterAccessoToGenericLogger"/>
