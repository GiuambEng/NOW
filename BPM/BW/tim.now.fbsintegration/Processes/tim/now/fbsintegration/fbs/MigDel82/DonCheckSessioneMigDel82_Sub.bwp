                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/DonatingMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Dro.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Olo&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'B2B'&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;'RISCONTROCODICESESSIONE'&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'ALTRO'&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Header/tns:sourceSystem&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineTITarget>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:OLO_N9Request/tns:CODICE_ORDINE_WHS&quot;/>&#xa;            &lt;/codiceOrdineTITarget>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;$Dro.parameters/tns0:outputDate&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;$Start/tns:Header/tns:sourceSystem&quot;>&#xa;                &lt;codificaOLOAGCOMRic>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Header/tns:sourceSystem&quot;/>&#xa;                &lt;/codificaOLOAGCOMRic>&#xa;            &lt;/xsl:if>&#xa;            &lt;esito>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:OLO_N9Request/tns:ESITO&quot;/>&#xa;            &lt;/esito>&#xa;            &lt;xsl:if test=&quot;$Start/tns:OLO_N9Request/tns:CODICE_MOTIVAZIONE&quot;>&#xa;                &lt;codiceRifiutoDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:OLO_N9Request/tns:CODICE_MOTIVAZIONE&quot;/>&#xa;                &lt;/codiceRifiutoDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;flagMigDel82>&#xa;                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;            &lt;/flagMigDel82>&#xa;        &lt;/tns1:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
