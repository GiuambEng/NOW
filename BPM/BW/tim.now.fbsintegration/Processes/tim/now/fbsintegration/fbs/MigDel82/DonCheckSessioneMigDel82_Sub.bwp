            <bpws:invoke inputVariable="Dro-input" name="Dro"
                operation="calcNextDateByDuration" outputVariable="Dro"
                partnerLink="GetNextDatePortType"
                portType="ns11:GetNextDatePortType" tibex:xpdlId="dc3b8495-c631-449d-92c6-2347784e7de6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns11="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns0="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="OraCorrente"/&gt;
    &lt;xsl:template name="Dro-input" match="/"&gt;
        &lt;tns11:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns0:Request&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="xsd:int($OraCorrente)&gt;18"&gt;
                            &lt;tns0:inputDate&gt;
                                &lt;xsl:value-of select="tib:add-to-date(current-date(), 0, 0, 1)"/&gt;
                            &lt;/tns0:inputDate&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns0:inputDate&gt;
                                &lt;xsl:value-of select="current-date()"/&gt;
                            &lt;/tns0:inputDate&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns0:inputDuration&gt;
                        &lt;xsl:value-of select="'PT9H'"/&gt;
                    &lt;/tns0:inputDuration&gt;
                &lt;/tns0:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns11:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OraCorrente&quot;/>&#xa;    &lt;xsl:template name=&quot;Dro-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;xsd:int($OraCorrente)>18&quot;>&#xa;                    &lt;tns0:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:add-to-date(current-date(), 0, 0, 1)&quot;/>&#xa;                    &lt;/tns0:inputDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns0:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                    &lt;/tns0:inputDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns0:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns0:inputDuration>&#xa;        &lt;/tns0:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
