            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ProcessManagementSubProcess-input"
                    name="ProcessManagementSubProcess"
                    outputVariable="ProcessManagementSubProcess"
                    tibex:xpdlId="722972a2-696b-4577-9cb6-f5eddaebcf03"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToProcessManagementSubProcess"/>
