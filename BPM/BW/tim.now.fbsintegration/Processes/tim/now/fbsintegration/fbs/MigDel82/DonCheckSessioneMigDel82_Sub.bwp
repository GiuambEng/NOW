                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&lt;tns7:Element>&lt;tns7:moduleName>&lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&lt;/tns7:moduleName>&lt;tns7:parameterName>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/tns7:parameterName>&lt;tns7:operationName>&lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&lt;/tns7:operationName>&lt;tns7:processName>&lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&lt;/tns7:processName>&lt;tns7:value>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns7:value>&lt;tns7:ID_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns7:ID_FILE>&lt;tns7:ContenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($Start)&quot;/>&lt;/tns7:ContenutoXML>&lt;tns7:CodificaOLOAgicom>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns7:CodificaOLOAgicom>&lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&lt;tns7:Ambito>&lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&lt;/tns7:Ambito>&lt;/xsl:if>&lt;tns7:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&lt;/tns7:StrutturaRichiesta>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&lt;tns7:Code_OLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&lt;/tns7:Code_OLO>&lt;/xsl:if>&lt;tns7:Parametro>&lt;xsl:value-of select=&quot;'NGAB2B'&quot;/>&lt;/tns7:Parametro>&lt;/tns7:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdStag-input" name="UpdStag"
                operation="InsertUpdateStaging" outputVariable="UpdStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns2:InsertUpdateStagingPortType" tibex:xpdlId="a5efa201-1978-42ad-adfb-89577b040e89">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd" xmlns:tns="http://wholesalesoperator/Schemas/DonatingMigrationServiceSchema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="ControlliDonCheckSessioneMigDel82"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns4:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($ControlliDonCheckSessioneMigDel82)"/&gt;&lt;/tns5:CONTENUTO_RESPONSE&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="190"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$ControlliDonCheckSessioneMigDel82/tns:MOTIVAZIONE"&gt;&lt;tns5:MOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliDonCheckSessioneMigDel82/tns:MOTIVAZIONE"/&gt;&lt;/tns5:MOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ControlliDonCheckSessioneMigDel82/tns:CODICE_MOTIVAZIONE"&gt;&lt;tns5:CODICEMOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliDonCheckSessioneMigDel82/tns:CODICE_MOTIVAZIONE"/&gt;&lt;/tns5:CODICEMOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns5:ESITO&gt;&lt;xsl:value-of select="$ControlliDonCheckSessioneMigDel82/tns:ESITO"/&gt;&lt;/tns5:ESITO&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="190"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns4:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/DonatingMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliDonCheckSessioneMigDel82&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ControlliDonCheckSessioneMigDel82)&quot;/>&#xa;                &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;190&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$ControlliDonCheckSessioneMigDel82/tns:MOTIVAZIONE&quot;>&#xa;                    &lt;tns5:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliDonCheckSessioneMigDel82/tns:MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ControlliDonCheckSessioneMigDel82/tns:CODICE_MOTIVAZIONE