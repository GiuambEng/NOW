                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;IdRichOrdn&quot;/>&lt;xsl:param name=&quot;EventoOf&quot;/>&lt;xsl:template name=&quot;LogId-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'InviaNotificaRientriDel82'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('TransactionId: ',$TransactionId,' IdNotifica: ',string($IdNotifica/Record[1]/NEXTVAL),' IdRichOrdn: ',string($IdRichOrdn/Record[1]/NEXTVAL))&quot;/>&lt;/tns2:Message>&lt;tns2:Payload>&lt;xsl:value-of select=&quot;concat('DataNotifica: ',string($EventoOf/Record[1]/DATA_NOTIFICA))&quot;/>&lt;/tns2:Payload>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="CheckNotifica" tibex:xpdlId="c23e4104-cbf7-4643-8ceb-15b285f692b8">
                <bpws:targets>
                    <bpws:target linkName="LogIdToEmpty"/>
                    <bpws:target linkName="GenericLoggerToCheckNotifica"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckNotificaToNotificaN4">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica=('KO','AQ','SP','KC','AC','AN','RR','RA','FS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('KO','AQ','SP','KC','AC','AN','RR','RA','FS')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToNotificaN5">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica='RD'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='RD']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToNotificaN6">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica='PC'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='PC']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToNotificaN7">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica=('OK','KD')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('OK','KD')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="AnagCaus-input"
                    name="AnagCaus" outputVariable="AnagCaus"
                    tibex:xpdlId="22606d33-e2cc-44f7-8121-fc677d44d682" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogIdToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AnagCausToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+22606d33-e2cc-44f7-8121-fc677d44d682+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AnagCaus-input&quot; match=&quot;/&quot;>&lt;tns4:jdbcQueryActivityInput>&lt;ID_ANAG_CAUS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:IdAnagraficaCausale)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:IdAnagraficaCausale&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ANAG_CAUS>&lt;/tns4:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_CAUS_OLO, DESCR_CAUS_OLO&#xa;  FROM ANAG_CAUS&#xa;  WHERE ID_ANAG_CAUS = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAG_CAUS"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogAnag-input"
                    name="LogAnag"
                    tibex:xpdlId="ac1b125a-342c-4d1c-b2a5-831b6c27a1f3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AnagCausToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToCheckNotifica"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:template name=&quot;LogAnag-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'InviaNotificaRientriDel82'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output AnagCaus ', tib:render-xml($AnagCaus))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="NotificaN4-input" name="NotificaN4"
                    outputVariable="NotificaN4"
                    tibex:xpdlId="4204f0d2-4ca2-42c4-af06-16ec29a300d2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckNotificaToNotificaN4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NotificaN4ToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:param name=&quot;EventoOf&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;NotificaN4-input&quot; match=&quot;/&quot;>&lt;tns5:WHS_StatusUpdateMig_Req>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if ($Start/tns:TipologiaNotifica='KO') then '1' else if ($Start/tns:TipologiaNotifica='AQ') then '0' else if ($Start/tns:TipologiaNotifica='AC') then '2' else if ($Start/tns:TipologiaNotifica='KC') then '3' else if ($Start/tns:TipologiaNotifica='SP') then '4' else if ($Start/tns:TipologiaNotifica='AN') then '5' else if ($Start/tns:TipologiaNotifica='RR') then '6' else if ($Start/tns:TipologiaNotifica='FS' and $ParseXml/statoRichiestaOF='ACQUISITOOK') then '0' else if ($Start/tns:TipologiaNotifica='FS' and $ParseXml/statoRichiestaOF='ACCETTATOOK') then '2' else '7'&quot;/>&lt;tns5:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns5:CODICE_OPERATORE_REC>&lt;tns5:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/tns5:CODICE_ORDINE_REC>&lt;tns5:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns5:CODICE_OPERATORE_WHS>&lt;tns5:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/tns5:CODICE_ORDINE_WHS>&lt;tns5:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&lt;/tns5:ID_NOTIFICA>&lt;tns5:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:DATA_NOTIFICA>&lt;tns5:STATO_ORDINE>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns5:STATO_ORDINE>&lt;xsl:if test=&quot;$StatoOrdine=('1','3','4','5','6','7')&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;>&lt;tns5:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine=('1','3','4','5','6','7')&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns5:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns5:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='DATAPREVISTAATTIVAZIONE']/valoreAttributo)&quot;>&lt;tns5:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;xsd:date($ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='DATAPREVISTAATTIVAZIONE']/valoreAttributo)&quot;/>&lt;/tns5:DATA_PREVISTA_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='ORARIOAPPUNTAMENTO']/valoreAttributo)&quot;>&lt;tns5:ORARIO_APPUNTAMENTO>&lt;xsl:value-of select=&quot;xsd:time($ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='ORARIOAPPUNTAMENTO']/valoreAttributo)&quot;/>&lt;/tns5:ORARIO_APPUNTAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='IDBUILDING']/valoreAttributo&quot;>&lt;tns5:ID_BUILDING>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='IDBUILDING']/valoreAttributo&quot;/>&lt;/tns5:ID_BUILDING>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine=('0','2')&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='FLAGDESOSPENSIONE']/valoreAttributo&quot;>&lt;tns5:FLAG_DESOSPENSIONE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFSOSPDESOSP']/attributiDettaglioOrdine[nomeAttributo='FLAGDESOSPENSIONE']/valoreAttributo&quot;/>&lt;/tns5:FLAG_DESOSPENSIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/noteFiberStream&quot;>&lt;tns5:NOTE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/noteFiberStream&quot;/>&lt;/tns5:NOTE>&lt;/xsl:if>&lt;tns5:SERVIZIO_FTTH>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='GPONDIATTESTAZIONE']/valoreAttributo&quot;>&lt;tns5:GPON_DI_ATTESTAZIONE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='GPONDIATTESTAZIONE']/valoreAttributo&quot;/>&lt;/tns5:GPON_DI_ATTESTAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;>&lt;tns5:ID_SERVIZIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='IDSERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:ID_SERVIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='PININTERVENTOAVUOTO']/valoreAttributo&quot;>&lt;tns5:PIN_INTERVENTO_A_VUOTO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFDATITECNICI']/attributiDettaglioOrdine[nomeAttributo='PININTERVENTOAVUOTO']/valoreAttributo&quot;/>&lt;/tns5:PIN_INTERVENTO_A_VUOTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/flagIU&quot;>&lt;tns5:FLAG_IU>&lt;xsl:value-of select=&quot;$ParseXml/ordine/flagIU&quot;/>&lt;/tns5:FLAG_IU>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='FEA_54471'])=0&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/codiceOrdineOpenFiber&quot;>&lt;tns5:IDENTIFICATIVO_ORDINE_FORNITORE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns5:IDENTIFICATIVO_ORDINE_FORNITORE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ParseXml/ordine/codiceOrdineOF&quot;>&lt;tns5:IDENTIFICATIVO_ORDINE_FORNITORE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/codiceOrdineOF&quot;/>&lt;/tns5:IDENTIFICATIVO_ORDINE_FORNITORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$EventoOf/Record[1]/DATA_NOTIFICA&quot;>&lt;tns5:TIMESTAMP_ORIGINE>&lt;xsl:value-of select=&quot;$EventoOf/Record[1]/DATA_NOTIFICA&quot;/>&lt;/tns5:TIMESTAMP_ORIGINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;>&lt;tns5:IP_ADDRESS_NET>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;/>&lt;/tns5:IP_ADDRESS_NET>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;>&lt;tns5:SUBNET_MASK_NET>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;/>&lt;/tns5:SUBNET_MASK_NET>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine='2'&quot;>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFVLAN']&quot;>&lt;tns5:VLAN>&lt;tns5:USER_VLAN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo&quot;/>&lt;/tns5:USER_VLAN>&lt;tns5:SERVICE_VLAN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='SERVICEVLAN']/valoreAttributo&quot;/>&lt;/tns5:SERVICE_VLAN>&lt;tns5:CUSTOMER_VLAN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CUSTOMERVLAN']/valoreAttributo&quot;/>&lt;/tns5:CUSTOMER_VLAN>&lt;/tns5:VLAN>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns5:SERVIZIO_FTTH>&lt;/tns5:WHS_StatusUpdateMig_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecipientMigrationNotify_OLOSchema_Fiberstream.xsd="http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecipientMigrationNotify_OLOSchema_Fiberstream.xsd:WHS_StatusUpdateMig_Req" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
