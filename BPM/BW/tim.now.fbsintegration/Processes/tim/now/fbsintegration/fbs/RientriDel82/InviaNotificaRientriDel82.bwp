            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdRichOrdn-input" name="UpdRichOrdn"
                    outputVariable="UpdRichOrdn"
                    tibex:xpdlId="18a40eba-19f4-4aeb-9569-11384857ac41" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdStagToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdRichOrdnToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ParseXml/statoRichiestaOLO = ('SCARTATO','SOSPESO','SOSPESOCONNOTIFICAFS','ESPLETAMENTOTECNICOKO','ANNULLATO','ACQUISITOKO','ACCETTATOKO','ESPLETATOKO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ParseXml/statoRichiestaOLO = ('SCARTATO','SOSPESO','SOSPESOCONNOTIFICAFS','ESPLETAMENTOTECNICOKO','ANNULLATO','ACQUISITOKO','ACCETTATOKO','ESPLETATOKO')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdRichOrdnToIdAnagCausGUI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+18a40eba-19f4-4aeb-9569-11384857ac41+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichOrdn&quot;/>&lt;xsl:template name=&quot;UpdRichOrdn-input&quot; match=&quot;/&quot;>&lt;tns12:jdbcUpdateActivityInput>&lt;ID_TIPOL_STATO_NOTIFICA>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ID_TIPOL_STATO_NOTIFICA>&lt;ID_RICHORDN_COMNOTFDEL82>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdRichOrdn/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICHORDN_COMNOTFDEL82>&lt;/tns12:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RICH_ORDN_COMUNIC_NOTF_DEL82 SET TIMESTAMP_AGG=SYSDATE, ID_TIPOL_STATO_NOTIFICA=? WHERE ID_RICHORDN_COMNOTFDEL82=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOL_STATO_NOTIFICA"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHORDN_COMNOTFDEL82"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
