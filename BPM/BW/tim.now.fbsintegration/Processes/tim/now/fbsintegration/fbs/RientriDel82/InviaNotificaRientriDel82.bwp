                    <bpws:sources>
                        <bpws:source linkName="NotificaN7ToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:param name=&quot;EventoOf&quot;/>&lt;xsl:template name=&quot;NotificaN7-input&quot; match=&quot;/&quot;>&lt;tns5:WHS_CompletionOrderMig_Req>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if ($Start/tns:TipologiaNotifica='OK') then '0' else '1'&quot;/>&lt;tns5:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns5:CODICE_OPERATORE_REC>&lt;tns5:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/tns5:CODICE_ORDINE_REC>&lt;tns5:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns5:CODICE_OPERATORE_WHS>&lt;tns5:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/tns5:CODICE_ORDINE_WHS>&lt;tns5:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&lt;/tns5:ID_NOTIFICA>&lt;tns5:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:DATA_NOTIFICA>&lt;tns5:STATO_ORDINE>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns5:STATO_ORDINE>&lt;xsl:if test=&quot;$StatoOrdine='1'&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;>&lt;tns5:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine='1'&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns5:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns5:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='COR']/valoreAttributo&quot;>&lt;tns5:COR>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='COR']/valoreAttributo&quot;/>&lt;/tns5:COR>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='COS']/valoreAttributo&quot;>&lt;tns5:COS>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='COS']/valoreAttributo&quot;/>&lt;/tns5:COS>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='DATAESPLETAMENTOORDINE']/valoreAttributo)>0&quot;>&lt;tns5:DATA_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;xsd:date($ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='DATAESPLETAMENTOORDINE']/valoreAttributo)&quot;/>&lt;/tns5:DATA_ESPLETAMENTO_ORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:DATA_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/DES&quot;/>&lt;/tns5:DATA_ESPLETAMENTO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='ORARIOESPLETAMENTOORDINE']/valoreAttributo)&quot;>&lt;tns5:ORARIO_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;xsd:time($ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='ORARIOESPLETAMENTOORDINE']/valoreAttributo)&quot;/>&lt;/tns5:ORARIO_ESPLETAMENTO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXml/ordine/ORA_DES)&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/ORA_DES&quot;>&lt;tns5:ORARIO_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/ORA_DES&quot;/>&lt;/tns5:ORARIO_ESPLETAMENTO_ORDINE>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseXml/note&quot;>&lt;tns5:NOTE>&lt;xsl:value-of select=&quot;$ParseXml/note&quot;/>&lt;/tns5:NOTE>&lt;/xsl:if>&lt;tns5:SERVIZIO_FTTH>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='DDT']/valoreAttributo&quot;>&lt;tns5:DDT>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='DDT']/valoreAttributo&quot;/>&lt;/tns5:DDT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='PARAMETRITRASMISSIVIOTTICI']/valoreAttributo&quot;>&lt;tns5:PARAMETRI_TRASMISSIVI_OTTICI>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='PARAMETRITRASMISSIVIOTTICI']/valoreAttributo&quot;/>&lt;/tns5:PARAMETRI_TRASMISSIVI_OTTICI>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='IDSPLITTERSECONDARIO']/valoreAttributo&quot;>&lt;tns5:ID_SPLITTER_SECONDARIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='IDSPLITTERSECONDARIO']/valoreAttributo&quot;/>&lt;/tns5:ID_SPLITTER_SECONDARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='POSIZIONESPLITTERSECONDARIO']/valoreAttributo&quot;>&lt;tns5:POSIZIONE_SPLITTER_SECONDARIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='OFESPLETAMENTO']/attributiDettaglioOrdine[nomeAttributo='POSIZIONESPLITTERSECONDARIO']/valoreAttributo&quot;/>&lt;/tns5:POSIZIONE_SPLITTER_SECONDARIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$EventoOf/Record[1]/DATA_NOTIFICA&quot;>&lt;tns5:TIMESTAMP_ORIGINE>&lt;xsl:value-of select=&quot;$EventoOf/Record[1]/DATA_NOTIFICA&quot;/>&lt;/tns5:TIMESTAMP_ORIGINE>&lt;/xsl:if>&lt;tns5:ID_RISORSA>&lt;xsl:value-of select=&quot;$ParseXml/IDRisorsa&quot;/>&lt;/tns5:ID_RISORSA>&lt;/tns5:SERVIZIO_FTTH>&lt;xsl:if test=&quot;$StatoOrdine='0'&quot;>&lt;tns5:SERVIZI_OPZIONALI>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='SERVIZIOAGGIUNTIVO' and attributiDettaglioOrdine[nomeAttributo='AMBITO']/valoreAttributo='DTU' and string-length(attributiDettaglioOrdine[nomeAttributo='ESITO']/valoreAttributo)>0]&quot;>&lt;tns5:SERVIZIO_AGGIUNTIVO>&lt;xsl:variable name=&quot;iddettord&quot; select=&quot;IDDettaglioOrdine&quot;/>&lt;tns5:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOMESERVIZIO']/valoreAttributo&quot;/>&lt;/tns5:NOME_SERVIZIO>&lt;tns5:ESITO_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITO']/valoreAttributo&quot;/>&lt;/tns5:ESITO_SERVIZIO>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALEESITO']/valoreAttributo&quot;>&lt;tns5:CODICE_MOTIVAZIONE_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALEESITO']/valoreAttributo&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE_SERVIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITO']/valoreAttributo&quot;>&lt;tns5:MOTIVAZIONE_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITO']/valoreAttributo&quot;/>&lt;/tns5:MOTIVAZIONE_SERVIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESTENSIONEIMPIANTO']/valoreAttributo&quot;>&lt;tns5:ESTENSIONE_IMPIANTO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESTENSIONEIMPIANTO']/valoreAttributo&quot;/>&lt;/tns5:ESTENSIONE_IMPIANTO>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='METRITOT']/valoreAttributo&quot;>&lt;tns5:METRI_TOT>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='METRITOT']/valoreAttributo&quot;/>&lt;/tns5:METRI_TOT>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='APPARATO' and IDDettaglioOrdineParent=$iddettord]&quot;>&lt;tns5:APPARATO>&lt;tns5:TIPOLOGIA_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:TIPOLOGIA_APPARATO>&lt;tns5:ESITO_CONSEGNA_APPARATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOCONSEGNAAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:ESITO_CONSEGNA_APPARATO>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='IDAPPARATO']/valoreAttributo&quot;>&lt;tns5:ID_APPARATO_CONSEGNATO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='IDAPPARATO']/valoreAttributo&quot;/>&lt;/tns5:ID_APPARATO_CONSEGNATO>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALEESITO']/valoreAttributo&quot;>&lt;tns5:CODICE_MOTIVAZIONE_CONSEGNA>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CAUSALEESITO']/valoreAttributo&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE_CONSEGNA>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITO']/valoreAttributo&quot;>&lt;tns5:MOTIVAZIONE_CONSEGNA>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITO']/valoreAttributo&quot;/>&lt;/tns5:MOTIVAZIONE_CONSEGNA>&lt;/xsl:if>&lt;tns5:QTA_APPARATO>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='QTAAPPARATO']/valoreAttributo)&quot;/>&lt;/tns5:QTA_APPARATO>&lt;/tns5:APPARATO>&lt;/xsl:for-each>&lt;/tns5:SERVIZIO_AGGIUNTIVO>&lt;/xsl:for-each>&lt;/tns5:SERVIZI_OPZIONALI>