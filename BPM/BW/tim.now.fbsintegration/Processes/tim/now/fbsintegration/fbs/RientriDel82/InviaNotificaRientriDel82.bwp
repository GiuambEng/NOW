            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IgAnagCausGUI"
                    name="IdAnagCausGUI" outputVariable="IgAnagCausGUI"
                    tibex:xpdlId="1b262d99-fb7d-4758-91ce-c30d0524fb36" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdRichOrdnToIdAnagCausGUI"/>
                        <bpws:target linkName="LogQueryToIdAnagCausGUI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IdAnagCausGUIToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (exists($ESPLETATOKO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $ESPLETATOKO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($ACCETTATOKO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $ACCETTATOKO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($ACQUISITOKO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $ACQUISITOKO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($ANNULLATO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $ANNULLATO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($ESPLETAMENTOTECNICOKO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $ESPLETAMENTOTECNICOKO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($SCARTATO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $SCARTATO/Record[1]/ID_ANAGRAFICA_CAUSALE else if (exists($SOSPESO/Record[1]/ID_ANAGRAFICA_CAUSALE)) then $SOSPESO/Record[1]/ID_ANAGRAFICA_CAUSALE else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="IgAnagCausGUI" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SOSPESO-input"
                    name="SOSPESO" outputVariable="SOSPESO"
                    tibex:xpdlId="e5b5bc8c-2627-4d8c-b275-ba4b9a690f2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SOSPESOToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e5b5bc8c-2627-4d8c-b275-ba4b9a690f2f+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SOSPESO-input&quot; match=&quot;/&quot;>&lt;tns13:jdbcQueryActivityInput>&lt;ID_RICHIESTA_OLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/ID_RICHIESTA_OLO>&lt;/tns13:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAGRAFICA_CAUSALE FROM RICH_ORDN_COMUNIC_NOTF_DEL82 &#xa;WHERE COD_TIPOLOGIA_NOTIF &#xa;IN ('RD', 'SP', 'KD', 'KO') AND ID_TIPOL_DEST_NOTIFICA = 1&#xa;AND ID_RICHIESTA_OLO =? ORDER BY TIMESTAMP_CREAZ DESC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICHIESTA_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_ANAGRAFICA_CAUSALE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SCARTATO-input"
                    name="SCARTATO" outputVariable="SCARTATO"
                    tibex:xpdlId="dc1207e1-231c-4b91-b43a-b7a6e4052013" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SCARTATOToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns14=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dc1207e1-231c-4b91-b43a-b7a6e4052013+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SCARTATO-input&quot; match=&quot;/&quot;>&lt;tns14:jdbcQueryActivityInput>&lt;ID_RICHIESTA_OLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/ID_RICHIESTA_OLO>&lt;/tns14:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAGRAFICA_CAUSALE FROM RICH_ORDN_COMUNIC_NOTF_DEL82 &#xa;WHERE COD_TIPOLOGIA_NOTIF &#xa;IN ('KC', 'KD', 'KO') AND ID_TIPOL_DEST_NOTIFICA = 1&#xa;AND ID_RICHIESTA_OLO =? ORDER BY TIMESTAMP_CREAZ DESC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
