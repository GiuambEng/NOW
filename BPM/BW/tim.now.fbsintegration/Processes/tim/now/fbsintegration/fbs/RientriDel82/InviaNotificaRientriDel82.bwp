lt;tns5:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE>&lt;tns5:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns5:MOTIVAZIONE>&lt;xsl:if test=&quot;$ParseXml/ordine/noteFiberStream&quot;>&lt;tns5:NOTE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/noteFiberStream&quot;/>&lt;/tns5:NOTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$PC-RDEventoOf/Record[1]/DATA_NOTIFICA&quot;>&lt;tns5:TIMESTAMP_ORIGINE>&lt;xsl:value-of select=&quot;$PC-RDEventoOf/Record[1]/DATA_NOTIFICA&quot;/>&lt;/tns5:TIMESTAMP_ORIGINE>&lt;/xsl:if>&lt;/tns5:WHS_RescheduleMig_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
