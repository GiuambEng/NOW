lect=&quot;$N7.out/tns5:CODICE_MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns8:CODICEMOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                        &lt;tns8:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$N4.out/tns5:ESITO&quot;/>&#xa;                        &lt;/tns8:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&#xa;                        &lt;tns8:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$N5.out/tns5:ESITO&quot;/>&#xa;                        &lt;/tns8:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&#xa;                        &lt;tns8:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$N6.out/tns5:ESITO&quot;/>&#xa;                        &lt;/tns8:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&#xa;                        &lt;tns8:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$N7.out/tns5:ESITO&quot;/>&#xa;                        &lt;/tns8:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns8:StagingIn>&#xa;            &lt;tns8:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_OUT'&quot;/>&#xa;            &lt;/tns8:StagingType>&#xa;            &lt;tns8:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDA