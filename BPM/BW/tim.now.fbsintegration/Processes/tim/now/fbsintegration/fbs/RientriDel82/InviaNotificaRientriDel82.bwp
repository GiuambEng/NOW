                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;N7.out&quot;/>&#xa;    &lt;xsl:param name=&quot;N5.out&quot;/>&#xa;    &lt;xsl:param name=&quot;N4.out&quot;/>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;N6.out&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN7&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN6&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:StagingRequest>&#xa;            &lt;tns8:StagingIn>&#xa;                &lt;xsl:if test=&quot;$ParseXml/codiceOrdineOLO&quot;>&#xa;                    &lt;tns8:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns8:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                        &lt;tns8:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($N4.out)&quot;/>&#xa;                        &lt;/tns8:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;