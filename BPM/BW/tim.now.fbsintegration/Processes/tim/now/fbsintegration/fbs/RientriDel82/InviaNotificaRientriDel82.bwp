            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichOrdn&quot;/>&lt;xsl:param name=&quot;IgAnagCausGUI&quot;/>&lt;xsl:param name=&quot;NotificaN4&quot;/>&lt;xsl:param name=&quot;N7&quot;/>&lt;xsl:param name=&quot;N6&quot;/>&lt;xsl:param name=&quot;N5&quot;/>&lt;xsl:param name=&quot;NotificaN7&quot;/>&lt;xsl:param name=&quot;NotificaN6&quot;/>&lt;xsl:param name=&quot;NotificaN5&quot;/>&lt;xsl:param name=&quot;N4&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:InviaNotificaMigDel82Response>&lt;xsl:if test=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;>&lt;tns:IdNotifica>&lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&lt;/tns:IdNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($IgAnagCausGUI)>0&quot;>&lt;tns:IdAnagraficaCausaleGUI>&lt;xsl:value-of select=&quot;xsd:int($IgAnagCausGUI)&quot;/>&lt;/tns:IdAnagraficaCausaleGUI>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&lt;tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$N4/out/tns5:WHS_StatusUpdateMig_Resp/tns5:ESITO='0'&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$N4/out/tns5:WHS_StatusUpdateMig_Resp/tns5:MOTIVAZIONE&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$N4/out/tns5:WHS_StatusUpdateMig_Resp/tns5:MOTIVAZIONE&quot;/>&lt;/tns:Descrizione>&lt;/xsl:if>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN5)&