        &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&#xa;                        &lt;tns8:CODICEOPERATOREREC>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN6/tns5:CODICE_OPERATORE_REC&quot;/>&#xa;                        &lt;/tns8:CODICEOPERATOREREC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&#xa;                        &lt;tns8:CODICEOPERATOREREC>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN7/tns5:CODICE_OPERATORE_REC&quot;/>&#xa;                        &lt;/tns8:CODICEOPERATOREREC>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;>&#xa;                    &lt;tns8:IDNOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/tns8:IDNOTIFICA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                        &lt;tns8:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN4/tns5:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns8:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&#xa;                        &lt;tns8:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN5/tns5:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns8:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&#xa;                        &lt;tns8:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN6/tns5:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns8:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&#xa;                        &lt;tns8:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$NotificaN7/tns5:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns8:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                        &lt;tns8:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N4 RIENTRIDEL82'&quot;/>&#xa;                        &lt;/tns8:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&#xa;                        &lt;tns8:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N5 RIENTRIDEL82'&quot;/>&#xa;                        &lt;/tns8:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&#xa;                        &lt;tns8:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N6 RIENTRIDEL82'&quot;/>&#xa;                        &lt;/tns8:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&#xa;                        &lt;tns8:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N7 RIENTRIDEL82'&quot;/>&#xa;                        &lt;/tns8:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ParseXml/oaoSourceB2B&quot;>&#xa;                    &lt;tns8:SOURCE_SYSTEM>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/oaoSourceB2B&quot;/>&#xa;                    &lt;/tns8:SOURCE_SYSTEM>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns8:StagingIn>&#xa;            &lt;tns8:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_OUT'&quot;/>&#xa;            &lt;/tns8:StagingType>&#xa;            &lt;tns8:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;201&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;202&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;203&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;204&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns8:LoggerIn>&#xa;        &lt;/tns8:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogN4ToInvoke"/>
