                    <bpws:target linkName="LogN7ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsStagToJDBCUpdate"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InsRichOrdn-input" name="InsRichOrdn"
                    outputVariable="InsRichOrdn"
                    tibex:xpdlId="cf50c902-f858-4fb3-91e2-e70e343c674d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsStagToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsRichOrdnToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cf50c902-f858-4fb3-91e2-e70e343c674d+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NotificaN4&quot;/>&lt;xsl:param name=&quot;NotificaN7&quot;/>&lt;xsl:param name=&quot;NotificaN6&quot;/>&lt;xsl:param name=&quot;NotificaN5&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdRichOrdn&quot;/>&lt;xsl:template name=&quot;InsRichOrdn-input&quot; match=&quot;/&quot;>&lt;tns9:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&lt;TRACCIATO>&lt;xsl:value-of select=&quot;tib:render-xml($NotificaN4)&quot;/>&lt;/TRACCIATO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&lt;TRACCIATO>&lt;xsl:value-of select=&quot;tib:render-xml($NotificaN5)&quot;/>&lt;/TRACCIATO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&lt;TRACCIATO>&lt;xsl:value-of select=&quot;tib:render-xml($NotificaN6)&quot;/>&lt;/TRACCIATO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&lt;TRACCIATO>&lt;xsl:value-of select=&quot;tib:render-xml($NotificaN7)&quot;/>&lt;/TRACCIATO>&lt;/xsl:when>&lt;/xsl:choose>&lt;STRUTTURA_RICHIESTA>&lt;xsl:value-of select=&quot;$ParseXml/strutturaRichiesta&quot;/>&lt;/STRUTTURA_RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:TipologiaNotifica = ('AQ','KO')&quot;>&lt;ORIGINE_NOTIFICA>&lt;xsl:value-of select=&quot;'RICHIESTA OLO'&quot;/>&lt;/ORIGINE_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseXml/IDRichiestaOLO) > 0 and $ParseXml/tipoRichiesta = &amp;quot;ORDINE&amp;quot;&quot;>&lt;ORIGINE_NOTIFICA>&lt;xsl:value-of select=&quot;'ORDINE NOW WHOLESALE'&quot;/>&lt;/ORIGINE_NOTIFICA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ORIGINE_NOTIFICA>&lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE SU ORDINE WHOLESALE&amp;quot;&quot;/>&lt;/ORIGINE_NOTIFICA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;OPERATORE>&lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&lt;/OPERATORE>&lt;ID_TIPOL_STATO_NOTIFICA>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/ID_TIPOL_STATO_NOTIFICA>&lt;DESCR_TIPOL_DEST_NOTIFICA>&lt;xsl:value-of select=&quot;'RECIPIENT'&quot;/>&lt;/DESCR_TIPOL_DEST_NOTIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:Tool_StatoOLOA)>0&quot;>&lt;STATO_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Tool_StatoOLOA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Tool_StatoOLOA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_RICH_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/statoRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_RICH_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:Tool_StatoNOWA)>0&quot;>&lt;STATO_RICH_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Tool_StatoNOWA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Tool_StatoNOWA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_RICH_NOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_RICH_NOW>&lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaNOW&quot;/>&lt;/STATO_RICH_NOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RICHIESTA_OLO>&lt;xsl:value-of select=&quot;$ParseXml/IDRichiestaOLO&quot;/>&lt;/ID_RICHIESTA_OLO>&lt;ID_RICHORDN_COMNOTFDEL82>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdRichOrdn/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICHORDN_COMNOTFDEL82>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/tns:IdAnagraficaCausale))>0&quot;>&lt;ID_ANAGRAFICA_CAUSALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:IdAnagraficaCausale)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:IdAnagraficaCausale&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ANAGRAFICA_CAUSALE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ANAGRAFICA_CAUSALE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODIFICA_OLO_AGCOM>&lt;xsl:value-of select=&quot;$ParseXml/codificaOLOAGCOM&quot;/>&lt;/CODIFICA_OLO_AGCOM>&lt;COD_TIPOLOGIA_NOTIF>&lt;xsl:value-of select=&quot;$Start/tns:TipologiaNotifica&quot;/>&lt;/COD_TIPOLOGIA_NOTIF>&lt;CODICE_OLO_NUMERICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/codificaOLONOW)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/codificaOLONOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_OLO_NUMERICO>&lt;OAO_SOURCE_B2B>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/oaoSourceB2B)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/oaoSourceB2B&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OAO_SOURCE_B2B>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&lt;NOME_FLUSSO>&lt;xsl:value-of select=&quot;'N4 RIENTRI DEL82'&quot;/>&lt;/NOME_FLUSSO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN5)&quot;>&lt;NOME_FLUSSO>&lt;xsl:value-of select=&quot;'N5 RIENTRI DEL82'&quot;/>&lt;/NOME_FLUSSO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN6)&quot;>&lt;NOME_FLUSSO>&lt;xsl:value-of select=&quot;'N6 RIENTRI DEL82'&quot;/>&lt;/NOME_FLUSSO>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificaN7)&quot;>&lt;NOME_FLUSSO>&lt;xsl:value-of select=&quot;'N7 RIENTRI DEL82'&quot;/>&lt;/NOME_FLUSSO>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns9:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF_DEL82 (TRACCIATO, TIMESTAMP_CREAZ, TIMESTAMP_AGG, STRUTTURA_RICHIESTA, ORIGINE_NOTIFICA, OPERATORE, ID_TIPOL_STATO_NOTIFICA, ID_TIPOL_DEST_NOTIFICA, ID_RICHCOMUNIC_STATO, ID_RICHIESTA_OLO, ID_RICHORDN_COMNOTFDEL82, ID_ANAGRAFICA_CAUSALE, CODIFICA_OLO_AGCOM, COD_TIPOLOGIA_NOTIF, CODICE_OLO_NUMERICO, OAO_SOURCE_B2B, NOME_FLUSSO) VALUES(?,SYSDATE,SYSDATE,?,?,?,?,(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR = ?),(SELECT IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTOLO WHERE STATO_RICH_OLO = ? AND STATO_RICH_NOW = ?),?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="TRACCIATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_RICHIESTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ORIGINE_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOL_STATO_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_TIPOL_DEST_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_RICH_NOW"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICHIESTA_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHORDN_COMNOTFDEL82"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAGRAFICA_CAUSALE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_TIPOLOGIA_NOTIF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO_NUMERICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OAO_SOURCE_B2B"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FLUSSO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInsStag-input"
                    name="LogInsStag"
                    tibex:xpdlId="4cdcf7cd-423c-4786-8ec8-4aa6ddd32d2e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsRichOrdnToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInsStagToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipologiaNotifica=('KO','AQ','SP','KC','AC','AN','RR','RA','FS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('KO','AQ','SP','KC','AC','AN','RR','RA','FS')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInsStagToInvoke1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipologiaNotifica='RD'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='RD']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInsStagToInvoke2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipologiaNotifica='PC'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='PC']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInsStagToInvoke3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipologiaNotifica=('OK','KD')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('OK','KD')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
