            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperUpdateStatus-input"
                    name="MapperUpdateStatus"
                    outputVariable="MapperUpdateStatus"
                    tibex:xpdlId="511e6786-c28d-48e3-a3be-0118906fd65c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OrdineNOWWHLSToMapper1"/>
