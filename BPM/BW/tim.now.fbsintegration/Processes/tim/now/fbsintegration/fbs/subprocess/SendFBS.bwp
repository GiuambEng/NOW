                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:SendFBSResponse>&lt;tns:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$Response/tns:IdEventoOrdnNowWhls&quot;/>&lt;/tns:IdEventoOrdnNowWhls>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Response/tns:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Response/tns:ESITO='0'&quot;>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:ESITO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Response/tns:CODICE_MOTIVAZIONE&quot;>&lt;tns:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$Response/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/tns:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:MOTIVAZIONE&quot;>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$Response/tns:MOTIVAZIONE&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/xsl:if>&lt;/tns:SendFBSResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="OrdineNOWWHLS-input"
                    name="OrdineNOWWHLS" outputVariable="OrdineNOWWHLS"
                    tibex:xpdlId="ace0896a-056b-4616-954d-2d2d36a845a0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToOrdineNOWWHLS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OrdineNOWWHLSToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF' and string-length($Start/ns0:RichiestaElement/ordine/flagIU)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF' and string-length($Start/ns0:RichiestaElement/ordine/flagIU)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OrdineNOWWHLSToMapper1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType=('ANNULLAMENTO_AUTO_OF','ANNULLAMENTO_OF','DESOSPENSIONE_OF')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType=('ANNULLAMENTO_AUTO_OF','ANNULLAMENTO_OF','DESOSPENSIONE_OF')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OrdineNOWWHLSToMapperReschedule">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='RDAD_OF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='RDAD_OF']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OrdineNOWWHLSToMapper2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='CESSAZIONE_OF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='CESSAZIONE_OF']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OrdineNOWWHLSToAggiuntiviApparatiInterventoUnico">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF' and $Start/ns0:RichiestaElement/ordine/flagIU='SI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF' and $Start/ns0:RichiestaElement/ordine/flagIU='SI']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/OrdineNOWWHLS/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;OrdineNOWWHLS-input&quot; match=&quot;/&quot;>&lt;sm:OrdineNOWWHLSRequest>&lt;sm:TipologiaEvento>&lt;xsl:value-of select=&quot;$Start/tns:Testata/tns:RequestType&quot;/>&lt;/sm:TipologiaEvento>&lt;sm:IdRichiestaOlo>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/sm:IdRichiestaOlo>&lt;/sm:OrdineNOWWHLSRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.OrdineNOWWHLS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="InsertUpdateStaging"
                outputVariable="InsertStaging"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns3:InsertUpdateStagingPortType" tibex:xpdlId="51ad1563-c0b1-44dc-b733-3f711c432990">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/xsd/SendFBS/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachineOF/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="OrdineNOWWHLS"/&gt;&lt;xsl:param name="TransactionId"/&gt;&lt;xsl:param name="MapperActivationSetup"/&gt;&lt;xsl:param name="MapperUpdateStatus"/&gt;&lt;xsl:param name="MapperDeactivation"/&gt;&lt;xsl:param name="MapperReschedule"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns3:StagingRequest&gt;&lt;tns3:StagingIn&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;tns3:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperActivationSetup)"/&gt;&lt;/tns3:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAD_OF'"&gt;&lt;tns3:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperReschedule)"/&gt;&lt;/tns3:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'"&gt;&lt;tns3:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperDeactivation)"/&gt;&lt;/tns3:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperUpdateStatus)"/&gt;&lt;/tns3:CONTENUTO_REQUEST&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;tns3:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="168"/&gt;&lt;/tns3:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAD_OF'"&gt;&lt;tns3:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="173"/&gt;&lt;/tns3:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'"&gt;&lt;tns3:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="174"/&gt;&lt;/tns3:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="169"/&gt;&lt;/tns3:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns3:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:ID_RICH_OLO&gt;&lt;xsl:if test="$Start/tns:RichiestaElement/IDRisorsa"&gt;&lt;tns3:ID_RISORSA&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRisorsa"/&gt;&lt;/tns3:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;tns3:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns3:ID_STATO_ELAB_STAG&gt;&lt;tns3:TRANSACTION_ID&gt;&lt;xsl:value-of select="$TransactionId"/&gt;&lt;/tns3:TRANSACTION_ID&gt;&lt;tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:value-of select="xsd:int($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls)"/&gt;&lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:if test="$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber"&gt;&lt;tns3:CODICEORDINEOLOOF&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber"/&gt;&lt;/tns3:CODICEORDINEOLOOF&gt;&lt;/xsl:if&gt;&lt;/tns3:StagingIn&gt;&lt;tns3:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichiestaOLO&gt;&lt;tns3:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_OF_OUT'"/&gt;&lt;/tns3:StagingType&gt;&lt;tns3:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="168"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAD_OF'"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="173"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="174"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="169"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns3:LoggerIn&gt;&lt;/tns3:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns2:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperActivationSetup&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperUpdateStatus&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperDeactivation&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperReschedule&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:StagingRequest>&#xa;            &lt;tns3:StagingIn>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                        &lt;tns3:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperActivationSetup)&quot;/>&#xa;                        &lt;/tns3:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAD_OF'&quot;>&#xa;                        &lt;tns3:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperReschedule)&quot;/>&#xa;                        &lt;/tns3:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'&quot;>&#xa;                        &lt;tns3:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperDeactivation)&quot;/>&#xa;                        &lt;/tns3:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperUpdateStatus)&quot;/>&#xa;                        &lt;/tns3:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                        &lt;tns3:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;168&quot;/>&#xa;                        &lt;/tns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAD_OF'&quot;>&#xa;                        &lt;tns3:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;173&quot;/>&#xa;                        &lt;/tns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'&quot;>&#xa;                        &lt;tns3:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;174&quot;/>&#xa;                        &lt;/tns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;169&quot;/>&#xa;                        &lt;/tns3:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$Start/tns:RichiestaElement/IDRisorsa&quot;>&#xa;                    &lt;tns3:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRisorsa&quot;/>&#xa;                    &lt;/tns3:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns3:ID_STATO_ELAB_STAG>&#xa;                &lt;tns3:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns3:TRANSACTION_ID>&#xa;                &lt;tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls)&quot;/>&#xa;                &lt;/tns3:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;>&#xa;                    &lt;tns3:CODICEORDINEOLOOF>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&#xa;                    &lt;/tns3:CODICEORDINEOLOOF>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:StagingIn>&#xa;            &lt;tns3:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns3:IdRichiestaOLO>&#xa;            &lt;tns3:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_OF_OUT'&quot;/>&#xa;            &lt;/tns3:StagingType>&#xa;            &lt;tns3:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;168&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAD_OF'&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;173&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;174&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;169&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns3:LoggerIn>&#xa;        &lt;/tns3:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogRequestToInsertStaging"/>
                    <bpws:target linkName="GenericLoggerToInsertStaging"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToLogStaging"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TransactionId"
                    name="TransactionId" outputVariable="TransactionId"
                    tibex:xpdlId="474f51e3-f9cb-40e4-a414-2e68f328f058" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToTransactionId"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TransactionIdToOscuramento"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="string(tib:timestamp())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TransactionId" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperActivationSetup-input"
                    name="MapperActivationSetup"
                    outputVariable="MapperActivationSetup"
                    tibex:xpdlId="e2803f42-a751-4d24-8a82-cf816a5042ca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OrdineNOWWHLSToMapper"/>
                        <bpws:target linkName="AggiuntiviApparatiInterventoUnicoToMapperActivationSetup"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperActivationSetupToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://openfiber.it/schemas/OLO_Gateway/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_ActivationSetup_OpenStream.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:tns15=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;AggiuntiviApparatiInterventoUnico&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapperActivationSetup-input&quot; match=&quot;/&quot;>&lt;tns4:ActivationSetup_OpenStream_Req>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/caratterizzazioneArea='AN'&quot;>&lt;tns4:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'COC'&quot;/>&lt;/tns4:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=1&quot;>&lt;tns4:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/tns4:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns4:CODICE_OPERATORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns4:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns4:CODICE_ORDINE_OLO>&lt;tns4:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns4:DATA_NOTIFICA>&lt;tns4:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns4:ID_NOTIFICA>&lt;tns4:NOME_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;'ND'&quot;/>&lt;/tns4:NOME_REFERENTE_TECNICO_OLO>&lt;tns4:COGNOME_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;'ND'&quot;/>&lt;/tns4:COGNOME_REFERENTE_TECNICO_OLO>&lt;tns4:TELEFONO_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;'ND'&quot;/>&lt;/tns4:TELEFONO_REFERENTE_TECNICO_OLO>&lt;tns4:EMAIL_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;'ND'&quot;/>&lt;/tns4:EMAIL_REFERENTE_TECNICO_OLO>&lt;tns4:NOME_CLIENTE>&lt;xsl:value-of select=&quot;substring($Start/tns:RichiestaElement/ordine/nome, 1, 20)&quot;/>&lt;/tns4:NOME_CLIENTE>&lt;tns4:COGNOME_CLIENTE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&lt;/tns4:COGNOME_CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente)>0&quot;>&lt;tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente&quot;/>&lt;/tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;/>&lt;/tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns4:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;>&lt;tns4:RECAPITO_TELEFONICO_CLIENTE_2>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;/>&lt;/tns4:RECAPITO_TELEFONICO_CLIENTE_2>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/tns:RichiestaElement/ordine/DACRimodulata))>0&quot;>&lt;tns4:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/DACRimodulata&quot;/>&lt;/tns4:DATA_PREVISTA_ATTIVAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/DAC&quot;/>&lt;/tns4:DATA_PREVISTA_ATTIVAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSOFIBERSTREAM']/attributiDettaglioOrdine[nomeAttributo = 'PROMOZIONE']/valoreAttributo&quot;>&lt;tns4:PROMOZIONE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSOFIBERSTREAM']/attributiDettaglioOrdine[nomeAttributo = 'PROMOZIONE']/valoreAttributo&quot;/>&lt;/tns4:PROMOZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/note&quot;>&lt;tns4:NOTE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/note&quot;/>&lt;/tns4:NOTE>&lt;/xsl:if>&lt;tns4:ID_BUILDING>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUSEDE']/attributiDettaglioOrdine[nomeAttributo = 'IDBUILDING']/valoreAttributo&quot;/>&lt;/tns4:ID_BUILDING>&lt;tns4:IDENTIFICATIVO_DEL_POP>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/sede[tipologiaSede='SEDECLIENTE']/identificativoDelPop&quot;/>&lt;/tns4:IDENTIFICATIVO_DEL_POP>&lt;tns4:PROFILO>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSOFIBERSTREAM']/attributiDettaglioOrdine[nomeAttributo = 'PROFILOTECNICOLINEA']/valoreAttributo&quot;/>&lt;/tns4:PROFILO>&lt;xsl:if test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=0&quot;>&lt;tns4:CODICE_OPERATORE_SECONDARIO>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns4:CODICE_OPERATORE_SECONDARIO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/ordine/flagIU='SI'&quot;>&lt;xsl:for-each select=&quot;$AggiuntiviApparatiInterventoUnico/tns15:Aggiuntivi&quot;>&lt;tns4:SERVIZIO_AGGIUNTIVO>&lt;tns4:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;tns15:NomeServizio&quot;/>&lt;/tns4:NOME_SERVIZIO>&lt;tns4:INFORMAZIONI_SERVIZIO>&lt;xsl:value-of select=&quot;tns15:InformazioniServizio&quot;/>&lt;/tns4:INFORMAZIONI_SERVIZIO>&lt;/tns4:SERVIZIO_AGGIUNTIVO>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='SERVIZIOAGGIUNTIVO' and attributiDettaglioOrdine[nomeAttributo='AMBITO']/valoreAttributo='OF']&quot;>&lt;tns4:SERVIZIO_AGGIUNTIVO>&lt;tns4:NOME_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOMESERVIZIO']/valoreAttributo&quot;/>&lt;/tns4:NOME_SERVIZIO>&lt;tns4:INFORMAZIONI_SERVIZIO>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='INFORMAZIONISERVIZIO']/valoreAttributo&quot;/>&lt;/tns4:INFORMAZIONI_SERVIZIO>&lt;/tns4:SERVIZIO_AGGIUNTIVO>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/flagIU='SI'&quot;>&lt;xsl:for-each select=&quot;$AggiuntiviApparatiInterventoUnico/tns15:Apparati&quot;>&lt;tns4:APPARATO>&lt;tns4:TIPOLOGIA_APPARATO>&lt;xsl:value-of select=&quot;tns15:CodiceApparato&quot;/>&lt;/tns4:TIPOLOGIA_APPARATO>&lt;xsl:if test=&quot;tns15:PasswordApparato&quot;>&lt;tns4:PASSWORD_APPARATO>&lt;xsl:value-of select=&quot;tns15:PasswordApparato&quot;/>&lt;/tns4:PASSWORD_APPARATO>&lt;/xsl:if>&lt;tns4:AZIONE_APPARATO>&lt;xsl:value-of select=&quot;tns15:AzioneApparato&quot;/>&lt;/tns4:AZIONE_APPARATO>&lt;xsl:if test=&quot;tns15:Causale&quot;>&lt;tns4:CAUSALE>&lt;xsl:value-of select=&quot;tns15:Causale&quot;/>&lt;/tns4:CAUSALE>&lt;/xsl:if>&lt;/tns4:APPARATO>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;xsl:variable name=&quot;PROFILOVLAN&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo&quot;/>&lt;xsl:variable name=&quot;USERVLAN&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo&quot;/>&lt;tns4:VLAN>&lt;tns4:KIT_CONSEGNA_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'IDKIT']/valoreAttributo&quot;/>&lt;/tns4:KIT_CONSEGNA_VLAN>&lt;tns4:USER_VLAN>&lt;xsl:value-of select=&quot;$USERVLAN&quot;/>&lt;/tns4:USER_VLAN>&lt;tns4:SERVICE_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'SERVICEVLAN']/valoreAttributo&quot;/>&lt;/tns4:SERVICE_VLAN>&lt;tns4:PROFILO_VLAN>&lt;xsl:value-of select=&quot;$PROFILOVLAN&quot;/>&lt;/tns4:PROFILO_VLAN>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'CVLAN']/valoreAttributo&quot;>&lt;tns4:CUSTOMER_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'CVLAN']/valoreAttributo&quot;/>&lt;/tns4:CUSTOMER_VLAN>&lt;/xsl:if>&lt;/tns4:VLAN>&lt;/xsl:for-each>&lt;/tns4:ActivationSetup_OpenStream_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:OLO_ActivationSetup_OpenStream.xsd="http://openfiber.it/schemas/OLO_Gateway/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_ActivationSetup_OpenStream.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
