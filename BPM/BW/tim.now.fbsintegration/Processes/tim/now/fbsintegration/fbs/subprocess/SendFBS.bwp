                &lt;tns:SendFBSResponse>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;tns:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Deactivation.output/tns8:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns:ID_NOTIFICA>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Deactivation.output/tns8:ESITO&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$Deactivation.output/tns8:CODICE_MOTIVAZIONE&quot;>&#xa;                        &lt;tns:CODICE_MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$Deactivation.output/tns8:CODICE_MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:CODICE_MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Deactivation.output/tns8:MOTIVAZIONE&quot;>&#xa;                        &lt;tns:MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$Deactivation.output/tns8:MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:SendFBSResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:SendFBSResponse>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;tns:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$UpdStat.Output/tns8:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns:ID_NOTIFICA>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$UpdStat.Output/tns8:ESITO&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$UpdStat.Output/tns8:CODICE_MOTIVAZIONE&quot;>&#xa;                        &lt;tns:CODICE_MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$UpdStat.Output/tns8:CODICE_MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:CODICE_MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$UpdStat.Output/tns8:MOTIVAZIONE&quot;>&#xa;                        &lt;tns:MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$UpdStat.Output/tns8:MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:SendFBSResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
