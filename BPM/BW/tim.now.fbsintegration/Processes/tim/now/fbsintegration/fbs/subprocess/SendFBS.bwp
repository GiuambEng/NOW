                    <bpws:targets>
                        <bpws:target linkName="OrdineNOWWHLSToMapperReschedule"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperRescheduleToLogRequest"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://openfiber.it/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_Reschedule.xsd3&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapperReschedule-input&quot; match=&quot;/&quot;>&lt;tns9:OLO_Reschedule>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/caratterizzazioneArea='AN'&quot;>&lt;tns9:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'COC'&quot;/>&lt;/tns9:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=1&quot;>&lt;tns9:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/tns9:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns9:CODICE_OPERATORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns9:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns9:CODICE_ORDINE_OLO>&lt;tns9:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns9:DATA_NOTIFICA>&lt;tns9:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns9:ID_NOTIFICA>&lt;tns9:NOME_CLIENTE>&lt;xsl:value-of select=&quot;substring($Start/tns:RichiestaElement/ordine/nome, 1, 20)&quot;/>&lt;/tns9:NOME_CLIENTE>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/cognomeRagioneSociale&quot;>&lt;tns9:COGNOME_CLIENTE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&lt;/tns9:COGNOME_CLIENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente&quot;>&lt;tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente&quot;/>&lt;/tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;>&lt;tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;/>&lt;/tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns9:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoMobileReferente)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;>&lt;tns9:RECAPITO_TELEFONICO_CLIENTE_2>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='REFERENTE'][1]/telefonoFissoReferente&quot;/>&lt;/tns9:RECAPITO_TELEFONICO_CLIENTE_2>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;tns9:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/DUA&quot;/>&lt;/tns9:DATA_PREVISTA_ATTIVAZIONE>&lt;tns9:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;'D13'&quot;/>&lt;/tns9:CODICE_MOTIVAZIONE>&lt;tns9:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'MOTIVI CLIENTE'&quot;/>&lt;/tns9:MOTIVAZIONE>&lt;/tns9:OLO_Reschedule>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:OLO_Reschedule.xsd3="http://openfiber.it/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_Reschedule.xsd3"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
