                    <bpws:sources>
                        <bpws:source linkName="MapperUpdateStatusToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://openfiber.it/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_StatusUpdate_New.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapperUpdateStatus-input&quot; match=&quot;/&quot;>&lt;tns5:OLO_StatusUpdate>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/caratterizzazioneArea='AN'&quot;>&lt;tns5:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'COC'&quot;/>&lt;/tns5:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=1&quot;>&lt;tns5:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/tns5:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber, &amp;quot;TLC_&amp;quot;)&quot;>&lt;tns5:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns5:CODICE_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:CODICE_OPERATORE>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns5:CODICE_OPERATORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns5:CODICE_ORDINE_OLO>&lt;tns5:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:DATA_NOTIFICA>&lt;tns5:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns5:ID_NOTIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='DESOSPENSIONE_OF'&quot;>&lt;tns5:AZIONE>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns5:AZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType=('ANNULLAMENTO_AUTO_OF','ANNULLAMENTO_OF')&quot;>&lt;tns5:AZIONE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns5:AZIONE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType=('ANNULLAMENTO_AUTO_OF','ANNULLAMENTO_OF')&quot;>&lt;tns5:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;'D12'&quot;/>&lt;/tns5:CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType=('ANNULLAMENTO_AUTO_OF','ANNULLAMENTO_OF')&quot;>&lt;tns5:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'Annullamento su richiesta OLO'&quot;/>&lt;/tns5:MOTIVAZIONE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/cognomeReferente&quot;>&lt;tns5:COGNOME_CLIENTE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/cognomeReferente&quot;/>&lt;/tns5:COGNOME_CLIENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/telefonoFissoReferente&quot;>&lt;tns5:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/telefonoFissoReferente&quot;/>&lt;/tns5:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/telefonoMobileReferente&quot;>&lt;tns5:RECAPITO_TELEFONICO_CLIENTE_2>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/referente[tipoReferenteOrdine='&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE']/telefonoMobileReferente&quot;/>&lt;/tns5:RECAPITO_TELEFONICO_CLIENTE_2>&lt;/xsl:if>&lt;/tns5:OLO_StatusUpdate>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:OLO_StatusUpdate_New.xsd="http://openfiber.it/SharedResources/CommonSchema/ServiziAttivi/OLO_New/OLO_StatusUpdate_New.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="OLO_StatusUpdate_New.xsd:OLO_StatusUpdate" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRequest-input"
                    name="LogRequest"
                    tibex:xpdlId="fd72741a-7016-42e6-8515-23fcf41deee5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperUpdateStatusToGenericLogger"/>
                        <bpws:target linkName="MapperActivationSetupToGenericLogger"/>
                        <bpws:target linkName="MapperRescheduleToLogRequest"/>
                        <bpws:target linkName="MapperToLogRequest"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRequestToInsertStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogRequestToSelectSemaforo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType=('EMISSIONEOF','CESSAZIONE_OF')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType=('EMISSIONEOF','CESSAZIONE_OF')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
