ayload>&lt;xsl:value-of select=&quot;concat('Risposta da FBS per UpdateStatus: ID_NOTIFICA ',$UpdStat/Output/tns8:Response/tns8:ID_NOTIFICA,' ESITO ',$UpdStat/Output/tns8:Response/tns8:ESITO,' CODICE_MOTIVAZIONE ',$UpdStat/Output/tns8:Response/tns8:CODICE_MOTIVAZIONE,' MOTIVAZIONE ',$UpdStat/Output/tns8:Response/tns8:MOTIVAZIONE)&quot;/>&lt;/tns6:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAD_OF'&quot;>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat('Risposta da FBS per Reschedule: ID_NOTIFICA ',$Reschedule/Output/tns8:Response/tns8:ID_NOTIFICA,' ESITO ',$Reschedule/Output/tns8:Response/tns8:ESITO,' CODICE_MOTIVAZIONE ',$Reschedule/Output/tns8:Response/tns8:CODICE_MOTIVAZIONE,' MOTIVAZIONE ',$Reschedule/Output/tns8:Response/tns8:MOTIVAZIONE)&quot;/>&lt;/tns6:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='CESSAZIONE_OF'&quot;>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat('Risposta da FBS per DeactivationOrder: ID_NOTIFICA ',$Deactivation/output/tns8:Response/tns8:ID_NOTIFICA,' ESITO ',$Deactivation/output/tns8:Response/tns8:ESITO,' CODICE_MOTIVAZIONE ',$Deactivation/output/tns8:Response/tns8:CODICE_MOTIVAZIONE,' MOTIVAZIONE ',$Deactivation/output/tns8:Response/tns8:MOTIVAZIONE)&quot;/>&lt;/tns6:Payload>&lt;/xsl:when>&lt;/xsl:choose>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
