                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:tns8=&quot;http://openfiber.it/schemas/OLO_Gateway/SharedResources/CommonSchema/ServiziAttivi/OLO_New/Schema.xsd&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ActivationSetup&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;UpdStat&quot;/>&lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&lt;xsl:param name=&quot;Deactivation&quot;/>&lt;xsl:param name=&quot;Reschedule&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&lt;tns:SendFBSResponse>&lt;tns:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&lt;/tns:IdEventoOrdnNowWhls>&lt;tns:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$ActivationSetup/Output/tns8:Response/tns8:ID_NOTIFICA&quot;/>&lt;/tns:ID_NOTIFICA>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;$ActivationSetup/Output/tns8:Response/tns8:ESITO&quot;/>&lt;/tns:ESITO>&lt;xsl:if test=&quot;$ActivationSetup/Output/tns8:Response/tns8:CODICE_MOTIVAZIONE&quot;>&lt;tns:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ActivationSetup/Output/tns8:Response/tns8:CODICE_MOTIVAZIONE&quot;/>&lt;/tns:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ActivationSetup/Output/tns8:Response/tns8:MOTIVAZIONE&quot;>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ActivationSetup/Output/tns8:Response/tns8:MOTIVAZIONE&quot;/>&lt;/tns:MOTIVAZIONE>&lt;/xsl:if>&lt;/tns:SendFBSResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAD_OF'&quot;>&lt;tns:SendFBSResponse>&lt;tns:IdEventoOrdnNowWhls>&lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&lt;/tn