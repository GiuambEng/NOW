            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="01f3a9a0-e07d-4c8a-8b8d-82548f74813a">
                <bpws:targets>
                    <bpws:target linkName="LogDel82ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToWhile1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns0:OLO_N1Request/ns0:NUMERAZIONI/ns0:DN) and not($CheckDN='NaN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns0:OLO_N1Request/ns0:NUMERAZIONI/ns0:DN) and not($CheckDN='NaN')]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="70e8230e-c349-4b8c-8086-8702808ff5d8">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="555eb53e-7ee6-47af-8ddc-e6eb3e642c2c">
                                <bpws:targets>
