            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="031bcdb4-621b-4a09-a8b7-4db5e3830150">
                <bpws:targets>
                    <bpws:target linkName="WhileToWhile1"/>
                </bpws:targets>
                <bpws:sources>
