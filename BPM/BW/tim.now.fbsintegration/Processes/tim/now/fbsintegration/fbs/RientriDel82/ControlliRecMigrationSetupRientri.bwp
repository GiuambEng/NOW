                                <tibex:activityExtension
                                    inputVariable="CheckDN"
                                    name="CheckDN"
                                    outputVariable="CheckDN"
                                    tibex:xpdlId="d68902f9-ab25-4448-87c8-b5f4d215bd7b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
