            name="AnagCow-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="AnagCow" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_AnagCow" sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="tim.now.shared_library-TimeOut"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="//tim.now.shared_library///Connections/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogAnagCow-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcQueryActivityInput"
            name="Richiesta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:resultSet" name="Richiesta" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_Richiesta" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogRichiesta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:jdbcQueryActivityInput"
            name="Del82EventiIn-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:resultSet" name="Del82EventiIn" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_Del82EventiIn" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
