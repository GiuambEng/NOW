        <bpws:variable element="ns10:resultSet" name="AnagServAggOf" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_AnagServAggOf" sca-bpel:internal="true"/>
        <bpws:variable element="ns11:jdbcQueryActivityInput"
