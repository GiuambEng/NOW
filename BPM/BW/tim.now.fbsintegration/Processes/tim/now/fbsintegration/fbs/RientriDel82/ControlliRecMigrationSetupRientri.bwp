        <bpws:variable element="ns12:resultSet" name="AnagCaus" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_AnagCaus" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="LogAnagCaus-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="ControlliToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AnagCowToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogAnagCowToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="RichiestaToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRichiestaToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="Del82EventiInToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogDel82ToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToWhile1" tibex:linkType="SUCCESS"/>
                <bpws:link name="While1ToControlli" tibex:linkType="SUCCESS"/>
                <bpws:link name="ControlliToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AnagCausToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="1abe4f8f-ae09-479e-a2e3-75472e2cbdbd"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="2d1dee2e-b882-410b-8cdd-3ebf8155e19e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlliToEnd"/>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Controlli&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Controlli/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;$Controlli/tns1:ESITO&quot;/>&lt;/tns1:ESITO>&lt;xsl:if test=&quot;$Controlli/tns1:ESITO='1'&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;>&lt;tns1:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns1:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Controlli/tns1:ESITO='1'&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Controlli-input"
                    name="Controlli" outputVariable="Controlli"
                    tibex:xpdlId="298eaaaa-999e-419f-b755-49c42fa53d2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="While1ToControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlliToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Controlli/ns0:ESITO='0'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Controlli/ns0:ESITO='0']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ControlliToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCow&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Del82EventiIn&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:param name=&quot;CheckDN&quot;/>&lt;xsl:param name=&quot;CheckServAgg&quot;/>&lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagCow/Record[COD_COW=$Start/tns1:OLO_N1Request/tns1:CODICE_OPERATORE_REC])=0&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not(substring($Start/tns1:OLO_N1Request/tns1:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns1:OLO_N1Request/tns1:CODICE_ORDINE_REC, 1, 3)=$Start/tns1:OLO_N1Request/tns1:CODICE_OPERATORE_REC)&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Richiesta/Record[1]/COUNT>0&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A08_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns1:OLO_N1Request/tns1:CODICE_OPERATORE_WHS='FOP')&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Del82EventiIn/Record[1]/COUNT>0&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns1:OLO_N1Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns1:OLO_N1Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N1Request/tns1:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH)>0 and string(number($Start/tns1:OLO_N1Request/tns1:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH))='NaN'&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_6'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N1Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1)>0 and string(number($Start/tns1:OLO_N1Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N1Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns1:OLO_N1Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($AnagCow/Record[COD_COW=$Start/tns1:OLO_N1Request/tns1:DATI_MIGRAZIONE/tns1:COW])=0&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_9'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns1:OLO_N1Request/tns1:DATI_MIGRAZIONE/tns1:COS=('OFA','OFB'))&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_10'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckDN='NaN'&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_11'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($Start/tns1:OLO_N1Request/tns1:SERVIZI_OPZIONALI/tns1:SERVIZIO_AGGIUNTIVO[tns1:NOME_SERVIZIO='TLC1'])) and exists($Start/tns1:OLO_N1Request/tns1:SERVIZI_OPZIONALI/tns1:SERVIZIO_AGGIUNTIVO[starts-with(tns1:NOME_SERVIZIO,'TLC')])&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_21'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckServAgg='KO'&quot;>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_20'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Rec_MigrationSetup_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N1Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns1:ESITO>&lt;/tns1:Rec_MigrationSetup_Resp>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecipientMigrationServiceSchema_OLO_Fiberstream.xsd="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecipientMigrationServiceSchema_OLO_Fiberstream.xsd:Rec_MigrationSetup_Resp" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="AnagCow-input"
                    name="AnagCow" outputVariable="AnagCow"
                    tibex:xpdlId="2b4028f7-ef4b-4a64-b37b-e321d0af8e13" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
