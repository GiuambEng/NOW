    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LogName</variable>
                <variable>LogLevel</variable>
                <variable>SendFBSMsg</variable>
            </endingVariables>
        </task>
        <task name="SendFBSMsgOut">
            <endingVariables>
                <variable>SendFBSMsgOut-input</variable>
                <variable>SendFBS</variable>
                <variable>ParseXml</variable>
                <variable>SendFBSRientri</variable>
            </endingVariables>
        </task>
        <task name="LogInput">
            <endingVariables>
                <variable>LogInput-input</variable>
            </endingVariables>
        </task>
        <task name="SendFBS">
            <endingVariables>
                <variable>SendFBS-input</variable>
            </endingVariables>
        </task>
        <task name="LogFind">
            <endingVariables>
                <variable>LogFind-input</variable>
            </endingVariables>
        </task>
        <task name="ParseXml">
            <endingVariables>
                <variable>ParseXml-input</variable>
                <variable>ReadCase</variable>
            </endingVariables>
        </task>
        <task name="FindCase">
            <endingVariables>
                <variable>FindCase-input</variable>
            </endingVariables>
        </task>
        <task name="ReadCase">
            <endingVariables>
                <variable>ReadCase-input</variable>
                <variable>FindCase</variable>
            </endingVariables>
        </task>
        <task name="LogRead">
            <endingVariables>
                <variable>LogRead-input</variable>
            </endingVariables>
        </task>
        <task name="SendFBSRientri">
            <endingVariables>
                <variable>SendFBSRientri-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="LogFault">
            <endingVariables>
                <variable>LogFault-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
