                  &lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:IdRichiesta&quot;/>&#xa;                    &lt;/tns1:IdRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:IdRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:IdRichiesta&quot;/>&#xa;                    &lt;/tns1:IdRichiestaOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_OF_IN'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;171&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:OF_Reschedule_OpenStream_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;170&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;206&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;212&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;208&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;207&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;172&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOrdineNOWWHLSToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInsStaging-input"
                    name="LogInsStaging"
                    tibex:xpdlId="3822f15c-6c5b-42d1-8b3e-ac97c9120f00"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagingToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInsStagingToResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInsStagingToStateMachine_ControlliOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ControlliRichiestaFBS/ns0:CodiceMotivazione='OK' or $ControlliRichiestaFBSRientri/ns0:CodiceMotivazione='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ControlliRichiestaFBS/ns0:CodiceMotivazione='OK' or $ControlliRichiestaFBSRientri/ns0:CodiceMotivazione='OK']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&lt;xsl:template name=&quot;LogInsStaging-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'ReceiveFBS'&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId,' ',$ControlliRichiestaFBS/sm:IdRichiesta,$ControlliRichiestaFBSRientri/sm:IdRichiesta)&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Effettuato insert su staging con id ordine now crmws: ',string($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="Response" outputVariable="Response"
                    tibex:xpdlId="74fc2185-0195-4836-b79a-0d33e23fd2d8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInsStagingToResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ResponseToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;sm:ReceiveFBSResponse>&lt;sm:OF_Response_OpenStream>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:OF_Reschedule_OpenStream_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:OF_Reschedule_OpenStream_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:WHS_StatusUpdateMig_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:WHS_RescheduleMig_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request)&quot;>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:WHS_Event_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/sm:OF_StatusUpdate_OpenStream_Request/sm:ID_NOTIFICA&quot;/>&lt;/sm:ID_NOTIFICA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;sm:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/sm:ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&lt;sm:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:CodiceMotivazione&quot;/>&lt;/sm:CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:CodiceMotivazione&quot;/>&lt;/sm:CODICE_MOTIVAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&lt;xsl:if test=&quot;$ControlliRichiestaFBSRientri/sm:Motivazione&quot;>&lt;sm:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:Motivazione&quot;/>&lt;/sm:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ControlliRichiestaFBS/sm:Motivazione&quot;>&lt;sm:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:Motivazione&quot;/>&lt;/sm:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:OF_Response_OpenStream>&lt;/sm:ReceiveFBSResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StateMachine-input"
                    name="StateMachine" outputVariable="StateMachine"
                    tibex:xpdlId="bfb36c0f-339d-420a-800b-9b6a3f8f199a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInsStagingToStateMachine_ControlliOK"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StateMachineToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&lt;xsl:template name=&quot;StateMachine-input&quot; match=&quot;/&quot;>&lt;sm:StateMachineValidationRequestOF>&lt;xsl:copy-of select=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:OF_Reschedule_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:OF_StatusUpdate_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:WHS_StatusUpdateMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:WHS_RescheduleMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:WHS_CompletionOrderMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/sm:WHS_Event_Request&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:IdRichiesta&quot;/>&lt;/sm:IdRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:IdRichiesta&quot;/>&lt;/sm:IdRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:StateMachineValidationRequestOF>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.StateMachine" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStateMachine-input"
                    name="LogStateMachine"
                    tibex:xpdlId="02d59e7a-1a43-49d5-b8b4-a1de8445625e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StateMachineToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStateMachineToFBStoBPM_StateMachineOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$StateMachine/ns0:ESITO_VALIDAZIONE='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$StateMachine/ns0:ESITO_VALIDAZIONE='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStateMachineToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
