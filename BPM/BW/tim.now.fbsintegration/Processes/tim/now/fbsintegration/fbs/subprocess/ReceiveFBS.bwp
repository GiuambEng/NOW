                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateStagingToJDBCUpdate">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="UpdateStagingToGenericLogger">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Response/ns0:OF_Response_OpenStream/ns0:ESITO='1'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Response/ns0:OF_Response_OpenStream/ns0:ESITO='1']]></bpws:transitionCondition>
