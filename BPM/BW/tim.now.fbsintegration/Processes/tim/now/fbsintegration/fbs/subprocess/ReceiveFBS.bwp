                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&#xa;                    &lt;tns1:StagingIn>&#xa;                        &lt;xsl:if test=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:CODICE_ORDINE_OLO&quot;>&#xa;                            &lt;tns1:COD_ORDN_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:CODICE_ORDINE_OLO&quot;/>&#xa;                            &lt;/tns1:COD_ORDN_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_REQUEST>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;171&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_