NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_StatusUpdateMig_Request)"&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="206"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_RescheduleMig_Request)"&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="212"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_CompletionOrderMig_Request)"&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="208"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_Event_Request)"&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="207"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="172"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ControlliRichiestaFBSRientri)"&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$ControlliRichiestaFBSRientri/sm:IdRichiesta"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$ControlliRichiestaFBS/sm:IdRichiesta"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;/tns1:StagingIn&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($ControlliRichiestaFBSRientri)"&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$ControlliRichiestaFBSRientri/sm:IdRichiesta"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$ControlliRichiestaFBS/sm:IdRichiesta"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_OF_IN'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Start/sm:OF_CompletionOrder_OpenStream_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="171"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:OF_Reschedule_OpenStream_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="170"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_StatusUpdateMig_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="206"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_RescheduleMig_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="212"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_CompletionOrderMig_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="208"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($Start/sm:WHS_Event_Request)"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="207"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="172"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns2:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;StateMachine&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingIn>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response)&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(exists($ControlliRichiestaFBS) and not($ControlliRichiestaFBS/sm:CodiceMotivazione='OK')) or (exists($ControlliRichiestaFBSRientri) and not($ControlliRichiestaFBSRientri/sm:CodiceMotivazione='OK'))&quot;>&#xa;                        &lt;tns1:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;'Controlli su richiesta pervenuta non superati'&quot;/>&#xa;                        &lt;/tns1:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$StateMachine/sm:ESITO_VALIDAZIONE='KO'&quot;>&#xa;                        &lt;tns1:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;'KO FUORI SEQUENZA - Nessun record trovato nella tabella della Macchina a Stati o nella tabella associativa'&quot;/>&#xa;                        &lt;/tns1:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;171&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:OF_Reschedule_OpenStream_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;170&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;206&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;212&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;208&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request)&quot;>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;207&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;172&quot;/>&#xa;                        &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&#xa;                        &lt;tns1:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:IdRichiesta&quot;/>&#xa;                        &lt;/tns1:ID_RICH_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:ID_RICH_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:IdRichiesta&quot;/>&#xa;                        &lt;/tns1:ID_RICH_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;            &lt;/tns1:StagingIn>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&#xa;                    &lt;tns1:IdRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:IdRichiesta&quot;/>&#xa;                    &lt;/tns1:IdRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:IdRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:IdRichiesta&quot;/>&#xa;                    &lt;/tns1:IdRichiestaOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_OF_IN'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;171&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:OF_Reschedule_OpenStream_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;170&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;206&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;212&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;208&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request)&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;207&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;172&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
