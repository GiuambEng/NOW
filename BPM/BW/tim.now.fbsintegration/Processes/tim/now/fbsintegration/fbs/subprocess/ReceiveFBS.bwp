            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CheckEventiPrec-input"
                    name="CheckEventiPrec"
                    outputVariable="CheckEventiPrec"
                    tibex:xpdlId="0f3ac78a-9bcf-4920-b593-e0749d359f88" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaBPMToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckEventiPrecToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0f3ac78a-9bcf-4920-b593-e0749d359f88+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlliRichiestaFBS&quot;/>&lt;xsl:param name=&quot;ControlliRichiestaFBSRientri&quot;/>&lt;xsl:template name=&quot;CheckEventiPrec-input&quot; match=&quot;/&quot;>&lt;tns4:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ControlliRichiestaFBSRientri)&quot;>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBSRientri/sm:IdRichiesta&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$ControlliRichiestaFBS/sm:IdRichiesta&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATO_ORDINE, TIPO_EVENTO_OF&#xa;  FROM EVENTI_OF_TO_BPM&#xa;  WHERE ID_RICH_OLO=? AND STATO='DA INVIARE'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="STATO_ORDINE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="TIPO_EVENTO_OF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogCheckEventiPrec-input"
                    name="LogCheckEventiPrec"
                    tibex:xpdlId="92ef9818-912e-4dee-beb0-b0de3f3a8d92"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckEventiPrecToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCheckEventiPrecToJDBCQuery">
