            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ControlliRichiestaFBS-input"
                    name="ControlliRichiestaFBS"
                    outputVariable="ControlliRichiestaFBS"
                    tibex:xpdlId="e9cc0084-04be-4e0a-b412-97d8a7c3e4a5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
