lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:N_Recap_Cliente&quot;>&#xa;                            &lt;tns1:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:N_Recap_Cliente&quot;/>&#xa;                            &lt;/tns1:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:N_Recap_Cliente_ALT&quot;>&#xa;                            &lt;tns1:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:N_Recap_Cliente_ALT&quot;/>&#xa;                            &lt;/tns1:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:Nome&quot;>&#xa;                            &lt;tns1:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:Nome&quot;/>&#xa;                            &lt;/tns1:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:CognomeRagioneSociale&quot;>&#xa;                            &lt;tns1:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/tns1:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:CodiceFiscale&quot;>&#xa;                            &lt;tns1:CodiceFiscale>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:CodiceFiscale&quot;/>&#xa;                            &lt;/tns1:CodiceFiscale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:PIVA&quot;>&#xa;                            &lt;tns1:PIVA>&#xa;                                &lt;xsl:value-of select=&quot;