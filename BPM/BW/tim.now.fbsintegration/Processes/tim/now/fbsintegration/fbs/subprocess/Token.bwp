            </endingVariables>
        </task>
        <task name="LogDecodeSECOLOOutput">
            <endingVariables>
                <variable>LogDecodeSECOLOOutput-input</variable>
            </endingVariables>
        </task>
        <task name="LogErrorSECOLO">
            <endingVariables>
                <variable>LogErrorSECOLO-input</variable>
                <variable>_error_SECOLO</variable>
            </endingVariables>
        </task>
        <task name="SECOLO">
            <endingVariables>
                <variable>SECOLO-input</variable>
            </endingVariables>
        </task>
        <task name="DecodeSECOLO">
            <endingVariables>
                <variable>DecodeSECOLO-input</variable>
                <variable>Operatore</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
