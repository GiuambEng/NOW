:ResponseCreate_token>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($DecodeSECOLO/Output/tns3:ResponseDecode_token)&quot;>&lt;tns1:ResponseDecode_token>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:ESITO&quot;/>&lt;/tns1:ESITO>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:DESCRIZIONE&quot;>&lt;tns1:DESCRIZIONE>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:DESCRIZIONE&quot;/>&lt;/tns1:DESCRIZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente&quot;>&lt;tns1:N_Recap_Cliente>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente&quot;/>&lt;/tns1:N_Recap_Cliente>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente_ALT&quot;>&lt;tns1:N_Recap_Cliente_ALT>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente_ALT&quot;/>&lt;/tns1:N_Recap_Cliente_ALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Note&quot;>&lt;tns1:Note>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Note&quot;/>&lt;/tns1:Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Nome&quot;>&lt;tns1:Nome>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Nome&quot;/>&lt;/tns1:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:CognomeRagioneSociale&quot;>&lt;tns1:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:CognomeRagioneSociale&quot;/>&lt;/tns1:CognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:CodiceFiscale&quot;>&lt;tns1:CodiceFiscale>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDec