    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Start</variable>
                <variable>SECOLO</variable>
                <variable>DecodeSECOLO</variable>
            </endingVariables>
        </task>
        <task name="LogStartToken">
            <endingVariables>
                <variable>LogStartToken-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndToken">
            <endingVariables>
                <variable>LogEndToken-input</variable>
            </endingVariables>
        </task>
        <task name="LogSECOLOInput">
            <endingVariables>
                <variable>LogSECOLOInput-input</variable>
            </endingVariables>
        </task>
        <task name="LogSECOLOOutput">
