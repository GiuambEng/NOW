                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd&quot; xmlns:ns4=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns31=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;N7.out&quot;/>&#xa;    &lt;xsl:param name=&quot;N5.out&quot;/>&#xa;    &lt;xsl:param name=&quot;N4.out&quot;/>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;N6.out&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolGenNotfRecuperoTracciato&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN6&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN7&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;xsl:if test=&quot;$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                    &lt;tns9:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns9:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($N4.out)&quot;>&#xa;             