                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns9="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns4="http://NOW.it.telecomitalia.it/casedata_v1" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="ToolGenNotfRecuperoTracciato"/&gt;&lt;xsl:param name="NotificaN4"/&gt;&lt;xsl:param name="NotificaN5"/&gt;&lt;xsl:param name="NotificaN7"/&gt;&lt;xsl:param name="NotificaN6"/&gt;&lt;xsl:template name="ErrorStag-input" match="/"&gt;&lt;tns8:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns9:StagingRequest&gt;&lt;tns9:StagingIn&gt;&lt;xsl:if test="$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO"&gt;&lt;tns9:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO"/&gt;&lt;/tns9:COD_ORDN_OLO&gt;&lt;/xsl:if&gt;&lt;tns9:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Errore generico nel processo InviaNotificaRientriDel82'"/&gt;&lt;/tns9:DESCR_ERRORE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($NotificaN4)"&gt;&lt;tns9:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="201"/&gt;&lt;/tns9:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($NotificaN5)"&gt;&lt;tns9:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="202"/&gt;&lt;/tns9:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($NotificaN6)"&gt;&lt;tns9:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="203"/&gt;&lt;/tns9:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($NotificaN7)"&gt;&lt;tns9:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="204"/&gt;&lt;/tns9:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;tns9:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns9:ID_STATO_ELAB_STAG&gt;&lt;/tns9:StagingIn&gt;&lt;tns9:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_OU