"xsd:integer(xsd:decimal($InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns1:ID_ESEC_PROCSO&gt;&lt;ns1:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns1:LOG_LEVEL&gt;&lt;ns1:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns1:LOG_MESSAGE&gt;&lt;ns1:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TIMSTP_INSMTO&gt;&lt;/ns1:LogFileProcessato&gt;&lt;/tns9:LoggerIn&gt;&lt;/tns9:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns8:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns4=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolGenNotfRecuperoTracciato&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN7&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificaN6&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;xsl:if test=&quot;$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                    &lt;tns9:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ToolGenNotfRecuperoTracciato/ns4:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns9:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo InviaNotificaRientriDel82'&quot;/>&#xa;                &lt;/tns9:DESCR_ERRORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificaN4)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;201&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xs