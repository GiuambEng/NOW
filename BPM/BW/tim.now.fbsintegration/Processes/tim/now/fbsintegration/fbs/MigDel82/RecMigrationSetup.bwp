                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Dro.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:param name=&quot;Olo&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagCow&quot;/>&#xa;    &lt;xsl:param name=&quot;ServOpz&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;IdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceOperatoreRec&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INVIATOD82&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INVIATOD82&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;statoRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'INVIATO'&quot;/>&#xa;            &lt;/statoRichiestaOLO>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'B2B'&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$CodiceOperatoreRec&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_PROGETTO_SPECIALE&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_PROGETTO_SPECIALE&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;ordine>&#xa;                &lt;xsl:if test=&quot;exists($RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE)&quot;>&#xa;                    &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;>&#xa;                        &lt;DAC>&#xa;                            &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                        &lt;/DAC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;cognomeRagioneSociale>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:COGNOME_CLIENTE&quot;/>&#xa;                &lt;/cognomeRagioneSociale>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:NOME_CLIENTE&quot;>&#xa;                    &lt;nome>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:NOME_CLIENTE&quot;/>&#xa;                    &lt;/nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$CodiceOperatoreRec&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;'MIGRAZIONEDEL82'&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;dettaglioordine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH)&quot;>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOVULAFTTH'&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH)&quot;>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSONGAFTTH'&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOEASYIPFTTH'&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;'3971'&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'TECNOLOGIA'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'Z'&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'PROFILOTECNICOLINEA'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH)&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:PROFILO_TECNICO_LINEA&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH)&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:PROFILO_TECNICO_LINEA&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH/tns:PROFILO_TECNICO_LINEA&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;xsl:if test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH) or exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH) or exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH)&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'USERVLAN1TAGGING'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH)&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:USER_VLAN_1_TAGGING&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH)&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'Tagged'&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:USER_VLAN_1_TAGGING&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOLINEA'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'ENCAPSULATION'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH)&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'DOUBLETAG'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH)&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:ENCAPSULATION&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'