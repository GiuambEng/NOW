                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:FULL_GPON_PLUS='SI' and exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:VULA_FTTH)) then 'FULLGPONPLUS' else if ($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:FULL_GPON_PLUS='SI' and exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:BITSTREAM_NGA_FTTH)) then 'FULLGPONPLUSNGA' else if (exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:VULA_FTTH) and $RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:VULA_FTTH/ns0:FLAG_S='SI') then 'SEMIVULAFTTH' else if (exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:VULA_FTTH)) then 'VULAFTTH' else if(exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:BITSTREAM_NGA_FTTH)) then 'BITSTREAMNGAFTTH' else if (exists($RichToken/ns0:OLO_N1Request/ns0:SERVIZIO_FTTH/ns0:EASYIP_NGA_FTTH)) then 'EASYIPNGAFTTH' else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
