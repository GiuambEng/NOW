          &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;'REFERENTEONFIELD'&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;cognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;' '&quot;/>&#xa;                        &lt;/cognomeReferente>&#xa;                        &lt;nomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;substring($RichToken/tns:OLO_N1Request/tns:EMAIL_REFERENTE_TECNICO_OLO, 1, 30)&quot;/>&#xa;                        &lt;/nomeReferente>&#xa;                        &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/referente>&#xa;                &lt;/xsl:if>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$Offerta&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH&quot;>&#xa;                        &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:VULA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH&quot;>&#xa;                        &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:BITSTREAM_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:EASYIP_NGA_FTTH/tns:SLA_PREMIUM_ASSURANCE&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_INDIRIZZO&quot;>&#xa;                    &lt;codAddressSedeCliente>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_INDIRIZZO&quot;/>&#xa;                    &lt;/codAddressSedeCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;flagMigDel82>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/flagMigDel82>&#xa;                &lt;xsl:if test=&quot;string-length($RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO&quot;>&#xa;                        &lt;clusterAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CLUSTER_ACCESSO&quot;/>&#xa;                        &lt;/clusterAccesso>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ordine>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;$Offerta&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;flagNaked>&#xa;                &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;            &lt;/flagNaked>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;IDOfferta>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&#xa;            &lt;/IDOfferta>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;$Dro.parameters/tns0:outputDate&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;$AnagCow/Record[1]/COD_PADRE&quot;>&#xa;                &lt;codificaOLOAGCOMDonating>&#xa;                    &lt;xsl:value-of select=&quot;$AnagCow/Record[1]/COD_PADRE&quot;/>&#xa;                &lt;/codificaOLOAGCOMDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;tipologiaScenario>&#xa;                &lt;xsl:value-of select=&quot;'MIGDEL82'&quot;/>&#xa;            &lt;/tipologiaScenario>&#xa;            &lt;xsl:if test=&quot;exists($RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE)&quot;>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;codiceRisorsaDonating>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COR&quot;/>&#xa;            &lt;/codiceRisorsaDonating>&#xa;            &lt;cowCodeOLO>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COW&quot;/>&#xa;            &lt;/cowCodeOLO>&#xa;            &lt;tipologiaSottolav>&#xa;                &lt;xsl:value-of select=&quot;'MIGRAZIONEDEL82'&quot;/>&#xa;            &lt;/tipologiaSottolav>&#xa;            &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO&quot;>&#xa;                &lt;codOperatoreSecondario>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO&quot;/>&#xa;                &lt;/codOperatoreSecondario>&#xa;            &lt;/xsl:if>&#xa;            &lt;flagMigDel82>&#xa;                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;            &lt;/flagMigDel82>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC='WIN'&quot;>&#xa;                    &lt;oaoSourceB2B>&#xa;                        &lt;xsl:value-of select=&quot;'INF'&quot;/>&#xa;                    &lt;/oaoSourceB2B>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$RichToken/tns:Header/tns:sourceSystem&quot;>&#xa;                        &lt;oaoSourceB2B>&#xa;                            &lt;xsl:value-of select=&quot;$RichToken/tns:Header/tns:sourceSystem&quot;/>&#xa;                        &lt;/oaoSourceB2B>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:ORARIO_APPUNTAMENTO&quot;>&#xa;                &lt;fasciaOrariaAppuntamento>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:ORARIO_APPUNTAMENTO&quot;/>&#xa;                &lt;/fasciaOrariaAppuntamento>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns6:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
