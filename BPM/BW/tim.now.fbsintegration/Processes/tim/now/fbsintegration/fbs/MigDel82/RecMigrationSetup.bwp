            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogControlli-input"
                    name="LogControlli"
                    tibex:xpdlId="912ae20d-dcec-49c9-877e-ce6de9fda869"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
