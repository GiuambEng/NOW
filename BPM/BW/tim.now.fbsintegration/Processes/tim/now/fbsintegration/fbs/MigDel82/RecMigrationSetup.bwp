                portType="ns5:InsertUpdateStagingPortType" tibex:xpdlId="96368233-bbdf-40f2-bb3c-00ad128699ce">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:template name="InsStag-input" match="/"&gt;&lt;tns4:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC"/&gt;&lt;/tns5:COD_ORDN_OLO&gt;&lt;tns5:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($RichToken)"/&gt;&lt;/tns5:CONTENUTO_REQUEST&gt;&lt;xsl:if test="$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE"&gt;&lt;tns5:DATA_ATTIVAZIONE&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE"/&gt;&lt;/tns5:DATA_ATTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="185"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$RichToken/tns:Header/tns:transactionID"&gt;&lt;tns5:ID_RICH&gt;&lt;xsl:value-of select="$RichToken/tns:Header/tns:transactionID"/&gt;&lt;/tns5:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;tns5:CODICEOPERATOREREC&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC"/&gt;&lt;/tns5:CODICEOPERATOREREC&gt;&lt;tns5:IDNOTIFICA&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:ID_NOTIFICA"/&gt;&lt;/tns5:IDNOTIFICA&gt;&lt;tns5:DATANOTIFICA&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATA_NOTIFICA"/&gt;&lt;/tns5:DATANOTIFICA&gt;&lt;tns5:CODICESESSIONE&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:CODICE_SESSIONE"/&gt;&lt;/tns5:CODICESESSIONE&gt;&lt;tns5:NOMEFLUSSO&gt;&lt;xsl:value-of select="'N1'"/&gt;&lt;/tns5:NOMEFLUSSO&gt;&lt;tns5:COR&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COR"/&gt;&lt;/tns5:COR&gt;&lt;tns5:COW&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COW"/&gt;&lt;/tns5:COW&gt;&lt;tns5:COS&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COS"/&gt;&lt;/tns5:COS&gt;&lt;xsl:if test="$RichToken/tns:Header/tns:sourceSystem"&gt;&lt;tns5:SOURCE_SYSTEM&gt;&lt;xsl:value-of select="$RichToken/tns:Header/tns:sourceSystem"/&gt;&lt;/tns5:SOURCE_SYSTEM&gt;&lt;/xsl:if&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="185"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns4:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:template name=&quot;InsStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns5:COD_ORDN_OLO>&#xa;                &lt;tns5:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($RichToken)&quot;/>&#xa;                &lt;/tns5:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;>&#xa;                    &lt;tns5:DATA_ATTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:DATA_ATTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;185&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:Header/tns:transactionID&quot;>&#xa;                    &lt;tns5:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:Header/tns:transactionID&quot;/>&#xa;                    &lt;/tns5:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;tns5:CODICEOPERATOREREC>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC&quot;/>&#xa;                &lt;/tns5:CODICEOPERATOREREC>&#xa;                &lt;tns5:IDNOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:ID_NOTIFICA&quot;/>&#xa;                &lt;/tns5:IDNOTIFICA>&#xa;                &lt;tns5:DATANOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_NOTIFICA&quot;/>&#xa;                &lt;/tns5:DATANOTIFICA>&#xa;                &lt;tns5:CODICESESSIONE>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:CODICE_SESSIONE&quot;/>&#xa;                &lt;/tns5:CODICESESSIONE>&#xa;                &lt;tns5:NOMEFLUSSO>&#xa;                    &lt;xsl:value-of select=&quot;'N1'&quot;/>&#xa;                &lt;/tns5:NOMEFLUSSO>&#xa;                &lt;tns5:COR>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COR&quot;/>&#xa;                &lt;/tns5:COR>&#xa;                &lt;tns5:COW>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COW&quot;/>&#xa;                &lt;/tns5:COW>&#xa;                &lt;tns5:COS>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COS&quot;/>&#xa;                &lt;/tns5:COS>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns:Header/tns:sourceSystem&quot;>&#xa;                    &lt;tns5:SOURCE_SYSTEM>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns:Header/tns:sourceSystem&quot;/>&#xa;                    &lt;/tns5:SOURCE_SYSTEM>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns5:StagingIn>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;185&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="RichTokenToInvoke"/>
