                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogControlliToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ControlliRecMigrationSetup/ns0:ESITO='0'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ControlliRecMigrationSetup/ns0:ESITO='0']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ControlliRecMigrationSetup&quot;/>&lt;xsl:template name=&quot;LogControlli-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecMigrationService'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output controlli: ',tib:render-xml($ControlliRecMigrationSetup))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdStag-input" name="UpdStag"
                operation="InsertUpdateStaging" outputVariable="UpdStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns5:InsertUpdateStagingPortType" tibex:xpdlId="c0f2e453-b70d-4fc2-a43e-1edb1725860a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:param name="ControlliRecMigrationSetup"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns4:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC"/&gt;&lt;/tns5:COD_ORDN_OLO&gt;&lt;tns5:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($ControlliRecMigrationSetup)"/&gt;&lt;/tns5:CONTENUTO_RESPONSE&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="185"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$ControlliRecMigrationSetup/tns:MOTIVAZIONE"&gt;&lt;tns5:MOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliRecMigrationSetup/tns:MOTIVAZIONE"/&gt;&lt;/tns5:MOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ControlliRecMigrationSetup/tns:CODICE_MOTIVAZIONE"&gt;&lt;tns5:CODICEMOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliRecMigrationSetup/tns:CODICE_MOTIVAZIONE"/&gt;&lt;/tns5:CODICEMOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns5:ESITO&gt;&lt;xsl:value-of select="$ControlliRecMigrationSetup/tns:ESITO"/&gt;&lt;/tns5:ESITO&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="185"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns4:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliRecMigrationSetup&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns5:COD_ORDN_OLO>&#xa;                &lt;tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ControlliRecMigrationSetup)&quot;/>&#xa;                &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;185&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$ControlliRecMigrationSetup/tns:MOTIVAZIONE&quot;>&#xa;                    &lt;tns5:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRecMigrationSetup/tns:MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ControlliRecMigrationSetup/tns:CODICE_MOTIVAZIONE&quot;>&#xa;                    &lt;tns5:CODICEMOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRecMigrationSetup/tns:CODICE_MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:CODICEMOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$ControlliRecMigrationSetup/tns:ESITO&quot;/>&#xa;                &lt;/tns5:ESITO>&#xa;            &lt;/tns5:StagingIn>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;185&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogControlliToInvoke"/>
                    <bpws:target linkName="ProcessManagementSubProcessToUpdStag"/>
                </bpws:targets>
