                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&lt;tns7:Element>&lt;tns7:moduleName>&lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&lt;/tns7:moduleName>&lt;tns7:parameterName>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/tns7:parameterName>&lt;tns7:operationName>&lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&lt;/tns7:operationName>&lt;tns7:processName>&lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&lt;/tns7:processName>&lt;tns7:value>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns7:value>&lt;tns7:ID_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns7:ID_FILE>&lt;tns7:ContenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($RichToken)&quot;/>&lt;/tns7:ContenutoXML>&lt;tns7:CodificaOLOAgicom>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns7:CodificaOLOAgicom>&lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&lt;tns7:Ambito>&lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&lt;/tns7:Ambito>&lt;/xsl:if>&lt;tns7:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&lt;/tns7:StrutturaRichiesta>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&lt;tns7:Code_OLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&lt;/tns7:Code_OLO>&lt;/xsl:if>&lt;tns7:Parametro>&lt;xsl:value-of select=&quot;'NGAB2B'&quot;/>&lt;/tns7:Parametro>&lt;/tns7:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
