                  &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'TIPOSERVIZIOFTTH'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:TIPO_SERVIZIO_FTTH&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;          