                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:copyOf="ControlliRecMigrationSetupRientri"
                    tibex:xpdlId="42a89180-8497-4ce9-88a2-ea73ed400f17" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlliRecMigrationSetupRientri&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$ControlliRecMigrationSetupRientri&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="1928a702-fac2-4525-85cf-05f50deab4e6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecMigrationSetupRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Input RecMigrationSetupRientri : ',tib:render-xml($Start))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="OraCorrente"
                    name="OraCorrente" outputVariable="OraCorrente"
                    tibex:xpdlId="b7b3f05d-d510-4c7f-892a-6c74a718c62d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OraCorrenteToGetLocalIP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="substring(string(current-time()), 1, 2)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OraCorrente" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity name="GetLocalIP"
                    outputVariable="GetLocalIP"
                    tibex:xpdlId="1e7e2ba1-c20d-4094-a5d8-cb09fa8bc1e4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OraCorrenteToGetLocalIP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetLocalIPToToken_Skip">
                            <tibex:DesignExpression>
                                <tibex:expression expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GetLocalIPToRichToken">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.GetLocalIP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Token-input"
                    name="Token" outputVariable="Token"
                    tibex:xpdlId="073cd55f-12fc-46c4-91b7-6ae3b5b4fb73"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToToken_Skip"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TokenToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;Operatore&quot;/>&lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&lt;tns1:Request>&lt;tns1:RequestCreate_token>&lt;tns1:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC&quot;/>&lt;/tns1:CodificaOLOAGCOM>&lt;tns1:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&lt;/tns1:CodiceOrdineOLO>&lt;tns1:Funzione>&lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&lt;/tns1:Funzione>&lt;tns1:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($Start/tns:OLO_N1Request/tns:CODICE_ORDINE_REC,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&lt;/tns1:ChiaveRiferimento>&lt;tns1:Operatore>&lt;xsl:value-of select=&quot;$Operatore&quot;/>&lt;/tns1:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns3:IPAddress&quot;>&lt;tns1:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns3:IPAddress&quot;/>&lt;/tns1:IPClient>&lt;/xsl:if>&lt;tns1:N_Recap_Cliente>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_1&quot;/>&lt;/tns1:N_Recap_Cliente>&lt;xsl:if test=&quot;$Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_2&quot;>&lt;tns1:N_Recap_Cliente_ALT>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:RECAPITO_TELEFONICO_CLIENTE_2&quot;/>&lt;/tns1:N_Recap_Cliente_ALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:OLO_N1Request/tns:NOME_CLIENTE&quot;>&lt;tns1:Nome>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:NOME_CLIENTE&quot;/>&lt;/tns1:Nome>&lt;/xsl:if>&lt;tns1:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N1Request/tns:COGNOME_CLIENTE&quot;/>&lt;/tns1:CognomeRagioneSociale>&lt;tns1:TOKENIZZAZIONE>&lt;xsl:value-of select=&quot;'D420'&quot;/>&lt;/tns1:TOKENIZZAZIONE>&lt;/tns1:RequestCreate_token>&lt;tns1:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns1:ProcessIstance>&lt;tns1:StrutturaRichiesta>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/tns1:StrutturaRichiesta>&lt;/tns1:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RichToken-input"
                    name="RichToken" outputVariable="RichToken"
                    tibex:xpdlId="cebada49-4b8e-400f-88d4-a0f81c6e32d1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TokenToMapper"/>
                        <bpws:target linkName="GetLocalIPToRichToken"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RichTokenToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
