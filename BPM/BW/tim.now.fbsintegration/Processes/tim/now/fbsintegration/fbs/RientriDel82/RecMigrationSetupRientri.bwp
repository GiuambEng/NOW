                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:template name="ErrorStag-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC"/&gt;&lt;/tns5:COD_ORDN_OLO&gt;&lt;tns5:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Errore generico nel processo RecMigrationSetupRientri'"/&gt;&lt;/tns5:DESCR_ERRORE&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="198"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="198"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns5:COD_ORDN_OLO>&#xa;                &lt;tns5:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo RecMigrationSetupRientri'&quot;/>&#xa;                &lt;/tns5:DESCR_ERRORE>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;198&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;            &lt;/tns5:StagingIn>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;198&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LogFaultToInvoke"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorStagToRethrow"/>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="ff42c1ae-a7ce-49a7-9db6-fe48da8265ef">
                            <bpws:targets>
                                <bpws:target linkName="ErrorStagToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="OraCorrenteToGetLocalIP" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetLocalIPToToken_Skip"
                    tibex:label="Skip" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="TokenToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="RichTokenToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsStagToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="LogInsStagToControlliRecMigrationSetupRientri" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="ControlliRecMigrationSetupRientriToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogControlliToInvoke" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogControlliToInvoke1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RichiestaToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRichiestaToRenderXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXmlToProcessManagementSubProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="ProcessManagementSubProcessToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToRichiesta" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToOlo" tibex:linkType="SUCCESS"/>
                <bpws:link name="DroToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToAnagCow" tibex:linkType="SUCCESS"/>
