p;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="198"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding