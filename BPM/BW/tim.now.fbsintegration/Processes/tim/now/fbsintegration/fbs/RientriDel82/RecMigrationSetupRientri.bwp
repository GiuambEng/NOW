quest/tns:TELEFONO_REFERENTE_OLO_ONFIELD_NOTECH&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;/referente>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/offerta>&lt;flagRientriDel82>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/flagRientriDel82>&lt;/ordine>&lt;offerta>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;75&quot;/>&lt;/IDOfferta>&lt;DRO>&lt;xsl:value-of select=&quot;$Dro/parameters/tns0:Response/tns0:outputDate&quot;/>&lt;/DRO>&lt;xsl:if test=&quot;$AnagCow/Record[1]/COD_PADRE&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$AnagCow/Record[1]/COD_PADRE&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;'MIGDEL82'&quot;/>&lt;/tipologiaScenario>&lt;xsl:if test=&quot;exists($RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE)&quot;>&lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;/xsl:if>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:CODICE_OPERATORE_REC&quot;/>&lt;/codificaOLOAGCOMRic>&lt;codiceRisorsaDonating>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COR&quot;/>&lt;/codiceRisorsaDonating>&lt;cowCodeOLO>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:DATI_MIGRAZIONE/tns:COW&quot;/>&lt;/cowCodeOLO>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'RIENTRIDEL82'&quot;/>&lt;/tipologiaSottolav>&lt;xsl:if test=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO&quot;>&lt;codOperatoreSecondario>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N1Request/tns:SERVIZIO_FTTH/tns:CODICE_OPERATORE_SECONDARIO&quot