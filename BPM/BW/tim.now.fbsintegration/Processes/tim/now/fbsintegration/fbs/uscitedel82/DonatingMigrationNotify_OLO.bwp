                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cf3b707e-2876-42a4-a293-71d7b251d702+input&quot; xmlns:tns1=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;WHS_Check_sessione&quot;/>&lt;xsl:template name=&quot;Asset-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;IDRISORSAOPENFIBER>&lt;xsl:value-of select=&quot;$WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:COR&quot;/>&lt;/IDRISORSAOPENFIBER>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
