                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ResponseCheckSessione"
                                    name="Response"
                                    outputVariable="ResponseCheckSessione"
                                    tibex:xpdlId="8e7657cc-5949-4a91-a312-b8d4de1cd5ff" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
