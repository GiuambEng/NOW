                                    <bpws:sources>
                                    <bpws:source linkName="ResponseToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WHS_Check_sessione.in&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:param name=&quot;ParametroOre&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseCheckSessione&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(tib:compare-dateTime($WHS_Check_sessione.in/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($WHS_Check_sessione.in/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&#xa;                &lt;tns1:WHS_Check_sessione_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$WHS_Check_sessione.in/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:CODICE_MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06'&quot;/>&#xa;                    &lt;/tns1:CODICE_MOTIVAZIONE>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'Valore campo DATA_NOTIFICA non ammesso'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:WHS_Check_sessione_Resp>&#xa;            &lt;/xsl:when