                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogResponse-input"
                                    name="LogResponse"
                                    tibex:xpdlId="17c84532-7d72-4b7b-9e6c-4b2c9282db42"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ResponseToGenericLogger"/>
