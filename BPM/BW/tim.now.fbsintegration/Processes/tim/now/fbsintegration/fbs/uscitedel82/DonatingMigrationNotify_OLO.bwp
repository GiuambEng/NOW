                                    sqlStatement="SELECT IDRISORSAOPENFIBER, IDRISORSA FROM BDS_1_CASEDATA_ASSET&#xa;WHERE IDRISORSAOPENFIBER=? AND STATOASSET in ('ATTIVO','INLAVORAZIONE') AND OFFERTA='FIBERSTREAM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

