                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WHS_Check_sessione.in&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'WHS_Check_Sessione'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Effettuato insert su staging con codice ordine olo: ',$WHS_Check_sessione.in/tns1:CODICE_ORDINE_WHS)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
