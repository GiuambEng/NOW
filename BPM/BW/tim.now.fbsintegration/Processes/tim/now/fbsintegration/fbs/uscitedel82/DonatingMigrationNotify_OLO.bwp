                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://donatingoperator/wsdl/DonatingMigrationNotify_OLO.wsdl" xmlns:tns1="http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd" version="2.0"&gt;&lt;xsl:param name="WHS_Check_sessione"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:WHS_Check_sessione_Response&gt;&lt;out&gt;&lt;tns1:WHS_Check_sessione_Resp&gt;&lt;tns1:ID_NOTIFICA&gt;&lt;xsl:value-of select="$WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:ID_NOTIFICA"/&gt;&lt;/tns1:ID_NOTIFICA&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/tns1:ESITO&gt;&lt;tns1:CODICE_MOTIVAZIONE&gt;&lt;xsl:value-of select="'A00'"/&gt;&lt;/tns1:CODICE_MOTIVAZIONE&gt;&lt;tns1:MOTIVAZIONE&gt;&lt;xsl:value-of select="'Errore tecnico di interfaccia'"/&gt;&lt;/tns1:MOTIVAZIONE&gt;&lt;/tns1:WHS_Check_sessione_Resp&gt;&lt;/out&gt;&lt;/tns:WHS_Check_sessione_Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
