                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/NOW_VerificaCodiceSessione/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:param name=&quot;WHS_Check_sessione&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:template name=&quot;ResponseCheckSessione&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(tib:compare-dateTime($WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&lt;tns1:WHS_Check_sessione_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06'&quot;/>&lt;/tns1:CODICE_MOTIVAZIONE>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'Valore campo DATA_NOTIFICA non ammesso'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:WHS_Check_sessione_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Asset/Record)=0&quot;>&lt;tns1:WHS_Check_sessione_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$WHS_Check_sessione/in/tns1:WHS_Check_sessione_Req/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&