                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select r.IDRICHIESTAOLO, r.STATORICHIESTANOW, r.STATORICHIESTAOLO, r.IDANAGRAFICACAUSALE, o.DACRIMODULATA, o.DAC from BDS_1_CASEDATA_RICHIESTA r, BDS_1_CASEDATA_ORDINE o where r.IDRICHIESTAOLO = o.IDRICHIESTAOLO and r.LAVORAZIONE='MIGRAZIONE' and r.TIPOLOGIASOTTOLAV='RIENTRIDEL82' and r.CODICEORDINEOLO=? and r.CODIFICAOLOAGCOM=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINEOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="IDANAGRAFICACAUSALE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DACRIMODULATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="DAC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRichiesta-input"
                    name="LogRichiesta"
                    tibex:xpdlId="7b76f688-0b94-49b3-90a0-9dd0346381fb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RichiestaToGenericLogger"/>
