                    tibex:xpdlId="12e2da33-10e3-4489-8d14-c7634e7ffde8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Del82EventiInToGenericLogger"/>
