                                    expression="string-length(string($Richiesta/Record[1]/DACRIMODULATA))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Richiesta/Record[1]/DACRIMODULATA))>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Del82EventiIn&quot;/>&lt;xsl:template name=&quot;LogDel82-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'ControlliRescheduleMigRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output Del82EventiIn : ',tib:render-xml($Del82EventiIn))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCow&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;RicalcoloDacRimodulata&quot;/>&lt;xsl:param name=&quot;Del82EventiIn&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:param name=&quot;DataAtt&quot;/>&lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagCow/Record)=0&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not(substring($Start/tns1:OLO_N3Request/tns1:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns1:OLO_N3Request/tns1:CODICE_ORDINE_REC, 1, 3)=$Start/tns1:OLO_N3Request/tns1:CODICE_OPERATORE_REC)&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Richiesta/Record)=0 or $Richiesta/Record[1]/STATORICHIESTAOLO=('ACQUISITOKO','ACCETTATOKO','ESPLETATOKO','ESPLETATO','INVIATO','INANNULLAMENTO','ESPLETAMENTOTECNICOKO') or ($Richiesta/Record[1]/STATORICHIESTAOLO='ACCETTATO' and tib:compare-dateTime(current-dateTime(), $RicalcoloDacRimodulata)>-1)&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns1:OLO_N3Request/tns1:CODICE_OPERATORE_WHS='FOP')&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Del82EventiIn/Record[1]/COUNT>0&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($DataAtt/parameters/tns0:Response/tns0:outputDate, $Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE)=1)&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Richiesta/Record[1]/STATORICHIESTAOLO='ACCETTATO' and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE, xsd:date($Richiesta/Record[1]/DACRIMODULATA))&amp;lt;1&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;$Richiesta/Record[1]/STATORICHIESTAOLO=('ACQUISITO','SOSPESO') and $Richiesta/Record[1]/STATORICHIESTANOW='SOSPESOD82' and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE, xsd:date($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA))=-1&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Richiesta/Record[1]/DACRIMODULATA))>0 and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE,xsd:date($Richiesta/Record[1]/DACRIMODULATA))&amp;lt;1&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Richiesta/Record[1]/DACRIMODULATA))=0 and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE,xsd:date($Richiesta/Record[1]/DAC))&amp;lt;1&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/tns1:OLO_N3Request/tns1:ORARIO_APPUNTAMENTO))>0 and not(substring(string($Start/tns1:OLO_N3Request/tns1:ORARIO_APPUNTAMENTO),1,8)=('08:30:00','11:30:00','14:30:00','16:30:00','18:30:00'))&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_15'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1)>0 and string(number($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:when test=&quot;not($Start/tns1:OLO_N3Request/tns1:CODICE_MOTIVAZIONE=('C08','D13'))&quot;>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:ESITO>&lt;tns1:MOTIVAZIONE>&lt;xsl:value-of select=&quot;'A06_INT_18'&quot;/>&lt;/tns1:MOTIVAZIONE>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Rec_RescheduleMig_Resp>&lt;tns1:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&lt;/tns1:ID_NOTIFICA>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns1:ESITO>&lt;/tns1:Rec_RescheduleMig_Resp>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Controlli-input" name="Controlli"
                    outputVariable="Controlli"
                    tibex:xpdlId="22d9c009-3d05-4fbb-8979-e45cd1855f24" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToControlli"/>
                        <bpws:target linkName="LogDataAttToControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlliToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DataAtt.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagCow&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RicalcoloDacRimodulata&quot;/>&#xa;    &lt;xsl:param name=&quot;Del82EventiIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ParametroOre&quot;/>&#xa;    &lt;xsl:template name=&quot;Controlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($AnagCow/Record)=0&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(substring($Start/tns1:OLO_N3Request/tns1:CODICE_ORDINE_REC, 4, 1)='_') or not(substring($Start/tns1:OLO_N3Request/tns1:CODICE_ORDINE_REC, 1, 3)=$Start/tns1:OLO_N3Request/tns1:CODICE_OPERATORE_REC)&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($Richiesta/Record)=0 or $Richiesta/Record[1]/STATORICHIESTAOLO=('ACQUISITOKO','ACCETTATOKO','ESPLETATOKO','ESPLETATO','INVIATO','INANNULLAMENTO','ESPLETAMENTOTECNICOKO') or ($Richiesta/Record[1]/STATORICHIESTAOLO='ACCETTATO' and tib:compare-dateTime(current-dateTime(), $RicalcoloDacRimodulata)>-1)&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A07_INT_1'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not($Start/tns1:OLO_N3Request/tns1:CODICE_OPERATORE_WHS='FOP')&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Del82EventiIn/Record[1]/COUNT>0&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_4'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(tib:compare-dateTime($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1)&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length(string($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE))>0 and (tib:compare-date($DataAtt.parameters/tns0:outputDate, $Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE)=1)&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Richiesta/Record[1]/STATORICHIESTAOLO='ACCETTATO' and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE, xsd:date($Richiesta/Record[1]/DACRIMODULATA))&amp;lt;1&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Richiesta/Record[1]/STATORICHIESTAOLO=('ACQUISITO','SOSPESO') and $Richiesta/Record[1]/STATORICHIESTANOW='SOSPESOD82' and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE, xsd:date($Start/tns1:OLO_N3Request/tns1:DATA_NOTIFICA))=-1&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length(string($Richiesta/Record[1]/DACRIMODULATA))>0 and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE,xsd:date($Richiesta/Record[1]/DACRIMODULATA))&amp;lt;1&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length(string($Richiesta/Record[1]/DACRIMODULATA))=0 and tib:compare-date($Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE,xsd:date($Richiesta/Record[1]/DAC))&amp;lt;1&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_19'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length(string($Start/tns1:OLO_N3Request/tns1:ORARIO_APPUNTAMENTO))>0 and not(substring(string($Start/tns1:OLO_N3Request/tns1:ORARIO_APPUNTAMENTO),1,8)=('08:30:00','11:30:00','14:30:00','16:30:00','18:30:00'))&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_15'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1)>0 and string(number($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_1))='NaN'&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_7'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2)>0 and string(number($Start/tns1:OLO_N3Request/tns1:RECAPITO_TELEFONICO_CLIENTE_2))='NaN'&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_8'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not($Start/tns1:OLO_N3Request/tns1:CODICE_MOTIVAZIONE=('C08','D13'))&quot;>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;tns1:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'A06_INT_18'&quot;/>&#xa;                    &lt;/tns1:MOTIVAZIONE>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Rec_RescheduleMig_Resp>&#xa;                    &lt;tns1:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns1:ID_NOTIFICA>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                &lt;/tns1:Rec_RescheduleMig_Resp>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecipientMigrationServiceSchema_OLO_Fiberstream.xsd="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecipientMigrationServiceSchema_OLO_Fiberstream.xsd:Rec_RescheduleMig_Resp" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RicalcoloDacRimodulata"
                    name="RicalcoloDacRimodulata"
                    outputVariable="RicalcoloDacRimodulata"
                    tibex:xpdlId="89058bf5-69cc-4746-a0e7-708eeab06f4a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDel82ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RicalcoloDacRimodulataToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Richiesta/Record[1]/DACRIMODULATA), month-from-dateTime($Richiesta/Record[1]/DACRIMODULATA), day-from-dateTime($Richiesta/Record[1]/DACRIMODULATA), 18, 00, 00), 0, 0, -1, 0, 0, 0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="RicalcoloDacRimodulata" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogDac-input"
                    name="LogDac"
                    tibex:xpdlId="1df7553f-9d9e-442d-be33-b5110acefa7a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RicalcoloDacRimodulataToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDacToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;RicalcoloDacRimodulata&quot;/>&lt;xsl:template name=&quot;LogDac-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'ControlliRescheduleMigRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Ricalcolata DAC Rimodulata : ',xsd:string($RicalcoloDacRimodulata))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="c5d88c22-10a0-47d7-bdba-9d7ee8cabb68">
                <bpws:targets>
                    <bpws:target linkName="LogDel82ToEmpty"/>
                    <bpws:target linkName="LogDacToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToControlli">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($Start/ns0:OLO_N3Request/ns0:DATA_PREVISTA_ATTIVAZIONE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Start/ns0:OLO_N3Request/ns0:DATA_PREVISTA_ATTIVAZIONE))>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="DataAtt-input" name="DataAtt"
                operation="calcNextDateByDuration"
                outputVariable="DataAtt"
                partnerLink="GetNextDatePortType"
                portType="ns10:GetNextDatePortType" tibex:xpdlId="f7c86547-5b05-4ac7-80ab-b1155680cf8f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns0="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tns1="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="DataAtt-input" match="/"&gt;
        &lt;tns5:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns0:Request&gt;
                    &lt;tns0:inputDate&gt;
                        &lt;xsl:value-of select="$Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE"/&gt;
                    &lt;/tns0:inputDate&gt;
                    &lt;tns0:inputDuration&gt;
                        &lt;xsl:value-of select="'PT9H'"/&gt;
                    &lt;/tns0:inputDuration&gt;
                &lt;/tns0:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns5:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;DataAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:Request>&#xa;            &lt;tns0:inputDate>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:OLO_N3Request/tns1:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;            &lt;/tns0:inputDate>&#xa;            &lt;tns0:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns0:inputDuration>&#xa;        &lt;/tns0:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="EmptyToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DataAttToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;DataAtt&quot;/>&lt;xsl:template name=&quot;LogDataAtt-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'ControlliRescheduleMigRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Data attivazione : ',string($DataAtt/parameters/tns0:Response/tns0:outputDate))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogDataAtt-input" name="LogDataAtt"
                    tibex:xpdlId="e80028ea-15a8-4b1e-b839-5756c8bb5c5e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DataAttToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDataAttToControlli"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DataAtt.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDataAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ControlliRescheduleMigRientri'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Data attivazione : ',string($DataAtt.parameters/tns0:outputDate))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogControlli-input"
                    name="LogControlli"
                    tibex:xpdlId="6bb4cf31-8559-4ac5-be27-682d01bced15"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlliToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogControlliToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
