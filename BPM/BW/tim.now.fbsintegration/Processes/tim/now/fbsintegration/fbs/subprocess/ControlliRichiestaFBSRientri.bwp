                    <bpws:sources>
                        <bpws:source linkName="ControlliSFInProgToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:param name=&quot;CodiceMotivazione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Controlli&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($IdRichiestaOlo/Record[1]/IDRICHIESTAOLO)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A03'&quot;/>&lt;/sm:CodiceMotivazione>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&lt;/sm:Motivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and $Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE=('0','2') and $Start/sm:WHS_StatusUpdateMig_Request/sm:FLAG_DESOSPENSIONE='SI' and count($CodiceMotivazione/Record)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A03'&quot;/>&lt;/sm:CodiceMotivazione>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&lt;/sm:Motivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and not($Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE=('0','1','2','3','4','5'))&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A02'&quot;/>&lt;/sm:CodiceMotivazione>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Valore campo STATO_ORDINE non ammesso'&quot;/>&lt;/sm:Motivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and $Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE=('0','1','2','3','4','5') and (string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_REC)=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_REC)=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_WHS)=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_WHS)=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:ID_NOTIFICA)=0 or string-length(string($Start/sm:WHS_StatusUpdateMig_Request/sm:DATA_NOTIFICA))=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE)=0)&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_REC)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_REC obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_REC)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_ORDINE_REC obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_WHS)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_WHS obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_WHS)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_ORDINE_WHS obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:ID_NOTIFICA)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo ID_NOTIFICA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/sm:WHS_StatusUpdateMig_Request/sm:DATA_NOTIFICA))=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo DATA_NOTIFICA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo STATO_ORDINE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and $Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE=('1','3','4','5') and (string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_MOTIVAZIONE)=0 or string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:MOTIVAZIONE)=0)&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_MOTIVAZIONE)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and $Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE='2' and string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:ID_SERVIZIO)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo ID_SERVIZIO obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and $Start/sm:WHS_StatusUpdateMig_Request/sm:STATO_ORDINE=('0','1','2','3','4','5') and (exists($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:VLAN[string-length(sm:USER_VLAN)=0]) or exists($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:VLAN[string-length(sm:SERVICE_VLAN)=0]) or exists($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:VLAN[string-length(sm:CUSTOMER_VLAN)=0]))&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:VLAN[string-length(sm:USER_VLAN)=0])&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo USER_VLAN obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request/sm:SERVIZIO_FTTH/sm:VLAN[string-length(sm:SERVICE_VLAN)=0])&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo SERVICE_VLAN obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CUSTOMER_VLAN obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request) and (string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_OPERATORE_REC)=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_REC)=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_OPERATORE_WHS)=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_WHS)=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:ID_NOTIFICA)=0 or string-length(string($Start/sm:WHS_RescheduleMig_Request/sm:DATA_NOTIFICA))=0 or string-length(string($Start/sm:WHS_RescheduleMig_Request/sm:DATA_PREVISTA_ATTIVAZIONE))=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_MOTIVAZIONE)=0 or string-length($Start/sm:WHS_RescheduleMig_Request/sm:MOTIVAZIONE)=0)&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_OPERATORE_REC)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_REC obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_REC)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_ORDINE_REC obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_OPERATORE_WHS)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_WHS obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_WHS)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_ORDINE_WHS obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:ID_NOTIFICA)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo ID_NOTIFICA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/sm:WHS_RescheduleMig_Request/sm:DATA_NOTIFICA))=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo DATA_NOTIFICA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($Start/sm:WHS_RescheduleMig_Request/sm:DATA_PREVISTA_ATTIVAZIONE))=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo DATA_PREVISTA_ATTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_MOTIVAZIONE)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request) and (string-length($Start/sm:WHS_Event_Request/sm:CODICE_OPERATORE_REC)=0 or string-length($Start/sm:WHS_Event_Request/sm:CODICE_ORDINE_REC)=0 or string-length($Start/sm:WHS_Event_Request/sm:CODICE_OPERATORE_WHS)=0 or string-length($Start/sm:WHS_Event_Request/sm:CODICE_ORDINE_WHS)=0 or string-length($Start/sm:WHS_Event_Request/sm:ID_NOTIFICA)=0 or string-length(string($Start/sm:WHS_Event_Request/sm:DATA_NOTIFICA))=0 or string-length(string($Start/sm:WHS_Event_Request/sm:DATA_AVVIO_POLICY_CONTATTO))=0 or string-length($Start/sm:WHS_Event_Request/sm:TIPOLOGIA_EVENTO