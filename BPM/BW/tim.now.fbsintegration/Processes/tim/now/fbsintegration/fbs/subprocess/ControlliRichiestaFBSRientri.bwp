            <bpws:empty name="Empty" tibex:xpdlId="de4fafd4-9256-4385-96ff-46482edb0907">
                <bpws:targets>
                    <bpws:target linkName="LogControlliToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToControlliSFInProg">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($IdRichiestaOlo/Record[1]/IDRICHIESTAOLO)>0 and exists($Start/ns0:WHS_StatusUpdateMig_Request) and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:STATO_ORDINE=('0','2') and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:FLAG_DESOSPENSIONE='SI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($IdRichiestaOlo/Record[1]/IDRICHIESTAOLO)>0 and exists($Start/ns0:WHS_StatusUpdateMig_Request) and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:STATO_ORDINE=('0','2') and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:FLAG_DESOSPENSIONE='SI']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CodiceMotivazione-input"
                    name="CodiceMotivazione"
                    outputVariable="CodiceMotivazione"
                    tibex:xpdlId="df8454b0-c7bb-4d81-8c73-39b62ec973b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodiceMotivazioneToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+df8454b0-c7bb-4d81-8c73-39b62ec973b9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:template name=&quot;CodiceMotivazione-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;id_rich_olo>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdRichiestaOlo/Record[1]/IDRICHIESTAOLO)&quot;>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/id_rich_olo>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select anof.codicemotivazione&#xa;from anagrafica_esito_open_fiber anof, anag_caus an, eventi_of_to_bpm_semaforo sem&#xa;where anof.categoria='SOSPESO' &#xa;and anof.codcluster='OF' &#xa;and anof.codicemotivazione=an.cod_caus_olo&#xa;and an.id_anag_caus=sem.idanagraficacausale&#xa;and sem.statorichiestaof='SOSPESOOF' and sem.id_rich_olo=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="id_rich_olo"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CODICEMOTIVAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCodiceMot-input"
                    name="LogCodiceMot"
                    tibex:xpdlId="a2b6b7d4-f59e-4aa0-8cf7-840bf86056e7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiceMotivazioneToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToControlliSFInProg"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;CodiceMotivazione&quot;/>&lt;xsl:template name=&quot;LogCodiceMot-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'ControlliRichiestaFBSRientri'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Recuperato codice motivazione: ',tib:render-xml($CodiceMotivazione))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogControlli2-input"
                    name="LogControlli2"
                    tibex:xpdlId="4436014b-f7b2-486f-87cd-41c4c69b8ddf"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlliSFInProgToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogControlli2ToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Controlli&quot;/>&lt;xsl:template name=&quot;LogControlli2-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'ControlliRichiestaFBSRientri'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output ControlliSFInProgress : ',tib:render-xml($Controlli))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="0fa90999-0f02-44b8-aba7-010c2f62e1f9">
                <bpws:targets>
                    <bpws:target linkName="LogControlli2ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns0:WHS_CompletionOrderMig_Request/ns0:SERVIZI_OPZIONALI/ns0:APPARATO) and $Controlli/ns0:CodiceMotivazione='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns0:WHS_CompletionOrderMig_Request/ns0:SERVIZI_OPZIONALI/ns0:APPARATO) and $Controlli/ns0:CodiceMotivazione='OK']]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="d19611e3-68e5-4267-bd05-2a94b40c5f17">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="78ba732b-b38e-4f92-8fb1-096287bbc74b">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Controlli"
                                    name="ControlliApparato"
                                    outputVariable="Controlli"
                                    tibex:xpdlId="1accab80-2843-438c-8f44-a8bab75e956c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:template name=&quot;Controlli&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:TIPOLOGIA_APPARATO)>0 and string-length($Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:ESITO_CONSEGNA_APPARATO)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo ESITO_CONSEGNA_APPARATO obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:ESITO_CONSEGNA_APPARATO=('0','3','5') and (string-length($Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:CODICE_MOTIVAZIONE_CONSEGNA)=0 or string-length($Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:MOTIVAZIONE_CONSEGNA)=0)&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/sm:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO[$index]/sm:CODICE_MOTIVAZIONE_CONSEGNA)=0&quot;>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_MOTIVAZIONE_CONSEGNA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:Motivazione>&lt;xsl:value-of select=&quot;'Campo MOTIVAZIONE_CONSEGNA obbligatorio non valorizzato'&quot;/>&lt;/sm:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Controlli" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:empty name="Empty1" tibex:xpdlId="4fff9a8f-22d7-42a5-8d3d-06e0af140990">
                <bpws:targets>
                    <bpws:target linkName="LogRichToEmpty1"/>
                    <bpws:target linkName="LogIdRichiestaToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToDataAtt">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($Start/ns0:WHS_StatusUpdateMig_Request/ns0:DATA_PREVISTA_ATTIVAZIONE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($Start/ns0:WHS_StatusUpdateMig_Request/ns0:DATA_PREVISTA_ATTIVAZIONE))>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToControlliSFFastdata">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
