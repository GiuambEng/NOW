            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Controlli"
                    name="ControlliSFFastdata"
                    outputVariable="Controlli"
                    tibex:xpdlId="804a4905-a2b4-405d-b338-12174a8f6d8a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToControlliSFFastdata"/>
                        <bpws:target linkName="GenericLoggerToControlliSFFastdata1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlliSFFastdataToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParametroOre&quot;/>&lt;xsl:template name=&quot;Controlli&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_REC)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A06_INT_1'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_REC)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A06_INT_2'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_WHS)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A06_INT_17'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and string-length($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_OPERATORE_WHS)=0&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A06_INT_3'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request) and ((tib:compare-dateTime($Start/sm:WHS_StatusUpdateMig_Request/sm:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, abs($ParametroOre), 0, 0)) > -1) or (tib:compare-dateTime($Start/sm:WHS_StatusUpdateMig_Request/sm:DATA_NOTIFICA, tib:add-to-dateTime(current-dateTime(), 0, 0, 0, $ParametroOre, 0, 0)) &amp;lt; 1))&quot;>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A06_INT_5'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;sm:ControlliRichiestaOutput>&lt;sm:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/sm:IdRichiesta>&lt;sm:CodiceMotivazione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/sm:CodiceMotivazione>&lt;/sm:ControlliRichiestaOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
