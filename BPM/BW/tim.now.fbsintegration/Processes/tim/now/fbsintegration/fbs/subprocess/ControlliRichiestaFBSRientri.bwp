                    <bpws:sources>
                        <bpws:source linkName="IdRichiestaOloToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+754ac70a-df25-4654-b0c8-1f6a01bcd9cf+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;IdRichiestaOlo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request)&quot;>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_REC)&quot;>&lt;xsl:value-of select=&quot;$Start/sm:WHS_StatusUpdateMig_Request/sm:CODICE_ORDINE_REC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request)&quot;>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_REC)&quot;>&lt;xsl:value-of select=&quot;$Start/sm:WHS_RescheduleMig_Request/sm:CODICE_ORDINE_REC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request)&quot;>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_CompletionOrderMig_Request/sm:CODICE_ORDINE_REC)&quot;>&lt;xsl:value-of select=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:CODICE_ORDINE_REC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:WHS_Event_Request/sm:CODICE_ORDINE_REC)&quot;>&lt;xsl:value-of select=&quot;$Start/sm:WHS_Event_Request/sm:CODICE_ORDINE_REC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select idrichiestaolo &#xa;from codice_ordine_olo_openfiber &#xa;where codordineoloopenfiber=?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codordineoloopenfiber"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogIdRichiesta-input"
                    name="LogIdRichiesta"
                    tibex:xpdlId="8a6dc717-a254-486b-9fc5-b8812d93558a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IdRichiestaOloToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogIdRichiestaToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Start/ns0:WHS_StatusUpdateMig_Request)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($Start/ns0:WHS_StatusUpdateMig_Request)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogIdRichiestaToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:template name=&quot;LogIdRichiesta-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'ControlliRichiestaFBSRientri'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Recuperato id richiesta olo: ',tib:render-xml($IdRichiestaOlo))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
