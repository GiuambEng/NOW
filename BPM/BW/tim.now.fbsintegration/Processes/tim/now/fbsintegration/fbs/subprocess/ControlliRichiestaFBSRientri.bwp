                    outputVariable="IdRichiestaOlo"
                    tibex:xpdlId="754ac70a-df25-4654-b0c8-1f6a01bcd9cf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
