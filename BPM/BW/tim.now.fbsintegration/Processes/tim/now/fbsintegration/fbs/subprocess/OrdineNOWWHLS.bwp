            </endingVariables>
        </task>
        <task name="OrdnNowWhls">
            <endingVariables>
                <variable>OrdnNowWhls-input</variable>
                <variable>OrdnNowWhls</variable>
                <variable>IDTPLG_EVENTO</variable>
            </endingVariables>
        </task>
        <task name="LogOutput">
            <endingVariables>
