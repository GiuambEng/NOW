        <task name="EventoOF">
            <endingVariables>
                <variable>EventoOF-input</variable>
                <variable>EventoOF</variable>
                <variable>MapEventoOF</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
