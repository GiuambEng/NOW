    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Nextval</variable>
                <variable>Start</variable>
            </endingVariables>
        </task>
        <task name="LogInput">
            <endingVariables>
                <variable>LogInput-input</variable>
            </endingVariables>
        </task>
        <task name="IDTPLG_EVENTO">
            <endingVariables>
