                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tns2=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MigrationSetup.out&quot;/>&#xa;    &lt;xsl:param name=&quot;Reschedule.out&quot;/>&#xa;    &lt;xsl:param name=&quot;StatusUpdate.out&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                &lt;tns:SendFBSResponse>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;tns:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$MigrationSetup.out/tns2:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns:ID_NOTIFICA>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$MigrationSetup.out/tns2:ESITO&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$MigrationSetup.out/tns2:CODICE_MOTIVAZIONE&quot;>&#xa;                        &lt;tns:CODICE_MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$MigrationSetup.out/tns2:CODICE_MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:CODICE_MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MigrationSetup.out/tns2:MOTIVAZIONE&quot;>&#xa;                       