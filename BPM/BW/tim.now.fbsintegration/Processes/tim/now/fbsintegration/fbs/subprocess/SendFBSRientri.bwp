                    tibex:xpdlId="3a405bc1-857d-4e61-8ed6-3f79c13225fe"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStagingToGenericLogger1"/>
