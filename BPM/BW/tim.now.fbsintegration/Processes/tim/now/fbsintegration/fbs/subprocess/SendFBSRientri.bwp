            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperStatusUpdate-input"
                    name="MapperStatusUpdate"
                    outputVariable="MapperStatusUpdate"
                    tibex:xpdlId="438267b7-7736-4326-a912-a0c0a8b2db89" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapperStatusUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperStatusUpdateToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;Del82EventiIn&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapperStatusUpdate-input&quot; match=&quot;/&quot;>&lt;tns2:Rec_StatusUpdateMig_Req>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/caratterizzazioneArea='AN'&quot;>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'COC'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=1&quot;>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber, &amp;quot;TLC_&amp;quot;)&quot;>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns2:CODICE_ORDINE_REC>&lt;tns2:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'OF'&quot;/>&lt;/tns2:CODICE_OPERATORE_WHS>&lt;tns2:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns2:ID_NOTI