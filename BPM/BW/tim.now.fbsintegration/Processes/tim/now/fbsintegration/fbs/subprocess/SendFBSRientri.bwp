&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns="http://www.tim.com/NOW/xsd/SendFBS/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:sm="http://www.tim.com/NOW/xsd/StateMachineOF/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="MapperMigrationSetup"/&gt;&lt;xsl:param name="MapperReschedule"/&gt;&lt;xsl:param name="MapperStatusUpdate"/&gt;&lt;xsl:param name="TransactionId"/&gt;&lt;xsl:param name="OrdineNOWWHLS"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns3:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns4:StagingRequest&gt;&lt;tns4:StagingIn&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperMigrationSetup)"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'"&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperReschedule)"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($MapperStatusUpdate)"/&gt;&lt;/tns4:CONTENUTO_REQUEST&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="205"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'"&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="211"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="210"/&gt;&lt;/tns4:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns4:ID_RICH_OLO&gt;&lt;xsl:if test="$Start/tns:RichiestaElement/IDRisorsa"&gt;&lt;tns4:ID_RISORSA&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRisorsa"/&gt;&lt;/tns4:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;tns4:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns4:ID_STATO_ELAB_STAG&gt;&lt;tns4:TRANSACTION_ID&gt;&lt;xsl:value-of select="$TransactionId"/&gt;&lt;/tns4:TRANSACTION_ID&gt;&lt;tns4:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:value-of select="xsd:int($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls)"/&gt;&lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS&gt;&lt;xsl:if test="$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber"&gt;&lt;tns4:CODICEORDINEOLOOF&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber"/&gt;&lt;/tns4:CODICEORDINEOLOOF&gt;&lt;/xsl:if&gt;&lt;/tns4:StagingIn&gt;&lt;tns4:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns4:IdRichiestaOLO&gt;&lt;tns4:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_OF_OUT'"/&gt;&lt;/tns4:StagingType&gt;&lt;tns4:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='EMISSIONEOF'"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="205"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'"&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="211"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="210"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns4:LoggerIn&gt;&lt;/tns4:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns3:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperMigrationSetup&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperReschedule&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperStatusUpdate&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                        &lt;tns4:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperMigrationSetup)&quot;/>&#xa;                        &lt;/tns4:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'&quot;>&#xa;                        &lt;tns4:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperReschedule)&quot;/>&#xa;                        &lt;/tns4:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperStatusUpdate)&quot;/>&#xa;                        &lt;/tns4:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;205&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'&quot;>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;211&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;210&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$Start/tns:RichiestaElement/IDRisorsa&quot;>&#xa;                    &lt;tns4:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRisorsa&quot;/>&#xa;                    &lt;/tns4:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;                &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls)&quot;/>&#xa;                &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;>&#xa;                    &lt;tns4:CODICEORDINEOLOOF>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&#xa;                    &lt;/tns4:CODICEORDINEOLOOF>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns4:IdRichiestaOLO>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_OF_OUT'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;205&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'&quot;>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;211&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;210&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
