                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:tns15=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:param name=&quot;RichOloDett&quot;/>&lt;xsl:param name=&quot;AggiuntiviApparatiInterventoUnico&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapperMigrationSetup-input&quot; match=&quot;/&quot;>&lt;tns2:Rec_MigrationSetup_Req>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/caratterizzazioneArea='AN'&quot;>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'COC'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=1&quot;>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns2:CODICE_OPERATORE_REC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&lt;/tns2:CODICE_ORDINE_REC>&lt;tns2:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'OF'&quot;/>&lt;/tns2:CODICE_OPERATORE_WHS>&lt;tns2:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/tns2:ID_NOTIFICA>&lt;tns2:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:DATA_NOTIFICA>&lt;xsl:if test=&quot;$RichOloDett/Record[NOME='NOMEREFERENTETECNICOOLO']/VALORE&quot;>&lt;tns2:NOME_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='NOMEREFERENTETECNICOOLO']/VALORE&quot;/>&lt;/tns2:NOME_REFERENTE_TECNICO_OLO>&lt;/xsl:if>&lt;tns2:COGNOME_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='COGNOMEREFERENTETECNICOOLO']/VALORE&quot;/>&lt;/tns2:COGNOME_REFERENTE_TECNICO_OLO>&lt;tns2:TELEFONO_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='TELEFONOREFERENTETECNICOOLO']/VALORE&quot;/>&lt;/tns2:TELEFONO_REFERENTE_TECNICO_OLO>&lt;tns2:EMAIL_REFERENTE_TECNICO_OLO>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='EMAILREFERENTETECNICOOLO']/VALORE&quot;/>&lt;/tns2:EMAIL_REFERENTE_TECNICO_OLO>&lt;xsl:if test=&quot;$RichOloDett/Record[NOME='NOMECLIENTE']/VALORE&quot;>&lt;tns2:NOME_CLIENTE>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='NOMECLIENTE']/VALORE&quot;/>&lt;/tns2:NOME_CLIENTE>&lt;/xsl:if>&lt;tns2:COGNOME_CLIENTE>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='COGNOMECLIENTE']/VALORE&quot;/>&lt;/tns2:COGNOME_CLIENTE>&lt;tns2:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='RECAPITOTELEFONICOCLIENTE1']/VALORE&quot;/>&lt;/tns2:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:if test=&quot;$RichOloDett/Record[NOME='RECAPITOTELEFONICOCLIENTE2']/VALORE&quot;>&lt;tns2:RECAPITO_TELEFONICO_CLIENTE_2>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='RECAPITOTELEFONICOCLIENTE2']/VALORE&quot;/>&lt;/tns2:RECAPITO_TELEFONICO_CLIENTE_2>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:RichiestaElement/ordine/DAC)&quot;>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/DAC&quot;>&lt;tns2:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/DAC&quot;/>&lt;/tns2:DATA_PREVISTA_ATTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/note&quot;>&lt;tns2:NOTE>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/note&quot;/>&lt;/tns2:NOTE>&lt;/xsl:if>&lt;tns2:DATI_MIGRAZIONE>&lt;tns2:CODICE_SESSIONE>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='CODICESESSIONE']/VALORE&quot;/>&lt;/tns2:CODICE_SESSIONE>&lt;tns2:COR>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='COR']/VALORE&quot;/>&lt;/tns2:COR>&lt;tns2:COW>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='COW']/VALORE&quot;/>&lt;/tns2:COW>&lt;tns2:COS>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='COS']/VALORE&quot;/>&lt;/tns2:COS>&lt;/tns2:DATI_MIGRAZIONE>&lt;xsl:if test=&quot;count($RichOloDett/Record[NOME='DN'])>0&quot;>&lt;tns2:NUMERAZIONI>&lt;xsl:for-each select=&quot;$RichOloDett/Record[NOME='DN']&quot;>&lt;tns2:DN>&lt;xsl:value-of select=&quot;VALORE&quot;/>&lt;/tns2:DN>&lt;/xsl:for-each>&lt;/tns2:NUMERAZIONI>&lt;/xsl:if>&lt;tns2:SERVIZIO_FTTH>&lt;tns2:TIPO_SERVIZO_FTTH>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='TIPOSERVIZIOFTTH']/VALORE&quot;/>&lt;/tns2:TIPO_SERVIZO_FTTH>&lt;tns2:IDENTIFICATIVO_DEL_POP>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='IDENTIFICATIVODELPOP']/VALORE&quot;/>&lt;/tns2:IDENTIFICATIVO_DEL_POP>&lt;xsl:if test=&quot;$RichOloDett/Record[NOME='PROFILO']/VALORE&quot;>&lt;tns2:PROFILO>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='PROFILO']/VALORE&quot;/>&lt;/tns2:PROFILO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichOloDett/Record[NOME='PROMOZIONE']/VALORE&quot;>&lt;tns2:PROMOZIONE>&lt;xsl:value-of select=&quot;$RichOloDett/Record[NOME='PROMOZIONE']/VALORE&quot;/>&lt;/tns2:PROMOZIONE>&lt;/xsl:if>&lt;tns2:CODICE_OPERATORE_SECONDARIO>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns2:CODICE_OPERATORE_SECONDARIO>&lt;xsl:for-each select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;xsl:variable name=&quot;USERVLAN&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo&quot;/>&lt;xsl:variable name=&quot;PROFILOVLAN&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo&quot;/>&lt;tns2:VLAN>&lt;tns2:KIT_CONSEGNA_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'IDKIT']/valoreAttributo&quot;/>&lt;/tns2:KIT_CONSEGNA_VLAN>&lt;tns2:USER_VLAN>&lt;xsl:value-of select=&quot;$USERVLAN&quot;/>&lt;/tns2:USER_VLAN>&lt;tns2:SERVICE_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'SERVICEVLAN']/valoreAttributo&quot;/>&lt;/tns2:SERVICE_VLAN>&lt;tns2:PROFILO_VLAN>&lt;xsl:value-of select=&quot;$PROFILOVLAN&quot;/>&lt;/tns2:PROFILO_VLAN>&lt;xsl:if test=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'CVLAN']/valoreAttributo&quot;>&lt;tns2:CUSTOMER_VLAN>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo = 'USERVLAN']/valoreAttributo=$USERVLAN and attributiDettaglioOrdine[nomeAttributo = 'PROFILOVLAN']/valoreAttributo=$PROFILOVLAN]/attributiDettaglioOrdine[nomeAttributo = 'CVLAN']/valoreAttributo&quot;/>&lt;/tns2:CUSTOMER_VLAN>&lt;/xsl:if>&lt;/tns2:VLAN>&lt;/xsl:for-each>&lt;/tns2:SERVIZIO_FTTH>&lt;tns2:SERVIZI_OPZIONALI>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:RichiestaElement/ordine/flagIU='SI'&quot;>&lt;xsl:for-each select=&quot;$AggiuntiviApparatiInterventoUnico/tns15:Aggiuntivi&quo