lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
