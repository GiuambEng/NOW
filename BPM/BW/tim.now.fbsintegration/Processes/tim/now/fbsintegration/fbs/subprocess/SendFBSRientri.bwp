                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToInsertStaging"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;SelectSemaforo&quot;/>&lt;xsl:template name=&quot;LogSemaforo-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'SentRequestToFBS'&quot;/>&lt;/tns6:Process>&lt;tns6:Service>&lt;xsl:value-of select=&quot;'SendFBSRientri'&quot;/>&lt;/tns6:Service>&lt;tns6:Operation>&lt;xsl:value-of select=&quot;'SendFBSRientri'&quot;/>&lt;/tns6:Operation>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns6:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectSemaforo/Record)>0&quot;>&lt;tns6:Message>&lt;xsl:value-of select=&quot;'IdRichiesta presente su semaforo'&quot;/>&lt;/tns6:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:Message>&lt;xsl:value-of select=&quot;'IdRichiesta assente su semaforo'&quot;/>&lt;/tns6:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
