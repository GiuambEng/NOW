                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo SendFBSRientri'&quot;/>&#xa;                &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='EMISSIONEOF'&quot;>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;205&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'&quot;>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;211&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;210&quot;/>&#xa;                        &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;              