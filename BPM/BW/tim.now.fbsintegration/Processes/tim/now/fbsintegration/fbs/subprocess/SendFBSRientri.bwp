                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStaging-input"
                    name="LogStaging"
                    tibex:xpdlId="1cdc84e4-949e-44a3-a944-9b70da357581"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagingToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStagingToLogStatusUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType=('DESOSPENSIONE_OF','ANNULLAMENTO_OF')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType=('DESOSPENSIONE_OF','ANNULLAMENTO_OF')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStagingToGenericLogger1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='RDAC_OF_OLO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='RDAC_OF_OLO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStagingToGenericLogger2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Testata/ns0:RequestType='EMISSIONEOF']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;OrdineNOWWHLS&quot;/>&lt;xsl:template name=&quot;LogStaging-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'SentRequestToFBS'&quot;/>&lt;/tns6:Process>&lt;tns6:Service>&lt;xsl:value-of select=&quot;'SendFBSRientri'&quot;/>&lt;/tns6:Service>&lt;tns6:Operation>&lt;xsl:value-of select=&quot;'SendFBSRientri'&quot;/>&lt;/tns6:Operation>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat('Effettuato insert su staging con id ordine now crmws: ',string($OrdineNOWWHLS/sm:IdEventoOrdnNowWhls))&quot;/>&lt;/tns6:Payload>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStatusUpdate-input"
                    name="LogStatusUpdate"
