   &lt;xsl:if test=&quot;$MigrationSetup/out/tns2:Rec_MigrationSetup_Resp/tns2:MOTIVAZIONE&quot;>&#xa;                        &lt;tns:MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$MigrationSetup/out/tns2:Rec_MigrationSetup_Resp/tns2:MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:SendFBSResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns:Testata/tns:RequestType='RDAC_OF_OLO'&quot;>&#xa;                &lt;tns:SendFBSResponse>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$OrdineNOWWHLS/sm:IdEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                    &lt;tns:ID_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:ID_NOTIFICA&quot;/>&#xa;                    &lt;/tns:ID_NOTIFICA>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:ESITO&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:CODICE_MOTIVAZIONE&quot;>&#xa;                        &lt;tns:CODICE_MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:CODICE_MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:CODICE_MOTIVAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:MOTIVAZIONE&quot;>&#xa;                        &lt;tns:MOTIVAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$Reschedule/out/tns2:Rec_RescheduleMig_Resp/tns2:MOTIVAZIONE&quot;/>&#xa;                        &lt;/tns:MOTIVAZIONE>&#xa;                    &lt;/x