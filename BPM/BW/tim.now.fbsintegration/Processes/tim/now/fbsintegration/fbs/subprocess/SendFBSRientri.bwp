                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:SendFBSResponse>&#xa;            &lt;tns:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Response/tns:IdEventoOrdnNowWhls&quot;/>&#xa;            &lt;/tns:IdEventoOrdnNowWhls>&#xa;            &lt;tns:ID_NOTIFICA>&#xa;                &lt;xsl:value-of select=&quot;$Response/tns:ID_NOTIFICA&quot;/>&#xa;            &lt;/tns:ID_NOTIFICA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Response/tns:ESITO='0'&quot;>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Response/tns:CODICE_MOTIVAZIONE&quot;>&#xa;                &lt;tns:CODICE_MOTIVAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$Response/tns:CODICE_MOTIVAZIONE&quot;/>&#xa;                &lt;/tns:CODICE_MOTIVAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Response/tns:MOTIVAZIONE&quot;>&#xa;                &lt;tns:MOTIVAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$Response/tns:MOTIVAZIONE&quot;/>&#xa;                &lt;/tns:MOTIVAZIONE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:SendFBSResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLangua