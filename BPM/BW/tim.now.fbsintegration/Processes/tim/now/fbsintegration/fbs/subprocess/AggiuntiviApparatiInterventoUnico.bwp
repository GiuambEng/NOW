        <bpws:variable element="ns3:AggiuntiviSendFBS" name="Aggiuntivi"/>
        <bpws:variable element="ns3:ApparatiSendFBS" name="Apparati"/>
        <bpws:variable element="ns4:jdbcQueryActivityInput"
            name="InvioVsOf-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:resultSet" name="InvioVsOf" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ActivityErrorData"
            name="_error_InvioVsOf" sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
