                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentApparatoNMU&quot;/>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;currentAggiuntivo&quot;/>&lt;xsl:template name=&quot;Aggiuntivi&quot; match=&quot;/&quot;>&lt;tns2:AggiuntiviSendFBS>&lt;xsl:copy-of select=&quot;$Aggiuntivi/tns2:Aggiuntivi&quot;/>&lt;tns2:Aggiuntivi>&lt;xsl:if test=&quot;$currentApparatoNMU/tns2:CodiceApparato&quot;>&lt;tns2:NomeServizio>&lt;xsl:value-of select=&quot;$currentApparatoNMU/tns2:CodiceApparato&quot;/>&lt;/tns2:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentAggiuntivo/tns2:InformazioniServizio&quot;>&lt;tns2:InformazioniServizio>&lt;xsl:value-of select=&quot;$currentAggiuntivo/tns2:InformazioniServizio&quot;/>&lt;/tns2:InformazioniServizio>&lt;/xsl:if>&lt;/tns2:Aggiuntivi>&lt;/tns2:AggiuntiviSendFBS>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

                                    <value
                                    processVariable="Aggiuntivi" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:forEach>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="b278b539-d837-4039-bca1-09e573b08ada"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;Apparati&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'SentRequestToFBS'&quot;/>&lt;/tns6:Process>&lt;tns6:Service>&lt;xsl:value-of select=&quot;'AggiuntiviApparatiInterventoUnico'&quot;/>&lt;/tns6:Service>&lt;xsl:if test=&quot;$Start/tns2:IdRichiestaOlo&quot;>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IdRichiestaOlo&quot;/>&lt;/tns6:BusinessID>&lt;/xsl:if>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Lista Aggiuntivi da inviare a OF : ',tib:render-xml($Aggiuntivi))&quot;/>&lt;/tns6:Message>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat('Lista Apparati da inviare a OF : ',tib:render-xml($Apparati))&quot;/>&lt;/tns6:Payload>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
