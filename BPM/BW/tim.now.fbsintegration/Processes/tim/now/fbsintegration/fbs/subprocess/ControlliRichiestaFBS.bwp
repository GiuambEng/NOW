                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dfa393f1-d177-44c3-9e1b-2f4532bdf5f3+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;IdRichiestaOlo-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:CODICE_ORDINE_OLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_CompletionOrder_OpenStream_Request/tns:CODICE_ORDINE_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request)&quot;>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request/tns:CODICE_ORDINE_OLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_Reschedule_OpenStream_Request/tns:CODICE_ORDINE_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codordineoloopenfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_ORDINE_OLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_ORDINE_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codordineoloopenfiber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
