    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>MapResponse</variable>
            </endingVariables>
        </task>
        <task name="LogInput">
            <endingVariables>
                <variable>LogInput-input</variable>
            </endingVariables>
        </task>
        <task name="IdRichiestaOlo">
            <endingVariables>
                <variable>IdRichiestaOlo-input</variable>
            </endingVariables>
        </task>
        <task name="LogIdRichiestaOlo">
            <endingVariables>
                <variable>LogIdRichiestaOlo-input</variable>
            </endingVariables>
        </task>
        <task name="MapResponse">
            <endingVariables>
                <variable>MapResponse-input</variable>
                <variable>Start</variable>
                <variable>IdRichiestaOlo</variable>
                <variable>CodiceMotivazione</variable>
                <variable>Oscuramento</variable>
            </endingVariables>
        </task>
        <task name="CodiceMotivazione">
            <endingVariables>
                <variable>CodiceMotivazione-input</variable>
            </endingVariables>
        </task>
        <task name="LogCodiceMot">
            <endingVariables>
                <variable>LogCodiceMot-input</variable>
            </endingVariables>
        </task>
        <task name="LogOutput">
            <endingVariables>
                <variable>LogOutput-input</variable>
                <variable>LogName</variable>
                <variable>LogLevel</variable>
            </endingVariables>
        </task>
        <task name="Oscuramento">
            <endingVariables>
                <variable>Oscuramento-input</variable>
            </endingVariables>
        </task>
        <task name="LogOscuramento">
            <endingVariables>
                <variable>LogOscuramento-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
