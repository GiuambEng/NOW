                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapResponse-input" name="MapResponse"
                    outputVariable="MapResponse"
                    tibex:xpdlId="2522df93-349a-4dc4-ac86-869d1ea617b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToMapResponse"/>
                        <bpws:target linkName="GenericLoggerToMapResponse1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapResponseToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdRichiestaOlo&quot;/>&lt;xsl:param name=&quot;CodiceMotivazione&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapResponse-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($IdRichiestaOlo/Record[1]/IDRICHIESTAOLO)=0&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A03'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE=('1','3','4','5','7') and (string-length($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE)=0 or string-length($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:MOTIVAZIONE)=0)&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/tns:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE)=0&quot;>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Campo CODICE_MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/tns:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Campo MOTIVAZIONE obbligatorio non valorizzato'&quot;/>&lt;/tns:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE='1' and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE='D18'&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A02'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Valore campo CODICE_MOTIVAZIONE non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE='2' and string-length($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:ID_SERVIZIO)=0&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Campo ID_SERVIZIO obbligatorio non valorizzato'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE='4' and ($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE=('D25', 'B14', 'D28', 'C26') or ($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE='D26' and count($Oscuramento/Record[COD_AGESP='R1F-25-0133'])>0))&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A02'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Valore campo CODICE_MOTIVAZIONE non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request) and $Start/tns:OF_CompletionOrder_OpenStream_Request/tns:STATO_ORDINE='0' and (string-length($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:ID_RISORSA)=0 or string-length($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:COS)=0)&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A01'&quot;/>&lt;/tns:CodiceMotivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:ID_RISORSA)=0&quot;>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Campo ID_RISORSA obbligatorio non valorizzato'&quot;/>&lt;/tns:Motivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Campo COS obbligatorio non valorizzato'&quot;/>&lt;/tns:Motivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request) and $Start/tns:OF_CompletionOrder_OpenStream_Request/tns:STATO_ORDINE='1' and $Start/tns:OF_CompletionOrder_OpenStream_Request/tns:CODICE_MOTIVAZIONE='D17'&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A02'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Valore campo CODICE_MOTIVAZIONE non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE=('0','2') and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:FLAG_DESOSPENSIONE='SI' and count($CodiceMotivazione/Record)=0&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A03'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request) and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE='7' and $Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE='D01'&quot;>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'A02'&quot;/>&lt;/tns:CodiceMotivazione>&lt;tns:Motivazione>&lt;xsl:value-of select=&quot;'Valore campo CODICE_MOTIVAZIONE non ammesso'&quot;/>&lt;/tns:Motivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ControlliRichiestaOutput>&lt;tns:IdRichiesta>&lt;xsl:value-of select=&quot;$IdRichiestaOlo/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:IdRichiesta>&lt;tns:CodiceMotivazione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:CodiceMotivazione>&lt;/tns:ControlliRichiestaOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
