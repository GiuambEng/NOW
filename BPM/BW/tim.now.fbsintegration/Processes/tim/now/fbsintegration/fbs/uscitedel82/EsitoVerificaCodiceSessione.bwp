                portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="ee6123f1-8863-458a-85d6-1e3bc1431524">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns8="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns7="http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns5="http://wholesalesoperator/Schemas/DonatingMigrationServiceSchema.xsd" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="Richiesta"/&gt;&lt;xsl:template name="InsertStaging-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns8:StagingRequest&gt;&lt;tns8:StagingIn&gt;&lt;tns8:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$Mapper/tns5:CODICE_ORDINE_WHS"/&gt;&lt;/tns8:COD_ORDN_OLO&gt;&lt;tns8:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns8:CONTENUTO_REQUEST&gt;&lt;tns8:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="179"/&gt;&lt;/tns8:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$Richiesta/Record[1]/IDRICHIESTA"&gt;&lt;tns8:ID_RICH&gt;&lt;xsl:value-of select="$Richiesta/Record[1]/IDRICHIESTA"/&gt;&lt;/tns8:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns8:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns8:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$Mapper/tns5:MOTIVAZIONE"&gt;&lt;tns8:MOTIVAZIONE&gt;&lt;xsl:value-of select="$Mapper/tns5:MOTIVAZIONE"/&gt;&lt;/tns8:MOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns5:CODICE_MOTIVAZIONE"&gt;&lt;tns8:CODICEMOTIVAZIONE&gt;&lt;xsl:value-of select="$Mapper/tns5:CODICE_MOTIVAZIONE"/&gt;&lt;/tns8:CODICEMOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns8:IDNOTIFICA&gt;&lt;xsl:value-of select="$Mapper/tns5:ID_NOTIFICA"/&gt;&lt;/tns8:IDNOTIFICA&gt;&lt;tns8:DATANOTIFICA&gt;&lt;xsl:value-of select="$Mapper/tns5:DATA_NOTIFICA"/&gt;&lt;/tns8:DATANOTIFICA&gt;&lt;tns8:ESITO&gt;&lt;xsl:value-of select="$Mapper/tns5:ESITO"/&gt;&lt;/tns8:ESITO&gt;&lt;xsl:if test="$Mapper/tns5:NOTE"&gt;&lt;tns8:NOTE&gt;&lt;xsl:value-of select="$Mapper/tns5:NOTE"/&gt;&lt;/tns8:NOTE&gt;&lt;/xsl:if&gt;&lt;/tns8:StagingIn&gt;&lt;tns8:StagingType&gt;&lt;xsl:value-of select="'TRACC_FL_N9_VS_OPENFIBER'"/&gt;&lt;/tns8:StagingType&gt;&lt;tns8:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="179"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns8:LoggerIn&gt;&lt;/tns8:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns7=&quot;http://dbcfx/SOA/RichiestaVerificaCodiceSessione/2016-09-15&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns5=&quot;http://wholesalesoperator/Schemas/DonatingMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:StagingRequest>&#xa;            &lt;tns8:StagingIn>&#xa;                &lt;tns8:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/tns5:CODICE_ORDINE_WHS&quot;/>&#xa;                &lt;/tns8:COD_ORDN_OLO>&#xa;                &lt;tns8:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns8:CONTENUTO_REQUEST>&#xa;                &lt;tns8:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;179&quot;/>&#xa;                &lt;/tns8:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;>&#xa;                    &lt;tns8:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/IDRICHIESTA&quot;/>&#xa;                    &lt;/tns8:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns8:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns8:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns5:MOTIVAZIONE&quot;>&#xa;      