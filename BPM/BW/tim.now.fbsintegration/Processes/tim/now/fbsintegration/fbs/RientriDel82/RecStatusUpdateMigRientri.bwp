       &lt;xsl:when test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='0'&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'INTERRUZIONESOSPENSIONE'&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='1'&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'ANNULLAMENTO'&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'ALTRO'&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_OPERATORE_REC&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_ORDINE_REC&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;codiceOrdineOLOTarget>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_ORDINE_REC&quot;/>&#xa;            &lt;/codiceOrdineOLOTarget>&#xa;            &lt;xsl:if test=&quot;$CodiceOrdineTi/Record[1]/CODICEORDINETI&quot;>&#xa;                &lt;codiceOrdineTITarget>&#xa;                    &lt;xsl:value-of select=&quot;$CodiceOrdineTi/Record[1]/CODICEORDINETI&quot;/>&#xa;                &lt;/codiceOrdineTITarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;$Dro.parameters/tns0:outputDate&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;string-length(string($RichToken/tns4:OLO_N2Request/tns4:DATA_PREVISTA_ATTIVAZIONE))>0 and $RichToken/tns4:OLO_N2Request/tns4:AZIONE='0'&quot;>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:DATA_PREVISTA_ATTIVAZIONE&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_OPERATORE_REC&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;xsl:if test=&quot;string-length(string($RichToken/tns4:OLO_N2Request/tns4:DATA_PREVISTA_ATTIVAZIONE))>0 and string-length(string($RichToken/tns4:OLO_N2Request/tns4:ORARIO_APPUNTAMENTO))>0  and $RichToken/tns4:OLO_N2Request/tns4:AZIONE='0'&quot;>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:ORARIO_APPUNTAMENTO&quot;>&#xa;                    &lt;fasciaOrariaAppuntamento>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:ORARIO_APPUNTAMENTO&quot;/>&#xa;                    &lt;/fasciaOrariaAppuntamento>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;flagRientriDel82>&#xa;                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;            &lt;/flagRientriDel82>&#xa;            &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='1'&quot;>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:MOTIVAZIONE&quot;>&#xa;                    &lt;motivazione>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:MOTIVAZIONE&quot;/>&#xa;                    &lt;/motivazione>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='1'&quot;>&#xa;                &lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_MOTIVAZIONE&quot;>&#xa;                    &lt;codiceMotivazione>&#xa;                        &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_MOTIVAZIONE&quot;/>&#xa;                    &lt;/codiceMotivazione>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns10:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:RichiestaElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRichiesta-input"
                    name="LogRichiesta"
                    tibex:xpdlId="ce6d5361-6fbb-4538-aa19-2164e528661d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RichiestaToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRichiestaToRenderXml">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogRichiestaToReferente">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:OLO_N2Request/ns0:AZIONE='0' and (string-length($Start/ns0:OLO_N2Request/ns0:NOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N2Request/ns0:COGNOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N2Request/ns0:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/ns0:OLO_N2Request/ns0:RECAPITO_TELEFONICO_CLIENTE_2)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:OLO_N2Request/ns0:AZIONE='0' and (string-length($Start/ns0:OLO_N2Request/ns0:NOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N2Request/ns0:COGNOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N2Request/ns0:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/ns0:OLO_N2Request/ns0:RECAPITO_TELEFONICO_CLIENTE_2)>0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecStatusUpdateMigRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Creata richiesta : ',tib:render-xml($Richiesta))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RenderRichiesta-input"
                    name="RenderRichiesta"
                    outputVariable="RenderRichiesta"
                    tibex:copyOf="Richiesta"
                    tibex:xpdlId="ad24c70b-6176-46ae-a15b-343ae8c14456" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaToRenderXml"/>
                        <bpws:target linkName="GenericLoggerToRenderRichiesta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderRichiestaToProcessManagementSubProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;RenderRichiesta-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Richiesta&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ProcessManagementSubProcess-input"
                    name="ProcessManagementSubProcess"
                    outputVariable="ProcessManagementSubProcess"
                    tibex:xpdlId="4cf62ff0-db26-4c9b-96d2-764e462d7044"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderRichiestaToProcessManagementSubProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProcessManagementSubProcessToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tns4=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:param name=&quot;RenderRichiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&lt;tns11:Element>&lt;tns11:moduleName>&lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&lt;/tns11:moduleName>&lt;tns11:parameterName>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/tns11:parameterName>&lt;xsl:if test=&quot;$Start/tns4:OLO_N2Request/tns4:AZIONE='0' and (string-length($Start/tns4:OLO_N2Request/tns4:NOME_CLIENTE)>0 or string-length($Start/tns4:OLO_N2Request/tns4:COGNOME_CLIENTE)>0 or string-length($Start/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_2)>0)&quot;>&lt;tns11:parameterName2>&lt;xsl:value-of select=&quot;'referenteAltreLavorazioni'&quot;/>&lt;/tns11:parameterName2>&lt;/xsl:if>&lt;tns11:operationName>&lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&lt;/tns11:operationName>&lt;tns11:processName>&lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&lt;/tns11:processName>&lt;tns11:value>&lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&lt;/tns11:value>&lt;xsl:if test=&quot;$Start/tns4:OLO_N2Request/tns4:AZIONE='0' and (string-length($Start/tns4:OLO_N2Request/tns4:NOME_CLIENTE)>0 or string-length($Start/tns4:OLO_N2Request/tns4:COGNOME_CLIENTE)>0 or string-length($Start/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_2)>0)&quot;>&lt;tns11:value2>&lt;xsl:value-of select=&quot;tib:render-xml($Referente)&quot;/>&lt;/tns11:value2>&lt;/xsl:if>&lt;tns11:ID_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns11:ID_FILE>&lt;tns11:ContenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($RichToken)&quot;/>&lt;/tns11:ContenutoXML>&lt;tns11:CodificaOLOAgicom>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns11:CodificaOLOAgicom>&lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&lt;tns11:Ambito>&lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&lt;/tns11:Ambito>&lt;/xsl:if>&lt;tns11:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&lt;/tns11:StrutturaRichiesta>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&lt;tns11:Code_OLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&lt;/tns11:Code_OLO>&lt;/xsl:if>&lt;tns11:Parametro>&lt;xsl:value-of select=&quot;'FIBERSTREAMB2B'&quot;/>&lt;/tns11:Parametro>&lt;/tns11:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdStag-input" name="UpdStag"
                operation="InsertUpdateStaging" outputVariable="UpdStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="d64d2a6e-fd49-40fd-b51e-e83e2fe2ce46">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns6="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:param name="ControlliStatusUpdateMigRientri"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns7:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns6:StagingRequest&gt;&lt;tns6:StagingIn&gt;&lt;tns6:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns4:OLO_N2Request/tns4:CODICE_ORDINE_REC"/&gt;&lt;/tns6:COD_ORDN_OLO&gt;&lt;tns6:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($ControlliStatusUpdateMigRientri)"/&gt;&lt;/tns6:CONTENUTO_RESPONSE&gt;&lt;tns6:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="199"/&gt;&lt;/tns6:ID_PROCSO_NO_FILE&gt;&lt;tns6:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns6:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$ControlliStatusUpdateMigRientri/tns4:MOTIVAZIONE"&gt;&lt;tns6:MOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliStatusUpdateMigRientri/tns4:MOTIVAZIONE"/&gt;&lt;/tns6:MOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ControlliStatusUpdateMigRientri/tns4:CODICE_MOTIVAZIONE"&gt;&lt;tns6:CODICEMOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliStatusUpdateMigRientri/tns4:CODICE_MOTIVAZIONE"/&gt;&lt;/tns6:CODICEMOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns6:ESITO&gt;&lt;xsl:value-of select="$ControlliStatusUpdateMigRientri/tns4:ESITO"/&gt;&lt;/tns6:ESITO&gt;&lt;/tns6:StagingIn&gt;&lt;tns6:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns6:StagingType&gt;&lt;tns6:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="199"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns6:StagingResponse/tns6:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns6:LoggerIn&gt;&lt;/tns6:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns7:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliStatusUpdateMigRientri&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:StagingRequest>&#xa;            &lt;tns6:StagingIn>&#xa;                &lt;tns6:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns6:COD_ORDN_OLO>&#xa;                &lt;tns6:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ControlliStatusUpdateMigRientri)&quot;/>&#xa;                &lt;/tns6:CONTENUTO_RESPONSE>&#xa;                &lt;tns6:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;199&quot;/>&#xa;                &lt;/tns6:ID_PROCSO_NO_FILE>&#xa;                &lt;tns6:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns6:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$ControlliStatusUpdateMigRientri/tns4:MOTIVAZIONE&quot;>&#xa;                    &lt;tns6:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliStatusUpdateMigRientri/tns4:MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns6:MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ControlliStatusUpdateMigRientri/tns4:CODICE_MOTIVAZIONE&quot;>&#xa;                    &lt;tns6:CODICEMOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliStatusUpdateMigRientri/tns4:CODICE_MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns6:CODICEMOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$ControlliStatusUpdateMigRientri/tns4:ESITO&quot;/>&#xa;                &lt;/tns6:ESITO>&#xa;            &lt;/tns6:StagingIn>&#xa;            &lt;tns6:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns6:StagingType>&#xa;            &lt;tns6:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns6:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns6:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns6:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;199&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns6:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns6:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns6:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns6:LoggerIn>&#xa;        &lt;/tns6:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogControlliToInvoke"/>
                    <bpws:target linkName="ProcessManagementSubProcessToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdStagToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Referente-input"
                    name="Referente" outputVariable="Referente"
                    tibex:xpdlId="f253d42c-3d9f-439d-98d8-46d4971588ce" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaToReferente"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ReferenteToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns4=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:template name=&quot;Referente-input&quot; match=&quot;/&quot;>&lt;tns10:ReferenteElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivoReferente>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;'CF'&quot;/>&lt;/qualificaReferente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RichToken/tns4:OLO_N2Request/tns4:COGNOME_CLIENTE)>0&quot;>&lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:COGNOME_CLIENTE&quot;>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:COGNOME_CLIENTE&quot;/>&lt;/cognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;' '&quot;/>&lt;/cognomeReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($RichToken/tns4:OLO_N2Request/tns4:NOME_CLIENTE)>0&quot;>&lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:NOME_CLIENTE&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:NOME_CLIENTE&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_1)>0&quot;>&lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_1&quot;>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_1&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_2)>0&quot;>&lt;xsl:if test=&quot;$RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_2&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;$RichToken/tns4:OLO_N2Request/tns4:RECAPITO_TELEFONICO_CLIENTE_2&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns10:ReferenteElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:ReferenteElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogReferente-input"
                    name="LogReferente"
                    tibex:xpdlId="26c35c8d-4ddd-4c55-99f7-a4e20583d8fe"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ReferenteToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToRenderRichiesta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:template name=&quot;LogReferente-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecStatusUpdateMigRientri'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Creato referente : ',tib:render-xml($Referente))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
