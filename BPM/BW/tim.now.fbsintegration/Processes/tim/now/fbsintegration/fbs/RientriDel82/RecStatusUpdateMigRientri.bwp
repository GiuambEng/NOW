                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select IDRICHIESTAOLO, CODICEORDINETI from BDS_1_CASEDATA_RICHIESTA where LAVORAZIONE='MIGRAZIONE' and TIPOLOGIASOTTOLAV='RIENTRIDEL82' and CODICEORDINEOLO=? and CODIFICAOLOAGCOM=?" xsi:type="jdbcPalette:JDBCQueryActivity">
