            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema_OLO_Fiberstream.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:param name=&quot;CodiceOrdineTi&quot;/>&lt;xsl:param name=&quot;Olo&quot;/>&lt;xsl:param name=&quot;Dro&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns10:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;'B2B'&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='0'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;'INTERRUZIONESOSPENSIONE'&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$RichToken/tns4:OLO_N2Request/tns4:AZIONE='1'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;'ANNULLAMENTO'&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;/xsl:choose>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;'ALTRO'&quot;/>&lt;/tipoR