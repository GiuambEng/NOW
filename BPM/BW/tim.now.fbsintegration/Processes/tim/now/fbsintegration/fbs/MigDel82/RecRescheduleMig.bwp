&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;>&lt;tns:RECAPITO_TELEFONICO_CLIENTE_1>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;/>&lt;/tns:RECAPITO_TELEFONICO_CLIENTE_1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;>&lt;tns:RECAPITO_TELEFONICO_CLIENTE_2>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/tns:RECAPITO_TELEFONICO_CLIENTE_2>&lt;/xsl:if>&lt;tns:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/tns:CODICE_MOTIVAZIONE>&lt;tns:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:MOTIVAZIONE&quot;/>&lt;/tns:MOTIVAZIONE>&lt;xsl:if test=&quot;$Start/tns:OLO_N3Request/tns:NOTE&quot;>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:NOTE&quot;/>&lt;/tns:NOTE>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Start/tns:OLO_N3Request/tns:SERVIZIO_FTTH&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:OLO_N3Request/tns:SERVIZI_OPZIONALI&quot;/>&lt;/tns:OLO_N3Request>&lt;xsl:copy-of select=&quot;$Start/tns:Header&quot;/>&lt;/tns:Rec_RescheduleMig_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
