                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:template name="ErrorStag-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC"/&gt;&lt;/tns5:COD_ORDN_OLO&gt;&lt;tns5:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Errore generico nel processo RecMigrationSetup'"/&gt;&lt;/tns5:DESCR_ERRORE&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="196"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="196"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns5:COD_ORDN_OLO>&#xa;                &lt;tns5:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo RecMigrationSetup'&quot;/>&#xa;                &lt;/tns5:DESCR_ERRORE>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;196&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;            &lt;/tns5:StagingIn>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;196&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LogFaultToInvoke"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorStagToRethrow"/>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="21ce8155-161f-4608-963b-dee062e485c3">
                            <bpws:targets>
                                <bpws:target linkName="ErrorStagToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="OraCorrenteToGetLocalIP" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetLocalIPToToken" tibex:linkType="SUCCESS"/>
                <bpws:link name="TokenToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="RichTokenToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="CodiceOrdineTIToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsStagToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInsStagToControlliRescheduleMig" tibex:linkType="SUCCESS"/>
                <bpws:link name="ControlliRescheduleMigToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogControlliToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="OloToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="DroToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogDroToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="RichiestaToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRichiestaToRenderXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderRichiestaToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ReferenteToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="LogReferenteToProcessManagementSubProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="ProcessManagementSubProcessToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogControlliToInvoke" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="UpdStagToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="RenderRichiestaToProcessManagementSubProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="7578501c-e240-40ca-861a-87b61c1937ae"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End" tibex:copyOf="ControlliRescheduleMig"
                    tibex:xpdlId="47f27ebd-3cca-4049-af97-f61d35a6a27c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdStagToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlliRescheduleMig&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$ControlliRescheduleMig&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="845b4cf2-f167-4fd2-a4a6-a443d7e06164"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecRescheduleMig'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Input RecRescheduleMig : ',tib:render-xml($Start))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="OraCorrente"
                    name="OraCorrente" outputVariable="OraCorrente"
                    tibex:xpdlId="c6c3020c-88c1-46f2-af36-73ffdd66629a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OraCorrenteToGetLocalIP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="substring(string(current-time()), 1, 2)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OraCorrente" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity name="GetLocalIP"
                    outputVariable="GetLocalIP"
                    tibex:xpdlId="33d83411-44a1-4594-a3eb-267f99d8e5dc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OraCorrenteToGetLocalIP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetLocalIPToToken"/>
                    </bpws:sources>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.GetLocalIP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Token-input"
                    name="Token" outputVariable="Token"
                    tibex:xpdlId="c2ee3ba7-40b8-4c64-9a5a-888d14ccdaaa"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToToken"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TokenToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;Operatore&quot;/>&lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&lt;tns1:Request>&lt;tns1:RequestCreate_token>&lt;tns1:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:CODICE_OPERATORE_REC&quot;/>&lt;/tns1:CodificaOLOAGCOM>&lt;tns1:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&lt;/tns1:CodiceOrdineOLO>&lt;tns1:Funzione>&lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&lt;/tns1:Funzione>&lt;tns1:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($Start/tns:OLO_N3Request/tns:CODICE_ORDINE_REC,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&lt;/tns1:ChiaveRiferimento>&lt;tns1:Operatore>&lt;xsl:value-of select=&quot;$Operatore&quot;/>&lt;/tns1:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns3:IPAddress&quot;>&lt;tns1:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns3:IPAddress&quot;/>&lt;/tns1:IPClient>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_1&quot;>&lt;tns1:N_Recap_Cliente>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_1&quot;/>&lt;/tns1:N_Recap_Cliente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_2&quot;>&lt;tns1:N_Recap_Cliente_ALT>&lt;xsl:value-of select=&quot;$Start/tns:OLO_N3Request/tn