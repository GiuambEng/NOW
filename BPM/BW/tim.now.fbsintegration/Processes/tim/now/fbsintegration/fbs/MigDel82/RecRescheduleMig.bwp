                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Dro.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;OraCorrente&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDro-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'RecRescheduleMig'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Calcolata DRO: ',string($Dro.parameters/tns0:outputDate))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Ora corrente ',$OraCorrente)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:param name=&quot;Olo&quot;/>&lt;xsl:param name=&quot;Dro&quot;/>&lt;xsl:param name=&quot;CodiceOrdineTI&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns8:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;'B2B'&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;'RIMODULAZIONEDACDARECIPIENT'&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;'ALTRO'&quot;/>&lt;/tipoRichiesta>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_OPERATORE_REC&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&lt;/codiceOrdineOLO>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&lt;/codiceOrdineOLOTarget>&lt;xsl:if test=&quot;$CodiceOrdineTI/Record[1]/CODICEORDINETI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$CodiceOrdineTI/Record[1]/CODICEORDINETI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/dataInvioRichiesta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;DRO>&lt;xsl:value-of select=&quot;$Dro/parameters/tns0:Response/tns0:outputDate&quot;/>&lt;/DRO>&lt;xsl:if test=&quot;string-length(string($RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE))>0 &quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_OPERATORE_REC&quot;/>&lt;/codificaOLOAGCOMRic>&lt;flagMigDel82>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/flagMigDel82>&lt;xsl:if test=&quot;string-length(string($RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE))>0 and string-length(string($RichToken/tns:OLO_N3Request/tns:ORARIO_APPUNTAMENTO))>0&quot;>&lt;fasciaOrariaAppuntamento>&lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:ORARIO_APPUNTAMENTO&quot;/>&lt;/fasciaOrariaAppuntamento>&lt;/xsl:if>&lt;/tns8:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Richiesta-input" name="Richiesta"
                    outputVariable="Richiesta"
                    tibex:xpdlId="3bbf3e5f-2054-42ce-81a8-46228c700634" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDroToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RichiestaToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Dro.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:param name=&quot;Olo&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceOrdineTI&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'B2B'&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;'RIMODULAZIONEDACDARECIPIENT'&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'ALTRO'&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_OPERATORE_REC&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;codiceOrdineOLOTarget>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;            &lt;/codiceOrdineOLOTarget>&#xa;            &lt;xsl:if test=&quot;$CodiceOrdineTI/Record[1]/CODICEORDINETI&quot;>&#xa;                &lt;codiceOrdineTITarget>&#xa;                    &lt;xsl:value-of select=&quot;$CodiceOrdineTI/Record[1]/CODICEORDINETI&quot;/>&#xa;                &lt;/codiceOrdineTITarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;$Dro.parameters/tns0:outputDate&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;string-length(string($RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE))>0 &quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_OPERATORE_REC&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;flagMigDel82>&#xa;                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;            &lt;/flagMigDel82>&#xa;            &lt;xsl:if test=&quot;string-length(string($RichToken/tns:OLO_N3Request/tns:DATA_PREVISTA_ATTIVAZIONE))>0 and string-length(string($RichToken/tns:OLO_N3Request/tns:ORARIO_APPUNTAMENTO))>0&quot;>&#xa;                &lt;fasciaOrariaAppuntamento>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:ORARIO_APPUNTAMENTO&quot;/>&#xa;                &lt;/fasciaOrariaAppuntamento>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns8:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:RichiestaElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRichiesta-input"
                    name="LogRichiesta"
                    tibex:xpdlId="1d444647-e860-4aa2-b86a-18562355961e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RichiestaToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRichiestaToRenderXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecRescheduleMig'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Creata richiesta : ',tib:render-xml($Richiesta))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RenderRichiesta-input"
                    name="RenderRichiesta"
                    outputVariable="RenderRichiesta"
                    tibex:copyOf="Richiesta"
                    tibex:xpdlId="03f97ea3-1493-4adc-b499-b5a5b394244d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaToRenderXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderRichiestaToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:OLO_N3Request/ns0:NOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N3Request/ns0:COGNOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N3Request/ns0:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/ns0:OLO_N3Request/ns0:RECAPITO_TELEFONICO_CLIENTE_2)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:OLO_N3Request/ns0:NOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N3Request/ns0:COGNOME_CLIENTE)>0 or string-length($Start/ns0:OLO_N3Request/ns0:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/ns0:OLO_N3Request/ns0:RECAPITO_TELEFONICO_CLIENTE_2)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RenderRichiestaToProcessManagementSubProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;RenderRichiesta-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Richiesta&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Referente-input"
                    name="Referente" outputVariable="Referente"
                    tibex:xpdlId="4ee0e625-2919-4a64-93bf-4078e9ca6aaa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderRichiestaToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ReferenteToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Token&quot;/>&lt;xsl:template name=&quot;Referente-input&quot; match=&quot;/&quot;>&lt;tns8:ReferenteElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivoReferente>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEDAC&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;'CF'&quot;/>&lt;/qualificaReferente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:OLO_N3Request/tns:COGNOME_CLIENTE)>0&quot;>&lt;xsl:if test=&quot;$Token/tns1:ResponseCreate_token/tns1:CognomeRagioneSociale&quot;>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:CognomeRagioneSociale&quot;/>&lt;/cognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;' '&quot;/>&lt;/cognomeReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns:OLO_N3Request/tns:NOME_CLIENTE)>0&quot;>&lt;xsl:if test=&quot;$Token/tns1:ResponseCreate_token/tns1:Nome&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:Nome&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_1)>0&quot;>&lt;xsl:if test=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_2)>0&quot;>&lt;xsl:if test=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;$Token/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;flag_Token>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/flag_Token>&lt;/tns8:ReferenteElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:ReferenteElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogReferente-input"
                    name="LogReferente"
                    tibex:xpdlId="42437f7a-c290-45cd-a049-f82a293c1a43"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ReferenteToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogReferenteToProcessManagementSubProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:template name=&quot;LogReferente-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'RecRescheduleMig'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Creato referente : ',tib:render-xml($Referente))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ProcessManagementSubProcess-input"
                    name="ProcessManagementSubProcess"
                    outputVariable="ProcessManagementSubProcess"
                    tibex:xpdlId="f526ed46-9215-476a-aee7-f3064571ce6a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogReferenteToProcessManagementSubProcess"/>
                        <bpws:target linkName="RenderRichiestaToProcessManagementSubProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProcessManagementSubProcessToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;RichToken&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:param name=&quot;RenderRichiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&lt;tns9:Element>&lt;tns9:moduleName>&lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&lt;/tns9:moduleName>&lt;tns9:parameterName>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/tns9:parameterName>&lt;xsl:if test=&quot;string-length($Start/tns:OLO_N3Request/tns:NOME_CLIENTE)>0 or string-length($Start/tns:OLO_N3Request/tns:COGNOME_CLIENTE)>0 or string-length($Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_1)>0 or string-length($Start/tns:OLO_N3Request/tns:RECAPITO_TELEFONICO_CLIENTE_2)>0&quot;>&lt;tns9:parameterName2>&lt;xsl:value-of select=&quot;'referenteAltreLavorazioni'&quot;/>&lt;/tns9:parameterName2>&lt;/xsl:if>&lt;tns9:operationName>&lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&lt;/tns9:operationName>&lt;tns9:processName>&lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&lt;/tns9:processName>&lt;tns9:value>&lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&lt;/tns9:value>&lt;tns9:value2>&lt;xsl:value-of select=&quot;tib:render-xml($Referente)&quot;/>&lt;/tns9:value2>&lt;tns9:ID_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns9:ID_FILE>&lt;tns9:ContenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($RichToken)&quot;/>&lt;/tns9:ContenutoXML>&lt;tns9:CodificaOLOAgicom>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns9:CodificaOLOAgicom>&lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&lt;tns9:Ambito>&lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&lt;/tns9:Ambito>&lt;/xsl:if>&lt;tns9:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&lt;/tns9:StrutturaRichiesta>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&lt;tns9:Code_OLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&lt;/tns9:Code_OLO>&lt;/xsl:if>&lt;tns9:Parametro>&lt;xsl:value-of select=&quot;'NGAB2B'&quot;/>&lt;/tns9:Parametro>&lt;/tns9:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.fbsintegration.fbs.subprocess.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdStag-input" name="UpdStag"
                operation="InsertUpdateStaging" outputVariable="UpdStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns8:InsertUpdateStagingPortType" tibex:xpdlId="655ef525-2791-4b83-9432-135e79b323d1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="RichToken"/&gt;&lt;xsl:param name="ControlliRescheduleMig"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns5:StagingRequest&gt;&lt;tns5:StagingIn&gt;&lt;tns5:COD_ORDN_OLO&gt;&lt;xsl:value-of select="$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC"/&gt;&lt;/tns5:COD_ORDN_OLO&gt;&lt;tns5:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($ControlliRescheduleMig)"/&gt;&lt;/tns5:CONTENUTO_RESPONSE&gt;&lt;tns5:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="196"/&gt;&lt;/tns5:ID_PROCSO_NO_FILE&gt;&lt;tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns5:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$ControlliRescheduleMig/tns:MOTIVAZIONE"&gt;&lt;tns5:MOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliRescheduleMig/tns:MOTIVAZIONE"/&gt;&lt;/tns5:MOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ControlliRescheduleMig/tns:CODICE_MOTIVAZIONE"&gt;&lt;tns5:CODICEMOTIVAZIONE&gt;&lt;xsl:value-of select="$ControlliRescheduleMig/tns:CODICE_MOTIVAZIONE"/&gt;&lt;/tns5:CODICEMOTIVAZIONE&gt;&lt;/xsl:if&gt;&lt;tns5:ESITO&gt;&lt;xsl:value-of select="$ControlliRescheduleMig/tns:ESITO"/&gt;&lt;/tns5:ESITO&gt;&lt;/tns5:StagingIn&gt;&lt;tns5:StagingType&gt;&lt;xsl:value-of select="'DELIB_82_EVENTI_IN'"/&gt;&lt;/tns5:StagingType&gt;&lt;tns5:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="196"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns5:StagingResponse/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns5:LoggerIn&gt;&lt;/tns5:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://wholesalesoperator/Schemas/RecipientMigrationServiceSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichToken&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliRescheduleMig&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:StagingRequest>&#xa;            &lt;tns5:StagingIn>&#xa;                &lt;tns5:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichToken/tns:OLO_N3Request/tns:CODICE_ORDINE_REC&quot;/>&#xa;                &lt;/tns5:COD_ORDN_OLO>&#xa;                &lt;tns5:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ControlliRescheduleMig)&quot;/>&#xa;                &lt;/tns5:CONTENUTO_RESPONSE>&#xa;                &lt;tns5:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;196&quot;/>&#xa;                &lt;/tns5:ID_PROCSO_NO_FILE>&#xa;                &lt;tns5:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns5:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$ControlliRescheduleMig/tns:MOTIVAZIONE&quot;>&#xa;                    &lt;tns5:MOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRescheduleMig/tns:MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:MOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ControlliRescheduleMig/tns:CODICE_MOTIVAZIONE&quot;>&#xa;                    &lt;tns5:CODICEMOTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliRescheduleMig/tns:CODICE_MOTIVAZIONE&quot;/>&#xa;                    &lt;/tns5:CODICEMOTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$ControlliRescheduleMig/tns:ESITO&quot;/>&#xa;                &lt;/tns5:ESITO>&#xa;            &lt;/tns5:StagingIn>&#xa;            &lt;tns5:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_IN'&quot;/>&#xa;            &lt;/tns5:StagingType>&#xa;            &lt;tns5:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;196&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns5:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns5:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns5:LoggerIn>&#xa;        &lt;/tns5:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ProcessManagementSubProcessToInvoke"/>
                    <bpws:target linkName="LogControlliToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdStagToEnd"/>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
