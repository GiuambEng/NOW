                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN8)"&gt;
                                &lt;xsl:if test="$WHSCheckSessione/out/tns14:WHS_Check_sessione_Resp/tns14:MOTIVAZIONE"&gt;
                                    &lt;tns9:MOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSCheckSessione/out/tns14:WHS_Check_sessione_Resp/tns14:MOTIVAZIONE"/&gt;
