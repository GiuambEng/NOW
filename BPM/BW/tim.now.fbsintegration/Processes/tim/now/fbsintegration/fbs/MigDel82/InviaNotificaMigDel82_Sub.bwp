                                    &lt;tns9:MOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSMsgDonating/out/tns14:WHS_Msg_Donating_Resp/tns14:MOTIVAZIONE"/&gt;
                                    &lt;/tns9:MOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN6)"&gt;
                                &lt;xsl:if test="$WHSEvent/out/tns6:WHS_Event_Resp/tns6:MOTIVAZIONE"&gt;
                                    &lt;tns9:MOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSEvent/out/tns6:WHS_Event_Resp/tns6:MOTIVAZIONE"/&gt;
                                    &lt;/tns9:MOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN5)"&gt;
                                &lt;xsl:if test="$WHSReschedule/out/tns6:WHS_RescheduleMig_Resp/tns6:MOTIVAZIONE"&gt;
                                    &lt;tns9:MOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSReschedule/out/tns6:WHS_RescheduleMig_Resp/tns6:MOTIVAZIONE"/&gt;
