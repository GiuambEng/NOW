                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN7)"&gt;
                                &lt;xsl:if test="$WHSCompletationOrder/out/tns6:WHS_CompletionOrderMig_Resp/tns6:MOTIVAZIONE"&gt;
                                    &lt;tns9:MOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSCompletationOrder/out/tns6:WHS_CompletionOrderMig_Resp/tns6:MOTIVAZIONE"/&gt;
                                    &lt;/tns9:MOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($MapNotificaN4)"&gt;
                                &lt;xsl:if test="$WHSStatusUpdate/out/tns6:WHS_StatusUpdateMig_Resp/tns6:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSStatusUpdate/out/tns6:WHS_StatusUpdateMig_Resp/tns6:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN8)"&gt;
                                &lt;xsl:if test="$WHSCheckSessione/out/tns14:WHS_Check_sessione_Resp/tns14:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSCheckSessione/out/tns14:WHS_Check_sessione_Resp/tns14:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN10)"&gt;
                                &lt;xsl:if test="$WHSMsgDonating/out/tns14:WHS_Msg_Donating_Resp/tns14:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSMsgDonating/out/tns14:WHS_Msg_Donating_Resp/tns14:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN6)"&gt;
                                &lt;xsl:if test="$WHSEvent/out/tns6:WHS_Event_Resp/tns6:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSEvent/out/tns6:WHS_Event_Resp/tns6:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN5)"&gt;
                                &lt;xsl:if test="$WHSReschedule/out/tns6:WHS_RescheduleMig_Resp/tns6:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSReschedule/out/tns6:WHS_RescheduleMig_Resp/tns6:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN7)"&gt;
                                &lt;xsl:if test="$WHSCompletationOrder/out/tns6:WHS_CompletionOrderMig_Resp/tns6:CODICE_MOTIVAZIONE"&gt;
                                    &lt;tns9:CODICEMOTIVAZIONE&gt;
                                        &lt;xsl:value-of select="$WHSCompletationOrder/out/tns6:WHS_CompletionOrderMig_Resp/tns6:CODICE_MOTIVAZIONE"/&gt;
                                    &lt;/tns9:CODICEMOTIVAZIONE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($MapNotificaN4)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSStatusUpdate/out/tns6:WHS_StatusUpdateMig_Resp/tns6:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN8)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSCheckSessione/out/tns14:WHS_Check_sessione_Resp/tns14:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN10)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSMsgDonating/out/tns14:WHS_Msg_Donating_Resp/tns14:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN6)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSEvent/out/tns6:WHS_Event_Resp/tns6:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN5)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSReschedule/out/tns6:WHS_RescheduleMig_Resp/tns6:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($MapNotificaN7)"&gt;
                                &lt;tns9:ESITO&gt;
                                    &lt;xsl:value-of select="$WHSCompletationOrder/out/tns6:WHS_CompletionOrderMig_Resp/tns6:ESITO"/&gt;
                                &lt;/tns9:ESITO&gt;
                            &lt;/xsl:when&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns9:StagingIn&gt;
                    &lt;tns9:StagingType&gt;
                        &lt;xsl:value-of select="'DELIB_82_EVENTI_OUT'"/&gt;
                    &lt;/tns9:StagingType&gt;
                    &lt;tns9:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="'NOFILE'"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="'UPDATE'"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MapNotificaN4)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="186"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN8)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="189"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN10)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="191"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN6)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="192"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN5)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="194"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN7)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="193"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'CHIUSO'"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;xsl:if test="$InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO&gt;
                                    &lt;xsl:value-of select="$InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns9:LoggerIn&gt;
                &lt;/tns9:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns8:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd&quot; xmlns:tns14=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WHSMsgDonating.out&quot;/>&#xa;    &lt;xsl:param name=&quot;WHSEvent.out&quot;/>&#xa;    &lt;xsl:param name=&quot;WHSReschedule.out&quot;/>&#xa;    &lt;xsl:param name=&quot;WHSStatusUpdate.out&quot;/>&#xa;    &lt;xsl:param name=&quot;WHSCheckSessione.out&quot;/>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;WHSCompletationOrder.out&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN8&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN10&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN6&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN7&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;xsl:if test=&quot;$ParseXml/codiceOrdineOLO&quot;>&#xa;                    &lt;tns9:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns9:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSStatusUpdate.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSCheckSessione.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSMsgDonating.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSEvent.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSReschedule.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($WHSCompletationOrder.out)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;186&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;189&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;191&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;192&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;194&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;193&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns9:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns9:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSStatusUpdate.out/tns6:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSStatusUpdate.out/tns6:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSCheckSessione.out/tns14:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSCheckSessione.out/tns14:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSMsgDonating.out/tns14:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSMsgDonating.out/tns14:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSEvent.out/tns6:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSEvent.out/tns6:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSReschedule.out/tns6:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSReschedule.out/tns6:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSCompletationOrder.out/tns6:MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:MOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSCompletationOrder.out/tns6:MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:MOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSStatusUpdate.out/tns6:CODICE_MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:CODICEMOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSStatusUpdate.out/tns6:CODICE_MOTIVAZIONE&quot;/>&#xa;                            &lt;/tns9:CODICEMOTIVAZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;xsl:if test=&quot;$WHSCheckSessione.out/tns14:CODICE_MOTIVAZIONE&quot;>&#xa;                            &lt;tns9:CODICEMOTIVAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$WHSCheckSessione.out/tns14:CODICE_MOTIVAZIONE&quot;/>&#xa;                            &