                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="VALORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapNotificaN4-input"
                    name="MapNotificaN4" outputVariable="MapNotificaN4"
                    tibex:xpdlId="fea718fa-5c71-42a0-ab5b-440a2744fc0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapNotifica"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapNotificaToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:param name=&quot;CodificaOloAgc&quot;/>&lt;xsl:param name=&quot;OloEasyIp&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapNotificaN4-input&quot; match=&quot;/&quot;>&lt;tns6:WHS_StatusUpdateMig_Req>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if ($Start/tns:TipologiaNotifica='KO') then '1' else if ($Start/tns:TipologiaNotifica='AQ') then '0' else if ($Start/tns:TipologiaNotifica='AC') then '2' else if ($Start/tns:TipologiaNotifica='KC') then '3' else if ($Start/tns:TipologiaNotifica='SP') then '4' else '5'&quot;/>&lt;tns6:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;$CodificaOloAgc&quot;/>&lt;/tns6:CODICE_OPERATORE_REC>&lt;tns6:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/tns6:CODICE_ORDINE_REC>&lt;tns6:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns6:CODICE_OPERATORE_WHS>&lt;tns6:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/tns6:CODICE_ORDINE_WHS>&lt;tns6:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&lt;/tns6:ID_NOTIFICA>&lt;tns6:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns6:DATA_NOTIFICA>&lt;tns6:STATO_ORDINE>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns6:STATO_ORDINE>&lt;xsl:if test=&quot;$StatoOrdine=('1','3','4','5')&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;>&lt;tns6:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns6:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine=('1','3','4','5')&quot;>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns6:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns6:MOTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:TipologiaNotifica='AC' and string-length(string($ParseXml/ordine/DACRimodulata))>0&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/DACRimodulata&quot;>&lt;tns6:DATA_PREVISTA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/DACRimodulata&quot;/>&lt;/tns6:DATA_PREVISTA_ATTIVAZIONE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:TipologiaNotifica='AC' and string-length($ParseXml/ordine/fasciaOraUltimoApptD82)>0 and $ParseXml/ordine/dettaglioordine[nomeComponente='DTUPOLICYCONTATTO']/attributiDettaglioOrdine[nomeAttributo='POLICYAVVIATA']/valoreAttributo='SI'&quot;>&lt;tns6:ORARIO_APPUNTAMENTO>&lt;xsl:value-of select=&quot;xsd:time($ParseXml/ordine/fasciaOraUltimoApptD82)&quot;/>&lt;/tns6:ORARIO_APPUNTAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine=('0','2') and $ParseXml/statoRichiestaPrecedNOW=('SOSPESOD82','SOSPESOACD82')&quot;>&lt;tns6:FLAG_DESOSPENSIONE>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns6:FLAG_DESOSPENSIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine=('0','2')&quot;>&lt;tns6:SERVIZIO_FTTH>&lt;xsl:if test=&quot;$StatoOrdine='0' and $ParseXml/offerta=('BITSTREAMNGAFTTH','EASYIPNGAFTTH') and string-length($ParseXml/ordine/numeroFittizio)>0 and count($Oscuramento/Record[COD_AGESP='T1PRJ0043073'])=0&quot;>&lt;tns6:DISTRETTO>&lt;xsl:value-of select=&quot;substring($ParseXml/ordine/numeroFittizio,1, 3)&quot;/>&lt;/tns6:DISTRETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine='0' and $ParseXml/offerta=('BITSTREAMNGAFTTH','EASYIPNGAFTTH') and string-length($ParseXml/ordine/numeroFittizio)>0 and count($Oscuramento/Record[COD_AGESP='T1PRJ0043073'])=0&quot;>&lt;tns6:NUMERO>&lt;xsl:value-of select=&quot;substring($ParseXml/ordine/numeroFittizio,4)&quot;/>&lt;/tns6:NUMERO>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine='0' and $ParseXml/offerta=('BITSTREAMNGAFTTH','EASYIPNGAFTTH') and string-length($ParseXml/ordine/numeroFittizio)>0 and count($Oscuramento/Record[COD_AGESP='T1PRJ0043073'])=0&quot;>&lt;tns6:COR>&lt;xsl:value-of select=&quot;concat('0',xsd:string(xsd:long($ParseXml/ordine/numeroFittizio)))&quot;/>&lt;/tns6:COR>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/offerta=('VULAFTTH','FULLGPONPLUS') and string-length($ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='REMOTEID'][1]/valoreAttributo)>0&quot;>&lt;tns6:VULA_FTTH>&lt;tns6:ID_SERVIZIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='REMOTEID'][1]/valoreAttributo&quot;/>&lt;/tns6:ID_SERVIZIO>&lt;xsl:if test=&quot;$StatoOrdine='2'&quot;>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;xsl:variable name=&quot;UsVlanId&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo&quot;/>&lt;xsl:if test=&quot;string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo=$UsVlanId]/attributiDettaglioOrdine[nomeAttributo='INTERAGENT']/valoreAttributo)>0&quot;>&lt;tns6:VLAN>&lt;tns6:UserVlan_ID>&lt;xsl:value-of select=&quot;xsd:int($UsVlanId)&quot;/>&lt;/tns6:UserVlan_ID>&lt;tns6:CIRCUIT_ID>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo=$UsVlanId]/attributiDettaglioOrdine[nomeAttributo='INTERAGENT']/valoreAttributo&quot;/>&lt;/tns6:CIRCUIT_ID>&lt;/tns6:VLAN>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns6:VULA_FTTH>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta=('BITSTREAMNGAFTTH','FULLGPONPLUSNGA') and string-length($ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='REMOTEID'][1]/valoreAttributo)>0&quot;>&lt;tns6:BITSTREAM_NGA_FTTH>&lt;tns6:ID_SERVIZIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='REMOTEID'][1]/valoreAttributo&quot;/>&lt;/tns6:ID_SERVIZIO>&lt;xsl:if test=&quot;$StatoOrdine='2'&quot;>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;xsl:variable name=&quot;UsVlanId2&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo&quot;/>&lt;xsl:if test=&quot;string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo=$UsVlanId2]/attributiDettaglioOrdine[nomeAttributo='INTERAGENT']/valoreAttributo)>0&quot;>&lt;tns6:VLAN>&lt;tns6:UserVlan_ID>&lt;xsl:value-of select=&quot;xsd:int($UsVlanId2)&quot;/>&lt;/tns6:UserVlan_ID>&lt;tns6:CIRCUIT_ID>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIVC' and attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo=$UsVlanId2]/attributiDettaglioOrdine[nomeAttributo='INTERAGENT']/valoreAttributo&quot;/>&lt;/tns6:CIRCUIT_ID>&lt;/tns6:VLAN>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns6:BITSTREAM_NGA_FTTH>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta='EASYIPNGAFTTH' and ((string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP1']/valoreAttributo)>0 or string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP2']/valoreAttributo)>0 or string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP3']/valoreAttributo)>0 or string-length($ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP4']/valoreAttributo)>0) or ($StatoOrdine='0' and count($OloEasyIp/Record)>0))&quot;>&lt;tns6:EASYIP_NGA_FTTH>&lt;xsl:choose>&lt;xsl:when test=&quot;$StatoOrdine='0' and count($OloEasyIp/Record)>0&quot;>&lt;tns6:IP_ADDRESS_NET>&lt;xsl:value-of select=&quot;concat('0',string(xsd:int($ParseXml/ordine/distretto)))&quot;/>&lt;/tns6:IP_ADDRESS_NET>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$StatoOrdine='2' and  $ParseXml/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MODALITACONSEGNA']/valoreAttributo=('2','3','4')&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP1']/valoreAttributo&quot;>&lt;tns6:IP_ADDRESS_NET>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP1']/valoreAttributo&quot;/>&lt;/tns6:IP_ADDRESS_NET>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$StatoOrdine='0' and count($OloEasyIp/Record)>0&quot;>&lt;tns6:SUBNET_MASK_NET>&lt;xsl:value-of select=&quot;substring($ParseXml/ordine/numeroFittizio, 4)&quot;/>&lt;/tns6:SUBNET_MASK_NET>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$StatoOrdine='2' and  $ParseXml/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='MODALITACONSEGNA']/valoreAttributo=('2','3','4')&quot;>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP2']/valoreAttributo&quot;>&lt;tns6:SUBNET_MASK_NET>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP2']/valoreAttributo&quot;/>&lt;/tns6:SUBNET_MASK_NET>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP3']/valoreAttributo&quot;>&lt;tns6:BASE_IP_ADDRESS_NET_LAN>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP3']/valoreAttributo&quot;/>&lt;/tns6:BASE_IP_ADDRESS_NET_LAN>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP4']/valoreAttributo&quot;>&lt;tns6:SUBNET_MASK_NET_LAN>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUCONFIGURAZIONE']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIP4']/valoreAttributo&quot;/>&lt;/tns6:SUBNET_MASK_NET_LAN>&lt;/xsl:if>&lt;/tns6:EASYIP_NGA_FTTH>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns6:SERVIZIO_FTTH>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoOrdine='2' and count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 and $ParseXml/offerta=('EASYIPNGAFTTCAB','EASYIPNGAFTTH') and $ParseXml/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']/attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='A001' and &amp;#xD;&amp;#xA;string-length($ParseXml/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']/attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo)>0&quot;>&lt;tns6:SERVIZI_OPZIONALI>&lt;tns6:SERVIZIO_AGGIUNTIVO>&lt;tns6:CODICE_SERVIZIO>&lt;xsl:value-of select=&quot;'A001'&quot;/>&lt;/tns6:CODICE_SERVIZIO>&lt;tns6:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns6:ESITO>&lt;tns6:DATI_TECNICI>&lt;xsl:value-of select=&quot;substring-before(substring-after($ParseXml/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']/attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo, 'USERNAMEMODEM: '), ',')&quot;/>&lt;/tns6:DATI_TECNICI>&lt;/tns6:SERVIZIO_AGGIUNTIVO>&lt;/tns6:SERVIZI_OPZIONALI>&lt;/xsl:if>&lt;/tns6:WHS_StatusUpdateMig_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecipientMigrationNotify_OLOSchema.xsd="http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd"
