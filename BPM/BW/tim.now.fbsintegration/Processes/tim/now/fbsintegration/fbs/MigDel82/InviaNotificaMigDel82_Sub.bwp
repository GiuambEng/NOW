                        &lt;/xsl:choose&gt;
                    &lt;/tns9:StagingIn&gt;
                    &lt;tns9:StagingType&gt;
                        &lt;xsl:value-of select="'DELIB_82_EVENTI_OUT'"/&gt;
                    &lt;/tns9:StagingType&gt;
                    &lt;tns9:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="'NOFILE'"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="'INSERT'"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MapNotificaN4)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="186"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN8)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="189"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN10)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="191"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN6)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="192"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN5)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="194"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($MapNotificaN7)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="193"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns9:LoggerIn&gt;
                &lt;/tns9:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns8:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:tns14=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; xmlns:tns6=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd&quot; xmlns:tns13=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;IdNotifica&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichOrdn&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN8&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN10&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN6&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN7&quot;/>&#xa;    &lt;xsl:param name=&quot;CodificaOloAgc&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader5&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader4&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader3&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader2&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader1&quot;/>&#xa;    &lt;xsl:param name=&quot;MapHeader&quot;/>&#xa;    &lt;xsl:template name=&quot;InsStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;xsl:if test=&quot;$ParseXml/codiceOrdineOLO&quot;>&#xa;                    &lt;tns9:COD_ORDN_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns9:COD_ORDN_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN4)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN8)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN10)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN6)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN5)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN7)&quot;/>&#xa;                        &lt;/tns9:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;186&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;189&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;191&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;192&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;194&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:ID_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;193&quot;/>&#xa;                        &lt;/tns9:ID_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;>&#xa;                    &lt;tns9:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/tns9:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns9:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$ParseXml/IDRisorsa&quot;>&#xa;                    &lt;tns9:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/IDRisorsa&quot;/>&#xa;                    &lt;/tns9:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns9:ID_STATO_ELAB_STAG>&#xa;                &lt;tns9:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns9:TRANSACTION_ID>&#xa;                &lt;tns9:CODICEOPERATOREREC>&#xa;                    &lt;xsl:value-of select=&quot;$CodificaOloAgc&quot;/>&#xa;                &lt;/tns9:CODICEOPERATOREREC>&#xa;                &lt;xsl:if test=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;>&#xa;                    &lt;tns9:IDNOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/tns9:IDNOTIFICA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN4/tns6:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN8/tns14:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN10/tns14:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN6/tns6:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN5/tns6:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:DATANOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;$MapNotificaN7/tns6:DATA_NOTIFICA&quot;/>&#xa;                        &lt;/tns9:DATANOTIFICA>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N4'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N8'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N10'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N6'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N5'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                        &lt;tns9:NOMEFLUSSO>&#xa;                            &lt;xsl:value-of select=&quot;'N7'&quot;/>&#xa;                        &lt;/tns9:NOMEFLUSSO>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$MapNotificaN10/tns14:EVENTO&quot;>&#xa;                    &lt;tns9:EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;$MapNotificaN10/tns14:EVENTO&quot;/>&#xa;                    &lt;/tns9:EVENTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapHeader/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapHeader1/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader1/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapHeader2/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader2/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapHeader3/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader3/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapHeader4/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader4/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$MapHeader5/tns13:sourceSystem&quot;>&#xa;                            &lt;tns9:SOURCE_SYSTEM>&#xa;                                &lt;xsl:value-of select=&quot;$MapHeader5/tns13:sourceSystem&quot;/>&#xa;                            &lt;/tns9:SOURCE_SYSTEM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns9:StagingIn>&#xa;            &lt;tns9:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'DELIB_82_EVENTI_OUT'&quot;/>&#xa;            &lt;/tns9:StagingType>&#xa;            &lt;tns9:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;186&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;189&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;191&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;192&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;194&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;193&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns9:LoggerIn>&#xa;        &lt;/tns9:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNotificaToInvoke"/>
                    <bpws:target linkName="LogNotifica1ToInsStag"/>
                    <bpws:target linkName="LogNotifica2ToInsStag"/>
                    <bpws:target linkName="LogNotifica3ToInsStag"/>
                    <bpws:target linkName="LogNotifica4ToInsStag"/>
                    <bpws:target linkName="LogNotifica5ToInsStag"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsStagToAssign">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInsStag-input"
                    name="LogInsStag"
                    tibex:xpdlId="74c72c45-dd7e-4e49-9528-a5023e49acc2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToLogInsStag"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInsStagToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:TipologiaNotifica=('KO','AQ','SP') or ($Start/ns0:TipologiaNotifica=('KC','AC','AN') and not($Start/ns0:TipologiaOLODestinatario='DONATING'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
