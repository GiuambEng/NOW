    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="c44a79a7-7a43-4b8a-a32a-7d06e03f7756">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link
                                name="LogFaultToInvoke_StagingUpdate"
                                tibex:label="Staging Update" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="ErrorStagToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToRethrow" tibex:linkType="SUCCESS"/>
                            <bpws:link name="LogFaultToErrorRichOrdn" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogFault-input"
                                name="LogFault"
                                tibex:xpdlId="1ec5aa49-23aa-436c-b6c3-a8e11dcf5602"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultToInvoke_StagingUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$controlStaging='True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$controlStaging='True']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogFaultToErrorRichOrdn">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogFault-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'InviaNotificaMigDel82_Sub'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="ErrorStag-input"
                            name="ErrorStag"
                            operation="InsertUpdateStaging"
                            outputVariable="ErrorStag"
                            partnerLink="InsertUpdateStagingPortType"
                            portType="ns17:InsertUpdateStagingPortType" tibex:xpdlId="37ebaf13-583a-480f-b877-dfca479d3f36">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns9="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="InsStag"/&gt;
    &lt;xsl:param name="ParseXml"/&gt;
    &lt;xsl:param name="MapNotificaN4"/&gt;
    &lt;xsl:param name="MapNotificaN10"/&gt;
    &lt;xsl:param name="MapNotificaN6"/&gt;
    &lt;xsl:param name="MapNotificaN8"/&gt;
    &lt;xsl:param name="MapNotificaN5"/&gt;
    &lt;xsl:param name="MapNotificaN7"/&gt;
    &lt;xsl:template name="ErrorStag-input" match="/"&gt;
        &lt;tns8:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns9:StagingRequest&gt;
                    &lt;tns9:StagingIn&gt;
