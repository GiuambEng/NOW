                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://recipientoperator/Schemas/RecipientMigrationNotify_OLOSchema.xsd&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;CodificaOloAgc&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;MapNotificaN7-input&quot; match=&quot;/&quot;>&lt;tns6:WHS_CompletionOrderMig_Req>&lt;xsl:variable name=&quot;StatoOrdine&quot; select=&quot;if ($Start/tns:TipologiaNotifica='KO') then '1' else if ($Start/tns:TipologiaNotifica='AQ') then '0' else if ($Start/tns:TipologiaNotifica='AC') then '2' else if ($Start/tns:TipologiaNotifica='KC') then '3' else if ($Start/tns:TipologiaNotifica='SP') then '4' else '5'&quot;/>&lt;tns6:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;$CodificaOloAgc&quot;/>&lt;/tns6:CODICE_OPERATORE_REC>&lt;tns6:CODICE_ORDINE_REC>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/tns6:CODICE_ORDINE_REC>&lt;tns6:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns6:CODICE_OPERATORE_WHS>&lt;tns6:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/tns6:CODICE_ORDINE_WHS>&lt;tns6:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&lt;/tns6:ID_NOTIFICA>&lt;tns6:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns6:DATA_NOTIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:TipologiaNotifica='OK'&quot;>&lt;tns6:STATO_ORDINE>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns6:STATO_ORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:STATO_ORDINE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns6:STATO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;>&lt;tns6:CODICE_MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns6:CODICE_MOTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns6:MOTIVAZIONE>&lt;xsl:value-of select=&quot;$AnagCaus/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns6:MOTIVAZIONE>&lt;/xsl:if>&lt;tns6:COR>&lt;xsl:value-of select=&quot;concat('0',string(xsd:integer($ParseXml/ordine/numeroFittizio)))&quot;/>&lt;/tns6:COR>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/offerta='VULAFTTH'&quot;>&lt;tns6:COS>&lt;xsl:value-of select=&quot;'012'&quot;/>&lt;/tns6:COS>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta=('BITSTREAMNGAFTTH','EASYIPNGAFTTH')&quot;>&lt;tns6:COS>&lt;xsl:value-of select=&quot;'015'&quot;/>&lt;/tns6:COS>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta='FULLGPONPLUS'&quot;>&lt;tns6:COS>&lt;xsl:value-of select=&quot;'022'&quot;/>&lt;/tns6:COS>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta='FULLGPONPLUSNGA'&quot;>&lt;tns6:COS>&lt;xsl:value-of select=&quot;'023'&quot;/>&lt;/tns6:COS>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseXml/offerta='SEMIVULAFTTH'&quot;>&lt;tns6:COS>&lt;xsl:value-of select=&quot;'018'&quot;/>&lt;/tns6:COS>&lt;/xsl:when>&lt;/xsl:choose>&lt;tns6:DATA_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/DES&quot;/>&lt;/tns6:DATA_ESPLETAMENTO_ORDINE>&lt;xsl:if test=&quot;$ParseXml/ordine/ORA_DES&quot;>&lt;tns6:ORARIO_ESPLETAMENTO_ORDINE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/ORA_DES&quot;/>&lt;/tns6:ORARIO_ESPLETAMENTO_ORDINE>&lt;/xsl:if>&lt;tns6:SERVIZIO_FTTH>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUINTERVENTOSEDECLIENTE']/attributiDettaglioOrdine[nomeAttributo='CODICEESITO']/valoreAttributo&quot;>&lt;tns6:MOTIVAZIONE_INTERVENTO_IN_SEDE_CLIENTE>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUINTERVENTOSEDECLIENTE']/attributiDettaglioOrdine[nomeAttributo='CODICEESITO']/valoreAttributo&quot;/>&lt;/tns6:MOTIVAZIONE_INTERVENTO_IN_SEDE_CLIENTE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUINDIRIZZOINTERVENTOCLIENTE']/attributiDettaglioOrdine[nomeAttributo='CODICEINDIRIZZO']/valoreAttributo&quot;>&lt;tns6:CODICE_INDIRIZZO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='DTUINDIRIZZOINTERVENTOCLIENTE']/attributiDettaglioOrdine[nomeAttributo='CODICEINDIRIZZO']/valoreAttributo&quot;/>&lt;/tns6:CODICE_INDIRIZZO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/offerta=('VULAFTTH','FULLGPONPLUS') and $Start/tns:TipologiaNotifica='OK' and $ParseXml/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='INTERMEDIATEAGENTFULL']/valoreAttributo='SI'&quot;>&lt;tns6:VULA_FTTH>&lt;tns6:ID_SERVIZIO>&lt;xsl:value-of select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']/attributiDettaglioOrdine[nomeAttributo='REMOTEID'][1]/valoreAttributo&quot;/>&lt;/tns6:ID_SERVIZIO>&lt;xsl:for-each select=&quot;$ParseXml/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;tns6:USER_VLAN>&lt;xsl:variable name=&quot;UserVlanId&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo='USERVLANID']/valoreAttributo&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UserVlanId)>0&quot;>&lt;tns6:USER_VLAN_ID>&lt;xsl:value-of select=&quot;xsd:int($UserVlanId)&quot;/>&lt;/tns6:USER_VLAN_ID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:USER_VLAN_ID>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns6:USER_VLAN_ID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UserVlanId)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ParseXml/ordine/dettaglioordine[nomeComponente='DTUDATIVC'])>1&quot;>&lt;tns6:CIRCUIT_ID>&lt;xsl:value-of se