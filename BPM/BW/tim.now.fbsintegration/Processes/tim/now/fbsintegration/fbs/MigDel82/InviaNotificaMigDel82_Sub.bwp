                                    sqlStatement="select nome, valore from rich_olo_dett where idtplg_dato_rich='22' and nome ='COR' and id_rich_olo=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="id_rich_olo"/>
