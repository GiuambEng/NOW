                                    expression="$ParseXml/codificaOLOAGCOM='INF' and not($Start/ns0:TipologiaOLODestinatario='DONATING')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
