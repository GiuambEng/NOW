                                    sqlStatement="SELECT ID_ANAGRAFICA_CAUSALE FROM RICH_ORDN_COMUNIC_NOTF_DEL82 &#xa;WHERE COD_TIPOLOGIA_NOTIF &#xa;IN ('RD', 'SP', 'KD', 'KO') AND ID_TIPOL_DEST_NOTIFICA = 1&#xa;AND ID_RICHIESTA_OLO =? ORDER BY TIMESTAMP_CREAZ DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
