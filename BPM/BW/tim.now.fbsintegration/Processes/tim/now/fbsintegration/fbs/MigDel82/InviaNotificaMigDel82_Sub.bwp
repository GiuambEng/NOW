                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8964d507-1450-4e24-a030-acfd352a10f6+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InviaNotificaMigDel82/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapNotificaN4&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichOrdn&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN8&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN10&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN6&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN5&quot;/>&#xa;    &lt;xsl:param name=&quot;MapNotificaN7&quot;/>&#xa;    &lt;xsl:param name=&quot;CodificaOloAgc&quot;/>&#xa;    &lt;xsl:param name=&quot;CodificaOloNow&quot;/>&#xa;    &lt;xsl:template name=&quot;InsRichOrdn-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN4)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN8)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN10)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN6)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN5)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                    &lt;TRACCIATO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($MapNotificaN7)&quot;/>&#xa;                    &lt;/TRACCIATO>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;STRUTTURA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$ParseXml/strutturaRichiesta&quot;/>&#xa;            &lt;/STRUTTURA_RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:TipologiaNotifica = ('AQ','KO')&quot;>&#xa;                    &lt;ORIGINE_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RICHIESTA OLO&amp;quot;&quot;/>&#xa;                    &lt;/ORIGINE_NOTIFICA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ParseXml/IDRichiestaOLO) > 0 and $ParseXml/tipoRichiesta = &amp;quot;ORDINE&amp;quot;&quot;>&#xa;                    &lt;ORIGINE_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE NOW WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/ORIGINE_NOTIFICA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ORIGINE_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE SU ORDINE WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/ORIGINE_NOTIFICA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&#xa;            &lt;/OPERATORE>&#xa;            &lt;ID_TIPOL_STATO_NOTIFICA>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/ID_TIPOL_STATO_NOTIFICA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns:TipologiaOLODestinatario) = 0&quot;>&#xa;                    &lt;DESCR_TIPOL_DEST_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;'RECIPIENT'&quot;/>&#xa;                    &lt;/DESCR_TIPOL_DEST_NOTIFICA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_TIPOL_DEST_NOTIFICA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:TipologiaOLODestinatario)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:TipologiaOLODestinatario&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DESCR_TIPOL_DEST_NOTIFICA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns:Tool_StatoOLOA)>0&quot;>&#xa;                    &lt;STATO_RICH_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:Tool_StatoOLOA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Tool_StatoOLOA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_RICH_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_RICH_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ParseXml/statoRichiestaOLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaOLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_RICH_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns:Tool_StatoNOWA)>0&quot;>&#xa;                    &lt;STATO_RICH_NOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:Tool_StatoNOWA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Tool_StatoNOWA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_RICH_NOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_RICH_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/statoRichiestaNOW&quot;/>&#xa;                    &lt;/STATO_RICH_NOW>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICHIESTA_OLO>&#xa;                &lt;xsl:value-of select=&quot;$ParseXml/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICHIESTA_OLO>&#xa;            &lt;ID_RICHORDN_COMNOTFDEL82>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IdRichOrdn/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICHORDN_COMNOTFDEL82>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($Start/tns:IdAnagraficaCausale))>0&quot;>&#xa;                    &lt;ID_ANAGRAFICA_CAUSALE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:IdAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:IdAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ANAGRAFICA_CAUSALE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODIFICA_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$CodificaOloAgc&quot;/>&#xa;            &lt;/CODIFICA_OLO_AGCOM>&#xa;            &lt;COD_TIPOLOGIA_NOTIF>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:TipologiaNotifica&quot;/>&#xa;            &lt;/COD_TIPOLOGIA_NOTIF>&#xa;            &lt;CODICE_OLO_NUMERICO>&#xa;                &lt;xsl:value-of select=&quot;$CodificaOloNow&quot;/>&#xa;            &lt;/CODICE_OLO_NUMERICO>&#xa;            &lt;OAO_SOURCE_B2B>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml/oaoSourceB2B)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/oaoSourceB2B&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OAO_SOURCE_B2B>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN4)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N4'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN8)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N8'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN10)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N10'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN6)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N6'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN5)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N5'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapNotificaN7)&quot;>&#xa;                    &lt;NOME_FLUSSO>&#xa;                        &lt;xsl:value-of select=&quot;'N7'&quot;/>&#xa;                    &lt;/NOME_FLUSSO>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns10:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF_DEL82 (TRACCIATO, TIMESTAMP_CREAZ, TIMESTAMP_AGG, STRUTTURA_RICHIESTA, ORIGINE_NOTIFICA, OPERATORE, ID_TIPOL_STATO_NOTIFICA, ID_TIPOL_DEST_NOTIFICA, ID_RICHCOMUNIC_STATO, ID_RICHIESTA_OLO, ID_RICHORDN_COMNOTFDEL82, ID_ANAGRAFICA_CAUSALE, CODIFICA_OLO_AGCOM, COD_TIPOLOGIA_NOTIF, CODICE_OLO_NUMERICO, OAO_SOURCE_B2B, NOME_FLUSSO) VALUES(?,SYSDATE,SYSDATE,?,?,?,?,(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR = ?),(SELECT IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTOLO WHERE STATO_RICH_OLO = ? AND STATO_RICH_NOW = ?),?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="TRACCIATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_RICHIESTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ORIGINE_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOL_STATO_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_TIPOL_DEST_NOTIFICA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_RICH_NOW"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICHIESTA_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHORDN_COMNOTFDEL82"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAGRAFICA_CAUSALE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_TIPOLOGIA_NOTIF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO_NUMERICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OAO_SOURCE_B2B"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FLUSSO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdRichOrdn-input" name="UpdRichOrdn"
                    outputVariable="UpdRichOrdn"
                    tibex:xpdlId="5c5e6f6e-914a-40fc-957c-a78533614b74" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdStagToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdRichOrdnToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ParseXml/statoRichiestaOLO = ('SCARTATO','SOSPESO','SOSPESOCONNOTIFICAFS','ESPLETAMENTOTECNICOKO','ANNULLATO','ACQUISITOKO','ACCETTATOKO','ESPLETATOKO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ParseXml/statoRichiestaOLO = ('SCARTATO','SOSPESO','SOSPESOCONNOTIFICAFS','ESPLETAMENTOTECNICOKO','ANNULLATO','ACQUISITOKO','ACCETTATOKO','ESPLETATOKO')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdRichOrdnToIdAnagCausGUI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5c5e6f6e-914a-40fc-957c-a78533614b74+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdRichOrdn&quot;/>&lt;xsl:template name=&quot;UpdRichOrdn-input&quot; match=&quot;/&quot;>&lt;tns11:jdbcUpdateActivityInput>&lt;ID_TIPOL_STATO_NOTIFICA>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ID_TIPOL_STATO_NOTIFICA>&lt;ID_RICHORDN_COMNOTFDEL82>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdRichOrdn/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$IdRichOrdn/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICHORDN_COMNOTFDEL82>&lt;/tns11:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RICH_ORDN_COMUNIC_NOTF_DEL82 SET TIMESTAMP_AGG=SYSDATE, ID_TIPOL_STATO_NOTIFICA=? WHERE ID_RICHORDN_COMNOTFDEL82=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOL_STATO_NOTIFICA"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHORDN_COMNOTFDEL82"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckNotifica" tibex:xpdlId="4581c905-f260-410c-b1de-241675362b60">
                <bpws:targets>
                    <bpws:target linkName="LogIdToEmpty"/>
                    <bpws:target linkName="LogAnagCausToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckNotificaToJDBCQuery2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica=('KO','AQ','SP') or ($Start/ns0:TipologiaNotifica=('KC','AC','AN') and not($Start/ns0:TipologiaOLODestinatario='DONATING'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('KO','AQ','SP') or ($Start/ns0:TipologiaNotifica=('KC','AC','AN') and not($Start/ns0:TipologiaOLODestinatario='DONATING'))]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica='CS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='CS']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToJDBCQuery1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica=('KC','AC','AN','OK','KD') and $Start/ns0:TipologiaOLODestinatario='DONATING'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('KC','AC','AN','OK','KD') and $Start/ns0:TipologiaOLODestinatario='DONATING']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToMapper1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica='PC'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='PC']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToMapper2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica='RD'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica='RD']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNotificaToMapper3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:TipologiaNotifica=('OK','KD') and not($Start/ns0:TipologiaOLODestinatario='DONATING')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:TipologiaNotifica=('OK','KD') and not($Start/ns0:TipologiaOLODestinatario='DONATING')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapNotificaN8-input"
                    name="MapNotificaN8" outputVariable="MapNotificaN8"
                    tibex:xpdlId="4c5d8cd1-9d54-417f-bd33-61b18c05c7b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToMapNotifica1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapNotifica1ToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns14=&quot;http://donatingoperator/Schemas/DonatingMigrationNotify_OLOSchema.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:param name=&quot;RichDett&quot;/>&lt;xsl:template name=&quot;MapNotifica1-input&quot; match=&quot;/&quot;>&lt;tns14:WHS_Check_sessione_Req>&lt;tns14:CODICE_OPERATORE_REC>&lt;xsl:value-of select=&quot;$ParseXml/codificaOLOAGCOM&quot;/>&lt;/tns14:CODICE_OPERATORE_REC>&lt;tns14:CODICE_OPERATORE_WHS>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns14:CODICE_OPERATORE_WHS>&lt;tns14:CODICE_ORDINE_WHS>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/tns14:CODICE_ORDINE_WHS>&lt;tns14:ID_NOTIFICA>&lt;xsl:value-of select=&quot;$IdNotifica/Record[1]/NEXTVAL&quot;/>&lt;/tns14:ID_NOTIFICA>&lt;tns14:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns14:DATA_NOTIFICA>&lt;tns14:CODICE_SESSIONE>&lt;xsl:value-of select=&quot;$RichDett/Record[NOME='CODICESESSIONE']/VALORE&quot;/>&lt;/tns14:CODICE_SESSIONE>&lt;tns14:COR>&lt;xsl:value-of select=&quot;$RichDett/Record[NOME='COR']/VALORE&quot;/>&lt;/tns14:COR>&lt;xsl:if test=&quot;count($RichDett/Record[NOME='DN'])>0&quot;>&lt;tns14:NUMERAZIONI>&lt;xsl:for-each select=&quot;$RichDett/Record[NOME='DN']&quot;>&lt;tns14:DN>&lt;xsl:value-of select=&quot;VALORE&quot;/>&lt;/tns14:DN>&lt;/xsl:for-each>&lt;/tns14:NUMERAZIONI>&lt;/xsl:if>&lt;/tns14:WHS_Check_sessione_Req>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
