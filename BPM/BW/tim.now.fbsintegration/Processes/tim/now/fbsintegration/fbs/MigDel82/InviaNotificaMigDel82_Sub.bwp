                    name="AnagCaus" outputVariable="AnagCaus"
                    tibex:xpdlId="69651755-41e8-451d-80dd-f83b2876fcd7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogIdToJDBCQuery"/>
