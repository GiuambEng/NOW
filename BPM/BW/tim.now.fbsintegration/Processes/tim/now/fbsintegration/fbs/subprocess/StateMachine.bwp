                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;AnagEsitoOF&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output AnagEsitoOF: ',tib:render-xml($AnagEsitoOF))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="ResponseOK" outputVariable="Response"
                    tibex:xpdlId="9b64f251-de17-43ad-9b45-f7d483308904" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ResponseOKToLogOutput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Notifiche&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MacchinaStati&quot;/>&lt;xsl:param name=&quot;StatoRic&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:StateMachineValidationResponseOF>&lt;tns:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns:ID_RICHIESTA>&lt;tns:ESITO_VALIDAZIONE>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:ESITO_VALIDAZIONE>&lt;xsl:if test=&quot;$MacchinaStati/Record[1]/STATORICHIESTAOPENFIBER&quot;>&lt;tns:STATO_SUCCESSIVO_OF>&lt;xsl:value-of select=&quot;$MacchinaStati/Record[1]/STATORICHIESTAOPENFIBER&quot;/>&lt;/tns:STATO_SUCCESSIVO_OF>&lt;/xsl:if>&lt;xsl:if test=&quot;$StatoRic/Record[1]/STATORICHIESTAOF&quot;>&lt;tns:FLAG_ALTRO_OPERATORE>&lt;xsl:value-of select=&quot;$StatoRic/Record[1]/STATORICHIESTAOF&quot;/>&lt;/tns:FLAG_ALTRO_OPERATORE>&lt;/xsl:if>&lt;tns:NOTIFICA>&lt;xsl:copy-of select=&quot;$Notifiche/tns:Notifica/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Notifiche/tns:Notifica/@*&quot;/>&lt;xsl:copy-of select=&quot;$Notifiche/tns:Notifica/node()&quot;/>&lt;/tns:NOTIFICA>&lt;xsl:copy-of select=&quot;$Start/tns:OF_CompletionOrder_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:OF_Reschedule_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:OF_StatusUpdate_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:WHS_StatusUpdateMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:WHS_RescheduleMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:WHS_CompletionOrderMig_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:WHS_Event_Request&quot;/>&lt;/tns:StateMachineValidationResponseOF>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="5e1b364b-af3c-43ca-bf5b-d0b5cfd237ae"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
