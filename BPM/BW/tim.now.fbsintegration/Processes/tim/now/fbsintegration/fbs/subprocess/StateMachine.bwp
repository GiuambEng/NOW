                                    columnIndex="1"
                                    columnName="ID_ANAG_CAUS"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
