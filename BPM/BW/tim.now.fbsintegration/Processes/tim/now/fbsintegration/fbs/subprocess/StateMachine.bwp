                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0da36043-b221-479e-b81a-97de599d102b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;MacchinaStati&quot;/>&lt;xsl:param name=&quot;SottofamOfferta&quot;/>&lt;xsl:param name=&quot;TiplgLavor&quot;/>&lt;xsl:param name=&quot;CausalePrec&quot;/>&lt;xsl:template name=&quot;Associativa-input&quot; match=&quot;/&quot;>&lt;tns8:jdbcQueryActivityInput>&lt;id_tiplg_esito_openfiber>&lt;xsl:value-of select=&quot;xsd:int($MacchinaStati/Record[number($index)]/ID_TIPLG_ESITO_OPENFIBER)&quot;/>&lt;/id_tiplg_esito_openfiber>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CausalePrec/Record[1]/CAUSALE_PRECEDENTE)&quot;>&lt;id_anag_caus_precedente>&lt;xsl:value-of select=&quot;xsd:int($CausalePrec/Record[1]/CAUSALE_PRECEDENTE)&quot;/>&lt;/id_anag_caus_precedente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;id_anag_caus_precedente xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;id_sottofamig_offerta>&lt;xsl:value-of select=&quot;xsd:int($SottofamOfferta/Record[1]/ID_SOTTOFAMIG_OFFERTA)&quot;/>&lt;/id_sottofamig_offerta>&lt;idtplg_lavrz>&lt;xsl:value-of select=&quot;xsd:int($TiplgLavor/Record[1]/IDTPLG_LAVRZ)&quot;/>&lt;/idtplg_lavrz>&lt;/tns8:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
