                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT a.id_anag_caus&#xa;FROM appuser.ass_evento_of_causale_olo a&#x9;&#xa;WHERE a.id_tiplg_esito_openfiber = ?                                                      &#xa;AND (a.id_anag_caus_precedente = ? OR a.id_anag_caus_precedente IS NULL)                  &#xa;AND a.id_sottofamig_offerta = ?                                                           &#xa;AND a.idtplg_lavrz = ?                                                                    &#xa;AND SYSDATE BETWEEN a.datainiziovalidita AND a.datafinevalidita&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

