                <bpws:link name="WhileToResponseKO" tibex:linkType="ERROR"/>
                <bpws:link name="WhileToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ResponseOKToLogOutput" tibex:linkType="SUCCESS"/>
                <bpws:link name="ResponseKOToGenericLogger" tibex:linkType="SUCCESS"/>
