                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output StateMachine: ',tib:render-xml($Response))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="DatiRichiesta-input"
                    name="DatiRichiesta" outputVariable="DatiRichiesta"
                    tibex:xpdlId="3876501d-6bf4-4e33-9c62-ad5210c95e7d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToDatiRichiesta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DatiRichiestaToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3876501d-6bf4-4e33-9c62-ad5210c95e7d+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DatiRichiesta-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/IDRICHIESTAOLO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT rich.OFFERTA, rich.LAVORAZIONE, rich.STATORICHIESTAOF, rich.STATORICHIESTAPRECEDOF, tp.ID_SCENARIO &#xa;  FROM BDS_1_CASEDATA_RICHIESTA rich, TIPOLG_SCENARIO tp&#xa;  WHERE rich.IDRICHIESTAOLO=? and rich.TIPOLOGIASCENARIO=tp.SCENARIO_BPM&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="STATORICHIESTAOF"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="STATORICHIESTAPRECEDOF"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="ID_SCENARIO"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRichiesta-input"
                    name="LogRichiesta"
                    tibex:xpdlId="a240ad76-fc18-4ab4-8ebd-e9c1bc7626aa"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToLogRichiesta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRichiestaToMacchinaStati"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;DatiRichiesta&quot;/>&lt;xsl:param name=&quot;StatoRic&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Dati richiesta recuperati da tabella BDS: ',tib:render-xml($DatiRichiesta))&quot;/>&lt;/tns6:Message>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat('Dati richiesta recuperati da tabella semaforo: ',tib:render-xml($StatoRic))&quot;/>&lt;/tns6:Payload>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MacchinaStati-input"
                    name="MacchinaStati" outputVariable="MacchinaStati"
                    tibex:xpdlId="3f9da2dc-6c23-4cc2-b9e9-a030682ef3be" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRichiestaToMacchinaStati"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MacchinaStatiToLogMS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($MacchinaStati/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($MacchinaStati/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MacchinaStatiToLogKOFuoriSeq">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3f9da2dc-6c23-4cc2-b9e9-a030682ef3be+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DatiRichiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;StatoRic&quot;/>&lt;xsl:template name=&quot;MacchinaStati-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DatiRichiesta/Record[1]/OFFERTA)&quot;>&lt;xsl:value-of select=&quot;$DatiRichiesta/Record[1]/OFFERTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'OF_CompletionOrder_OpenStream'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'OF_Reschedule'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_StatusUpdateMig_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'WHS_StatusUpdateMig'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_RescheduleMig_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'WHS_RescheduleMig'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_CompletionOrderMig_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'WHS_OrderCompletionMig'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_Event_Request)&quot;>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'WHS_Event'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:when>&lt;xsl:otherwise>&lt;EVENTO_OPENFIBER>&lt;xsl:value-of select=&quot;'OF_StatusUpdate'&quot;/>&lt;/EVENTO_OPENFIBER>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;STATO_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:STATO_ORDINE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_CompletionOrder_OpenStream_Request/tns:STATO_ORDINE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request)&quot;>&lt;STATO_ORDINE xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_StatusUpdateMig_Request)&quot;>&lt;STATO_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:WHS_StatusUpdateMig_Request/tns:STATO_ORDINE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:WHS_StatusUpdateMig_Request/tns:STATO_ORDINE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_RescheduleMig_Request)&quot;>&lt;STATO_ORDINE xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_CompletionOrderMig_Request)&quot;>&lt;STATO_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:WHS_CompletionOrderMig_Request/tns:STATO_ORDINE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:WHS_CompletionOrderMig_Request/tns:STATO_ORDINE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_Event_Request)&quot;>&lt;STATO_ORDINE xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_StatusUpdate_OpenStream_Request/tns:STATO_ORDINE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_CompletionOrder_OpenStream_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_CompletionOrder_OpenStream_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request)&quot;>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_Reschedule_OpenStream_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_Reschedule_OpenStream_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_StatusUpdateMig_Request)&quot;>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:WHS_StatusUpdateMig_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:WHS_StatusUpdateMig_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_RescheduleMig_Request)&quot;>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:WHS_RescheduleMig_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:WHS_RescheduleMig_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_CompletionOrderMig_Request)&quot;>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:WHS_CompletionOrderMig_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:WHS_CompletionOrderMig_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:WHS_Event_Request)&quot;>&lt;CODICE_MOTIVAZIONE xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_MOTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:OF_StatusUpdate_OpenStream_Request/tns:CODICE_MOTIVAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_MOTIVAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIPOLG_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DatiRichiesta/Record[1]/LAVORAZIONE)&quot;>&lt;xsl:value-of select=&quot;$DatiRichiesta/Record[1]/LAVORAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPOLG_LAVRZ>&lt;STATORICHIESTAOPENFIBERcorrente>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StatoRic/Record[1]/STATORICHIESTAOF)&quot;>&lt;xsl:value-of select=&quot;$StatoRic/Record[1]/STATORICHIESTAOF&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATORICHIESTAOPENFIBERcorrente>&lt;STATORICHIESTAOPENFIBERprecedente>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StatoRic/Record[1]/STATORICHIESTAPRECEDOF)&quot;>&lt;xsl:value-of select=&quot;$StatoRic/Record[1]/STATORICHIESTAPRECEDOF&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATORICHIESTAOPENFIBERprecedente>&lt;ID_SCENARIO>&lt;xsl:value-of select=&quot;xsd:int($DatiRichiesta/Record[1]/ID_SCENARIO)&quot;/>&lt;/ID_SCENARIO>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT MS.COD_TIPOLG_NOTF_RECIPIENT, ST1.statorichiestaopenfiber, TE.id_tiplg_esito_openfiber, AD.COD_MACCHINA_A_STATI_DTU, MS.IDTPLG_EVENTO&#xa;  FROM appuser.macchina_stati_openfiber MS,&#xa;       appuser.TIPOLOGIA_ESITO_OPENFIBER TE,&#xa;       appuser.AMBITO_DTU AD,&#xa;       appuser.TIPOLG_LAVRZ TL,&#xa;       appuser.TRASCODFC_OFFERTA TRO,&#xa;       appuser.STATO_RICHIESTA_OPENFIBER ST1&#xa;  WHERE TRO.NOME_OFFERTA_ESTERNA = ?&#xa;    AND TRO.PROVENIENZA = 'BPM'&#xa;    AND TRO.ID_OFFERTA = AD.ID_OFFERTA&#xa;    AND TE.EVENTO_OPENFIBER = ?&#xa;    AND (te.stato_ordine = ? OR te.stato_ordine is null)&#xa;    AND (te.codice_motivazione = ? OR te.codice_motivazione is null)&#xa;    AND TE.IDTPLG_EVENTO = MS.IDTPLG_EVENTO&#xa;    AND TL.TIPOLG_LAVRZ = ? AND TL.IDTPLG_LAVRZ = AD.IDTPLG_LAVRZ&#xa;    AND MS.IDRICH_COM_STRC_CORRNT = (SELECT ST2.IDSTATORICHOPENFIBER FROM STATO_RICHIESTA_OPENFIBER ST2 WHERE ST2.STATORICHIESTAOPENFIBER = ?)&#xa;    AND (MS.IDRICH_COM_STRC_PRECED = (SELECT ST3.IDSTATORICHOPENFIBER FROM STATO_RICHIESTA_OPENFIBER ST3 WHERE ST3.STATORICHIESTAOPENFIBER = ?)&#xa;            OR MS.IDRICH_COM_STRC_PRECED IS NULL)&#xa;    AND MS.IDRICH_COM_STRC_SUCCV = ST1.IDSTATORICHOPENFIBER&#xa;    AND AD.COD_MACCHINA_A_STATI_DTU = MS.COD_MACCHINA_STATI_OPEN_FIBER &#xa;    AND (AD.ID_SCENARIO = ? OR AD.ID_SCENARIO IS NULL)&#xa;    ORDER BY MS.IDTPLG_EVENTO ASC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="EVENTO_OPENFIBER"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_ORDINE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_MOTIVAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATORICHIESTAOPENFIBERcorrente"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATORICHIESTAOPENFIBERprecedente"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_SCENARIO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="STATORICHIESTAOPENFIBER"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="ID_TIPLG_ESITO_OPENFIBER"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="COD_MACCHINA_A_STATI_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="IDTPLG_EVENTO"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="StatoRic-input"
                    name="StatoRic" outputVariable="StatoRic"
                    tibex:xpdlId="797db454-ba6b-4a7b-8104-3170f3d659cb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DatiRichiestaToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLogRichiesta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+797db454-ba6b-4a7b-8104-3170f3d659cb+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StatoRic-input&quot; match=&quot;/&quot;>&lt;tns12:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/ID_RICH_OLO>&lt;/tns12:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATORICHIESTAOF, STATORICHIESTAPRECEDOF&#xa;  FROM EVENTI_OF_TO_BPM_SEMAFORO&#xa;  WHERE ID_RICH_OLO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="STATORICHIESTAOF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="STATORICHIESTAPRECEDOF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
