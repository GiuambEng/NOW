                <bpws:link name="LogInputToDatiRichiesta" tibex:linkType="SUCCESS"/>
                <bpws:link name="DatiRichiestaToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRichiestaToMacchinaStati" tibex:linkType="SUCCESS"/>
                <bpws:link name="MacchinaStatiToLogMS" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MacchinaStatiToLogKOFuoriSeq" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBCQueryToLogRichiesta" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="2a9a332c-ec75-4f57-8da0-d6c86b3fede7"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
