                    tibex:xpdlId="d56762ff-dbf1-4101-880c-bc77d50876e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Response&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="299f8944-dedf-4038-abd5-f86687d28b88"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToDatiRichiesta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Input StateMachine: ',tib:render-xml($Start))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMS-input"
                    name="LogMS"
                    tibex:xpdlId="836bd4e5-3335-41db-a20b-002b70ba1bc1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MacchinaStatiToLogMS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMSToWhile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogMSToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$StatoRic/Record[1]/STATORICHIESTAOF='INRICHIESTAANNULLAMENTOAUTO' and ((exists($Start/ns0:OF_StatusUpdate_OpenStream_Request) and $Start/ns0:OF_StatusUpdate_OpenStream_Request/ns0:STATO_ORDINE='5') or (exists($Start/ns0:WHS_StatusUpdateMig_Request) and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:STATO_ORDINE='5'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$StatoRic/Record[1]/STATORICHIESTAOF='INRICHIESTAANNULLAMENTOAUTO' and ((exists($Start/ns0:OF_StatusUpdate_OpenStream_Request) and $Start/ns0:OF_StatusUpdate_OpenStream_Request/ns0:STATO_ORDINE='5') or (exists($Start/ns0:WHS_StatusUpdateMig_Request) and $Start/ns0:WHS_StatusUpdateMig_Request/ns0:STATO_ORDINE='5'))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;MacchinaStati&quot;/>&lt;xsl:template name=&quot;LogMS-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output macchina a stati: ',tib:render-xml($MacchinaStati))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogKOFuoriSeq-input"
                    name="LogKOFuoriSeq"
                    tibex:xpdlId="7f83ccc0-8c93-4de7-9715-13aa1a44db35"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MacchinaStatiToLogKOFuoriSeq"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogKOFuoriSeqToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogKOFuoriSeq-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato nella tabella della Macchina a Stati&amp;quot;&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="ResponseKO" outputVariable="Response"
                    tibex:xpdlId="8fbad0cd-a116-4740-a866-9ce6a7431761" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogKOFuoriSeqToAssign"/>
                        <bpws:target linkName="WhileToResponseKO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ResponseKOToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:StateMachineValidationResponseOF>&lt;tns:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns:ID_RICHIESTA>&lt;tns:ESITO_VALIDAZIONE>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO_VALIDAZIONE>&lt;xsl:copy-of select=&quot;$Start/tns:OF_CompletionOrder_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:OF_Reschedule_OpenStream_Request&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:OF_StatusUpdate_OpenStream_Request&quot;/>&lt;/tns:StateMachineValidationResponseOF>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CausalePrec-input" name="CausalePrec"
                    outputVariable="CausalePrec"
                    tibex:xpdlId="7c112950-ab6f-49ed-9c5a-3728b4624803" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMSToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CausalePrecToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c112950-ab6f-49ed-9c5a-3728b4624803+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CausalePrec-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/ID_RICH_OLO>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAG_CAUS AS CAUSALE_PRECEDENTE&#xa;FROM RICH_ORDN_COMUNIC_TRACC &#xa;WHERE ID_RICH_OLO = ?&#xa;AND STATO_NOW_A='SOSPESOOF'&#xa;ORDER BY TIMSTP_TRACC DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CAUSALE_PRECEDENTE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCausalePrec-input"
                    name="LogCausalePrec"
                    tibex:xpdlId="429e9c88-f1db-4796-a701-9d4be298e867"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CausalePrecToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCausalePrecToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;CausalePrec&quot;/>&lt;xsl:template name=&quot;LogCausalePrec-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'StateMachine'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output CausalePrecedente: ',tib:render-xml($CausalePrec))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="53e08aa9-296b-43d6-a2b0-d6f343cadcdc">
                <bpws:targets>
                    <bpws:target linkName="LogMSToWhile"/>
                    <bpws:target linkName="LogCausalePrecToWhile"/>
                </bpws:targets>
                <bpws:sources>
