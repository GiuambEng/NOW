                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT SO.ID_SOTTOFAMIG_OFFERTA&#xa;&#x9;FROM SOTTO_FAMIG_OFFERTA SO, TRASCODFC_OFFERTA TR, OFFERTA O&#xa;&#x9;WHERE SO.ID_SOTTOFAMIG_OFFERTA = O.ID_SOTTOFAMIG_OFFERTA&#xa;&#x9;&#x9;AND O.ID_OFFERTA = TR.ID_OFFERTA&#xa;&#x9;&#x9;AND TR.NOME_OFFERTA_ESTERNA = ?&#xa;&#x9;&#x9;AND TR.PROVENIENZA = 'BPM'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

