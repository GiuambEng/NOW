        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="LogCaus-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Notifiche" name="Notifiche"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
        <bpws:variable element="ns20:ActivityErrorData"
            name="_error_Throw" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogOutput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns21:jdbcQueryActivityInput"
            name="AnagEsitoOF-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns22:resultSet" name="AnagEsitoOF" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityErrorData"
            name="_error_AnagEsitoOF" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogAnagEsito-input" sca-bpel:internal="true"/>
        <bpws:variable name="IntervalloRetry" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/WaitTimeReceiveFBS" type="xsd:int"/>
        <bpws:variable name="NumeroRetry" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/RetryMacchinaStati" type="xsd:int"/>
