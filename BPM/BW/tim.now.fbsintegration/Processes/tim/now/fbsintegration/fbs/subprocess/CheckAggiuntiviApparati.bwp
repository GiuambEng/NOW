                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ApparatiCodServ&quot;/>&lt;xsl:param name=&quot;Apparati&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CodiceServAggiuntivo&quot;/>&lt;xsl:template name=&quot;ApparatiCodServ&quot; match=&quot;/&quot;>&lt;tns2:ApparatiCodServ>&lt;xsl:copy-of select=&quot;$ApparatiCodServ/tns2:Apparati&quot;/>&lt;tns2:Apparati>&lt;xsl:if test=&quot;$Apparati/tns2:Apparati[$index]/tns2:CodiceApparato&quot;>&lt;tns2:CodiceApparato>&lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:CodiceApparato&quot;/>&lt;/tns2:CodiceApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiceServAggiuntivo/Record[1]/VALOREATTRIBUTO&quot;>&lt;tns2:NomeServizio>&lt;xsl:value-of select=&quot;$CodiceServAggiuntivo/Record[1]/VALOREATTRIBUTO&quot;/>&lt;/tns2:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$Apparati/tns2:Apparati[$index]/tns2:EsitoConsegnaApparato&quot;>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:EsitoConsegnaApparato&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;$Apparati/tns2:Apparati[$index]/tns2:IdApparatoConsegnato&quot;>&lt;tns2:IdApparatoConsegnato>&lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:IdApparatoConsegnato&quot;/>&lt;/tns2:IdApparatoConsegnato>&lt;/xsl:if>&lt;xsl:if test=&quot;$Apparati/tns2:Apparati[$index]/tns2:CodiceMotivazioneConsegna&quot;>&lt;tns2:CodiceMotivazioneConsegna>&lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:CodiceMotivazioneConsegna&quot;/>&lt;/tns2:CodiceMotivazioneConsegna>&lt;/xsl:if>&lt;xsl:if test=&quot;$Apparati/tns2:Apparati[$index]/tns2:MotivazioneConsegna&quot;>&lt;tns2:MotivazioneConsegna>&lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:MotivazioneConsegna&quot;/>&lt;/tns2:MotivazioneConsegna>&lt;/xsl:if>&lt;/tns2:Apparati>&lt;/tns2:ApparatiCodServ>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
