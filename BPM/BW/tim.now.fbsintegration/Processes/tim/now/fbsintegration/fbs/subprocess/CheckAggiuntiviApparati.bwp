                                <bpws:link
                                    name="ApparatiCodServToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="b9ea3069-1845-4032-8989-039596f87bab">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="64e9e3a9-5da9-4258-a955-5cc386cce05f">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd1_Aggiuntivoesistente"/>
                                    <bpws:target linkName="AssignToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="IdDettParentApparato-input"
                                    name="IdDettParentApparato"
                                    outputVariable="IdDettParentApparato"
                                    tibex:xpdlId="986467e4-793f-4a5b-a748-0096a6083e32" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="IdDettParentApparatoToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+986467e4-793f-4a5b-a748-0096a6083e32+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Apparati&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;IdDettParentApparato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/sm:IdRichiesta&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;VALOREATTRIBUTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Apparati/tns2:Apparati[$index]/tns2:CodiceApparato)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Apparati/tns2:Apparati[$index]/tns2:CodiceApparato&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/VALOREATTRIBUTO>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select dett.iddettaglioordineparent &#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA rich &#xa;JOIN APPUSER.BDS_1_CASEDATA_ORDINE ordine ON rich.IDRICHIESTAOLO = ordine.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE dett ON ordine.IDRICHIESTAOLO = dett.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN attrd ON dett.IDRICHIESTAOLO = attrd.IDRICHIESTAOLO&#xa;WHERE rich.IDRICHIESTAOLO = ? AND dett.NOMECOMPONENTE='APPARATO' AND attrd.NOMEATTRIBUTO='CODICEAPPARATO' AND attrd.VALOREATTRIBUTO=? AND dett.BDS_ID = attrd.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;ORDER BY dett.NOMECOMPONENTE, dett.BDS_ID, attrd.NOMEATTRIBUTO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VALOREATTRIBUTO"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="IDDETTAGLIOORDINEPARENT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogIdParent-input"
                                    name="LogIdParent"
                                    tibex:xpdlId="640b2dc9-8cb9-42a8-8e1a-6f9e829152b1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IdDettParentApparatoToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogIdParentToJDBCQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Apparati&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;IdDettParentApparato&quot;/>&lt;xsl:template name=&quot;LogIdParent-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'CheckAggiuntiviApparati'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/sm:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output query IdDettParentApparato per Apparato ',$Apparati/tns2:Apparati[$index]/tns2:CodiceApparato,' ',tib:render-xml($IdDettParentApparato))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
