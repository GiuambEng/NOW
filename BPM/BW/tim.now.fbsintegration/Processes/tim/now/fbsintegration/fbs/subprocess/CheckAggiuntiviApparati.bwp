                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CodiceServAggiuntivo-input"
                                    name="CodiceServAggiuntivo"
                                    outputVariable="CodiceServAggiuntivo"
                                    tibex:xpdlId="20017c72-0401-4997-8434-0b20cca783e4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogIdParentToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CodiceServAggiuntivoToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+20017c72-0401-4997-8434-0b20cca783e4+input&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdDettParentApparato&quot;/>&lt;xsl:template name=&quot;CodiceServAggiuntivo-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$Start/sm:IdRichiesta&quot;/>&lt;/IDRICHIESTAOLO>&lt;iddettaglioordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdDettParentApparato/Record[1]/IDDETTAGLIOORDINEPARENT)&quot;>&lt;xsl:value-of select=&quot;$IdDettParentApparato/Record[1]/IDDETTAGLIOORDINEPARENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/iddettaglioordine>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  dett.NOMECOMPONENTE, attrd.NOMEATTRIBUTO, attrd.VALOREATTRIBUTO&#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA rich &#xa;JOIN APPUSER.BDS_1_CASEDATA_ORDINE ordine ON rich.IDRICHIESTAOLO = ordine.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE dett ON ordine.IDRICHIESTAOLO = dett.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN attrd ON dett.IDRICHIESTAOLO = attrd.IDRICHIESTAOLO&#xa;WHERE rich.IDRICHIESTAOLO = ? AND dett.NOMECOMPONENTE='SERVIZIOAGGIUNTIVO' AND attrd.NOMEATTRIBUTO='NOMESERVIZIO' AND dett.iddettaglioordine=? AND dett.BDS_ID = attrd.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;ORDER BY dett.NOMECOMPONENTE, dett.BDS_ID, attrd.NOMEATTRIBUTO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="iddettaglioordine"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
