                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Apparati&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Apparati&quot; match=&quot;/&quot;>&lt;tns2:Apparati>&lt;xsl:copy-of select=&quot;$Apparati/tns2:Apparati&quot;/>&lt;xsl:for-each select=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:APPARATO/sm:item&quot;>&lt;tns2:Apparati>&lt;tns2:CodiceApparato>&lt;xsl:value-of select=&quot;sm:TIPOLOGIA_APPARATO&quot;/>&lt;/tns2:CodiceApparato>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;sm:ESITO_CONSEGNA_APPARATO&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;xsl:if test=&quot;sm:ID_APPARATO_CONSEGNATO&quot;>&lt;tns2:IdApparatoConsegnato>&lt;xsl:value-of select=&quot;sm:ID_APPARATO_CONSEGNATO&quot;/>&lt;/tns2:IdApparatoConsegnato>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:CODICE_MOTIVAZIONE_CONSEGNA&quot;>&lt;tns2:CodiceMotivazioneConsegna>&lt;xsl:value-of select=&quot;sm:CODICE_MOTIVAZIONE_CONSEGNA&quot;/>&lt;/tns2:CodiceMotivazioneConsegna>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:MOTIVAZIONE_CONSEGNA&quot;>&lt;tns2:MotivazioneConsegna>&lt;xsl:value-of select=&quot;sm:MOTIVAZIONE_CONSEGNA&quot;/>&lt;/tns2:MotivazioneConsegna>&lt;/xsl:if>&lt;/tns2:Apparati>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:APPARATO&quot;>&lt;tns2:Apparati>&lt;tns2:CodiceApparato>&lt;xsl:value-of select=&quot;sm:TIPOLOGIA_APPARATO&quot;/>&lt;/tns2:CodiceApparato>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;sm:ESITO_CONSEGNA_APPARATO&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;xsl:if test=&quot;sm:ID_APPARATO_CONSEGNATO&quot;>&lt;tns2:IdApparatoConsegnato>&lt;xsl:value-of select=&quot;sm:ID_APPARATO_CONSEGNATO&quot;/>&lt;/tns2:IdApparatoConsegnato>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:CODICE_MOTIVAZIONE_CONSEGNA&quot;>&lt;tns2:CodiceMotivazioneConsegna>&lt;xsl:value-of select=&quot;sm:CODICE_MOTIVAZIONE_CONSEGNA&quot;/>&lt;/tns2:CodiceMotivazioneConsegna>&lt;/xsl:if>&lt;xsl:if test=&quot;sm:MOTIVAZIONE_CONSEGNA&quot;>&lt;tns2:MotivazioneConsegna>&lt;xsl:value-of select=&quot;sm:MOTIVAZIONE_CONSEGNA&quot;/>&lt;/tns2:MotivazioneConsegna>&lt;/xsl:if>&lt;/tns2:Apparati>&lt;/xsl:for-each>&lt;/tns2:Apparati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
