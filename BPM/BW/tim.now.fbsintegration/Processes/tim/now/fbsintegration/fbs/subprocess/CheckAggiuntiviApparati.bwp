                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;ApparatiCodServ&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns2:OutputCheckAggiuntiviApparati>&lt;xsl:for-each select=&quot;$Aggiuntivi/tns2:Aggiuntivi&quot;>&lt;tns2:Aggiuntivi>&lt;xsl:variable name=&quot;NomeServizioAgg&quot; select=&quot;tns2:NomeServizio&quot;/>&lt;xsl:if test=&quot;$NomeServizioAgg&quot;>&lt;tns2:NomeServizio>&lt;xsl:value-of select=&quot;$NomeServizioAgg&quot;/>&lt;/tns2:NomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:EsitoServizio&quot;>&lt;tns2:EsitoServizio>&lt;xsl:value-of select=&quot;tns2:EsitoServizio&quot;/>&lt;/tns2:EsitoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CodiceMotivazioneServizio&quot;>&lt;tns2:CodiceMotivazioneServizio>&lt;xsl:value-of select=&quot;tns2:CodiceMotivazioneServizio&quot;/>&lt;/tns2:CodiceMotivazioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MotivazioneServizio&quot;>&lt;tns2:MotivazioneServizio>&lt;xsl:value-of select=&quot;tns2:MotivazioneServizio&quot;/>&lt;/tns2:MotivazioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:EstensioneImpianto&quot;>&lt;tns2:EstensioneImpianto>&lt;xsl:value-of select=&quot;tns2:EstensioneImpianto&quot;/>&lt;/tns2:EstensioneImpianto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MetriTot&quot;>&lt;tns2:MetriTot>&lt;xsl:value-of select=&quot;tns2:MetriTot&quot;/>&lt;/tns2:MetriTot>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$ApparatiCodServ/tns2:Apparati[tns2:NomeServizio=$NomeServizioAgg]&quot;>&lt;tns2:Apparati>&lt;xsl:if test=&quot;tns2:CodiceApparato&quot;>&lt;tns2:CodiceApparato>&lt;xsl:value-of select=&quot;tns2:CodiceApparato&quot;/>&lt;/tns2:CodiceApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:EsitoConsegnaApparato&quot;>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;tns2:EsitoConsegnaApparato&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:IdApparatoConsegnato&quot;>&lt;tns2:IdApparatoConsegnato>&lt;xsl:value-of select=&quot;tns2:IdApparatoConsegnato&quot;/>&lt;/tns2:IdApparatoConsegnato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:CodiceMotivazioneConsegna&quot;>&lt;tns2:CodiceMotivazioneConsegna>&lt;xsl:value-of select=&quot;tns2:CodiceMotivazioneConsegna&quot;/>&lt;/tns2:CodiceMotivazioneConsegna>&lt;/xsl:if>&lt;xsl:if test=&quot;tns2:MotivazioneConsegna&quot;>&lt;tns2:MotivazioneConsegna>&lt;xsl:value-of select=&quot;tns2:MotivazioneConsegna&quot;/>&lt;/tns2:MotivazioneConsegna>&lt;/xsl:if>&lt;/tns2:Apparati>&lt;/xsl:for-each>&lt;/tns2:Aggiuntivi>&lt;/xsl:for-each>&lt;/tns2:OutputCheckAggiuntiviApparati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="0341813e-387c-45de-b085-1f88c698a340"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Application>&lt;xsl:value-of select=&quot;'tim.now.fbsintegration.application'&quot;/>&lt;/tns6:Application>&lt;tns6:Process>&lt;xsl:value-of select=&quot;'CheckAggiuntiviApparati'&quot;/>&lt;/tns6:Process>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$Start/sm:IdRichiesta&quot;/>&lt;/tns6:BusinessID>&lt;tns6:Message>&lt;xsl:value-of select=&quot;concat('Output CheckAggiuntiviApparati: ',tib:render-xml($Response))&quot;/>&lt;/tns6:Message>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
