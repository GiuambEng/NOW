            <bpws:scope name="ForEach1" tibex:group="foreach"
                tibex:indexToGlobal="false" tibex:xpdlId="b6bb32af-d6a1-4448-a443-ed29bfdfa343">
                <bpws:targets>
                    <bpws:target linkName="LogAggiuntiviToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ForEach1ToGenericLogger"/>
                </bpws:sources>
                <bpws:forEach counterName="index" name="forEach1"
                    parallel="no" tibex:group="foreach">
                    <tibex:DesignExpression name="final">
                        <tibex:expression
                            expression="count($Apparati/ns1:Apparati)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Apparati/ns1:Apparati)]]></bpws:finalCounterValue>
                    <bpws:scope name="innerScope1">
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="IdDettParentApparatoToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogIdParentToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CodiceServAggiuntivoToGenericLogger" tibex:linkType="SUCCESS"/>
