                                    <tibex:expression
                                    expression="$CheckAggiuntivo/Record[1]/NOMECOMPONENTE='SERVIZIOAGGIUNTIVO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$CheckAggiuntivo/Record[1]/NOMECOMPONENTE='SERVIZIOAGGIUNTIVO']]></bpws:transitionCondition>
