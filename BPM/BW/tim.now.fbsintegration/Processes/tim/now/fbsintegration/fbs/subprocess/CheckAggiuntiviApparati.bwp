                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UtilFBS/&quot; xmlns:sm=&quot;http://www.tim.com/NOW/xsd/StateMachineOF/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Apparati&quot;/>&lt;xsl:param name=&quot;CheckAggiuntivo&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Apparati&quot; match=&quot;/&quot;>&lt;tns2:Apparati>&lt;xsl:copy-of select=&quot;$Apparati/tns2:Apparati&quot;/>&lt;tns2:Apparati>&lt;xsl:variable name=&quot;CodiceApparato&quot; select=&quot;$CheckAggiuntivo/Record[1]/VALOREATTRIBUTO&quot;/>&lt;xsl:if test=&quot;$CodiceApparato&quot;>&lt;tns2:CodiceApparato>&lt;xsl:value-of select=&quot;$CodiceApparato&quot;/>&lt;/tns2:CodiceApparato>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;xsl:if test=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:SERVIZIO_AGGIUNTIVO/sm:item[sm:NOME_SERVIZIO=$CodiceApparato]/sm:ESITO_SERVIZIO&quot;>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;$Start/sm:OF_CompletionOrder_OpenStream_Request/sm:SERVIZIO_AGGIUNTIVO/sm:item[sm:NOME_SERVIZIO=$CodiceApparato]/sm:ESITO_SERVIZIO&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:SERVIZIO_AGGIUNTIVO[sm:NOME_SERVIZIO=$CodiceApparato]/sm:ESITO_SERVIZIO&quot;>&lt;tns2:EsitoConsegnaApparato>&lt;xsl:value-of select=&quot;$Start/sm:WHS_CompletionOrderMig_Request/sm:SERVIZI_OPZIONALI/sm:SERVIZIO_AGGIUNTIVO[sm:NOME_SERVIZIO=$CodiceApparato]/sm:ESITO_SERVIZIO&quot;/>&lt;/tns2:EsitoConsegnaApparato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/sm:OF_CompletionOrder_OpenStream_Request)&quot;>&lt;xsl:if test=&quo