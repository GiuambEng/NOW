<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/NotificationManagerWSDP" xmlns:tns="http://www.example.org/NotificationManagerWSDP" elementFormDefault="qualified">

    <element name="NotificaOLOInput">
    	<complexType>
    		<sequence>
    			<element name="TransactionID" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TipologiaNotifica" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CodiceOlo" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CodiceOloAgcom" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IDRichiestaOLO" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FlagGiornaliero" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FlagOrario" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="StrutturaRichiesta" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    						<enumeration value="REGOLATORIO"></enumeration>
    						<enumeration value="NGA"></enumeration>
    						<enumeration value="XSDL"></enumeration>
    						<enumeration value="FWA"></enumeration>
    						<enumeration value="FIBERSTREAM"></enumeration>
    						<enumeration value="NPNG"></enumeration>
    						<enumeration value="NPG"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="TracciatoFile" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="IdTipologiaOloDestinatario" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="integer">
    						<enumeration value="1"></enumeration>
    						<enumeration value="2"></enumeration>
    						<enumeration value="3"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="IdLavorazione" type="integer" maxOccurs="1" minOccurs="1"></element>
    			<element name="FlagGpon" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NotificaOLOOutput">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="integer" maxOccurs="1" minOccurs="1"></element>
    			<element name="CodiceErrore" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DescrizioneErrore" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="255"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>