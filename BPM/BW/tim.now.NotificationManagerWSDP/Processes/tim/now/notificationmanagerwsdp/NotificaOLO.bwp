                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fbe60e18-aa3a-40d5-ade5-06e352198f06+input&quot; xmlns:tns1=&quot;http://www.example.org/NotificationManagerWSDP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;IdNotifica&quot;/>&lt;xsl:template name=&quot;InsNotf-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcUpdateActivityInput>&lt;COD_TIPOLG_NOTF>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:TipologiaNotifica&quot;/>&lt;/COD_TIPOLG_NOTF>&lt;ID_NOTF>&lt;xsl:value-of select=&quot;xsd:int($IdNotifica/Record[1]/NEXTVAL)&quot;/>&lt;/ID_NOTF>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;IDRICH_COM_STRC>&lt;xsl:value-of select=&quot;999&quot;/>&lt;/IDRICH_COM_STRC>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns1:NotificaOLOInput/tns1:FlagGiornaliero)=('Y','S')&quot;>&lt;STATO_NOTF_GIORNALIERO>&lt;xsl:value-of select=&quot;'DA INVIARE'&quot;/>&lt;/STATO_NOTF_GIORNALIERO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_NOTF_GIORNALIERO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns1:NotificaOLOInput/tns1:FlagOrario)=('Y','S')&quot;>&lt;STATO_NOTF_ORARIO>&lt;xsl:value-of select=&quot;'DA INVIARE'&quot;/>&lt;/STATO_NOTF_ORARIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO_NOTF_ORARIO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ORIGINE_NOTF>&lt;xsl:value-of select=&quot;'WSDPLUS'&quot;/>&lt;/ORIGINE_NOTF>&lt;STRUTTURA_RICH>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:StrutturaRichiesta&quot;/>&lt;/STRUTTURA_RICH>&lt;TIMSTP_CREAZIONE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_CREAZIONE>&lt;TRACCIATO_FILE>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:TracciatoFile&quot;/>&lt;/TRACCIATO_FILE>&lt;CODFC_OLO_NOW>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:CodiceOlo&quot;/>&lt;/CODFC_OLO_NOW>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:CodiceOloAgcom&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;OPERATORE>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/OPERATORE>&lt;IDTPLG_DESTNRIO_NOTF>&lt;xsl:value-of select=&quot;xsd:int($post/item/tns1:NotificaOLOInput/tns1:IdTipologiaOloDestinatario)&quot;/>&lt;/IDTPLG_DESTNRIO_NOTF>&lt;IDTPLG_LAVRZ>&lt;xsl:value-of select=&quot;xsd:int($post/item/tns1:NotificaOLOInput/tns1:IdLavorazione)&quot;/>&lt;/IDTPLG_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns1:NotificaOLOInput/tns1:StrutturaRichiesta='NPG'&quot;>&lt;FLAG_NP103>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/FLAG_NP103>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_NP103 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns1:NotificaOLOInput/tns1:FlagGpon)=('Y','S')&quot;>&lt;NEW_GPON>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/NEW_GPON>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NEW_GPON xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsNotf-input"
                                    name="InsNotf"
                                    outputVariable="InsNotf"
                                    tibex:xpdlId="fbe60e18-aa3a-40d5-ade5-06e352198f06" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToInsNotf"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsNotfToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fbe60e18-aa3a-40d5-ade5-06e352198f06+input&quot; xmlns:tns1=&quot;http://www.example.org/NotificationManagerWSDP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;IdNotifica&quot;/>&#xa;    &lt;xsl:template name=&quot;InsNotf-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;COD_TIPOLG_NOTF>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/COD_TIPOLG_NOTF>&#xa;            &lt;ID_NOTF>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($IdNotifica/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_NOTF>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;IDRICH_COM_STRC>&#xa;                &lt;xsl:value-of select=&quot;999&quot;/>&#xa;            &lt;/IDRICH_COM_STRC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns1:FlagGiornaliero)=('Y','S')&quot;>&#xa;                    &lt;STATO_NOTF_GIORNALIERO>&#xa;                        &lt;xsl:value-of select=&quot;'DA INVIARE'&quot;/>&#xa;                    &lt;/STATO_NOTF_GIORNALIERO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_NOTF_GIORNALIERO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns1:FlagOrario)=('Y','S')&quot;>&#xa;                    &lt;STATO_NOTF_ORARIO>&#xa;                        &lt;xsl:value-of select=&quot;'DA INVIARE'&quot;/>&#xa;                    &lt;/STATO_NOTF_ORARIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_NOTF_ORARIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ORIGINE_NOTF>&#xa;                &lt;xsl:value-of select=&quot;'WSDPLUS'&quot;/>&#xa;            &lt;/ORIGINE_NOTF>&#xa;            &lt;STRUTTURA_RICH>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/STRUTTURA_RICH>&#xa;            &lt;TIMSTP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CREAZIONE>&#xa;            &lt;TRACCIATO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:TracciatoFile&quot;/>&#xa;            &lt;/TRACCIATO_FILE>&#xa;            &lt;CODFC_OLO_NOW>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:CodiceOlo&quot;/>&#xa;            &lt;/CODFC_OLO_NOW>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:CodiceOloAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/OPERATORE>&#xa;            &lt;IDTPLG_DESTNRIO_NOTF>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($post.item/tns1:IdTipologiaOloDestinatario)&quot;/>&#xa;            &lt;/IDTPLG_DESTNRIO_NOTF>&#xa;            &lt;IDTPLG_LAVRZ>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($post.item/tns1:IdLavorazione)&quot;/>&#xa;            &lt;/IDTPLG_LAVRZ>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns1:StrutturaRichiesta='NPG'&quot;>&#xa;                    &lt;FLAG_NP103>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/FLAG_NP103>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_NP103 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns1:FlagGpon)=('Y','S')&quot;>&#xa;                    &lt;NEW_GPON>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/NEW_GPON>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NEW_GPON xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF (COD_TIPOLG_NOTF, ID_NOTF,&#xa;&#x9;&#x9;&#x9;ID_RICH_OLO, IDRICH_COM_STRC, IDTPLG_STNTF_FLGIORN,IDTPLG_STNTF_FILE_ORARIO, ORIGINE_NOTF,&#xa;&#x9;&#x9;&#x9;STRUTTURA_RICH, TIMSTP_CREAZIONE, TRACCIATO_FILE,&#xa;&#x9;&#x9;&#x9;CODFC_OLO_NOW, CODFC_OLO_AGCOM, OPERATORE, IDTPLG_DESTNRIO_NOTF, IDLAVORAZIONE, FLAG_NP103, NEW_GPON)&#xa;VALUES(?, ?, ?, ?,(SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), ?, ?, ?, ?, ?, ?, ?, ?, (SELECT TIPOLG_LAVRZ FROM TIPOLG_LAVRZ WHERE IDTPLG_LAVRZ = ?), ?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_TIPOLG_NOTF"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_NOTF"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDRICH_COM_STRC"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_NOTF_GIORNALIERO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_NOTF_ORARIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ORIGINE_NOTF"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_RICH"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_CREAZIONE"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="TRACCIATO_FILE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_NOW"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDTPLG_DESTNRIO_NOTF"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDTPLG_LAVRZ"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_NP103"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NEW_GPON"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/NotificationManagerWSDP&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;'tim.now.NotificationManagerWSDP.application'&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;'NotificaOLO'&quot;/>&lt;/tns4:Process>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:IDRichiestaOLO&quot;/>&lt;/tns4:BusinessID>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat('Ricevuta notifica da WSDP ', tib:render-xml($post/item/tns1:NotificaOLOInput))&quot;/>&lt;/tns4:Message>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogInput-input"
                                    name="LogInput"
                                    tibex:xpdlId="4681cbad-daeb-48c2-b258-8077108ced7c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogInputToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/NotificationManagerWSDP&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.NotificationManagerWSDP.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaOLO'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Ricevuta notifica da WSDP ', tib:render-xml($post.item))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cd76a5ea-a17e-4484-8ed4-1549d73005b8+input&quot; xmlns:tns1=&quot;http://www.example.org/NotificationManagerWSDP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;InsStag-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcUpdateActivityInput>&lt;CODICEOLO>&lt;xsl:value-of select=&quot;xsd:int($post/item/tns1:NotificaOLOInput/tns1:CodiceOlo)&quot;/>&lt;/CODICEOLO>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:CodiceOloAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;COD_LAVRZ>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:IdLavorazione&quot;/>&lt;/COD_LAVRZ>&lt;FLAG_GIORNALIERO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:NotificaOLOInput/tns1:FlagGiornaliero)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:FlagGiornaliero&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLAG_GIORNALIERO>&lt;FLAG_GPON>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:NotificaOLOInput/tns1:FlagGpon)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:FlagGpon&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLAG_GPON>&lt;FLAG_ORARIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:NotificaOLOInput/tns1:FlagOrario)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:NotificaOLOInput/tns1:FlagOrario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attr