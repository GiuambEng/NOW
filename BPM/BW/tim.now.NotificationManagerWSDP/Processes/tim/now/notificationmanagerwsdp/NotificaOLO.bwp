                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ANALITICO_NOTF_WSDPLUS (CODICEOLO, CODIFICAOLOAGCOM, COD_LAVRZ, FLAG_GIORNALIERO, FLAG_GPON, FLAG_ORARIO, ID_RICH_OLO, ID_TIP_OLO_DESTINATARIO, SISTEMA_CHIAMANTE, STATO_ELABORAZIONE, STRUTTURA_RICHIESTA, TIMSTP_RICH, TIPOLOGIANOTIFICA, TRACCIATO_FILE, TRANSACTIONID) VALUES (?,?,?,?,?,?,?,?,?,?,?,SYSDATE,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

