                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_OLO,CANALE_RICHIESTA,DN,TIMESTAMP_CREAZIONE,CODICE_ORDINE_OLO,ID_RICHIESTA,DN_ALTERNATIVO &#xd;&#xa;FROM ACQUISIZIONE_RICHIESTE &#xd;&#xa;WHERE TIMESTAMP_CREAZIONE &lt; TRUNC(SYSDATE)&#xd;&#xa;AND STATO='DA_ELABORARE_CPS'" xsi:type="jdbcPalette:JDBCQueryActivity">
