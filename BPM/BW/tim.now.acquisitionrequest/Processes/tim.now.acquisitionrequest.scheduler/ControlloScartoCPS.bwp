                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(ID_RICHIESTA) AS COUNTIDRICHIESTA FROM ACQUISIZIONE_RICHIESTE WHERE CODICE_OLO=? AND CODICE_ORDINE_OLO!=?&#xa;AND ID_RICHIESTA NOT IN (SELECT ID_RICHIESTA FROM ACQUISIZIONE_RICHIESTE WHERE ID_RICHIESTA=?)AND TRUNC(TIMESTAMP_CREAZIONE)=?&#xa;AND DN=? AND STATO='DA_ELABORARE_CPS'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
