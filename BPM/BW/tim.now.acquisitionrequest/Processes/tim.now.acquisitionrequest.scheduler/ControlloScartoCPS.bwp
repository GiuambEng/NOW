                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89527ee6-559b-4c6b-ac54-c38274aef9f4+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Controlli/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:Controlli[1]/tns1:Controlli/tns1:Cod_Olo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:Controlli[1]/tns1:Controlli/tns1:Cod_Olo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_OLO>&lt;CODICE_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:Controlli[1]/tns1:Controlli/tns1:CodiceOrdineOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:Controlli[1]/tns1:Controlli/tns1:CodiceOrdineOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OLO>&lt;ID_RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:Controlli[1]/tns1:Controlli/tns1:IDRichiesta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:Controlli[1]/tns1:Controlli/tns1:IDRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICHIESTA>&lt;TIMESTAMP_CREAZIONE>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:Controlli[1]/tns1:Controlli/tns1:Data)&quot;/>&lt;/TIMESTAMP_CREAZIONE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(ID_RICHIESTA) AS COUNTIDRICHIESTA FROM ACQUISIZIONE_RICHIESTE WHERE CODICE_OLO=? AND CODICE_ORDINE_OLO=?&#xa;AND ID_RICHIESTA NOT IN (SELECT ID_RICHIESTA FROM ACQUISIZIONE_RICHIESTE WHERE ID_RICHIESTA=?)AND TRUNC(TIMESTAMP_CREAZIONE)=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHIESTA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="TIMESTAMP_CREAZIONE"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COUNTIDRICHIESTA"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
