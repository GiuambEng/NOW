                                    DataTypeDisplayValue="DATE" ParameterName="TIMESTAMP_CREAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COUNTIDRICHIESTA"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
