                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Richieste-input"
                    name="Richieste" outputVariable="Richieste"
                    tibex:xpdlId="c9c83f06-500e-4a9f-a9ff-926d60aac47c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToRichieste"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c9c83f06-500e-4a9f-a9ff-926d60aac47c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Richieste-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ROWNUM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/MESSAGGIACQUISIZIONERIC_FWA)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/MESSAGGIACQUISIZIONERIC_FWA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ROWNUM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT XML_CASEDATA_RICHIESTA,ID_RICHIESTA,PARAMETRO&#xd;&#xa;  FROM ACQUISIZIONE_RICHIESTE &#xd;&#xa;  WHERE AMBITO='NOW' AND STATO='INSERITO' &#xd;&#xa;  AND STRUTTURARICHIESTA='FWA' &#xd;&#xa;  AND CANALE_RICHIESTA='GUI'&#xd;&#xa;  ORDER BY ID_RICHIESTA fetch first ? rows only" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ROWNUM"/>
                                    <columnMetadata
                                    columnName="XML_CASEDATA_RICHIESTA"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="ID_RICHIESTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PARAMETRO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e539f756-2abc-4507-b81b-cbcdbf1278bd">
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdateToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLog2"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Richieste/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Richieste/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToSendRequestGUI" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SendRequestGUIToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SendRequestGUIToLog" tibex:linkType="ERROR"/>
                                <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="73fcb981-ec4a-4907-b8db-a6560c626fdd">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToSendRequestGUI"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="9523f8a2-743b-425f-994c-bd923bd5a863">
                                <bpws:targets>
                                    <bpws:target linkName="SendRequestGUIToGroupEnd"/>
                                    <bpws:target linkName="LogToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
