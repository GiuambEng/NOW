                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RI.DATA_INVIO_RICH_SDR,RI.COD_ORDINE_SDR, RI.LAV_SDR,RI.SOTTO_LAV_SDR,RI.DN,RI.DN_OLD,RI.DISTR_DEL_DN,&#xd;&#xa;RI.DATA_CESS_SDR,RI.DATA_ESPL_SDR,RI.CLLI,RI.CLLI_OLD,RI.TIPO_LINEA,RI.RADICALE,RI.QUANTITA_AGGIUNTIVI,RI.STATO_RICH_SDR,&#xd;&#xa;RI.ID_ESEC_PROCSO_NO_FILE,RI.TIMESTAMP_INS,RI.TIMESTAMP_AGG,RI.ID_RICH_SDR_CPS,RI.DESCR_ERRORE&#xd;&#xa;FROM RICH_SDR_CPS RI&#xd;&#xa;WHERE &#xd;&#xa;RI.STATO_RICH_SDR='DA_ELABORARE'" xsi:type="jdbcPalette:JDBCQueryActivity">
