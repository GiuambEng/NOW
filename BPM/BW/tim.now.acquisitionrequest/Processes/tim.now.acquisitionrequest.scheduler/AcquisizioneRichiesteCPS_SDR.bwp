                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5112b5e6-a02e-41e9-bbe5-55f8c1251e17+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RichiesteCPS_SDR&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('Errore Validazione:', $_error/StackTrace,$_error/ProcessStack,$_error/MsgCode,$_error/Msg,$_error/FullClass,$_error/Class)&quot;/>&lt;/DESCR_ERRORE>&lt;ID_RICH_SDR_CPS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RichiesteCPS_SDR/Record[$index]/ID_RICH_SDR_CPS)&quot;>&lt;xsl:value-of select=&quot;$RichiesteCPS_SDR/Record[$index]/ID_RICH_SDR_CPS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_SDR_CPS>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RichiesteCPS_SDR/Record[$index]/ID_ESEC_PROCSO_NO_FILE)&quot;>&lt;xsl:value-of select=&quot;$RichiesteCPS_SDR/Record[$index]/ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RICH_SDR_CPS&#xa;  SET STATO_RICH_SDR='ERRORE',DESCR_ERRORE=?,TIMESTAMP_AGG=SYSDATE&#xa;  WHERE STATO_RICH_SDR='IN_ELABORAZIONE' AND ID_RICH_SDR_CPS=?&#xa;  AND ID_ESEC_PROCSO_NO_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICH_SDR_CPS"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
