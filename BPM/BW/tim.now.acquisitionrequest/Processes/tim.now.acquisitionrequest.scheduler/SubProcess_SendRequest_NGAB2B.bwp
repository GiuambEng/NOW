                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9158b1e3-eb72-47a0-b4c1-1168f1628f48+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectMessaggi&quot;/>&lt;xsl:template name=&quot;SelectContenutoXML-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;STRUTTURARICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StrutturaRichiesta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StrutturaRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STRUTTURARICHIESTA>&lt;OLOPREVALENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:OloPrevalente)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:OloPrevalente&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OLOPREVALENTE>&lt;ROWNUM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectMessaggi/Record[1]/MESSAGGIACQUISIZIONERIC_NGA)&quot;>&lt;xsl:value-of select=&quot;$SelectMessaggi/Record[1]/MESSAGGIACQUISIZIONERIC_NGA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ROWNUM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT XML_CASEDATA_RICHIESTA,ID_RICHIESTA,ID_FILE,NUMERO_RETRY,PARAMETRO&#xa;  FROM ACQUISIZIONE_RICHIESTE &#xa;  WHERE STATO='INSERITO' &#xa;  AND STRUTTURARICHIESTA=? &#xa;  AND PARAMETRO='NGAB2B'&#xa;  AND CODICE_OLO=? AND ID_FILE IS NOT NULL&#xa;  ORDER BY ID_FILE,ID_RICHIESTA fetch first ? rows only" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURARICHIESTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OLOPREVALENTE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ROWNUM"/>
                                    <columnMetadata
                                    columnName="XML_CASEDATA_RICHIESTA"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="ID_RICHIESTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUMERO_RETRY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PARAMETRO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogSelectContenutoXML-input"
                    name="LogSelectContenutoXML"
