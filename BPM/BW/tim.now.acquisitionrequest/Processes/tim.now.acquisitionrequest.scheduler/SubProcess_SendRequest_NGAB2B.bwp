                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE ACQUISIZIONE_RICHIESTE&#xa;  SET STATO='INSERITO' WHERE STATO ='INELABORAZIONE' and ID_RICHIESTA=? " xsi:type="jdbcPalette:JDBCUpdateActivity">

