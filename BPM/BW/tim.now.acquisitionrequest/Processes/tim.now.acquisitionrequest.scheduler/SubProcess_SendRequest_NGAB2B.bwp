                                    <bpws:target linkName="JDBCUpdate5ToGroupEnd2"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:scope name="RepeatOnError"
                                tibex:group="repeatOnError" tibex:xpdlId="d845d07b-91ce-42d0-b4d8-86abefc43aed">
                                <bpws:targets>
                                    <bpws:target linkName="Scope1ToRepeatOnError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RepeatOnErrorToEmpty"/>
                                    <bpws:source
                                    linkName="RepeatOnErrorToLog2"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName">
                                    <bpws:if name="if">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1 > $MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1 > $MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
                                    <bpws:flow name="flow1">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToScope" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="ScopeToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log1ToSleep" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="SleepToScope" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCUpdateToLogTentativi" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="8df3848c-4387-4728-8da6-a877583a783c">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToScope">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToJDBCUpdate">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1 > 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index1 > 1]]></bpws:transitionCondition>
