                                <bpws:link name="Scope1ToRepeatOnError" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="RepeatOnErrorToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Scope1ToJDBCUpdate5" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Log2ToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RepeatOnErrorToLog2" tibex:linkType="ERROR"/>
                                <bpws:link name="Log2ToJDBCUpdate3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdate3ToLogLavorazioneManuale" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate4ToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToJDBCUpdate4" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="LavorazioneManualeToLog3_KO"
                                    tibex:label="KO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Log3ToJDBCUpdate5" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate5ToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToScope1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ControlloRToLogControlloRichiesta" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="e42261e2-e9f7-4526-afe7-bdad4629a498">
