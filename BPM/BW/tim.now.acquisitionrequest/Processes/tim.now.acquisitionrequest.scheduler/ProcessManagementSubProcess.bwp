            </xs:complexType>
            <xs:element name="SleepInputSchema" type="tns:SleepInputSchema"/>
        </xs:schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4147fd87-7ae3-4907-812f-47f00de13f4f+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4147fd87-7ae3-4907-812f-47f00de13f4f+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="CODICE_OLO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="AMBITO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="STATO" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="NUMERO_RETRY" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="XML_CASEDATA_RICHIESTA"
                            nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="TIMESTAMP_CREAZIONE" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="1"
