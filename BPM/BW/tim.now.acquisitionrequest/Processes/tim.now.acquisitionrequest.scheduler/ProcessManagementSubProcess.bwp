    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog2" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatOnErrorToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToRepeatOnError" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="44c99971-137c-41f3-99d9-7ba6c581f205"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog2"/>
                    </bpws:sources>
                    <tibex:eventSource>
