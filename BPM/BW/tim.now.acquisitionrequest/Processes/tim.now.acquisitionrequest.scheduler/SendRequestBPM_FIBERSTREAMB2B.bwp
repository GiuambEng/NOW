                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;STRUTTURARICHIESTA&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQuery_OLO_DISPONIBILE&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;SubProcess_SendRequest_FIBERSTREAMB2B-input&quot; match=&quot;/&quot;>&lt;tns1:Element>&lt;tns1:moduleName>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:moduleName>&lt;tns1:parameterName>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:parameterName>&lt;tns1:operationName>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:operationName>&lt;tns1:processName>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:processName>&lt;tns1:value>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:value>&lt;tns1:ID_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ID_FILE>&lt;tns1:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$STRUTTURARICHIESTA&quot;/>&lt;/tns1:StrutturaRichiesta>&lt;xsl:if test=&quot;$JDBCQuery_OLO_DISPONIBILE/Record[$index]/CODICE_OLO&quot;>&lt;tns1:OloPrevalente>&lt;xsl:value-of select=&quot;$JDBCQuery_OLO_DISPONIBILE/Record[$index]/CODICE_OLO&quot;/>&lt;/tns1:OloPrevalente>&lt;/xsl:if>&lt;tns1:Transaction_ID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns1:Transaction_ID>&lt;/tns1:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.acquisitionrequest.scheduler.SubProcess_SendRequest_FIBERSTREAMB2B" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
