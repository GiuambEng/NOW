                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE ACQUISIZIONE_RICHIESTE&#xa;  SET STATO='INSERITO',TIMESTAMP_AGGIORNAMENTO=SYSDATE&#xa;  WHERE ID_RICHIESTA=? &#xa;  AND STATO='ATTESA_CONTROLLI' AND STRUTTURARICHIESTA='CPS'&#xa;  AND CANALE_RICHIESTA = 'FILE'" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICHIESTA"/>
                                    </value>
