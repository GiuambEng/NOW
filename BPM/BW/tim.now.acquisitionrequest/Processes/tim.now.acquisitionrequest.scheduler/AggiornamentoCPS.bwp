            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1bc4316e-84a9-4581-8d0b-f650230e23f4+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Estrazione&quot;/>&lt;xsl:template name=&quot;AggiornamentoRichiesta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Estrazione/Record&quot;>&lt;Record>&lt;ID_RICHIESTA>&lt;xsl:value-of select=&quot;ID_RICHIESTA&quot;/>&lt;/ID_RICHIESTA>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
