<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Controlli/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Controlli/">

    <element name="Controlli">
    	<complexType>
    		<sequence>
    			<element name="Controlli" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Controlli"
    							maxOccurs="1" minOccurs="0">
    							<complexType>
    								<sequence>
    									<sequence>
    										<element name="Scarto"
    											type="string" maxOccurs="1" minOccurs="0">
    										</element>
    										<element name="IDRichiesta"
    											type="int" maxOccurs="1" minOccurs="0">
    										</element>
    									</sequence>
    									<element name="Cod_Olo"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="CodiceOrdineOLO"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element
    										name="TimstpInserimento" type="dateTime" maxOccurs="1"
    										minOccurs="0">
    									</element>
    									<element name="Data"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="DN" type="string"
    										maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="CanaleRichiesta"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="DNALTERNATIVO"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
	<element name="RichiesteFBS">
    	<complexType>
    		<sequence>
    			<element name="RichiesteFBS" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="RichiesteFBS"
    							maxOccurs="1" minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="XML_CASEDATA_RICHIESTA"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="ID_RICHIESTA"
    										type="int" maxOccurs="1" minOccurs="0">
    									</element>
    									<element
    										name="ID_FILE" type="int" maxOccurs="1"
    										minOccurs="0">
    									</element>
    									<element name="NUMERO_RETRY"
    										type="int" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="PARAMETRO" type="string"
    										maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>