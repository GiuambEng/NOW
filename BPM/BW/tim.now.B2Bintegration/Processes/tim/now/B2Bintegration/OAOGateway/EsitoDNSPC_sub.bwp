            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SendFBS/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EsitoDNSPC/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindCase&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogFind-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;'tim.now.B2Bintegration.application'&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'EsitoDNSPC'&quot;/>&lt;/tns2:Process>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&lt;/tns2:BusinessID>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output FindCase ', tib:render-xml($FindCase/findCaseByCriteriaResponse/ns:FindCaseByCriteriaResponse))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogFind-input" name="LogFind"
