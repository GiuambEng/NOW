                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns8="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:template name="ErrorStag-input" match="/"&gt;&lt;tns7:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns8:StagingRequest&gt;&lt;tns8:StagingIn&gt;&lt;tns8:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="216"/&gt;&lt;/tns8:ID_PROCSO_NO_FILE&gt;&lt;tns8:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="46"/&gt;&lt;/tns8:ID_STATO_ELAB_STAG&gt;&lt;tns8:CODE_ACK_NACK&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/tns8:CODE_ACK_NACK&gt;&lt;tns8:MOTIVAZIONE&gt;&lt;xsl:value-of select="'Errore generico nel processo EsitoDNSPC'"/&gt;&lt;/tns8:MOTIVAZIONE&gt;&lt;/tns8:StagingIn&gt;&lt;tns8:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_GATEWAY_OUT_NOFILE'"/&gt;&lt;/tns8:StagingType&gt;&lt;tns8:LoggerIn&gt;&lt;ns1:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns1:TipologiaProcesso&gt;&lt;ns1:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns1:TipologiaOperazione&gt;&lt;ns1:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="216"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;ns1:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns1:STATO_ESEC&gt;&lt;ns1:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TMSP_FINE_ELAB&gt;&lt;/ns1:EsecuzioneNOFileProcessato&gt;&lt;ns1:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;&lt;ns1:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;&lt;/ns1:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns1:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns8:StagingResponse/tns8:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns1:ID_ESEC_PROCSO&gt;&lt;ns1:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns1:LOG_LEVEL&gt;&lt;ns1:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns1:LOG_MESSAGE&gt;&lt;ns1:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TIMSTP_INSMTO&gt;&lt;/ns1:LogFileProcessato&gt;&lt;/tns8:LoggerIn&gt;&lt;/tns8:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns7:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:StagingRequest>&#xa;            &lt;tns8:StagingIn>&#xa;                &lt;tns8:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;216&quot;/>&#xa;                &lt;/tns8:ID_PROCSO_NO_FILE>&#xa;                &lt;tns8:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;46&quot;/>&#xa;                &lt;/tns8:ID_STATO_ELAB_STAG>&#xa;                &lt;tns8:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns8:CODE_ACK_NACK>&#xa;                &lt;tns8:MOTIVAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo EsitoDNSPC'&quot;/>&#xa;                &lt;/tns8:MOTIVAZIONE>&#xa;            &lt;/tns8:StagingIn>&#xa;            &lt;tns8:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_GATEWAY_OUT_NOFILE'&quot;/>&#xa;            &lt;/tns8:StagingType>&#xa;            &lt;tns8:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns8:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;216&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns8:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns8:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&