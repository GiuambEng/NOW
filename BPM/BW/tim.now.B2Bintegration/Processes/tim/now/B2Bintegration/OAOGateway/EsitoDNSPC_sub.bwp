&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://services.bds.tibco.com/BusinessDataServices_1.2.0" xmlns:ns="http://api.bds.tibco.com" xmlns:tns="http://www.tim.com/NOW/xsd/EsitoDNSPC/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="FindCase-input" match="/"&gt;&lt;tns3:findCaseByCriteriaRequest&gt;&lt;findCaseByCriteriaRequest&gt;&lt;ns:FindCaseByCriteriaRequest&gt;&lt;caseModelVersion&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/caseModelVersion&gt;&lt;caseType&gt;&lt;xsl:value-of select="'it.telecomitalia.it.NOW.casedata.Richiesta'"/&gt;&lt;/caseType&gt;&lt;criteria&gt;&lt;queryString&gt;&lt;xsl:value-of select="'IDRichiestaOLO=:ID'"/&gt;&lt;/queryString&gt;&lt;namedParameterAssignment&gt;&lt;name&gt;&lt;xsl:value-of select="'ID'"/&gt;&lt;/name&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns:IdRichiestaOlo"/&gt;&lt;/value&gt;&lt;/namedParameterAssignment&gt;&lt;/criteria&gt;&lt;/ns:FindCaseByCriteriaRequest&gt;&lt;/findCaseByCriteriaRequest&gt;&lt;/tns3:findCaseByCriteriaRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://services.bds.tibco.com/BusinessDataServices_1.2.0&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EsitoDNSPC/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;FindCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:FindCaseByCriteriaRequest>&#xa;            &lt;caseModelVersion>&#xa;                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;            &lt;/caseModelVersion>&#xa;            &lt;caseType>&#xa;                &lt;xsl:value-of select=&quot;'it.telecomitalia.it.NOW.casedata.Richiesta'&quot;/>&#xa;            &lt;/caseType>&#xa;            &lt;criteria>&#xa;                &lt;queryString>&#xa;                    &lt;xsl:value-of select=&quot;'IDRichiestaOLO=:ID'&quot;/>&#xa;                &lt;/queryString>&#xa;                &lt;namedParameterAssignment>&#xa;                    &lt;name>&#xa;                        &lt;xsl:value-of select=&quot;'ID'&quot;/>&#xa;                    &lt;/name>&#xa;                    &lt;value>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/value>&#xa;                &lt;/namedParameterAssignment>&#xa;            &lt;/criteria>&#xa;        &lt;/ns:FindCaseByCriteriaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
