            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Olo-input"
                    name="Olo" outputVariable="Olo"
                    tibex:xpdlId="adfce80f-b651-4ef0-945a-43c27a8d88c6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
