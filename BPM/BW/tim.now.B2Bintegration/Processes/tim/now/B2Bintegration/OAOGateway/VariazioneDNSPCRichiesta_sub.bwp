                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:template name="ErrorStag-input" match="/"&gt;&lt;tns3:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingIn&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="215"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="46"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:CODE_ACK_NACK&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/tns1:CODE_ACK_NACK&gt;&lt;tns1:MOTIVAZIONE&gt;&lt;xsl:value-of select="'Errore generico nel processo VariazioneDNSCPRichiesta'"/&gt;&lt;/tns1:MOTIVAZIONE&gt;&lt;/tns1:StagingIn&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_GATEWAY_IN_NOFILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="215"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns3:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsStag.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingIn>&#xa;                &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;215&quot;/>&#xa;                &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;46&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns1:CODE_ACK_NACK>&#xa;                &lt;tns1:MOTIVAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Errore generico nel processo VariazioneDNSCPRichiesta'&quot;/>&#xa;                &lt;/tns1:MOTIVAZIONE>&#xa;            &lt;/tns1:StagingIn>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_GATEWAY_IN_NOFILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;215&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsStag.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsStag.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LogFaultToInvoke"/>
