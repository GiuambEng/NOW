            <bpws:invoke inputVariable="UpdStag-input" name="UpdStag"
                operation="InsertUpdateStaging" outputVariable="UpdStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns2:InsertUpdateStagingPortType" tibex:xpdlId="846a62e6-2be7-4820-9b65-a557dcce6b2e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsStag"/&gt;&lt;xsl:param name="Response"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns3:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingIn&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($Response)"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;tns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="215"/&gt;&lt;/tns1:ID_PROCSO_NO_FILE&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:CODE_ACK_NACK&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns1:CODE_ACK_NACK&gt;&lt;/tns1:StagingIn&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_GATEWAY_IN_NOFILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsStag/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="215"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of selec