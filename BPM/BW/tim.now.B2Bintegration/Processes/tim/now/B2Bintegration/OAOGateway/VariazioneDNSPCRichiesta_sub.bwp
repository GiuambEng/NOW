                    <bpws:sources>
                        <bpws:source linkName="RichiestaToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://wholesalesoperator/VariazioneDNSPCRichiesta&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Olo&quot;/>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns5:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;'B2B'&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;'ORDINE'&quot;/>&lt;/tipoRichiesta>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&lt;/IDRisorsa>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Olo/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/dataInvioRichiesta>&lt;ordine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Olo/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&lt;/tipologiaLavorazione>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'VARIAZIONEPARENTALCONTROL'&quot;/>&lt;/tipologiaSottolav>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;$Asset/Record[1]/OFFERTA='EASYIPNGAFTTCAB'&quot;>&lt;nomeComponente>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPFTTCAB'&quot;/>&lt;/nomeComponente>&lt;/xsl:when>&lt;xsl:when test=&quot;$Asset/Record[1]/OFFERTA=('EASYIPNGAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;nomeComponente>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPFTTH'&quot;/>&lt;/nomeComponente>&lt;/xsl:when>&lt;/xsl:choose>&lt;integrationID>&lt;xsl:value-of select=&quot;3971&quot;/>&lt;/integrationID>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'PROFILOTECNICOLINEA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns:Profilo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;/dettaglioordine>&lt;offerta>&lt;xsl:value-of select=&quot;$Asset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;/ordine>&lt;xsl:if test=&quot;$Asset/Record[1]/OFFERTA&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$Asset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:choose>&lt;xsl:when test=&quot;$Asset/Record[1]/OFFERTA='EASYIPNGAFTTCAB'&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;44&quot;/>&lt;/IDOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Asset/Record[1]/OFFERTA='EASYIPNGAFTTH'&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;45&quot;/>&lt;/IDOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Asset/Record[1]/OFFERTA='SEMIEASYIPNGAFTTH'&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;69&quot;/>&lt;/IDOfferta>&lt;/xsl:when>&lt;/xsl:choose>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'VARIAZIONEPARENTALCONTROL'&quot;/>&lt;/tipologiaSottolav>&lt;/tns5:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
