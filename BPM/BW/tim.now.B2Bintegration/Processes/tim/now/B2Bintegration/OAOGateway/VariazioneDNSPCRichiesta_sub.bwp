                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select IDASSET, OFFERTA from BDS_1_CASEDATA_ASSET&#xa;where (IDRISORSA=? or NUMEROTELEFONICO=?) and CODIFICAOLOAGCOM=?&#xa;and STATOASSET in ('ATTIVO','INLAVORAZIONE')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
