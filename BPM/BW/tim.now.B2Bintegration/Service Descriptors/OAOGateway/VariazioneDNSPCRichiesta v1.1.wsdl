<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="VariazioneDNSPCRichiesta" targetNamespace="http://wholesalesoperator/VariazioneDNSPCRichiesta" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://wholesalesoperator/VariazioneDNSPCRichiesta">
	<!-- ===================================================== -->
	<!-- TYPES : definizione strutturale dei messaggi (XSD)    -->
	<!-- ===================================================== -->
	<wsdl:types>
		<xsd:schema targetNamespace="http://wholesalesoperator/VariazioneDNSPCRichiesta" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://wholesalesoperator/VariazioneDNSPCRichiesta" elementFormDefault="qualified">
			<!-- ===== REQUEST ===== -->
			<xsd:element name="VariazioneDNSPCRichiesta_Req">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CodiceOrdineOLO">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="30"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="IdRisorsa">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="16"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="CodiceOLOAGCOM">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="3"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="CodiceMessaggio" minOccurs="0">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="255"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="UserName">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="64"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="Profilo">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:enumeration value="1"/>
									<xsd:enumeration value="2"/>
									<xsd:enumeration value="3"/>
									<xsd:enumeration value="4"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="Note" minOccurs="0">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="255"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<!-- ===== RESPONSE ===== -->
			<xsd:element name="VariazioneDNSPCRichiesta_Resp">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CodiceEsito">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:enumeration value="OK"/>
									<xsd:enumeration value="KO"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="DescrizioneEsito" minOccurs="0">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="255"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:schema>
	</wsdl:types>
	<!-- ===================================================== -->
	<!-- MESSAGE : messaggi logici                             -->
	<!-- ===================================================== -->
	<wsdl:message name="VariazioneDNSPCRichiesta_Request">
		<wsdl:part name="parameters" element="tns:VariazioneDNSPCRichiesta_Req"/>
	</wsdl:message>
	<wsdl:message name="VariazioneDNSPCRichiesta_Response">
		<wsdl:part name="parameters" element="tns:VariazioneDNSPCRichiesta_Resp"/>
	</wsdl:message>
	<!-- ===================================================== -->
	<!-- PORTTYPE : interfaccia astratta                       -->
	<!-- ===================================================== -->
	<wsdl:portType name="VariazioneDNSPCRichiestaPortType">
		<wsdl:operation name="VariazioneDNSPCRichiesta">
			<wsdl:input message="tns:VariazioneDNSPCRichiesta_Request"/>
			<wsdl:output message="tns:VariazioneDNSPCRichiesta_Response"/>
		</wsdl:operation>
	</wsdl:portType>
	<!-- ===================================================== -->
	<!-- BINDING : SOAP document/literal                       -->
	<!-- ===================================================== -->
	<wsdl:binding name="VariazioneDNSPCRichiestaSoapBinding" type="tns:VariazioneDNSPCRichiestaPortType">
		<soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
		<wsdl:operation name="VariazioneDNSPCRichiesta">
			<soap:operation soapAction="http://wholesalesoperator/VariazioneDNSPCRichiesta/VariazioneDNSPCRichiesta" style="document"/>
			<wsdl:input>
				<soap:body use="literal"/>
			</wsdl:input>
			<wsdl:output>
				<soap:body use="literal"/>
			</wsdl:output>
		</wsdl:operation>
	</wsdl:binding>
	<!-- ===================================================== -->
	<!-- SERVICE : endpoint                                   -->
	<!-- ===================================================== -->
	<wsdl:service name="VariazioneDNSPCRichiestaService">
		<wsdl:port name="VariazioneDNSPCRichiestaPort" binding="tns:VariazioneDNSPCRichiestaSoapBinding">
			<soap:address location="http://localhost:8080/services/VariazioneDNSPCRichiesta"/>
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>