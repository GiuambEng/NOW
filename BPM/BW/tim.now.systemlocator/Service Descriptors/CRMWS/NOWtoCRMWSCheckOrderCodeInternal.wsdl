			<xsd:sequence>

				<xsd:element ref="tns:rispostaLocator"></xsd:element>

				<xsd:element ref="tns:Response" maxOccurs="1" minOccurs="0"></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
