            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="3"></xsd:maxLength>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="IdEsecProcsoNoFile" type="xsd:int"></xsd:element>
            		<xsd:element name="COD_ORDINE_OLO" maxOccurs="1"
            			minOccurs="0">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"></xsd:maxLength>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="COD_ORDINE_TI" maxOccurs="1"
            			minOccurs="0">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"></xsd:maxLength>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            	</xsd:sequence>
            </xsd:complexType>

