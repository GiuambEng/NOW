            					<xsd:enumeration
            						value="ULL Dati Linea Non Attiva">
            					</xsd:enumeration>
            					<xsd:enumeration
            						value="ULL Linea Attiva">
            					</xsd:enumeration>
            					<xsd:enumeration
            						value="ULL Linea Non Attiva">
