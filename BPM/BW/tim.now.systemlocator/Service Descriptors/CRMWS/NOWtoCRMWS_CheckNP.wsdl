<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:tns="http://xmlns.now.com/CRMWSCheckNP/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="CRMWSCheckConsistenza" targetNamespace="http://xmlns.now.com/CRMWSCheckNP/">
    <wsdl:types>
    <xsd:schema xmlns:Q1="http://www.tim.com/NOW/xsd/SystemLocator/" targetNamespace="http://xmlns.now.com/CRMWSCheckNP/">
            <xsd:import namespace="http://www.tim.com/NOW/xsd/SystemLocator/" schemaLocation="../../Schemas/SystemLocator/SystemLocator.xsd"/>

	<xsd:element name="checkNPResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="tns:rispostaLocator"/>
				<xsd:element ref="tns:CRMWSResponse" maxOccurs="1" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
            <xsd:element name="rispostaLocator" type="Q1:rispostaType"/>
        
            <xsd:complexType name="HeaderType">
            	<xsd:sequence>
            		<xsd:element name="TRANSACTION_ID">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"/>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="TRANSACTION_DATE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element name="SISTEMA_ORIGINE">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"/>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            	</xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="RequestType">
            	<xsd:sequence>
            		<xsd:element name="DATA_RICHIESTA"
            			type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element name="CODICE_OLO">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="3" />
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="ID_RISORSA" type="xsd:string" />
            		<xsd:element name="IdEsecProcsoNoFile" type="xsd:int"></xsd:element>
            	</xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="ResponseType">
            	<xsd:sequence>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="STATO_RISORSA">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:enumeration value="11" />
            					<xsd:enumeration value="12" />
            					<xsd:enumeration value="13" />
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="DATA_ATTIVAZIONE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="DATA_CESSAZIONE" type="xsd:dateTime">
            		</xsd:element>

            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="CODICE_OLO">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="3" />
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="CHECK_AMBITO_SERVIZIO"
            			minOccurs="0" maxOccurs="1">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:enumeration value="NOW"></xsd:enumeration>
            					<xsd:enumeration value="CRMWS"></xsd:enumeration>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="FLAG_NP" minOccurs="0"
            			maxOccurs="1">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:enumeration value="Y"></xsd:enumeration>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="RETURN_CODE" maxOccurs="1"
            			minOccurs="0">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:enumeration value="00"></xsd:enumeration>
            					<xsd:enumeration value="01"></xsd:enumeration>
            					<xsd:enumeration value="99"></xsd:enumeration>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="DESCRIZIONE_ERRORE"
            			type="xsd:string" maxOccurs="1" minOccurs="0">
            		</xsd:element>
            	</xsd:sequence>
            </xsd:complexType>

            <xsd:element name="CRMWSResponse" type="tns:ResponseType"/>
        
        
            <xsd:element name="checkNPRequest">
            	<xsd:complexType>
            		<xsd:sequence>
            			<xsd:element name="request"
            				type="tns:RequestType">
            			</xsd:element>
            		</xsd:sequence>
            	</xsd:complexType>
            </xsd:element>
    </xsd:schema>
  </wsdl:types>
    <wsdl:message name="checkNPRequest">
		<wsdl:part element="tns:checkNPRequest"
			name="parameters" />
    </wsdl:message>
    <wsdl:message name="checkNPResponse">
    	<wsdl:part element="tns:checkNPResponse" name="parameters"/>
    </wsdl:message>
    <wsdl:portType name="CMWSCheckNPPT">
    	<wsdl:operation name="checkNP">
    		<wsdl:input message="tns:checkNPRequest"/>
    		<wsdl:output message="tns:checkNPResponse"/>
    	</wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
