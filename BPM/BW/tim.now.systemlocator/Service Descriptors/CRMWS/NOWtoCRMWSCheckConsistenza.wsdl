	<xsd:element name="checkConsistenzaResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="tns:rispostaLocator"/>
				<xsd:element ref="tns:CRMWSResponse" maxOccurs="1" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
            <xsd:element name="rispostaLocator" type="Q1:rispostaType"/>
        
            <xsd:complexType name="HeaderType">
            	<xsd:sequence>
            		<xsd:element name="TRANSACTION_ID">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"/>
