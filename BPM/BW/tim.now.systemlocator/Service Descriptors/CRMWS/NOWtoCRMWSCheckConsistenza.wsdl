            			name="STATO_RISORSA">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:enumeration value="11" />
            					<xsd:enumeration value="12" />
            					<xsd:enumeration value="13" />
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="DATA_ATTIVAZIONE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="DATA_CESSAZIONE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="DATA_VARIAZIONE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element maxOccurs="1" minOccurs="0"
            			name="CODICE_OLO_RIS">
            			<xsd:simpleType>
