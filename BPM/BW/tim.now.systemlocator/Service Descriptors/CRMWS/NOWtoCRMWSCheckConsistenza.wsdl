            			</xsd:simpleType>
            		</xsd:element>
            		<xsd:element name="TRANSACTION_DATE" type="xsd:dateTime">
            		</xsd:element>
            		<xsd:element name="SISTEMA_ORIGINE">
            			<xsd:simpleType>
            				<xsd:restriction base="xsd:string">
            					<xsd:maxLength value="50"/>
            				</xsd:restriction>
            			</xsd:simpleType>
            		</xsd:element>
            	</xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="RequestType">
