    </wsdl:message>
    <wsdl:message name="checkConsistenzaResponse">
    	<wsdl:part element="tns:checkConsistenzaResponse" name="parameters"/>
    </wsdl:message>
    <wsdl:portType name="CMWSCheckConsistenzaPT">
    	<wsdl:operation name="checkConsistenza">
    		<wsdl:input message="tns:checkConsistenzaRequest"/>
    		<wsdl:output message="tns:checkConsistenzaResponse"/>
    	</wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
