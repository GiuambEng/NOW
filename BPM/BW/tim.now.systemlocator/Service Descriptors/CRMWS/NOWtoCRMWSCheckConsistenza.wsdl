<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:tns="http://xmlns.now.com/CRMWSCheckConsistenza/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="CRMWSCheckConsistenza" targetNamespace="http://xmlns.now.com/CRMWSCheckConsistenza/">
    <wsdl:types>
