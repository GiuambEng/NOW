<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:tns="http://www.tim.com/NOW/xsd/CriteriRollOut" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/CriteriRollOut">

    <import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../..//tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
    <complexType name="t_RichiestaVerificaCriteriRollOut">
    	<sequence>
    		<element name="Richiesta" type="string"/>
    		<element name="Servizio" type="string"/>
    		<element name="DataRichiesta" type="dateTime"/>
    		<element name="CodiceOLO">
    			<simpleType>
    				<restriction base="string">
    					<minLength value="1"></minLength>
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CodiceISP" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<minLength value="1"></minLength>
    					<maxLength value="3"></maxLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element minOccurs="0" name="CodiceComune" type="string"/>
    	</sequence>
    </complexType>
    
    <complexType name="t_RispostaVerificaCriteriRollOut">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" name="RecordCriteriRollOut">
    			<complexType>
    				<sequence>
			    		<element name="DataInizio" type="dateTime"/>
			    		<element name="DataFine" type="dateTime"/>
			    		<element name="Richiesta" type="string"/>
			    		<element name="Servizio" type="string"/>
			    		<element name="CodiceOLO">
			    			<simpleType>
			    				<restriction base="string">
			    					<minLength value="1"></minLength>
			    					<maxLength value="3"></maxLength>
			    				</restriction>
			    			</simpleType>
			    		</element>
			    		<element name="CodiceISP">
			    			<simpleType>
			    				<restriction base="string">
			    					<minLength value="1"></minLength>
			    					<maxLength value="3"></maxLength>
			    				</restriction>
			    			</simpleType>
			    		</element>
			    		<element name="CodiceComune" type="string"/>
			    		<element name="SistemaDiCompetenza" type="string"/>    		
			    	</sequence>
			    </complexType>
			</element>
    	</sequence>
    </complexType>

    <element name="RichiestaVerificaCriteriRollOut" type="tns:t_RichiestaVerificaCriteriRollOut"/>

    <element name="RispostaVerificaCriteriRollOut" type="tns:t_RispostaVerificaCriteriRollOut"/>
</schema>
