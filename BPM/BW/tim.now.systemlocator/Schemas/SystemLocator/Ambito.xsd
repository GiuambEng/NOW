<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"  xmlns:tns="http://www.tim.com/NOW/xsd/Ambito/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/Ambito/">

    <element name="RichiestaVerificaAmbito" type="tns:t_RichiestaVerificaAmbito"/>

    <element name="RispostaVerificaAmbito" type="tns:t_RispostaVerificaAmbito"/>

    <complexType name="t_RichiestaVerificaAmbito">
    	<sequence>
    		<element name="Richiesta" type="string"/>
    		<element minOccurs="0" name="Servizio" type="string"/>
    	</sequence>
    </complexType>
    
    <complexType name="t_RispostaVerificaAmbito">
    	<sequence>
    		<element name="RecordsRichiestaInAmbito">
    			<complexType>
    				<sequence>
    					<element maxOccurs="unbounded" minOccurs="0" name="RecordRichiestaInAmbito" type="tns:t_RecordRichiestaInAmbito"/>
    				</sequence>
    			</complexType>
      </element>
    	</sequence>
    </complexType>

    <complexType name="t_RecordRichiestaInAmbito">
    	<sequence>
    		<element name="Richiesta" type="string"/>
    		<element minOccurs="0" name="Servizio" type="string"/>
    		<element minOccurs="0" name="FlagNaked" type="string"/>
    		<element minOccurs="0" name="Ambito" type="string"/>
    	</sequence>
    </complexType>

</schema>
