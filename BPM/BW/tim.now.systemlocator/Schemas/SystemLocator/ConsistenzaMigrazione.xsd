<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/">

    <complexType name="InputType">
    	<sequence>
    		<element name="Risorsa" type="string" minOccurs="0"></element>
    		<element name="Servizio" type="string" minOccurs="0"></element>
    		<element name="OLO" type="string" minOccurs="0"></element>
    		<element name="Stato" type="string" minOccurs="0"></element>
    		<element name="DataAttivazione" type="date" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <element name="Consistenza" type="tns:InputType"></element>

    <complexType name="ConsistenzeType">
    	<sequence>
    		<element name="Consistenza" type="tns:InputType"
    			minOccurs="0" maxOccurs="unbounded">
    		</element>
    		<element name="ErroreRadicale" type="string" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Consistenze" type="tns:ConsistenzeType"></element>



    <complexType name="RisorsaInputType">
    	<sequence>
    		<element name="Risorsa" type="string"></element>
    		<element name="FlagAttivo" minOccurs="0" maxOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="Y"></enumeration>
    					<enumeration value="N"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="OLO" type="string" minOccurs="0"></element>
    		<element name="FlagNP" type="string" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="RisorsaInput" type="tns:RisorsaInputType"></element>
</schema>