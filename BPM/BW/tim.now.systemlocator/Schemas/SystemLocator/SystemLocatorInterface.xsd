<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- tim.now.schema.xsd.systemlocator.xsd ver 1.0 21/03/2016 --><xs:schema xmlns:pref="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocatorInterface/" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SystemLocatorInterface/">

	<xs:import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../..//tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
	<xs:element name="RispostaLocalizzatore">
		<xs:annotation>
			<xs:documentation>
				Tracciato output sistema Localizzatore NOW
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Testata" type="tns:testataType"/>
				<xs:element name="Risposta" type="tns:rispostaType"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RichiestaLocalizzatore">
		<xs:annotation>
			<xs:documentation>
				Tracciato input sistema Localizzatore NOW
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Testata" type="tns:testataType"/>
				<xs:element name="Richiesta" type="tns:richiestaType"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="rispostaType">
		<xs:sequence>
			<xs:element name="DataRisposta" type="xs:dateTime">

			</xs:element>
			<xs:element name="SistemaDiCompetenza">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="NOW"/>
						<xs:enumeration value="CRMWS"/>
						<xs:enumeration value="KO"/>
						<xs:enumeration value="DBCFX"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			
			<xs:element name="RC">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="00" />
						<xs:enumeration value="01" />
						<xs:enumeration value="02" />
						<xs:enumeration value="03" />
						<xs:enumeration value="04" />
						<xs:enumeration value="05" />
						<xs:enumeration value="06" />
						<xs:enumeration value="07" />
						<xs:enumeration value="08" />
						<xs:enumeration value="09" />
						<xs:enumeration value="10" />
						<xs:enumeration value="11" />
						<xs:enumeration value="12" />
						<xs:enumeration value="13" />
						<xs:enumeration value="14" />
						<xs:enumeration value="99" />
						<xs:enumeration value="15" />
						<xs:enumeration value="16" />
						<xs:enumeration value="17" />
						<xs:enumeration value="18" />
						<xs:enumeration value="20"></xs:enumeration>
						<xs:enumeration value="21"></xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			
			<xs:element minOccurs="0" name="ErrMSG">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="150"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>			

		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="richiestaType">
		<xs:sequence>
			<xs:element name="DataRichiesta" type="xs:dateTime" />

			<xs:element minOccurs="0" name="CodiceOLO"
				type="pref:CodificaOLOAGCOM">
			</xs:element>

			<xs:element minOccurs="0" name="CodiceISP"
				type="pref:CodiceOLO">
			</xs:element>

			<xs:element minOccurs="0" name="CodiceComune">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0" name="Servizio">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0" name="FlagNaked">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="S" />
						<xs:enumeration value="N" />
						<xs:enumeration value="" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0" name="Richiesta">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element name="Sottolavorazione" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element minOccurs="0" name="Ambito_XDSL">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="S" />
						<xs:enumeration value="N" />
						<xs:enumeration value="" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0"
				name="CodiceOrdineRiferimentoTI">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0"
				name="CodiceOrdineRiferimentoOLO">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0" name="IdRisorsa">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element minOccurs="0" name="IdCorrelazione">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element maxOccurs="1" minOccurs="0"
				name="Flag_verticalizzato">
				<xs:simpleType>
					<xs:restriction base="xs:string">

						<xs:enumeration value="S" />

						<xs:enumeration value="N" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element maxOccurs="1" minOccurs="0" name="Rientro_TI">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="1" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IdRisorsa2" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Telefonico" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OpzioneDinamica" minOccurs="0"
				maxOccurs="1" type="xs:string">

			</xs:element>
			<xs:element name="TipoLinea" type="xs:string" minOccurs="0"
				maxOccurs="1">
			</xs:element>
			<xs:element name="DNAggiuntivi" type="tns:DNaggiuntiviType"
				minOccurs="0" maxOccurs="1">
			</xs:element>

			<xs:element name="CodiceCambioTipologia" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="testataType">
		<xs:sequence>
			<xs:element name="Transaction_id">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element name="Transaction_date" type="xs:dateTime"/>

			<xs:element name="Sistema_origine">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="NOW"/>
						<xs:enumeration value="PORTALE"/>
						<xs:enumeration value="NOWDISAMB"/>
						<xs:enumeration value="NOWUPLOAD"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Fault">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Fault" type="tns:rispostaType"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="DNaggiuntiviType">
		<xs:sequence>

			<xs:element name="DN" minOccurs="0" maxOccurs="10">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"></xs:maxLength>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
