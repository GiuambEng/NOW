<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:tns="http://www.tim.com/NOW/xsd/CriteriRollOut_NP" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/CriteriRollOut_NP">
	<import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../..//tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
	<complexType name="t_RichiestaVerificaCriteriRollOut_NP">
		<sequence>
			<element name="Distretto" type="string"/>
            <element name="DataRichiesta" type="dateTime"/>
            <element name="CodiceOLO" minOccurs="0">
            	<simpleType>
            		<restriction base="string">
            			<maxLength value="3"></maxLength>
            			<minLength value="1"></minLength>
            		</restriction>
            	</simpleType>
            </element>
            <element name="CodiceISP" minOccurs="0">
            	<simpleType>
            		<restriction base="string">
            			<maxLength value="3"></maxLength>
            			<minLength value="1"></minLength>
            		</restriction>
            	</simpleType>
            </element>
		</sequence>
	</complexType>
	<complexType name="t_RispostaVerificaCriteriRollOut_NP">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="RecordCriteriRollOut_NP">
				<complexType>
					<sequence>
						<element name="DataInizio" type="dateTime"/>
						<element name="DataFine" type="dateTime"/>
						<element name="ID_Sistema" type="string"/>  
						<element name="CodiceOLO">
							<simpleType>
								<restriction base="string">
									<minLength value="1"></minLength>
									<maxLength value="3"></maxLength>
								</restriction>
							</simpleType>
						</element>
						<element name="CodiceISP">
							<simpleType>
								<restriction base="string">
									<minLength value="1"></minLength>
									<maxLength value="3"></maxLength>
								</restriction>
							</simpleType>
						</element>
						<element name="Distretto" type="string"/>  	
						<element name="Nome_Sistema" type="string"/>	
					</sequence>
				</complexType>	
			</element>
		</sequence>
	</complexType>

	<element name="RichiestaVerificaCriteriRollOut_NP" type="tns:t_RichiestaVerificaCriteriRollOut_NP"/>
	<element name="RispostaVerificaCriteriRollOut_NP" type="tns:t_RispostaVerificaCriteriRollOut_NP"/>

</schema>
