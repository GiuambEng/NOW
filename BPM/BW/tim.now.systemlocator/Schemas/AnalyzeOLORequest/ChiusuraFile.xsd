			<element name="ContatoreRichieste" type="int"></element>
			<element name="CodiceISP" type="string"></element>
			<element name="CodificaOLOagcom" type="string"></element>
			<element name="IDintrfc" type="int"></element>
			<element name="IDtplg_file" type="int"></element>
			<element name="Contatori" type="pref:ContatoriType"></element>
		</sequence>
