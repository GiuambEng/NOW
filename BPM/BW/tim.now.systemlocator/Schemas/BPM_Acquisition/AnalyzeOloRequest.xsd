<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns:cs="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:ns="http://www.tim.com/NOW/xsd/AnalyzeOloRequest/" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AnalyzeOloRequest/">

	<xs:import namespace="http://www.tim.com/NOW/xsd/CommonSchema/"/>
	<xs:element name="AnalyzeOloRequest">
		<xs:complexType>
			<xs:sequence>


				<xs:element name="FileName" type="xs:string"/>
				<xs:element name="Location" type="xs:string"/>
                <xs:element name="FileContent" type="xs:string"/>
            </xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="faultType">
		<xs:sequence>
			<xs:element name="RC" type="xs:string"/>
			<xs:element minOccurs="0" name="ErrMSG" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Fault">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="fault" type="ns:faultType"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>


	<xs:element name="AnalyzeOloEsito" type="ns:esitoType"/>
	
    <xs:complexType name="esitoType">
    	<xs:sequence>
    		<xs:element name="Esito">
    			<xs:simpleType>
    				<xs:restriction base="xs:string">
    					<xs:enumeration value="INSERITO"/>
    					<xs:enumeration value="DUPLICATO"/>
    					<xs:enumeration value="BAD"/>
    					<xs:enumeration value="IN AMBITO"/>
    					<xs:enumeration value="NON IN AMBITO"/>
    				</xs:restriction>
    			</xs:simpleType>
    		</xs:element>
    		<xs:element maxOccurs="1" minOccurs="0" name="CodiceOLO" type="xs:string"/>
    		<xs:element maxOccurs="1" minOccurs="0" name="CodificaOLOAgcom" type="xs:string"/>
    		<xs:element maxOccurs="1" minOccurs="0" name="DatiPUT" type="ns:PUTType"/>
    	</xs:sequence>
    </xs:complexType>

    <xs:complexType name="PUTType">
    	<xs:sequence>
    		<xs:element maxOccurs="1" minOccurs="1" name="RemoteFile" type="xs:string"/>
    		<xs:element maxOccurs="1" minOccurs="1" name="DirectoryPut" type="xs:string"/>
    		<xs:element name="Credenziali">
    			<xs:complexType>
    				<xs:sequence>
    					<xs:element maxOccurs="1" minOccurs="1" name="Host" type="xs:string">
    					</xs:element>
    					<xs:element maxOccurs="1" minOccurs="1" name="Port" type="xs:int">
    					</xs:element>
    					<xs:element maxOccurs="1" minOccurs="1" name="Password" type="xs:string">
    					</xs:element>
    					<xs:element maxOccurs="1" minOccurs="1" name="User" type="xs:string">
    					</xs:element>
    				</xs:sequence>
    			</xs:complexType>
    		</xs:element>
    	</xs:sequence>
    </xs:complexType>
</xs:schema>
