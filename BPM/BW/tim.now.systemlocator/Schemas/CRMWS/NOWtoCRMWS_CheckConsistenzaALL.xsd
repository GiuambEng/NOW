<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckConsistenzaALL" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckConsistenzaALL">

    <complexType name="InputType">
    	<sequence>
    		<element name="CodiceOrdineOLO" type="string"
    			minOccurs="0">
    		</element>
    		<element name="CodiceOrdineTI" type="string"
    			minOccurs="0">
    		</element>
    		<element name="IdEsecProcsoNoFile" type="int"
    			minOccurs="0">
    		</element>
    		<element name="IdRichiestaOLO" type="string"
    			minOccurs="0">
    		</element>
    		<element name="IdRisorsa" type="string" minOccurs="0"></element>
    		<element name="IdRisorsa2" type="string" minOccurs="0"></element>
    		<element name="Telefonico" type="string" minOccurs="0"></element>
    		<element name="DN" type="string" minOccurs="0" maxOccurs="10"></element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:InputType"></element>
    
    	<element name="FlowInfo" type="tns:FlowInfoType"/>

	<complexType name="FlowInfoType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="processInfoID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="processCode" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionDate" type="dateTime">
			</element>
			<element maxOccurs="1" minOccurs="0" name="sourceSystem" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="idProcessInstance" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="requestID" type="long"/>
		</sequence>
	</complexType>

	<element name="Esito">
		<simpleType>
			<restriction base="string">
				<enumeration value="ALLINEATO"></enumeration>
				<enumeration value="DISALLINEATO"></enumeration>
			</restriction>
		</simpleType>
	</element>
</schema>