<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://www.example.com/namespaces/tns/1464255115306" xmlns:Q2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://tim.now.com/StagVerificaDN_BDCFX" elementFormDefault="qualified" targetNamespace="http://tim.now.com/StagVerificaDN_BDCFX">

	<import namespace="http://www.tim.now.sharedlibrary.logprocess.telecom" schemaLocation="../../../tim.now.shared_library/Schemas/ProcessLog/tim.now.sharedlibrary.processlog.xsd"/>
	<import namespace="http://www.example.com/namespaces/tns/1464255115306" schemaLocation="../AnalyzeOLORequest/SchemaLogMessage.xsd"/>
	<element name="StagVerificaDN_BDCFX" type="tns:StagVerificaDN_BDCFXType"/>

	<complexType name="StagVerificaDN_BDCFXType">
		<sequence>
			<element name="target">
				<simpleType>
					<restriction base="string">
						<enumeration value="ERR"/>
						<enumeration value="REQ"/>
						<enumeration value="RES"/>
					</restriction>
				</simpleType>
			</element>
			<element name="processNoFileID" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="description" type="string">
			</element>




			<element maxOccurs="1" minOccurs="0" name="executionStatus" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="exitCode" type="string">
			</element>


			<element ref="tns:StagVerificaDN"/>
			<element name="IdEsecProcsoNoFile" type="int"/>
		</sequence>
	</complexType>

	<element name="FlowInfo" type="tns:FlowInfoType"/>

	<complexType name="FlowInfoType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="processInfoID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="processCode" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionID" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="transactionDate" type="dateTime">
			</element>
			<element maxOccurs="1" minOccurs="0" name="sourceSystem" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="idProcessInstance" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="requestID" type="long"/>
		</sequence>
	</complexType>

	<element name="StagingCheckOrderCode" type="tns:StagingCheckOrderCodeType">
	</element>

	<complexType name="StagingCheckOrderCodeType">
		<sequence>
			<element name="target" type="string"/>
			<element name="processNoFileID" type="string"/>
			<element maxOccurs="1" minOccurs="0" ref="tns:StagVerificaOrdn">
			</element>
			<element maxOccurs="1" minOccurs="0" ref="Q2:LogFileProcessato"/>
		</sequence>
	</complexType>


	<element name="StagVerificaDN" type="tns:StagVerificaDNType">
	</element>

	<complexType name="StagVerificaDNType">
		<sequence>
			<element name="idRichiesta">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element name="AMBITO" type="string" minOccurs="0"/>
			<element name="timestampRichiesta" type="dateTime"/>
			<element maxOccurs="1" minOccurs="0" name="timestampRisposta" type="dateTime"/>
			<element name="contenutoRequest" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="contenutoResponse" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="SistemaDiCompetenzaNWS">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="DN">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="returnCode">
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="descrizioneErrore" type="string"></element>
		</sequence>
	</complexType>

	<element name="StagVerificaOrdn" type="tns:StagVerificaOrdnType"/>

	<complexType name="StagVerificaOrdnType">
		<sequence>
			<element name="identificativoRichiesta">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element name="timestampRichiesta" type="dateTime"/>
			<element maxOccurs="1" minOccurs="0" name="timestampRisposta" type="dateTime"/>
			<element name="contenutoRequest" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="contenutoResponse" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="sistemaOrigine">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="codiceOLO">
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="codiceOLOCRMWS">
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="codiceOrdineOLO">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="codiceOrdineTI">
				<simpleType>
					<restriction base="string">
						<maxLength value="50"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="servizio">
				<simpleType>
					<restriction base="string">
						<maxLength value="100"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="lavorazione">
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="dataRicezioneOrdine" type="dateTime"/>
			<element maxOccurs="1" minOccurs="0" name="returnCode">
				<simpleType>
					<restriction base="string">
						<maxLength value="2"/>
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="descrizioneErrore" type="string"></element>
		</sequence>
	</complexType>

	<element name="LogInput" type="tns:LogInputType"/>

	<complexType name="LogInputType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="COD_PROCSO_NOFILE" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="LOG_MESSAGE" type="string">
			</element>
			<element maxOccurs="1" minOccurs="0" name="TIMSTP_INSMTO" type="dateTime">
			</element>
			<element maxOccurs="1" minOccurs="0" name="COD_PROCSO" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="LOG_LEVEL" type="string"/>
		</sequence>
	</complexType>
</schema>
