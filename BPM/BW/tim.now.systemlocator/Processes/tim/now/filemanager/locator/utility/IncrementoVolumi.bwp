            </bpws:extensionActivity>
            <bpws:flow name="LocalTransaction" tibex:group="localTX"
                tibex:txGroup="com.tibco.bw.palette.jdbc.txGroup" tibex:xpdlId="e851e3fa-d4d5-43d7-80a5-298a289d9ffa">
                <bpws:targets>
                    <bpws:target linkName="LogToLocalTransaction"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LocalTransactionToEnd"/>
                </bpws:sources>
                <bpws:links>
                    <bpws:link name="JDBCUpdateToEnd" tibex:linkType="SUCCESS"/>
                    <bpws:link name="DenormToGroupEnd" tibex:linkType="SUCCESS"/>
                    <bpws:link name="GroupStartToRollout" tibex:linkType="SUCCESS"/>
                </bpws:links>
                <bpws:empty name="GroupStart" tibex:group="groupStart" tibex:xpdlId="f08e2854-e580-4181-bad3-6b4d9a27dfbb">
                    <bpws:sources>
                        <bpws:source linkName="GroupStartToRollout"/>
                    </bpws:sources>
                </bpws:empty>
                <bpws:empty name="GroupEnd" tibex:group="groupEnd" tibex:xpdlId="ef62efd3-cb04-48b8-ad7e-7e7fd1748700">
                    <bpws:targets>
                        <bpws:target linkName="DenormToGroupEnd"/>
                    </bpws:targets>
                </bpws:empty>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+098f8775-5ced-48d4-8e5a-00f4af257df5+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;Richiesta>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta&quot;/>&lt;/Richiesta>&lt;Servizio>&lt;xsl:value-of select=&quot;$Start/tns1:Servizio&quot;/>&lt;/Servizio>&lt;CodOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLO&quot;/>&lt;/CodOLO>&lt;CodISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodISP)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodISP&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodISP>&lt;Data>&lt;xsl:value-of select=&quot;format-dateTime($Start/tns1:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&lt;/Data>&lt;CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceISTATComune)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceISTATComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceComune>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="Rollout-input" name="Rollout"
                        outputVariable="Rollout"
                        tibex:xpdlId="098f8775-5ced-48d4-8e5a-00f4af257df5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="GroupStartToRollout"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="JDBCUpdateToEnd"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+098f8775-5ced-48d4-8e5a-00f4af257df5+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;Richiesta>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta&quot;/>&lt;/Richiesta>&lt;Servizio>&lt;xsl:value-of select=&quot;$Start/tns1:Servizio&quot;/>&lt;/Servizio>&lt;CodOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLO&quot;/>&lt;/CodOLO>&lt;CodISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodISP)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodISP&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodISP>&lt;Data>&lt;xsl:value-of select=&quot;format-dateTime($Start/tns1:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&lt;/Data>&lt;CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceISTATComune)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceISTATComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceComune>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE &#xa;(select r.CONTA_ORDN&#xa;from LOCZRE_CRITR_ROLLT r, TIPOLG_LAVRZ l, TRASCODFC_OFFERTA o, SISTEMA s&#xa;WHERE r.idtplg_lavrz = l.idtplg_lavrz&#xa;and r.ID_TRASCODFC_OFFERTA =o.id_trascodfc_offerta&#xa;and o.provenienza = 'XML'&#xa;and upper(l.tipolg_lavrz)= ? --'RICHIESTA'&#xa;and upper(o.nome_offerta_esterna) = ? --'SERVIZIO'&#xa;and (r.COD_OLO = ? or (r.COD_ISP = ? and r.COD_ISP is not null))&#xa;and To_Date(?,'yyyymmdd-hh24miss') between r.datainz and r.datafi --DATA RICHIESTA &#xa;AND NVL(r.CONTA_ORDN,0)&lt;NVL(r.VOLUMI_IN_NOW,0)&#xa;AND r.ID_SISTEMA=s.ID_SISTEMA&#xa;AND s.DESCR_SISTEMA_NOME_SISTEMA='NOW'&#xa;AND (r.COD_ISTAT_COMUNE=? OR r.COD_ISTAT_COMUNE='*'))&#xa;SET CONTA_ORDN=NVL(CONTA_ORDN,0)+1" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Richiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Data"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceComune"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b7d931f9-6e6b-4f46-9ab5-08ab63b81ae7+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:Servizio)&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:Richiesta)&quot;/>&lt;/TIPOLG_LAVRZ>&lt;COD_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLO&quot;/>&lt;/COD_OLO>&lt;COD_ISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodISP)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodISP&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISP>&lt;DATA>&lt;xsl:value-of select=&quot;format-dateTime($Start/tns1:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&lt;/DATA>&lt;COD_ISTAT_COMUNE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceISTATComune)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceISTATComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISTAT_COMUNE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                        inputVariable="Denorm-input" name="Denorm"
                        outputVariable="Denorm"
                        tibex:xpdlId="b7d931f9-6e6b-4f46-9ab5-08ab63b81ae7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="JDBCUpdateToEnd"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="DenormToGroupEnd"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b7d931f9-6e6b-4f46-9ab5-08ab63b81ae7+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:Servizio)&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:Richiesta)&quot;/>&lt;/TIPOLG_LAVRZ>&lt;COD_OLO>&lt;xsl:value-of select=&quot;$Start/tns1:CodOLO&quot;/>&lt;/COD_OLO>&lt;COD_ISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodISP)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodISP&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISP>&lt;DATA>&lt;xsl:value-of select=&quot;format-dateTime($Start/tns1:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&lt;/DATA>&lt;COD_ISTAT_COMUNE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceISTATComune)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceISTATComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISTAT_COMUNE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE LOCZRE_CRITR_ROLLT_DENORM rt&#xa;SET rt.CONTA_ORDN=NVL(rt.CONTA_ORDN,0)+1&#xa;WHERE upper(rt.NOME_OFFERTA_ESTERNA)=?&#xa;AND upper(rt.TIPOLG_LAVRZ)=? &#xa;and rt.DESCR_SISTEMA='NOW' &#xa;and (rt.COD_OLO = ? or (rt.COD_ISP = ? and rt.COD_ISP is not null))&#xa;and To_Date(?,'yyyymmdd-hh24miss') between rt.DATAINZ and rt.DATAFI --DATA RICHIESTA &#xa;AND NVL(rt.CONTA_ORDN,0)&lt;NVL(rt.VOLUMI_IN_NOW,0)&#xa;AND (rt.COD_COMUNE=? OR rt.COD_COMUNE='*')" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISTAT_COMUNE"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
            </bpws:flow>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input Incremento Volumi: &amp;quot;,tib:render-xml($Start))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInput-input" name="LogInput"
                    tibex:xpdlId="40995dbd-5c43-436f-9681-0e0b3b7722a8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLocalTransaction"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToLocalTransaction"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input Incremento Volumi: &amp;quot;,tib:render-xml($Start))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
