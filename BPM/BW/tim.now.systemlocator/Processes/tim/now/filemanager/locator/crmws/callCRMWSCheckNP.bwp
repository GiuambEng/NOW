&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd" xmlns:tns="http://xmlns.example.com/1460641967114" xmlns:ns1="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2" xmlns:tns1="http://xmlns.example.com/1470142071397" xmlns:ns2="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckNP/Schema.xsd2" version="2.0"&gt;&lt;xsl:param name="codeNA"/&gt;&lt;xsl:param name="retryErrorMessage"/&gt;&lt;xsl:template name="CRMWSCheckNPError-input" match="/"&gt;&lt;tns1:Response&gt;&lt;RESPONSE&gt;&lt;ns2:RESPONSE&gt;&lt;ns2:RETURN_CODE&gt;&lt;xsl:value-of select="$codeNA"/&gt;&lt;/ns2:RETURN_CODE&gt;&lt;ns2:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$retryErrorMessage"/&gt;&lt;/ns2:DESCRIZIONE_ERRORE&gt;&lt;/ns2:RESPONSE&gt;&lt;/RESPONSE&gt;&lt;/tns1:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd&quot; xmlns:tns=&quot;http://xmlns.example.com/1460641967114&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2&quot; xmlns:tns1=&quot;http://xmlns.example.com/1470142071397&quot; xmlns:ns2=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckNP/Schema.xsd2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;codeNA&quot;/>&#xa;    &lt;xsl:param name=&quot;retryErrorMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;CRMWSCheckNPError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:RESPONSE>&#xa;            &lt;ns2:RETURN_CODE>&#xa;                &lt;xsl:value-of select=&quot;$codeNA&quot;/>&#xa;            &lt;/ns2:RETURN_CODE>&#xa;            &lt;ns2:DESCRIZIONE_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$retryErrorMessage&quot;/>&#xa;            &lt;/ns2:DESCRIZIONE_ERRORE>&#xa;        &lt;/ns2:RESPONSE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogCallErrorToReply"/>
                </bpws:targets>
            </bpws:reply>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
