                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_NP (DATAINZ, DATAFI, COD_OLO, COD_ISP, DISTR, ID_SISTEMA, VOLUMI_IN_NOW)&#xa;  SELECT (SELECT TO_DATE(SYSDATE) FROM DUAL), TO_DATE('31-12-2999','dd-mm-yyyy'), OLO.CODFC_OLO_AGCOM, OLO.COD_OLO, ?, SIS.ID_SISTEMA, ?&#xa;    FROM APPUSER.OLO OLO, APPUSER.SISTEMA SIS&#xa;    WHERE CODFC_OLO_AGCOM=? AND UPPER(SIS.DESCR_SISTEMA_NOME_SISTEMA)=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Distretto"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>

