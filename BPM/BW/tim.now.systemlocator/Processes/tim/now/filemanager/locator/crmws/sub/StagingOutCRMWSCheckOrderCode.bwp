                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+574e8a11-ab93-440b-a275-7480dc9f1640+input&quot; xmlns:tns1=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;InsertStagingALL-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_OLO_CRMWS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagVerificaOrdn/tns1:codiceOLOCRMWS)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagVerificaOrdn/tns1:codiceOLOCRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO_CRMWS>&lt;CODOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagVerificaOrdn/tns1:codiceOLO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagVerificaOrdn/tns1:codiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODOLO>&lt;CONTENUTO_REQUEST>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagVerificaOrdn/tns1:contenutoRequest)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagVerificaOrdn/tns1:contenutoRequest&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_REQUEST>&lt;CONTENUTO_RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:StagVerificaOrdn/tns1:contenutoResponse)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:StagVerificaOrdn/tns1:contenutoResponse&quot;