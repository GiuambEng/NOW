                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_VERIFICA_ORDN (COD_OLO_CRMWS, CODOLO,&#xa;  CONTENUTO_REQUEST, CONTENUTO_RESPONSE, ID_RICH, LAVRZ, SISTEMA_ORIGINE,&#xa;  TIMSTP_RICH, TIMSTP_RISPOSTA, ID_ESEC_PROCSO_NO_FILE, ID_STATO_ELAB_STAG)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, (SELECT ID_STATO_ELAB_STAG&#xd;&#xa;                                                        FROM APPUSER.TIPOLG_STATO_ELAB_STAG&#xd;&#xa;                                                        WHERE DESCR = ?))" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_CRMWS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_REQUEST"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_RESPONSE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA_ORIGINE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_REQUEST"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_RESPONSE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
