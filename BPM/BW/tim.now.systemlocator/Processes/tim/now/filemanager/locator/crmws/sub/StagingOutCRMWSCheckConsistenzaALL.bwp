                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_CHECKCOSTZALL_NO_FILE(ID_ESEC_PROCSO_NO_FILE,&#xa;  TIMSTP_RICH, CONTENUTO_REQUEST, TIMSTP_RISPOSTA, CONTENUTO_RESPONSE,&#xa;  ID_RICH,COD_ORDN_OLO,COD_ORDN_TI,ID_RICH_OLO,IDRISORSA,IDRISORSA2,OPERATORE,TELEFONICO,ID_STATO_ELAB_STAG)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, (SELECT ID_STATO_ELAB_STAG&#xa;                                                        FROM APPUSER.TIPOLG_STATO_ELAB_STAG&#xa;                                                        WHERE DESCR = ?))" xsi:type="jdbcPalette:JDBCUpdateActivity">
