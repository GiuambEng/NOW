                                <bpws:link name="JDBCQuery1ToLog4" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Log4ToWriteFile1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="WriteFile1ToGroupEnd" tibex:linkType="SUCCESS"/>
