                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LocalFlowInfo&quot; match=&quot;/&quot;>&lt;tns:FlowInfo>&lt;tns:processInfoID>&lt;xsl:value-of select=&quot;concat('ProcessName=',bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),'; JobId-ProcessId=',$_processContext/JobId,'-',$_processContext/ProcessInstanceId,'; ApplicationName=',bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;))&quot;/>&lt;/tns:processInfoID>&lt;tns:processCode>&lt;xsl:value-of select=&quot;'PROCESSO_NOW_CRMWS_CHECKORDERCODE'&quot;/>&lt;/tns:processCode>&lt;tns:transactionID>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/tns:transactionID>&lt;tns:transactionDate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:transactionDate>&lt;tns:sourceSystem>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns:sourceSystem>&lt;tns:idProcessInstance>&lt;xsl:value-of select=&quot;concat(string(tib:timestamp()), $_processContext/ProcessInstanceId)&quot;/>&lt;/tns:idProcessInstance>&lt;tns:requestID>&lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&lt;/tns:requestID>&lt;/tns:FlowInfo>&lt;/xsl:template>&lt;/xsl:stylesheet>"
