                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallCRMWSCheckOrderCode/HEADER/ns6:HEADER/ns6:RESPONSE/ns6:RETURN_CODE = $codeOK or $CallCRMWSCheckOrderCode/HEADER/ns6:HEADER/ns6:RESPONSE/ns6:RETURN_CODE = $codeNA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallCRMWSCheckOrderCode.HEADER/ns6:RESPONSE/ns6:RETURN_CODE = $codeOK or $CallCRMWSCheckOrderCode.HEADER/ns6:RESPONSE/ns6:RETURN_CODE = $codeNA]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallCRMWSCheckOrderCodeToLogError">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
