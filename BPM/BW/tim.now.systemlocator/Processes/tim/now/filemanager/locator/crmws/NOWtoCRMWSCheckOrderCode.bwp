                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1463671354330" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd" xmlns:tns2="http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="LocalRequest"/&gt;&lt;xsl:template name="CallCRMWSCheckOrderCode-input" match="/"&gt;&lt;tns:Request&gt;&lt;HEADER&gt;&lt;xsl:copy-of select="$LocalRequest"/&gt;&lt;/HEADER&gt;&lt;/tns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1463671354330&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd&quot; xmlns:tns2=&quot;http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LocalRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;CallCRMWSCheckOrderCode-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$LocalRequest&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
