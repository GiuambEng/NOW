                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns2="http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd2" version="2.0"&gt;&lt;xsl:param name="CallCRMWSCheckOrderCode"/&gt;&lt;xsl:template name="checkOrderCodeOut-input" match="/"&gt;&lt;tns2:checkOrderCodeResponse&gt;&lt;parameters&gt;&lt;tns2:checkOrderCodeResponse&gt;&lt;tns2:rispostaLocator&gt;&lt;tns1:DataRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:DataRisposta&gt;&lt;tns1:SistemaDiCompetenza&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/tns1:SistemaDiCompetenza&gt;&lt;tns1:RC&gt;&lt;xsl:value-of select="&amp;quot;00&amp;quot;"/&gt;&lt;/tns1:RC&gt;&lt;tns1:ErrMSG&gt;&lt;xsl:value-of select="&amp;quot;Errore chiamata check order code&amp;quot;"/&gt;&lt;/tns1:ErrMSG&gt;&lt;/tns2:rispostaLocator&gt;&lt;xsl:if test="exists($CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE)"&gt;&lt;tns2:Response&gt;&lt;xsl:if test="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:SERVIZIO"&gt;&lt;SERVIZIO&gt;&lt;xsl:value-of select="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:SERVIZIO"/&gt;&lt;/SERVIZIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:LAVORAZIONE"&gt;&lt;LAVORAZIONE&gt;&lt;xsl:value-of select="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:LAVORAZIONE"/&gt;&lt;/LAVORAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:DRO"&gt;&lt;DRO&gt;&lt;xsl:value-of select="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:DRO"/&gt;&lt;/DRO&gt;&lt;/xsl:if&gt;&lt;RETURN_CODE&gt;&lt;xsl:value-of select="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:RETURN_CODE"/&gt;&lt;/RETURN_CODE&gt;&lt;xsl:if test="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"&gt;&lt;DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$CallCRMWSCheckOrderCode/HEADER/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"/&gt;&lt;/DESCRIZIONE_ERRORE&gt;&lt;/xsl:if&gt;&lt;/tns2:Response&gt;&lt;/xsl:if&gt;&lt;/tns2:checkOrderCodeResponse&gt;&lt;/parameters&gt;&lt;/tns2:checkOrderCodeResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallCRMWSCheckOrderCode.HEADER&quot;/>&#xa;    &lt;xsl:template name=&quot;checkOrderCodeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:checkOrderCodeResponse>&#xa;            &lt;tns2:rispostaLocator>&#xa;                &lt;tns1:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:DataRisposta>&#xa;                &lt;tns1:SistemaDiCompetenza>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns1:SistemaDiCompetenza>&#xa;                &lt;tns1:RC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                &lt;/tns1:RC>&#xa;                &lt;tns1:ErrMSG>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Errore chiamata check order code&amp;quot;&quot;/>&#xa;                &lt;/tns1:ErrMSG>&#xa;            &lt;/tns2:rispostaLocator>&#xa;            &lt;xsl:if test=&quot;exists($CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE)&quot;>&#xa;                &lt;tns2:Response>&#xa;                    &lt;xsl:if test=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:SERVIZIO&quot;>&#xa;                        &lt;SERVIZIO>&#xa;                            &lt;xsl:value-of select=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:SERVIZIO&quot;/>&#xa;                        &lt;/SERVIZIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:LAVORAZIONE&quot;>&#xa;                        &lt;LAVORAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:LAVORAZIONE&quot;/>&#xa;                        &lt;/LAVORAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:DRO&quot;>&#xa;                        &lt;DRO>&#xa;                            &lt;xsl:value-of select=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:DRO&quot;/>&#xa;                        &lt;/DRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;RETURN_CODE>&#xa;                        &lt;xsl:value-of select=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:RETURN_CODE&quot;/>&#xa;                    &lt;/RETURN_CODE>&#xa;                    &lt;xsl:if test=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                        &lt;DESCRIZIONE_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;$CallCRMWSCheckOrderCode.HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                        &lt;/DESCRIZIONE_ERRORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Response>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:checkOrderCodeResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="StagResTocheckOrderCodeOut"/>
                                    <bpws:target linkName="StagErrTocheckOrderCodeOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:tns2=&quot;http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LocalFlowInfo&quot;/>&lt;xsl:param name=&quot;checkOrderCode&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogBegin-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Process: NOWtoCRMWSCheckOrderCode: &amp;quot;,&amp;quot;BEGIN> &amp;quot;, $LocalFlowInfo/tns1:processInfoID, &amp;quot;Input: &amp;quot;, tib:render-xml($checkOrderCode/parameters/tns2:checkOrderCodeRequest))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogBegin-input"
                                    name="LogBegin"
                                    tibex:xpdlId="ef60e0be-f291-4e07-b85e-ef542c5a4d61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToLogBegin"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogBeginToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:tns2=&quot;http://www.tibco.com/NOWtoCRMWSCheckOrderCode/Internal&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkOrderCode.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LocalFlowInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogBegin-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Process: NOWtoCRMWSCheckOrderCode: &amp;quot;,&amp;quot;BEGIN> &amp;quot;, $LocalFlowInfo/tns1:processInfoID, &amp;quot;Input: &amp;quot;, tib:render-xml($checkOrderCode.parameters))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
