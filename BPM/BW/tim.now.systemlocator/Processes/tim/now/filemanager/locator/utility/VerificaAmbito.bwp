                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQuery3-input" name="JDBCQuery3"
                    outputVariable="JDBCQuery3"
                    tibex:xpdlId="49904008-32ef-4adc-99ef-edc1df8dcab7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToJDBCQuery1_EsisteservizioNP"/>
