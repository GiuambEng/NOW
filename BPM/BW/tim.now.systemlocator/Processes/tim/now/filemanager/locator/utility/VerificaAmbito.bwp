                    inputVariable="v_RispostaVerificaAmbito"
                    name="Assign"
                    outputVariable="v_RispostaVerificaAmbito"
                    tibex:xpdlId="f9cb1689-18a7-4a7c-b28d-e8983cfd11b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEndLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Ambito/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery3&quot;/>&lt;xsl:template name=&quot;v_RispostaVerificaAmbito&quot; match=&quot;/&quot;>&lt;tns:RispostaVerificaAmbito>&lt;tns:RecordsRichiestaInAmbito>&lt;xsl:for-each select=&quot;$JDBCQuery3/Record&quot;>&lt;tns:RecordRichiestaInAmbito>&lt;tns:Richiesta>&lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&lt;/tns:Richiesta>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;tns:FlagNaked>&lt;xsl:value-of select=&quot;FLAG_NAKED&quot;/>&lt;/tns:FlagNaked>&lt;tns:Ambito>&lt;xsl:value-of select=&quot;AMBITO&quot;/>&lt;/tns:Ambito>&lt;/tns:RecordRichiestaInAmbito>&lt;/xsl:for-each>&lt;/tns:RecordsRichiestaInAmbito>&lt;/tns:RispostaVerificaAmbito>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
