&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SystemLocator/" version="2.0"&gt;&lt;xsl:param name="V_RispostaLocalizzatore"/&gt;&lt;xsl:template name="GetSystemOut-input" match="/"&gt;&lt;ns0:GetSystemResponse xmlns:ns0="http://www.tim.com/NOW/wsdl/abstract/SystemLocatorInternal/"&gt;&lt;RispostaLocalizzatore&gt;&lt;xsl:copy-of select="$V_RispostaLocalizzatore"/&gt;&lt;/RispostaLocalizzatore&gt;&lt;/ns0:GetSystemResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
