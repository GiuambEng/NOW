                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ca040e34-3377-494d-964e-152da5515526+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaOrd-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CODICEORDINEOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICEORDINEOLO>&#xa;            &lt;CODIFICAOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODIFICAOLOAGCOM>&#xa;            &lt;CODIFICAOLONOW>&#xa;           