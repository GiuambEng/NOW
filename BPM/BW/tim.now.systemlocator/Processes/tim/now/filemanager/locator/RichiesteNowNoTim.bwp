                        <bpws:source linkName="AttivazioneToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)='VULLLINEANONATTIVA'&#xd;&#xa; or starts-with(upper-case($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio),'EASYIPUBB') &#xd;&#xa; or (( upper-case($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'BITSTREAMGBEASIMMETRICOFLAT' &#xd;&#xa; or  upper-case($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'BITSTREAMNGAFTTCAB' &#xd;&#xa; or upper-case($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'VULAFTTCAB') &#xd;&#xa; and $GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:OpzioneDinamica='Y')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)='VULLLINEANONATTIVA'
 or starts-with(upper-case($GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio),'EASYIPUBB') 
 or (( upper-case($GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'BITSTREAMGBEASIMMETRICOFLAT' 
 or  upper-case($GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'BITSTREAMNGAFTTCAB' 
 or upper-case($GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:Servizio)= 'VULAFTTCAB') 
 and $GetSystemIn.RichiestaLocalizzatore/ns3:Richiesta/ns3:OpzioneDinamica='Y')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AttivazioneToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
