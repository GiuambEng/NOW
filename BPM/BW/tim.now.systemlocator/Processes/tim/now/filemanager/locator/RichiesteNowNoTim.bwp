                                    sqlStatement="SELECT CODIFICAOLOAGCOM&#xa;FROM BDS_1_CASEDATA_ORDINE&#xa;WHERE CODICEORDINEOLO = ? AND (CODIFICAOLOAGCOM = ? or CODIFICAOLONOW = ?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
