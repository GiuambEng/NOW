            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:param name=&quot;JDBCQuery3&quot;/>&lt;xsl:param name=&quot;JDBCQuery4&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:FlagNP=&amp;quot;Y&amp;quot;&quot;>&lt;tns:Consistenze>&lt;xsl:for-each select=&quot;$JDBCQuery/Record[SERVIZIO=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns:Risorsa>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RISORSA&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;STATO_RISORSA&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;tns:DataAttivazione>&lt;xsl:value-of select=&quot;xsd:date(DES)&quot;/>&lt;/tns:DataAttivazione>&lt;/tns:Consistenza>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$JDBCQuery1/Record[SERVIZIO=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns:Risorsa>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RISORSA&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;STATO_RISORSA&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;tns:DataAttivazione>&lt;xsl:value-of select=&quot;xsd:date(DES)&quot;/>&lt;/tns:DataAttivazione>&lt;/tns:Consistenza>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$JDBCQuery2/Record[SERVIZIO=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns:Risorsa>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RISORSA&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;STATO_RISORSA&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;tns:DataAttivazione>&lt;xsl:value-of select=&quot;xsd:date(DES)&quot;/>&lt;/tns:DataAttivazione>&lt;/tns:Consistenza>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$JDBCQuery3/Record[SERVIZIO=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns:Risorsa>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RISORSA&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;STATO_RISORSA&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;tns:DataAttivazione>&lt;xsl:value-of select=&quot;xsd:date(DES)&quot;/>&lt;/tns:DataAttivazione>&lt;/tns:Consistenza>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$JDBCQuery4/Record[SERVIZIO=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns:Risorsa>&lt;xsl:if test=&quot;SERVIZIO&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Ser