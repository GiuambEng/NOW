                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT asset.IDASSET,asset.CODIFICAOLOAGCOM, asset.statoasset AS stato_risorsa, asset.offerta AS servizio, asset.created,asset.CODICETOPONOMASTICA,asset.CODICEISTATCOMUNE,asset.DES &#xa;FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ATTR, BDS_1_CASEDATA_ASSET ASSET &#xa;WHERE ATTR.NOMEATTRIBUTO = 'CAPOSERIE' AND ATTR.VALOREATTRIBUTO=?&#xa;AND ATTR.IDASSET=ASSET.IDASSET AND (asset.statoasset='ATTIVO' or asset.statoasset='INLAVORAZIONE') AND ASSET.OFFERTA!='CPS'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Risorsa"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="SERVIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODICETOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEISTATCOMUNE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
