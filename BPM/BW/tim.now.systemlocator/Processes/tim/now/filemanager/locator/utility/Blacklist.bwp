                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Lista" name="Lista"
                    outputVariable="Lista"
                    tibex:xpdlId="c0fa0e96-3843-4a7d-949d-ff46a8034032" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
