            <xs:import namespace="http://www.example.org/RisorsaBlackList"/>
            <xs:element name="AccumulatedOutput" type="tns:AccumulatedOutputType"/>
            <xs:complexType name="AccumulatedOutputType">
                <xs:sequence maxOccurs="1" minOccurs="0">
                    <xs:element maxOccurs="unbounded" minOccurs="0" ref="Q1:Risorsa"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
