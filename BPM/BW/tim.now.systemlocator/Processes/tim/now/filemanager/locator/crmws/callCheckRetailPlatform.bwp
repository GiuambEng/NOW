                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$CheckRetailPlatform/parameters/ns7:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &quot;00&quot; and ($CheckRetailPlatform/parameters/ns7:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMB_V&quot; or $CheckRetailPlatform/parameters/ns7:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;DBSS&quot; or $CheckRetailPlatform/parameters/ns7:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMR_V&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
