                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns5:Richiesta/ns2:IdCorrelazione)>0 and $Start/ns5:FlagPacchettiNP=&quot;N&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns5:Richiesta/ns2:IdCorrelazione)>0 and $Start/ns5:FlagPacchettiNP="N"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
