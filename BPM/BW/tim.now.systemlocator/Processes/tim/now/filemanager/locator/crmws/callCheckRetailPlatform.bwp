            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1475570713382&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CriteriRolloutNP&quot;/>&lt;xsl:template name=&quot;v_RispostaLocalizzatore&quot; match=&quot;/&quot;>&lt;tns1:RispostaLocalizzatore>&lt;tns1:Testata>&lt;xsl:copy-of select=&quot;$Start/tns:Testata/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:Testata/@*&quot;/>&lt;xsl:copy-of select=&quot;$Start/tns:Testata/node()&quot;/>&lt;/tns1:Testata>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CriteriRolloutNP/tns2:RecordCriteriRollOut_NP) > 0 and $CriteriRolloutNP/tns2:RecordCriteriRollOut_NP[1]/tns2:Nome_Sistema = &amp;quot;CRMWS&amp;quot;&quot;>&lt;tns1:Risposta>&lt;tns1:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:DataRisposta>&lt;tns1:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'DBCFX'&quot;/>&lt;/tns1:SistemaDiCompetenza>&lt;tns1:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns1:RC>&lt;tns1:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout NP non superata&amp;quot;&quot;/>&lt;/tns1:ErrMSG>&lt;/tns1:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;count($CriteriRolloutNP/tns2:RecordCriteriRollOut_NP) > 0 and $CriteriRolloutNP/tns2:RecordCriteriRollOut_NP[1]/tns2:Nome_Sistema = &amp;quot;NOW&amp;quot;&quot;>&lt;tns1:Risposta>&lt;tns1:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:DataRisposta>&lt;tns1:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns1:SistemaDiCompetenza>&lt;tns1:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns1:RC>&lt;/tns1:R