                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.example.com/namespaces/tns/1475570713382" xmlns:tns2="http://dbcfx/SOA/CheckRetailPlatform" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:sm="http://dbcfx/SOA/CheckRetailPlatform/2016-07-04" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://xmlns.now.com/CheckRetailPlatform/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns3:checkNPRequest&gt;&lt;parameters&gt;&lt;tns3:checkNPRequest&gt;&lt;request&gt;&lt;DATA_RICHIESTA&gt;&lt;xsl:value-of select="$Start/tns1:Richiesta/tns:DataRichiesta"/&gt;&lt;/DATA_RICHIESTA&gt;&lt;CODICE_OLO&gt;&lt;xsl:value-of select="$Start/tns1:Richiesta/tns:CodiceOLO"/&gt;&lt;/CODICE_OLO&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$Start/tns1:Richiesta/tns:IdRisorsa"/&gt;&lt;/ID_RISORSA&gt;&lt;IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="$Start/tns1:Testata/tns:IdEsecProcsoNoFile"/&gt;&lt;/IdEsecProcsoNoFile&gt;&lt;/request&gt;&lt;/tns3:checkNPRequest&gt;&lt;/parameters&gt;&lt;/tns3:checkNPRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475570713382&quot; xmlns:tns2=&quot;http://dbcfx/SOA/CheckRetailPlatform&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:sm=&quot;http://dbcfx/SOA/CheckRetailPlatform/2016-07-04&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:checkNPRequest>&#xa;            &lt;request>&#xa;                &lt;DATA_RICHIESTA>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/tns:DataRichiesta&quot;/>&#xa;                &lt;/DATA_RICHIESTA>&#xa;                &lt;CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/tns:CodiceOLO&quot;/>&#xa;                &lt;/CODICE_OLO>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/tns:IdRisorsa&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;                &lt;IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/IdEsecProcsoNoFile>&#xa;            &lt;/request>&#xa;        &lt;/tns3:checkNPRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
