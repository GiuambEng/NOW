            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b1e5459-e393-4f5a-84d3-e5df16efd1b8+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCriteriRolloutIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:Richiesta&quot;/>&#xa;            &lt;/Richiesta>&#xa;            &lt;Servizio>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:Servizio&quot;/>&#xa;            &lt;/Servizio>&#xa;            &lt;CodOlo>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:CodiceOLO&quot;/>&#xa;            &lt;/CodOlo>&#xa;            &lt;CodIsp>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:CodiceISP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:CodiceISP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodIsp>&#xa;            &lt;DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime($VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&#xa;            &lt;/DataRichiesta>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQuery-input" name="JDBCQuery"
                    outputVariable="JDBCQuery"
                    tibex:xpdlId="8b1e5459-e393-4f5a-84d3-e5df16efd1b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCopy_1_EndLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b1e5459-e393-4f5a-84d3-e5df16efd1b8+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCriteriRolloutIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn.parameters/tns:Richiesta&quot;/>&#xa;            &lt;/Richiesta>&#xa;            &lt;Servizio>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn.parameters/tns:Servizio&quot;/>&#xa;            &lt;/Servizio>&#xa;            &lt;CodOlo>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn.parameters/tns:CodiceOLO&quot;/>&#xa;            &lt;/CodOlo>&#xa;            &lt;CodIsp>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCriteriRolloutIn.parameters/tns:CodiceISP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCriteriRolloutIn.parameters/tns:CodiceISP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodIsp>&#xa;            &lt;DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime($VerificaCriteriRolloutIn.parameters/tns:DataRichiesta, &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&#xa;            &lt;/DataRichiesta>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select l.tipolg_lavrz as Richiesta, o.nome_offerta_esterna as Servizio, r.COD_OLO as Cod_Olo, r.COD_ISP as Cod_Isp, r.COD_ISTAT_COMUNE as Comune,  r.datainz as Data_Inizio, r.datafi as Data_Fine, s.DESCR_SISTEMA_NOME_SISTEMA as Sistema_Di_Competenza, NVL(r.CONTA_ORDN,0) as NVLRCONTAORDN0, NVL(r.VOLUMI_IN_NOW,0) as NVLRVOLUMIINNOW0 &#xd;&#xa;from LOCZRE_CRITR_ROLLT r, TIPOLG_LAVRZ l, TRASCODFC_OFFERTA o, SISTEMA s&#xd;&#xa;WHERE r.idtplg_lavrz = l.idtplg_lavrz&#xd;&#xa;and r.id_sistema = s.id_sistema&#xd;&#xa;and r.ID_TRASCODFC_OFFERTA =o.id_trascodfc_offerta&#xd;&#xa;and o.provenienza = 'XML'&#xd;&#xa;and upper(l.tipolg_lavrz) in (?,'ALL') --'RICHIESTA'&#xd;&#xa;and upper(o.nome_offerta_esterna) in (?,'ALL')--'SERVIZIO' &#xd;&#xa;and (r.COD_OLO in (?,'*') or (r.COD_ISP = ? and r.COD_ISP is not null))&#xd;&#xa;and To_Date(?,'yyyymmdd-hh24miss') between r.datainz and r.datafi --DATA RICHIESTA" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Richiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOlo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodIsp"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DataRichiesta"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="RICHIESTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="SERVIZIO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="COD_ISP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="DATA_INIZIO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="DATA_FINE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="SISTEMA_DI_COMPETENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="NVLRCONTAORDN0"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="10"
                                    columnName="NVLRVOLUMIINNOW0"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Query-input"
                    name="Query"
                    tibex:xpdlId="1ff3922e-2f48-4bdd-8b99-eccd9f1863f5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToCopy_1_EndLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_EndLogToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Query-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Subprocess &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot; - Query= &amp;quot;, tib:render-xml($JDBCQuery))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
