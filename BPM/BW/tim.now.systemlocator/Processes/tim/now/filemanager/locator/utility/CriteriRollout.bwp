                        <element maxOccurs="1" minOccurs="1"
                            name="CodOlo" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="CodIsp" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DataRichiesta" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="maxRows" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b1e5459-e393-4f5a-84d3-e5df16efd1b8+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b1e5459-e393-4f5a-84d3-e5df16efd1b8+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="RICHIESTA" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="SERVIZIO" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="COD_OLO" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="COD_ISP" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="COMUNE" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DATA_INIZIO" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DATA_FINE" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="SISTEMA_DI_COMPETENZA" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="NVLRCONTAORDN0"
                                    nillable="false" type="int"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="NVLRVOLUMIINNOW0"
                                    nillable="false" type="int"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
