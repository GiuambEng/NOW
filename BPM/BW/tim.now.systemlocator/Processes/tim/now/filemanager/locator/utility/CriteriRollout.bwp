            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;VerificaCriteriRolloutIn&quot;/>&lt;xsl:template name=&quot;v_RispostaVerificaCriteriRollout&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:CodiceComune)>0&quot;>&lt;tns:RispostaVerificaCriteriRollOut>&lt;xsl:for-each select=&quot;$JDBCQuery/Record[COMUNE='*' or COMUNE=$VerificaCriteriRolloutIn/parameters/tns:RichiestaVerificaCriteriRollOut/tns:CodiceComune][1]&quot;>&lt;tns:RecordCriteriRollOut>&lt;tns:DataInizio>&lt;xsl:value-of select=&quot;DATA_INIZIO&quot;/>&lt;/tns:DataInizio>&lt;tns:DataFine>&lt;xsl:value-of select=&quot;DATA_FINE&quot;/>&lt;/tns:DataFine>&lt;tns:Richiesta>&lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&lt;/tns:Richiesta>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;COD_ISP&quot;/>&lt;/tns:CodiceISP>&lt;tns:CodiceComune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and (COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and not(COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;SISTEMA_DI_COMPETENZA&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RecordCriteriRollOut>&lt;/xsl:for-each>&lt;/tns:RispostaVerificaCriteriRollOut>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RispostaVerificaCriteriRollOut>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:RecordCriteriRollOut>&lt;tns:DataInizio>&lt;xsl:value-of select=&quot;DATA_INIZIO&quot;/>&lt;/tns:DataInizio>&lt;tns:DataFine>&lt;xsl:value-of select=&quot;DATA_FINE&quot;/>&lt;/tns:DataFine>&lt;tns:Richiesta>&lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&lt;/tns:Richiesta>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&lt;/tns:Servizio>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;COD_ISP&quot;/>&lt;/tns:CodiceISP>&lt;tns:CodiceComune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and (COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and not(COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;SISTEMA_DI_COMPETENZA&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RecordCriteriRollOut>&lt;/xsl:for-each>&lt;/tns:RispostaVerificaCriteriRollOut>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
