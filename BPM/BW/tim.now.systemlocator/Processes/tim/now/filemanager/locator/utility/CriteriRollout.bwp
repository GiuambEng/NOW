:value-of select=&quot;COD_ISP&quot;/>&#xa;                            &lt;/tns:CodiceISP>&#xa;                            &lt;tns:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                            &lt;/tns:CodiceComune>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and (COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and not(COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;SISTEMA_DI_COMPETENZA&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:RecordCriteriRollOut>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:RispostaVerificaCriteriRollOut>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:RispostaVerificaCriteriRollOut>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&#xa;                        &lt;tns:RecordCriteriRollOut>&#xa;                            &lt;tns:DataInizio>&#xa;                                &lt;xsl:value-of select=&quot;DATA_INIZIO&quot;/>&#xa;                            &lt;/tns:DataInizio>&#xa;                            &lt;tns:DataFine>&#xa;                                &lt;xsl:value-of select=&quot;DATA_FINE&quot;/>&#xa;                            &lt;/tns:DataFine>&#xa;                            &lt;tns:Richiesta>&#xa;                                &lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&#xa;                            &lt;/tns:Richiesta>&#xa;                            &lt;tns:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;SERVIZIO&quot;/>&#xa;                            &lt;/tns:Servizio>&#xa;                            &lt;tns:CodiceOLO>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                            &lt;/tns:CodiceOLO>&#xa;                            &lt;tns:CodiceISP>&#xa;                                &lt;xsl:value-of select=&quot;COD_ISP&quot;/>&#xa;                            &lt;/tns:CodiceISP>&#xa;                            &lt;tns:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                            &lt;/tns:CodiceComune>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and (COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;xsd:int(NVLRCONTAORDN0)>=xsd:int(NVLRVOLUMIINNOW0) and not(COD_OLO=&amp;quot;TLC&amp;quot; or COD_ISP=&amp;quot;002&amp;quot;)&quot;>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SistemaDiCompetenza>&#xa;                                        &lt;xsl:value-of select=&quot;SISTEMA_DI_COMPETENZA&quot;/>&#xa;                                    &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:RecordCriteriRollOut>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:RispostaVerificaCriteriRollOut>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
