                                tibex:group="groupStart" tibex:xpdlId="b492222a-7b43-43e5-988b-c8c47fd650e0">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="5f01b25b-22a9-4992-b5a1-e90eeaab9b31">
                                <bpws:targets>
                                    <bpws:target linkName="Log1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns1=&quot;http://tim.now.com/TC1noTIM&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:template name=&quot;TC1noTIM-input&quot; match=&quot;/&quot;>&lt;tns1:INPUT>&lt;tns2:RichiestaLocalizzatore>&lt;tns2:Testata>&lt;tns2:Transaction_id>&lt;xsl:value-of select=&quot;$Start/tns:TransactionId&quot;/>&lt;/tns2:Transaction_id>&lt;tns2:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:Transaction_date>&lt;tns2:Sistema_origine>&lt;xsl:value-of select=&quot;$Start/tns:SistemaOrigine&quot;/>&lt;/tns2:Sistema_origine>&lt;xsl:if test=&quot;$Start/tns:IdEsecProcsoNoFile&quot;>&lt;tns2:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns2:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;/tns2:Testata>&lt;tns2:Richiesta>&lt;tns2:DataRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:DataRichiesta&quot;/>&lt;/tns2:DataRichiesta>&lt;xsl:if test=&quot;$Start/tns:OLOrecipient&quot;>&lt;tns2:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/tns:OLOrecipient&quot;/>&lt;/tns2:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:CodiceComune&quot;>&lt;tns2:CodiceComune>&lt;xsl:value-of select=&quot;$Start/tns:CodiceComune&quot;/>&lt;/tns2:CodiceComune>&lt;/xsl:if>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;$Start/tns:Servizio&quot;/>&lt;/tns2:Servizio>&lt;tns2:Richiesta>&lt;xsl:value-of select=&quot;$Start/tns:Richiesta&quot;/>&lt;/tns2:Richiesta>&lt;tns2:IdRisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns2:IdRisorsa>&lt;/tns2:Richiesta>&lt;/tns2:RichiestaLocalizzatore>&lt;tns1:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns1:Distretto>&lt;xsl:copy-of select=&quot;$Start/tns3:Esiti&quot;/>&lt;/tns1:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="TC1noTIM-input"
                                    name="TC1noTIM"
                                    outputVariable="TC1noTIM"
                                    tibex:xpdlId="457827f2-034c-4039-bb95-ae401e000e69"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TC1noTIMToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns1=&quot;http://tim.now.com/TC1noTIM&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:template name=&quot;TC1noTIM-input&quot; match=&quot;/&quot;>&lt;tns1:INPUT>&lt;tns2:RichiestaLocalizzatore>&lt;tns2:Testata>&lt;tns2:Transaction_id>&lt;xsl:value-of select=&quot;$Start/tns:TransactionId&quot;/>&lt;/tns2:Transaction_id>&lt;tns2:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:Transaction_date>&lt;tns2:Sistema_origine>&lt;xsl:value-of select=&quot;$Start/tns:SistemaOrigine&quot;/>&lt;/tns2:Sistema_origine>&lt;xsl:if test=&quot;$Start/tns:IdEsecProcsoNoFile&quot;>&lt;tns2:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns2:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;/tns2:Testata>&lt;tns2:Richiesta>&lt;tns2:DataRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:DataRichiesta&quot;/>&lt;/tns2:DataRichiesta>&lt;xsl:if test=&quot;$Start/tns:OLOrecipient&quot;>&lt;tns2:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/tns:OLOrecipient&quot;/>&lt;/tns2:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:CodiceComune&quot;>&lt;tns2:CodiceComune>&lt;xsl:value-of select=&quot;$Start/tns:CodiceComune&quot;/>&lt;/tns2:CodiceComune>&lt;/xsl:if>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;$Start/tns:Servizio&quot;/>&lt;/tns2:Servizio>&lt;tns2:Richiesta>&lt;xsl:value-of select=&quot;$Start/tns:Richiesta&quot;/>&lt;/tns2:Richiesta>&lt;tns2:IdRisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns2:IdRisorsa>&lt;/tns2:Richiesta>&lt;/tns2:RichiestaLocalizzatore>&lt;tns1:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns1:Distretto>&lt;xsl:copy-of select=&quot;$Start/tns3:Esiti&quot;/>&lt;/tns1:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.locator.scenari.TC1noTIM" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (substring($Risorsa, 2, 1)='2' or (substring($Risorsa, 2, 1)='6')) then(substring($Risorsa, 1, 2))&#xd;&#xa;else (if (substring($Risorsa, 3, 1)='0' or &#xd;&#xa;(substring($Risorsa, 3, 1)='1')or (substring($Risorsa, 3, 1)='5')or&#xd;&#xa;(substring($Risorsa, 3, 1)='9')) then (substring($Risorsa, 1, 3)) else (substring($Risorsa, 1, 4)))"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Distretto"
