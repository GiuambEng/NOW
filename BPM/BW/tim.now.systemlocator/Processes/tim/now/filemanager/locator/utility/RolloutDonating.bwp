            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;CriteriRollout&quot;/>&lt;xsl:template name=&quot;LogRollout-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Record estratti dai criteri di rollout: &amp;quot;,tib:render-xml($CriteriRollout/parameters/tns1:RispostaVerificaCriteriRollOut,true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogRollout-input" name="LogRollout"
                    tibex:xpdlId="455b6838-3074-46ca-b951-f2b32cadd659" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CriteriRolloutToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRolloutToAssign">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CriteriRollout.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRollout-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Record estratti dai criteri di rollout: &amp;quot;,tib:render-xml($CriteriRollout.parameters,true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(exists($CriteriRollout/parameters/tns:RispostaVerificaCriteriRollOut/tns:RecordCriteriRollOut[tns:SistemaDiCompetenza=&quot;NOW&quot; and (tns:CodiceComune=$Start/ns2:CodiceComune or tns:CodiceComune=&quot;*&quot; or tns:CodiceComune=$RecuperaComune/ns4:CodiceISTATcomune)]) and $Start/ns2:CodOLO!=&quot;TLC&quot;) then &quot;NOW&quot; else if($CheckRetailPlatform/parameters/ns5:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&quot;00&quot;) then &quot;CRMWS&quot;&#xd;&#xa;else if($CheckRetailPlatform/parameters/ns5:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&quot;03&quot;) then &quot;NOW&quot;&#xd;&#xa;else &quot;NOW&quot;"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="SistemaDiCompetenza"
                    name="AssignOther"
                    outputVariable="SistemaDiCompetenza"
                    tibex:xpdlId="a9855a68-0b02-416e-a825-9b86e9014ba9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRolloutToAssign"/>
                        <bpws:target linkName="LogRetailToAssignOther"/>
                        <bpws:target linkName="LogAlfanunToAssignOther"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignOtherToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$SistemaDiCompetenza='CRMWS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$SistemaDiCompetenza='CRMWS']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignOtherToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(exists($CriteriRollout.parameters/tns:RecordCriteriRollOut[tns:SistemaDiCompetenza=&quot;NOW&quot; and (tns:CodiceComune=$Start/ns2:CodiceComune or tns:CodiceComune=&quot;*&quot; or tns:CodiceComune=$RecuperaComune/ns4:CodiceISTATcomune)]) and $Start/ns2:CodOLO!=&quot;TLC&quot;) then &quot;NOW&quot; else if($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&quot;00&quot;) then &quot;CRMWS&quot;&#xd;&#xa;else if($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&quot;03&quot;) then &quot;NOW&quot;&#xd;&#xa;else &quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
