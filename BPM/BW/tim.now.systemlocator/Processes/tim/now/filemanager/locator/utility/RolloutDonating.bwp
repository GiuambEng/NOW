            </bpws:extensionActivity>
            <bpws:invoke inputVariable="CheckRetailPlatform-input"
                name="CheckRetailPlatform" operation="checkNP"
                outputVariable="CheckRetailPlatform"
                partnerLink="CheckRetailPlatformPT"
                portType="ns5:CheckRetailPlatformPT" tibex:xpdlId="0664e7bf-9604-4d37-b7d4-3dd835c32579">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/RolloutDonating" xmlns:tns1="http://xmlns.now.com/CheckRetailPlatform/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="CheckRetailPlatform-input" match="/"&gt;&lt;tns1:checkNPRequest&gt;&lt;parameters&gt;&lt;tns1:checkNPRequest&gt;&lt;request&gt;&lt;DATA_RICHIESTA&gt;&lt;xsl:value-of select="$Start/tns:DataRichiesta"/&gt;&lt;/DATA_RICHIESTA&gt;&lt;CODICE_OLO&gt;&lt;xsl:value-of select="$Start/tns:CodOLO"/&gt;&lt;/CODICE_OLO&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$Start/tns:Risorsa"/&gt;&lt;/ID_RISORSA&gt;&lt;IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="$Start/tns:IdEsecProcsoNoFile"/&gt;&lt;/IdEsecProcsoNoFile&gt;&lt;/request&gt;&lt;/tns1:checkNPRequest&gt;&lt;/parameters&gt;&lt;/tns1:checkNPRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns1=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckRetailPlatform-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:checkNPRequest>&#xa;            &lt;request>&#xa;                &lt;DATA_RICHIESTA>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:DataRichiesta&quot;/>&#xa;                &lt;/DATA_RICHIESTA>&#xa;                &lt;CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:CodOLO&quot;/>&#xa;                &lt;/CODICE_OLO>&#xa;                &lt;ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&#xa;                &lt;/ID_RISORSA>&#xa;                &lt;IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/IdEsecProcsoNoFile>&#xa;            &lt;/request>&#xa;        &lt;/tns1:checkNPRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToCheckRetailPlatform"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToWhile">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:scope name="While" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="fa6be2c4-8e3a-4d26-98d1-6154238fa2d2">
                <bpws:targets>
                    <bpws:target linkName="LogToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
