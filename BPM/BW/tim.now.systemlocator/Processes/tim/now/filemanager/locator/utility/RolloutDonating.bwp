                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns1=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:IDrisorsa>&lt;xsl:value-of select=&quot;$Start/tns:Risorsa&quot;/>&lt;/tns1:IDrisorsa>&lt;tns1:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$Start/tns:CodOLO&quot;/>&lt;/tns1:CodificaOLOagcom>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RecuperaComune-input"
