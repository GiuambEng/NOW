                outputVariable="CriteriRollout"
                partnerLink="CriteriRollout"
                portType="ns1:CriteriRollout" tibex:xpdlId="e8e8d73c-23cf-40cc-a29c-3c5c70d78449">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns1="http://www.tim.com/NOW/xsd/CriteriRollOut" xmlns:tns2="http://www.tim.com/NOW/xsd/RolloutDonating" xmlns:tns3="http://www.example.org/RecuperoComune" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="RecuperaComune"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Start/tns2:CodiceComune)&gt;0"&gt;&lt;tns1:RichiestaVerificaCriteriRollOut&gt;&lt;tns1:Richiesta&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta"/&gt;&lt;/tns1:Richiesta&gt;&lt;tns1:Servizio&gt;&lt;xsl:value-of select="$Start/tns2:Servizio"/&gt;&lt;/tns1:Servizio&gt;&lt;tns1:DataRichiesta&gt;&lt;xsl:value-of select="$Start/tns2:DataRichiesta"/&gt;&lt;/tns1:DataRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$Start/tns2:CodOLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;xsl:if test="$Start/tns2:CodiceComune"&gt;&lt;tns1:CodiceComune&gt;&lt;xsl:value-of select="$Start/tns2:CodiceComune"/&gt;&lt;/tns1:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns1:RichiestaVerificaCriteriRollOut&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:RichiestaVerificaCriteriRollOut&gt;&lt;tns1:Richiesta&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta"/&gt;&lt;/tns1:Richiesta&gt;&lt;tns1:Servizio&gt;&lt;xsl:value-of select="$Start/tns2:Servizio"/&gt;&lt;/tns1:Servizio&gt;&lt;tns1:DataRichiesta&gt;&lt;xsl:value-of select="$Start/tns2:DataRichiesta"/&gt;&lt;/tns1:DataRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$Start/tns2:CodOLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;xsl:if test="$RecuperaComune/tns3:CodiceISTATcomune"&gt;&lt;tns1:CodiceComune&gt;&lt;xsl:value-of select="$RecuperaComune/tns3:CodiceISTATcomune"/&gt;&lt;/tns1:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns1:RichiestaVerificaCriteriRollOut&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaComune&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($Start/tns2:CodiceComune)>0&quot;>&#xa;                &lt;tns1:RichiestaVerificaCriteriRollOut>&#xa;                    &lt;tns1:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta&quot;/>&#xa;                    &lt;/tns1:Richiesta>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                    &lt;tns1:DataRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:DataRichiesta&quot;/>&#xa;                    &lt;/tns1:DataRichiesta>&#xa;                    &lt;tns1:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodOLO&quot;/>&#xa;                    &lt;/tns1:CodiceOLO>&#xa;                    &lt;xsl:if test=&quot;$Start/tns2:CodiceComune&quot;>&#xa;                        &lt;tns1:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:CodiceComune&quot;/>&#xa;                        &lt;/tns1:CodiceComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:RichiestaVerificaCriteriRollOut>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:RichiestaVerificaCriteriRollOut>&#xa;                    &lt;tns1:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta&quot;/>&#xa;                    &lt;/tns1:Richiesta>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                    &lt;tns1:DataRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:DataRichiesta&quot;/>&#xa;                    &lt;/tns1:DataRichiesta>&#xa;                    &lt;tns1:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodOLO&quot;/>&#xa;                    &lt;/tns1:CodiceOLO>&#xa;                    &lt;xsl:if test=&quot;$RecuperaComune/tns3:CodiceISTATcomune&quot;>&#xa;                        &lt;tns1:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaComune/tns3:CodiceISTATcomune&quot;/>&#xa;                        &lt;/tns1:CodiceComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:RichiestaVerificaCriteriRollOut>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToInvoke"/>
                    <bpws:target linkName="Empty1ToCriteriRollout"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CriteriRolloutToLog"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input Rollout Donating: &amp;quot;, tib:render-xml($Start,true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInput-input" name="LogInput"
                    tibex:xpdlId="c8e39046-a05c-4043-bbda-765b9dfa3986" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns2:CodOLO!=&quot;TLC&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns2:CodOLO!="TLC"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input Rollout Donating: &amp;quot;, tib:render-xml($Start,true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
