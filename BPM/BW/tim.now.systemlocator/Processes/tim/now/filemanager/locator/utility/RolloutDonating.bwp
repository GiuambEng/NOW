            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:CriteriRollout"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp2:CheckRetailPlatformPT"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/"/>
            <wsdl:import namespace="http://xmlns.now.com/CheckRetailPlatform/"/>
        </wsdl:definitions>
    </tibex:Types>
