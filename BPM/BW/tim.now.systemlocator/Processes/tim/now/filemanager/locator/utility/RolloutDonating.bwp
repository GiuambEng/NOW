                                <bpws:link name="Log1ToAssignSistema" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignSistemaToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log1ToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign1ToAssignSistema" tibex:linkType="SUCCESS"/>
                                <bpws:link name="TC1noTIMToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
