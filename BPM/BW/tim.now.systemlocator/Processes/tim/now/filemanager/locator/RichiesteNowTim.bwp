                                expression="$GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:Richiesta='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
