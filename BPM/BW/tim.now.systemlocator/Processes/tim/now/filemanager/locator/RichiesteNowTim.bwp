                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="VerificaCriteriRolloutCessazione-input"
                name="VerificaCriteriRolloutCessazione"
                operation="VerificaCriteriRollout"
                outputVariable="VerificaCriteriRolloutCessazione"
