            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Ambito/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;VerificaAmbito&quot;/>&lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;xsl:choose>&#xa;                            &lt;!--ATTIVAZIONE o CESSAZIONE, controllo Ambito in RT,DT-->&lt;xsl:when test=&quot;($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='ATTIVAZIONE' or $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='CESSAZIONE' or $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='VARIAZIONE' or $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='MIGRAZIONE') and exists($VerificaAmbito/parameters/tns2:RispostaVerificaAmbito/tns2:RecordsRichiestaInAmbito/tns2:RecordRichiestaInAmbito[tns2:Ambito='RT' or tns2:Ambito='DT'])&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'OK farlok, in ambito'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&#xa;                                                                    &lt;!-- Altre richieste, NON controllo Ambito in RT,DT-->&lt;xsl:when test=&quot;($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='ATTIVAZIONE' and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='CESSAZIONE' and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='VARIAZIONE' and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='MIGRAZIONE' ) and count($VerificaAmbito/parameters/tns2:RispostaVerificaAmbito/tns2:RecordsRichiestaInAmbito/tns2:RecordRichiestaInAmbito)>0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'OK farlok, in ambito'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'09'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Richiesta/Servizio non in ambito NOW'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="V_RispostaLocalizzatore"
                    name="EsitoAmbito"
                    outputVariable="V_RispostaLocalizzatore"
                    tibex:xpdlId="c4c64eb9-9a82-49b2-9562-3f3c341dd235" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaAmbitoToCheckAmbito"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckAmbitoToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$V_RispostaLocalizzatore/ns3:Risposta/ns3:SistemaDiCompetenza='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$V_RispostaLocalizzatore/ns3:Risposta/ns3:SistemaDiCompetenza='KO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckAmbitoToEmpty2_OK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Ambito/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaAmbito.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;!--ATTIVAZIONE o CESSAZIONE, controllo Ambito in RT,DT-->&#xa;                &lt;xsl:when test=&quot;($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='ATTIVAZIONE' or $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='CESSAZIONE' or $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='VARIAZIONE' or $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='MIGRAZIONE') and exists($VerificaAmbito.parameters/tns2:RecordsRichiestaInAmbito/tns2:RecordRichiestaInAmbito[tns2:Ambito='RT' or tns2:Ambito='DT'])&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'OK farlok, in ambito'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;!-- Altre richieste, NON controllo Ambito in RT,DT-->&#xa;                &lt;xsl:when test=&quot;($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='ATTIVAZIONE' and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='CESSAZIONE' and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='VARIAZIONE' and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta!='MIGRAZIONE' ) and count($VerificaAmbito.parameters/tns2:RecordsRichiestaInAmbito/tns2:RecordRichiestaInAmbito)>0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'OK farlok, in ambito'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'09'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Richiesta/Servizio non in ambito NOW'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="V_RispostaLocalizzatore" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="VerificaAmbito-input"
                name="VerificaAmbito" operation="VerificaAmbito"
                outputVariable="VerificaAmbito"
                partnerLink="VerificaAmbito" portType="ns22:Ambito" tibex:xpdlId="18562111-10cf-4c23-b411-79cf2b4d315c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/Ambito/" xmlns:tns1="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns2="http://www.tim.com/NOW/xsd/Ambito/" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:template name="VerificaAmbito-input" match="/"&gt;&lt;tns:VerificaAmbitoRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaAmbito&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio"&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;/xsl:if&gt;&lt;/tns2:RichiestaVerificaAmbito&gt;&lt;/parameters&gt;&lt;/tns:VerificaAmbitoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/Ambito/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Ambito/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaAmbito-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaAmbito>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio&quot;>&#xa;                &lt;tns2:Servizio>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio&quot;/>&#xa;                &lt;/tns2:Servizio>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:RichiestaVerificaAmbito>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ControlloInputToVerificaAmbito_OK"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="VerificaAmbitoToCheckAmbito"/>
                </bpws:sources>
            </bpws:invoke>
