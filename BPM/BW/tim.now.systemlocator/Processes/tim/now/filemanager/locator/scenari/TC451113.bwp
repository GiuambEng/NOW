                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AMBITO, TIPOCOMUNICAZIONENP FROM BDS_1_CASEDATA_RICHIESTA WHERE CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE=? UNION SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM=? UNION SELECT O.CODFC_OLO_AGCOM_ASSET FROM OLO_NORMALIZZATO O WHERE O.CODFC_OLO_AGCOM_RICH=?) AND CODICEORDINEOLO=? &#xd;&#xa;AND NUMEROTELEFONICO=? AND TIPORICHIESTA='ORDINE'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOlo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOrdineOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NumeroTelefonico"/>
                                    <columnMetadata
                                    columnName="AMBITO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOCOMUNICAZIONENP"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
