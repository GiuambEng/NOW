            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475570713382&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Risposta_Localizzatore&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;tns:Testata>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;tns:Sistema_origine>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns:Sistema_origine&quot;/>&lt;/tns:Sistema_origine>&lt;xsl:if test=&quot;$Start/tns1:Testata/tns:IdEsecProcsoNoFile&quot;>&lt;tns:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns1:Testata/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;/tns:Testata>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tns:Richiesta=&amp;quot;TIPO_COMUNICAZIONE_7&amp;quot; and not(exists($JDBCQuery/Record[TIPOCOMUNICAZIONENP=&amp;quot;PRENOTIFICADONATING&amp;quot;]))&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;DBCFX&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/AMBITO&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/AMBITO!=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Richiesta target non in ambito NOW&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:if>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tns:Richiesta=&amp;quot;TIPO_COMUNICAZIONE_7&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;DBCFX&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Richiesta target assente&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
