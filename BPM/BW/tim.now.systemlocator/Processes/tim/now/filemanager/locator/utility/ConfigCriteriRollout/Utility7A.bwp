                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_NP (DATAINZ, DATAFI, COD_OLO, COD_ISP, DISTR, ID_SISTEMA, VOLUMI_IN_NOW)&#xa;    SELECT (SELECT TO_DATE(SYSDATE) FROM DUAL), TO_DATE('31-12-2999','dd-mm-yyyy'), OLO.CODFC_OLO_AGCOM, OLO.COD_OLO, ?, SIS.ID_SISTEMA, ?&#xa;    FROM APPUSER.OLO OLO, APPUSER.SISTEMA SIS&#xa;    WHERE OLO.CODFC_OLO_AGCOM = ? AND SIS.DESCR_SISTEMA_NOME_SISTEMA = 'NOW'" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Distretto"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOLO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
