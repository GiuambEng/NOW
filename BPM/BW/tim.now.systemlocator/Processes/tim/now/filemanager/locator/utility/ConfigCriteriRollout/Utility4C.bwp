    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="FilePollerToParseData" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToParseData" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseDataToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToRenameFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenameFileToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="FilePoller"
                    tibex:xpdlId="c1c1d87f-07d7-4587-8ed7-6d778848a68b"
                    variable="FilePoller" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="FilePollerToParseData"/>
                    </bpws:sources>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.file.poller"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="fileName" processProperty="PathUtility4C"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//FilePoller"/>
                                    <value contentAs="text"
                                    createEvent="true"
                                    includeCurrent="true"
                                    includeSubDirectories="true"
                                    mode="files-and-directories"
                                    modifyEvent="true"
                                    pollInterval="5"
                                    sortby="File Name"
                                    sortorder="descending" xsi:type="file:FilePoller"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ParseData-input"
                    name="ParseData" outputVariable="ParseData"
                    tibex:xpdlId="a543a42b-fb11-4fa1-9a2a-5a8c3ee0966a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToParseData"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ParseDataToLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+a543a42b-fb11-4fa1-9a2a-5a8c3ee0966a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:template name=&quot;ParseData-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;text>&lt;xsl:value-of select=&quot;$FilePoller/fileContent/textContent&quot;/>&lt;/text>&lt;noOfRecords>&lt;xsl:value-of select=&quot;-1&quot;/>&lt;/noOfRecords>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.parse.parsedata"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value continueOnError="true"
                                    dataFormat="dataFormatResourceProperty1"
                                    encoding="ASCII"
                                    inputType="String" xsi:type="parse:ParseData"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e2455db2-116f-4cfd-9e54-a25256ad05f9">
                <bpws:targets>
                    <bpws:target linkName="Log1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRenameFile"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($ParseData/Rows/dataformat4:root)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ParseData/Rows/dataformat4:root)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStartToWriteFile1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="WriteFile1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log3ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log5ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToJDBCQuery2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCQuery1ToWriteFile2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQuery2ToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCUpdateToLog2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateToLog3" tibex:linkType="ERROR"/>
                                <bpws:link name="Log2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery2ToWriteFile2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="WriteFile2ToLog4" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log4ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateToLogUpdateSysdate" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateToLogErrorUpdate" tibex:linkType="ERROR"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="fec92afe-b17f-460a-9e18-694c74ff00fa">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ParseData/Rows/dataformat4:root[number($index)]/Byte=$byte" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ParseData/Rows/dataformat4:root[number($index)]/Byte=$byte]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToWriteFile1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f6b79948-c5bd-430d-b1bc-9ba95f7263d1">
                                <bpws:targets>
                                    <bpws:target linkName="Log3ToGroupEnd"/>
                                    <bpws:target linkName="Log5ToGroupEnd"/>
                                    <bpws:target linkName="Log2ToGroupEnd"/>
                                    <bpws:target linkName="Log4ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="WriteBADFileErrCessaz-input"
                                    name="WriteBADFileErrCessaz"
                                    outputVariable="WriteBADFileErrCessaz"
                                    tibex:xpdlId="01f629e2-069a-47b4-82ab-da1f53bdf52a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToWriteFile1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="WriteFile1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:dataformat3=&quot;http://ns.tibco.com/bw/palette/dataformat/00cddf79-0e0a-4d81-8fe4-afcd4ce7b5ac&quot; xmlns:dataformat4=&quot;http://ns.tibco.com/bw/palette/dataformat/061145e0-00d8-4cd6-97f1-bfdc2991edd1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BADSuf&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;WriteFile1-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat($FilePoller/fileInfo/fullName, $BADSuf)&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;concat($ParseData/Rows/dataformat4:root[number($index)]/CodOLO, &amp;quot; ; Tipo Record Cessazione errato&amp;quot;)&quot;/>&lt;/textContent>&lt;addLineSeparator>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/addLineSeparator>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.write"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value append="true"
                                    compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCUpdateSysdate-input"
                                    name="JDBCUpdateSysdate"
                                    outputVariable="JDBCUpdateSysdate"
                                    tibex:xpdlId="5701d05a-5c6f-4385-b55c-593953ddf924" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery2ToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToLog2"/>
                                    <bpws:source
                                    linkName="JDBCUpdateToLog3"
                                    tibex:faultDetailsVar="JDBCUpdateSysdate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5701d05a-5c6f-4385-b55c-593953ddf924+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:dataformat=&quot;http://ns.tibco.com/bw/palette/dataformat/061145e0-00d8-4cd6-97f1-bfdc2991edd1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;JDBCUpdateSysdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CodOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodOLO>&lt;CodCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodCOM)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodCOM>&lt;CodiceCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodCOM)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceCOM>&lt;Servizio>&lt;xsl:value-of select=&quot;upper-case($ParseData/Rows/dataformat:root[number($index)]/Servizio)&quot;/>&lt;/Servizio>&lt;Lavorazione>&lt;xsl:value-of select=&quot;upper-case($ParseData/Rows/dataformat:root[number($index)]/Lavorazione)&quot;/>&lt;/Lavorazione>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.LOCZRE_CRITR_ROLLT&#xa;  SET DATAFI = (SELECT TO_DATE(SYSDATE) FROM DUAL)&#xa;  WHERE COD_OLO = ? AND (COD_ISTAT_COMUNE = ? OR '*'=?) &#xa;  AND ID_TRASCODFC_OFFERTA IN (SELECT TRASC.ID_TRASCODFC_OFFERTA&#xa;                          FROM APPUSER.TRASCODFC_OFFERTA TRASC&#xa;                          WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML')&#xa;  AND IDTPLG_LAVRZ IN (SELECT TL.IDTPLG_LAVRZ FROM TIPOLG_LAVRZ TL WHERE UPPER(TL.TIPOLG_LAVRZ) = ?)&#xa;  AND DATAFI = TO_DATE('31-12-2999','dd-mm-yyyy')" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="LogErrorUpdate-input"
                                    name="LogErrorUpdate"
                                    tibex:xpdlId="d8caf154-f719-44c3-bb6e-b432d5209ae0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToLog3"/>
                                    <bpws:target linkName="JDBCUpdateToLogErrorUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log3ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogErrorUpdate-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Dati non inseriti dati sul DB&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
