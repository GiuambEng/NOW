                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT *&#xa;    FROM APPUSER.LOCZRE_AMBITO LA,&#xa;         APPUSER.TRASCODFC_OFFERTA TRA&#xa;    WHERE LA.ID_TRASCODFC_OFFERTA = TRA.ID_TRASCODFC_OFFERTA&#xa;    AND TRA.PROVENIENZA = 'XML'&#xa;&#x9;AND LA.ID_TRASCODFC_OFFERTA IN (SELECT TOE.ID_TRASCODFC_OFFERTA FROM TRASCODFC_OFFERTA TOE WHERE UPPER(TOE.NOME_OFFERTA_ESTERNA) = ? AND TOE.PROVENIENZA = 'XML')&#xa;&#x9;AND LA.IDTPLG_LAVRZ IN (SELECT TL.IDTPLG_LAVRZ FROM TIPOLG_LAVRZ TL WHERE UPPER(TL.TIPOLG_LAVRZ) = ?)" xsi:type="jdbcPalette:JDBCQueryActivity">

