                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT (DATAINZ, DATAFI, IDTPLG_LAVRZ,&#xa;  ID_TRASCODFC_OFFERTA, COD_OLO, COD_ISP, COD_ISTAT_COMUNE, ID_SISTEMA, VOLUMI_IN_NOW)&#xa;  SELECT (SELECT TO_DATE(SYSDATE)&#xa;          FROM DUAL), TO_DATE('31-12-2999','dd-mm-yyyy'), LA.IDTPLG_LAVRZ, LA.ID_TRASCODFC_OFFERTA,&#xa;  ?, ?, ?, SYS.ID_SISTEMA, ?&#xa;    FROM APPUSER.LOCZRE_AMBITO LA, APPUSER.SISTEMA SYS,&#xa;         APPUSER.TRASCODFC_OFFERTA TRA&#xa;    WHERE SYS.DESCR_SISTEMA_NOME_SISTEMA = 'NOW'&#xa;    AND LA.ID_TRASCODFC_OFFERTA = TRA.ID_TRASCODFC_OFFERTA&#xa;    AND TRA.PROVENIENZA = 'XML' AND UPPER(TRA.NOME_OFFERTA_ESTERNA) = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

