                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCUpdate5-input"
                                    name="JDBCUpdate5"
                                    outputVariable="JDBCUpdate5"
                                    tibex:xpdlId="4b48e3c0-3a6b-47a5-800e-4e387a9bdda7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateServizioAlternativoToJDBCUpdate5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdate5ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DataFormatSchemaUtility3A&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4b48e3c0-3a6b-47a5-800e-4e387a9bdda7+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:param name=&quot;JDBCQueryVerificaOLO&quot;/>&lt;xsl:template name=&quot;JDBCUpdate5-input&quot; match=&quot;/&quot;>&lt;ns1:jdbcUpdateActivityInput>&lt;CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/tns1:root[number($index)]/tns1:CodiceComune)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:root[number($index)]/tns1:CodiceComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceComune>&lt;CodiceISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryVerificaOLO/Record[1]/COD_OLO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryVerificaOLO/Record[1]/COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceISP>&lt;CodiceOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/tns1:root[number($index)]/tns1:CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:root[number($index)]/tns1:CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceOLO>&lt;VOLUMI_IN_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/tns1:root[number($index)]/tns1:Volumi)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:root[number($index)]/tns1:Volumi&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VOLUMI_IN_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($ParseData/Rows/tns1:root[number($index)]/tns1:Servizio)='ULL'&quot;>&lt;Servizio2>&lt;xsl:value-of select=&quot;'ULLLINEANONATTIVA'&quot;/>&lt;/Servizio2>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($ParseData/Rows/tns1:root[number($index)]/tns1:Servizio)='ULLLINEANONATTIVA'&quot;>&lt;Servizio2>&lt;xsl:value-of select=&quot;'ULL'&quot;/>&lt;/Servizio2>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($ParseData/Rows/tns1:root[number($index)]/tns1:Servizio)='ULLDATI'&quot;>&lt;Servizio2>&lt;xsl:value-of select=&quot;'ULLDATILINEANONATTIVA'&quot;/>&lt;/Servizio2>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($ParseData/Rows/tns1:root[number($index)]/tns1:Servizio)='ULLDATILINEANONATTIVA'&quot;>&lt;Servizio2>&lt;xsl:value-of select=&quot;'ULLDATI'&quot;/>&lt;/Servizio2>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($ParseData/Rows/tns1:root[number($index)]/tns1:Servizio)='SLU'&quot;>&lt;Servizio2>&lt;xsl:value-of select=&quot;'SLULINEANONATTIVA'&quot;/>&lt;/Servizio2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Servizio2>&lt;xsl:value-of select=&quot;'SLU'&quot;/>&lt;/Servizio2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_DENORM (COD_COMUNE, COD_ISP,COD_OLO,&#xd;&#xa;  CONFLICT_ID, CREATED, CREATED_BY, DATAFI, DATAINZ, DB_LAST_UPD, DESCR_SISTEMA, &#xd;&#xa;  LAST_UPD, LAST_UPD_BY, MODIFICATION_NUM, NOME_OFFERTA_ESTERNA, ROW_ID, ROW_ID_NOW, TIPOLG_LAVRZ, VOLUMI_IN_NOW)&#xd;&#xa;  SELECT ?, ?, ?,&#xd;&#xa;  '0', (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', TO_DATE('31-12-2999','dd-mm-yyyy'), (SELECT TO_DATE(SYSDATE) FROM DUAL),  (SELECT TO_DATE(SYSDATE) FROM DUAL), 'NOW', &#xd;&#xa;  (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', 0, UPPER(TRO.NOME_OFFERTA_ESTERNA), s_loczre_critr_rollt_denorm.nextval, '1-NOW-' || s_loczre_critr_rollt_denorm.currval, TL.TIPOLG_LAVRZ, ?&#xd;&#xa;    FROM APPUSER.LOCZRE_AMBITO LA, APPUSER.TRASCODFC_OFFERTA TRO, TIPOLG_LAVRZ TL&#xd;&#xa;    WHERE TRO.ID_TRASCODFC_OFFERTA=LA.ID_TRASCODFC_OFFERTA AND TL.IDTPLG_LAVRZ=LA.IDTPLG_LAVRZ&#xd;&#xa;    AND TRO.PROVENIENZA = 'XML' AND UPPER(TRO.NOME_OFFERTA_ESTERNA) = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceComune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceISP"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MoveToProcessed-input"
                    name="MoveToProcessed"
                    outputVariable="MoveToProcessed"
                    tibex:xpdlId="076ec34b-0a06-4795-bb30-eb7d07658251" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToRenameFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenameFileToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessedFolder&quot;/>&lt;xsl:param name=&quot;ProcessedSubfix&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:template name=&quot;MoveToProcessed-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;fromFileName>&lt;xsl:value-of select=&quot;$FilePoller/fileInfo/fullName&quot;/>&lt;/fromFileName>&lt;toFileName>&lt;xsl:value-of select=&quot;concat(substring-before($FilePoller/fileInfo/fullName,$FilePoller/fileInfo/fileName),$ProcessedFolder,$FilePoller/fileInfo/fileName,$ProcessedSubfix)&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.rename"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true"
                                    overwrite="true" xsi:type="file:RenameFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="9455e263-cc8e-4456-8818-27209dc90f7e">
                <bpws:targets>
                    <bpws:target linkName="RenameFileToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
