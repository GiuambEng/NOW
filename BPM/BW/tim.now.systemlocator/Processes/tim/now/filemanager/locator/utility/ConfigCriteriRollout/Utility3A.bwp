                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.LOCZRE_CRITR_ROLLT&#xa;  SET DATAFI = (SELECT TO_DATE(SYSDATE)&#xa;                  FROM DUAL)&#xa;  WHERE COD_OLO = ? AND DATAFI = TO_DATE('31-12-2999','dd-mm-yyyy') AND (COD_ISTAT_COMUNE = ? OR '*' = ?)&#xa;    AND (ID_TRASCODFC_OFFERTA IN (SELECT TRASC.ID_TRASCODFC_OFFERTA&#xa;      FROM APPUSER.TRASCODFC_OFFERTA TRASC&#xa;      WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML')&#xa;    OR ID_TRASCODFC_OFFERTA IN (SELECT TRASC.ID_TRASCODFC_OFFERTA&#xa;      FROM APPUSER.TRASCODFC_OFFERTA TRASC&#xa;      WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML'))" xsi:type="jdbcPalette:JDBCUpdateActivity">

