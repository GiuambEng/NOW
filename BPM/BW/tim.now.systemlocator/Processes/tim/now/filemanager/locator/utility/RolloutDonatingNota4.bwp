                                    <tibex:inputBinding
                                    expression="if (substring($Risorsa, 2, 1)='2' or (substring($Risorsa, 2, 1)='6')) then(substring($Risorsa, 1, 2))&#xd;&#xa;else (if (substring($Risorsa, 3, 1)='0' or &#xd;&#xa;(substring($Risorsa, 3, 1)='1')or (substring($Risorsa, 3, 1)='5')or&#xd;&#xa;(substring($Risorsa, 3, 1)='9')) then (substring($Risorsa, 1, 3)) else (substring($Risorsa, 1, 4)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
