                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns2:DNAggiuntivi) and $SistemaDiCompetenza="NOW"]]></bpws:condition>
