&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns1="http://www.tim.com/NOW/xsd/CriteriRollOut" xmlns:tns2="http://www.tim.com/NOW/xsd/RolloutDonating" xmlns:tns3="http://www.example.org/RecuperoComune" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="CriteriRollout-input" match="/"&gt;&lt;tns:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns1:RichiestaVerificaCriteriRollOut&gt;&lt;tns1:Richiesta&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta"/&gt;&lt;/tns1:Richiesta&gt;&lt;tns1:Servizio&gt;&lt;xsl:value-of select="$Start/tns2:Servizio"/&gt;&lt;/tns1:Servizio&gt;&lt;tns1:DataRichiesta&gt;&lt;xsl:value-of select="$Start/tns2:DataRichiesta"/&gt;&lt;/tns1:DataRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$Start/tns2:CodOLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;xsl:if test="$Start/tns2:CodiceComune"&gt;&lt;tns1:CodiceComune&gt;&lt;xsl:value-of select="$Start/tns2:CodiceComune"/&gt;&lt;/tns1:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns1:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CriteriRollout-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;tns1:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:Servizio&quot;/>&#xa;            &lt;/tns1:Servizio>&#xa;            &lt;tns1:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:DataRichiesta&quot;/>&#xa;            &lt;/tns1:DataRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:CodOLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:CodiceComune&quot;>&#xa;                &lt;tns1:CodiceComune>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:CodiceComune&quot;/>&#xa;                &lt;/tns1:CodiceComune>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
