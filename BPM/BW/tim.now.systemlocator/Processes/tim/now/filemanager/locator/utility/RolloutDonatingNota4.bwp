                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns1=&quot;http://tim.now.com/TC1noTIM&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:template name=&quot;TC1noTIM-input&quot; match=&quot;/&quot;>&lt;tns1:INPUT>&lt;tns2:RichiestaLocalizzatore>&lt;tns2:Testata>&lt;tns2:Transaction_id>&lt;xsl:value-of select=&quot;$Start/tns:TransactionId&quot;/>&lt;/tns2:Transaction_id>&lt;tns2:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:Transaction_date>&lt;tns2:Sistema_origine>&lt;xsl:value-of select=&quot;$Start/tns:SistemaOrigine&quot;/>&lt;/tns2:Sistema_origine>&lt;xsl:if test=&quot;$Start/tns:IdEsecProcsoNoFile&quot;>&lt;tns2:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns2:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;/tns2:Testata>&lt;tns2:Richiesta>&lt;tns2:DataRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:DataRichiesta&quot;/>&lt;/tns2:DataRichiesta>&lt;xsl:if test=&quot;$Start/tns:OLOrecipient&quot;>&lt;tns2:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/tns:OLOrecipient&quot;/>&lt;/tns2:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:CodiceComune&quot;>&lt;tns2:CodiceComune>&lt;xsl:value-of select=&quot;$Start/tns:CodiceComune&quot;/>&lt;/tns2:CodiceComune>&lt;/xsl:if>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;$Start/tns:Servizio&quot;/>&lt;/tns2:Servizio>&lt;tns2:Richiesta>&lt;xsl:value-of select=&quot;$Start/tns:Richiesta&quot;/>&lt;/tns2:Richiesta>&lt;tns2:IdRisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns2: