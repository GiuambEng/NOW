                            <tibex:expression
                                expression="not(exists($Consistenza/tns3:Consistenza)) and $Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico and not($Consistenza/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
