                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns14=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenzaALL/Schema.xsd2&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza&quot;/>&#xa;    &lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Consistenza/tns3:Consistenza[upper-case(tns3:Stato)=&amp;quot;CESSATO&amp;quot; and tns3:OLO=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO ]) or exists($ConsistenzaNOW_DIN/tns3:Consistenza[upper-case(tns3:Stato)=&amp;quot;CESSATO&amp;quot; and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO=tns3:OLO ])&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;          