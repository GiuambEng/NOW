                portType="ns2:CriteriRollout" tibex:xpdlId="4e06907d-0249-4a24-898c-68195b716efe">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns2="http://www.tim.com/NOW/xsd/CriteriRollOut" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns1:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaCriteriRollOut&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;tns2:DataRichiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/tns2:DataRichiesta&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"&gt;&lt;tns2:CodiceISP&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"/&gt;&lt;/tns2:CodiceISP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns2:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns1:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns2:DataRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&#xa;                &lt;tns2:CodiceISP>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&#xa;                &lt;/tns2:CodiceISP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&#xa;                &lt;tns2:CodiceComune>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;/>&#xa;                &lt;/tns2:CodiceComune>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
