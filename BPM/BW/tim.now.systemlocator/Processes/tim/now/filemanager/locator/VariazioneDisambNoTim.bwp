                <bpws:sources>
                    <bpws:source linkName="StartToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToVULL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="((upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&quot;VARIAZIONEULL&quot; and (upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)=&quot;TRASFORMAZIONEVULL-ULL-NP&quot; or upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)=&quot;TRASFORMAZIONEVULL-ULL&quot; or upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)=&quot;TRASFORMAZIONEULLCOMM-ULLLNA&quot;))) or starts-with(upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceCambioTipologia)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[((upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)="VARIAZIONEULL" and (upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)="TRASFORMAZIONEVULL-ULL-NP" or upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)="TRASFORMAZIONEVULL-ULL" or upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Sottolavorazione)="TRASFORMAZIONEULLCOMM-ULLLNA"))) or starts-with(upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceCambioTipologia)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
