            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+68ec307f-ed5f-4056-9740-1f7bcb5f51db+input&quot; xmlns:tns1=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DatiDaAsset-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IdRisorsa>&lt;xsl:value-of select=&quot;$Start/tns1:IDrisorsa&quot;/>&lt;/IdRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns1:IDrisorsa,2,1)=(&amp;quot;2&amp;quot;,&amp;quot;6&amp;quot;)&quot;>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;,$Start/tns1:IDrisorsa)&quot;/>&lt;/NumeroFittizio>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns1:IDrisorsa,3,1)=(&amp;quot;0&amp;quot;,&amp;quot;1&amp;quot;,&amp;quot;5&amp;quot;,&amp;quot;9&amp;quot;)&quot;>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;$Start/tns1:IDrisorsa&quot;/>&lt;/NumeroFittizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;substring($Start/tns1:IDrisorsa,2)&quot;/>&lt;/NumeroFittizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DatiDaAsset-input" name="DatiDaAsset"
                    outputVariable="DatiDaAsset"
                    tibex:xpdlId="68ec307f-ed5f-4056-9740-1f7bcb5f51db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToQueryToponomastica">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($DatiDaAsset/Record[string-length(CODICETOPONOMASTICA)>0])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($DatiDaAsset/Record[string-length(CODICETOPONOMASTICA)>0])]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DatiDaAssetToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+68ec307f-ed5f-4056-9740-1f7bcb5f51db+input&quot; xmlns:tns1=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DatiDaAsset-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IdRisorsa>&lt;xsl:value-of select=&quot;$Start/tns1:IDrisorsa&quot;/>&lt;/IdRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns1:IDrisorsa,2,1)=(&amp;quot;2&amp;quot;,&amp;quot;6&amp;quot;)&quot;>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;,$Start/tns1:IDrisorsa)&quot;/>&lt;/NumeroFittizio>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns1:IDrisorsa,3,1)=(&amp;quot;0&amp;quot;,&amp;quot;1&amp;quot;,&amp;quot;5&amp;quot;,&amp;quot;9&amp;quot;)&quot;>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;$Start/tns1:IDrisorsa&quot;/>&lt;/NumeroFittizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NumeroFittizio>&lt;xsl:value-of select=&quot;substring($Start/tns1:IDrisorsa,2)&quot;/>&lt;/NumeroFittizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  asset.CODIFICAOLOAGCOM, asset.statoasset AS stato_risorsa, asset.offerta AS servizio, asset.created,asset.CODICETOPONOMASTICA,asset.CODICEISTATCOMUNE,asset.DES  &#xa;FROM BDS_1_CASEDATA_ASSET asset &#xa;WHERE&#xa;(? IN (asset.IDRISORSA,asset.NUMEROTELEFONICO, asset.NUMEROFITTIZIO) &#xa; OR asset.NUMEROFITTIZIO =? ) &#xa;AND (asset.statoasset='ATTIVO' or asset.statoasset='INLAVORAZIONE') &#xa;AND asset.offerta&lt;>'NP' &#xa;order by DES desc&#xa;"
                                    threadPool="threadPoolProperty" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdRisorsa"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NumeroFittizio"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="SERVIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODICETOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEISTATCOMUNE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
