                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Cod_Comune&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:if test=&quot;$Cod_Comune/tns:CodiceISTATcomune&quot;>&lt;tns:CodiceISTATcomune>&lt;xsl:value-of select=&quot;$Cod_Comune/tns:CodiceISTATcomune&quot;/>&lt;/tns:CodiceISTATcomune>&lt;/xsl:if>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
