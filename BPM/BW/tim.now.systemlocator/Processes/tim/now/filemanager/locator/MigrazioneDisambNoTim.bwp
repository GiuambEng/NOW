                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Comune1&quot;/>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;DIN2&quot;/>&lt;xsl:param name=&quot;Comune2&quot;/>&lt;xsl:param name=&quot;DIN1&quot;/>&lt;xsl:template name=&quot;Nota4-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:TransactionId>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&lt;/tns1:TransactionId>&lt;tns1:SistemaOrigine>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&lt;/tns1:SistemaOrigine>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[tns3:OLO!=&amp;quot;TLC&amp;quot;][1]/tns3:OLO&quot;/>&lt;/tns1:CodOLO>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&lt;tns1:OLOrecipient>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:OLOrecipient>&lt;/xsl:if>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[tns3:OLO!=&amp;quot;TLC&amp;quot;][1]/tns3:Servizio&quot;/>&lt;/tns1:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[tns3:OLO!=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLo