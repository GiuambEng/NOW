                    <bpws:target linkName="Empty5ToRolloutRecipient"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RolloutRecipientToAssign1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RolloutRecipientToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($RolloutRecipient/parameters/tns:RispostaVerificaCriteriRollOut/tns:RecordCriteriRollOut[tns:SistemaDiCompetenza=&quot;NOW&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($RolloutRecipient.parameters/tns:RecordCriteriRollOut[tns:SistemaDiCompetenza="NOW"])]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns15=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:ns11=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:sm=&quot;http://dbcfx/SOA/CheckRetailPlatform/2016-07-04&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;RolloutRecipient&quot;/>&lt;xsl:param name=&quot;Risorsa1&quot;/>&lt;xsl:param name=&quot;CheckRetailPlatform&quot;/>&lt;xsl:param name=&quot;RolloutDonating1&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;01&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:Stato!=&amp;quot;CESSATO&amp;quot; and (upper-case(ns15:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoHL&amp;quot;) or upper-case(ns15:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoFlat&amp;quot;))]) and (upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=upper-case(&amp;quot;BitstreamNGAFTTCAB&amp;quot;) or upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&amp;quot;VULAFTTCAB&amp;quot;)&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;03&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;01&amp;quot;&quot;/>&lt;xsl:when test=&quot;not(exists($RolloutRecipient/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;]))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;]) and exists($Consistenze/ns15:Consistenza[ns15:OLO!=&amp;quot;TLC&amp;quot;]) and not(matches($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;][1]/ns15:Risorsa,&amp;quot;[0-9]*&amp;quot;))&amp;#xD;&amp;#xA;and not(matches(if ($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;][1]/ns15:Risorsa=$Risorsa1) then $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa else $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2 ,&amp;quot;[0-9]*&amp;quot;))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Risorsa TLC alfanumerica&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;]) and exists($Consistenze/ns15:Consistenza[ns15:OLO!=&amp;quot;TLC&amp;quot;]) and not($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &amp;quot;00&amp;quot; and ($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;CRMR_V&amp;quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;CRMB_V&amp;quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;DBSS&amp;quot;))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Check Retail Platform non su nuova catena&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;$RolloutDonating1/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:Risposta>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta" name="EsitoCRMWS"
                    outputVariable="Risposta"
                    tibex:xpdlId="26fac9e2-9fd1-4265-813f-f1cc7209ca8e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RolloutRecipientToAssign1"/>
                        <bpws:target linkName="InvokeToEsitoCRMWS"/>
                        <bpws:target linkName="RolloutDonating1ToEsitoCRMWS"/>
                        <bpws:target linkName="Log2ToEsitoCRMWS"/>
                        <bpws:target linkName="Log2ToEsitoCRMWS1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EsitoCRMWSToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns15=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:ns11=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:sm=&quot;http://dbcfx/SOA/CheckRetailPlatform/2016-07-04&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;RolloutDonating1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RolloutRecipient.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckRetailPlatform.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;tns:Risposta>&#xa;                &lt;tns:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:DataRisposta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;01&amp;quot;&quot;>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:Stato!=&amp;quot;CESSATO&amp;quot; and (upper-case(ns15:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoHL&amp;quot;) or upper-case(ns15:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoFlat&amp;quot;))]) and (upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=upper-case(&amp;quot;BitstreamNGAFTTCAB&amp;quot;) or upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&amp;quot;VULAFTTCAB&amp;quot;)&quot;>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;03&amp;quot;&quot;>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:RC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                &lt;/tns:RC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE=&amp;quot;01&amp;quot;&quot;/>&#xa;                    &lt;xsl:when test=&quot;not(exists($RolloutRecipient.parameters/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;]))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;]) and exists($Consistenze/ns15:Consistenza[ns15:OLO!=&amp;quot;TLC&amp;quot;]) and not(matches($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;][1]/ns15:Risorsa,&amp;quot;[0-9]*&amp;quot;))&amp;#xD;&amp;#xA;and not(matches(if ($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;][1]/ns15:Risorsa=$Risorsa1) then $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa else $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2 ,&amp;quot;[0-9]*&amp;quot;))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Risorsa TLC alfanumerica&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenze/ns15:Consistenza[ns15:OLO=&amp;quot;TLC&amp;quot;]) and exists($Consistenze/ns15:Consistenza[ns15:OLO!=&amp;quot;TLC&amp;quot;]) and not($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &amp;quot;00&amp;quot; and ($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;CRMR_V&amp;quot; or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;CRMB_V&amp;quot; or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;DBSS&amp;quot;))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Check Retail Platform non su nuova catena&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$RolloutDonating1.parameters/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Risposta>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Risposta" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="e5301433-41e9-4c4e-aa0b-1f77fb342867">
                <bpws:targets>
                    <bpws:target linkName="RolloutRecipientToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToLog">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Consistenze/ns15:Consistenza[ns15:OLO=&quot;TLC&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Consistenze/ns15:Consistenza[ns15:OLO="TLC"])]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToEmpty2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;OLO_TIM-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Migrazione TIM2OLO&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OLO_TIM-input" name="OLO_TIM"
                    tibex:xpdlId="bb5c2876-123b-46b2-95fc-a09ab98d7c60" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OLO_TIMToEmpty4">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Consistenze/ns15:Consistenza[ns15:OLO!=&quot;TLC&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($Consistenze/ns15:Consistenza[ns15:OLO!="TLC"])]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OLO_TIMToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;OLO_TIM-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Migrazione TIM2OLO&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty2" tibex:xpdlId="79209e6a-f0f4-4134-8972-f7f49e7b3e9d">
                <bpws:targets>
                    <bpws:target linkName="EmptyToEmpty2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToLog">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Consistenze/ns15:Consistenza)>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($Consistenze/ns15:Consistenza)>1]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Comune1&quot;/>&lt;xsl:param name=&quot;Comune2&quot;/>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;DIN2&quot;/>&lt;xsl:param name=&quot;DIN1&quot;/>&lt;xsl:template name=&quot;RolloutDonatingNota4-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Consistenze/tns3:Consistenza)>1&quot;>&lt;tns1:Input>&lt;tns1:TransactionId>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&lt;/tns1:TransactionId>&lt;tns1:SistemaOrigine>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&lt;/tns1:SistemaOrigine>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[2]/tns3:OLO&quot;/>&lt;/tns1:CodOLO>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&lt;tns1:OLOrecipient>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:OLOrecipient>&lt;/xsl:if>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[2]/tns3:Servizio&quot;/>&lt;/tns1:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[2]/tns3:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa or $Consistenze/tns3:Consistenza[2]/tns3:Risorsa=$DIN1/ID_RISORSA&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Comune1/tns2:CodiceISTATcomune)>0&quot;>&lt;xsl:if test=&quot;$Comune1/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;$Comune1/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[2]/tns3:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2 or $Consistenze/tns3:Consistenza[2]/tns3:Risorsa=$DIN2/ID_RISORSA&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Comune2/tns2:CodiceISTATcomune)>0&quot;>&lt;xsl:if test=&quot;$Comune2/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;$Comune2/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Consistenze/tns3:Consistenza[2]/tns3:Risorsa&quot;>&lt;tns1:Risorsa>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[2]/tns3:Risorsa&quot;/>&lt;/tns1:Risorsa>&lt;/xsl:if>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&lt;/tns1:DataRichiesta>&lt;tns1:Richiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&lt;/tns1:Richiesta>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;>&lt;tns1:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns1:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DNAggiuntivi/tns:DN&quot;>&lt;tns1:DNAggiuntivi>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns1:DNAggiuntivi>&lt;/xsl:for-each>&lt;tns4:Esiti/>&lt;/tns1:Input>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Input>&lt;tns1:TransactionId>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&lt;/tns1:TransactionId>&lt;tns1:SistemaOrigine>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&lt;/tns1:SistemaOrigine>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[1]/tns3:OLO&quot;/>&lt;/tns1:CodOLO>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&lt;tns1:OLOrecipient>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:OLOrecipient>&lt;/xsl:if>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[1]/tns3:Servizio&quot;/>&lt;/tns1:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[1]/tns3:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa or $Consistenze/tns3:Consistenza[1]/tns3:Risorsa=$DIN1/ID_RISORSA&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Comune1/tns2:CodiceISTATcomune)>0&quot;>&lt;xsl:if test=&quot;$Comune1/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;$Comune1/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceComune>&lt;xsl:value-of selec