         &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&#xa;                                &lt;/tns:ErrMSG>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$RolloutDonatingTIM/tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot; or $RolloutDonatingTIM/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&#xa;                                &lt;tns:SistemaDiCompetenza>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;tns:RC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                                &lt;/tns:RC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:SistemaDiCompetenza>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                &lt;/tns:SistemaDiCompetenza>&#xa;                                &lt;tns:RC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                                &lt;/tns:RC>&#xa;                                &lt;tns:ErrMSG>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&#xa;                                &lt;/tns:ErrMSG>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Risposta>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
