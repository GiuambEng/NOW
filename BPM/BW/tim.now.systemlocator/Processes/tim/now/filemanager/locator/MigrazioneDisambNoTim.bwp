                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;DIN2&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune2&quot;/>&#xa;    &lt;xsl:param name=&quot;DIN1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa2&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonatingTIM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:SistemaOrigine>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&#xa;            &lt;/tns1:SistemaOrigine>&#xa;            &lt;tns1:CodOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;            &lt;/tns1:CodOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&#xa;                &lt;tns1:OLOrecipient>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;                &lt;/tns1:OLOrecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Servizio&quot;/>&#xa;            &lt;/tns1:Servizio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa or $Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$DIN1/ID_RISORSA&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Comune1/tns2:CodiceISTATcomune)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Comune1/tns2:CodiceISTATcomune&quot;>&#xa;                                &lt;tns1:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$Comune1/tns2:CodiceISTATcomune&quot;/>&#xa;                                &lt;/tns1:CodiceComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns1:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2 or $Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$DIN2/ID_RISORSA&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Comune2/tns2:CodiceISTATcomune)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Comune2/tns2:CodiceISTATcomune&quot;>&#xa;                                &lt;tns1:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$Comune2/tns2:CodiceISTATcomune&quot;/>&#xa;                                &lt;/tns1:CodiceComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns1:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$Risorsa1&quot;>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;>&#xa;                        &lt;tns1:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;/>&#xa;                        &lt;/tns1:Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa=$Risorsa2&quot;>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2&quot;>&#xa;                        &lt;tns1:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2&quot;/>&#xa;                        &lt;/tns1:Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;matches($Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa&quot;>&#xa;                        &lt;tns1:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa&quot;/>&#xa;                        &lt;/tns1:Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa&quot;>&#xa;                        &lt;tns1:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/tns3:Consistenza[tns3:OLO=&amp;quot;TLC&amp;quot;][1]/tns3:Risorsa&quot;/>&#xa;                        &lt;/tns1:Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns1:DataRichiesta>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;>&#xa;                &lt;tns1:IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/tns1:IdEsecProcsoNoFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DNAggiuntivi/tns:DN&quot;>&#xa;                &lt;tns1:DNAggiuntivi>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns1:DNAggiuntivi>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns4:Esiti/>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.locator.utility.RolloutDonating" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;RolloutDonatingTIM&quot;/>&lt;xsl:param name=&quot;Nota4&quot;/>&lt;xsl:param name=&quot;RolloutDonatingNota4&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RolloutDonatingNota4/tns1:SistemaDiCompetenza)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$RolloutDonatingNota4/tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Nota4/tns1:SistemaDiCompetenza)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Nota4/tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$RolloutDonatingTIM/tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot; or $RolloutDonatingTIM/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Risposta>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta" name="Assign1"
                    outputVariable="Risposta"
                    tibex:xpdlId="8951c2a7-1b62-45f1-8a5c-a0179281d72e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
