                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;DoppioDonating-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Doppio donating&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="RolloutDonating1-input"
                name="RolloutDonating1"
                operation="VerificaCriteriRollout"
                outputVariable="RolloutDonating1"
                partnerLink="CriteriRollout1"
                portType="ns8:CriteriRollout" tibex:xpdlId="dda489ea-3a87-41af-a8bd-eea24451f462">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns2="http://www.tim.com/NOW/xsd/CriteriRollOut" xmlns:tns3="http://www.example.org/RecuperoComune" xmlns:tns4="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:param name="Comune1"/&gt;&lt;xsl:param name="Consistenze"/&gt;&lt;xsl:template name="RolloutDonating1-input" match="/"&gt;&lt;tns1:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaCriteriRollOut&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$Consistenze/tns4:Consistenza[1]/tns4:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;tns2:DataRichiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/tns2:DataRichiesta&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$Consistenze/tns4:Consistenza[1]/tns4:OLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Comune1/tns3:CodiceISTATcomune)&gt;0"&gt;&lt;xsl:if test="$Comune1/tns3:CodiceISTATcomune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$Comune1/tns3:CodiceISTATcomune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="&amp;quot;xxxxxxxxx&amp;quot;"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns2:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns1:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonating1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[1]/tns4:Servizio&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns2:DataRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[1]/tns4:OLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Comune1/tns3:CodiceISTATcomune)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Comune1/tns3:CodiceISTATcomune&quot;>&#xa;                        &lt;tns2:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;$Comune1/tns3:CodiceISTATcomune&quot;/>&#xa;                        &lt;/tns2:CodiceComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:CodiceComune>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&#xa;                    &lt;/tns2:CodiceComune>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="DoppioDonatingToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToRolloutDonatingSingolo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RolloutDonating1/parameters/tns:RispostaVerificaCriteriRollOut/tns:RecordCriteriRollOut[1]/tns:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RolloutDonating1.parameters/tns:RecordCriteriRollOut[1]/tns:SistemaDiCompetenza="NOW"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RolloutDonating1ToEsitoCRMWS">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="CheckRetailPlatform-input"
                name="CheckRetailPlatform" operation="checkNP"
                outputVariable="CheckRetailPlatform"
                partnerLink="CheckRetailPlatformPT"
                portType="ns11:CheckRetailPlatformPT" tibex:xpdlId="ca50c470-00f6-479c-99a6-73d7379272d9">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://xmlns.now.com/CheckRetailPlatform/" xmlns:tns2="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/" version="2.0"&gt;
    &lt;xsl:param name="GetSystemIn"/&gt;
    &lt;xsl:param name="Consistenze"/&gt;
    &lt;xsl:param name="Risorsa1"/&gt;
    &lt;xsl:param name="Risorsa2"/&gt;
    &lt;xsl:template name="CheckRetailPlatform-input" match="/"&gt;
        &lt;tns1:checkNPRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:checkNPRequest&gt;
                    &lt;request&gt;
                        &lt;DATA_RICHIESTA&gt;
                            &lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;
                        &lt;/DATA_RICHIESTA&gt;
                        &lt;CODICE_OLO&gt;
                            &lt;xsl:value-of select="$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:OLO"/&gt;
                        &lt;/CODICE_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="matches($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa=$Risorsa1"&gt;
                                &lt;ID_RISORSA&gt;
                                    &lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa"/&gt;
                                &lt;/ID_RISORSA&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="matches($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa=$Risorsa2"&gt;
                                &lt;ID_RISORSA&gt;
                                    &lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2"/&gt;
                                &lt;/ID_RISORSA&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="matches($Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa,&amp;quot;[0-9]*&amp;quot;)"&gt;
                                &lt;ID_RISORSA&gt;
                                    &lt;xsl:value-of select="$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa"/&gt;
                                &lt;/ID_RISORSA&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ID_RISORSA&gt;
                                    &lt;xsl:value-of select="$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa"/&gt;
                                &lt;/ID_RISORSA&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;IdEsecProcsoNoFile&gt;
                            &lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile"/&gt;
                        &lt;/IdEsecProcsoNoFile&gt;
                    &lt;/request&gt;
                &lt;/tns1:checkNPRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns1:checkNPRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa2&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckRetailPlatform-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:checkNPRequest>&#xa;            &lt;request>&#xa;                &lt;DATA_RICHIESTA>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;                &lt;/DATA_RICHIESTA>&#xa;                &lt;CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:OLO&quot;/>&#xa;                &lt;/CODICE_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa=$Risorsa1&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2,&amp;quot;[0-9]*&amp;quot;) and $Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa=$Risorsa2&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;matches($Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/tns2:Consistenza[tns2:OLO=&amp;quot;TLC&amp;quot;][1]/tns2:Risorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/IdEsecProcsoNoFile>&#xa;            &lt;/request>&#xa;        &lt;/tns1:checkNPRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty4ToCheckRetailPlatform"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToEsitoCRMWS">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="InvokeToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &quot;00&quot; and ($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMR_V&quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMB_V&quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;DBSS&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE = "00" and ($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "CRMR_V" or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "CRMB_V" or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "DBSS")]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
