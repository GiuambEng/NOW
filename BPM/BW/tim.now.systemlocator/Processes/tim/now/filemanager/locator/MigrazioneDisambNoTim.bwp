                    expression="if(string-length($DIN2/ID_RISORSA)>0  and $DIN2/ESITO=&quot;000&quot;) then (if(matches($DIN2/ID_RISORSA,&quot;[0-9]*&quot;)) then $DIN2/ID_RISORSA else substring($DIN2/ID_RISORSA,4)) else $GetSystemIn/RichiestaLocalizzatore/ns4:RichiestaLocalizzatore/ns4:Richiesta/ns4:IdRisorsa2"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="RisorsaCRWMS" name="Assign3"
