                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;Risorsa1&quot;/>&lt;xsl:param name=&quot;Risorsa2&quot;/>&lt;xsl:template name=&quot;Comune2-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:IDrisorsa>&lt;xsl:value-of select=&quot;$Consistenze/tns2:Consistenza[tns2:Risorsa!=$Risorsa1][1]/tns2:Risorsa&quot;/>&lt;/tns1:IDrisorsa>&lt;xsl:if test=&quot;$Consistenze/tns2:Consistenza[tns2:Risorsa!=$Risorsa2][1]/tns2:OLO&quot;>&lt;tns1:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$Consistenze/tns2:Consistenza[tns2:Risorsa!=$Risorsa2][1]/tns2:OLO&quot;/>&lt;/tns1:CodificaOLOagcom>&lt;/xsl:if>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
