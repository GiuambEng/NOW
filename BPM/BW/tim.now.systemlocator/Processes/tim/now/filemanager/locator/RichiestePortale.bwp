                                    name="DATA_INIZIO" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DATA_FINE" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="SISTEMA_DI_COMPETENZA" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
