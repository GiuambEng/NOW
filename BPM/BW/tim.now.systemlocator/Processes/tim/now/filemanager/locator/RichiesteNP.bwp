                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALORE_STRINGA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 2, 1)='2' or (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 2, 1)='6')) then(substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 1, 2))&#xd;&#xa;else (if (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 3, 1)='0' or &#xd;&#xa;(substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 3, 1)='1')or (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 3, 1)='5')or&#xd;&#xa;(substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 3, 1)='9')) then (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 1, 3)) else (substring($GetSystemIn/RichiestaLocalizzatore/ns3:RichiestaLocalizzatore/ns3:Richiesta/ns3:IdRisorsa, 1, 4)))"
