                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CHIAVE, VALORE_STRINGA FROM PARAMETRI_CFGZ_NOW&#xd;&#xa;WHERE CHIAVE='GESTISCI_PACCHETTI_NP' OR CHIAVE='GESTISCI_RIENTRI_NP' AND NOME_PROCSO='LOCALIZZATORE'&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
