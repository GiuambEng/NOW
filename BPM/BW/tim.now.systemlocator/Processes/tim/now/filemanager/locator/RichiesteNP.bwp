            <bpws:reply name="GetSystemOut" operation="GetSystem"
                partnerLink="SystemLocatorPortTypeInternal"
                portType="ns14:SystemLocatorPortTypeInternal"
                tibex:xpdlId="2304c14c-ea6b-4a1d-a8a7-b32ec8b2f1a6" variable="GetSystemOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/xsd/SystemLocator/" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:param name="V_RispostaLocalizzatore"/&gt;&lt;xsl:template name="GetSystemOut-input" match="/"&gt;&lt;ns0:GetSystemResponse xmlns:ns0="http://www.tim.com/NOW/wsdl/abstract/SystemLocatorInternal/"&gt;&lt;RispostaLocalizzatore&gt;&lt;tns1:RispostaLocalizzatore&gt;&lt;xsl:copy-of select="$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Testata"/&gt;&lt;xsl:copy-of select="$V_RispostaLocalizzatore/tns1:Risposta"/&gt;&lt;/tns1:RispostaLocalizzatore&gt;&lt;/RispostaLocalizzatore&gt;&lt;/ns0:GetSystemResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;V_RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;GetSystemOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Testata&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$V_RispostaLocalizzatore/tns1:Risposta&quot;/>&#xa;        &lt;/tns1:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToGetSystemOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;StartLogNP-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Start Subprocess &amp;quot;,bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot; - Input= &amp;quot;, tib:render-xml($GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartLogNP-input" name="StartLogNP"
                    tibex:xpdlId="18963b4a-01cd-4965-9167-f0d262bc5231" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetSystemInToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogNPToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;StartLogNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Start Subprocess &amp;quot;,bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot; - Input= &amp;quot;, tib:render-xml($GetSystemIn.RichiestaLocalizzatore))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta)=0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Il campo Richiesta è obblogatorio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)=0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'IdRisorsa è obbligatporio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO)=0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Codice OLO è obbligatorio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP)=0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Codice ISP è obbligatorio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_1') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_3') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_4') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_5') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_7') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_8') and  not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_10') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_11') and not($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_13') &quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'15'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Tipo Comunicazione NP non Gestita'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_8') and (not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI) =0) and ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO='TLC' or $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP='002')&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;(($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_4') or ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_5') or ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_11') or ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_7') or ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_10') or  ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_13')) and (not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOrdineRiferimentoOLO))or(string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOrdineRiferimentoOLO)=0))&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Per Tipo_Comunicazione 4,5,7,10,11,13 il campo: CodiceOrdineRiferimentoOLO è obbligatorio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_1' and (not(exists($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Flag_verticalizzato)) or string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Flag_verticalizzato)=0 ) and ($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO='TLC' or $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP='002')&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;'Nel caso di Rientri (Tipo_Comunicazione 1, scenario 4) il campo Flag_Verticalizzato è obbligatorio'&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:RC>&lt;/tns:Risposta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="V_RispostaLocalizzatore"
                    name="CheckInput"
                    outputVariable="V_RispostaLocalizzatore"
                    tibex:xpdlId="21a97004-bdff-412d-8195-55a5f57274de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogNPToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$V_RispostaLocalizzatore/ns3:Risposta/ns3:SistemaDiCompetenza='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$V_RispostaLocalizzatore/ns3:Risposta/ns3:SistemaDiCompetenza='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta)=0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Il campo Richiesta è obblogatorio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)=0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'IdRisorsa è obbligatporio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO)=0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Codice OLO è obbligatorio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP)=0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Codice ISP è obbligatorio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_1') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_3') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_4') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_5') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_7') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_8') and  not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_10') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_11') and not($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_13') &quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'15'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Tipo Comunicazione NP non Gestita'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_8') and (not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI) =0) and ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO='TLC' or $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP='002')&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_4') or ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_5') or ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_11') or ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_7') or ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_10') or  ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_13')) and (not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOrdineRiferimentoOLO))or(string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOrdineRiferimentoOLO)=0))&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Per Tipo_Comunicazione 4,5,7,10,11,13 il campo: CodiceOrdineRiferimentoOLO è obbligatorio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta='TIPO_COMUNICAZIONE_1' and (not(exists($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Flag_verticalizzato)) or string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Flag_verticalizzato)=0 ) and ($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO='TLC' or $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP='002')&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'03'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'Nel caso di Rientri (Tipo_Comunicazione 1, scenario 4) il campo Flag_Verticalizzato è obbligatorio'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
