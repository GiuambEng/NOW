            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e44b2ad-1488-400c-aed5-3f7e392d1e8b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Servizio>&lt;xsl:value-of select=&quot;upper-case($GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;/>&lt;/Servizio>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LNA_LA-input" name="LNA_LA"
                    outputVariable="LNA_LA"
                    tibex:xpdlId="9e44b2ad-1488-400c-aed5-3f7e392d1e8b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToRolloutDonating"/>
                        <bpws:target linkName="ComuneToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LNA_LAToWhile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$LNA_LA/Record[1]/LNA_LA=&quot;LA&quot; and (count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and tns3:Servizio!=&quot;NP&quot;])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!=&quot;NP&quot;])>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$LNA_LA/Record[1]/LNA_LA="LA" and (count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and tns3:Servizio!="NP"])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!="NP"])>0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LNA_LAToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LNA_LAToLog2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$LNA_LA/Record[1]/LNA_LA=&quot;LA&quot; and not(count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and tns3:Servizio!=&quot;NP&quot;])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!=&quot;NP&quot;])>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$LNA_LA/Record[1]/LNA_LA="LA" and not(count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and tns3:Servizio!="NP"])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!="NP"])>0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e44b2ad-1488-400c-aed5-3f7e392d1e8b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;Servizio>&#xa;                &lt;xsl:value-of select=&quot;upper-case($GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;/>&#xa;            &lt;/Servizio>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT LNA_LA FROM OFFERTA off,TRASCODFC_OFFERTA tro&#xa;WHERE off.ID_OFFERTA=tro.ID_OFFERTA AND upper(tro.NOME_OFFERTA_ESTERNA)=?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>
                                    <columnMetadata
                                    columnName="LNA_LA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
