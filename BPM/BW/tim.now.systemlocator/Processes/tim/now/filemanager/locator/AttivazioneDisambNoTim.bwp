                    <bpws:sources>
                        <bpws:source linkName="ComuneToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(exists($VerificaCriteriRolloutTel/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[(tns1:CodiceComune=$Comune/tns2:CodiceISTATcomune or tns1:CodiceComune=&quot;*&quot; or tns1:CodiceComune=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune) and tns1:SistemaDiCompetenza=&quot;NOW&quot;])) or (count($VerificaCriteriRolloutTel/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($VerificaCriteriRolloutTel.parameters/tns1:RecordCriteriRollOut[(tns1:CodiceComune=$Comune/tns2:CodiceISTATcomune or tns1:CodiceComune="*" or tns1:CodiceComune=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune) and tns1:SistemaDiCompetenza="NOW"])) or (count($VerificaCriteriRolloutTel.parameters/tns1:RecordCriteriRollOut)=0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ComuneToRisorsaCessata">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
