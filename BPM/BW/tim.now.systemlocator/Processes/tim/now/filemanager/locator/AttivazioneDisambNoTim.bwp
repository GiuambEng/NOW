                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&lt;xsl:template name=&quot;Comune-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns:IDrisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;])&quot;>&lt;xsl:if test=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
