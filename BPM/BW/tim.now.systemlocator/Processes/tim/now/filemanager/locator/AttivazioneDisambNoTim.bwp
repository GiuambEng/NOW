                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="IncrementoVolumi-input"
                    name="IncrementoVolumi"
                    tibex:xpdlId="073d3262-f50a-4693-af12-8af0861c2620"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:CodOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns1:CodOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&#xa;                &lt;tns1:CodISP>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&#xa;                &lt;/tns1:CodISP>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;tns1:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&#xa;            &lt;/tns1:Servizio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&#xa;                        &lt;tns1:CodiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;/>&#xa;                        &lt;/tns1:CodiceISTATComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Comune/tns2:CodiceISTATcomune&quot;>&#xa;                        &lt;tns1:CodiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$Comune/tns2:CodiceISTATcomune&quot;/>&#xa;                        &lt;/tns1:CodiceISTATComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns1:DataRichiesta>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="tim.now.filemanager.locator.utility.IncrementoVolumi" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output query consistenza: &amp;quot;, tib:render-xml($ConsistenzaNOW))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log-input" name="Log"
                    tibex:xpdlId="bc0e1283-03fa-4d7d-aef2-bcc345abadcb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTCAB&quot; and upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTH&quot;]) and not($ConsistenzaNOW/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and upper-case(tns3:Servizio)!="EASYIPNGAFTTCAB" and upper-case(tns3:Servizio)!="EASYIPNGAFTTH"]) and not($ConsistenzaNOW/tns3:ErroreRadicale="Y")]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToDIN">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToRisorsaCessata">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ConsistenzaNOW/tns3:ErroreRadicale=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$ConsistenzaNOW/tns3:ErroreRadicale="Y"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToAssign5">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and (upper-case(tns3:Servizio)=&quot;EASYIPNGAFTTCAB&quot; or upper-case(tns3:Servizio)=&quot;EASYIPNGAFTTH&quot;)]) and not($ConsistenzaNOW/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and (upper-case(tns3:Servizio)="EASYIPNGAFTTCAB" or upper-case(tns3:Servizio)="EASYIPNGAFTTH")]) and not($ConsistenzaNOW/tns3:ErroreRadicale="Y")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output query consistenza: &amp;quot;, tib:render-xml($ConsistenzaNOW))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
