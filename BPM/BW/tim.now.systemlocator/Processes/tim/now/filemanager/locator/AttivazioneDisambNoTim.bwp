                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SystemLocatorInternal/" version="2.0"&gt;&lt;xsl:param name="Risposta"/&gt;&lt;xsl:template name="GetSystemOut-input" match="/"&gt;&lt;tns:GetSystemResponse&gt;&lt;RispostaLocalizzatore&gt;&lt;xsl:copy-of select="$Risposta"/&gt;&lt;/RispostaLocalizzatore&gt;&lt;/tns:GetSystemResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
