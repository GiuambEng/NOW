            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;VerificaCriteriRollout&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;count($VerificaCriteriRollout/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut)>0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;$VerificaCriteriRollout/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:RC>&lt;xsl:if test=&quot;$VerificaCriteriRollout/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:if>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta" name="Assign"
                    outputVariable="Risposta"
                    tibex:xpdlId="ca67ae22-efda-421f-a7b6-2247080eb01c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCriteriRollout.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($VerificaCriteriRollout.parameters/tns1:RecordCriteriRollOut)>0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCriteriRollout.parameters/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;xsl:if test=&quot;$VerificaCriteriRollout.parameters/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                            &lt;tns:ErrMSG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                            &lt;/tns:ErrMSG>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
