                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="61e6e029-5df0-4c98-a022-a3788b95b7bd">
                <bpws:targets>
                    <bpws:target linkName="LNA_LAToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToSistemaDonating"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+0aa475e7-2f7d-4dbc-a37e-2935abec64ef" version="2.0"> <xsl:template name="AccumulateRolloutDonating" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateRolloutDonating"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and tns3:Servizio!=&quot;NP&quot;]) or $index&lt;=count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!=&quot;NP&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and tns3:Servizio!="NP"]) or $index<=count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!="NP"])]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToRolloutDonating" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RolloutDonatingToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="ef8e04ef-fd60-43ef-98cd-1b5f1218f645">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToRolloutDonating"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateRolloutDonating"
                                    outputVariable="AccumulateRolloutDonating"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="0aa475e7-2f7d-4dbc-a37e-2935abec64ef" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RolloutDonatingToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>RolloutDonating</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;RolloutDonating-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:TransactionId>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&lt;/tns1:TransactionId>&lt;tns1:SistemaOrigine>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&lt;/tns1:SistemaOrigine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;])&quot;>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:OLO&quot;/>&lt;/tns1:CodOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns2:Consistenza[tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:OLO&quot;/>&lt;/tns1:CodOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&lt;tns1:OLOrecipient>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:OLOrecipient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;])&quot;>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:Servizio&quot;/>&lt;/tns1:Servizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns2:Consistenza[tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:Servizio&quot;/>&lt;/tns1:Servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico&quot;>&lt;tns1:Risorsa>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico&quot;/>&lt;/tns1:Risorsa>&lt;/xsl:if>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&lt;/tns1:DataRichiesta>&lt;tns1:Richiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&lt;/tns1:Richiesta>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;>&lt;tns1:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns1:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DNAggiuntivi/tns:DN&quot;>&lt;tns1:DNAggiuntivi>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns1:DNAggiuntivi>&lt;/xsl:for-each>&lt;tns3:Esiti/>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RolloutDonating-input"
                                    name="RolloutDonating"
                                    outputVariable="RolloutDonating"
                                    tibex:xpdlId="08bbb2fa-aa59-4256-9fb0-29661a161595"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToRolloutDonating"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RolloutDonatingToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&#xa;    &lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonating-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:SistemaOrigine>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&#xa;            &lt;/tns1:SistemaOrigine>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;])&quot;>&#xa;                    &lt;tns1:CodOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:OLO&quot;/>&#xa;                    &lt;/tns1:CodOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CodOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns2:Consistenza[tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:OLO&quot;/>&#xa;                    &lt;/tns1:CodOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&#xa;                &lt;tns1:OLOrecipient>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;                &lt;/tns1:OLOrecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;])&quot;>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns2:Consistenza[tns2:Stato!=&amp;quot;CESSATO&amp;quot; and tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns2:Consistenza[tns2:Servizio!=&amp;quot;NP&amp;quot;][number($index)]/tns2:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico&quot;>&#xa;                &lt;tns1:Risorsa>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico&quot;/>&#xa;                &lt;/tns1:Risorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns1:DataRichiesta>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;>&#xa;                &lt;tns1:IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/tns1:IdEsecProcsoNoFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DNAggiuntivi/tns:DN&quot;>&#xa;                &lt;tns1:DNAggiuntivi>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns1:DNAggiuntivi>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns3:Esiti/>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.locator.utility.RolloutDonating" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
