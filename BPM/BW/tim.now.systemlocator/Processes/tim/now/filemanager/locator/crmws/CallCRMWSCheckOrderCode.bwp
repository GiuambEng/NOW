                                <bpws:link name="ScopeToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToWaitBeforeRetry_OtherTries"
                                    tibex:label="Other Tries" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="WaitBeforeRetryToScope" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="20905533-4a98-4129-90eb-323206c7be9f">
