                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1463671354330&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckOrderCodeIn.HEADER&quot;/>&#xa;    &lt;xsl:template name=&quot;CRMWSCheckOrderCode-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:HEADER>&#xa;            &lt;ns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:TRANSACTION_ID&quot;/>&#xa;            &lt;/ns:TRANSACTION_ID>&#xa;            &lt;ns:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:TRANSACTION_DATE&quot;/>&#xa;            &lt;/ns:TRANSACTION_DATE>&#xa;            &lt;ns:SISTEMA_ORIGINE>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:SISTEMA_ORIGINE&quot;/>&#xa;            &lt;/ns:SISTEMA_ORIGINE>&#xa;            &lt;ns:REQUEST>&#xa;                &lt;ns:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:CODICE_OLO>&#xa;                &lt;ns:CODICE_OLO_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:CODICE_OLO_CRMWS&quot;/>&#xa;                &lt;/ns:CODICE_OLO_CRMWS>&#xa;                &lt;xsl:if test=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO&quot;>&#xa;                    &lt;ns:COD_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO&quot;/>&#xa;                    &lt;/ns:COD_ORDINE_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI&quot;>&#xa;                    &lt;ns:COD_ORDINE_TI>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI&quot;/>&#xa;                    &lt;/ns:COD_ORDINE_TI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:REQUEST>&#xa;        &lt;/ns:HEADER>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCRMWSCheckOrderCode"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CRMWSCheckOrderCodeToGroupEnd"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                </bpws:flow>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;callTryWaitSeconds&quot;/>&lt;xsl:template name=&quot;WaitBeforeRetry-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;$callTryWaitSeconds * 1000&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="WaitBeforeRetry-input"
                                    name="WaitBeforeRetry"
                                    tibex:xpdlId="ef0a586b-a019-4780-af9b-5a7a533f3dcb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToWaitBeforeRetry_OtherTries"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="WaitBeforeRetryToScope"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;callTryWaitSeconds&quot;/>&lt;xsl:template name=&quot;WaitBeforeRetry-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;$callTryWaitSeconds * 1000&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.sleep"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[boolean($repeatOnError_success_flag)]]></bpws:condition>
                </bpws:repeatUntil>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
