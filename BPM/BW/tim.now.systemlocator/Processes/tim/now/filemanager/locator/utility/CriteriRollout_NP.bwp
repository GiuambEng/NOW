                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;v_VerificaCriteriRollout_NP&quot; match=&quot;/&quot;>&lt;tns:RispostaVerificaCriteriRollOut_NP>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($Start/tns:CodiceOLO)) or not(exists($Start/tns:CodiceISP))&quot;>&lt;xsl:for-each select=&quot;$JDBCQuery1/Record&quot;>&lt;tns:RecordCriteriRollOut_NP>&lt;tns:DataInizio>&lt;xsl:value-of select=&quot;DATAINZ&quot;/>&lt;/tns:DataInizio>&lt;tns:DataFine>&lt;xsl:value-of select=&quot;DATAFI&quot;/>&lt;/tns:DataFine>&lt;tns:ID_Sistema>&lt;xsl:value-of select=&quot;ID_SISTEMA&quot;/>&lt;/tns:ID_Sistema>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;COD_ISP&quot;/>&lt;/tns:CodiceISP>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;DISTR&quot;/>&lt;/tns:Distretto>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(LOCZRECRITRROLLTNPCONTAORDN0)>=xsd:int(LOCZRECRITRROLLTNPVOLUMIINNOW0) and (COD_ISP=&amp;quot;002&amp;quot; or COD_OLO=&amp;quot;TLC&amp;quot;)&quot;>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:when>&lt;xsl:when test=&quot;xsd:int(LOCZRECRITRROLLTNPCONTAORDN0)>=xsd:int(LOCZRECRITRROLLTNPVOLUMIINNOW0) and not(COD_ISP=&amp;quot;002&amp;quot; or COD_OLO=&amp;quot;TLC&amp;quot;)&quot;>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;DESCR_SISTEMA_NOME_SISTEMA&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RecordCriteriRollOut_NP>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:RecordCriteriRollOut_NP>&lt;tns:DataInizio>&lt;xsl:value-of select=&quot;DATAINZ&quot;/>&lt;/tns:DataInizio>&lt;tns:DataFine>&lt;xsl:value-of select=&quot;DATAFI&quot;/>&lt;/tns:DataFine>&lt;tns:ID_Sistema>&lt;xsl:value-of select=&quot;ID_SISTEMA&quot;/>&lt;/tns:ID_Sistema>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;COD_ISP&quot;/>&lt;/tns:CodiceISP>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;DISTR&quot;/>&lt;/tns:Distretto>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(LOCZRECRITRROLLTNPCONTAORDN0)>=xsd:int(LOCZRECRITRROLLTNPVOLUMIINNOW0) and (COD_ISP=&amp;quot;002&amp;quot; or COD_OLO=&amp;quot;TLC&amp;quot;)&quot;>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:when>&lt;xsl:when test=&quot;xsd:int(LOCZRECRITRROLLTNPCONTAORDN0)>=xsd:int(LOCZRECRITRROLLTNPVOLUMIINNOW0) and not(COD_ISP=&amp;quot;002&amp;quot; or COD_OLO=&amp;quot;TLC&amp;quot;)&quot;>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;DESCR_SISTEMA_NOME_SISTEMA&quot;/>&lt;/tns:Nome_Sistema>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RecordCriteriRollOut_NP>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaVerificaCriteriRollOut_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
