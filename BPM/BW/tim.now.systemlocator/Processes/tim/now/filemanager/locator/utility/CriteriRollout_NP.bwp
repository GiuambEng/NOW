            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns4:RispostaVerificaCriteriRollOut_NP" name="v_VerificaCriteriRollout_NP"/>
        <bpws:variable element="ns4:RispostaVerificaCriteriRollOut_NP"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns4:RichiestaVerificaCriteriRollOut_NP"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns5:jdbcQueryActivityInput"
