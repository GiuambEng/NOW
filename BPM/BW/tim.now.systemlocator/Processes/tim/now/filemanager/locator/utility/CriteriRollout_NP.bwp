            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="9013de22-d0a1-400f-ba7c-0020fdfa826e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;v_VerificaCriteriRollout_NP&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RispostaVerificaCriteriRollOut_NP>&lt;xsl:for-each select=&quot;$v_VerificaCriteriRollout_NP/tns:RecordCriteriRollOut_NP&quot;>&lt;tns:RecordCriteriRollOut_NP>&lt;tns:DataInizio>&lt;xsl:value-of select=&quot;tns:DataInizio&quot;/>&lt;/tns:DataInizio>&lt;tns:DataFine>&lt;xsl:value-of select=&quot;tns:DataFine&quot;/>&lt;/tns:DataFine>&lt;tns:ID_Sistema>&lt;xsl:value-of select=&quot;tns:ID_Sistema&quot;/>&lt;/tns:ID_Sistema>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;tns:CodiceOLO&quot;/>&lt;/tns:CodiceOLO>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;tns:CodiceISP&quot;/>&lt;/tns:CodiceISP>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;tns:Distretto&quot;/>&lt;/tns:Distretto>&lt;tns:Nome_Sistema>&lt;xsl:value-of select=&quot;tns:Nome_Sistema&quot;/>&lt;/tns:Nome_Sistema>&lt;/tns:RecordCriteriRollOut_NP>&lt;/xsl:for-each>&lt;/tns:RispostaVerificaCriteriRollOut_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="StartLog-input"
                    name="StartLog"
                    tibex:xpdlId="2d94afb3-cd38-4c9c-8ae3-3513e4fc447c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartLogToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="not(exists($Start/ns4:CodiceOLO)) or not(exists($Start/ns4:CodiceISP))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[not(exists($Start/ns4:CodiceOLO)) or not(exists($Start/ns4:CodiceISP))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Start Subprocess &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot; - Input= &amp;quot;, tib:render-xml($Start,true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="be017bd5-af81-423f-97b4-3d7ca4f0b6d2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+be017bd5-af81-423f-97b4-3d7ca4f0b6d2+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;DISTRETTO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Distretto&quot;/>&#xa;            &lt;/DISTRETTO>&#xa;            &lt;COD_ISP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceISP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceISP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ISP>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;            &lt;DATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($Start/tns:DataRichiesta)&quot;/>&#xa;            &lt;/DATA_RICHIESTA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT LOCZRE_CRITR_ROLLT_NP.COD_ISP, LOCZRE_CRITR_ROLLT_NP.COD_OLO,&#xa;LOCZRE_CRITR_ROLLT_NP.DATAFI, LOCZRE_CRITR_ROLLT_NP.DATAINZ, &#xa;LOCZRE_CRITR_ROLLT_NP.DISTR, LOCZRE_CRITR_ROLLT_NP.ID_SISTEMA, &#xa;SISTEMA.DESCR_SISTEMA_NOME_SISTEMA, NVL(LOCZRE_CRITR_ROLLT_NP.CONTA_ORDN,0) as LOCZRECRITRROLLTNPCONTAORDN0, NVL(LOCZRE_CRITR_ROLLT_NP.VOLUMI_IN_NOW,0) as LOCZRECRITRROLLTNPVOLUMIINNOW0&#xa;FROM LOCZRE_CRITR_ROLLT_NP&#xa;INNER JOIN SISTEMA&#xa;ON LOCZRE_CRITR_ROLLT_NP.ID_SISTEMA=SISTEMA.ID_SISTEMA&#xa;WHERE (LOCZRE_CRITR_ROLLT_NP.DISTR=? OR LOCZRE_CRITR_ROLLT_NP.DISTR='*') AND LOCZRE_CRITR_ROLLT_NP.COD_ISP=? AND &#xa;LOCZRE_CRITR_ROLLT_NP.COD_OLO=? AND (? between LOCZRE_CRITR_ROLLT_NP.DATAINZ and LOCZRE_CRITR_ROLLT_NP.DATAFI)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_RICHIESTA"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_ISP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAFI"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="DATAINZ"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DISTR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="ID_SISTEMA"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="DESCR_SISTEMA_NOME_SISTEMA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="LOCZRECRITRROLLTNPCONTAORDN0"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="LOCZRECRITRROLLTNPVOLUMIINNOW0"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
