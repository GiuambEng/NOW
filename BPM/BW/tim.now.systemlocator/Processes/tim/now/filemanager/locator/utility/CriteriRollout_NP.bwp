            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQuery1-input" name="JDBCQuery1"
                    outputVariable="JDBCQuery1"
                    tibex:xpdlId="33fac3ed-92e7-4669-b0d7-33a476bfbae9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+33fac3ed-92e7-4669-b0d7-33a476bfbae9+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;DISTRETTO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Distretto&quot;/>&#xa;            &lt;/DISTRETTO>&#xa;            &lt;COD_ISP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceISP)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceISP&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_ISP>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;            &lt;DATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($Start/tns:DataRichiesta)&quot;/>&#xa;            &lt;/DATA_RICHIESTA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="SELECT LOCZRE_CRITR_ROLLT_NP.COD_ISP, LOCZRE_CRITR_ROLLT_NP.COD_OLO,&#xa;LOCZRE_CRITR_ROLLT_NP.DATAFI, LOCZRE_CRITR_ROLLT_NP.DATAINZ, &#xa;LOCZRE_CRITR_ROLLT_NP.DISTR, LOCZRE_CRITR_ROLLT_NP.ID_SISTEMA, &#xa;SISTEMA.DESCR_SISTEMA_NOME_SISTEMA, NVL(LOCZRE_CRITR_ROLLT_NP.CONTA_ORDN,0) as LOCZRECRITRROLLTNPCONTAORDN0, NVL(LOCZRE_CRITR_ROLLT_NP.VOLUMI_IN_NOW,0) as LOCZRECRITRROLLTNPVOLUMIINNOW0&#xa;FROM LOCZRE_CRITR_ROLLT_NP&#xa;INNER JOIN SISTEMA&#xa;ON LOCZRE_CRITR_ROLLT_NP.ID_SISTEMA=SISTEMA.ID_SISTEMA&#xa;WHERE (LOCZRE_CRITR_ROLLT_NP.DISTR=? OR LOCZRE_CRITR_ROLLT_NP.DISTR='*') AND (LOCZRE_CRITR_ROLLT_NP.COD_ISP=? OR LOCZRE_CRITR_ROLLT_NP.COD_OLO=?) and (? between LOCZRE_CRITR_ROLLT_NP.DATAINZ and LOCZRE_CRITR_ROLLT_NP.DATAFI)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTRETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_RICHIESTA"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_ISP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAFI"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="DATAINZ"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DISTR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="ID_SISTEMA"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="DESCR_SISTEMA_NOME_SISTEMA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="LOCZRECRITRROLLTNPCONTAORDN0"
