                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:tns1=&quot;http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_error_callCRMWScheckConsistenzaALL&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error_callCRMWScheckConsistenzaALL/tns1:ActivityTimedOutException)&quot;>&lt;tns:DefaultFault>&lt;xsl:if test=&quot;$_error_callCRMWScheckConsistenzaALL/tns1:ActivityTimedOutException/msg&quot;>&lt;message>&lt;xsl:value-of select=&quot;$_error_callCRMWScheckConsistenzaALL/tns1:ActivityTimedOutException/msg&quot;/>&lt;/message>&lt;/xsl:if>&lt;xsl:if test=&quot;$_error_callCRMWScheckConsistenzaALL/tns1:ActivityTimedOutException/msgCode&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;$_error_callCRMWScheckConsistenzaALL/tns1:ActivityTimedOutException/msgCode&quot;/>&lt;/msgCode>&lt;/xsl:if>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;concat($_error/Msg,$_error/StackTrace)&quot;/>&lt;/message>&lt;xsl:if test=&quot;$_error/MsgCode&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;$_error/MsgCode&quot;/>&lt;/msgCode>&lt;/xsl:if>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DefaultFault/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallStagKOToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
