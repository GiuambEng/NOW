                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ListaRisorse" name="Assign"
                    outputVariable="ListaRisorse"
                    tibex:xpdlId="1c457783-6905-4c2c-b303-90649073a2d3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
