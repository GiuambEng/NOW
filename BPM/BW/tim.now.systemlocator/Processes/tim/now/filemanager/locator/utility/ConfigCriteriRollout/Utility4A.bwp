                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT (DATAINZ, DATAFI, IDTPLG_LAVRZ,&#xa;  ID_TRASCODFC_OFFERTA, COD_OLO, COD_ISP, COD_ISTAT_COMUNE, ID_SISTEMA, VOLUMI_IN_NOW)&#xa;  SELECT (SELECT TO_DATE(SYSDATE) FROM DUAL), TO_DATE('31-12-2999','dd-mm-yyyy'), LA.IDTPLG_LAVRZ, LA.ID_TRASCODFC_OFFERTA,&#xa;  ?, ?, ?, SYS.ID_SISTEMA, ?&#xa;    FROM APPUSER.LOCZRE_AMBITO LA, APPUSER.SISTEMA SYS&#xa;    WHERE SYS.DESCR_SISTEMA_NOME_SISTEMA = 'NOW'&#xa;&#x9;AND LA.ID_TRASCODFC_OFFERTA IN (SELECT ID_TRASCODFC_OFFERTA FROM TRASCODFC_OFFERTA WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML')&#xa;&#x9;AND LA.IDTPLG_LAVRZ IN (SELECT IDTPLG_LAVRZ FROM TIPOLG_LAVRZ WHERE UPPER(TIPOLG_LAVRZ) = ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

