                                    <bpws:target linkName="WriteFileToGroupEnd"/>
                                    <bpws:target linkName="WriteFile1ToGroupEnd"/>
                                    <bpws:target linkName="Log7ToGroupEnd"/>
                                    <bpws:target linkName="Log6ToGroupEnd"/>
                                    <bpws:target linkName="Log8ToGroupEnd"/>
                                    <bpws:target linkName="WriteFile2ToGroupEnd"/>
                                    <bpws:target linkName="Log9ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCUpdateInput2-input"
                                    name="JDBCUpdateInput2"
                                    outputVariable="JDBCUpdateInput2"
                                    tibex:xpdlId="192d7344-0fd4-45b5-bf2d-5bcfcedd4230" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToLog2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+192d7344-0fd4-45b5-bf2d-5bcfcedd4230+input&quot; xmlns:dataformat=&quot;http://ns.tibco.com/bw/palette/dataformat/c80898d7-17cc-44d4-b2e9-698db0ab957a&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;JDBCUpdateInput2-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CodOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodOLO>&lt;CodiceComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodCOM)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceComune>&lt;Servizio>&lt;xsl:value-of select=&quot;upper-case($ParseData/Rows/dataformat:root[number($index)]/Servizio)&quot;/>&lt;/Servizio>&lt;Lavorazione>&lt;xsl:value-of select=&quot;upper-case($ParseData/Rows/dataformat:root[number($index)]/Lavorazione)&quot;/>&lt;/Lavorazione>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.LOCZRE_CRITR_ROLLT&#xd;&#xa;  SET DATAFI = (SELECT TO_DATE(SYSDATE) FROM DUAL)&#xd;&#xa;  WHERE COD_OLO = ? AND DATAFI = TO_DATE('31-12-2999','dd-mm-yyyy') AND COD_ISTAT_COMUNE = ?&#xd;&#xa;AND ID_TRASCODFC_OFFERTA IN (SELECT TRASC.ID_TRASCODFC_OFFERTA&#xd;&#xa;  FROM APPUSER.TRASCODFC_OFFERTA TRASC&#xd;&#xa;  WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML')&#xd;&#xa;  AND IDTPLG_LAVRZ IN (SELECT LAVOR.IDTPLG_LAVRZ&#xd;&#xa;  FROM APPUSER.TIPOLG_LAVRZ LAVOR&#xd;&#xa;  WHERE UPPER(TIPOLG_LAVRZ) = ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceComune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>
                                    </value>
                                    </properties>
