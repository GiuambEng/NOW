            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="deb2d413-dbf8-488c-a1c5-fbbf33f0f663">
                <bpws:targets>
                    <bpws:target linkName="Log1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRenameFile"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($ParseData/Rows/dataformat:root)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ParseData/Rows/dataformat:root)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCUpdate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCUpdateToLog2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToJDBCUpdate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCUpdate1ToLog3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log2ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log3ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToLog4" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Log4ToWriteFile" tibex:linkType="SUCCESS"/>
                                <bpws:link name="WriteFileToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToJDBCQuery1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQuery1ToLog5" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Log5ToWriteFile1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="WriteFile1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToJDBCUpdate2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="EmptyToJDBCUpdate3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateNOTimToJDBCUpdate2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateTimToJDBCUpdate3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log7ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log6ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate3ToLog8" tibex:linkType="ERROR"/>
                                <bpws:link name="Log8ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate2ToLog9" tibex:linkType="ERROR"/>
                                <bpws:link name="JDBCQuery2ToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCQuery2ToLog10" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Log10ToWriteFile2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="WriteFile2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log9ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateToLogRecordAggiornati2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdate1ToLogRecordAggiornati1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdate2ToLogInsertDB2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQueryServRichToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCQueryTimToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQueryTimToLogServRich" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdate3ToLogInsertDB1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="a82bdcbb-58b9-4a4c-8c72-d1de6ed84c70">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToJDBCUpdate1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ParseData/Rows/dataformat:root[number($index)]/CodCOM='*'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ParseData/Rows/dataformat:root[number($index)]/CodCOM='*']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="25440024-767c-4b88-bce8-930084e99026">
