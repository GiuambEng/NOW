            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogOLO-input"
                    name="LogOLO"
                    tibex:xpdlId="f7a3d6e8-b6b9-476a-9f26-b8980639434d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseDataToLog1"/>
