                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_DENORM (COD_COMUNE, COD_ISP,COD_OLO,&#xd;&#xa;  CONFLICT_ID, CREATED, CREATED_BY, DATAFI, DATAINZ, DB_LAST_UPD, DESCR_SISTEMA, &#xd;&#xa;  LAST_UPD, LAST_UPD_BY, MODIFICATION_NUM, NOME_OFFERTA_ESTERNA, ROW_ID, ROW_ID_NOW, TIPOLG_LAVRZ, VOLUMI_IN_NOW)&#xd;&#xa;  VALUES(?, ?, ?,&#xd;&#xa;  '0', (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', TO_DATE('31-12-2999','dd-mm-yyyy'), (SELECT TO_DATE(SYSDATE) FROM DUAL),  (SELECT TO_DATE(SYSDATE) FROM DUAL), 'NOW', &#xd;&#xa;  (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', 0, UPPER(?), s_loczre_critr_rollt_denorm.nextval, '1-NOW-' || s_loczre_critr_rollt_denorm.currval, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceComune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceISP"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MoveToProcessed-input"
                    name="MoveToProcessed"
                    outputVariable="MoveToProcessed"
                    tibex:xpdlId="b74efb69-7cfb-4bcc-b205-de7c17ab2bfd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToRenameFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenameFileToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ProcessedFolder&quot;/>&lt;xsl:param name=&quot;ProcessedSubfix&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:template name=&quot;RenameFile-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;fromFileName>&lt;xsl:value-of select=&quot;$FilePoller/fileInfo/fullName&quot;/>&lt;/fromFileName>&lt;toFileName>&lt;xsl:value-of select=&quot;concat(substring-before($FilePoller/fileInfo/fullName,$FilePoller/fileInfo/fileName),$ProcessedFolder,$FilePoller/fileInfo/fileName,$ProcessedSubfix)&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.rename"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true"
                                    overwrite="true" xsi:type="file:RenameFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="1082cb57-2e3a-479d-bbe2-a929629f00aa">
                <bpws:targets>
                    <bpws:target linkName="RenameFileToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
