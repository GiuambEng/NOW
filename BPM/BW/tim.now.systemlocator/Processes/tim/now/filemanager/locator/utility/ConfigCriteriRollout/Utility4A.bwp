                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT *&#xa;&#x9;FROM APPUSER.LOCZRE_AMBITO LA&#xa;&#x9;WHERE LA.AMBITO IN ('RT', 'DT') AND LA.ID_TRASCODFC_OFFERTA IN (SELECT ID_TRASCODFC_OFFERTA FROM TRASCODFC_OFFERTA WHERE UPPER(NOME_OFFERTA_ESTERNA) = ? AND PROVENIENZA = 'XML')&#xa;&#x9;AND LA.IDTPLG_LAVRZ IN (SELECT IDTPLG_LAVRZ FROM TIPOLG_LAVRZ WHERE UPPER(TIPOLG_LAVRZ) = ?)" xsi:type="jdbcPalette:JDBCQueryActivity">

