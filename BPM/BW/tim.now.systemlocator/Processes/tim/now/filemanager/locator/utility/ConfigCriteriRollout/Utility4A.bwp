                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_DENORM (COD_COMUNE, COD_ISP,COD_OLO,&#xd;&#xa;  CONFLICT_ID, CREATED, CREATED_BY, DATAFI, DATAINZ, DB_LAST_UPD, DESCR_SISTEMA, &#xd;&#xa;  LAST_UPD, LAST_UPD_BY, MODIFICATION_NUM, NOME_OFFERTA_ESTERNA, ROW_ID, ROW_ID_NOW, TIPOLG_LAVRZ, VOLUMI_IN_NOW)&#xd;&#xa;  VALUES(?, ?, ?,&#xd;&#xa;  '0', (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', TO_DATE('31-12-2999','dd-mm-yyyy'), (SELECT TO_DATE(SYSDATE) FROM DUAL),  (SELECT TO_DATE(SYSDATE) FROM DUAL), 'NOW', &#xd;&#xa;  (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', 0, UPPER(?), s_loczre_critr_rollt_denorm.nextval, '1-NOW-' || s_loczre_critr_rollt_denorm.currval, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

