                                    <bpws:while name="while1" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($index1&lt;=count($currentElement/ns9:Consistenza[ns9:Servizio!=&quot;NP&quot;])) and $EsitoRolloutVar!=&quot;CRMWS&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($index1<=count($currentElement/ns9:Consistenza[ns9:Servizio!="NP"])) and $EsitoRolloutVar!="CRMWS"]]></bpws:condition>
                                    <bpws:flow name="flow6">
