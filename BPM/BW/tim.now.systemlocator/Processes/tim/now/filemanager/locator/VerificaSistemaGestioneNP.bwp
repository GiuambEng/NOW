                                    outputVariable="AccumulateNP"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="0348253c-210f-42cc-a5e7-650b89e93b8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
