                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="if (substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,2,1)=&quot;2&quot; or substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,2,1)=&quot;6&quot;) then substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,1,2) else if (substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,3,1)=&quot;0&quot; or substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,3,1)=&quot;1&quot; or substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,3,1)=&quot;5&quot; or substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,3,1)=&quot;9&quot;) then substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,1,3) else substring($currentElement/ns9:Consistenza[ns9:Servizio=&quot;NP&quot;][number($index1)]/ns9:Risorsa,1,4)"
