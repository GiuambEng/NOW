                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Esito-input"
                                    name="Esito"
                                    outputVariable="Esito"
                                    tibex:xpdlId="8eaefc81-c9c4-4e64-a5a4-3139a1bbb861" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
