                                    <bpws:sources>
                                    <bpws:source linkName="RolloutNPToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut_NP&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaSistemaGestioneNP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;RolloutNP-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaVerificaCriteriRollOut_NP>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns:Distretto>&lt;tns:DataRichiesta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRichiesta>&lt;xsl:if test=&quot;$currentElement/tns1:Consistenza[tns1:Servizio=&amp;quot;NP&amp;quot;][number($index1)]/tns1:OLO&quot;>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;$currentElement/tns1:Consistenza[tns1:Servizio=&amp;quot;NP&amp;quot;][number($index1)]/tns1:OLO&quot;/>&lt;/tns:CodiceOLO>&lt;/xsl:if>&lt;/tns:RichiestaVerificaCriteriRollOut_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
