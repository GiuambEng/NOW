                                    <bpws:target linkName="LogToEsito"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="EsitoToLog5"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/VerificaSistemaGestioneNP&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Blacklist&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;AttivoNP&quot;/>&#xa;    &lt;xsl:param name=&quot;Blacklist&quot;/>&#xa;    &lt;xsl:template name=&quot;Esito-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Esito>&#xa;            &lt;tns:DN>&#xa;                &lt;xsl:value-of select=&quot;$currentElement&quot;/>&#xa;            &lt;/tns:DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Blacklist/tns1:Esito=&amp;quot;KO&amp;quot; or $AttivoNP/tns2:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;>&#xa;                    &lt;tns:SistemaDiCompetenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/tns:SistemaDiCompetenza>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:SistemaDiCompetenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                    &lt;/tns:SistemaDiCompetenza>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$AttivoNP/tns2:Consistenza&quot;>&#xa;                &lt;tns:Consistenza>&#xa;                    &lt;tns:Risorsa>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement&quot;/>&#xa;                    &lt;/tns:Risorsa>&#xa;                    &lt;xsl:if test=&quot;tns2:Servizio&quot;>&#xa;                        &lt;tns:Servizio>&#xa;                            &lt;xsl:value-of select=&quot;tns2:Servizio&quot;/>&#xa;                        &lt;/tns:Servizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns2:OLO&quot;>&#xa;                        &lt;tns:OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns2:OLO&quot;/>&#xa;                        &lt;/tns:OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Consistenza>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Esito>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:VerificaSistemaGestioneNP="http://www.tim.com/NOW/xsd/VerificaSistemaGestioneNP"
