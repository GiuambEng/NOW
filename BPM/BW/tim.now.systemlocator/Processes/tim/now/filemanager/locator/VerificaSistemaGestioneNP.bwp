                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/VerificaSistemaNP/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaSistemaGestioneNP&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaSistemaGestioneNPIn.Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;EsitiRollout&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Risposta>&#xa;            &lt;DataRisposta>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/DataRisposta>&#xa;            &lt;xsl:for-each select=&quot;$VerificaSistemaGestioneNPIn.Richiesta/DN&quot;>&#xa;                &lt;Sistema_DN>&#xa;                    &lt;xsl:variable name=&quot;risorsa&quot; select=&quot;.&quot;/>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/DN>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($EsitiRollout/tns1:Esito[tns1:DN=$risorsa and tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;]) and not(exists($EsitiRollout/tns1:Esito[tns1:DN=$risorsa and tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;]))&quot;>&#xa;                            &lt;SistemaDiCompetenza>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                            &lt;/SistemaDiCompetenza>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;SistemaDiCompetenza>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                            &lt;/SistemaDiCompetenza>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Sistema_DN>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;RC>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;            &lt;/RC>&#xa;        &lt;/tns:Risposta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Risposta" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
