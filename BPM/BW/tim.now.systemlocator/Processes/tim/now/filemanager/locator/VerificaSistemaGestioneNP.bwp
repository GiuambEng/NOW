                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($VerificaSistemaGestioneNPIn.Richiesta/DN)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_Current_Element_DN"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="LogToBlacklist" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="LogToEsito" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link name="EsitoToLog5" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="CallProcessToLog" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Log5ToEsiti" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="2e245784-94fb-4140-b610-caa7de5c9b5d" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($VerificaSistemaGestioneNPIn.Richiesta/DN)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Esiti"
                                    outputVariable="Esiti"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="ccb9d60a-cbe9-4546-a1b9-08dcf9b12e62" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log5ToEsiti"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Esito</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/VerificaSistemaGestioneNP&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Blacklist&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;AttivoNP&quot;/>&#xa;    &lt;xsl:param name=&quot;Blacklist&quot;/>&#xa;    &lt;xsl:template name=&quot;Esito-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Esito>&#xa;            &lt;tns:DN>&#xa;                &lt;xsl:value-of select=&quot;$currentElement&quot;/>&#xa;            &lt;/tns:DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Blacklist/tns1:Esito=&amp;quot;KO&amp;quot; or $AttivoNP/tns2:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;>&#xa;                    &lt;tns:SistemaDiCompetenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/tns:SistemaDiCompetenza>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:SistemaDiCompetenza>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                    &lt;/tns:SistemaDiCompetenza>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$AttivoNP/tns2:Consistenza&quot;>&#xa;                &lt;tns:Consistenza>&#xa;                    &lt;tns:Risorsa>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement&quot;/>&#xa;                    &lt;/tns:Risorsa>&#xa;                    &lt;xsl:if test=&quot;tns2:Servizio&quot;>&#xa;                        &lt;tns:Servizio>&#xa;                            &lt;xsl:value-of select=&quo