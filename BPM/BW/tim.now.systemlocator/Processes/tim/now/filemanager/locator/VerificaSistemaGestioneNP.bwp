                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="if (exists($RolloutNP/ns24:RecordCriteriRollOut_NP)) then&#xd;&#xa;if(exists($RolloutNP/ns24:RecordCriteriRollOut_NP[ns24:Nome_Sistema=&quot;CRMWS&quot;])) then &quot;CRMWS&quot; else &quot;NOW&quot; else &quot;CRMWS&quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="EsitoRolloutVar"
                                    name="Assign3"
                                    outputVariable="EsitoRolloutVar"
                                    tibex:xpdlId="49309d22-db75-4bc2-bf2e-166899724c2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RolloutNPToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign3ToAccumulateNP"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="if (exists($RolloutNP/ns24:RecordCriteriRollOut_NP)) then&#xd;&#xa;if(exists($RolloutNP/ns24:RecordCriteriRollOut_NP[ns24:Nome_Sistema=&quot;CRMWS&quot;])) then &quot;CRMWS&quot; else &quot;NOW&quot; else &quot;CRMWS&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
