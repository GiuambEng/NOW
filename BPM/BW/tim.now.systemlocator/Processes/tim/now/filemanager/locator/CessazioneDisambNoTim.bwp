                                <tibex:expression
                                    expression="exists($ConsistenzaNOW_DIN/tns3:Consistenza[(upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTCAB&quot; and upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTH&quot;) or tns3:Stato= &quot;CESSATO&quot; ]) and not($ConsistenzaNOW_DIN/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
