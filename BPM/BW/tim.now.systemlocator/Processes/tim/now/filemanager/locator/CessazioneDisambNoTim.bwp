            <bpws:empty name="Empty1" tibex:xpdlId="a89b2324-ad68-433d-bd4f-baed2b10b917">
                <bpws:targets>
                    <bpws:target linkName="LogToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToDIN">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToEmpty3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Consistenza/tns3:Consistenza[(upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTCAB&quot; and upper-case(tns3:Servizio)!=&quot;EASYIPNGAFTTH&quot;) or tns3:Stato= &quot;CESSATO&quot; ]) and not($Consistenza/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Consistenza/tns3:Consistenza[(upper-case(tns3:Servizio)!="EASYIPNGAFTTCAB" and upper-case(tns3:Servizio)!="EASYIPNGAFTTH") or tns3:Stato= "CESSATO" ]) and not($Consistenza/tns3:ErroreRadicale="Y")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Consistenza/tns3:ErroreRadicale=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Consistenza/tns3:ErroreRadicale="Y"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssignUBB">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Consistenza/tns3:Consistenza[(upper-case(tns3:Servizio)=&quot;EASYIPNGAFTTCAB&quot; or upper-case(tns3:Servizio)=&quot;EASYIPNGAFTTH&quot;) and tns3:Stato!=&quot;CESSATO&quot; ]) and not($Consistenza/tns3:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Consistenza/tns3:Consistenza[(upper-case(tns3:Servizio)="EASYIPNGAFTTCAB" or upper-case(tns3:Servizio)="EASYIPNGAFTTH") and tns3:Stato!="CESSATO" ]) and not($Consistenza/tns3:ErroreRadicale="Y")]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="CriterRollouti-input"
                name="CriterRollouti" operation="VerificaCriteriRollout"
                outputVariable="CriterRollouti"
                partnerLink="CriteriRollout"
                portType="ns2:CriteriRollout" tibex:xpdlId="4e06907d-0249-4a24-898c-68195b716efe">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns2="http://www.tim.com/NOW/xsd/CriteriRollOut" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns1:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaCriteriRollOut&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;tns2:DataRichiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/tns2:DataRichiesta&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"&gt;&lt;tns2:CodiceISP&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"/&gt;&lt;/tns2:CodiceISP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns2:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns1:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns2:DataRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&#xa;                &lt;tns2:CodiceISP>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&#xa;                &lt;/tns2:CodiceISP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&#xa;                &lt;tns2:CodiceComune>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;/>&#xa;                &lt;/tns2:CodiceComune>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty3ToCriterRollouti"/>
                    <bpws:target linkName="Empty4ToCriterRollouti"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="InvokeToCallProcess1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CriterRollouti&quot;/>&lt;xsl:param name=&quot;RecuperoComune&quot;/>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0 and count($CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut)>0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;$CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:if test=&quot;$CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:if>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza) > 0&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;$CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:if test=&quot;$CriterRollouti/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:if>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta" name="Assign"
                    outputVariable="Risposta"
                    tibex:xpdlId="1475e5a2-ac9a-44f0-bad6-a6f2cbbc773e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToAssign"/>
                        <bpws:target linkName="CallProcess1ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CriterRollouti.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoComune&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0 and count($CriterRollouti.parameters/tns1:RecordCriteriRollOut)>0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;$CriterRollouti.parameters/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;xsl:if test=&quot;$CriterRollouti.parameters/tns1:RecordCriteriRollOut[1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                            &lt;tns:ErrMSG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                            &lt;/tns:ErrMSG>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CriterRollouti.parameters/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza) > 0&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;$CriterRollouti.parameters/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;xsl:if test=&quot;$CriterRollouti.parameters/tns1:RecordCriteriRollOut[tns1:CodiceComune = $RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;][1]/tns1:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                            &lt;tns:ErrMSG>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                            &lt;/tns:ErrMSG>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Risposta" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
