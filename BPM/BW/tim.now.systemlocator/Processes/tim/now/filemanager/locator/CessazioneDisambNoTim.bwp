                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoComune&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:CodOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns1:CodOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&#xa;                &lt;tns1:CodISP>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&#xa;                &lt;/tns1:CodISP>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;tns1:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&#xa;            &lt;/tns1:Servizio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&#xa;                        &lt;tns1:CodiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tn