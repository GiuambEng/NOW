                            expression="if(string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)>0) then $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa else $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Telefonico" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
