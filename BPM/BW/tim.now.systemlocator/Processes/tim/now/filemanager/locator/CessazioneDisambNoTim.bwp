                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI=&quot;1&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI="1"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToLog4_UBB">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with(upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with(upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB')]]></bpws:transitionCondition>
                    </bpws:source>
