            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/SystemLocatorInternal/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/"/>
        </wsdl:definitions>
