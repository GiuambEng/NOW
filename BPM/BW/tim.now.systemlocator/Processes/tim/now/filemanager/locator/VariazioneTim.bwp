                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;CriteriRollout.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoConsistenza&quot;/>&#xa;    &lt;xsl:param name=&quot;ConsistenzaTGU&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoComune&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta_Localizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0 and (exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]) or exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]))&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&a