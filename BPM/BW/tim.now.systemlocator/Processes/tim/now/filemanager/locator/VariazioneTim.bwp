            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;RecuperaTGU&quot;/>&lt;xsl:template name=&quot;RecuperoComune-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecuperaTGU/ID_RISORSA)>0 and matches($RecuperaTGU/ID_RISORSA,&amp;quot;[0-9]*&amp;quot;)&quot;>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$RecuperaTGU/ID_RISORSA&quot;/>&lt;/tns:IDrisorsa>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperaTGU/ID_RISORSA)>0 and not(matches($RecuperaTGU/ID_RISORSA,&amp;quot;[0-9]*&amp;quot;))&quot;>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;substring($RecuperaTGU/ID_RISORSA, 4)&quot;/>&lt;/tns:IDrisorsa>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa)>0 and not(string-length($RecuperaTGU/ID_RISORSA)>0)&quot;>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa&quot;/>&lt;/tns:IDrisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico&quot;/>&lt;/tns:IDrisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RecuperoComune-input"
                    name="RecuperoComune"
                    outputVariable="RecuperoComune"
                    tibex:xpdlId="ea52abee-741e-424e-8bf9-7c8eae3010fc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCallProcess"/>
