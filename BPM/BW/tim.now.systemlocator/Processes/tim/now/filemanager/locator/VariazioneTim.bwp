t;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;13&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Risorsa TIM cessata su NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and not(exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and $GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine != &amp;quot;NOWDISAMB&amp;quot;&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Risorsa TIM cessata su NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#x