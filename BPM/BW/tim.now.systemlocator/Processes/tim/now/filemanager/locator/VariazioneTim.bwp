                    <bpws:sources>
                        <bpws:source linkName="RecuperoComuneToConsistenzaOK"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaTGU&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaTGU/ID_RISORSA)>0 and matches($RecuperaTGU/ID_RISORSA,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                    &lt;tns:IDrisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaTGU/ID_RISORSA&quot;/>&#xa;                    &lt;/tns:IDrisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaTGU/ID_RISORSA)>0 and not(matches($RecuperaTGU/ID_RISORSA,&amp;quot;[0-9]*&amp;quot;))&quot;>&#xa;                    &lt;tns:IDrisorsa>&#xa;                        &lt;xsl:value-of select=&quot;substring($RecuperaTGU/ID_RISORSA, 4)&quot;/>&#xa;                    &lt;/tns:IDrisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa)>0 and not(string-length($RecuperaTGU/ID_RISORSA)>0)&quot;>&#xa;                    &lt;tns:IDrisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa&quot;/>&#xa;                    &lt;/tns:IDrisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:IDrisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico&quot;/>&#xa;                    &lt;/tns:IDrisorsa>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO&quot;>&#xa;                &lt;tns:CodificaOLOagcom>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO&quot;/>&#xa;                &lt;/tns:CodificaOLOagcom>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.locator.utility.RecuperoComune" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="ed7ae6c5-4393-425e-92f2-abefda1db37f">
                <bpws:targets>
                    <bpws:target linkName="LogToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
