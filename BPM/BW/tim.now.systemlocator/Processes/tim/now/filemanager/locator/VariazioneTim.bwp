                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)>0 or $RecuperoConsistenza/tns1:ErroreRadicale="Y"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToCallProcess">
                        <tibex:DesignExpression>
