                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[not(string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0) and (exists($RecuperoConsistenza/tns1:Consistenza[tns1:Stato="ATTIVO" or tns1:Stato="INLAVORAZIONE"]) or exists($ConsistenzaTGU/tns1:Consistenza[tns1:Stato="ATTIVO" or tns1:Stato="INLAVORAZIONE"]))]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoConsistenza&quot;/>&#xa;    &lt;xsl:param name=&quot;ConsistenzaTGU&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoComune&quot;/>&#xa;    &lt;xsl:param name=&quot;CriteriRollout&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta_Localizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0 and (exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]) or exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]))&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0)  and exists($CriteriRollout/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:CodiceComune=$RecuperoComune/tns2:CodiceISTATcomune or tns1:CodiceComune=&amp;quot;*&amp;quot;]) and (exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]) or exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;]))&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and not(exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine = &amp;quot;NOWDISAMB&amp;quot;&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;13&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Risorsa TIM cessata su NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(exists($RecuperoConsistenza/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and not(exists($ConsistenzaTGU/tns3:Consistenza[tns3:Stato=&amp;quot;ATTIVO&amp;quot; or tns3:Stato=&amp;quot;INLAVORAZIONE&amp;quot;])) and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine != &amp;quot;NOWDISAMB&amp;quot;&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Risorsa TIM cessata su NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Richiesta/Servizio/Comune TIM  non rientrano nei criteri di roll-out&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
