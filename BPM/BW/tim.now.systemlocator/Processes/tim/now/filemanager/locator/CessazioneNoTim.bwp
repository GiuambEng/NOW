                    <bpws:source linkName="StartToLog4">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI=&quot;1&quot; and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!=&quot;VULL&quot; and  $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!=&quot;ULLDATI-NP&quot; and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!=&quot;ULL-NP&quot; and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!=&quot;CESSAZIONEWLRLINEAATTIVA&quot; and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!=&quot;SLU-NP&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Rientro_TI="1" and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!="VULL" and  $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!="ULLDATI-NP" and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!="ULL-NP" and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!="CESSAZIONEWLRLINEAATTIVA" and $GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio!="SLU-NP"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToLog5">
