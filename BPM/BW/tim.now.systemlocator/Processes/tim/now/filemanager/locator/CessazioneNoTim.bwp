                                <tibex:expression
                                    expression="((not(exists($ConsistenzaNOW/ns15:Consistenza[ns15:Stato!=&quot;CESSATO&quot;])) or not(exists($ConsistenzaNOW/ns15:Consistenza))) and string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)>0) or $ConsistenzaNOW/ns15:ErroreRadicale=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[((not(exists($ConsistenzaNOW/ns15:Consistenza[ns15:Stato!="CESSATO"])) or not(exists($ConsistenzaNOW/ns15:Consistenza))) and string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa)>0) or $ConsistenzaNOW/ns15:ErroreRadicale="Y"]]></bpws:transitionCondition>
                        </bpws:source>
