                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($ConsistenzaNOW/ns15:Consistenza[ns15:Stato!=&quot;CESSATO&quot; and (upper-case(ns15:Servizio)!=&quot;EASYIPNGAFTTCAB&quot; and upper-case(ns15:Servizio)!=&quot;EASYIPNGAFTTH&quot;)]) and not($ConsistenzaNOW/ns15:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
