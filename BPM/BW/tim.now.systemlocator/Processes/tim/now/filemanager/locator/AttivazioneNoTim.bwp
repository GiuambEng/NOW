                    <bpws:target linkName="Assign2ToEmpty11"/>
                    <bpws:target linkName="Assign2ToEmpty12"/>
                    <bpws:target linkName="Assign3ToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToIncrementaVolumi">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Risposta/tns:Risposta/tns:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
