            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&lt;xsl:template name=&quot;Comune-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns:IDrisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;])&quot;>&lt;xsl:if test=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Comune-input" name="Comune"
                    outputVariable="Comune"
                    tibex:xpdlId="32362398-d570-41d6-8570-608bf1aa7b0a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ComuneToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($VerificaCriteriRolloutTel/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[(tns1:CodiceComune=$Comune/tns2:CodiceISTATcomune or tns1:CodiceComune=&quot;*&quot;) and tns1:SistemaDiCompetenza=&quot;NOW&quot;])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($VerificaCriteriRolloutTel.parameters/tns1:RecordCriteriRollOut[(tns1:CodiceComune=$Comune/tns2:CodiceISTATcomune or tns1:CodiceComune="*") and tns1:SistemaDiCompetenza="NOW"])]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ComuneToRisorsaCessata">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW&quot;/>&lt;xsl:param name=&quot;ConsistenzaNOW_DIN&quot;/>&lt;xsl:template name=&quot;Comune-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:IDrisorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns:IDrisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;])&quot;>&lt;xsl:if test=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW/tns1:Consistenza[tns1:Stato!=&amp;quot;CESSATO&amp;quot;][1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ConsistenzaNOW_DIN/tns1:Consistenza[1]/tns1:OLO&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.locator.utility.RecuperoComune" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7bc69ba4-f955-4c6b-9aeb-04502518df76+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Servizio>&lt;xsl:value-of select=&quot;upper-case($GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;/>&lt;/Servizio>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LNA_LA-input" name="LNA_LA"
                    outputVariable="LNA_LA"
                    tibex:xpdlId="7bc69ba4-f955-4c6b-9aeb-04502518df76" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToRolloutDonating"/>
                        <bpws:target linkName="ComuneToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LNA_LAToWhile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$LNA_LA/Record[1]/LNA_LA=&quot;LA&quot; and (count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and tns3:Servizio!=&quot;NP&quot;])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!=&quot;NP&quot;])>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$LNA_LA/Record[1]/LNA_LA="LA" and (count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and tns3:Servizio!="NP"])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!="NP"])>0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LNA_LAToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LNA_LAToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$LNA_LA/Record[1]/LNA_LA=&quot;LA&quot; and not(count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!=&quot;CESSATO&quot; and tns3:Servizio!=&quot;NP&quot;])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!=&quot;NP&quot;])>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$LNA_LA/Record[1]/LNA_LA="LA" and not(count($ConsistenzaNOW/tns3:Consistenza[tns3:Stato!="CESSATO" and tns3:Servizio!="NP"])>0 or count($ConsistenzaNOW_DIN/tns3:Consistenza[tns3:Servizio!="NP"])>0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7bc69ba4-f955-4c6b-9aeb-04502518df76+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;Servizio>&#xa;                &lt;xsl:value-of select=&quot;upper-case($GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;/>&#xa;            &lt;/Servizio>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT LNA_LA FROM OFFERTA off,TRASCODFC_OFFERTA tro&#xa;WHERE off.ID_OFFERTA=tro.ID_OFFERTA AND upper(tro.NOME_OFFERTA_ESTERNA)=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Servizio"/>
                                    <columnMetadata
                                    columnName="LNA_LA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Comune&quot;/>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:template name=&quot;IncrementaVolumi-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:CodOLO>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&lt;tns1:CodISP>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&lt;/tns1:CodISP>&lt;/xsl:if>&lt;tns1:Richiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&lt;/tns1:Richiesta>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&lt;/tns1:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0&quot;>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&lt;tns1:CodiceISTATComune>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;/>&lt;/tns1:CodiceISTATComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Comune/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceISTATComune>&lt;xsl:value-of select=&quot;$Comune/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceISTATComune>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&lt;/tns1:DataRichiesta>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="IncrementaVolumi-input"
                    name="IncrementaVolumi"
                    tibex:xpdlId="fc7b0186-e762-45e3-9741-b99c11723620"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToIncrementaVolumi"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IncrementaVolumiToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncrementoVolumi&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune&quot;/>&#xa;    &lt;xsl:template name=&quot;IncrementaVolumi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:CodOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns1:CodOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;>&#xa;                &lt;tns1:CodISP>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP&quot;/>&#xa;                &lt;/tns1:CodISP>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns1:Richiesta>&#xa;            &lt;tns1:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio&quot;/>&#xa;            &lt;/tns1:Servizio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;>&#xa;                        &lt;tns1:CodiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune&quot;/>&#xa;                        &lt;/tns1:CodiceISTATComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Comune/tns2:CodiceISTATcomune&quot;>&#xa;                        &lt;tns1:CodiceISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$Comune/tns2:CodiceISTATcomune&quot;/>&#xa;                        &lt;/tns1:CodiceISTATComune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns1:DataRichiesta>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="tim.now.filemanager.locator.utility.IncrementoVolumi" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="b128bdcc-1c0a-4e8b-af99-4b5235b83e34">
                <bpws:targets>
                    <bpws:target linkName="AssignToEnd"/>
                    <bpws:target linkName="SistemaDonatingToEmpty1"/>
