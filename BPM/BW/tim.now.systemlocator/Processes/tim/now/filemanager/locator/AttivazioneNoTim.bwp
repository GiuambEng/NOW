                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Risorsa&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:RisorsaInput>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$Risorsa&quot;/>&lt;/tns:Risorsa>&lt;tns:FlagAttivo>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FlagAttivo>&lt;/tns:RisorsaInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
