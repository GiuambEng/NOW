                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;AccumulateRolloutDonating&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AccumulateRolloutDonating/tns1:Output[tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot;])&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($AccumulateRolloutDonating/tns1:Output[tns1:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;]) or not(exists($AccumulateRolloutDonating/tns1:Output/tns1:SistemaDiCompetenza))&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:if test=&quot;exists($AccumulateRolloutDonating/tns1:Output[tns1:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;]) or not(exists($AccumulateRolloutDonating/tns1:Output/tns1:SistemaDiCompetenza))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout donating non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:if>&lt;/tns:Risposta