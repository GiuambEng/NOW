            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp3:PortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://xmlns.now.com/CRMWSCheckConsistenza/"/>
            <wsdl:import namespace="http://xmlns.example.com/1460641967114"/>
        </wsdl:definitions>
    </tibex:Types>
