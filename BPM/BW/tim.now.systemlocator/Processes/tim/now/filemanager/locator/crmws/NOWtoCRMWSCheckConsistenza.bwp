                                portType="ns2:CMWSCheckConsistenzaPT"
                                tibex:xpdlId="b75ef80e-c2ed-4b73-bf9e-62733192e7c7" variable="checkConsistenzaOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.now.com/CRMWSCheckConsistenza/" xmlns:tns1="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2" version="2.0"&gt;&lt;xsl:param name="callCRMWSCheckConsistenza"/&gt;&lt;xsl:param name="codeOK"/&gt;&lt;xsl:template name="checkConsistenzaOut-input" match="/"&gt;&lt;tns:checkConsistenzaResponse&gt;&lt;parameters&gt;&lt;tns:checkConsistenzaResponse&gt;&lt;tns:rispostaLocator&gt;&lt;tns1:DataRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:DataRisposta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:RETURN_CODE = $codeOK"&gt;&lt;tns1:SistemaDiCompetenza&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/tns1:SistemaDiCompetenza&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:SistemaDiCompetenza&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/tns1:SistemaDiCompetenza&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:RC&gt;&lt;xsl:value-of select="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:RETURN_CODE"/&gt;&lt;/tns1:RC&gt;&lt;xsl:if test="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"&gt;&lt;tns1:ErrMSG&gt;&lt;xsl:value-of select="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"/&gt;&lt;/tns1:ErrMSG&gt;&lt;/xsl:if&gt;&lt;/tns:rispostaLocator&gt;&lt;tns:CRMWSResponse&gt;&lt;xsl:if test="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:STATO_RISORSA"&gt;&lt;STATO_RISORSA&gt;&lt;xsl:value-of select="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:STATO_RISORSA"/&gt;&lt;/STATO_RISORSA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_ATTIVAZZIONE"&gt;&lt;DATA_ATTIVAZIONE&gt;&lt;xsl:value-of select="$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_ATTIVAZZIONE"