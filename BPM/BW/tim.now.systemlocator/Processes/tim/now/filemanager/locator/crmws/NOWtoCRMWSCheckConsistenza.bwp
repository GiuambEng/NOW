                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.now.com/CRMWSCheckConsistenza/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;callCRMWSCheckConsistenza.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;codeOK&quot;/>&#xa;    &lt;xsl:template name=&quot;checkConsistenzaOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:checkConsistenzaResponse>&#xa;            &lt;tns:rispostaLocator>&#xa;                &lt;tns1:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:DataRisposta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:RETURN_CODE = $codeOK&quot;>&#xa;                        &lt;tns1:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                        &lt;/tns1:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns1:SistemaDiCompetenza>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:RC>&#xa;                    &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:RETURN_CODE&quot;/>&#xa;                &lt;/tns1:RC>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;tns1:ErrMSG>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/tns1:ErrMSG>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:rispostaLocator>&#xa;            &lt;tns:CRMWSResponse>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:STATO_RISORSA&quot;>&#xa;                    &lt;STATO_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:STATO_RISORSA&quot;/>&#xa;                    &lt;/STATO_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;>&#xa;                    &lt;DATA_ATTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;/>&#xa;                    &lt;/DATA_ATTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;>&#xa;                    &lt;DATA_CESSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;/>&#xa;                    &lt;/DATA_CESSAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_VARIAZIONE&quot;>&#xa;                    &lt;DATA_VARIAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_VARIAZIONE&quot;/>&#xa;                    &lt;/DATA_VARIAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;>&#xa;                    &lt;CODICE_OLO_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;/>&#xa;                    &lt;/CODICE_OLO_RIS>&#xa;                &lt;/xsl:if>&#xa;                &lt;RETURN_CODE>&#xa;                    &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:RETURN_CODE&quot;/>&#xa;                &lt;/RETURN_CODE>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;DESCRIZIONE_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/DESCRIZIONE_ERRORE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:CRMWSResponse>&#xa;        &lt;/tns:checkConsistenzaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
