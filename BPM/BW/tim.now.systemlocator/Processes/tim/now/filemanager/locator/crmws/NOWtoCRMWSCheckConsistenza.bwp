                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessTocheckConsistenzaOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.now.com/CRMWSCheckConsistenza/&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;checkConsistenza.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;callCRMWSCheckConsistenza.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;FlowInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:template name=&quot;CallStagOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingCheckConsistenza>&#xa;            &lt;tns:target>&#xa;                &lt;xsl:value-of select=&quot;'REQ'&quot;/>&#xa;            &lt;/tns:target>&#xa;            &lt;tns:processNoFileID>&#xa;                &lt;xsl:value-of select=&quot;$FlowInfo/tns:processCode&quot;/>&#xa;            &lt;/tns:processNoFileID>&#xa;            &lt;tns:description>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/tns:description>&#xa;            &lt;tns:StagVerificaRisorsa>&#xa;                &lt;tns:idRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns:requestID&quot;/>&#xa;                &lt;/tns:idRichiesta>&#xa;                &lt;tns:timestampRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$FlowInfo/tns:transactionDate&quot;/>&#xa;                &lt;/tns:timestampRichiesta>&#xa;                &lt;tns:timestampRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:timestampRisposta>&#xa;                &lt;tns:contenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request, true(),false())&quot;/>&#xa;                &lt;/tns:contenutoRequest>&#xa;                &lt;tns:contenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($callCRMWSCheckConsistenza.RESPONSE, true(),false())&quot;/>&#xa;                &lt;/tns:contenutoResponse>&#xa;                &lt;xsl:if test=&quot;$FlowInfo/tns:sourceSystem&quot;>&#xa;                    &lt;tns:sistemaOrigine>&#xa;                        &lt;xsl:value-of select=&quot;$FlowInfo/tns:sourceSystem&quot;/>&#xa;                    &lt;/tns:sistemaOrigine>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:codiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$checkConsistenza.parameters/request/CODICE_OLO&quot;/>&#xa;                &lt;/tns:codiceOLO>&#xa;                &lt;tns:idRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$checkConsistenza.parameters/request/ID_RISORSA&quot;/>&#xa;                &lt;/tns:idRisorsa>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:STATO_RISORSA&quot;>&#xa;                    &lt;tns:statoRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:STATO_RISORSA&quot;/>&#xa;                    &lt;/tns:statoRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;>&#xa;                    &lt;tns:dataAttivazione>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;/>&#xa;                    &lt;/tns:dataAttivazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;>&#xa;                    &lt;tns:dataCessazione>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;/>&#xa;                    &lt;/tns:dataCessazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;>&#xa;                    &lt;tns:codiceOLORis>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;/>&#xa;                    &lt;/tns:codiceOLORis>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:returnCode>&#xa;                    &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:RETURN_CODE&quot;/>&#xa;                &lt;/tns:returnCode>&#xa;                &lt;xsl:if test=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;tns:descrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza.RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/tns:descrizioneErrore>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:StagVerificaRisorsa>&#xa;            &lt;tns:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$checkConsistenza.parameters/request/IdEsecProcsoNoFile&quot;/>&#xa;            &lt;/tns:IdEsecProcsoNoFile>&#xa;        &lt;/tns:StagingCheckConsistenza>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
