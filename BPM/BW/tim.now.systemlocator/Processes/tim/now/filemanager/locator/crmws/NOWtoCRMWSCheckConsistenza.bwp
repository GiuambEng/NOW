                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1460641967114" xmlns:tns1="http://xmlns.now.com/CRMWSCheckConsistenza/" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd" xmlns:tns2="http://tim.now.com/NOWtoCRMSWSCheckConsistenza" version="2.0"&gt;&lt;xsl:param name="Request"/&gt;&lt;xsl:template name="callCRMWSCheckConsistenza-input" match="/"&gt;&lt;tns:Request&gt;&lt;REQUEST&gt;&lt;xsl:copy-of select="$Request"/&gt;&lt;/REQUEST&gt;&lt;/tns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1460641967114&quot; xmlns:tns1=&quot;http://xmlns.now.com/CRMWSCheckConsistenza/&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd&quot; xmlns:tns2=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:template name=&quot;callCRMWSCheckConsistenza-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Request&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="SetRequestTocallCRMWSCheckConsistenza"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="callCRMWSCheckConsistenzaTocheckConsistenzaOut_OK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$callCRMWSCheckConsistenza/RESPONSE/ns7:HEADER/ns7:RESPONSE/ns7:RETURN_CODE = $codeOK or $callCRMWSCheckConsistenza/RESPONSE/ns7:HEADER/ns7:RESPONSE/ns7:RETURN_CODE = $codeNA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$callCRMWSCheckConsistenza.RESPONSE/ns7:RESPONSE/ns7:RETURN_CODE = $codeOK or $callCRMWSCheckConsistenza.RESPONSE/ns7:RESPONSE/ns7:RETURN_CODE = $codeNA]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="callCRMWSCheckConsistenzaToLogError_KO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlowInfo&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogBegin-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Process: NOWtoCRMWSCheckConsistenza: &amp;quot;, &amp;quot;BEGIN> &amp;quot;, $FlowInfo/tns1:processInfoID)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
