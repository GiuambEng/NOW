                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tim.now.com/NOWtoCRMSWSCheckConsistenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.now.com/CRMWSCheckConsistenza/&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlowInfo&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;checkConsistenza&quot;/>&lt;xsl:param name=&quot;callCRMWSCheckConsistenza&quot;/>&lt;xsl:template name=&quot;CallStagOK-input&quot; match=&quot;/&quot;>&lt;tns:StagingCheckConsistenza>&lt;tns:target>&lt;xsl:value-of select=&quot;'REQ'&quot;/>&lt;/tns:target>&lt;tns:processNoFileID>&lt;xsl:value-of select=&quot;$FlowInfo/tns:processCode&quot;/>&lt;/tns:processNoFileID>&lt;tns:description>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:description>&lt;tns:StagVerificaRisorsa>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;$FlowInfo/tns:requestID&quot;/>&lt;/tns:idRichiesta>&lt;tns:timestampRichiesta>&lt;xsl:value-of select=&quot;$FlowInfo/tns:transactionDate&quot;/>&lt;/tns:timestampRichiesta>&lt;tns:timestampRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:timestampRisposta>&lt;tns:contenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($Request, true(),false())&quot;/>&lt;/tns:contenutoRequest>&lt;tns:contenutoResponse>&lt;xsl:value-of select=&quot;tib:render-xml($callCRMWSCheckConsistenza/RESPONSE, true(),false())&quot;/>&lt;/tns:contenutoResponse>&lt;xsl:if test=&quot;$FlowInfo/tns:sourceSystem&quot;>&lt;tns:sistemaOrigine>&lt;xsl:value-of select=&quot;$FlowInfo/tns:sourceSystem&quot;/>&lt;/tns:sistemaOrigine>&lt;/xsl:if>&lt;tns:codiceOLO>&lt;xsl:value-of select=&quot;$checkConsistenza/parameters/tns1:checkConsistenzaRequest/request/CODICE_OLO&quot;/>&lt;/tns:codiceOLO>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;$checkConsistenza/parameters/tns1:checkConsistenzaRequest/request/ID_RISORSA&quot;/>&lt;/tns:idRisorsa>&lt;xsl:if test=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:STATO_RISORSA&quot;>&lt;tns:statoRisorsa>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:STATO_RISORSA&quot;/>&lt;/tns:statoRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;>&lt;tns:dataAttivazione>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_ATTIVAZZIONE&quot;/>&lt;/tns:dataAttivazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;>&lt;tns:dataCessazione>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DATA_CESSAZIONE&quot;/>&lt;/tns:dataCessazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;>&lt;tns:codiceOLORis>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:CODICE_OLO_RIS&quot;/>&lt;/tns:codiceOLORis>&lt;/xsl:if>&lt;tns:returnCode>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:RETURN_CODE&quot;/>&lt;/tns:returnCode>&lt;xsl:if test=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&lt;tns:descrizioneErrore>&lt;xsl:value-of select=&quot;$callCRMWSCheckConsistenza/RESPONSE/ns:HEADER/ns:RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&lt;/tns:descrizioneErrore>&lt;/xsl:if>&lt;/tns:StagVerificaRisorsa>&lt;tns:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$checkConsistenza/parameters/tns1:checkConsistenzaRequest/request/IdEsecProcsoNoFile&quot;/>&lt;/tns:IdEsecProcsoNoFile>&lt;/tns:StagingCheckConsistenza>&lt;/xsl:template>&lt;/xsl:stylesheet>"
