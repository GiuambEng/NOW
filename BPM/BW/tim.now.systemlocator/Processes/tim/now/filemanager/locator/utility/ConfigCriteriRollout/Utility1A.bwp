                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogFilePoller-input"
                    name="LogFilePoller"
                    tibex:xpdlId="7c26be36-6914-41f3-966e-1d652fdfefcb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FilePollerToParseData"/>
