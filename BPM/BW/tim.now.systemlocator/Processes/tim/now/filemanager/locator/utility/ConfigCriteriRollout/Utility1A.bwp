                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dce78abb-772e-48f6-a13c-8689eef54b0e+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:dataformat=&quot;http://ns.tibco.com/bw/palette/dataformat/73cbee09-6b33-4cd8-8cd8-43e46a4585ee&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryVerificaOLO&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;UpdateDENORMnoTIM-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_ISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryVerificaOLO/Record[1]/COD_OLO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryVerificaOLO/Record[1]/COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISP>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;VOLUMI_IN_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/Volumi)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/Volumi&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VOLUMI_IN_NOW>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT_DENORM (COD_COMUNE, COD_ISP,COD_OLO,&#xd;&#xa;  CONFLICT_ID, CREATED, CREATED_BY, DATAFI, DATAINZ, DB_LAST_UPD, DESCR_SISTEMA, &#xd;&#xa;  LAST_UPD, LAST_UPD_BY, MODIFICATION_NUM, NOME_OFFERTA_ESTERNA, ROW_ID, ROW_ID_NOW, TIPOLG_LAVRZ, VOLUMI_IN_NOW)&#xd;&#xa;  SELECT '*', ?, ?,&#xd;&#xa;  '0', (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', TO_DATE('31-12-2999','dd-mm-yyyy'), (SELECT TO_DATE(SYSDATE) FROM DUAL),  (SELECT TO_DATE(SYSDATE) FROM DUAL), 'NOW', &#xd;&#xa;  (SELECT TO_DATE(SYSDATE) FROM DUAL), '0-1', 0, UPPER(TRO.NOME_OFFERTA_ESTERNA), s_loczre_critr_rollt_denorm.nextval, '1-NOW-' || s_loczre_critr_rollt_denorm.currval, TL.TIPOLG_LAVRZ, ?&#xd;&#xa;    FROM APPUSER.LOCZRE_AMBITO LA, APPUSER.TRASCODFC_OFFERTA TRO, TIPOLG_LAVRZ TL&#xd;&#xa;    WHERE TRO.ID_TRASCODFC_OFFERTA=LA.ID_TRASCODFC_OFFERTA AND TL.IDTPLG_LAVRZ=LA.IDTPLG_LAVRZ AND TRO.NOME_OFFERTA_ESTERNA &lt;> 'NP'" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISP"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
