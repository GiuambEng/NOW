                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.LOCZRE_CRITR_ROLLT (DATAINZ, DATAFI, IDTPLG_LAVRZ,&#xa;  ID_TRASCODFC_OFFERTA, COD_OLO, COD_ISP, COD_ISTAT_COMUNE, ID_SISTEMA, VOLUMI_IN_NOW)&#xa;  SELECT (SELECT TO_DATE(SYSDATE) FROM DUAL), TO_DATE('31-12-2999','dd-mm-yyyy'), LA.IDTPLG_LAVRZ, LA.ID_TRASCODFC_OFFERTA,&#xa;  ?, ?, '*', SYS.ID_SISTEMA, ?&#xa;    FROM APPUSER.LOCZRE_AMBITO LA, APPUSER.SISTEMA SYS, APPUSER.TRASCODFC_OFFERTA TRO&#xa;    WHERE SYS.DESCR_SISTEMA_NOME_SISTEMA = 'NOW' AND LA.AMBITO IN ('RT', 'DT') AND TRO.ID_TRASCODFC_OFFERTA = LA.ID_TRASCODFC_OFFERTA AND TRO.NOME_OFFERTA_ESTERNA&lt;>'NP'" xsi:type="jdbcPalette:JDBCUpdateActivity">

