                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2182cf53-f60e-4e06-815b-da6247abbea4+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:dataformat=&quot;http://ns.tibco.com/bw/palette/dataformat/73cbee09-6b33-4cd8-8cd8-43e46a4585ee&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryVerificaOLO&quot;/>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;UpdateDENORMTIM-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_ISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryVerificaOLO/Record[1]/COD_OLO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryVerificaOLO/Record[1]/COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISP>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;VOLUMI_IN_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseData/Rows/dataformat:root[number($index)]/Volumi)&quot;>&lt;xsl:value-of select=&quot;$ParseData/Rows/dataformat:root[number($index)]/Volumi&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VOLUMI_IN_NOW>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
