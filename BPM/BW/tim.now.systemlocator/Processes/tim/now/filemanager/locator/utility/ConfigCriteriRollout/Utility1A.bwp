                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodISP"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="VOLUMI_IN_NOW"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
