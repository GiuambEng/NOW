            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:ns11=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:sm=&quot;http://dbcfx/SOA/CheckRetailPlatform/2016-07-04&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;RolloutRecipient&quot;/>&lt;xsl:param name=&quot;Risorsa1&quot;/>&lt;xsl:param name=&quot;CheckRetailPlatform&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE='01'&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists($Consistenze/ns19:Consistenza[ns19:Stato!=&amp;quot;CESSATO&amp;quot; and (upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoHL&amp;quot;) or upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoFlat&amp;quot;))]) and (upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=upper-case(&amp;quot;BitstreamNGAFTTCAB&amp;quot;) or upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&amp;quot;VULAFTTCAB&amp;quot;))&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of selec