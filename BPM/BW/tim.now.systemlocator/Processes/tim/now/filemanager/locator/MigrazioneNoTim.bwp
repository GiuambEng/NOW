                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://xmlns.now.com/CheckRetailPlatform/" xmlns:ns19="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:param name="Consistenze"/&gt;&lt;xsl:param name="Risorsa1"/&gt;&lt;xsl:param name="Risorsa2"/&gt;&lt;xsl:template name="CheckRetailPlatform-input" match="/"&gt;&lt;tns1:checkNPRequest&gt;&lt;parameters&gt;&lt;tns1:checkNPRequest&gt;&lt;request&gt;&lt;DATA_RICHIESTA&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/DATA_RICHIESTA&gt;&lt;CODICE_OLO&gt;&lt;xsl:value-of select="&amp;quot;TLC&amp;quot;"/&gt;&lt;/CODICE_OLO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa1 and matches($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa,&amp;quot;[0-9]*&amp;quot;)"&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa"/&gt;&lt;/ID_RISORSA&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa2 and matches($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2,&amp;quot;[0-9]*&amp;quot;)"&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2"/&gt;&lt;/ID_RISORSA&gt;&lt;/xsl:when&gt;&lt;xsl:when test="matches($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa,&amp;quot;[0-9]*&amp;quot;)"&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa"/&gt;&lt;/ID_RISORSA&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ID_RISORSA&gt;&lt;xsl:value-of select="$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa"/&gt;&lt;/ID_RISORSA&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile"/&gt;&lt;/IdEsecProcsoNoFile&gt;&lt;/request&gt;&lt;/tns1:checkNPRequest&gt;&lt;/parameters&gt;&lt;/tns1:checkNPRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa2&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckRetailPlatform-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:checkNPRequest>&#xa;            &lt;request>&#xa;                &lt;DATA_RICHIESTA>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;                &lt;/DATA_RICHIESTA>&#xa;                &lt;CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                &lt;/CODICE_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa1 and matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa2 and matches($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;matches($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa,&amp;quot;[0-9]*&amp;quot;)&quot;>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa&quot;/>&#xa;                        &lt;/ID_RISORSA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;IdEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&#xa;                &lt;/IdEsecProcsoNoFile>&#xa;            &lt;/request>&#xa;        &lt;/tns1:checkNPRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
