                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:ns11=&quot;http://xmlns.now.com/CheckRetailPlatform/&quot; xmlns:sm=&quot;http://dbcfx/SOA/CheckRetailPlatform/2016-07-04&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;RolloutRecipient.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckRetailPlatform.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;tns:Risposta>&#xa;                &lt;tns:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:DataRisposta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE='01'&quot;>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(exists($Consistenze/ns19:Consistenza[ns19:Stato!=&amp;quot;CESSATO&amp;quot; and (upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoHL&amp;quot;) or upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoFlat&amp;qu