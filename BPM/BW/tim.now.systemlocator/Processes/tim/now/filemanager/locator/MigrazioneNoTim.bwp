                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Consistenza1&quot;/>&lt;xsl:param name=&quot;Consistenza2&quot;/>&lt;xsl:param name=&quot;Consistenza_DIN_1&quot;/>&lt;xsl:param name=&quot;Consistenza_DIN_2&quot;/>&lt;xsl:param name=&quot;FlagPacchetto&quot;/>&lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;starts-with(upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or &amp;#xD;&amp;#xA;(exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;(exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;(exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])&quot;>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or starts-with(upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or (not(exists($Consistenza_DIN_2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) or exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or (exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;) or (not(exists($Consistenza_DIN_1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) or exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza_DIN_1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;) or exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;/>&lt;xsl:when test=&quot;$FlagPacchetto/Record[CHIAVE = &amp;quot;GESTISCI_PACCHETTI_MIG&amp;quot;]/VALORE_STRINGA = &amp;quot;N&amp;quot; and string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdCorrelazione)>0&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Gestione pacchetti non abilitata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;$Consistenza1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza_DIN_1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza_DIN_2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Recuperate consistenze multiple o non NP da radicale&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($Consistenza1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) and (not(exists($Consistenza_DIN_1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;No asset attivo con id risorsa DIN&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($Consistenza2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) and (not(exists($Consistenza_DIN_2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;No asset attivo con id risorsa DIN&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:Risposta>&lt;/tns:RispostaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta" name="Assign"
                    outputVariable="Risposta"
                    tibex:xpdlId="2c8268e0-550e-4a59-ae15-02012f9d2972" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
