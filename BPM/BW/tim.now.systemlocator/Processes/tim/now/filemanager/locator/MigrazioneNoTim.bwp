                                    sqlStatement="SELECT CHIAVE, VALORE_STRINGA FROM PARAMETRI_CFGZ_NOW&#xd;&#xa;WHERE CHIAVE='GESTISCI_PACCHETTI_MIG' AND NOME_PROCSO='LOCALIZZATORE'&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
