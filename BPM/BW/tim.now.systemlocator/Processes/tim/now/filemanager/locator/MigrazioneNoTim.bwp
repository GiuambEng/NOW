                        <bpws:source linkName="Log6ToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagPacchetto/Record[CHIAVE = &quot;GESTISCI_PACCHETTI_MIG&quot;]/VALORE_STRINGA = &quot;N&quot; and string-length($GetSystemIn/RichiestaLocalizzatore/ns4:RichiestaLocalizzatore/ns4:Richiesta/ns4:IdCorrelazione)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FlagPacchetto/Record[CHIAVE = "GESTISCI_PACCHETTI_MIG"]/VALORE_STRINGA = "N" and string-length($GetSystemIn.RichiestaLocalizzatore/ns4:Richiesta/ns4:IdCorrelazione)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
