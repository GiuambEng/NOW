;) or upper-case($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&amp;quot;VULAFTTCAB&amp;quot;)&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;ATM Simmetrico vs FTTCAB&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($RolloutRecipient/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;]))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;not(matches($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa,&amp;quot;[0-9]*&amp;quot;)) and not(matches(if ($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa1) then $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa else $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2 ,&amp;quot;[0-9]*&amp;quot;))&quot;>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Risorsa TLC alfanumerica&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;]) and exists($Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;]) and not($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &amp;quot;00&amp;quot; and ($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &amp;quot;CRMR_V&amp;quot;