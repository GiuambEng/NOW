                <bpws:sources>
                    <bpws:source linkName="InvokeToEsitoCRMWS">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="InvokeToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:RETURN_CODE = &quot;00&quot; and ($CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMR_V&quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;CRMB_V&quot; or $CheckRetailPlatform/parameters/ns11:checkNPResponse/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = &quot;DBSS&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE = "00" and ($CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "CRMR_V" or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "CRMB_V" or $CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:SISTEMA_RETAIL = "DBSS")]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Comune2&quot;/>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Risorsa2&quot;/>&lt;xsl:param name=&quot;Risorsa1&quot;/>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;Comune1&quot;/>&lt;xsl:template name=&quot;Nota4-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:TransactionId>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&lt;/tns1:TransactionId>&lt;tns1:SistemaOrigine>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&lt;/tns1:SistemaOrigine>&lt;tns1:CodOLO>&lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:OLO&quot;/>&lt;/tns1:CodOLO>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&lt;tns1:OLOrecipient>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&lt;/tns1:OLOrecipient>&lt;/xsl:if>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Servizio&quot;/>&lt;/tns1:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa1&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Comune1/tns2:CodiceISTATcomune)>0&quot;>&lt;xsl:if test=&quot;$Comune1/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;$Comune1/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa=$Risorsa2&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Comune2/tns2:CodiceISTATcomune)>0&quot;>&lt;xsl:if test=&quot;$Comune2/tns2:CodiceISTATcomune&quot;>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;$Comune2/tns2:CodiceISTATcomune&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceComune>&lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&lt;/tns1:CodiceComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa&quot;>&lt;tns1:Risorsa>&lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa&quot;/>&lt;/tns1:Risorsa>&lt;/xsl:if>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&lt;/tns1:DataRichiesta>&lt;tns1:Richiesta>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&lt;/tns1:Richiesta>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;>&lt;tns1:IdEsecProcsoNoFile>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:IdEsecProcsoNoFile&quot;/>&lt;/tns1:IdEsecProcsoNoFile>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DNAggiuntivi/tns:DN&quot;>&lt;tns1:DNAggiuntivi>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns1:DNAggiuntivi>&lt;/xsl:for-each>&lt;tns3:Esiti/>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Nota4-input" name="Nota4"
                    outputVariable="Nota4"
                    tibex:xpdlId="860454ee-5886-422c-b34b-1ebce4e7f97b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Nota4ToAssign1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RolloutDonating&quot; xmlns:tns2=&quot;http://www.example.org/RecuperoComune&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune2&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa2&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:template name=&quot;Nota4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Transaction_id&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:SistemaOrigine>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine&quot;/>&#xa;            &lt;/tns1:SistemaOrigine>&#xa;            &lt;tns1:CodOLO>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:OLO&quot;/>&#xa;            &lt;/tns1:CodOLO>&#xa;            &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;>&#xa;                &lt;tns1:OLOrecipient>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO&quot;/>&#xa;                &lt;/tns1:OLOrecipie