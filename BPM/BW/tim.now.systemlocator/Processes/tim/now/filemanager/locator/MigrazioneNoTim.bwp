           &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
