                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa1&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune2&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:param name=&quot;Risorsa2&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonating1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns2:Richiesta/tns2:Richiesta&quot;/>&#xa;            &lt;/tns:Richiesta>&#xa;            &lt;tns:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Servizio&quot;/>&#xa;            &lt;/tns:Servizio>&#xa;            &lt;tns:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns2:Richiesta/tns2:DataRichiesta&quot;/>&#xa;            &lt;/tns:DataRichiesta>&#xa;            &lt;tns:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/ns19:Consistenza[ns19:OLO!=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:OLO&quot;/>&#xa;            &lt;/tns:CodiceOLO>&#