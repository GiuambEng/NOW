                                    name="CHIAVE" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="VALORE_STRINGA"
                                    nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
