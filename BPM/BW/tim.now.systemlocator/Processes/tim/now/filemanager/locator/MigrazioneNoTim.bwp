                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:ns19=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza1&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza2&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza_DIN_1&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza_DIN_2&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagPacchetto&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;tns:Risposta>&#xa;                &lt;tns:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:DataRisposta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or &amp;#xD;&amp;#xA;starts-with(upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or &amp;#xD;&amp;#xA;(exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;(exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;(exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or &amp;#xD;&amp;#xA;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or &amp;#xD;&amp;#xA;(upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])&quot;>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:RC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                &lt;/tns:RC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot;]) or starts-with(upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio),'EASYIPUBB') or (not(exists($Consistenza_DIN_2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) or exists($Consistenza_DIN_2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)])) or (exists($Consistenza2/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;) or (not(exists($Consistenza_DIN_1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) or exists($Consistenza_DIN_1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza_DIN_1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;) or exists($Consistenza1/ns19:Consistenza[upper-case(ns19:Servizio)=&amp;quot;VULLLINEANONATTIVA&amp;quot; or (upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTCAB&amp;quot; or upper-case(ns19:Servizio)=&amp;quot;EASYIPNGAFTTH&amp;quot;)]) or $Consistenza1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;/>&#xa;                    &lt;xsl:when test=&quot;$FlagPacchetto/Record[CHIAVE = &amp;quot;GESTISCI_PACCHETTI_MIG&amp;quot;]/VALORE_STRINGA = &amp;quot;N&amp;quot; and string-length($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdCorrelazione)>0&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Gestione pacchetti non abilitata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Consistenza1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza_DIN_1/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza_DIN_2/ns19:ErroreRadicale=&amp;quot;Y&amp;quot;&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Recuperate consistenze multiple o non NP da radicale&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(exists($Consistenza1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) and (not(exists($Consistenza_DIN_1/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No asset attivo con id risorsa DIN&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(exists($Consistenza2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])) and (not(exists($Consistenza_DIN_2/ns19:Consistenza[ns19:Servizio!=&amp;quot;NP&amp;quot;])))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No asset attivo con id risorsa DIN&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Risposta>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
