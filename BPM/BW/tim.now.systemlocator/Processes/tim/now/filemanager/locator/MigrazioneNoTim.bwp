             &lt;/tns:SistemaDiCompetenza>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:RC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                &lt;/tns:RC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CheckRetailPlatform.parameters/sm:checkRetailPlatformResponse/sm:RETURN_CODE='01'&quot;/>&#xa;                    &lt;xsl:when test=&quot;exists($Consistenze/ns19:Consistenza[ns19:Stato!=&amp;quot;CESSATO&amp;quot; and (upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoHL&amp;quot;) or upper-case(ns19:Servizio)=upper-case(&amp;quot;BitstreamATMSimmetricoFlat&amp;quot;))]) and (upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=upper-case(&amp;quot;BitstreamNGAFTTCAB&amp;quot;) or upper-case($GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Servizio)=&amp;quot;VULAFTTCAB&amp;quot;)&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ATM Simmetrico vs FTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(exists($RolloutRecipient.parameters/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;]))&quot;>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica dei criteri di rollout non superata&amp;quot;&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not(matches($Consistenze/ns19:Consistenza[ns19:OLO=&amp;quot;TLC&amp;quot; and ns19:Stato!=&amp;quot;CESSATO&amp;quot; and ns19:Servizio!=&amp;quot;NP&amp;quot;][1]/ns19:Risorsa,&amp;quot;[0-9]*&amp;quot;)) and not(matches(if ($Consistenze/ns19:Consistenza[ns19:OLO=&amp;q