                                    sqlStatement="SELECT COD_OLO&#xa;  FROM APPUSER.LOCZRE_CRITR_ROLLT_NP &#xa;  WHERE COD_OLO = ? AND DATAFI = TO_DATE('31-12-2999','dd-mm-yyyy')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

