            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Consistenze&quot;/>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Consistenza2&quot;/>&lt;xsl:template name=&quot;Consistenze&quot; match=&quot;/&quot;>&lt;tns:Consistenze>&lt;xsl:copy-of select=&quot;$Consistenze/tns:Consistenza&quot;/>&lt;xsl:for-each select=&quot;$Consistenza2/tns:Consistenza[tns:Servizio!=&amp;quot;NP&amp;quot;]&quot;>&lt;tns:Consistenza>&lt;xsl:if test=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2&quot;>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2&quot;/>&lt;/tns:Risorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Servizio&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;tns:Servizio&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OLO&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;tns:OLO&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Stato&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;tns:Stato&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DataAttivazione&quot;>&lt;tns:DataAttivazione>&lt;xsl:value-of select=&quot;tns:DataAttivazione&quot;/>&lt;/tns:DataAttivazione>&lt;/xsl:if>&lt;/tns:Consistenza>&lt;/xsl:for-each>&lt;/tns:Consistenze>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Consistenze" name="Assign4"
