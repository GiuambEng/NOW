                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns2="http://www.tim.com/NOW/xsd/CriteriRollOut" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:template name="RolloutRecipient-input" match="/"&gt;&lt;tns1:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaCriteriRollOut&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;tns2:DataRichiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/tns2:DataRichiesta&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceOLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"&gt;&lt;tns2:CodiceISP&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceISP"/&gt;&lt;/tns2:CodiceISP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:CodiceComune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/tns2:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns1:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
