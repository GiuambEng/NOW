                        <bpws:source linkName="Assign2ToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Risposta_Localizzatore/tns:Risposta/tns:SistemaDiCompetenza=&quot;NOW&quot; and exists($Consistenze/tns1:Consistenza[tns1:Stato=&quot;ATTIVO&quot; or tns1:Stato=&quot;INLAVORAZIONE&quot; and tns1:OLO!=&quot;TLC&quot;][2])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Risposta_Localizzatore/tns:Risposta/tns:SistemaDiCompetenza="NOW" and exists($Consistenze/tns1:Consistenza[tns1:Stato="ATTIVO" or tns1:Stato="INLAVORAZIONE" and tns1:OLO!="TLC"][2])]]></bpws:transitionCondition>
                        </bpws:source>
