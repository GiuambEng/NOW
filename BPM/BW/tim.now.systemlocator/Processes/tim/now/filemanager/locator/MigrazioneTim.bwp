            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn&quot;/>&#xa;    &lt;xsl:param name=&quot;RolloutDonating2&quot;/>&#xa;    &lt;xsl:template name=&quot;Risposta_Localizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RolloutDonating2/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza = &amp;quot;NOW&amp;quot;]) and not(string-length($GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2) > 0)&quot;>&#xa;                    &lt;tns:Risposta>&#xa;                        &lt;tns:DataRisposta>&#xa;                            &lt;xsl:value-of select=&quot; current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RolloutDonating2/parameters/tns1:RispostaVerificaCriteriRollOut/tns1:RecordCriteriRollOut[tns1:SistemaDiCompetenza = &amp;quot;NOW&amp;quot;]) and string-length($GetSystemIn/RichiestaLocalizzatore/tns:R