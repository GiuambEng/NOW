                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonating2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][2]/tns4:Servizio&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns2:DataRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][2]/tns4:OLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][2]/tns4:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Comune1/tns3:CodiceISTATcomune)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Comune1/tns3:CodiceISTATcomune&quot;>&#xa;                                &lt;tns2:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$Comune1/tns3:CodiceISTATcomune&quot;/>&#xa;                                &lt;/tns2:CodiceComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns2:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
