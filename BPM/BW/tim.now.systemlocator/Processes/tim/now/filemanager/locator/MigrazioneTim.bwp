                        </bpws:source>
                        <bpws:source linkName="Assign4ToComune2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Consistenze/tns1:Consistenza[(tns1:Stato=&quot;ATTIVO&quot; or tns1:Stato=&quot;INLAVORAZIONE&quot;) and tns1:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2]) and not($Consistenza2/tns1:ErroreRadicale=&quot;Y&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
