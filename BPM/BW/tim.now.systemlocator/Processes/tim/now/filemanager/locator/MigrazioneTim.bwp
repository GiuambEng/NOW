select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:DataRisposta>&#xa;                        &lt;tns:SistemaDiCompetenza>&#xa;                            &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                        &lt;/tns:SistemaDiCompetenza>&#xa;                        &lt;tns:RC>&#xa;                            &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                        &lt;/tns:RC>&#xa;                        &lt;tns:ErrMSG>&#xa;                            &lt;xsl:value-of select=&quot;'OK farloc'&quot;/>&#xa;                        &lt;/tns:ErrMSG>&#xa;                    &lt;/tns:Risposta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Risposta_Localizzatore"
                    name="EsitoRecipient"
                    outputVariable="Risposta_Localizzatore"
                    tibex:xpdlId="822ee793-7e10-4bd7-bf43-a6b8de2612c6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RolloutRecipientToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EsitoRecipientToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Risposta_Localizzatore/tns:Risposta/tns:SistemaDiCompetenza=&quot;KO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Risposta_Localizzatore/tns:Risposta/tns:SistemaDiCompetenza="KO"]]></bpws:transitionCondition>
