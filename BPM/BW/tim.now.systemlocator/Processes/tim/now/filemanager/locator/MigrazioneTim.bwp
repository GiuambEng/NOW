                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/" xmlns:tns2="http://www.tim.com/NOW/xsd/CriteriRollOut" xmlns:tns3="http://www.example.org/RecuperoComune" xmlns:tns4="http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/" version="2.0"&gt;&lt;xsl:param name="GetSystemIn"/&gt;&lt;xsl:param name="Comune2"/&gt;&lt;xsl:param name="Consistenze"/&gt;&lt;xsl:param name="Comune1"/&gt;&lt;xsl:template name="RolloutDonatingOLO1-input" match="/"&gt;&lt;tns1:VerificaCriteriRolloutRequest&gt;&lt;parameters&gt;&lt;tns2:RichiestaVerificaCriteriRollOut&gt;&lt;tns2:Richiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta"/&gt;&lt;/tns2:Richiesta&gt;&lt;tns2:Servizio&gt;&lt;xsl:value-of select="$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Servizio"/&gt;&lt;/tns2:Servizio&gt;&lt;tns2:DataRichiesta&gt;&lt;xsl:value-of select="$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta"/&gt;&lt;/tns2:DataRichiesta&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:OLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Comune1/tns3:CodiceISTATcomune)&gt;0"&gt;&lt;xsl:if test="$Comune1/tns3:CodiceISTATcomune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$Comune1/tns3:CodiceISTATcomune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="&amp;quot;xxxxxxxx&amp;quot;"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Risorsa=$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Comune2/tns3:CodiceISTATcomune)&gt;0"&gt;&lt;xsl:if test="$Comune2/tns3:CodiceISTATcomune"&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="$Comune2/tns3:CodiceISTATcomune"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:CodiceComune&gt;&lt;xsl:value-of select="&amp;quot;xxxxxxxx&amp;quot;"/&gt;&lt;/tns2:CodiceComune&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/tns2:RichiestaVerificaCriteriRollOut&gt;&lt;/parameters&gt;&lt;/tns1:VerificaCriteriRolloutRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/CriteriRollout/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CriteriRollOut&quot; xmlns:tns3=&quot;http://www.example.org/RecuperoComune&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune2&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Comune1&quot;/>&#xa;    &lt;xsl:template name=&quot;RolloutDonatingOLO1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaVerificaCriteriRollOut>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:Richiesta&quot;/>&#xa;            &lt;/tns2:Richiesta>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Servizio&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:DataRichiesta&quot;/>&#xa;            &lt;/tns2:DataRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:OLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Comune1/tns3:CodiceISTATcomune)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Comune1/tns3:CodiceISTATcomune&quot;>&#xa;                                &lt;tns2:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$Comune1/tns3:CodiceISTATcomune&quot;/>&#xa;                                &lt;/tns2:CodiceComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns2:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Consistenze/tns4:Consistenza[tns4:Stato=&amp;quot;ATTIVO&amp;quot; or tns4:Stato=&amp;quot;INLAVORAZIONE&amp;quot; and tns4:OLO!=&amp;quot;TLC&amp;quot;][1]/tns4:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Comune2/tns3:CodiceISTATcomune)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Comune2/tns3:CodiceISTATcomune&quot;>&#xa;                                &lt;tns2:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$Comune2/tns3:CodiceISTATcomune&quot;/>&#xa;                                &lt;/tns2:CodiceComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;xxxxxxxx&amp;quot;&quot;/>&#xa;                            &lt;/tns2:CodiceComune>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RichiestaVerificaCriteriRollOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
