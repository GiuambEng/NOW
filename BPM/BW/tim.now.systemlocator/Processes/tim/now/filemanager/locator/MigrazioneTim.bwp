                            <bpws:transitionCondition><![CDATA[exists($Consistenze/tns1:Consistenza[(tns1:Stato="ATTIVO" or tns1:Stato="INLAVORAZIONE") and tns1:Risorsa=$GetSystemIn.RichiestaLocalizzatore/tns:Richiesta/tns:IdRisorsa2]) and not($Consistenza2/tns1:ErroreRadicale="Y")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystemIn.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenze&quot;/>&#xa;    &lt;xsl:param name=&quot;Consistenza2&quot;/>&#xa;    &lt;xsl:template name=&quot;Consistenze&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Consistenze>&#xa;            &lt;xsl:copy-of select=&quot;$Consistenze/tns:Consistenza&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$Consistenza2/tns:Consistenza[tns:Servizio!=&amp;quot;NP&amp;quot;]&quot;>&#xa;                &lt;tns:Consistenza>&#xa;                    &lt;xsl:if test=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2&quot;>&#xa;                        &lt;tns:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$GetSystemIn.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2&quot;/>&#xa;                        &lt;/tns:Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:Servizio&quot;>&#xa;                        &lt;tns:Servizio>&#xa;                            &lt;xsl:value-of select=&quot;tns:Servizio&quot;/>&#xa;                        &lt;/tns:Servizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:OLO&quot;>&#xa;                        &lt;tns:OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns:OLO&quot;/>&#xa;                        &lt;/tns:OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:Stato&quot;>&#xa;                        &lt;tns:Stato>&#xa;                            &lt;xsl:value-of select=&quot;tns:Stato&quot;/>&#xa;                        &lt;/tns:Stato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DataAttivazione&quot;>&#xa;                        &lt;tns:DataAttivazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:DataAttivazione&quot;/>&#xa;                        &lt;/tns:DataAttivazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Consistenza>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Consistenze>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Consistenze" xsi:type="generalactivities:BWAssign"/>
