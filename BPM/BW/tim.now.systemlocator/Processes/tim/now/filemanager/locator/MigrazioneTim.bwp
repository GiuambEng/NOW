                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ConsistenzaMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystemIn&quot;/>&lt;xsl:param name=&quot;Consistenza1&quot;/>&lt;xsl:param name=&quot;Consistenza2&quot;/>&lt;xsl:template name=&quot;Risposta_Localizzatore&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:copy-of select=&quot;$GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;(exists($Consistenza1/tns1:Consistenza[tns1:Stato=&amp;quot;CESSATO&amp;quot;]) or exists($Consistenza2/tns1:Consistenza[tns1:Stato=&amp;quot;CESSATO&amp;quot;]) or $Consistenza1/tns1:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza2/tns1:ErroreRadicale=&amp;quot;Y&amp;quot;) and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Testata/tns:Sistema_origine=&amp;quot;NOWDISAMB&amp;quot;&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;07&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;La Risorsa risulta cessata sul NOW&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($Consistenza1/tns1:Consistenza[tns1:Stato=&amp;quot;CESSATO&amp;quot;]) or exists($Consistenza2/tns1:Consistenza[tns1:Stato=&amp;quot;CESSATO&amp;quot;]) or $Consistenza1/tns1:ErroreRadicale=&amp;quot;Y&amp;quot; or $Consistenza2/tns1:ErroreRadicale=&amp;quot;Y&amp;quot;)) and $GetSystemIn/RichiestaLocalizzatore/tns:RichiestaLocalizzatore/tns:Test