                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UpperCaseMapper&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator Input Uppercase: &amp;quot;, tib:render-xml($UpperCaseMapper))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogInput-input"
                                    name="LogInput"
                                    tibex:xpdlId="5ca366d7-b0ed-40d3-8af8-1f2211c931e8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToLogInput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogInputToCopy_1_NOWSITIM">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine = &quot;NOW&quot; and ($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO = &quot;TLC&quot; or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP = '002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine = "NOW" and ($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO = "TLC" or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP = '002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToCopy_1_LogInput">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine = &quot;NOW&quot; and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO != &quot;TLC&quot;) and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP != '002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine = "NOW" and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO != "TLC") and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP != '002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToCopy_1_PORTALEoNOWUPLOAD">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine=&quot;PORTALE&quot; or $UpperCaseMapper/ns2:Testata/ns2:Sistema_origine=&quot;NOWUPLOAD&quot; and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine="PORTALE" or $UpperCaseMapper/ns2:Testata/ns2:Sistema_origine="NOWUPLOAD" and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToCopy_2_NOWDISAMBNOTIM">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine=&quot;NOWDISAMB&quot; and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO!='TLC') and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP!='002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine="NOWDISAMB" and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO!='TLC') and (not(exists($UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP)) or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP!='002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToCopy_1_NOWDISAMBTIM">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine=&quot;NOWDISAMB&quot; and ($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO='TLC' or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP='002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine="NOWDISAMB" and ($UpperCaseMapper/ns2:Richiesta/ns2:CodiceOLO='TLC' or $UpperCaseMapper/ns2:Richiesta/ns2:CodiceISP='002') and not($UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToCopy_1_sistemanoncensito">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogInputToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine= 'NOW' and $UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$UpperCaseMapper/ns2:Testata/ns2:Sistema_origine= 'NOW' and $UpperCaseMapper/ns2:Richiesta/ns2:Servizio='NP']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UpperCaseMapper&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator Input Uppercase: &amp;quot;, tib:render-xml($UpperCaseMapper))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetSystem&quot;/>&lt;xsl:template name=&quot;UpperCaseMapper-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaLocalizzatore>&lt;tns:Testata>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Testata/tns1:Transaction_id)&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;$GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Testata/tns1:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;tns:Sistema_origine>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Testata/tns1:Sistema_origine)&quot;/>&lt;/tns:Sistema_origine>&lt;/tns:Testata>&lt;tns:Richiesta>&lt;tns:DataRichiesta>&lt;xsl:value-of select=&quot;$GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:DataRichiesta&quot;/>&lt;/tns:DataRichiesta>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO)&quot;>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO)&quot;/>&lt;/tns:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceISP)&quot;>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceISP)&quot;/>&lt;/tns:CodiceISP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune) and not(string-length($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)>5)&quot;>&lt;tns:CodiceComune>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)&quot;/>&lt;/tns:CodiceComune>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune) and string-length($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)>5&quot;>&lt;tns:CodiceComune>&lt;xsl:value-of select=&quot;tib:trim(substring($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune,string-length($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)-5,6))&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:CodiceComune>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio))&quot;/>&lt;/tns:Servizio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:FlagNaked)&quot;>&lt;tns:FlagNaked>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:FlagNaked)&quot;/>&lt;/tns:FlagNaked>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Richiesta)&quot;>&lt;tns:Richiesta>&lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richi