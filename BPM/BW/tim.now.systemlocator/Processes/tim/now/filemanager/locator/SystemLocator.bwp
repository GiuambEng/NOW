&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdCorrelazione)&quot;/>&lt;/tns:IdCorrelazione>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Flag_verticalizzato)&quot;>&lt;tns:Flag_verticalizzato>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Flag_verticalizzato)&quot;/>&lt;/tns:Flag_verticalizzato>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Rientro_TI)&quot;>&lt;tns:Rientro_TI>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Rientro_TI)&quot;/>&lt;/tns:Rientro_TI>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2)&quot;>&lt;tns:IdRisorsa2>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2)&quot;/>&lt;/tns:IdRisorsa2>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico)&quot;>&lt;tns:Telefonico>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico)&quot;/>&lt;/tns:Telefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:OpzioneDinamica)>0&quot;>&lt;tns:OpzioneDinamica>&lt;xsl:value-of select=&quot;tib:trim($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:OpzioneDinamica)&quot;/>&lt;/tns:OpzioneDinamica>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:TipoLinea)>0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:TipoLinea))&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:DNAggiuntivi)&quot;>&lt;tns:DNAggiuntivi>&lt;xsl:for-each select=&quot;$GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:DNAggiuntivi/tns1:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;tib:trim(upper-case(.))&quot;/>&lt;/tns:DN>&lt;/xsl:for-each>&lt;/tns:DNAggiuntivi>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceCambioTipologia)&quot;>&lt;tns:CodiceCambioTipologia>&lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem/RichiestaLocalizzatore/tns1:RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceCambioTipologia))&quot;/>&lt;/tns:CodiceCambioTipologia>&lt;/xsl:if>&lt;/tns:Richiesta>&lt;/tns:RichiestaLocalizzatore>&lt;/xsl:template>&lt;/xsl:stylesheet>"
