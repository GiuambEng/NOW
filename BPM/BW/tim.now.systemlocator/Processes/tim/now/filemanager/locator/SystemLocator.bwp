                                <bpws:scope name="scope1">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="LogErrorToReply_DBerror"
                                    tibex:label="DB error" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogErrorToUndeclaredFlaut_otherwise"
