                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystem.RichiestaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;UpperCaseMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RichiestaLocalizzatore>&#xa;            &lt;tns:Testata>&#xa;                &lt;tns:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Testata/tns1:Transaction_id)&quot;/>&#xa;                &lt;/tns:Transaction_id>&#xa;                &lt;tns:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystem.RichiestaLocalizzatore/tns1:Testata/tns1:Transaction_date&quot;/>&#xa;                &lt;/tns:Transaction_date>&#xa;                &lt;tns:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Testata/tns1:Sistema_origine)&quot;/>&#xa;                &lt;/tns:Sistema_origine>&#xa;            &lt;/tns:Testata>&#xa;            &lt;tns:Richiesta>&#xa;                &lt;tns:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:DataRichiesta&quot;/>&#xa;                &lt;/tns:DataRichiesta>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO)&quot;>&#xa;                    &lt;tns:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOLO)&quot;/>&#xa;                    &lt;/tns:CodiceOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceISP)&quot;>&#xa;                    &lt;tns:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceISP)&quot;/>&#xa;                    &lt;/tns:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune) and not(string-length($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)>5)&quot;>&#xa;                        &lt;tns:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)&quot;/>&#xa;                        &lt;/tns:CodiceComune>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune) and string-length($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)>5&quot;>&#xa;                        &lt;tns:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;tib:trim(substring($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune,string-length($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceComune)-5,6))&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:CodiceComune>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio)&quot;>&#xa;                    &lt;tns:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Servizio))&quot;/>&#xa;                    &lt;/tns:Servizio>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:FlagNaked)&quot;>&#xa;                    &lt;tns:FlagNaked>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:FlagNaked)&quot;/>&#xa;                    &lt;/tns:FlagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Richiesta)&quot;>&#xa;                    &lt;tns:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Richiesta))&quot;/>&#xa;                    &lt;/tns:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Sottolavorazione)&quot;>&#xa;                    &lt;tns:Sottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Sottolavorazione))&quot;/>&#xa;                    &lt;/tns:Sottolavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Ambito_XDSL)&quot;>&#xa;                    &lt;tns:Ambito_XDSL>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Ambito_XDSL)&quot;/>&#xa;                    &lt;/tns:Ambito_XDSL>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoTI)&quot;>&#xa;                    &lt;tns:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoTI)&quot;/>&#xa;                    &lt;/tns:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoOLO)&quot;>&#xa;                    &lt;tns:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceOrdineRiferimentoOLO)&quot;/>&#xa;                    &lt;/tns:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa)&quot;>&#xa;                    &lt;tns:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa)&quot;/>&#xa;                    &lt;/tns:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdCorrelazione)&quot;>&#xa;                    &lt;tns:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdCorrelazione)&quot;/>&#xa;                    &lt;/tns:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Flag_verticalizzato)&quot;>&#xa;                    &lt;tns:Flag_verticalizzato>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Flag_verticalizzato)&quot;/>&#xa;                    &lt;/tns:Flag_verticalizzato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Rientro_TI)&quot;>&#xa;                    &lt;tns:Rientro_TI>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Rientro_TI)&quot;/>&#xa;                    &lt;/tns:Rientro_TI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2)&quot;>&#xa;                    &lt;tns:IdRisorsa2>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:IdRisorsa2)&quot;/>&#xa;                    &lt;/tns:IdRisorsa2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico)&quot;>&#xa;                    &lt;tns:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:Telefonico)&quot;/>&#xa;                    &lt;/tns:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:OpzioneDinamica)>0&quot;>&#xa;                    &lt;tns:OpzioneDinamica>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:OpzioneDinamica)&quot;/>&#xa;                    &lt;/tns:OpzioneDinamica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:TipoLinea)>0&quot;>&#xa;                    &lt;tns:TipoLinea>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:TipoLinea))&quot;/>&#xa;                    &lt;/tns:TipoLinea>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:DNAggiuntivi)&quot;>&#xa;                    &lt;tns:DNAggiuntivi>&#xa;                        &lt;xsl:for-each select=&quot;$GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:DNAggiuntivi/tns1:DN&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(upper-case(.))&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:DNAggiuntivi>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceCambioTipologia)&quot;>&#xa;                    &lt;tns:CodiceCambioTipologia>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(upper-case($GetSystem.RichiestaLocalizzatore/tns1:Richiesta/tns1:CodiceCambioTipologia))&quot;/>&#xa;                    &lt;/tns:CodiceCambioTipologia>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:Richiesta>&#xa;        &lt;/tns:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
