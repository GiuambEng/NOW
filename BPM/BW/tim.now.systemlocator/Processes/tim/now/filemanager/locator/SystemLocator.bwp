                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SystemLocator/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;V_RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;GetSystemOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RispostaLocalizzatore>&#xa;            &lt;tns1:Testata>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Testata/tns2:Transaction_id&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Testata/tns2:Transaction_date&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;                &lt;tns1:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Testata/tns2:Sistema_origine&quot;/>&#xa;                &lt;/tns1:Sistema_origine>&#xa;            &lt;/tns1:Testata>&#xa;            &lt;tns1:Risposta>&#xa;                &lt;tns1:DataRisposta>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Risposta/tns2:DataRisposta&quot;/>&#xa;                &lt;/tns1:DataRisposta>&#xa;                &lt;tns1:SistemaDiCompetenza>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Risposta/tns2:SistemaDiCompetenza&quot;/>&#xa;                &lt;/tns1:SistemaDiCompetenza>&#xa;                &lt;tns1:RC>&#xa;                    &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Risposta/tns2:RC&quot;/>&#xa;                &lt;/tns1:RC>&#xa;                &lt;xsl:if test=&quot;$V_RispostaLocalizzatore/tns2:Risposta/tns2:ErrMSG&quot;>&#xa;                    &lt;tns1:ErrMSG>&#xa;                        &lt;xsl:value-of select=&quot;$V_RispostaLocalizzatore/tns2:Risposta/tns2:ErrMSG&quot;/>&#xa;                    &lt;/tns1:ErrMSG>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:Risposta>&#xa;        &lt;/tns1:RispostaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="EndLogToGetSystemOut"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="GetSystemOutToResponseInsert"/>
                                </bpws:sources>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NowNoTm&quot;/>&lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$NowNoTm/RispostaLocalizzatore/tns:RispostaLocalizzatore&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="V_RispostaLocalizzatore"
                                    name="Esito2"
                                    outputVariable="V_RispostaLocalizzatore"
                                    tibex:xpdlId="117a203f-f283-458c-8a8f-cdbc04cd4e5d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetSystemToSetRisposta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetRispostaToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NowNoTm.RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;V_RispostaLocalizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$NowNoTm.RispostaLocalizzatore&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
