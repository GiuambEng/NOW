            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="38b33e96-f85f-487c-89a2-23d65ce2a445">
                <bpws:onMessage operation="GetSystem"
                    partnerLink="SystemLocatorPortType"
                    portType="ns1:SystemLocatorPortType"
                    tibex:xpdlId="f4c895ca-2cf2-4a46-8ab6-acc65f127af3" variable="GetSystem">
                    <bpws:scope name="getSystem">
                        <bpws:variables>
                            <bpws:variable
