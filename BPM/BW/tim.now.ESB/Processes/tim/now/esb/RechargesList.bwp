odiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/dataInvioRichiesta&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;xsl:if test=&quot;$RechargeIn.Request/tns:Richiesta/IDAnagraficaCausale&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/IDAnagraficaCausale&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RechargeIn.Request/tns:Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;IDCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/IDCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RechargeIn.Request/tns:Richiesta/totaleRichiestePacchetto&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RechargeIn.Request/tns:Richiesta/tipoPacchetto&quot;>&#xa;                    &lt;tipoPacchetto>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:Richiesta/tipoPacchetto&quot;/>&#xa;                    &lt;/tipoPacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RechargeIn.Request/tns:Richiesta/IDPacchettoNOW&quot;>&#xa;                    &lt;IDPacchettoNOW>&