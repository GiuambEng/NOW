setRicarica&quot;/>&lt;/IDAssetRicarica>&lt;/xsl:if>&lt;IDAsset>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/IDAsset&quot;/>&lt;/IDAsset>&lt;dataInizio>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataInizio&quot;/>&lt;/dataInizio>&lt;dataFine>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataFine&quot;/>&lt;/dataFine>&lt;tipologiaRicarica>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/tipologiaRicarica&quot;/>&lt;/tipologiaRicarica>&lt;statoAsset>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/statoAsset&quot;/>&lt;/statoAsset>&lt;famigliaAsset>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/famigliaAsset&quot;/>&lt;/famigliaAsset>&lt;xsl:if test=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataAccensione&quot;>&lt;dataAccensione>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataAccensione&quot;/>&lt;/dataAccensione>&lt;/xsl:if>&lt;xsl:if test=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataSpegnimento&quot;>&lt;dataSpegnimento>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataSpegnimento&quot;/>&lt;/dataSpegnimento>&lt;/xsl:if>&lt;xsl:if test=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataAnnullamento&quot;>&lt;dataAnnullamento>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/dataAnnullamento&quot;/>&lt;/dataAnnullamento>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:AssetRicarica/operatore&quot;/>&lt;/operatore>&lt;/tns1:AssetRicarica>&lt;/xsl:if>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$RechargeIn/Request/tns:Request/tns:BusinessID&quot;/>&lt;/tns1:BusinessID>&lt;tns1:TransactionID>&lt;xsl:value-of select=&quot;$TransactionID&quot;/>&lt;/tns1:TransactionID>&lt;tns1:MessageID>&lt;xsl:value-of select=&quot;$MessageID&quot;/>&lt;/tns1:MessageID>&lt;tns1:ContenutoRequest>&lt;xsl:value-of select=&quot;tib:render-xml($RechargeIn/Request/tns:Request, true(),true())&quot;/>&lt;/tns1:ContenutoRequest>&lt;/tns1:Req>&lt;/xsl:template>&lt;/xsl:stylesheet>"
