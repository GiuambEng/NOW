#xa;                    &lt;/dataFine>&#xa;                    &lt;tipologiaRicarica>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/tipologiaRicarica&quot;/>&#xa;                    &lt;/tipologiaRicarica>&#xa;                    &lt;statoAsset>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/statoAsset&quot;/>&#xa;                    &lt;/statoAsset>&#xa;                    &lt;famigliaAsset>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/famigliaAsset&quot;/>&#xa;                    &lt;/famigliaAsset>&#xa;                    &lt;xsl:if test=&quot;$RechargeIn.Request/tns:AssetRicarica/lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$RechargeIn.Request/tns:AssetRicarica/dataAccensione&quot;>&#xa;                        &lt;dataAccensione>&#xa;                            &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/dataAccensione&quot;/>&#xa;                        &lt;/dataAccensione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RechargeIn.Request/tns:AssetRicarica/dataSpegnimento&quot;>&#xa;                        &lt;dataSpegnimento>&#xa;                            &lt;xsl:value-of select=&quot;$RechargeIn.Request/tns:AssetRicarica/dataSpegnimento&quot;/>&#xa;                        &lt;/dataSpegnimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RechargeIn.Request/tns:AssetRica