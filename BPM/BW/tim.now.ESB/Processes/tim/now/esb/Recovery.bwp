            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogParametro-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcQueryActivityInput"
            name="Ora-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:resultSet" name="Ora" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="LogOra-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcQueryActivityInput"
            name="Ritardo-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:resultSet" name="Ritardo" sca-bpel:internal="true"/>
        <bpws:variable name="JDBCTimeout" sca-bpel:hotUpdate="false"
