                <bpws:link name="CallProcess2ToJDBCQuery1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCQuery1ToCallProcess3" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQuery2ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess3ToJDBCQuery2" tibex:linkType="SUCCESS"/>
