    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToCallProcess2" tibex:linkType="SUCCESS"/>
