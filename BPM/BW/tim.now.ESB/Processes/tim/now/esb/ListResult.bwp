                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/Asset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AssetRicarica&quot;/>&lt;xsl:template name=&quot;AccumulateRic-input&quot; match=&quot;/&quot;>&lt;tns:AssetRicarica>&lt;xsl:for-each select=&quot;$AssetRicarica/Record&quot;>&lt;tns:Asset>&lt;IDAssetRicarica>&lt;xsl:value-of select=&quot;xsd:integer(IDASSETRICARICA)&quot;/>&lt;/IDAssetRicarica>&lt;IDAsset>&lt;xsl:value-of select=&quot;xsd:int(IDASSET)&quot;/>&lt;/IDAsset>&lt;dataInizio>&lt;xsl:value-of select=&quot;DATAINIZIO&quot;/>&lt;/dataInizio>&lt;dataFine>&lt;xsl:value-of select=&quot;DATAFINE&quot;/>&lt;/dataFine>&lt;tipologiaRicarica>&lt;xsl:value-of select=&quot;xsd:int(TIPOLOGIARICARICA)&quot;/>&lt;/tipologiaRicarica>&lt;statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/statoAsset>&lt;famigliaAsset>&lt;xsl:value-of select=&quot;FAMIGLIAASSET&quot;/>&lt;/famigliaAsset>&lt;xsl:if test=&quot;LASTUPDATE&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;CREATED&quot;/>&lt;/created>&lt;xsl:if test=&quot;DATAACCENSIONE&quot;>&lt;dataAccensione>&lt;xsl:value-of select=&quot;DATAACCENSIONE&quot;/>&lt;/dataAccensione>&lt;/xsl:if>&lt;xsl:if test=&quot;DATASPEGNIMENTO&quot;>&lt;dataSpegnimento>&lt;xsl:value-of select=&quot;DATASPEGNIMENTO&quot;/>&lt;/dataSpegnimento>&lt;/xsl:if>&lt;xsl:if test=&quot;DATAANNULLAMENTO&quot;>&lt;dataAnnullamento>&lt;xsl:value-of select=&quot;DATAANNULLAMENTO&quot;/>&lt;/dataAnnullamento>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/operatore>&lt;/tns:Asset>&lt;/xsl:for-each>&lt;/tns:AssetRicarica>&lt;/xsl:template>&lt;/xsl:stylesheet>"
