                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_ORDINE_OLO FROM STAG_ESB_OUT_NO_FILE &#xd;&#xa;WHERE &#xd;&#xa;CODICE_ORDINE_OLO=? " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
