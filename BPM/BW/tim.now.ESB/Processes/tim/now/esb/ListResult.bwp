                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/List/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AccensioneRic&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Header/h:businessID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Header/h:businessID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AccensioneRic/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Accensione Richiesta Recuperato',tib:render-xml($AccensioneRic,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;' Accensione Richiesta Ricarica non recuperato'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/Asset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper1&quot;/>&lt;xsl:param name=&quot;AccensioneRic&quot;/>&lt;xsl:template name=&quot;Request-input&quot; match=&quot;/&quot;>&lt;tns:AssetRicarica>&lt;xsl:copy-of select=&quot;$Mapper1/tns:Ricarica&quot;/>&lt;xsl:for-each select=&quot;$AccensioneRic/Record&quot;>&lt;tns:Ricarica>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;xsl:if test=&quot;CREATED&quot;>&lt;tns:Created>&lt;xsl:value-of select=&quot;CREATED&quot;/>&lt;/tns:Created>&lt;/xsl:if>&lt;xsl:if test=&quot;CANALERICHIESTA&quot;>&lt;tns:CanaleRichiesta>&lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&lt;/tns:CanaleRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLOGIASOTTOLAV&quot;>&lt;tns:Sottolavorazione>&lt;xsl:value-of select=&quot;TIPOLOGIASOTTOLAV&quot;/>&lt;/tns:Sottolavorazione>&lt;/xsl:if>&lt;/tns:Ricarica>&lt;/xsl:for-each>&lt;/tns:AssetRicarica>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Request-input" name="Request"
                    outputVariable="Request"
                    tibex:xpdlId="e72e2277-f74a-46fa-8d59-273fa0121418" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAccensioneRicToMapper3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RequestToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/Asset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper1&quot;/>&lt;xsl:param name=&quot;AccensioneRic&quot;/>&lt;xsl:template name=&quot;Request-input&quot; match=&quot;/&quot;>&lt;tns:AssetRicarica>&lt;xsl:copy-of select=&quot;$Mapper1/tns:Ricarica&quot;/>&lt;xsl:for-each select=&quot;$AccensioneRic/Record&quot;>&lt;tns:Ricarica>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;xsl:if test=&quot;CREATED&quot;>&lt;tns:Created>&lt;xsl:value-of select=&quot;CREATED&quot;/>&lt;/tns:Created>&lt;/xsl:if>&lt;xsl:if test=&quot;CANALERICHIESTA&quot;>&lt;tns:CanaleRichiesta>&lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&lt;/tns:CanaleRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLOGIASOTTOLAV&quot;>&lt;tns:Sottolavorazione>&lt;xsl:value-of select=&quot;TIPOLOGIASOTTOLAV&quot;/>&lt;/tns:Sottolavorazione>&lt;/xsl:if>&lt;/tns:Ricarica>&lt;/xsl:for-each>&lt;/tns:AssetRicarica>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Asset="http://telecomitalia.it/Asset"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Asset:AssetRicarica" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/List/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Header/h:businessID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Header/h:businessID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper Request&amp;quot;, tib:render-xml($Request, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogRequest-input" name="LogRequest"
                    tibex:xpdlId="1102323d-92d8-49d3-b381-1aa798cc32fc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RequestToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRequestToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/List/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ListResult&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/ns:Header/h:businessID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:Header/h:businessID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper Request&amp;quot;, tib:render-xml($Request, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (count($Request/ns12:Ricarica)>0) then count($Request/ns12:Ricarica) else count($Mapper1/ns12:Ricarica)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Scarto" name="Assign3"
                    outputVariable="Scarto"
                    tibex:xpdlId="fc1be375-1331-46b7-81de-37672da9efe0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="While1ToAssign3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign3ToWhile3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (count($Request/ns12:Ricarica)>0) then count($Request/ns12:Ricarica) else count($Mapper1/ns12:Ricarica)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Scarto" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While3" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="8b4bcb76-4d18-40f9-a79c-fb4389e997ed">
                <bpws:targets>
                    <bpws:target linkName="Assign3ToWhile3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While3ToMapper3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence3" tibex:group="while">
                    <bpws:assign name="GroupInit3"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+8e83883a-7e49-4b0d-9e53-c4a89f3ab6f3" version="2.0"> <xsl:template name="Accumulate3" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate3"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while3" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$Scarto" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$Scarto]]></bpws:condition>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link name="GroupStart3ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AccumulateScartoToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToMapper3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart3"
                                tibex:group="groupStart" tibex:xpdlId="07a92a04-2918-4d9b-943c-6e89c0f4678f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart3ToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate3"
                                    outputVariable="Accumulate3"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="8e83883a-7e49-4b0d-9e53-c4a89f3ab6f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>AccumulateScarto</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
