                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDASSETRICARICA,IDASSET,DATAINIZIO,DATAFINE,TIPOLOGIARICARICA,&#xa;STATOASSET,FAMIGLIAASSET,LASTUPDATE,CREATED,DATAACCENSIONE,DATASPEGNIMENTO,&#xa;DATAANNULLAMENTO,OPERATORE&#xa;  FROM BDS_1_CASEDATA_ASSETRICARICA&#xa;  WHERE IDASSET=? AND CREATED >=? AND CREATED&lt;=? &#xa;  AND FAMIGLIAASSET!='RICARICAINIZIALE'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="CREATED"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="CREATED2"/>
