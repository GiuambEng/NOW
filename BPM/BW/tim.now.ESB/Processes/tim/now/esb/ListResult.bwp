                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/Asset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ScartoRichiesta&quot;/>&lt;xsl:param name=&quot;Mapper1&quot;/>&lt;xsl:template name=&quot;AccumulateScarto-input&quot; match=&quot;/&quot;>&lt;tns:AssetRicarica>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Request/tns:Ricarica)>0&quot;>&lt;tns:Scarto>&lt;xsl:if test=&quot;$ScartoRichiesta/Record[1]/ID_RICH_OLO&quot;>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$ScartoRichiesta/Record[1]/ID_RICH_OLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/tns:Ricarica[$index]/tns:CanaleRichiesta&quot;>&lt;tns:CanaleRichiesta>&lt;xsl:value-of select=&quot;$Request/tns:Ricarica[$index]/tns:CanaleRichiesta&quot;/>&lt;/tns:CanaleRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;count($ScartoRichiesta/Record[NOME='DATAINIZIORICARICA' and string-length(VALORE)>0])>0&quot;>&lt;tns:DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime($ScartoRichiesta/Record[NOME='DATAINIZIORICARICA']/VALORE)&quot;/>&lt;/tns:DataInizioRicarica>&lt;/xsl:if>&lt;xsl:if test=&quot;count($ScartoRichiesta/Record[NOME='DATAFINERICARICA' and string-length(VALORE)>0])>0&quot;>&lt;tns:DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime($ScartoRichiesta/Record[NOME='DATAFINERICARICA']/VALORE)&quot;/>&lt;/tns:DataFineRicarica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/tns:Ricarica[$index]/tns:Sottolavorazione&quot;>&lt;tns:Sottolavorazione>&lt;xsl:value-of select=&quot;$Request/tns:Ricarica[$index]/tns:Sottolavorazione&quot;/>&lt;/tns:Sottolavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/tns:Ricarica[$index]/tns:Created&quot;>&lt;tns:Created>&