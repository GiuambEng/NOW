REATED2>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/CREATED2>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($DataFine)&quot;>&lt;CREATED2>&lt;xsl:value-of select=&quot;$DataFine&quot;/>&lt;/CREATED2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CREATED2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Richiesta/ns:TipoAzione/ns:ListaRicariche/ns:DataFineEstrazione)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Richiesta/ns:TipoAzione/ns:ListaRicariche/ns:DataFineEstrazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CREATED2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
