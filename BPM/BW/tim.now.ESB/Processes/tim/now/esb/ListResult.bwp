                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e4bcc031-196a-40ca-ab0a-10021a1ff242+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/List/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/ns:Richiesta/ns:CodiceOrdineOLO&quot;/>&lt;/CODICEORDINEOLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
