                portType="ns5:InsertUpdateStagingPortType" tibex:xpdlId="914cad6a-ef2f-4a49-b77a-d13490fd0c63">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:sm="http://telecomitalia.it/SOA/B2BDynamicResourceQueryResponse/2019-06-17" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Control"/&gt;&lt;xsl:param name="InsertStagingOK"/&gt;&lt;xsl:param name="InsertStagingKO"/&gt;&lt;xsl:param name="ListaRicarica"/&gt;&lt;xsl:param name="RechargesList"/&gt;&lt;xsl:param name="CODOLO"/&gt;&lt;xsl:param name="CodiceOrdnRic"/&gt;&lt;xsl:template name="UpdateStag-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="concat(tib:render-xml($RechargesList/body/sm:getRechargesListResultResponse,true(),true()),tib:render-xml($RechargesList/Header/h:Header, true(),true()))"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Control='OK'"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($CODOLO/Record)&gt;0 or count($CodiceOrdnRic/Record)&gt;0"&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Errore per non univocità del Codice Ordine OLO'"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="'Verifica Id Risorsa con esito errato'"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RISPOSTA&gt;&lt;tns1:NUMERO_RETRY&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns1:NUMERO_RETRY&gt;&lt;tns1:CODE_ACK_NACK&gt;&lt;xsl:value-of select="$RechargesList/body/sm:getRechargesListResultResponse/sm:ProcessData/sm:returnCode"/&gt;&lt;/tns1:CODE_ACK_NACK&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_ESB_OUT_NO_FILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Control='OK'"&gt;&lt;xsl:if test="$InsertStagingKO/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStagingKO/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InsertStagingOK/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStagingOK/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Control='OK'"&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingKO/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingOK/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ListaRicarica"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Control='OK'"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Info'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/B2BDynamicResourceQueryResponse/2019-06-17&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingKO.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RechargesList.body&quot;/>&#xa;    &lt;xsl:param name=&quot;RechargesList.Header&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStagingOK.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Control&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;CODOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceOrdnRic&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($RechargesList.body,true(),true()),tib:render-xml($RechargesList.Header, true(),true()))&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Control='OK'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($CODOLO/Record)>0 or count($CodiceOrdnRic/Record)>0&quot;>&#xa;                                &lt;tns1:DESCR_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;'Errore per non univocità del Codice Ordine OLO'&quot;/>&#xa;                                &lt;/tns1:DESCR_ERRORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:DESCR_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;'Verifica Id Risorsa con esito errato'&quot;/>&#xa;                                &lt;/tns1:DESCR_ERRORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                &lt;tns1:NUMERO_RETRY>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns1:NUMERO_RETRY>&#xa;                &lt;tns1:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;$RechargesList.body/sm:ProcessData/sm:returnCode&quot;/>&#xa;                &lt;/tns1:CODE_ACK_NACK>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_ESB_OUT_NO_FILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Control='OK'&quot;>&#xa;                            &lt;xsl:if test=&quot;$InsertStagingKO.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStagingKO.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStagingOK.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStagingOK.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Control='OK'&quot;>&#xa;                            &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingKO.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingOK.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ListaRicarica&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Control='OK'&quot;>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/ns:STATO_ESEC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns:STATO_ESEC>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                            &lt;/ns:STATO_ESEC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'Info'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
