                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  CODICEORDINEOLO FROM BDS_1_CASEDATA_RICHIESTA WHERE &#xa;CODICEORDINEOLO=? AND&#xa; TIPORICHIESTA='RICARICA'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
