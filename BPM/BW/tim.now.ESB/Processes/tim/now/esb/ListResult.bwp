                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATAINIZIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAFINE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
