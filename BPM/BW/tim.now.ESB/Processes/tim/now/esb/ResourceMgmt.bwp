                                <bpws:transitionCondition><![CDATA[(exists($Start/ns0:AssetRicarica) and exists($Start/ns0:AssetRicarica/IDAssetRicarica)) or (string-length($Start/ns0:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSETRICARICA']/valoreAttributo)>0)]]></bpws:transitionCondition>
                            </bpws:source>
                            <bpws:source linkName="IdAssetToRecharge">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                            </bpws:source>
                        </bpws:sources>
                    </bpws:empty>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            inputVariable="IDRichOLO-input"
                            name="IDRichOLO" outputVariable="IDRichOLO"
                            tibex:xpdlId="887fae4c-ee64-4141-a811-c184b067d568" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="EmptyToJDBCQuery"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="IDRichOLOToGenericLogger"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+887fae4c-ee64-4141-a811-c184b067d568+input&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:AssetRicarica) and exists($Start/tns1:AssetRicarica/IDAssetRicarica)&quot;>&lt;IDASSETRICARICA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:AssetRicarica/IDAssetRicarica)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/IDAssetRicarica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDASSETRICARICA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDASSETRICARICA>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSETRICARICA']/valoreAttributo)&quot;/>&lt;/IDASSETRICARICA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AQ.CODICE_ORDINE_OLO,ASS.IDASSETRICARICA,ASS.IDRICHIESTAOLO,AQ.CANALE_RICHIESTA,AQ.XML_CASEDATA_RICHIESTA &#xd;&#xa;FROM ASSET_RICARICA_RICHIESTA ASS,ACQUISIZIONE_RICHIESTE AQ&#xd;&#xa;WHERE &#xd;&#xa;ASS.IDASSETRICARICA =? AND&#xd;&#xa;ASS.IDRICHIESTAOLO=AQ.ID_RICHIESTA_OLO AND AQ.CANALE_RICHIESTA='B2B'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSETRICARICA"/>
                                    <columnMetadata
                                    columnName="CODICE_ORDINE_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSETRICARICA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CANALE_RICHIESTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="XML_CASEDATA_RICHIESTA"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="LogIDRichOLO-input"
                            name="LogIDRichOLO"
                            tibex:xpdlId="b9b8df6a-781e-4d0e-b7ec-ec7312f36615"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="IDRichOLOToGenericLogger"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="LogIDRichOLOToRecharge"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;IDRichOLO&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:BusinessID&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($IDRichOLO/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('IDRichOLO Record trovati:',tib:render-xml($IDRichOLO,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'IDRichOLO Record non trovati'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                </bpws:flow>
