                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/B2BDynamicResourceMgmtResponse/2019-06-17&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/B2BDynamicResourceMgmtCustomTypes/2019-06-17&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagCaus&quot;/>&lt;xsl:param name=&quot;IDRichOLO&quot;/>&lt;xsl:template name=&quot;Recharge-input&quot; match=&quot;/&quot;>&lt;tns:rechargeResultRequest>&lt;tns:resultOfRequirement>&lt;xsl:choose>&lt;xsl:when test=&quot;count($IDRichOLO/Record)>0&quot;>&lt;cst:OloOrderCode>&lt;xsl:value-of select=&quot;$IDRichOLO/Record[1]/CODICE_ORDINE_OLO&quot;/>&lt;/cst:OloOrderCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;cst:OloOrderCode>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/cst:OloOrderCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;cst:resourceId>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/IDRisorsa&quot;/>&lt;/cst:resourceId>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:AssetRicarica) and exists($Start/tns1:AssetRicarica/IDAssetRicarica)&quot;>&lt;cst:numberOfOrder>&lt;xsl:value-of select=&quot;xsd:string($Start/tns1:AssetRicarica/IDAssetRicarica)&quot;/>&lt;/cst:numberOfOrder>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSETRICARICA']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSETRICARICA']/valoreAttributo&quot;>&lt;cst:numberOfOrder>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DATIRICARICA']/attributiDettaglioOrdine[nomeAttributo='IDENTIFICATIVOASSETRICARICA']/valoreAttributo&quot;/>&lt;/cst:numberOfOrder>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;cst:OloAgcomCode>&lt;xsl:value-of select=&quot;$Start/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/cst:OloAgcomCode>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Richiesta/tipologiaSottolav,'SCHEDULAZIONE')&quot;>&lt;cst:actionType>&lt;xsl:value-of select=&quot;'SCHEDULAZIONE'&quot;/>&lt;/cst:actionType>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/tns1:Richiesta/tipologiaSottolav,'PROLUNGAMENTO')&quot;>&lt;cst:actionType>&lt;xsl:value-of select=&quot;'PROLUNGAMENTO'&quot;/>&lt;/cst:actionType>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/tns1:Richiesta/tipologiaSottolav,'ACCENSIONE')&quot;>&lt;cst:actionType>&lt;xsl:value-of select=&quot;'ACCENSIONE'&quot;/>&lt;/cst:actionType>&lt;/xsl:when>&lt;xsl:otherwise>&lt;cst:actionType>&lt;xsl:value-of select=&quot;'ANNULLAMENTO'&quot;/>&lt;/cst:actionType>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:AssetRicarica)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tipologiaSottolav='ANNULLAMENTORICARICA'&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:AssetRicarica/famigliaAsset&quot;>&lt;cst:typeOfRecharge>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/famigliaAsset&quot;/>&lt;/cst:typeOfRecharge>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tipologiaSottolav='ANNULLAMENTORICARICA'&quot;/>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tipologiaSottolav='PROLUNGAMENTORICARICA'&quot;>&lt;cst:typeOfRecharge>&lt;xsl:value-of select=&quot;'PROLUNGATA'&quot;/>&lt;/cst:typeOfRecharge>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:Richiesta/tipologiaSottolav='SCHEDULAZIONERICARICA'&quot;