            <bpws:invoke inputVariable="UpdateStagKO-input"
                name="UpdateStagKO" operation="InsertUpdateStaging"
                outputVariable="UpdateStagKO"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns3:InsertUpdateStagingPortType" tibex:xpdlId="5c0f505e-5716-462d-a213-0798f2caffa6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://telecomitalia.it/ResourceMgmt/" version="2.0"&gt;&lt;xsl:param name="InsertSTAG"/&gt;&lt;xsl:param name="ResourceMgmt"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Error"/&gt;&lt;xsl:param name="Validation"/&gt;&lt;xsl:template name="UpdateStagKO-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Validation='KO'"&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="'Errore Validazione tracciato'"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="'Chiamata al sistema non riuscita'"/&gt;&lt;/tns1:CONTENUTO_RESPONSE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:DESCR_ERRORE&gt;&lt;xsl:value-of select="$Error"/&gt;&lt;/tns1:DESCR_ERRORE&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="12"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RISPOSTA&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta/IDRichiestaOLO"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;tns1:NUMERO_RETRY&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns1:NUMERO_RETRY&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_ESB_OUT_NO_FILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertSTAG/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertSTAG/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertSTAG/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ResourceMgmt"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Error'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://telecomitalia.it/ResourceMgmt/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertSTAG.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;ResourceMgmt&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Error&quot;/>&#xa;    &lt;xsl:param name=&quot;Validation&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Validation='KO'&quot;>&#xa;                        &lt;tns1:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'Errore Validazione tracciato'&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'Chiamata al sistema non riuscita'&quot;/>&#xa;                        &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$Error&quot;/>&#xa;                &lt;/tns1:DESCR_ERRORE>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;        