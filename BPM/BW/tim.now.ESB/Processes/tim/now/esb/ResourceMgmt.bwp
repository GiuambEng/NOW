                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:tns2=&quot;http://telecomitalia.it/Duration/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Header-input&quot; match=&quot;/&quot;>&lt;tns:Header>&lt;tns:sourceSystem>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns:sourceSystem>&lt;tns:interactionDate>&lt;tns:Date>&lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&lt;/tns:Date>&lt;tns:Time>&lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&lt;/tns:Time>&lt;/tns:interactionDate>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:BusinessID)>0&quot;>&lt;tns:businessID>&lt;xsl:value-of select=&quot;$Start/tns1:BusinessID&quot;/>&lt;/tns:businessID>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Accumulate/tns2:BusinessID)>0&quot;>&lt;xsl:if test=&quot;$Accumulate/tns2:BusinessID[1]/tns2:BusinessID&quot;>&lt;tns:businessID>&lt;xsl:value-of select=&quot;$Accumulate/tns2:BusinessID[1]/tns2:BusinessID&quot;/>&lt;/tns:businessID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:businessID>&lt;xsl:value-of select=&quot;string(tib:timestamp())&quot;/>&lt;/tns:businessID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:messageID>&lt;xsl:value-of select=&quot;$Start/tns1:MessageID&quot;/>&lt;/tns:messageID>&lt;tns:transactionID>&lt;xsl:value-of select=&quot;$Start/tns1:TransactionID&quot;/>&lt;/tns:transactionID>&lt;/tns:Header>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:SOAPHeader="http://telecomitalia.it/SOA/SOAP/SOAPHeader"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="SOAPHeader:Header" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:invoke inputVariable="InsertSTAG-input"
                        name="InsertSTAG"
                        operation="InsertUpdateStaging"
                        outputVariable="InsertSTAG"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns3:InsertUpdateStagingPortType" tibex:xpdlId="71e2eb4e-f0fc-4e6c-988e-835ccadbf197">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://telecomitalia.it/ResourceMgmt/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ResourceMgmt"/&gt;&lt;xsl:param name="Recharge"/&gt;&lt;xsl:param name="Header"/&gt;&lt;xsl:param name="IDRichOLO"/&gt;&lt;xsl:template name="InsertSTAG-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;tns1:COD_OLO&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta/codificaOLOAGCOM"/&gt;&lt;/tns1:COD_OLO&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="concat(tib:render-xml($Recharge, true(), true()),'*',tib:render-xml($Header,true(),true()))"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;xsl:if test="$Start/tns2:Richiesta/IDRisorsa"&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta/IDRisorsa"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:TIMSTP_RICH&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Start/tns2:TransactionID"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($IDRichOLO/Record)&gt;0"&gt;&lt;xsl:if test="$IDRichOLO/Record[1]/CODICE_ORDINE_OLO"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="$IDRichOLO/Record[1]/CODICE_ORDINE_OLO"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/tns2:Richiesta/codiceOrdineOLO"&gt;&lt;tns1:COD_ID_ORDN&gt;&lt;xsl:value-of select="$Start/tns2:Richiesta/codiceOrdineOLO"/&gt;&lt;/tns1:COD_ID_ORDN&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:ID_TIPO_EVENTO_RIC&gt;&lt;xsl:value-of select="4"/&gt;&lt;/tns1:ID_TIPO_EVENTO_RIC&gt;&lt;xsl:if test="$Header/h:businessID"&gt;&lt;tns1:BU_ID&gt;&lt;xsl:value-of select="$Header/h:businessID"/&gt;&lt;/tns1:BU_ID&gt;&lt;/xsl:if&gt;&lt;tns1:MESSAGE_ID&gt;&lt;xsl:value-of select="$Start/tns2:MessageID"/&gt;&lt;/tns1:MESSAGE_ID&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_ESB_OUT_NO_FILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ResourceMgmt"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ResourceMgmt&quot;/>&#xa;    &lt;xsl:param name=&quot;Recharge&quot;/>&#xa;    &lt;xsl:param name=&quot;Header&quot;/>&#xa;    &lt;xsl:param name=&quot;IDRichOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertSTAG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns1:COD_OLO>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($Recharge, true(), true()),'*',tib:render-xml($Header,true(),true()))&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:Richiesta/IDRisorsa&quot;>&#xa;                    &lt;tns1:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/tns1:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;tns1:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:TransactionID&quot;/>&#xa;                &lt;/tns1:TRANSACTION_ID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($IDRichOLO/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$IDRichOLO/Record[1]/CODICE_ORDINE_OLO&quot;>&#xa;                            &lt;tns1:COD_ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$IDRichOLO/Record[1]/CODICE_ORDINE_OLO&quot;/>&#xa;                            &lt;/tns1:COD_ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns2:Richiesta/codiceOrdineOLO&quot;>&#xa;                            &lt;tns1:COD_ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns1:COD_ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:ID_TIPO_EVENTO_RIC>&#xa;                    &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                &lt;/tns1:ID_TIPO_EVENTO_RIC>&#xa;                &lt;xsl:if test=&quot;$Header/h:businessID&quot;>&#xa;                    &lt;tns1:BU_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Header/h:businessID&quot;/>&#xa;                    &lt;/tns1:BU_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:MESSAGE_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:MessageID&quot;/>&#xa;                &lt;/tns1:MESSAGE_ID>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_ESB_OUT_NO_FILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ResourceMgmt&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="MapperToInsertSTAG"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InsertSTAGToGenericLogger"/>
                            <bpws:source linkName="InsertSTAGToAssign2"
                                tibex:faultDetailsVar="InsertSTAG" tibex:faultNameVar="FaultName">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                            </bpws:source>
                        </bpws:sources>
                    </bpws:invoke>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;InsertSTAG&quot;/>&lt;xsl:template name=&quot;LogInsertSTAG-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:BusinessID&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;InsertSTAG&amp;quot;, tib:render-xml($InsertSTAG/RESPONSE/tns2:StagingResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                            inputVariable="LogInsertSTAG-input"
                            name="LogInsertSTAG"
                            tibex:xpdlId="f2cd4156-2f39-4aea-ad62-339d59bd868d"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="InsertSTAGToGenericLogger"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="LogInsertSTAGToAssign2"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://telecomitalia.it/ResourceMgmt/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertSTAG.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInsertSTAG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ResourceMgmt&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:BusinessID&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InsertSTAG&amp;quot;, tib:render-xml($InsertSTAG.RESPONSE,true(),true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:scope name="While" tibex:group="while" tibex:xpdlId="2e8f73af-500f-4e4d-ae6a-e59197203bfd">
                        <bpws:targets>
                            <bpws:target linkName="LogRechargeToWhile"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="WhileToHeader"/>
                        </bpws:sources>
                        <bpws:variables>
                            <bpws:variable name="index"
                                sca-bpel:internal="true" type="xsd:int">
                                <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                </bpws:from>
                            </bpws:variable>
                        </bpws:variables>
                        <bpws:sequence name="sequence" tibex:group="while">
                            <bpws:assign name="GroupInit"
                                tibex:group="groupInit" validate="no">
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+605339d2-8cb4-4919-8859-4e9a252f47f0" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:while name="while" tibex:counterName="index">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index&lt;=count($IDRichOLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($IDRichOLO/Record)]]></bpws:condition>
                                <bpws:flow name="flow6">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart3ToParseXml" tibex:linkType="SUCCESS"/>
                                    <bpws:link
