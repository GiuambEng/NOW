                                expression="$OLO_NPRequestServiceIn/Request/ns1:NPRequest/ns1:OLO_NPRequest/ns1:codiceOperatoreRec=$OLO_NPRequestServiceIn/Request/ns1:NPRequest/ns1:Header/h:sourceSystem" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$OLO_NPRequestServiceIn.Request/ns1:OLO_NPRequest/ns1:codiceOperatoreRec=$OLO_NPRequestServiceIn.Request/ns1:Header/h:sourceSystem]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToJDBCQuery2">
