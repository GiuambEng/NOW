                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;moduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;processName&quot;/>&#xa;    &lt;xsl:param name=&quot;operationName&quot;/>&#xa;    &lt;xsl:param name=&quot;parameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;Priority&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Element>&#xa;            &lt;tns6:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$moduleName&quot;/>&#xa;            &lt;/tns6:moduleName>&#xa;            &lt;tns6:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$parameterName&quot;/>&#xa;            &lt;/tns6:parameterName>&#xa;            &lt;tns6:parameterName2>&#xa;                &lt;xsl:value-of select=&quot;'BusinessID'&quot;/>&#xa;            &lt;/tns6:parameterName2>&#xa;            &lt;tns6:parameterName3>&#xa;                &lt;xsl:value-of select=&quot;'IDEsec'&quot;/>&#xa;            &lt;/tns6:parameterName3>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:parameterName4>&#xa;                    &lt;xsl:value-of select=&quot;'ScartoFastData'&quot;/>&#xa;                &lt;/tns6:parameterName4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:operationName>&#xa;                &lt;xsl:value-of select=&quot;$operationName&quot;/>&#xa;            &lt;/tns6:operationName>&#xa;            &lt;tns6:processName>&#xa;                &lt;xsl:value-of select=&quot;$processName&quot;/>&#xa;            &lt;/tns6:processName>&#xa;            &lt;tns6:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns6:value>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns6:value2>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns6:value2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($InsertStaging.RESPONSE/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE, '.')&quot;>&#xa;                    &lt;tns6:value3>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($InsertStaging.RESPONSE/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE,'.')&quot;/>&#xa;                    &lt;/tns6:value3>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;tns6:value3>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/tns6:value3>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:value4>&#xa;                    &lt;xsl:value-of select=&quot;'SCARTO'&quot;/>&#xa;                &lt;/tns6:value4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns6:ID_FILE>&#xa;            &lt;tns6:priority>&#xa;                &lt;xsl:value-of select=&quot;xsd:short($Priority)&quot;/>&#xa;            &lt;/tns6:priority>&#xa;            &lt;tns6:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$CreateRequest/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns6:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$CreateRequest/ambito&quot;>&#xa;                &lt;tns6:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$CreateRequest/ambito&quot;/>&#xa;                &lt;/tns6:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$CreateRequest/strutturaRichiesta&quot;/>&#xa;            &lt;/tns6:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$CreateRequest/codiceOrdineOLO&quot;>&#xa;                &lt;tns6:Code_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$CreateRequest/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns6:Code_OLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns6:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
