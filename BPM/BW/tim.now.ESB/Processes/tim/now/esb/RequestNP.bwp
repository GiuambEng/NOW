                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDRICHIESTAOLO ,CREATED&#xa;FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE &#xa; STATORICHIESTANOW IN ('PERVENUTOB2B','ACQUISITOB2B','INVIATOADELIVERYB2B','LAVORAZIONEHD')&#xa;AND CODICEORDINEOLO=? AND OFFERTA='NP'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
