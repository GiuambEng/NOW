           &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
