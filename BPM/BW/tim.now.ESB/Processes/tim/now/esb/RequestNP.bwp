                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO2&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery3&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset2&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&#xa;                            &lt;statoRichiestaNOW>&#xa;                                &lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&#xa;                            &lt;/statoRichiestaNOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statoRichiestaNOW>&#xa;                                &lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&#xa;                            &lt;/statoRichiestaNOW>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&#xa;                            &lt;statoRichiestaPrecedNOW>&#xa;                                &lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&#xa;                            &lt;/statoRichiestaPrecedNOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statoRichiestaPrecedNOW>&#xa;                                &lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&#xa;                            &lt;/statoRichiestaPrecedNOW>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B']) or $OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ESPLETATOKO&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ESECUZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$OLO2/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$OLO2/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;codiceOrdineOLOTarget>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/codiceOrdineOLOTarget>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($Asset2/Record)>0 and exists($Asset2/Record[1]/IDCONTRATTO)&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Asset2/Record[1]/IDCONTRATTO)&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;IDOfferta>&#xa;                &lt;xsl:value-of select=&quot;20&quot;/>&#xa;            &lt;/IDOfferta>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()),'+'))&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;codificaOLOAGCOMDonor>&#xa;                &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;            &lt;/codificaOLOAGCOMDonor>&#xa;            &lt;xsl:if test=&quot;$JDBCQuery3/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOWDonor>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQuery3/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOWDonor>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;tipologiaScenario>&#xa;                &lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&#xa;            &lt;/tipologiaScenario>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;        &lt;/tns4:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
