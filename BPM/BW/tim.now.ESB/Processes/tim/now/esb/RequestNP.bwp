                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:param name=&quot;ANAG_CAUS&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;statoRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaOLO>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$OLO/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$OLO/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;codiceOrdineOLOTarget>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/codiceOrdineOLOTarget>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($ANAG_CAUS/Record)>0&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($ANAG_CAUS/Record[1]/ID_ANAG_CAUS)&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/COGNOMERAGIONESOCIALE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Asset/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                        &lt;cognomeRagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                        &lt;/cognomeRagioneSociale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/NOME)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Asset/Record[1]/NOME&quot;>&#xa;                        &lt;nome>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Record[1]/NOME&quot;/>&#xa;                        &lt;/nome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/CODICEFISCALE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Asset/Record[1]/CODICEFISCALE&quot;>&#xa;                        &lt;CF>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Record[1]/CODICEFISCALE&quot;/>&#xa;                        &lt;/CF>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/PARTITAIVA)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Asset/Record[1]/PARTITAIVA&quot;>&#xa;                        &lt;PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Record[1]/PARTITAIVA&quot;/>&#xa;                        &lt;/PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;>&#xa;                        &lt;noteCliente>&#xa;                            &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:note&quot;/>&#xa;                        &lt;/noteCliente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($OLO/Record[1]/COD_OLO)>0&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$OLO/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;'PORTABILITASUCCESSIVADEL82'&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;xsl:for-each select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn&quot;>&#xa;                    &lt;dettaglioordine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;nomeComponente>&#xa;                            &lt;xsl:value-of select=&quot;'NUMBERPORTABILITY'&quot;/>&#xa;                        &lt;/nomeComponente>&#xa;                        &lt;integrationID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/integrationID>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'NUMEROTELEFONICO'&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'NUMEROTELEFONICOPRINCIPALE'&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'CODICEOPERATOREDONOR'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'DISTRETTO'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;substring(.,2,1)='2' or substring(.,2,1)='6'&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;concat('0', substring(.,1,2))&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;substring(.,2,1)!='2' and  substring(.,2,1)!='6'  and (substring(.,3,1)='0' or substring(.,3,1)='1' or substring(.,3,1)='5' or substring(.,3,1)='9')&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;substring(.,1, 3)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;substring(.,2, 3)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                        &lt;xsl:if test=&quot;string-length(../../tns3:routingNumber)>0&quot;>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'ROUTINGNUMBER'&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;../../tns3:routingNumber&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;progressivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/progressivo>&#xa;                        &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                            &lt;IDRisorsaNOW>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                            &lt;/IDRisorsaNOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;azione>&#xa;                            &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                        &lt;/azione>&#xa;                    &lt;/dettaglioordine>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;tipologiaAccesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                &lt;/tipologiaAccesso>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],2,1)='2' or substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],2,1)='6'&quot;>&#xa;                        &lt;distretto>&#xa;                            &lt;xsl:value-of select=&quot;concat('0', substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],1,2))&quot;/>&#xa;                        &lt;/distretto>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],2,1)!='2' and  substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],2,1)!='6'  and (substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],3,1)='0' or substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],3,1)='1' or substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],3,1)='5' or substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],3,1)='9')&quot;>&#xa;                        &lt;distretto>&#xa;                            &lt;xsl:value-of select=&quot;substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],1, 3)&quot;/>&#xa;                        &lt;/distretto>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;distretto>&#xa;                            &lt;xsl:value-of select=&quot;substring($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1],2, 3)&quot;/>&#xa;                        &lt;/distretto>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                    &lt;numeroTelefonico>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                    &lt;/numeroTelefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOMDonor>&#xa;                    &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                &lt;/codificaOLOAGCOMDonor>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&#xa;                    &lt;codificaOLONOWDonor>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/codificaOLONOWDonor>&#xa;                &lt;/xsl:if>&#xa;                &lt;tipologiaScenario>&#xa;                    &lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&#xa;                &lt;/tipologiaScenario>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:if test=&quot;count($Asset/Record)>0 and exists($Asset/Record[1]/IDCONTRATTO)&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Asset/Record[1]/IDCONTRATTO)&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;IDOfferta>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery1/Record[1]/ID_OFFERTA)&quot;/>&#xa;            &lt;/IDOfferta>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()),'+'))&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;codificaOLOAGCOMDonor>&#xa;                &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;            &lt;/codificaOLOAGCOMDonor>&#xa;            &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOWDonor>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOWDonor>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;tipologiaScenario>&#xa;                &lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&#xa;            &lt;/tipologiaScenario>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;        &lt;/tns4:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:RichiestaElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogCreateRequest-input"
                    name="LogCreateRequest"
                    tibex:xpdlId="8036f500-bb80-4bcc-a0e9-9a2ee3ec7945"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToGenericLogger1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger1ToRenderXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateRequest&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCreateRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('CreateRequest',tib:render-xml($CreateRequest, true(), true()))&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RenderXml-input"
                    name="RenderXml" outputVariable="RenderXml"
                    tibex:xpdlId="77c18ed7-8f8e-4bd8-8abf-a0a31f84c750" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLogger1ToRenderXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderXmlToGenericLogger2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateRequest&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$CreateRequest&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger2-input"
                    name="GenericLogger2"
                    tibex:xpdlId="3cf5dcc4-bfe2-4880-a172-5c7a68961fa3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToGenericLogger2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger2ToProcessManagementSubProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;moduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;processName&quot;/>&#xa;    &lt;xsl:param name=&quot;operationName&quot;/>&#xa;    &lt;xsl:param name=&quot;parameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;Priority&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessManagementSubProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Element>&#xa;            &lt;tns6:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$moduleName&quot;/>&#xa;            &lt;/tns6:moduleName>&#xa;            &lt;tns6:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$parameterName&quot;/>&#xa;            &lt;/tns6:parameterName>&#xa;            &lt;tns6:parameterName2>&#xa;                &lt;xsl:value-of select=&quot;'BusinessID'&quot;/>&#xa;            &lt;/tns6:parameterName2>&#xa;            &lt;tns6:parameterName3>&#xa;                &lt;xsl:value-of select=&quot;'IDEsec'&quot;/>&#xa;            &lt;/tns6:parameterName3>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:parameterName4>&#xa;                    &lt;xsl:value-of select=&quot;'ScartoFastData'&quot;/>&#xa;                &lt;/tns6:parameterName4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:operationName>&#xa;                &lt;xsl:value-of select=&quot;$operationName&quot;/>&#xa;            &lt;/tns6:operationName>&#xa;            &lt;tns6:processName>&#xa;                &lt;xsl:value-of select=&quot;$processName&quot;/>&#xa;            &lt;/tns6:processName>&#xa;            &lt;tns6:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns6:value>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns6:value2>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns6:value2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($InsertStaging/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE, '.')&quot;>&#xa;                    &lt;tns6:value3>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($InsertStaging/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE,'.')&quot;/>&#xa;                    &lt;/tns6:value3>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;tns6:value3>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/tns6:value3>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:value4>&#xa;                    &lt;xsl:value-of select=&quot;'SCARTO'&quot;/>&#xa;                &lt;/tns6:value4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns6:ID_FILE>&#xa;            &lt;tns6:priority>&#xa;                &lt;xsl:value-of select=&quot;xsd:short($Priority)&quot;/>&#xa;            &lt;/tns6:priority>&#xa;            &lt;tns6:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$CreateRequest/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns6:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$CreateRequest/ambito&quot;>&#xa;                &lt;tns6:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$CreateRequest/ambito&quot;/>&#xa;                &lt;/tns6:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$CreateRequest/strutturaRichiesta&quot;/>&#xa;            &lt;/tns6:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$CreateRequest/codiceOrdineOLO&quot;>&#xa;                &lt;tns6:Code_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$CreateRequest/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns6:Code_OLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns6:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
