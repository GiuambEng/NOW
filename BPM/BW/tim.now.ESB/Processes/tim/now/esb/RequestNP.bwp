                            <bpws:link name="Assign12ToReply" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="GenericLogger3-input"
                                name="GenericLogger3"
                                tibex:xpdlId="d1a995cf-277f-4d26-a9f5-1d277e2f6b4f"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="GenericLogger3ToAssign12"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;tns6:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/FullClass,$FaultDetails/Class)&quot;/>&#xa;                &lt;/tns6:Message>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:Ack>&#xa;                &lt;tns3:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns3:idNotifica>&#xa;                &lt;tns3:esito>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns3:esito>&#xa;                &lt;tns3:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;'N03'&quot;/>&#xa;                &lt;/tns3:codiceMotivazione>&#xa;                &lt;tns3:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&#xa;                &lt;/tns3:motivazione>&#xa;            &lt;/tns3:Ack>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="Response" name="Assign12"
                                outputVariable="Response"
                                tibex:xpdlId="be6cdd56-662a-4938-a4d7-b528e0c18510" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger3ToAssign12"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign12ToInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($IDEsec)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($IDEsec)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Assign12ToReply">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:Ack>&#xa;                &lt;tns3:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns3:idNotifica>&#xa;                &lt;tns3:esito>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns3:esito>&#xa;                &lt;tns3:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;'N03'&quot;/>&#xa;                &lt;/tns3:codiceMotivazione>&#xa;                &lt;tns3:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;'Messaggio non ammesso'&quot;/>&#xa;                &lt;/tns3:motivazione>&#xa;            &lt;/tns3:Ack>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Invoke-input"
                            name="Invoke"
                            operation="InsertUpdateStaging"
                            outputVariable="Invoke"
                            partnerLink="InsertUpdateStagingPortType"
                            portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="5b766abf-a56b-4399-9a59-dc319b31290c">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns7="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://olo2olo.npfibra.it/migrazione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Response"/&gt;
    &lt;xsl:param name="IDEsec"/&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="OLO_NPRequestServiceIn"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns7:StagingRequest&gt;
                    &lt;tns7:StagingIn&gt;
                        &lt;tns7:COD_ORDN_OLO&gt;
                            &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS"/&gt;
                        &lt;/tns7:COD_ORDN_OLO&gt;
                        &lt;tns7:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($Response, true(), true())"/&gt;
                        &lt;/tns7:CONTENUTO_RESPONSE&gt;
                        &lt;tns7:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="concat($FaultDetails/ActivityName, $FaultDetails/ProcessStack,$FaultDetails/StackTrace,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/FullClass,$FaultDetails/Class)"/&gt;
                        &lt;/tns7:DESCR_ERRORE&gt;
                        &lt;tns7:ID_RICH&gt;
                            &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:idNotifica"/&gt;
                        &lt;/tns7:ID_RICH&gt;
                        &lt;tns7:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="49"/&gt;
                        &lt;/tns7:ID_STATO_ELAB_STAG&gt;
                        &lt;tns7:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns7:TIMSTP_RISPOSTA&gt;
                    &lt;/tns7:StagingIn&gt;
                    &lt;tns7:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns7:IdRichiestaOLO&gt;
                    &lt;tns7:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_FASTDATA_INPUT_NO_FILE'"/&gt;
                    &lt;/tns7:StagingType&gt;
                    &lt;tns7:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;ns1:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="'PROCESSO_FASTDATA_NOW_REQ_NPDEL82'"/&gt;
                            &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($IDEsec))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="127"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns7:LoggerIn&gt;
                &lt;/tns7:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
