3:numerazioni/tns3:dn[1],2, 3)&quot;/>&lt;/distretto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&lt;/tipologiaScenario>&lt;/ordine>&lt;xsl:if test=&quot;count($Asset/Record)>0 and exists($Asset/Record[1]/IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($Asset/Record[1]/IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery1/Record[1]/ID_OFFERTA)&quot;/>&lt;/IDOfferta>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()),'+'))&quot;/>&lt;/DRO>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&lt;/tipologiaScenario>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/tns4:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
