                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;moduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;processName&quot;/>&#xa;    &lt;xsl:param name=&quot;operationName&quot;/>&#xa;    &lt;xsl:param name=&quot;parameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;Priority&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateRequestScarto&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml1&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessManagementSubProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Element>&#xa;            &lt;tns6:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$moduleName&quot;/>&#xa;            &lt;/tns6:moduleName>&#xa;            &lt;tns6:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$parameterName&quot;/>&#xa;            &lt;/tns6:parameterName>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:parameterName4>&#xa;                    &lt;xsl:value-of select=&quot;'ScartoFastData'&quot;/>&#xa;                &lt;/tns6:parameterName4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:operationName>&#xa;                &lt;xsl:value-of select=&quot;$operationName&quot;/>&#xa;            &lt;/tns6:operationName>&#xa;            &lt;tns6:processName>&#xa;                &lt;xsl:value-of select=&quot;$processName&quot;/>&#xa;            &lt;/tns6:processName>&#xa;            &lt;tns6:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml1&quot;/>&#xa;            &lt;/tns6:value>&#xa;            &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&#xa;                &lt;tns6:value4>&#xa;                    &lt;xsl:value-of select=&quot;'SCARTO'&quot;/>&#xa;                &lt;/tns6:value4>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns6:ID_FILE>&#xa;            &lt;tns6:priority>&#xa;                &lt;xsl:value-of select=&quot;xsd:short($Priority)&quot;/>&#xa;            &lt;/tns6:priority>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateRequestScarto)&quot;>&#xa;                    &lt;tns6:CodificaOLOAgicom>&#xa;                        &lt;xsl:value-of select=&quot;$CreateRequestScarto/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns6:CodificaOLOAgicom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns6:CodificaOLOAgicom>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns6:CodificaOLOAgicom>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateRequestScarto)&quot;>&#xa;                    &lt;xsl:if test=&quot;$CreateRequestScarto/ambito&quot;>&#xa;                        &lt;tns6:Ambito>&#xa;                            &lt;xsl:value-of select=&quot;$CreateRequestScarto/ambito&quot;/>&#xa;                        &lt;/tns6:Ambito>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Mapper/ambito&quot;>&#xa;                        &lt;tns6:Ambito>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/ambito&quot;/>&#xa;                        &lt;/tns6:Ambito>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateRequestScarto)&quot;>&#xa;                    &lt;tns6:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$CreateRequestScarto/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns6:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns6:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns6:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateRequestScarto)&quot;>&#xa;                    &lt;xsl:if test=&quot;$CreateRequestScarto/codiceOrdineOLO&quot;>&#xa;                        &lt;tns6:Code_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$CreateRequestScarto/codiceOrdineOLO&quot;/>&#xa;                        &lt;/tns6:Code_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Mapper/codiceOrdineOLO&quot;>&#xa;                        &lt;tns6:Code_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/codiceOrdineOLO&quot;/>&#xa;                        &lt;/tns6:Code_OLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns6:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.esb.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b2776b30-cd74-4bbf-b968-1582347f5441+input&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;CODICEORDINEOLO>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/CODICEORDINEOLO>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQuery2-input" name="JDBCQuery2"
                    outputVariable="JDBCQuery2"
                    tibex:xpdlId="b2776b30-cd74-4bbf-b968-1582347f5441" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign11ToJDBCQuery2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery2ToGenericLogger4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b2776b30-cd74-4bbf-b968-1582347f5441+input&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;CODICEORDINEOLO>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;            &lt;/CODICEORDINEOLO>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDRICHIESTAOLO,STATORICHIESTANOW &#xa;FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE &#xa; STATORICHIESTANOW IN ('PERVENUTOB2B','ACQUISITOB2B','SCARTATOB2B')&#xa;AND CODICEORDINEOLO=?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINEOLO"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger4-input"
                    name="GenericLogger4"
                    tibex:xpdlId="3ba650bd-ad9d-4540-9221-846e7099da7b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery2ToGenericLogger4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger4ToEmpty10"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery2/Record)>0&quot;>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Richiesta con stato scartato Record trovato',tib:render-xml($JDBCQuery2,true(), true()))&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Richiesta con stato scartato Record non trovato'&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&lt;xsl:param name=&quot;OLO2&quot;/>&lt;xsl:param name=&quot;JDBCQuery3&quot;/>&lt;xsl:param name=&quot;Asset2&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns4:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery2/Record[STATORICHIESTANOW='ACQUISITOB2B']) or $OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETATOKO&amp;quot;&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESECUZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OLO2/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$OLO2/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLO>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLOTarget>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note)>0&quot;>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset2/Record)>0 and exists($Asset2/Record[1]/IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($Asset2/Record[1]/IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;20&quot;/>&lt;/IDOfferta>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()),'+'))&quot;/>&lt;/DRO>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;xsl:if test=&quot;$JDBCQuery3/Record[1]/COD_OLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$JDBCQuery3/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&lt;/tipologiaScenario>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/tns4:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
