                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Asset/Record) > 0&quot;>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Asset Record trovato',tib:render-xml($Asset,true(), true()))&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Asset Record non trovato'&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:Ack>&#xa;                &lt;tns3:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns3:idNotifica>&#xa;                &lt;tns3:esito>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns3:esito>&#xa;                &lt;tns3:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;'N02'&quot;/>&#xa;                &lt;/tns3:codiceMotivazione>&#xa;                &lt;tns3:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_REC non ammesso'&quot;/>&#xa;                &lt;/tns3:motivazione>&#xa;            &lt;/tns3:Ack>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Response" name="Assign14"
                    outputVariable="Response"
                    tibex:xpdlId="94a74c88-1579-4237-8145-48836576e681" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty11ToAssign14"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign14ToJDBCQuery4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:Ack>&#xa;                &lt;tns3:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns3:idNotifica>&#xa;                &lt;tns3:esito>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns3:esito>&#xa;                &lt;tns3:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;'N02'&quot;/>&#xa;                &lt;/tns3:codiceMotivazione>&#xa;                &lt;tns3:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_REC non ammesso'&quot;/>&#xa;                &lt;/tns3:motivazione>&#xa;            &lt;/tns3:Ack>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
