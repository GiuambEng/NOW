                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Asset-input" name="Asset"
                    outputVariable="Asset"
                    tibex:xpdlId="73c7d2eb-487e-4d5e-a561-d22dbb5ce179" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
