                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Response" name="Assign"
                    outputVariable="Response"
                    tibex:xpdlId="e2cb40ef-fe9f-4b55-8060-ee23449374f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
