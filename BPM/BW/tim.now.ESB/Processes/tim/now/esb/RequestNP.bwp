            <bpws:invoke inputVariable="UpdateStagOK_KO-input"
                name="UpdateStagOK_KO" operation="InsertUpdateStaging"
                outputVariable="UpdateStagOK_KO"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="82defd35-02ac-4663-954d-e475ce80d531">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns7="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://olo2olo.npfibra.it/migrazione/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Response"/&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="OLO_NPRequestServiceIn"/&gt;
    &lt;xsl:template name="UpdateStagOK_KO-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns7:StagingRequest&gt;
                    &lt;tns7:StagingIn&gt;
                        &lt;tns7:COD_ORDN_OLO&gt;
                            &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS"/&gt;
                        &lt;/tns7:COD_ORDN_OLO&gt;
                        &lt;tns7:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($Response, true(), true())"/&gt;
                        &lt;/tns7:CONTENUTO_RESPONSE&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($Response/tns3:Ack/tns3:codiceMotivazione)&gt;0"&gt;
                                &lt;xsl:if test="$Response/tns3:Ack/tns3:codiceMotivazione"&gt;
                                    &lt;tns7:DESCR_ERRORE&gt;
                                        &lt;xsl:value-of select="$Response/tns3:Ack/tns3:codiceMotivazione"/&gt;
                                    &lt;/tns7:DESCR_ERRORE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($Response/tns3:Ack/tns3:codiceMotivazione)&gt;0"&gt;
                                &lt;tns7:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="46"/&gt;
                                &lt;/tns7:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns7:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="47"/&gt;
                                &lt;/tns7:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns7:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns7:TIMSTP_RISPOSTA&gt;
                    &lt;/tns7:StagingIn&gt;
                    &lt;tns7:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns7:IdRichiestaOLO&gt;
                    &lt;tns7:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_FASTDATA_INPUT_NO_FILE'"/&gt;
                    &lt;/tns7:StagingType&gt;
                    &lt;tns7:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;ns1:COD_PROCSO_FILE&gt;
                                &lt;xsl:value-of select="'PROCESSO_FASTDATA_NOW_REQ_NPDEL82'"/&gt;
                            &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="127"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns7:LoggerIn&gt;
                &lt;/tns7:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagOK_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:StagingRequest>&#xa;            &lt;tns7:StagingIn>&#xa;                &lt;tns7:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;                &lt;/tns7:COD_ORDN_OLO>&#xa;                &lt;tns7:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Response, true(), true())&quot;/>&#xa;                &lt;/tns7:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Response/tns3:Ack/tns3:codiceMotivazione)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Response/tns3:Ack/tns3:codiceMotivazione&quot;>&#xa;                            &lt;tns7:DESCR_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$Response/tns3:Ack/tns3:codiceMotivazione&quot;/>&#xa;                            &lt;/tns7:DESCR_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa; 