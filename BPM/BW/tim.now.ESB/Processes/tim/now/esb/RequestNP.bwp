            <bpws:invoke inputVariable="LogAccessiUtenti-input"
                name="LogAccessiUtenti" operation="NewOperation"
                outputVariable="LogAccessiUtenti"
                partnerLink="LogAccessiUtenti"
                portType="ns6:ServiceSecurity" tibex:xpdlId="f9d007f1-3936-4c70-b197-2fb13deac8f2">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns1="http://www.example.org/ServicesSecurityData" xmlns:ns="www.tim.now.HeaderConnection" xmlns:tns2="http://www.example.com/namespaces/tns/1564740682912" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:param name="GetLocalIP"/&gt;&lt;xsl:param name="LoggerName"/&gt;&lt;xsl:param name="LogLevel"/&gt;&lt;xsl:param name="GetContext"/&gt;&lt;xsl:template name="LogAccessiUtenti-input" match="/"&gt;&lt;tns:NewOperationRequest&gt;&lt;parameters&gt;&lt;tns1:LoggerSecurityInput&gt;&lt;tns1:LogInfo&gt;&lt;tns1:LoggerName&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:LoggerName&gt;&lt;tns1:Application&gt;&lt;xsl:value-of select="&amp;quot;tim.now.ESB.application&amp;quot;"/&gt;&lt;/tns1:Application&gt;&lt;tns1:LogLevel&gt;&lt;xsl:value-of select="$LogLevel"/&gt;&lt;/tns1:LogLevel&gt;&lt;tns1:ServiceName&gt;&lt;xsl:value-of select="&amp;quot;O2ONPFibra&amp;quot;"/&gt;&lt;/tns1:ServiceName&gt;&lt;tns1:Operation&gt;&lt;xsl:value-of select="'OLO_NPRequestService'"/&gt;&lt;/tns1:Operation&gt;&lt;tns1:JMS&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:JMS&gt;&lt;/tns1:LogInfo&gt;&lt;tns1:InputDataUserLog&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value) &gt; 0"&gt;&lt;xsl:if test="$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value"&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="&amp;quot;NPFIBRA&amp;quot;"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:COD_FUNZIONE&gt;&lt;xsl:value-of select="'Richiesta NP DEL82'"/&gt;&lt;/tns1:COD_FUNZIONE&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="&amp;quot;M2M&amp;quot;"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:HOSTNAME_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP/tns2:IPAddress"&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP/tns2:IPAddress"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns1:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns1:OS_USER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="'ID322'"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="concat('OLO_NPRequest',$_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'M2M_SDR'"/&gt;&lt;/tns1:SISTEMA_CHIAMANTE&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccessiUtenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:LoggerSecurityInput>&#xa;            &lt;tns1:LogInfo>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns1:ServiceName>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value&quot;>&#xa;                            &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                                &lt;xsl:value-of select=&quot;$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value&quot;/>&#xa;                            &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NPFIBRA&amp;quot;&quot;/>&#xa;                        &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'Richiesta NP DEL82'&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;tns1:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;M2M&amp;quot;&quot;/>&#xa;                &lt;/tns1:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns1:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns1:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'ID322'&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('OLO_NPRequest',$_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'M2M_SDR'&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GetLocalIPToLogAccessiUtenti"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogAccessiUtentiToAssign1"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="InsertUpdateStaging"
                outputVariable="InsertStaging"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="981b757c-9f86-4059-b662-4e969d0128af">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns7="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns3="http://olo2olo.npfibra.it/migrazione/" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="OLO_NPRequestServiceIn"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="Mapper1"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns6:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns7:StagingRequest&gt;
                    &lt;tns7:StagingIn&gt;
                        &lt;tns7:COD_ORDN_OLO&gt;
                            &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS"/&gt;
                        &lt;/tns7:COD_ORDN_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)&gt;0"&gt;
                                &lt;tns7:COD_OLO&gt;
                                    &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec"/&gt;
                                &lt;/tns7:COD_OLO&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns7:COD_OLO&gt;
                                    &lt;xsl:value-of select="&amp;quot;NNN&amp;quot;"/&gt;
                                &lt;/tns7:COD_OLO&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns7:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($Mapper1, true(), true())"/&gt;
                        &lt;/tns7:CONTENUTO_REQUEST&gt;
                        &lt;tns7:ID_RICH&gt;
                            &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:idNotifica"/&gt;
                        &lt;/tns7:ID_RICH&gt;
                        &lt;tns7:ID_RICH_JPUB_RISPOSTE&gt;
                            &lt;xsl:value-of select="xsd:int($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica)"/&gt;
                        &lt;/tns7:ID_RICH_JPUB_RISPOSTE&gt;
                        &lt;tns7:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="42"/&gt;
                        &lt;/tns7:ID_STATO_ELAB_STAG&gt;
                        &lt;tns7:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns7:TIMSTP_RICH&gt;
                        &lt;xsl:if test="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID"&gt;
                            &lt;tns7:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:transactionID"/&gt;
                            &lt;/tns7:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem"&gt;
                            &lt;tns7:RC&gt;
                                &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem"/&gt;
                            &lt;/tns7:RC&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID"&gt;
                            &lt;tns7:BU_ID&gt;
                                &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:businessID"/&gt;
                            &lt;/tns7:BU_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:messageID"&gt;
                            &lt;tns7:MESSAGE_ID&gt;
                                &lt;xsl:value-of select="$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:messageID"/&gt;
                            &lt;/tns7:MESSAGE_ID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns7:StagingIn&gt;
                    &lt;tns7:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns7:IdRichiestaOLO&gt;
                    &lt;tns7:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_FASTDATA_INPUT_NO_FILE'"/&gt;
                    &lt;/tns7:StagingType&gt;
                    &lt;tns7:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="127"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;Info&amp;quot;"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RICHIESTA XML RICEVUTA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns7:LoggerIn&gt;
                &lt;/tns7:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns6:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:StagingRequest>&#xa;            &lt;tns7:StagingIn>&#xa;                &lt;tns7:COD_ORDN_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&#xa;                &lt;/tns7:COD_ORDN_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&#xa;                        &lt;tns7:COD_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;                        &lt;/tns7:COD_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:COD_OLO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&#xa;                        &lt;/tns7:COD_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper1, true(), true())&quot;/>&#xa;                &lt;/tns7:CONTENUTO_REQUEST>&#xa;                &lt;tns7:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns7:ID_RICH>&#xa;                &lt;tns7:ID_RICH_JPUB_RISPOSTE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:tipoNotifica)&quot;/>&#xa;                &lt;/tns7:ID_RICH_JPUB_RISPOSTE>&#xa;                &lt;tns7:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns7:ID_STATO_ELAB_STAG>&#xa;                &lt;tns7:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;tns7:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/tns7:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;tns7:RC>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/tns7:RC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;tns7:BU_ID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/tns7:BU_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:messageID&quot;>&#xa;                    &lt;tns7:MESSAGE_ID>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:Header/h:messageID&quot;/>&#xa;                    &lt;/tns7:MESSAGE_ID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns7:StagingIn>&#xa;            &lt;tns7:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns7:IdRichiestaOLO>&#xa;            &lt;tns7:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_FASTDATA_INPUT_NO_FILE'&quot;/>&#xa;            &lt;/tns7:StagingType>&#xa;            &lt;tns7:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;127&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Info&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW SINC: RICHIESTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns7:LoggerIn>&#xa;        &lt;/tns7:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Mapper1ToInsertStaging"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingToAssign13"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:empty name="Empty" tibex:xpdlId="9f207a4a-5028-468c-af6b-e1a18fb7b131">
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdateToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToJDBCQuery2_X0203">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery_X01">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$OLO_NPRequestServiceIn/Request/ns1:NPRequest/ns1:OLO_NPRequest/ns1:tipoNotifica='01'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$OLO_NPRequestServiceIn.Request/ns1:OLO_NPRequest/ns1:tipoNotifica='01']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+58b71ef7-ddd5-4d74-81f0-40d463f7802a+input&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OLO-input" name="OLO"
                    outputVariable="OLO"
                    tibex:xpdlId="58b71ef7-ddd5-4d74-81f0-40d463f7802a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery_X01"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+58b71ef7-ddd5-4d74-81f0-40d463f7802a+input&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn.Request&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn.Request/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT  CODFC_OLO_AGCOM,COD_OLO&#xa;  FROM OLO&#xa;  WHERE CODFC_OLO_AGCOM = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOLO-input"
                    name="LogOLO"
                    tibex:xpdlId="833a2ccd-4238-4ab4-91cf-bee9ea135814"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOLOToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($OLO/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($OLO/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOLOToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($OLO/Record)>0&quot;>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('OLO Record trovato',tib:render-xml($OLO,true(), true()))&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;'OLO Record non trovato'&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:Ack>&#xa;                &lt;tns3:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:idNotifica&quot;/>&#xa;                &lt;/tns3:idNotifica>&#xa;                &lt;tns3:esito>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/tns3:esito>&#xa;                &lt;tns3:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;'N02'&quot;/>&#xa;                &lt;/tns3:codiceMotivazione>&#xa;                &lt;tns3:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;'Campo CODICE_OPERATORE_REC non ammesso'&quot;/>&#xa;                &lt;/tns3:motivazione>&#xa;            &lt;/tns3:Ack>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;  