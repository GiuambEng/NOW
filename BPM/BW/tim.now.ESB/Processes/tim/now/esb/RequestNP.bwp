                <bpws:sources>
                    <bpws:source linkName="Empty12ToUpdateStagOK03">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($JDBCQuery2/Record[STATORICHIESTANOW='PERVENUTOB2B'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($JDBCQuery2/Record[STATORICHIESTANOW='PERVENUTOB2B'])]]></bpws:transitionCondition>
                    </bpws:source>
