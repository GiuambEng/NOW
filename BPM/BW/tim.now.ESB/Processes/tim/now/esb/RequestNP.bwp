                                expression="count($OLOAccorpante/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($OLOAccorpante/Record)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
