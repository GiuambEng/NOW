            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogOLOAccorpante-input"
                    name="LogOLOAccorpante"
                    tibex:xpdlId="0704e316-8b65-4bb3-aac1-3ae6302a8ed3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OLOAccorpanteToGenericLogger4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger4ToEmpty11"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;OLOAccorpante&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns6:Application>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RequestNP&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O2ONPFibra&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'OLO_NPRequestService'&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;tns6:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns6:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($OLOAccorpante/Record) > 0&quot;>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('OLO Accorpante Record trovato',tib:render-xml($OLOAccorpante,true(), true()))&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Message>&#xa;                            &lt;xsl:value-of select=&quot;'OLO Accorpante Record non trovato'&quot;/>&#xa;                        &lt;/tns6:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&lt;xsl:param name=&quot;OLO2&quot;/>&lt;xsl:param name=&quot;JDBCQuery3&quot;/>&lt;xsl:param name=&quot;Asset2&quot;/>&lt;xsl:param name=&quot;JDBCQuery4&quot;/>&lt;xsl:template name=&quot;CreateRequestScarto-input&quot; match=&quot;/&quot;>&lt;tns4:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&lt;/statoRichiestaOLO>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESECUZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OLO2/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$OLO2/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLO>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLOTarget>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery4/Record)>0&quot;>&lt;IDAnagraficaCausale>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery4/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/IDAnagraficaCausale>&lt;/xsl:when>&lt;xsl:otherwise/