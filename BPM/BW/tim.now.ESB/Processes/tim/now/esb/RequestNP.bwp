            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLO_NPRequestServiceIn&quot;/>&lt;xsl:param name=&quot;OLO&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;Asset&quot;/>&lt;xsl:param name=&quot;ANAG_CAUS&quot;/>&lt;xsl:template name=&quot;CreateRequest-input&quot; match=&quot;/&quot;>&lt;tns4:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Response/tns3:Ack/tns3:esito='1'&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTOB2B&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&lt;/statoRichiestaOLO>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOperatoreRec&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;NNN&amp;quot;&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OLO/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$OLO/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLO>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:codiceOrdineWHS&quot;/>&lt;/codiceOrdineOLOTarget>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ANAG_CAUS/Record)>0&quot;>&lt;IDAnagraficaCausale>&lt;xsl:value-of select=&quot;xsd:int($ANAG_CAUS/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/IDAnagraficaCausale>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note)>0&quot;>&lt;xsl:if test=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$OLO_NPRequestServiceIn/Request/tns3:NPRequest/tns3:OLO_NPRequest/tns3:note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:if>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/COGNOMERAGIONESOCIALE)>0&quot;>&lt;xsl:if test=&quot;$Asset/Record[1]/COGNOMERAGIONESOCIALE&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Asset/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/NOME)>0&quot;>&lt;xsl:if test=&quot;$Asset/Record[1]/NOME&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$Asset/Record[1]/NOME&quot;/>&lt;/nome>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/CODICEFISCALE)>0&quot;>&lt;xsl:if test=&quot;$Asset/Record[1]/CODICEFISCALE&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Asset/Record[1]/CODICEFISCALE&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset/Record)>0 and string-length($Asset/Record[1]/PARTITAIVA)>0&quot;>&lt;xsl:if test=&quot;$Asset/Record[1]/PARTITAIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Asset/Record[1]/PARTITAIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl: