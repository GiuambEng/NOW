hen>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTO&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONERICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/x