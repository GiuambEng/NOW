test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns10:value2>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns10:value2>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns10:ID_FILE>&#xa;            &lt;tns10:priority>&#xa;                &lt;xsl:value-of select=&quot;xsd:short($Priority)&quot;/>&#xa;            &lt;/tns10:priority>&#xa;            &lt;tns10:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$TransformXml&quot;/>&#xa;            &lt;/tns10:ContenutoXML>&#xa;            &lt;tns10:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&#xa;            &lt;/tns10:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Request/ambito&quot;>&#xa;                &lt;tns10:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Request/ambito&quot;/>&#xa;                &lt;/tns10:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Request/strutturaRichiesta&quot;/>&#xa;            &lt;/tns10:StrutturaRichiesta>&#xa;            &lt;tns10:Code_OLO>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:CodiceOrdineOLO&quot;/>&#xa;            &lt;/tns10:Code_OLO>&#xa;            &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns10:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
