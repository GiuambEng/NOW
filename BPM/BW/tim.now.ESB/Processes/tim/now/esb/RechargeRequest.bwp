            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Recovery/&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1785157871659&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Tracciato&quot;/>&lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&lt;xsl:param name=&quot;Recovery&quot;/>&lt;xsl:param name=&quot;DataFin&quot;/>&lt;xsl:param name=&quot;RecordAsset&quot;/>&lt;xsl:template name=&quot;Request-input&quot; match=&quot;/&quot;>&lt;tns7:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecordAsset/tns5:OFFERTA) = 0&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecordAsset/tns5:OFFERTA = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;RICARICA&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&lt;/IDRisorsa>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecordAsset/tns5:COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOloTarget&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOloTarget&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;xsl:i