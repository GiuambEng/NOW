                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;FaultRechargeRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RechargeRequest&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;B2BRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RichiestaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultRechargeRequest',$FaultDetails/ActivityName,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/Msg,$FaultDetails/MsgCode)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="FaultRechargeRequest-input"
                                name="FaultRechargeRequest"
                                tibex:xpdlId="c64e10ca-3d93-4797-aae0-db665b59ba42"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="FaultRechargeRequestToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;FaultRechargeRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.billingmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RechargeRequest&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;B2BRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RichiestaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('FaultRechargeRequest',$FaultDetails/ActivityName,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/Msg,$FaultDetails/MsgCode)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:reply name="Reply"
                            operation="RichiestaRicarica"
                            partnerLink="B2BRicarica"
                            portType="ns1:B2BRicarica"
                            tibex:xpdlId="7421a830-da00-4c02-9d2d-a03fd6d42c89" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://telecomitalia.it/NOW/B2BRicarica" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://telecomitalia.it/NOW/B2BNOWRicarica" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" version="2.0"&gt;
    &lt;xsl:param name="RichiestaRicaricaIn"/&gt;
    &lt;xsl:param name="Tracciato"/&gt;
    &lt;xsl:param name="MessageID"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns10:B2BEsitoRichiestaRicarica&gt;
            &lt;body&gt;
                &lt;tns3:Response&gt;
                    &lt;tns3:ACK&gt;
                        &lt;ns2:Data&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:Data&gt;
                        &lt;ns2:CausaleEsito&gt;
                            &lt;xsl:value-of select="&amp;quot;000&amp;quot;"/&gt;
                        &lt;/ns2:CausaleEsito&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Prolungamento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;PROLUNGAMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Spegnimento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;SPEGNIMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Accensione)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;ACCENSIONE&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Annullamento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;ANNULLAMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Schedulazione)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;SCHEDULAZIONE&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns3:ACK&gt;
                    &lt;tns3:Header&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem"&gt;
                            &lt;h:sourceSystem&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem"/&gt;
                            &lt;/h:sourceSystem&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID"&gt;
                            &lt;h:businessID&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID"/&gt;
                            &lt;/h:businessID&gt;
                        &lt;/xsl:if&gt;
                        &lt;h:messageID&gt;
                            &lt;xsl:value-of select="$MessageID"/&gt;
                        &lt;/h:messageID&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID"&gt;
                            &lt;h:transactionID&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID"/&gt;
                            &lt;/h:transactionID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns3:Header&gt;
                &lt;/tns3:Response&gt;
            &lt;/body&gt;
        &lt;/tns10:B2BEsitoRichiestaRicarica&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://telecomitalia.it/NOW/B2BRicarica&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://telecomitalia.it/NOW/B2BNOWRicarica&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;Tracciato&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:ACK>&#xa;                &lt;ns2:Data>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:Data>&#xa;                &lt;ns2:CausaleEsito>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                &lt;/ns2:CausaleEsito>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Spegnimento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns3:ACK>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="FaultRechargeRequestToReply"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ReplyToEmpty2"/>
                            </bpws:sources>
                        </bpws:reply>
                        <bpws:empty name="Stag" tibex:xpdlId="de132c94-520a-4eae-bc1d-a32f2c0db4d7">
                            <bpws:targets>
                                <bpws:target linkName="ReplyToEmpty2"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="StagToInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(string-length($CodProcso)>0 and string-length($IDEsec)>0) or (count($SelectStag/Record)>0 and count($CodProcsoNoFile/Record)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(string-length($CodProcso)>0 and string-length($IDEsec)>0) or (count($SelectStag/Record)>0 and count($CodProcsoNoFile/Record)>0)]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="StagToExit">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:exit name="Exit" tibex:xpdlId="967d33df-1e8b-4108-83aa-11c1ba9c419a">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToExit"/>
                                <bpws:target linkName="StagToExit"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:invoke inputVariable="UpdateKO-input"
                            name="UpdateKO"
                            operation="InsertUpdateStaging"
                            outputVariable="UpdateKO"
                            partnerLink="InsertUpdateStagingPortType"
                            portType="ns3:InsertUpdateStagingPortType" tibex:xpdlId="92275204-a1d7-40de-bed4-0cb509746fce">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns9="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" version="2.0"&gt;
    &lt;xsl:param name="RichiestaRicaricaIn"/&gt;
    &lt;xsl:param name="RichiestaRicarica"/&gt;
    &lt;xsl:param name="AnnullamentoRicarica"/&gt;
    &lt;xsl:param name="ListaRicarica"/&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="CodProcso"/&gt;
    &lt;xsl:param name="IDEsec"/&gt;
    &lt;xsl:param name="SelectStag"/&gt;
    &lt;xsl:param name="CodProcsoNoFile"/&gt;
    &lt;xsl:template name="UpdateKO-input" match="/"&gt;
        &lt;tns8:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns9:StagingRequest&gt;
                    &lt;tns9:StagingIn&gt;
                        &lt;tns9:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="'ESITO KO'"/&gt;
                        &lt;/tns9:CONTENUTO_RESPONSE&gt;
                        &lt;tns9:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="concat($FaultDetails/ActivityName, $FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/MsgCode,$FaultDetails/Msg)"/&gt;
                        &lt;/tns9:DESCR_ERRORE&gt;
                        &lt;tns9:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="12"/&gt;
                        &lt;/tns9:ID_STATO_ELAB_STAG&gt;
                        &lt;tns9:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns9:TIMSTP_RISPOSTA&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="count($SelectStag/Record)&gt;0 and count($CodProcsoNoFile/Record)&gt;0"&gt;
                                &lt;tns9:NUMERO_RETRY&gt;
                                    &lt;xsl:value-of select="xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)"/&gt;
                                &lt;/tns9:NUMERO_RETRY&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns9:NUMERO_RETRY&gt;
                                    &lt;xsl:value-of select="0"/&gt;
                                &lt;/tns9:NUMERO_RETRY&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns9:CODE_ACK_NACK&gt;
                            &lt;xsl:value-of select="&amp;quot;000&amp;quot;"/&gt;
                        &lt;/tns9:CODE_ACK_NACK&gt;
                    &lt;/tns9:StagingIn&gt;
                    &lt;tns9:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_ESB_INPUT_NO_FILE'"/&gt;
                    &lt;/tns9:StagingType&gt;
                    &lt;tns9:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="count($CodProcsoNoFile/Record)&gt;0"&gt;
                                    &lt;xsl:if test="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns1:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns1:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:COD_PROCSO_FILE&gt;
                                        &lt;xsl:value-of select="$CodProcso"/&gt;
                                    &lt;/ns1:COD_PROCSO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;
                                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)"/&gt;
                                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($IDEsec))"/&gt;
                                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$RichiestaRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$AnnullamentoRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$ListaRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'ERROR'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns9:LoggerIn&gt;
                &lt;/tns9:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns8:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;AnnullamentoRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProcso&quot;/>&#xa;    &lt;xsl:param name=&quot;IDEsec&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStag&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;'ESITO KO'&quot;/>&#xa;                &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                &lt;tns9:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/MsgCode,$FaultDetails/Msg)&quot;/>&#xa;                &lt;/tns9:DESCR_ERRORE>&#xa;                &lt;tns9:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                &lt;/tns9:ID_STATO_ELAB_STAG>&#xa;                &lt;tns9:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns9:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStag/Record)>0 and count($CodProcsoNoFile/Record)>0&quot;>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns9:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                &lt;/tns9:CODE_ACK_NACK>&#xa;            &lt;/tns9:StagingIn>&#xa;            &lt;tns9:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_ESB_INPUT_NO_FILE'&quot;/>&#xa;            &lt;/tns9:StagingType>&#xa;            &lt;tns9:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($CodProcsoNoFile/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns1:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns1:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:COD_PROCSO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$CodProcso&quot;/>&#xa;                            &lt;/ns1:COD_PROCSO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($IDEsec))&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$AnnullamentoRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ListaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns9:LoggerIn>&#xa;        &lt;/tns9:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
