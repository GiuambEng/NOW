                            expression="if (contains(xsd:string(current-dateTime()),'+')) then xsd:dateTime(substring-before(xsd:string(current-dateTime()),'+')) else  if  (contains(xsd:string(current-dateTime()),'Z'))  then xsd:dateTime(substring-before(xsd:string(current-dateTime()),'Z')) else current-dateTime()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
