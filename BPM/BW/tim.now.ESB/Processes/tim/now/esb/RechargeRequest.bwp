                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1785157871659&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDAsset_DIN&quot;/>&#xa;    &lt;xsl:param name=&quot;DataInizioRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;DataFin&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;Sysdate&quot;/>&#xa;    &lt;xsl:param name=&quot;RecordAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciato-input&quot; match=&quot;/&quot;>&#xa;        &lt;RichiestaOloRicarica>&#xa;            &lt;Richiesta>&#xa;                &lt;DatiRisorsa>&#xa;                    &lt;CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&#xa;                    &lt;/CodiceOloAgcom>&#xa;                    &lt;IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;                    &lt;/IdRisorsa>&#xa;                    &lt;IdAsset>&#xa;                        &lt;xsl:value-of select=&quot;$RecordAsset/tns5:IDASSET&quot;/>&#xa;                    &lt;/IdAsset>&#xa;                    &lt;xsl:if test=&quot;$RecordAsset/tns5:CODICEORDINEOLO&quot;>&#xa;                        &lt;CodiceOrdineOloTarget>&#xa;                            &lt;xsl:value-of select=&quot;$RecordAsset/tns5:CODICEORDINEOLO&quot;/>&#xa;                        &lt;/CodiceOrdineOloTarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RecordAsset/tns5:CODICEORDINETI&quot;>&#xa;                        &lt;CodiceOrdineTITarget>&#xa;                            &lt;xsl:value-of select=&quot;$RecordAsset/tns5:CODICEORDINETI&quot;/>&#xa;                        &lt;/CodiceOrdineTITarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RecordAsset/tns5:IDCONTRATTO)&quot;>&#xa;                            &lt;IdContratto>&#xa;                                &lt;xsl:value-of select=&quot;$RecordAsset/tns5:IDCONTRATTO&quot;/>&#xa;                            &lt;/IdContratto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;IdContratto>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/IdContratto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:CodiceOrdineOLO&quot;/>&#xa;                    &lt;/CodiceOrdineOLO>&#xa;                &lt;/DatiRisorsa>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)='NRT'&quot;>&#xa;                        &lt;TipoAzione>&#xa;                            &lt;Accensione>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($RecordAsset/tns5:OFFERTA) = 0&quot;>&#xa;                                        &lt;BitstreamGBEAsimmetricoFlat>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamGBEAsimmetricoFlat>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$RecordAsset/tns5:OFFERTA = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;>&#xa;                                        &lt;BitstreamGBEAsimmetricoFlat>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamGBEAsimmetricoFlat>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$RecordAsset/tns5:OFFERTA = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;>&#xa;                                        &lt;BitstreamNGAFTTCAB>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamNGAFTTCAB>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;VULAFTTCAB>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataInizioRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0)&quot;/>&#xa;                                                    &lt;/DataInizioRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;minutes-from-dateTime($Sysdate)>=00 and minutes-from-dateTime($Sysdate)&amp;lt;=30&quot;>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate),30,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;DataFineRicarica>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($Sysdate),month-from-dateTime($Sysdate),day-from-dateTime($Sysdate),hours-from-dateTime($Sysdate)+1,0,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                    &lt;/DataFineRicarica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/VULAFTTCAB>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/Accensione>&#xa;                        &lt;/TipoAzione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)&quot;>&#xa;                        &lt;TipoAzione>&#xa;                            &lt;Annullamento>&#xa;                                &lt;IdRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento/tns3:NumeroOrdineRichiesta&quot;/>&#xa;                                &lt;/IdRicarica>&#xa;                            &lt;/Annullamento>&#xa;                        &lt;/TipoAzione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)='PROLUNGATA'&quot;>&#xa;                        &lt;TipoAzione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:NumeroOrdineRichiesta)>0&quot;>&#xa;                                    &lt;Prolungamento>&#xa;                                        &lt;IdRicarica>&#xa;                                            &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:NumeroOrdineRichiesta&quot;/>&#xa;                                        &lt;/IdRicarica>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($DataFin/Record)=0&quot;>&#xa;                                                &lt;DataInizioRicarica>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),100,0,0,0,0,0)&quot;/>&#xa;                                                &lt;/DataInizioRicarica>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;minutes-from-dateTime($Data)>=00 and minutes-from-dateTime($Data)&amp;lt;=30 and seconds-from-dateTime($Data)>00&quot;>&#xa;                                                &lt;DataInizioRicarica>&#xa;                                                    &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Data),month-from-dateTime($Data),day-from-dateTime($Data),hours-from-dateTime($Data),30,0,0)&quot;/>&#xa;                                                &lt;/DataInizioRicarica>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;minutes-from-dateTime($Data)>=00 and minutes-from-dateTime($Data)&amp;lt;=30 and seconds-from-dateTime($Data)=00&quot;>&#xa;                                                        &lt;DataInizioRicarica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Data&quot;/>&#xa;                                                        &lt;/DataInizioRicarica>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;DataInizioRicarica>&#xa;                                                            &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-dateTime($Data),month-from-dateTime($Data),day-from-dateTime($Data),hours-from-dateTime($Data)+1,0,0,0)&quot;/>&#xa;                                                        &lt;/DataInizioRicarica>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                      