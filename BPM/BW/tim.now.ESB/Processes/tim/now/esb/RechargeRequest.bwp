      &lt;xsl:when test=&quot;minutes-from-dateTime($DataInizioRicarica)>=00 and minutes-from-dateTime($DataInizioRicarica)&amp;lt;=30 and seconds-from-dateTime($DataInizioRicarica)=00&quot;>&#xa;                                                            &lt;DataFineRicarica>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:add-to-dateTime($DataInizioRicarica,0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                            &lt;/DataFineRicarica>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;DataFineRicarica>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:add-to-dateTime(tib:create-dateTime(year-from-dateTime($DataInizioRicarica),month-from-dateTime($DataInizioRicarica),day-from-dateTime($DataInizioRicarica),hours-from-dateTime($DataInizioRicarica)+1,0,0,0),0,0,xsd:int($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica),0,0,0)&quot;/>&#xa;                                                            &lt;/DataFineRicarica>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULATA&amp;quot;&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/VULAFTTCAB>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/Schedulazione>&#xa;                        &lt;/TipoAzione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRicarica>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
