            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1785157871659&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&lt;xsl:param name=&quot;SelectIDAsset_DIN&quot;/>&lt;xsl:param name=&quot;DataInizioRicarica&quot;/>&lt;xsl:param name=&quot;DataFin&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;Sysdate&quot;/>&lt;xsl:param name=&quot;RecordAsset&quot;/>&lt;xsl:template name=&quot;Tracciato-input&quot; match=&quot;/&quot;>&lt;RichiestaOloRicarica>&lt;Richiesta>&lt;DatiRisorsa>&lt;CodiceOloAgcom>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&lt;/CodiceOloAgcom>&lt;IdRisorsa>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&lt;/IdRisorsa>&lt;IdAsset>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:IDASSET&quot;/>&lt;/IdAsset>&lt;xsl:if test=&quot;$RecordAsset/tns5:CODICEORDINEOLO&quot;>&lt;CodiceOrdineOloTarget>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:CODICEORDINEOLO&quot;/>&lt;/CodiceOrdineOloTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecordAsset/tns5:CODICEORDINETI&quot;>&lt;CodiceOrdineTITarget>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:CODICEORDINETI&quot;/>&lt;/CodiceOrdineTITarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;/>&lt;/Note>&l