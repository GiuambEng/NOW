                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns1="http://www.example.org/ServicesSecurityData" xmlns:ns="www.tim.now.HeaderConnection" xmlns:tns2="http://www.example.com/namespaces/tns/1564740682912" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:param name="GetLocalIP"/&gt;&lt;xsl:param name="LoggerName"/&gt;&lt;xsl:param name="LogLevel"/&gt;&lt;xsl:param name="RichiestaRicaricaIn"/&gt;&lt;xsl:param name="GetContext"/&gt;&lt;xsl:template name="LogAccessiUtenti-input" match="/"&gt;&lt;tns:NewOperationRequest&gt;&lt;parameters&gt;&lt;tns1:LoggerSecurityInput&gt;&lt;tns1:LogInfo&gt;&lt;tns1:LoggerName&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:LoggerName&gt;&lt;tns1:Application&gt;&lt;xsl:value-of select="&amp;quot;tim.now.ESB.application&amp;quot;"/&gt;&lt;/tns1:Application&gt;&lt;tns1:LogLevel&gt;&lt;xsl:value-of select="$LogLevel"/&gt;&lt;/tns1:LogLevel&gt;&lt;tns1:ServiceName&gt;&lt;xsl:value-of select="&amp;quot;B2BRicarica&amp;quot;"/&gt;&lt;/tns1:ServiceName&gt;&lt;tns1:Operation&gt;&lt;xsl:value-of select="&amp;quot;RichiestaRicarica&amp;quot;"/&gt;&lt;/tns1:Operation&gt;&lt;tns1:JMS&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:JMS&gt;&lt;/tns1:LogInfo&gt;&lt;tns1:InputDataUserLog&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value) &gt; 0"&gt;&lt;xsl:if test="$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value"&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="&amp;quot;ESB&amp;quot;"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:COD_FUNZIONE&gt;&lt;xsl:value-of select="&amp;quot;ESB Richiesta Ricarica&amp;quot;"/&gt;&lt;/tns1:COD_FUNZIONE&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="&amp;quot;M2M&amp;quot;"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:HOSTNAME_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP/tns2:IPAddress"&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP/tns2:IPAddress"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns1:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns1:OS_USER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)"&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="&amp;quot;ESB_ACCENSIONE_RICARICA&amp;quot;"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)"&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="&amp;quot;ESB_ANNULLAMENTO_RICARICA&amp;quot;"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="&amp;quot;ESB_LISTA_RICARICHE&amp;quot;"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="concat('RicaricaESB',$_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'M2M_SDR'"/&gt;&lt;/tns1:SISTEMA_CHIAMANTE&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:ns=&quot;www.tim.now.HeaderConnection&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccessiUtenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:LoggerSecurityInput>&#xa;            &lt;tns1:LogInfo>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;B2BRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns1:ServiceName>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RichiestaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value&quot;>&#xa;                            &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                                &lt;xsl:value-of select=&quot;$GetContext/ns:DinamicHeaders/ns:Headers[ns:Name = &amp;quot;SoapAction&amp;quot;]/ns:Value&quot;/>&#xa;                            &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ESB&amp;quot;&quot;/>&#xa;                        &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ESB Richiesta Ricarica&amp;quot;&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;tns1:COD_PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;M2M&amp;quot;&quot;/>&#xa;                &lt;/tns1:COD_PROFILO>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:HOSTNAME_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:HOSTNAME_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetContext/ns:remoteaddress&quot;>&#xa;                    &lt;tns1:IP_CLIENT>&#xa;                        &lt;xsl:value-of select=&quot;$GetContext/ns:remoteaddress&quot;/>&#xa;                    &lt;/tns1:IP_CLIENT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns1:IP_SERVER>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns1:IP_SERVER>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;bw:getSystemProperty(&amp;quot;os.name&amp;quot;)&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&#xa;                        &lt;tns1:COD_INTRFC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ESB_ACCENSIONE_RICARICA&amp;quot;&quot;/>&#xa;                        &lt;/tns1:COD_INTRFC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)&quot;>&#xa;                        &lt;tns1:COD_INTRFC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ESB_ANNULLAMENTO_RICARICA&amp;quot;&quot;/>&#xa;                        &lt;/tns1:COD_INTRFC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:COD_INTRFC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ESB_LISTA_RICARICHE&amp;quot;&quot;/>&#xa;                        &lt;/tns1:COD_INTRFC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('RicaricaESB',$_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'M2M_SDR'&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GetLocalIPToLogAccessiUtenti"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogAccessiUtentiToTransactionID"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (contains(xsd:string($RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'+')) then xsd:dateTime(substring-before(xsd:string($RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'+')) else  if  (contains(xsd:string($RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'Z'))  then xsd:dateTime(substring-before(xsd:string($RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'Z')) else $RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="DataInizioRicarica" name="Assign2"
                    outputVariable="DataInizioRicarica"
                    tibex:xpdlId="9865607e-5ec5-4d5d-b5be-807c10d879f5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToAssign2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign2ToAssign4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (contains(xsd:string($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'+')) then xsd:dateTime(substring-before(xsd:string($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'+')) else  if  (contains(xsd:string($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'Z'))  then xsd:dateTime(substring-before(xsd:string($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica),'Z')) else $RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DataInizioRicarica" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
