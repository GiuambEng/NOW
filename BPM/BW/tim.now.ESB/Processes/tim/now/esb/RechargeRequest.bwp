acciato/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Prolungamento/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/VULAFTTCAB/DataInizioRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&