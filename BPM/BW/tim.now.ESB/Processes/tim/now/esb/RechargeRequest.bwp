                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://telecomitalia.it/NOW/B2BRicarica" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://telecomitalia.it/NOW/B2BNOWRicarica" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" version="2.0"&gt;
    &lt;xsl:param name="RichiestaRicaricaIn"/&gt;
    &lt;xsl:param name="Tracciato"/&gt;
    &lt;xsl:param name="MessageID"/&gt;
    &lt;xsl:template name="RichiestaRicaricaOut-input" match="/"&gt;
        &lt;tns10:B2BEsitoRichiestaRicarica&gt;
            &lt;body&gt;
                &lt;tns3:Response&gt;
                    &lt;tns3:ACK&gt;
                        &lt;ns2:Data&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:Data&gt;
                        &lt;ns2:CausaleEsito&gt;
                            &lt;xsl:value-of select="&amp;quot;000&amp;quot;"/&gt;
                        &lt;/ns2:CausaleEsito&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Prolungamento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;PROLUNGAMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Spegnimento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;SPEGNIMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Accensione)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;ACCENSIONE&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Annullamento)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;ANNULLAMENTO&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Tracciato/Richiesta/TipoAzione/Schedulazione)"&gt;
                                &lt;ns2:TipoMessaggio&gt;
                                    &lt;xsl:value-of select="&amp;quot;SCHEDULAZIONE&amp;quot;"/&gt;
                                &lt;/ns2:TipoMessaggio&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/tns3:ACK&gt;
                    &lt;tns3:Header&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem"&gt;
                            &lt;h:sourceSystem&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem"/&gt;
                            &lt;/h:sourceSystem&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:interactionDate)"&gt;
                            &lt;xsl:copy-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:interactionDate"/&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID"&gt;
                            &lt;h:businessID&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID"/&gt;
                            &lt;/h:businessID&gt;
                        &lt;/xsl:if&gt;
                        &lt;h:messageID&gt;
                            &lt;xsl:value-of select="$MessageID"/&gt;
                        &lt;/h:messageID&gt;
                        &lt;xsl:if test="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID"&gt;
                            &lt;h:transactionID&gt;
                                &lt;xsl:value-of select="$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID"/&gt;
                            &lt;/h:transactionID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns3:Header&gt;
                &lt;/tns3:Response&gt;
            &lt;/body&gt;
        &lt;/tns10:B2BEsitoRichiestaRicarica&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://telecomitalia.it/NOW/B2BRicarica&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://telecomitalia.it/NOW/B2BNOWRicarica&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;Tracciato&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:template name=&quot;RichiestaRicaricaOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Response>&#xa;            &lt;tns3:ACK>&#xa;                &lt;ns2:Data>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:Data>&#xa;                &lt;ns2:CausaleEsito>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                &lt;/ns2:CausaleEsito>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Spegnimento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                        &lt;ns2:TipoMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/ns2:TipoMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns3:ACK>&#xa;            &lt;tns3:Header>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($RichiestaRicaricaIn.body/tns3:Header/h:interactionDate)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:interactionDate&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:Header>&#xa;        &lt;/tns3:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToRichiestaRicaricaOut"/>
                    <bpws:target linkName="UpadateStagToRichiestaRicaricaOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStartRechargeRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RechargeRequest&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;B2BRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RichiestaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Start RechargeRequest&amp;quot;, tib:render-xml($RichiestaRicaricaIn/body/tns3:Request,true(),true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
