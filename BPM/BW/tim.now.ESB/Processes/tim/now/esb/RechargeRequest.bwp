                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c756bd22-96b1-456a-a7ac-2ca1251f955d+input&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectIDAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;        &lt;/tns10:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT   ASS.IDASSET,ASS.OFFERTA ,ASS.IDOFFERTA,ASS.IDCONTRATTO,ASS.CODICEORDINETI,ASS.CODICEORDINEOLO,O.COD_OLO&#xd;&#xa;FROM  BDS_1_CASEDATA_ASSET ASS left join OLO O ON O.CODFC_OLO_AGCOM=ASS.CODIFICAOLOAGCOM&#xd;&#xa;WHERE  &#xd;&#xa;ASS.OPZIONEDINAMICA='Y' AND ASS.IDRISORSA=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="IDCONTRATTO"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&lt;xsl:param name=&quot;SelectIDAsset_DIN&quot;/>&lt;xsl:template name=&quot;LogSelectIDAsset_DIN-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.ESB.application&amp;quot;&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;&amp;quot;RechargeRequest&amp;quot;&quot;/>&lt;/tns4:Process>&lt;tns4:Service>&lt;xsl:value-of select=&quot;&amp;quot;B2BRicarica&amp;quot;&quot;/>&lt;/tns4:Service>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RichiestaRicarica&amp;quot;&quot;/>&lt;/tns4:Operation>&lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;/>&lt;/tns4:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectIDAsset_DIN/Record) > 0&quot;>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;SelectIDAsset_DIN&amp;quot;, tib:render-xml($SelectIDAsset_DIN, true(), true()))&quot;/>&lt;/tns4:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Message>&lt;xsl:value-of select=&quot;'SelectIDAsset : record non trovato con OPZIONEDINAMICA=Y'&quot;/>&lt;/tns4:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
