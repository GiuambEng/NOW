rName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
