omeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Prolungamento/DataFineRicarica&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/VULAFTTCAB/DataFineRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$DataFin/Record[1]/DATAFINE&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;1 > 0&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'IDENTIFICATIVOASSET'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string($RecordAsset/tns5:IDASSET), &amp;quot;.&amp;quot;)&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(xsd:string($RecordAsset/tns5:IDASSET), &amp;quot;.&amp;quot;)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$RecordAsset/tns5:IDASSET&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($RecordAsset/tns5:OFFERTA)&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'OFFERTA'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)>0 or (count($DataFin/Record)>0 and exists($DataFin/Record[1]/FAMIGLIAASSET))&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIAACCENSIONERICARICA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)>0&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$DataFin/Record[1]/FAMIGLIAASSET&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica)>0 or (exists($Tracciato/Richiesta/TipoAzione/Prolungamento)   and not($Tracciato/Richiesta/TipoAzione/Prolungamento/IdRicarica='NON PRESENTE'))&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSETRICARICA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica)>0&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Prolungamento/IdRicarica&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;!--L'attributo TIPOLOGIARICARICA non esiste come enumeration del casedata sul nomeAttributo-->&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                    &lt;azione>&#xa;                        &lt;xsl:value-of select=&quot;'A'&quot;/>&#xa;                    &lt;/azione>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RecordAsset/tns5:OFFERTA) > 0&quot;>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&#xa;                        &lt;/offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&#xa;                        &lt;/offerta>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;IDRisorsaNOW>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;                &lt;/IDRisorsaNOW>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RecordAsset/tns5:IDCONTRATTO)&quot;>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecordAsset/tns5:IDCONTRATTO)&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($RecordAsset/tns5:OFFERTA) > 0&quot;>&#xa;                &lt;xsl:if test=&quot;$RecordAsset/tns5:OFFERTA&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RecordAsset/tns5:IDOFFERTA)&quot;>&#xa;                    &lt;IDOfferta>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecordAsset/tns5:IDOFFERTA)&quot;/>&#xa;                    &lt;/IDOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento) or exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($DataFin/Record[1]/CREATED)&quot;>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($DataFin/Record[1]/CREATED), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;'ACCSCHEDUL'&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;'ACCPROL'&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONERICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTORICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns7:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
