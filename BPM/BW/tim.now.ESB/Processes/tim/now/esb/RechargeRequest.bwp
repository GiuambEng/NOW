                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectIDAsset_DIN-input"
                    name="SelectIDAsset_DIN"
                    outputVariable="SelectIDAsset_DIN"
