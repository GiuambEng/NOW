        &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/DataInizioRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/DataInizioRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/DataInizioRicarica&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                                    &lt;va