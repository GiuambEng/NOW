                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:Ricarica/tns:DataInizioRicarica)]]></bpws:transitionCondition>
                    </bpws:source>
