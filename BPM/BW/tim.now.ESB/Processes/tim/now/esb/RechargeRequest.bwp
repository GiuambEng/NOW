l:if>&#xa;            &lt;xsl:if test=&quot;$Request/codificaOLOAGCOMRic&quot;>&#xa;                &lt;codificaOLOAGCOMRic>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codificaOLOAGCOMRic&quot;/>&#xa;                &lt;/codificaOLOAGCOMRic>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDNotificaDonor&quot;>&#xa;                &lt;IDNotificaDonor>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDNotificaDonor&quot;/>&#xa;                &lt;/IDNotificaDonor>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDNotificaDonating&quot;>&#xa;                &lt;IDNotificaDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDNotificaDonating&quot;/>&#xa;                &lt;/IDNotificaDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/esito&quot;>&#xa;                &lt;esito>&#xa;                    &lt;xsl:value-of select=&quot;$Request/esito&quot;/>&#xa;                &lt;/esito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceCausaleInterno&quot;>&#xa;                &lt;codiceCausaleInterno>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceCausaleInterno&quot;/>&#xa;                &lt;/codiceCausaleInterno>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/dataEspletamentoDONOR&quot;>&#xa;                &lt;dataEspletamentoDONOR>&#xa;                    &lt;xsl:value-of select=&quot;$Request/dataEspletamentoDONOR&quot;/>&#xa;                &lt;/dataEspletamentoDONOR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceTrasformazione&quot;>&#xa;                &lt;codiceTrasformazione>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceTrasformazione&quot;/>&#xa;                &lt;/codiceTrasformazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/flagOpereSpeciali&quot;>&#xa;                &lt;flagOpereSpeciali>&#xa;                    &lt;xsl:value-of select=&quot;$Request/flagOpereSpeciali&quot;/>&#xa;                &lt;/flagOpereSpeciali>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDRisorsaCorrelato&quot;>&#xa;                &lt;IDRisorsaCorrelato>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDRisorsaCorrelato&quot;/>&#xa;                &lt;/IDRisorsaCorrelato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDRichiestaOLOGenerante&quot;>&#xa;                &lt;IDRichiestaOLOGenerante>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDRichiestaOLOGenerante&quot;/>&#xa;                &lt;/IDRichiestaOLOGenerante>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/tipoComunicazioneNP&quot;>&#xa;                &lt;tipoComunicazioneNP>&#xa;                    &lt;xsl:value-of select=&quot;$Request/tipoComunicazioneNP&quot;/>&#xa;                &lt;/tipoComunicazioneNP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/servizioOrigine&quot;>&#xa;                &lt;servizioOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$Request/servizioOrigine&quot;/>&#xa;                &lt;/servizioOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceSTS&quot;>&#xa;                &lt;codiceSTS>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceSTS&quot;/>&#xa;                &lt;/codiceSTS>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/caratteristica&quot;>&#xa;                &lt;caratteristica>&#xa;                    &lt;xsl:value-of select=&quot;$Request/caratteristica&quot;/>&#xa;                &lt;/caratteristica>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceRisorsaDonating&quot;>&#xa;                &lt;codiceRisorsaDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceRisorsaDonating&quot;/>&#xa;                &lt;/codiceRisorsaDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceRisorsaDonating2&quot;>&#xa;                &lt;codiceRisorsaDonating2>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceRisorsaDonating2&quot;/>&#xa;                &lt;/codiceRisorsaDonating2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/cowCodeOLO&quot;>&#xa;                &lt;cowCodeOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Request/cowCodeOLO&quot;/>&#xa;                &lt;/cowCodeOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/cowCodeOLO2&quot;>&#xa;                &lt;cowCodeOLO2>&#xa;                    &lt;xsl:value-of select=&quot;$Request/cowCodeOLO2&quot;/>&#xa;                &lt;/cowCodeOLO2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceSessione&quot;>&#xa;                &lt;codiceSessione>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceSessione&quot;/>&#xa;                &lt;/codiceSessione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceSessione2&quot;>&#xa;                &lt;codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceSessione2&quot;/>&#xa;                &lt;/codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$Request/DNAggiuntivo&quot;>&#xa;                &lt;DNAggiuntivo>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/DNAggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Request/IDPreventivo&quot;>&#xa;                &lt;IDPreventivo>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDPreventivo&quot;/>&#xa;                &lt;/IDPreventivo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDConsuntivo&quot;>&#xa;                &lt;IDConsuntivo>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDConsuntivo&quot;/>&#xa;                &lt;/IDConsuntivo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/noteAltreLavorazioni&quot;>&#xa;                &lt;noteAltreLavorazioni>&#xa;                    &lt;xsl:value-of select=&quot;$Request/noteAltreLavorazioni&quot;/>&#xa;                &lt;/noteAltreLavorazioni>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codicePacchettoNOW&quot;>&#xa;                &lt;codicePacchettoNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codicePacchettoNOW&quot;/>&#xa;                &lt;/codicePacchettoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$Request/assetTarget&quot;>&#xa;                &lt;assetTarget>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                    &lt;flagInLavorazione>&#xa;                        &lt;xsl:value-of select=&quot;flagInLavorazione&quot;/>&#xa;                    &lt;/flagInLavorazione>&#xa;                &lt;/assetTarget>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Request/operatoreRete&quot;>&#xa;                &lt;operatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;$Request/operatoreRete&quot;/>&#xa;                &lt;/operatoreRete>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/transactionIDLocator&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;$Request/transactionIDLocator&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/flagNumAggiuntive&quot;>&#xa;                &lt;flagNumAggiuntive>&#xa;                    &lt;xsl:value-of select=&quot;$Request/flagNumAggiuntive&quot;/>&#xa;                &lt;/flagNumAggiuntive>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/IDAnagraficaCausaleGUI&quot;>&#xa;                &lt;IDAnagraficaCausaleGUI>&#xa;                    &lt;xsl:value-of select=&quot;$Request/IDAnagraficaCausaleGUI&quot;/>&#xa;                &lt;/IDAnagraficaCausaleGUI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceRifiutoDonating&quot;>&#xa;                &lt;codiceRifiutoDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceRifiutoDonating&quot;/>&#xa;                &lt;/codiceRifiutoDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/DACFile&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;$Request/DACFile&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/tipologiaSottolav&quot;>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;$Request/tipologiaSottolav&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/codiceRifiuto&quot;>&#xa;                &lt;codiceRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$Request/codiceRifiuto&quot;/>&#xa;                &lt;/codiceRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/routingNumber&quot;>&#xa;                &lt;routingNumber>&#xa;                    &lt;xsl:value-of select=&quot;$Request/routingNumber&quot;/>&#xa;                &lt;/routingNumber>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/progressivoEmissioneDTU&quot;>&#xa;                &lt;progressivoEmissioneDTU>&#xa;                    &lt;xsl:value-of select=&quot;$Request/progressivoEmissioneDTU&quot;/>&#xa;                &lt;/progressivoEmissioneDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/flagAttesaDesospOLO&quot;>&#xa;                &lt;flagAttesaDesospOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Request/flagAttesaDesospOLO&quot;/>&#xa;                &lt;/flagAttesaDesospOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/flagDeliveryExposed&quot;>&#xa;                &lt;flagDeliveryExposed>&#xa;                    &lt;xsl:value-of select=&quot;$Request/flagDeliveryExposed&quot;/>&#xa;                &lt;/flagDeliveryExposed>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/disaggregato&quot;>&#xa;                &lt;disaggregato>&#xa;                    &lt;xsl:value-of select=&quot;$Request/disaggregato&quot;/>&#xa;                &lt;/disaggregato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/exDisaggregato&quot;>&#xa;                &lt;exDisaggregato>&#xa;                    &lt;xsl:value-of select=&quot;$Request/exDisaggregato&quot;/>&#xa;                &lt;/exDisaggregato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/FFACQKO&quot;>&#xa;                &lt;FFACQKO>&#xa;                    &lt;xsl:value-of select=&quot;$Request/FFACQKO&quot;/>&#xa;                &lt;/FFACQKO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/idProgressivoNotificheFF&quot;>&#xa;                &lt;idProgressivoNotificheFF>&#xa;                    &lt;xsl:value-of select=&quot;$Request/idProgressivoNotificheFF&quot;/>&#xa;                &lt;/idProgressivoNotificheFF>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/idTplgCautelare&quot;>&#xa;                &lt;idTplgCautelare>&#xa;                    &lt;xsl:value-of select=&quot;$Request/idTplgCautelare&quot;/>&#xa;                &lt;/idTplgCautelare>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Request/rendezVous&quot;>&#xa;                &lt;rendezVous>&#xa;                    &lt;xsl:value-of select=&quot;$Request/rendezVous&quot;/>&#xa;                &lt;/rendezVous>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns7:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpadateStag-input"
                name="UpadateStag" operation="InsertUpdateStaging"
                outputVariable="UpadateStag"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns3:InsertUpdateStagingPortType" tibex:xpdlId="172186b0-b870-435d-8520-b4cf76c6bb67">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns9="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" version="2.0"&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="RichiestaRicaricaIn"/&gt;
    &lt;xsl:param name="RichiestaRicarica"/&gt;
    &lt;xsl:param name="AnnullamentoRicarica"/&gt;
    &lt;xsl:param name="ListaRicarica"/&gt;
    &lt;xsl:param name="CodProcsoNoFile"/&gt;
    &lt;xsl:param name="SelectStag"/&gt;
    &lt;xsl:template name="UpadateStag-input" match="/"&gt;
        &lt;tns8:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns9:StagingRequest&gt;
                    &lt;tns9:StagingIn&gt;
                        &lt;tns9:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="'ESITO OK'"/&gt;
                        &lt;/tns9:CONTENUTO_RESPONSE&gt;
                        &lt;tns9:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns9:ID_STATO_ELAB_STAG&gt;
                        &lt;tns9:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns9:TIMSTP_RISPOSTA&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;
                                &lt;xsl:if test="$SelectStag/Record[1]/DESCR_ERRORE"&gt;
                                    &lt;tns9:DESCR&gt;
                                        &lt;xsl:value-of select="$SelectStag/Record[1]/DESCR_ERRORE"/&gt;
                                    &lt;/tns9:DESCR&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;
                                &lt;tns9:NUMERO_RETRY&gt;
                                    &lt;xsl:value-of select="xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)"/&gt;
                                &lt;/tns9:NUMERO_RETRY&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns9:NUMERO_RETRY&gt;
                                    &lt;xsl:value-of select="0"/&gt;
                                &lt;/tns9:NUMERO_RETRY&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns9:CODE_ACK_NACK&gt;
                            &lt;xsl:value-of select="&amp;quot;000&amp;quot;"/&gt;
                        &lt;/tns9:CODE_ACK_NACK&gt;
                    &lt;/tns9:StagingIn&gt;
                    &lt;tns9:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_ESB_INPUT_NO_FILE'"/&gt;
                    &lt;/tns9:StagingType&gt;
                    &lt;tns9:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="count($CodProcsoNoFile/Record)&gt;0"&gt;
                                    &lt;xsl:if test="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns1:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns1:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                        &lt;ns1:COD_PROCSO_FILE&gt;
                                            &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                        &lt;/ns1:COD_PROCSO_FILE&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;
                                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)"/&gt;
                                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$RichiestaRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)"&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$AnnullamentoRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                        &lt;xsl:value-of select="$ListaRicarica"/&gt;
                                    &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns9:LoggerIn&gt;
                &lt;/tns9:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns8:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;AnnullamentoRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStag&quot;/>&#xa;    &lt;xsl:template name=&quot;UpadateStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;'ESITO OK'&quot;/>&#xa;                &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                &lt;tns9:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns9:ID_STATO_ELAB_STAG>&#xa;                &lt;tns9:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns9:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectStag/Record[1]/DESCR_ERRORE&quot;>&#xa;                            &lt;tns9:DESCR>&#xa;                                &lt;xsl:value-of select=&quot;$SelectStag/Record[1]/DESCR_ERRORE&quot;/>&#xa;                            &lt;/tns9:DESCR>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns9:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                &lt;/tns9:CODE_ACK_NACK>&#xa;            &lt;/tns9:StagingIn>&#xa;            &lt;tns9:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_ESB_INPUT_NO_FILE'&quot;/>&#xa;            &lt;/tns9:StagingType>&#xa;            &lt;tns9:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($CodProcsoNoFile/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns1:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns1:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns1:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns1:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$AnnullamentoRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ListaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW SINC: RISPOSTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns9:LoggerIn>&#xa;        &lt;/tns9:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AcquisitionToInvoke"/>
                    <bpws:target linkName="ListToUpadateStag"/>
                    <bpws:target linkName="CallProcessToUpadateStag"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToLogEndRechargeRequest"/>
                    <bpws:source
                        linkName="UpadateStagToRichiestaRicaricaOut"
                        tibex:faultDetailsVar="UpadateStag" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/List/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn&quot;/>&#xa;    &lt;xsl:template name=&quot;List-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Request>&#xa;            &lt;ns2:Richiesta>&#xa;                &lt;ns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:CodiceOrdineOLO&quot;/>&#xa;                &lt;/ns2:CodiceOrdineOLO>&#xa;                &lt;ns2:DatiRisorsa>&#xa;                    &lt;ns2:CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&#xa;                    &lt;/ns2:CodiceOloAgcom>&#xa;                    &lt;ns2:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;                    &lt;/ns2:IdRisorsa>&#xa;                    &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;>&#xa;                        &lt;ns2:Note>&#xa;                            &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;/>&#xa;                        &lt;/ns2:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns2:DatiRisorsa>&#xa;                &lt;ns2:TipoAzione>&#xa;                    &lt;ns2:ListaRicariche>&#xa;                        &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataInizioEstrazione&quot;>&#xa;                            &lt;ns2:DataInizioEstrazione>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataInizioEstrazione&quot;/>&#xa;                            &lt;/ns2:DataInizioEstrazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataFineEstrazione&quot;>&#xa;                            &lt;ns2:DataFineEstrazione>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataFineEstrazione&quot;/>&#xa;                            &lt;/ns2:DataFineEstrazione>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns2:ListaRicariche>&#xa;                &lt;/ns2:TipoAzione>&#xa;            &lt;/ns2:Richiesta>&#xa;            &lt;ns2:Header>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:interactionDate)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:interactionDate&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:messageID&quot;>&#xa;                    &lt;h:messageID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:messageID&quot;/>&#xa;                    &lt;/h:messageID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns2:Header>&#xa;        &lt;/ns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="List-input" name="List"
                    tibex:xpdlId="9f483f36-9bea-455d-a0c5-c6a698c451d1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToList"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListToUpadateStag"/>
                        <bpws:source linkName="ListToCallProcess"
                            tibex:faultDetailsVar="List" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/List/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:template name=&quot;List-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Request>&#xa;            &lt;ns2:Richiesta>&#xa;                &lt;ns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:CodiceOrdineOLO&quot;/>&#xa;                &lt;/ns2:CodiceOrdineOLO>&#xa;                &lt;ns2:DatiRisorsa>&#xa;                    &lt;ns2:CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&#xa;                    &lt;/ns2:CodiceOloAgcom>&#xa;                    &lt;ns2:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;                    &lt;/ns2:IdRisorsa>&#xa;                    &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;>&#xa;                        &lt;ns2:Note>&#xa;                            &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:Note&quot;/>&#xa;                        &lt;/ns2:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns2:DatiRisorsa>&#xa;                &lt;ns2:TipoAzione>&#xa;                    &lt;ns2:ListaRicariche>&#xa;                        &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataInizioEstrazione&quot;>&#xa;                            &lt;ns2:DataInizioEstrazione>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataInizioEstrazione&quot;/>&#xa;                            &lt;/ns2:DataInizioEstrazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataFineEstrazione&quot;>&#xa;                            &lt;ns2:DataFineEstrazione>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:ListaRicariche/tns3:DataFineEstrazione&quot;/>&#xa;                            &lt;/ns2:DataFineEstrazione>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns2:ListaRicariche>&#xa;                &lt;/ns2:TipoAzione>&#xa;            &lt;/ns2:Richiesta>&#xa;            &lt;ns2:Header>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($RichiestaRicaricaIn.body/tns3:Header/h:interactionDate)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:interactionDate&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:messageID&quot;>&#xa;                    &lt;h:messageID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:messageID&quot;/>&#xa;                    &lt;/h:messageID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:Header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns2:Header>&#xa;        &lt;/ns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="tim.now.esb.ListResult" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="06a71723-3f21-4c7e-a2c7-7b5895144fbf">
                <bpws:targets>
                    <bpws:target linkName="Assign1ToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToSelectIDAsset">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToList">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($RichiestaRicaricaIn/body/tns:Request/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:ListaRicariche)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($RichiestaRicaricaIn.body/tns:RichiestaRicarica_Type/tns:TipoAzione/tns:ListaRicariche)]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TransactionID"
                    name="TransactionID" outputVariable="TransactionID"
                    tibex:xpdlId="62ec8d58-bda1-4b34-a46e-ba005c263ac0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAccessiUtentiToTransactionID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToAssign1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="string(tib:timestamp())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
