                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;AnnullamentoRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaRicarica&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStag&quot;/>&#xa;    &lt;xsl:template name=&quot;NotFoundUpadateStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:StagingRequest>&#xa;            &lt;tns9:StagingIn>&#xa;                &lt;tns9:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;'ESITO KO'&quot;/>&#xa;                &lt;/tns9:CONTENUTO_RESPONSE>&#xa;                &lt;tns9:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns9:ID_STATO_ELAB_STAG>&#xa;                &lt;tns9:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns9:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectStag/Record[1]/DESCR_ERRORE&quot;>&#xa;                            &lt;tns9:DESCR>&#xa;                                &lt;xsl:value-of select=&quot;$SelectStag/Record[1]/DESCR_ERRORE&quot;/>&#xa;                            &lt;/tns9:DESCR>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns9:NUMERO_RETRY>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns9:NUMERO_RETRY>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns9:CODE_ACK_NACK>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                &lt;/tns9:CODE_ACK_NACK>&#xa;            &lt;/tns9:StagingIn>&#xa;            &lt;tns9:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_ESB_INPUT_NO_FILE'&quot;/>&#xa;            &lt;/tns9:StagingType>&#xa;            &lt;tns9:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($CodProcsoNoFile/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns1:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns1:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                                &lt;ns1:COD_PROCSO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                                &lt;/ns1:COD_PROCSO_FILE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($SelectStag/Record)>0&quot;>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$RichiestaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)&quot;>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$AnnullamentoRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ListaRicarica&quot;/>&#xa;                            &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;'DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA'&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns9:LoggerIn>&#xa;        &lt;/tns9:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns9="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://telecomitalia.it/NOW/B2B_Ricarica" version="2.0"&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="RichiestaRicaricaIn"/&gt;&lt;xsl:param name="RichiestaRicarica"/&gt;&lt;xsl:param name="AnnullamentoRicarica"/&gt;&lt;xsl:param name="ListaRicarica"/&gt;&lt;xsl:param name="CodProcsoNoFile"/&gt;&lt;xsl:param name="SelectStag"/&gt;&lt;xsl:template name="NotFoundUpadateStag-input" match="/"&gt;&lt;tns8:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns9:StagingRequest&gt;&lt;tns9:StagingIn&gt;&lt;tns9:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="'ESITO KO'"/&gt;&lt;/tns9:CONTENUTO_RESPONSE&gt;&lt;tns9:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns9:ID_STATO_ELAB_STAG&gt;&lt;tns9:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns9:TIMSTP_RISPOSTA&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;&lt;xsl:if test="$SelectStag/Record[1]/DESCR_ERRORE"&gt;&lt;tns9:DESCR&gt;&lt;xsl:value-of select="$SelectStag/Record[1]/DESCR_ERRORE"/&gt;&lt;/tns9:DESCR&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;&lt;tns9:NUMERO_RETRY&gt;&lt;xsl:value-of select="xsd:int($SelectStag/Record[1]/NUMERO_RETRY+1)"/&gt;&lt;/tns9:NUMERO_RETRY&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns9:NUMERO_RETRY&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns9:NUMERO_RETRY&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns9:CODE_ACK_NACK&gt;&lt;xsl:value-of select="&amp;quot;000&amp;quot;"/&gt;&lt;/tns9:CODE_ACK_NACK&gt;&lt;/tns9:StagingIn&gt;&lt;tns9:StagingType&gt;&lt;xsl:value-of select="'STAG_ESB_INPUT_NO_FILE'"/&gt;&lt;/tns9:StagingType&gt;&lt;tns9:LoggerIn&gt;&lt;ns1:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns1:TipologiaProcesso&gt;&lt;ns1:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns1:TipologiaOperazione&gt;&lt;ns1:EsecuzioneNOFileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($CodProcsoNoFile/Record)&gt;0"&gt;&lt;xsl:if test="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$CodProcsoNoFile/Record[1]/COD_PROCSO_NO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($SelectStag/Record)&gt;0"&gt;&lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer($SelectStag/Record[1]/ID_ESEC_PROCSO_NO_FILE)"/&gt;&lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns9:StagingResponse/tns9:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)"&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$RichiestaRicarica"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Annullamento)"&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$AnnullamentoRicarica"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$ListaRicarica"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns1:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns1:STATO_ESEC&gt;&lt;ns1:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TMSP_FINE_ELAB&gt;&lt;/ns1:EsecuzioneNOFileProcessato&gt;&lt;ns1:LogFileProcessato&gt;&lt;ns1:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns1:LOG_LEVEL&gt;&lt;ns1:LOG_MESSAGE&gt;&lt;xsl:value-of select="'DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA'"/&gt;&lt;/ns1:LOG_MESSAGE&gt;&lt;ns1:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TIMSTP_INSMTO&gt;&lt;/ns1:LogFileProcessato&gt;&lt;/tns9:LoggerIn&gt;&lt;/tns9:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns8:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
