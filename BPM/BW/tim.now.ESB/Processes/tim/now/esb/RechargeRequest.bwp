t;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamGBEAsimmetricoFlat/DataFineRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/BitstreamNGAFTTCAB/DataFineRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Schedulazione/VULAFTTCAB/DataFineRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DataFin/Record[1]/DATAFINE&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;1 > 0&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'IDENTIFICATIVOASSET'&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($RecordAsset/tns5:IDASSET), &amp;quot;.&amp;quot;)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;substring-before(xsd:string($RecordAsset/tns5:IDASSET), &amp;quot;.&amp;quot;)&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:IDASSET&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($RecordAsset/tns5:OFFERTA)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'OFFERTA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)>0 or (count($DataFin/Record)>0 and exists($DataFin/Record[1]/FAMIGLIAASSET))&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIAACCENSIONERICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica)>0&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TipologiaAccensioneRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DataFin/Record[1]/FAMIGLIAASSET&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica)>0 or (exists($Tracciato/Richiesta/TipoAzione/Prolungamento)   and not($Tracciato/Richiesta/TipoAzione/Prolungamento/IdRicarica='NON PRESENTE'))&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSETRICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica)>0&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Annullamento/IdRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/TipoAzione/Prolungamento/IdRicarica&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:TipoAzione/tns3:Ricarica/tns3:TaglioRicarica&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--L'attributo TIPOLOGIARICARICA non esiste come enumeration del casedata sul nomeAttributo-->&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&lt;/IDRisorsaNOW>&lt;azione>&lt;xsl:value-of select=&quot;'A'&quot;/>&lt;/azione>&lt;/dettaglioordine>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecordAsset/tns5:OFFERTA) > 0&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$RichiestaRicaricaIn/body/tns3:Request/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&lt;/IDRisorsaNOW>&lt;/ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecordAsset/tns5:IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($RecordAsset/tns5:IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($RecordAsset/tns5:OFFERTA) > 0&quot;>&lt;xsl:if test=&quot;$RecordAsset/tns5:OFFERTA&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecordAsset/tns5:IDOFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($RecordAsset/tns5:IDOFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento) or exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DataFin/Record[1]/CREATED)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($DataFin/Record[1]/CREATED), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&lt;/codificaOLOAGCOMRic>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCSCHEDUL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCPROL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONERICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $Tracciato/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns7:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Request-input" name="Request"
                    outputVariable="Request"
                    tibex:xpdlId="bd1942e5-d6a8-4938-b647-5e4d9e9a53d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecoveryToMapper1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToLogRequest"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Recovery/&quot; xmlns:tns3=&quot;http://telecomitalia.it/NOW/B2B_Ricarica&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1785157871659&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiestaRicaricaIn.body&quot;/>&#xa;    &lt;xsl:param name=&quot;Tracciato&quot;/>&#xa;    &lt;xsl:param name=&quot;Recovery&quot;/>&#xa;    &lt;xsl:param name=&quot;DataFin&quot;/>&#xa;    &lt;xsl:param name=&quot;RecordAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;Request-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Schedulazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Prolungamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Tracciato/Richiesta/TipoAzione/Annullamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecordAsset/tns5:OFFERTA) = 0&quot;>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecordAsset/tns5:OFFERTA = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;RICARICA&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;IDRisorsa>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:IdRisorsa&quot;/>&#xa;            &lt;/IDRisorsa>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaRicaricaIn.body/tns3:RichiestaRicarica_Type/tns3:DatiRisorsa/tns3:CodiceOloAgcom&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecordAsset/tns5:COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecordAsset/tns5:COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;codiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOLO&quot;/>&#xa;            &lt;/codiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOloTarget&quot;>&#xa;                &lt;codiceOrdineOLOTarget>&#xa;                    &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineOloTarget&quot;/>&#xa;                &lt;/codiceOrdineOLOTarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineTITarget&quot;>&#xa;                &lt;codiceOrdineTITarget>&#xa;                    &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/CodiceOrdineTITarget&quot;/>&#xa;                &lt;/codiceOrdineTITarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;string-length($Tracciato/Richiesta/DatiRisorsa/Note)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Tracciato/Richiesta/DatiRisorsa/Note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;$Tracciato/Richiesta/DatiRisorsa/Note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;xsl:if test=&quot;string-length($RecordAsset/tns5:OFFERTA) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecordAsset/tns5:OFFERTA&quot;>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;$RecordAsset/tns5:OFFERTA&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RecordAsset/tns5:COD_OLO) > 0&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecordAsset/tns5:COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;