                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns2=&quot;http://telecomitalia.it/NPNotification/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPNotificationIn.Request&quot;/>&#xa;    &lt;xsl:param name=&quot;MessageID&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStagIN&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns2:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns1:COD_OLO>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Request,true(), true())&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;42&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;                &lt;/tns1:TRANSACTION_ID>&#xa;                &lt;tns1:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO&quot;>&#xa;                    &lt;tns1:COD_TOPON>&#xa;                        &lt;xsl:value-of select=&quot;$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO&quot;/>&#xa;                    &lt;/tns1:COD_TOPON>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_TIPOLOGIA_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SelectStagIN/Record[1]/ID_TPLG_EVNT_FASTDATA)&quot;/>&#xa;                &lt;/tns1:ID_TIPOLOGIA_EVENTO>&#xa;                &lt;tns1:IDDETTAGLIOORDINE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($NPNotificationIn.Request/tns2:IDEsecProcsoNoFile)&quot;/>&#xa;                &lt;/tns1:IDDETTAGLIOORDINE>&#xa;                &lt;xsl:if test=&quot;$SelectStagIN/Record[1]/ID_NOTF_FASTDATA&quot;>&#xa;                    &lt;tns1:ID_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;$SelectStagIN/Record[1]/ID_NOTF_FASTDATA&quot;/>&#xa;                    &lt;/tns1:ID_LINEA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NPNotificationIn.Request/tns2:Richiesta/codiceOrdineOLO&quot;>&#xa;                    &lt;tns1:RC>&#xa;                        &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns1:RC>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:BU_ID>&#xa;                    &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns2:BusinessID&quot;/>&#xa;                &lt;/tns1:BU_ID>&#xa;                &lt;tns1:MESSAGE_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/tns1:MESSAGE_ID>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_FASTDATA_OUT_NO_FILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;126&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'Info'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
