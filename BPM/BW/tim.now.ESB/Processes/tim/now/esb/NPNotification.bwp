                 &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$NPNotificationIn.Request/tns1:BusinessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$MessageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/tns:Header>&#xa;        &lt;/tns:NPNotification>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
