            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tns1=&quot;http://telecomitalia.it/NPNotification/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NPNotificationIn&quot;/>&lt;xsl:param name=&quot;MessageID&quot;/>&lt;xsl:param name=&quot;TransactionID&quot;/>&lt;xsl:param name=&quot;SelectStagIN&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;Request-input&quot; match=&quot;/&quot;>&lt;tns:NPNotification>&lt;tns:OLO_NPNotification>&lt;tns:codiceOperatoreDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns:codiceOperatoreDonor>&lt;tns:codiceOrdineWHS>&lt;xsl:value-of select=&quot;$NPNotificationIn/Request/tns1:Request/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/tns:codiceOrdineWHS>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;$SelectStagIN/Record[1]/ID_NOTF_FASTDATA&quot;/>&lt;/tns:idNotifica>&lt;tns:dataNotifica>&lt;xsl:value-of select=&quot;$ParseXml/tns:OLO_NPRequest/tns:dataNotifica&quot;/>&lt;/tns:dataNotifica>&lt;tns:tipoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:tipoNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NPNotificationIn/Request/tns1:Request/tns1:DNScartati)&quot;>&lt;tns:numerazioniScartate>&lt;xsl:for-each select=&quot;$NPNotificationIn/Request/tns1:Request/tns1:DNScartati/tns1:DN&quot;>&lt;tns:dn>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:dn>&lt;/xsl:for-each>&lt;/tns:numerazioniScartate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:numerazioniScartate>&lt;xsl:for-each select=&quot;$NPNotificationIn/Request/tns1:Request/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY']&quot;>&lt;tns:dn>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns:dn>&lt;/xsl:for-each>&lt;/tns:numerazioniScartate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:codiceMotivazione>&lt;xsl:value-of select=&quot;'N08'&quot;/>&lt;/tns:codiceMotivazione>&lt;tns:motivazione>&lt;xsl:value-of select=&quot;'Numerazione non associata al Donor'&quot;/>&lt;/tns:motivazione>&lt;xsl:if test=&quot;$NPNotificationIn/Request/tns1:Request/tns1:Richiesta/note&quot;>&lt;tns:note>&lt;xsl:value-of select=&quot;$NPNotificationIn/Request/tns1:Request/tns1:Richiesta/note&quot;/>&lt;/tns:note>&lt;/xsl:if>&lt;/tns:OLO_NPNotification>&lt;tns:Header>&lt;xsl:if test=&quot;$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO&quot;>&lt;h:sourceSystem>&lt;xsl:value-of select=&quot;$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO&quot;/>&lt;/h:sourceSystem>&lt;/xsl:if>&lt;h:interactionDate>&lt;h:Date>&lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&lt;/h:Date>&lt;h:Time>&lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&lt;/h:Time>&lt;/h:interactionDate>&lt;h:businessID>&lt;xsl:value-of select=&quot;$NPNotificationIn/Request/tns1:Request/tns1:BusinessID&quot;/>&lt;/h:businessID>&lt;h:messageID>&lt;xsl:value-of select=&quot;$MessageID&quot;/>&lt;/h:messageID>&lt;h:transactionID>&lt;xsl:value-of select=&quot;$TransactionID&quot;/>&lt;/h:transactionID>&lt;/tns:Header>&lt;/tns:NPNotification>&lt;/xsl:template>&lt;/xsl:stylesheet>"
