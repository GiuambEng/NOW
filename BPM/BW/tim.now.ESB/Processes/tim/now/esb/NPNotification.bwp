&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns2="http://telecomitalia.it/NPNotification/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="NPNotificationIn"/&gt;&lt;xsl:param name="MessageID"/&gt;&lt;xsl:param name="Request"/&gt;&lt;xsl:param name="TransactionID"/&gt;&lt;xsl:param name="SelectStagIN"/&gt;&lt;xsl:template name="InsertStag-input" match="/"&gt;&lt;tns:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns1:StagingRequest&gt;&lt;tns1:StagingOut&gt;&lt;tns1:COD_OLO&gt;&lt;xsl:value-of select="$NPNotificationIn/Request/tns2:Request/tns2:Richiesta/codificaOLOAGCOM"/&gt;&lt;/tns1:COD_OLO&gt;&lt;tns1:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($Request,true(), true())"/&gt;&lt;/tns1:CONTENUTO_REQUEST&gt;&lt;tns1:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="42"/&gt;&lt;/tns1:ID_STATO_ELAB_STAG&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$TransactionID"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;tns1:ID_RICH_OLO&gt;&lt;xsl:value-of select="$NPNotificationIn/Request/tns2:Request/tns2:Richiesta/IDRichiestaOLO"/&gt;&lt;/tns1:ID_RICH_OLO&gt;&lt;xsl:if test="$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO"&gt;&lt;tns1:COD_TOPON&gt;&lt;xsl:value-of select="$SelectStagIN/Record[1]/SOURCE_SYSTEM_OLO"/&gt;&lt;/tns1:COD_TOPON&gt;&lt;/xsl:if&gt;&lt;tns1:ID_TIPOLOGIA_EVENTO&gt;&lt;xsl:value-of select="xsd:int($SelectStagIN/Record[1]/ID_TPLG_EVNT_FASTDATA)"/&gt;&lt;/tns1:ID_TIPOLOGIA_EVENTO&gt;&lt;tns1:IDDETTAGLIOORDINE&gt;&lt;xsl:value-of select="xsd:int($NPNotificationIn/Request/tns2:Request/tns2:IDEsecProcsoNoFile)"/&gt;&lt;/tns1:IDDETTAGLIOORDINE&gt;&lt;xsl:if test="$SelectStagIN/Record[1]/ID_NOTF_FASTDATA"&gt;&lt;tns1:ID_LINEA&gt;&lt;xsl:value-of select="$SelectStagIN/Record[1]/ID_NOTF_FASTDATA"/&gt;&lt;/tns1:ID_LINEA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$NPNotificationIn/Request/tns2:Request/tns2:Richiesta/codiceOrdineOLO"&gt;&lt;tns1:RC&gt;&lt;xsl:value-of select="$NPNotificationIn/Request/tns2:Request/tns2:Richiesta/codiceOrdineOLO"/&gt;&lt;/tns1:RC&gt;&lt;/xsl:if&gt;&lt;tns1:BU_ID&gt;&lt;xsl:value-of select="$NPNotificationIn/Request/tns2:Request/tns2:BusinessID"/&gt;&lt;/tns1:BU_ID&gt;&lt;tns1:MESSAGE_ID&gt;&lt;xsl:value-of select="$MessageID"/&gt;&lt;/tns1:MESSAGE_ID&gt;&lt;/tns1:StagingOut&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$NPNotificationIn/Request/tns2:Request/tns2:Richiesta/IDRichiestaOLO"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;tns1:StagingType&gt;&lt;xsl:value-of select="'STAG_FASTDATA_OUT_NO_FILE'"/&gt;&lt;/tns1:StagingType&gt;&lt;tns1:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="126"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'Info'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding