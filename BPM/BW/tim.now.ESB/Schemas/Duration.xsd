<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/Duration/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://telecomitalia.it/Duration/">

    <element name="Duration">
    	<complexType>
    		<sequence>
    			<element name="Duration" type="duration" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="BusinessID">
    	<complexType>
    		<sequence>
    			<element name="BusinessID" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>