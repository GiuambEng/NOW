<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.tim.com/NOW/xsd/List/"
	elementFormDefault="qualified"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.tim.com/NOW/xsd/List/"
	xmlns:ns1="http://telecomitalia.it/NOW/B2BNOWRicarica"
	xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:pref="http://telecomitalia.it/NOW/B2BRicarica/Header">









	<xsd:import schemaLocation="B2B_NOW_Ricarica.xsd"
		namespace="http://telecomitalia.it/NOW/B2BNOWRicarica">
	</xsd:import>

	<xsd:import schemaLocation="Header.xsd" namespace="http://telecomitalia.it/NOW/B2BRicarica/Header"></xsd:import>
	<xsd:element name="Request">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Richiesta">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CodiceOrdineOLO"
								type="xsd:string" />
							<xsd:element name="DatiRisorsa">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element
											name="CodiceOloAgcom">
											<xsd:simpleType>
												<xsd:restriction
													base="xsd:string">
													<xsd:length
														value="3" />
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="IdRisorsa"
											type="xsd:string" />
										<xsd:element name="Note"
											minOccurs="0">
											<xsd:simpleType>
												<xsd:restriction
													base="xsd:string">
													<xsd:maxLength
														value="255" />
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="TipoAzione">
								<xsd:complexType>
									<xsd:choice>
										<xsd:element name="Ricarica">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element
														name="NumeroOrdineRichiesta" type="xsd:string"
														minOccurs="0" />
													<xsd:element
														name="DataInizioRicarica" type="xsd:dateTime"
														minOccurs="0" />
													<xsd:element
														name="TaglioRicarica" type="ns1:TaglioRicaricaType" />
													<xsd:element
														name="TipologiaAccensioneRicarica"
														type="ns1:RicaricaType" />
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element
											name="Annullamento">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element
														name="NumeroOrdineRichiesta" type="xsd:string" />
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element
											name="ListaRicariche">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element
														name="DataInizioEstrazione" type="xsd:dateTime"
														minOccurs="0" />
													<xsd:element
														name="DataFineEstrazione" type="xsd:dateTime"
														minOccurs="0" />
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:choice>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>




				</xsd:element>
				<xsd:element name="Header" type="pref:HeaderType">
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="Response">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="ACK" type="ns1:Ack_Type"
					maxOccurs="1" minOccurs="0">
				</xsd:element>
				<xsd:element name="Header" type="pref:HeaderType" maxOccurs="1" minOccurs="0"></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>