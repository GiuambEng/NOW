<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/NPNotification/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://telecomitalia.it/NPNotification/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="BusinessID" type="string"></element>
				<element name="Richiesta" type="pref:Richiesta"></element>
				<element name="IDEsecProcsoNoFile" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="DNScartati" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="DN" type="string" minOccurs="1" maxOccurs="10"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="Esito" type="string"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Msg" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="MsgCode" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>