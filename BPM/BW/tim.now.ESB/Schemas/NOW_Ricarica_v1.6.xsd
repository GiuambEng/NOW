<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.0" id="NOW_Ricarica.xsd">
	<xs:element name="RichiestaOloRicarica">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Richiesta">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DatiRisorsa">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="CodiceOloAgcom">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:length value="3"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="IdRisorsa">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="IdAsset">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodiceOrdineOloTarget" minOccurs="0">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodiceOrdineTITarget" minOccurs="0">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="Note" minOccurs="0">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="IdContratto">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="CodiceOrdineOLO" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="TipoAzione">
								<xs:complexType>
									<xs:choice>
										<xs:element name="Accensione" type="DatiAccensioneRicarica"/>
										<xs:element name="Spegnimento">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="IdRicarica">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:minLength value="1"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="DataFineRicarica" type="xs:dateTime"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Annullamento">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="IdRicarica">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="12"/>
																<xs:minLength value="1"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Prolungamento">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="IdRicarica">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:maxLength value="12"/>
																<xs:minLength value="1"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="DataInizioRicarica" type="xs:dateTime"/>
													<xs:element name="DatiProlungamento">
														<xs:complexType>
															<xs:choice>
																<xs:element name="TaglioRicaricaXDSL" type="TaglioRicaricaXDSL"/>
																<xs:element name="TaglioRicaricaNGA_VULA" type="TaglioRicaricaNGA_VULA"/>
															</xs:choice>
														</xs:complexType>
													</xs:element>
													<xs:element name="DataFineRicarica" type="xs:dateTime"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Schedulazione" type="DatiAccensioneRicarica"/>
									</xs:choice>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="TaglioRicaricaXDSL">
		<xs:restriction base="xs:string">
			<xs:enumeration value="2"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="28"/>
            <xs:enumeration value="30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TaglioRicaricaNGA_VULA">
		<xs:restriction base="xs:string">
			<xs:enumeration value="2"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="30"/>
            <xs:enumeration value="28"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TipoRicarica">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NRT"/>
			<xs:enumeration value="SCHEDULATA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="DatiAccensioneRicarica">
		<xs:choice>
			<xs:element name="BitstreamGBEAsimmetricoFlat">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataInizioRicarica" type="xs:dateTime"/>
						<xs:element name="DataFineRicarica" type="xs:dateTime"/>
						<xs:element name="TipologiaAccensioneRicarica" type="TipoRicarica"/>
						<!-- NRT o SCHEDULATA -->
						<xs:element name="TaglioRicarica" type="TaglioRicaricaXDSL"/>
						<!-- 28,7,2 -->
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="BitstreamNGAFTTCAB">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataInizioRicarica" type="xs:dateTime"/>
						<xs:element name="DataFineRicarica" type="xs:dateTime"/>
						<xs:element name="TipologiaAccensioneRicarica" type="TipoRicarica"/>
						<!-- NRT o SCHEDULATA -->
						<xs:element name="TaglioRicarica" type="TaglioRicaricaNGA_VULA"/>
						<!-- 30,7,2 -->
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="VULAFTTCAB">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DataInizioRicarica" type="xs:dateTime"/>
						<xs:element name="DataFineRicarica" type="xs:dateTime"/>
						<xs:element name="TipologiaAccensioneRicarica" type="TipoRicarica"/>
						<!-- NRT o SCHEDULATA -->
						<xs:element name="TaglioRicarica" type="TaglioRicaricaNGA_VULA"/>
						<!-- 30,7,2 -->
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:complexType>
</xs:schema>
