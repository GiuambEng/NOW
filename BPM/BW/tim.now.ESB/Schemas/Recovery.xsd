<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Recovery/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Recovery/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="TaglioRicarica" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="IDOfferta" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="BusinessID" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="Valore_Numerico" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ValoreNumericoRitardo" type="int"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="Durata" type="int" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>