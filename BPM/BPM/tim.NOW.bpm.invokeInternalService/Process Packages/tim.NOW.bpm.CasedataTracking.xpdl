	AcquisitionIDTracc = AcquisitionID;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;AcquisitionIDTracc : &quot;+AcquisitionIDTracc);&#xD;
&#xD;
AcquisitionIDTracc;</xpdl2:Actual>
