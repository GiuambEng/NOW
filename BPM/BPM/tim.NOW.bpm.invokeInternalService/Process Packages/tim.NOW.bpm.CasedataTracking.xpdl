if (localRequest.IDRichiestaOLO.slice(localRequest.IDRichiestaOLO.length-4,localRequest.IDRichiestaOLO.length)==&quot;_ANN&quot;)&#xD;
{&#xD;
	Process.auditLog(&quot;Richiesta annullamento stesso file&quot;);&#xD;
}&#xD;
