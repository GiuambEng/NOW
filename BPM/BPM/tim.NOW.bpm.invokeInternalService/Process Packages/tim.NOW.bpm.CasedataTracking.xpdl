            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">AggiornaAssetRequest = com_tim_NOW_xsd_AggiornaAssetNPDonating_Factory.createRequestType();&#xD;
&#xD;
// Leggo gli asset dagli assetRefs in input e valorizzo l'array di IDAsset da mandare al servizio per l'aggiornamento dello stato sulla BDS_CASEDATA_ASSET&#xD;
for(var i = 0; i &lt; AssetRefs.size(); i++)&#xD;
{&#xD;
	AggiornaAssetRequest.idAsset.add(AssetRefs.get(i).readAsset().IDAsset);&#xD;
	Process.auditLog(&quot;Aggiunto idAsset &quot;+AssetRefs.get(i).readAsset().IDAsset+&quot; in input al servizio&quot;);&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
