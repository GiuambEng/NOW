            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">GenerateHashRequest = com_tim_NOW_xsd_GenerateHashingCliente_Factory.createRequestType();&#xD;
&#xD;
GenerateHashRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
GenerateHashRequest.canaleRichiesta = String(localRequest.canaleRichiesta);&#xD;
GenerateHashRequest.codiceOrdineOLO = localRequest.codiceOrdineOLO;&#xD;
GenerateHashRequest.codificaOLOAGCOM = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	GenerateHashRequest.nome = localRequest.ordine.nome;&#xD;
	GenerateHashRequest.cognomeRagioneSociale = localRequest.ordine.cognomeRagioneSociale;&#xD;
	GenerateHashRequest.CF = localRequest.ordine.CF;&#xD;
	GenerateHashRequest.PIVA = localRequest.ordine.PIVA;&#xD;
}&#xD;
