            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="75.0" LaneId="_NJbaMaS4Eemshrz44t76Ew" Width="111.0">
              <xpdl2:Coordinates XCoordinate="333.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
