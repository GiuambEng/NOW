                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_rmDloLJcEeadw_PjkoITMw" OperationName="AggiornaAssetNPDonating">
