          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">CreatedCaseRequestInput = com_tim_NOW_xsd_CreatedCaseRequest_Factory.createCreatedCaseRequestInputType();&#xD;
&#xD;
CreatedCaseRequestInput.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if(numeroRecordCSV != null)&#xD;
{&#xD;
	CreatedCaseRequestInput.numeroRecordCSV = numeroRecordCSV; //RU_1180&#xD;
}&#xD;
&#xD;
//RU_740&#xD;
if(localRequest.contenutoXML != null &amp;&amp; localRequest.contenutoXML != &quot;&quot;)&#xD;
{&#xD;
	CreatedCaseRequestInput.contenutoXML = localRequest.contenutoXML;&#xD;
}&#xD;
else&#xD;
{&#xD;
	CreatedCaseRequestInput.contenutoXML = &quot;&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.lavorazione != null)&#xD;
{&#xD;
	CreatedCaseRequestInput.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
}&#xD;
if (localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA)&#xD;
{&#xD;
	CreatedCaseRequestInput.tipoRichiesta = String(it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA);&#xD;
}&#xD;
CreatedCaseRequestInput.note = localRequest.note;&#xD;
CreatedCaseRequestInput.operatore = localRequest.operatore;&#xD;
CreatedCaseRequestInput.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));&#xD;
&#xD;
CreatedCaseRequestInput.flagDelibera103 = localRequest.flagDelibera103;   //RU_1346</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
