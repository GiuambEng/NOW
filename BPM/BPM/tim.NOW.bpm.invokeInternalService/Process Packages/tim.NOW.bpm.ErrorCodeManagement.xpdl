        <xpdl2:Activity Id="_80cY1IAKEeaImvbI8Xw6Gw" Name="setinput" xpdExt:Visibility="Private" xpdExt:DisplayName="set input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Input = com_tim_NOW_xsd_ErrorCodeManagement_Factory.createmonitoraggioCautelareInput();&#xD;
&#xD;
Input.idAnagCaus = localRequest.IDAnagraficaCausale;&#xD;
Input.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
Input.TMSTP_AggRichOLO = localRequest.lastUpdate;&#xD;
Input.offerta = String(localRequest.offerta);&#xD;
Input.tipologiaLavorazione = String(localRequest.lavorazione);&#xD;
&#xD;
Input.esitoVerifica = EsitoVerifica;&#xD;
&#xD;
if(TipoOperazione==&quot;INSERT&quot;)&#xD;
{&#xD;
	Input.tipoOperazione = com_tim_NOW_xsd_ErrorCodeManagement_TipoOperazioneType1.INSERT;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Input.tipoOperazione = com_tim_NOW_xsd_ErrorCodeManagement_TipoOperazioneType1.UPDATE;&#xD;
	Input.codCausInternoNew = causaleInternoNEW;&#xD;
	Input.descrCausInternoNew = descrizioneInternoNEW;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
