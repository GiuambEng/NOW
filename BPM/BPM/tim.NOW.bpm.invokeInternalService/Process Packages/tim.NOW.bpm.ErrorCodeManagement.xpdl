          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//valore di default di FiltraPerLavorazioneServizio&#xD;
if(FiltraPerLavorazioneServizio==null){&#xD;
	FiltraPerLavorazioneServizio=true;&#xD;
}&#xD;
&#xD;
&#xD;
RecuperaCausaliInput=com_tim_NOW_xsd_ErrorCodeManagement_Factory.createrecuperaCausaliValideInput();&#xD;
RecuperaCausaliInput.codificaOLO_AGCOM = localRequest.codificaOLOAGCOM;&#xD;
RecuperaCausaliInput.idRichiestaNOW = localRequest.IDRichiestaOLO;&#xD;
&#xD;
//fetching fase by comparing with statoRichiestaNOW &#xD;
RecuperaCausaliInput.fase=com_tim_NOW_xsd_CommonSchema_Fase.SCARTO;&#xD;
if (PrecedenteStatoRichiestaNOW==&quot;ANNULLATO&quot;)&#xD;
{&#xD;
RecuperaCausaliInput.fase=com_tim_NOW_xsd_CommonSchema_Fase.ANNULLAMENTO;&#xD;
}&#xD;
else if(PrecedenteStatoRichiestaNOW==&quot;ESPLETAMENTOTECNICO&quot;)&#xD;
{&#xD;
RecuperaCausaliInput.fase=com_tim_NOW_xsd_CommonSchema_Fase.ESPLETAMENTO;&#xD;
}&#xD;
&#xD;
else if (PrecedenteStatoRichiestaNOW==&quot;SOSPESO&quot;)&#xD;
{&#xD;
RecuperaCausaliInput.fase=com_tim_NOW_xsd_CommonSchema_Fase.SOSPENSIONE;&#xD;
}&#xD;
&#xD;
if(FiltraPerLavorazioneServizio){&#xD;
	//fetching lavorazione&#xD;
	RecuperaCausaliInput.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
&#xD;
	//fetching servizio&#xD;
	RecuperaCausaliInput.servizio = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
