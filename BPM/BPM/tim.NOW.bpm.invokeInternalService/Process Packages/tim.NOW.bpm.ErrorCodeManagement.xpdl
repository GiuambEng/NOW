DestinazioneUso = null;&#xD;
&#xD;
while(DestinazioneUso == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var j=0;&#xD;
		&#xD;
		while(DestinazioneUso == null &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			if(componente.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESTINAZIONEUSO)&#xD;
			{&#xD;
				DestinazioneUso = componente.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperata Destinazione uso: &quot;+DestinazioneUso+&quot;, con slice: &quot;+DestinazioneUso.slice(0,1));&#xD;
				&#xD;
				if(DestinazioneUso.length == 1)&#xD;
				{&#xD;
					componente.attributiDettaglioOrdine.get(j).valoreAttributo = DestinazioneUso + &quot;|4&quot;;&#xD;
					localRequest.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
					localRequest.ordine.tipologiaSottolav = it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.ATTIVAZIONE274;&#xD;
					Process.auditLog(&quot;Aggiornata Destinazione uso con &quot;+componente.attributiDettaglioOrdine.get(j).valoreAttributo+&quot; e sottolavorazione con &quot;+localRequest.tipologiaSottolav);&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					componente.attributiDettaglioOrdine.get(j).valoreAttributo = DestinazioneUso.slice(0,1) + &quot;|4&quot;;&#xD;
					Process.auditLog(&quot;Aggiornata Destinazione uso con &quot;+componente.attributiDettaglioOrdine.get(j).valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}	&#xD;
	}&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
