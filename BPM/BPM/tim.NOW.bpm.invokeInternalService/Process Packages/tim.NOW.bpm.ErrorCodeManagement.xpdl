                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_80YucIAKEeaImvbI8Xw6Gw" OperationName="RecuperaCausaliValide">
