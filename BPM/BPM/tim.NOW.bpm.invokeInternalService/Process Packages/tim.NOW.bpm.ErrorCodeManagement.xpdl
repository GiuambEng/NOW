          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">// Create target 'VerificaCongruenzaInputType' if it doesn't exist.
VerificaCongruenzaInputType = com_tim_NOW_xsd_ErrorCodeManagement_Factory.createverificaCongruenzaCausaliInput();

// Map from 'ControlloFallito.id_Causale' to 'VerificaCongruenzaInputType.IDAnagraficaCausale'
VerificaCongruenzaInputType.IDAnagraficaCausale = localRequest.IDAnagraficaCausale;

// Map from 'localRequest.codificaOLOAGCOM' to 'VerificaCongruenzaInputType.codificaOLO_AGCOM'
VerificaCongruenzaInputType.codificaOLO_AGCOM = localRequest.codificaOLOAGCOM;

// Map from 'Fase' to 'VerificaCongruenzaInputType.fase'

// Function for user defined mapping script: Fase

//fetching fase by comparing with statoRichiestaNOW
var fase = com_tim_NOW_xsd_CommonSchema_Fase.SCARTO;
if(nextState == &quot;ANNULLATO&quot;)
{
  	fase = com_tim_NOW_xsd_CommonSchema_Fase.ANNULLAMENTO;
}
else if(nextState == &quot;ESPLETAMENTOTECNICO&quot;)
{
   	fase = com_tim_NOW_xsd_CommonSchema_Fase.ESPLETAMENTO;
}
else if(nextState == &quot;SOSPESO&quot; || nextState == &quot;SOSPESOAPPUNTAMENTO&quot;)
{
   	fase = com_tim_NOW_xsd_CommonSchema_Fase.SOSPENSIONE;
}
    
VerificaCongruenzaInputType.fase = fase;

// Map from 'localRequest.IDRichiestaOLO' to 'VerificaCongruenzaInputType.idRichiestaNOW'
VerificaCongruenzaInputType.idRichiestaNOW = localRequest.IDRichiestaOLO;

// Map from 'localRequest.lavorazione' to 'VerificaCongruenzaInputType.lavorazione'
VerificaCongruenzaInputType.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(String(localRequest.lavorazione)));

// Map from 'localRequest.offerta' to 'VerificaCongruenzaInputType.servizio'
if(localRequest != null &amp;&amp; localRequest.offerta != null)
{
    VerificaCongruenzaInputType.servizio = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(String(localRequest.offerta)));
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
