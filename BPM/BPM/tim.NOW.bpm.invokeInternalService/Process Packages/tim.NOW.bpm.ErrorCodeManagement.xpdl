                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="ErrorCodeManagement_Concrete_v1.4.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
