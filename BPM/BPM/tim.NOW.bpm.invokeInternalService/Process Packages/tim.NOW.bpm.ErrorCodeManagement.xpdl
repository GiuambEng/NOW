            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="117.0" LaneId="_6UrESYGKEea1BcUITTCQOA" Width="146.0">
              <xpdl2:Coordinates XCoordinate="351.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
