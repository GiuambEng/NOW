        <xpdl2:Activity Id="_80c_54AKEeaImvbI8Xw6Gw" Name="SetInput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">Input = com_tim_NOW_xsd_ErrorCodeManagement_Factory.createstoricizzaLavorazioneManualeInput();&#xD;
Input.IDAnagCaus = localRequest.IDAnagraficaCausale;&#xD;
Input.IDOfferta = localRequest.IDOfferta;&#xD;
Input.IDRisorsa =localRequest.IDRisorsa;&#xD;
Input.ID_RchiestaOLO = localRequest.IDRichiestaOLO;&#xD;
Input.causaleErrore = causaleErrore;&#xD;
Input.codOLO = localRequest.codiceOrdineOLO;&#xD;
Input.codificaOLONow = localRequest.codificaOLONOW;&#xD;
Input.esitoVerifica = EsitoVerifica;&#xD;
Input.lavorazione = String(localRequest.lavorazione);&#xD;
Input.noteElaborazione = Note;&#xD;
Input.offerta = String(localRequest.offerta);&#xD;
Input.operatore = Operatore;&#xD;
Input.tipoAzione = Azione;&#xD;
if(TipoOperazione == &quot;INSERT&quot;){&#xD;
	Input.tipoOperazione = com_tim_NOW_xsd_ErrorCodeManagement_TipoOperazioneType1.INSERT;&#xD;
}&#xD;
else {&#xD;
	Input.tipoOperazione = com_tim_NOW_xsd_ErrorCodeManagement_TipoOperazioneType1.UPDATE;&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
