}&#xD;
&#xD;
if(localRequest.lavorazione != null)&#xD;
{&#xD;
	MonitoraggioCautelare_v1_Request.tipologiaLavorazione = String(localRequest.lavorazione);&#xD;
}&#xD;
&#xD;
if(TipoOperazione==&quot;INSERT&quot;)&#xD;
{&#xD;
	MonitoraggioCautelare_v1_Request.tipoOperazione = com_tim_NOW_xsd_ErrorCodeManagement_TipoOperazioneType1.INSERT;&#xD;
}&#xD;
else&#xD;
{&#xD;
