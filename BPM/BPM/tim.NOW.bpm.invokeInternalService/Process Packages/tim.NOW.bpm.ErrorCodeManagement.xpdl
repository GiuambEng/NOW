              <xpdExt:Information ScriptGrammar="JavaScript">MonitoraggioCautelare_v1_Request = com_tim_NOW_xsd_ErrorCodeManagement_Factory.createmonitoraggioCautelare_Input1();&#xD;
&#xD;
MonitoraggioCautelare_v1_Request.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
