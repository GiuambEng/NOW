	DeterminaClusterRadius.codOLOAgcom = localRequest.codificaOLOAGCOM;&#xD;
	DeterminaClusterRadius.codiceProgetto = localRequest.codiceProgetto;&#xD;
	DeterminaClusterRadius.lavorazione = String(localRequest.lavorazione);&#xD;
	DeterminaClusterRadius.offerta = String(localRequest.offerta);&#xD;
	DeterminaClusterRadius.sottoLavorazione = String(localRequest.tipologiaSottolav); //SM_12067&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
