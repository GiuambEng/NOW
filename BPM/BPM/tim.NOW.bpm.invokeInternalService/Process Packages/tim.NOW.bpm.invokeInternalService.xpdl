          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaOLOblackOtoOperatoreRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaOLOinblacklistONTOperatore_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	DeterminaOLOblackOtoOperatoreRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	DeterminaOLOblackOtoOperatoreRequest.offerta = String(localRequest.offerta);&#xD;
	DeterminaOLOblackOtoOperatoreRequest.DRO = localRequest.DRO;&#xD;
	DeterminaOLOblackOtoOperatoreRequest.codOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
				{&#xD;
					DeterminaOLOblackOtoOperatoreRequest.codiceServizio = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
