                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_7l7-sF-KEeq9DrMHh8xhhw" OperationName="CalcoloRemoteID">
