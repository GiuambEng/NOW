                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_8zGdwLPkEeegdcKeFiA4RA" OperationName="RecuperaTipoNumeroTipoServizio">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="RecuperaTipoNumeroTipoServizioSOAP" ServiceName="RecuperaTipoNumeroTipoServizio">
