                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_WC5xANfBEeqh2KUpLPmtBw" OperationName="Calcolo_Trasporto_Vlan">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceVlanPortTypeSOAP" ServiceName="BPM_CheckServiceVlanPortType">
