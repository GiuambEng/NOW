			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDULLCO)&#xD;
			{&#xD;
				DeterminaAreaDiCantiereRequest.IDULLCO = attributo.valoreAttributo;&#xD;
