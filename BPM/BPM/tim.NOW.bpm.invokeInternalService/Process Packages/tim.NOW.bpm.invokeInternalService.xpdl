                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">StateMachineValidationResponse</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.FLAG_ARRICCHIMENTO">
                      <xpdl2:Actual ScriptGrammar="JavaScript">FLAG_ARRICCHIMENTO</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_GmyyBJCFEeaEm-ktY1iisg" OperationName="ValidateNotification">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="StateMachineValidationPortTypeSOAP" ServiceName="StateMachineValidationPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="StateMachineValidation_concrete_v.1.0.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
                <xpdExt:PortTypeOperation PortTypeName="StateMachineValidationPortType" OperationName="ValidateNotification">
