          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" LaneId="_v_8PgVDXEfCL_cmBnQ7P-w" Width="45.0">
              <xpdl2:Coordinates XCoordinate="848.0" YCoordinate="155.0"/>
