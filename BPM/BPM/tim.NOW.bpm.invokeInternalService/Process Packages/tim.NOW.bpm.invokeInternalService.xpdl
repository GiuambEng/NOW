          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Creo LavorazioneRichiesta se è null&#xD;
if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}&#xD;
&#xD;
CalcoloTrasportoVLANRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createCalcolo_Trasporto_Vlan_RequestType();&#xD;
CalcoloTrasportoVLANRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
&#xD;
CalcoloTrasportoVLANRequest.idAdrCrmws = LavorazioneRichiesta.idAdrCrmws;&#xD;
CalcoloTrasportoVLANRequest.idMadrCrmws = LavorazioneRichiesta.idMadrCrmws;&#xD;
&#xD;
CalcoloTrasportoVLANRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
CalcoloTrasportoVLANRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
CalcoloTrasportoVLANRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
&#xD;
// DATI DA RICHIESTA&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				CalcoloTrasportoVLANRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICETDKIT &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
			{&#xD;
				CalcoloTrasportoVLANRequest.clliCentrale = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICECLLI &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA) //SM_9882&#xD;
			{&#xD;
				CalcoloTrasportoVLANRequest.superMacroArea = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo SUPERMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(ConsistenzaRaccolta != null){&#xD;
	CalcoloTrasportoVLANRequest.codiceTdKitConsistenza = ConsistenzaRaccolta.codiceTdKit; //SM_9882&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
