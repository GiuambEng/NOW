          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;Output: codFatturazionePrincipale = &quot; + outputElement.codFatturazionePrincipale + &quot;, codFatturazioneAggiuntivi = &quot; + outputElement.codFatturazioneAggiuntivi);&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLR&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEAATTIVA&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOWLR &amp;&amp; outputElement.codFatturazionePrincipale!= null &amp;&amp; outputElement.codFatturazionePrincipale!= &quot;&quot;)&#xD;
		{&#xD;
			var codiceFatturazioneTrovato = false;&#xD;
			var j = 0;&#xD;
			while(!codiceFatturazioneTrovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE)&#xD;
				{&#xD;
					codiceFatturazioneTrovato = true;&#xD;
					attributo.valoreAttributo = outputElement.codFatturazionePrincipale;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					Process.auditLog(&quot;Sostituito CODICEFATTURAZIONE in &quot;+componente.nomeComponente+&quot;, valore: &quot;+outputElement.codFatturazionePrincipale);&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!codiceFatturazioneTrovato)&#xD;
			{&#xD;
				var attr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attr.created = DateTimeUtil.createDatetime();&#xD;
				attr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				attr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE;&#xD;
				attr.operatore = &quot;BPM&quot;;&#xD;
				attr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attr.valoreAttributo = outputElement.codFatturazionePrincipale;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attr));&#xD;
				Process.auditLog(&quot;Aggiunto CODICEFATTURAZIONE in &quot;+componente.nomeComponente+&quot;, valore: &quot;+outputElement.codFatturazionePrincipale);&#xD;
			}&#xD;
		}&#xD;
		else if((componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO || componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO) &amp;&amp; outputElement.codFatturazioneAggiuntivi!= null &amp;&amp; outputElement.codFatturazioneAggiuntivi != &quot;&quot;)&#xD;
		{&#xD;
			var codiceFatturazioneTrovato = false;&#xD;
			var j = 0;&#xD;
			while(!codiceFatturazioneTrovato &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE)&#xD;
				{&#xD;
					codiceFatturazioneTrovato = true;&#xD;
					attributo.valoreAttributo = outputElement.codFatturazioneAggiuntivi;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					Process.auditLog(&quot;Sostituito CODICEFATTURAZIONE in &quot;+componente.nomeComponente+&quot;, valore: &quot;+outputElement.codFatturazioneAggiuntivi);&#xD;
				}&#xD;
					&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!codiceFatturazioneTrovato)&#xD;
			{&#xD;
				var attr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attr.created = DateTimeUtil.createDatetime();&#xD;
				attr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				attr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEFATTURAZIONE;&#xD;
				attr.operatore = &quot;BPM&quot;;&#xD;
				attr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attr.valoreAttributo = outputElement.codFatturazioneAggiuntivi;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attr));&#xD;
				Process.auditLog(&quot;Aggiunto CODICEFATTURAZIONE in &quot;+componente.nomeComponente+&quot;, valore: &quot;+outputElement.codFatturazioneAggiuntivi);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
