          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">AssettizzazioneVlanRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createGestione_Assettizzazione_Consistenza_Vlan_RequestType();&#xD;
&#xD;
//AssettizzazioneVlanRequest.clli = localRequest.ordine.CLLI;&#xD;
AssettizzazioneVlanRequest.codificaOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
AssettizzazioneVlanRequest.codificaOloNow = localRequest.codificaOLONOW;&#xD;
AssettizzazioneVlanRequest.des = localRequest.ordine.DES;&#xD;
AssettizzazioneVlanRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
AssettizzazioneVlanRequest.idRisorsa = localRequest.IDRisorsa;&#xD;
AssettizzazioneVlanRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
AssettizzazioneVlanRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componenteReq = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componenteReq.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;&#xD;
	|| componenteReq.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.OLOVLAN&#xD;
	|| componenteReq.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		var componenteTemp = com_tim_NOW_xsd_ControlliVlan_Factory.createComponente(); //Componente da passare al servizio&#xD;
		componenteTemp.nomeComponente = String(componenteReq.nomeComponente);&#xD;
		componenteTemp.azione = String(componenteReq.azione);&#xD;
		&#xD;
		for(var j=0; j&lt;componenteReq.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributoReq = componenteReq.attributiDettaglioOrdine.get(j); //Attributi da passare al servizio&#xD;
			&#xD;
			var attributoTemp = com_tim_NOW_xsd_ControlliVlan_Factory.createAttributi();&#xD;
			attributoTemp.nomeAttributo = String(attributoReq.nomeAttributo);&#xD;
			attributoTemp.valoreAttributo = attributoReq.valoreAttributo;&#xD;
			&#xD;
			componenteTemp.attributi.add(attributoTemp);&#xD;
			&#xD;
			if(attributoReq.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
			{&#xD;
				AssettizzazioneVlanRequest.clli = attributoReq.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		AssettizzazioneVlanRequest.componente.add(componenteTemp);&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
