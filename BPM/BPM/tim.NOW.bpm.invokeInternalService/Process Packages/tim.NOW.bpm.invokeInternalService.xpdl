        <xpdl2:Activity Id="_imWokkatEfCI6_5G5wXIUg" Name="PrecondizioneFallita" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Precondizione Fallita">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
&#xD;
EsitoResponse.codice = true;&#xD;
EsitoResponse.descrizione = &quot;Determina modello VULA Migr Del82 saltato&quot;;&#xD;
Process.auditLog(EsitoResponse.descrizione);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_UtEkkUatEfCI6_5G5wXIUg" Width="143.0">
              <xpdl2:Coordinates XCoordinate="353.0" YCoordinate="80.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_jD2c4katEfCI6_5G5wXIUg" Name="DeterminamodelloVULAMigrDel82" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Determina modello VULA Migr Del82">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">EsitoResponse = com_tim_NOW_xsd_ControlliAmmessi_Factory.createEsitoType();&#xD;
EsitoResponse.codice= true;&#xD;
EsitoResponse.descrizione=&quot;controllo C01M02F45 superato&quot;;&#xD;
&#xD;
var failed = false;&#xD;
var userVlanId = DataUtil.createList();&#xD;
var userVlanCode = DataUtil.createList();&#xD;
&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
{&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
	{&#xD;
		for(var i=0 ; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN)&#xD;
			{&#xD;
				for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size();j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
					{&#xD;
						userVlanId.add(currentAttDettOrdine.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da ORDINE MIG aggiunto USERVLANID &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE)&#xD;
					{&#xD;
						userVlanCode.add(currentAttDettOrdine.valoreAttributo);&#xD;
						Process.auditLog(&quot;Da ORDINE MIG aggiunto SVLANCODE &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
					}&#xD;
					else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST&#xD;
						 &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;SI&quot;)&#xD;
					{&#xD;
						userVlanCode.add(&quot;&quot;);&#xD;
						Process.auditLog(&quot;Da ORDINE MIG aggiunto SVLANCODE vuoto per MULTICAST&quot;);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(userVlanCode.size() &lt; 1)&#xD;
{&#xD;
	failed = true;&#xD;
	Process.auditLog(&quot;Presente nessuno SVLANCODE&quot;);&#xD;
}&#xD;
else&#xD;
{&#xD;
	var i=0;&#xD;
	&#xD;
	while(!failed &amp;&amp; i &lt; userVlanCode.size())&#xD;
	{&#xD;
		if(i > 0)&#xD;
		{&#xD;
			if(userVlanCode.get(i) != userVlanCode.get(i-1))&#xD;
			{&#xD;
				failed = true;&#xD;
				Process.auditLog(&quot;Trovati SVLANCODE diversi: &quot;+userVlanCode.get(i)+&quot; e &quot;+userVlanCode.get(i-1));&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(failed)&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo MODELLO VULA: trovati SvlanCode distinti oppure nessuno svlancode trovato&quot;;&#xD;
	FlagNuovoModello = &quot;N&quot;;&#xD;
}&#xD;
&#xD;
else&#xD;
{&#xD;
	EsitoResponse.codice = true;&#xD;
	EsitoResponse.descrizione = &quot;Controllo MODELLO VULA: nuovo modello (Y)&quot;;&#xD;
	FlagNuovoModello = &quot;Y&quot;;&#xD;
}&#xD;
&#xD;
Process.auditLog(EsitoResponse.descrizione);&#xD;
&#xD;
&#xD;
//aggiungere il flag in attributo dettaglio ordine (FLAGNUOVOMODELLO) della componente (ACCESSOVULAFTTH)&#xD;
i=0;&#xD;
var trovataComponente=false;&#xD;
var trovatoAttributo = false;&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var attributoTemp = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
attributoTemp.lastUpdate = date;&#xD;
attributoTemp.created = date;&#xD;
attributoTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO;&#xD;
attributoTemp.operatore= &quot;BPM&quot;;&#xD;
attributoTemp.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
attributoTemp.valoreAttributo = FlagNuovoModello;&#xD;
				&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	while(!trovataComponente &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH)&#xD;
		 {&#xD;
			trovataComponente=true;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(!trovatoAttributo &amp;&amp; j &lt; dettaglio.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var attributo = dettaglio.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGNUOVOMODELLO)&#xD;
				{&#xD;
					trovatoAttributo = true;&#xD;
					attributo.valoreAttributo = FlagNuovoModello;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!trovatoAttributo)&#xD;
			{&#xD;
				attributoTemp.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
				attributoTemp.IDRichiestaOLO = dettaglio.IDRichiestaOLO;&#xD;
&#xD;
				localRequest.ordine.dettaglioordine.get(i).attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(!trovataComponente)&#xD;
	{&#xD;
		var componente = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
		componente.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size()+1;&#xD;
		componente.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
		componente.created = DateTimeUtil.createDatetime();&#xD;
		componente.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
		componente.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size();&#xD;
		&#xD;
		if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
		    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS)&#xD;
		{&#xD;
			componente.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH;&#xD;
		}&#xD;
		&#xD;
		componente.operatore = &quot;BPM&quot;;&#xD;
		componente.progressivo = 1;&#xD;
		&#xD;
		attributoTemp.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
		attributoTemp.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				&#xD;
		componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoTemp));&#xD;
		&#xD;
		localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componente));&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
