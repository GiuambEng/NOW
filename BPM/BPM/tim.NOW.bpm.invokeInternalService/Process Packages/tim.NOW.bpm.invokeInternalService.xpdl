        <xpdl2:Activity Id="_bhDhgOfREeaVge_mO9ZDvA" Name="SetInput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set Input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">// InputAllineamento_OGG&#xD;
InputAllineamento_OGG = com_tim_NOW_xsd_NOWtoCRMWSAllineamentoConsistenza_Factory.createREQUESTType();&#xD;
&#xD;
//InputAllineamento_OGG.DATIORDINE&#xD;
InputAllineamento_OGG.DATIORDINE = com_tim_NOW_xsd_NOWtoCRMWSAllineamentoConsistenza_Factory.createDATIORDINEType();&#xD;
InputAllineamento_OGG.DATIORDINE.CF = localRequest.ordine.CF;&#xD;
InputAllineamento_OGG.DATIORDINE.DAC = localRequest.ordine.DAC;&#xD;
InputAllineamento_OGG.DATIORDINE.PIVA= localRequest.ordine.PIVA;&#xD;
InputAllineamento_OGG.DATIORDINE.cognomeRagioneSociale = localRequest.ordine.cognomeRagioneSociale;&#xD;
InputAllineamento_OGG.DATIORDINE.nome = localRequest.ordine.nome;&#xD;
&#xD;
//InputAllineamento_OGG.ASSETPRINCIPALE&#xD;
if(Assetv1 != null)&#xD;
{&#xD;
	InputAllineamento_OGG.ASSETPRINCIPALE = ScriptUtil.copy(Assetv1);&#xD;
}&#xD;
&#xD;
//InputAllineamento_OGG.RICHIESTA&#xD;
if(localRequestv1 != null)&#xD;
{&#xD;
	InputAllineamento_OGG.RICHIESTA = ScriptUtil.copy(localRequestv1);&#xD;
}&#xD;
&#xD;
//InputAllineamento_OGG.SERVIZIO&#xD;
InputAllineamento_OGG.SERVIZIO = com_tim_NOW_xsd_NOWtoCRMWSAllineamentoConsistenza_Factory.createservizioType();&#xD;
InputAllineamento_OGG.SERVIZIO.CODICE_OLO = localRequest.codificaOLONOW;&#xD;
InputAllineamento_OGG.SERVIZIO.DESCOLO = localRequest.codificaOLOAGCOM;&#xD;
&#xD;
//InputAllineamento_OGG.ASSETCORRELATI&#xD;
if(AssetAggiuntivi!= null &amp;&amp; AssetAggiuntivi.size()>0){&#xD;
	InputAllineamento_OGG.ASSETCORRELATI_ATTIVAZIONE.addAll(AssetAggiuntivi);&#xD;
}&#xD;
if(AssetCessati!= null &amp;&amp; AssetCessati.size()>0){&#xD;
	InputAllineamento_OGG.ASSETCORRELATI_CESSAZIONE.addAll(AssetCessati);&#xD;
}&#xD;
if(AssetVariati!= null &amp;&amp; AssetVariati.size()>0){&#xD;
	InputAllineamento_OGG.ASSETCORRELATI_VARIAZIONE.addAll(AssetVariati);&#xD;
}&#xD;
&#xD;
//InputAllineamento_OGG.numeriAggiuntivi&#xD;
var PIATTAFORME =&quot;&quot;;&#xD;
var PRINCIPALE=&quot;&quot;;&#xD;
var RADICALE=&quot;&quot;;&#xD;
var ROUTINGNUMBER=&quot;&quot;;&#xD;
var TIPOLINEANP=&quot;&quot;;&#xD;
var TIPOSERVIZIO=&quot;&quot;;&#xD;
var TOTALEAGGIUNTIVI=&quot;&quot;;&#xD;
var TOTALELINEE=&quot;&quot;;&#xD;
var TIPONUMERO =&quot;&quot;;&#xD;
var CAPOSERIE =&quot;&quot;;&#xD;
var CODICERO = &quot;&quot;;&#xD;
var OLORETAILER = &quot;&quot;;&#xD;
&#xD;
&#xD;
PIATTAFORME =null;&#xD;
PRINCIPALE =null;&#xD;
RADICALE =null;&#xD;
ROUTINGNUMBER =null;&#xD;
TIPOLINEANP =null;&#xD;
TIPOSERVIZIO =null;&#xD;
TOTALEAGGIUNTIVI =null;&#xD;
TOTALELINEE =null;&#xD;
TIPONUMERO=null;&#xD;
CAPOSERIE= null;&#xD;
CODICERO = null;&#xD;
OLORETAILER = null;&#xD;
&#xD;
if(localRequest.ordine != null){&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY){&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size();j++){&#xD;
				var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PIATTAFORMACOMMERCIALE){&#xD;
					PIATTAFORME = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
					PRINCIPALE = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RADICALE){&#xD;
					RADICALE = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ROUTINGNUMBER){&#xD;
					ROUTINGNUMBER = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEAOLO){&#xD;
					TIPOLINEANP = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOSERVIZIO){&#xD;
					TIPOSERVIZIO = attr.valoreAttributo;&#xD;
				}else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALEAGGIUNTIVI){&#xD;
					TOTALEAGGIUNTIVI = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TOTALELINEE){&#xD;
					TOTALELINEE = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPONUMERO){&#xD;
					TIPONUMERO = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAPOSERIE){&#xD;
					CAPOSERIE = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICERO){&#xD;
					CODICERO = attr.valoreAttributo;&#xD;
				}&#xD;
				else if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER){&#xD;
					OLORETAILER = attr.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.NP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP){&#xD;
	for(var i=0; i&lt;AssetAggiuntiviList.size(); i++){&#xD;
		var assetTemp = AssetAggiuntiviList.get(i);&#xD;
		var assetAggiuntivi = com_tim_NOW_xsd_CRMWSNumberPortability_Factory.createAssetAggiuntiviComplexType();&#xD;
		assetAggiuntivi.IDAsset = assetTemp.IDAsset;&#xD;
		assetAggiuntivi.numeroTelefonico = assetTemp.numeroTelefonico;&#xD;
		assetAggiuntivi.DES = assetTemp.DES;&#xD;
		assetAggiuntivi.IDAssetCRMWS = assetTemp.IDAssetCRMWS;&#xD;
		assetAggiuntivi.IDContratto = assetTemp.IDContratto;&#xD;
		assetAggiuntivi.IDRichOLO = assetTemp.IDRichiestaOLO;&#xD;
		assetAggiuntivi.IDRisorsa = assetTemp.IDRisorsa;&#xD;
		assetAggiuntivi.codiceOrdineOLO = assetTemp.codiceOrdineOLO;&#xD;
		assetAggiuntivi.codiceOrdineTI = assetTemp.codiceOrdineTI;&#xD;
		assetAggiuntivi.codificaOLOAgcom = assetTemp.codificaOLOAGCOM;&#xD;
		assetAggiuntivi.codificaOLOAgicomDonating = assetTemp.codificaOLOAGCOMDonating;&#xD;
		assetAggiuntivi.distretto = assetTemp.distretto;&#xD;
		assetAggiuntivi.numeroTelefonico = assetTemp.numeroTelefonico;&#xD;
		assetAggiuntivi.numeroTelefonicoPrincipale = assetTemp.numTelPrincipale;&#xD;
		assetAggiuntivi.offerta = String(assetTemp.offerta);&#xD;
		&#xD;
		if(assetTemp.cliente != null)&#xD;
		{&#xD;
			assetAggiuntivi.CF = assetTemp.cliente.codiceFiscale;&#xD;
			assetAggiuntivi.cognomeragsociale = assetTemp.cliente.cognomeRagioneSociale;&#xD;
			assetAggiuntivi.nome = assetTemp.cliente.nome;&#xD;
			assetAggiuntivi.partitaIVA = assetTemp.cliente.partitaIVA;&#xD;
		}&#xD;
		&#xD;
		assetAggiuntivi.NUMBERPORTABILITY = com_tim_NOW_xsd_CRMWSNumberPortability_Factory.createNUMBERPORTABILITYType1();&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti = com_tim_NOW_xsd_CRMWSNumberPortability_Factory.createattributiNumeriAggiunti();&#xD;
		&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.PIATTAFORME = PIATTAFORME;	&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.PRINCIPALE = PRINCIPALE;	&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.RADICALE = RADICALE;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.ROUTINGNUMBER =ROUTINGNUMBER;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.TIPOLINEANP = TIPOLINEANP;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.TIPOSERVIZIO =TIPOSERVIZIO;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.TOTALEAGGIUNTIVI = TOTALEAGGIUNTIVI;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.TOTALELINEE =TOTALELINEE;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.TIPONUMERO = TIPONUMERO;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.CAPOSERIE = CAPOSERIE;&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.CODICERO = CODICERO;&#xD;
&#xD;
		assetAggiuntivi.NUMBERPORTABILITY.attributiNumeriAggiunti.OLORETAILER = OLORETAILER;&#xD;
	&#xD;
		InputAllineamento_OGG.numeriAggiuntivi.add(assetAggiuntivi);&#xD;
	}&#xD;
}&#xD;
&#xD;
