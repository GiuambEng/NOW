            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaONTOperatoreRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaONTOperatore_RequestType();&#xD;
&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	DeterminaONTOperatoreRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
	DeterminaONTOperatoreRequest.offerta = String(localRequest.offerta);&#xD;
	DeterminaONTOperatoreRequest.servizioNonValido = ServizioNonValido;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
