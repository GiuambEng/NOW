          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaDatiCentraleNGA_Request = com_tim_NOW_xsd_ControlliVlan_Factory.createDetermina_Dati_Centrale_NGA_RequestType();&#xD;
&#xD;
DeterminaDatiCentraleNGA_Request.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
DeterminaDatiCentraleNGA_Request.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
DeterminaDatiCentraleNGA_Request.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
&#xD;
//SM_9882: per le variazioni passiamo il valore in consistenza, mentre per le attivazion il tag in input &#xD;
if(ConsistenzaRaccolta != null &amp;&amp; ConsistenzaRaccolta.codiceClli != null&#xD;
   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
{&#xD;
   DeterminaDatiCentraleNGA_Request.clli = ConsistenzaRaccolta.codiceClli;&#xD;
}&#xD;
else&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
				{&#xD;
					DeterminaDatiCentraleNGA_Request.clli = attributo.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo CODICECLLI &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
//Creo LavorazioneRichiesta se è null&#xD;
if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}</xpdExt:Information>
