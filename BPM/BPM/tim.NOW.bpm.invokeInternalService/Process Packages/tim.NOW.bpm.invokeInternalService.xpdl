          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">RecuperaTipoNumeroRequest = com_tim_NOW_xsd_RecuperaTipoNumeroTipoServizio_Factory.createRecuperaTipoNumTipoServInType();&#xD;
&#xD;
RecuperaTipoNumeroRequest.idRichiestaOLO = IDRichiestaOLO;&#xD;
&#xD;
for(var i = 0; i &lt; NumeroTelefonico.size(); i++)&#xD;
{&#xD;
	var num = com_tim_NOW_xsd_RecuperaTipoNumeroTipoServizio_Factory.createNumeroTelefonicoNPType();&#xD;
	&#xD;
	num.numeroTelefonico = NumeroTelefonico.get(i);&#xD;
	&#xD;
	RecuperaTipoNumeroRequest.numeroTelefonicoNP.add(ScriptUtil.copy(num));&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(!flagOscurato)&#xD;
{&#xD;
	for(var i = 0; i &lt; RecuperaTipoNumeroResponse.recuperaTipoNumOutput.size(); i++)&#xD;
	{&#xD;
		var currentRecuperaTipoNumero = RecuperaTipoNumeroResponse.recuperaTipoNumOutput.get(i);&#xD;
	&#xD;
		TipoNumero.add(currentRecuperaTipoNumero.tipoNumero);&#xD;
		TipoServizio.add(currentRecuperaTipoNumero.tipoServizio);&#xD;
	}&#xD;
}</xpdExt:Information>
