            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="69.0" LaneId="_3f9dQl-JEeq9DrMHh8xhhw" Width="119.0">
              <xpdl2:Coordinates XCoordinate="543.0" YCoordinate="137.0"/>
