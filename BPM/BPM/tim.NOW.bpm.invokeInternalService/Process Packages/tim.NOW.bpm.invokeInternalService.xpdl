                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest.IDRisorsa</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.IDRisorsa">
