                        <xpdl2:Actual ScriptGrammar="JavaScript">DeterminaModelloDiServizioRequest</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:InputMappings>
                </xpdl2:MessageIn>
