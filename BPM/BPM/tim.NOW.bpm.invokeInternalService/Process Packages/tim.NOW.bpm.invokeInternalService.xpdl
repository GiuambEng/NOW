          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaIDANAGKITADRCARRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createDetermina_Identificativo_Anagrafica_Kit_Adr_Car_RequestType();&#xD;
&#xD;
DeterminaIDANAGKITADRCARRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
DeterminaIDANAGKITADRCARRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));;&#xD;
DeterminaIDANAGKITADRCARRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
DeterminaIDANAGKITADRCARRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
&#xD;
DeterminaIDANAGKITADRCARRequest.idAdrCrmws = LavorazioneRichiesta.idAdrCrmws;&#xD;
DeterminaIDANAGKITADRCARRequest.idMadrCrmws = LavorazioneRichiesta.idMadrCrmws;&#xD;
&#xD;
//RU_1099&#xD;
if(LavorazioneRichiesta != null &amp;&amp; LavorazioneRichiesta.idMadrCrmwsComm != null)&#xD;
{&#xD;
	DeterminaIDANAGKITADRCARRequest.idMadrCrmwsComm = LavorazioneRichiesta.idMadrCrmwsComm;&#xD;
}&#xD;
&#xD;
// DATI DA CONSISTENZA&#xD;
if(ConsistenzaRaccoltaTemp != null)&#xD;
{&#xD;
	DeterminaIDANAGKITADRCARRequest.codiceTdKitConsistenza = ConsistenzaRaccoltaTemp.codiceTdKit;&#xD;
	DeterminaIDANAGKITADRCARRequest.idKitAreaCarConsistenza = ConsistenzaRaccoltaTemp.idKitAreaCar;&#xD;
	DeterminaIDANAGKITADRCARRequest.idAsset = ConsistenzaRaccoltaTemp.IDAsset;&#xD;
	&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccoltaTemp.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
	&#xD;
	for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(currentDettAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					DeterminaIDANAGKITADRCARRequest.identificativoTipologiaCosConsistenza = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(String(currentDettAsset.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
				{&#xD;
					DeterminaIDANAGKITADRCARRequest.famigliaVlanConsistenza = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
				else if(currentAttDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
				{&#xD;
					DeterminaIDANAGKITADRCARRequest.identificativoCarConsistenza = currentAttDettAsset.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
// DATI DA RICHIESTA&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICETDKIT &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.famigliaVlan = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BMCLIGHT)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.bmcLight = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo BMCLIGHT &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.superMacroArea = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo SUPERMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCAR)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.identificativoCar = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCAR &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			//RU_1099&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.CC_LIB = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
			{&#xD;
				DeterminaIDANAGKITADRCARRequest.identificativoTipologiaCos = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//Creo LavorazioneRichiesta se è null&#xD;
if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_x23KgeFhEeqCP_tvVex8aA" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_wZqzwOFhEeqCP_tvVex8aA" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_synNguFhEeqCP_tvVex8aA" Width="58.0">
              <xpdl2:Coordinates XCoordinate="60.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_w7CuQf23EeqiufrSKghXsw" Name="CheckPrecondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Check Precondizione">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
//Il controllo non va effettuato per servizio VLANVULA&#xD;
if(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA)&#xD;
{&#xD;
	var FamigliaVlan = &quot;&quot;;&#xD;
	FamigliaVlan = null;&#xD;
	var IdentificativoCos = &quot;&quot;;&#xD;
	IdentificativoCos = null;&#xD;
	&#xD;
	//SM_9860: per le VARIAZIONI bisogna controllare i valori in consistenza&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE     &#xD;
	    &amp;&amp; ConsistenzaRaccoltaTemp != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccoltaTemp.IDAsset, 10));&#xD;
		&#xD;
		if(AssetRef!= null)&#xD;
		{	&#xD;
			Asset = AssetRef.readAsset();&#xD;
			&#xD;
			for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var currentComponente = Asset.dettaglioasset.get(i);&#xD;
			&#xD;
				if(String(currentComponente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
				{&#xD;
					for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
						{&#xD;
							FamigliaVlan = currentAttributo.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ currentAttributo.valoreAttributo +&quot; su componente con IDDett &quot;+currentComponente.IDDettaglioAsset);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				else if(currentComponente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
				{	&#xD;
					for(var j=0; j&lt;currentComponente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var currentAttributo = currentComponente.attributidettaglioasset.get(j);&#xD;
					&#xD;
						if(currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
						{&#xD;
							IdentificativoCos = currentAttributo.valoreAttributo;&#xD;
							Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ currentAttributo.valoreAttributo +&quot; su componente con IDDett &quot;+currentComponente.IDDettaglioAsset);&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else &#xD;
	{	&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
					{&#xD;
						FamigliaVlan = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						IdentificativoCos = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);	&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	if(((FamigliaVlan == &quot;1&quot; &amp;&amp; (IdentificativoCos == &quot;0&quot; || IdentificativoCos == &quot;1&quot;)) &#xD;
		|| FamigliaVlan == &quot;2&quot; &#xD;
		|| FamigliaVlan == &quot;3&quot;) &#xD;
			&amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.VARIAZIONEBANDA) //SM_9894&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
