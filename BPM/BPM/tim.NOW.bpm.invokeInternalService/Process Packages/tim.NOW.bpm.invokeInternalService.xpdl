        </xpdl2:Activity>
        <xpdl2:Activity Id="_NKxecfK3EeqLdswaMl47yQ" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_BkbtcPK3EeqLdswaMl47yQ" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_IB11wfK3EeqLdswaMl47yQ" Width="45.0">
              <xpdl2:Coordinates XCoordinate="170.0" YCoordinate="219.0"/>
