              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaCLLIJiveInput = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaCLLIJive_RequestType();&#xD;
&#xD;
if(localRequest != null)&#xD;
{&#xD;
	if(localRequest.lavorazione != null &amp;&amp; localRequest.lavorazione != &quot;&quot;)&#xD;
	{&#xD;
		DeterminaCLLIJiveInput.lavorazione = String(localRequest.lavorazione);&#xD;
