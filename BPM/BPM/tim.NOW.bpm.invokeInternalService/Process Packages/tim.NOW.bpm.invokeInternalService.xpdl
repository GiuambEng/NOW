          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaTipologiaONTRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaTipologiaONT_RequestType();&#xD;
&#xD;
DeterminaTipologiaONTRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
DeterminaTipologiaONTRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
	{&#xD;
		var arrCodiceServizio = com_tim_NOW_xsd_ControlliFormali_Factory.createServizioType();&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
               &amp;&amp;(attributo.valoreAttributo  == 'TLC8' || attributo.valoreAttributo  == 'TLC9'))&#xD;
			{&#xD;
				arrCodiceServizio.codiceServizio = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		DeterminaTipologiaONTRequest.servizio.add(arrCodiceServizio);&#xD;
    }&#xD;
&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
