    <xpdl2:WorkflowProcess Id="_C2RtwJCFEeaEm-ktY1iisg" xpdExt:DisplayName="ValidateNotification" Name="ValidateNotification">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_Jl4ZUJCFEeaEm-ktY1iisg" xpdExt:DisplayName="StateMachineValidationRequest" Name="StateMachineValidationRequest">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.StateMachine.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StateMachineStateMachineValidationRequestType"/>
          </xpdl2:DataType>
        </xpdl2:DataField>
      </xpdl2:DataFields>
