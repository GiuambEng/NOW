                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="ServiziOpzAutogenerati">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.serviziOpz</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_7l7-sF-KEeq9DrMHh8xhhw" OperationName="DeterminaServiziOpzionaliAutogenerati">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceFormaliPortTypeSOAP" ServiceName="BPM_CheckServiceFormaliPortType">
                    <xpdl2:EndPoint EndPointType="WSDL">
                      <xpdl2:ExternalReference location="BPM_CheckServiceFormali_v1.wsdl"/>
                    </xpdl2:EndPoint>
                  </xpdl2:Service>
                </xpdl2:WebServiceOperation>
