        <xpdl2:Activity Id="_zKyHQn5KEeq-wM1YTxex-Q" Name="AreaDiCantiere" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Area Di Cantiere" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_M6rz8H5LEeq-wM1YTxex-Q">
                  <xpdExt:InputMappings MapperContext="InputToService" MappingDirection="IN">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="InputToService.DataMapperContent" Direction="IN" Formal="input">
                        <xpdl2:Actual ScriptGrammar="JavaScript">DeterminaAreaDiCantiereRequest</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:InputMappings>
                </xpdl2:MessageIn>
                <xpdl2:MessageOut Id="_M6rz8X5LEeq-wM1YTxex-Q">
                  <xpdExt:OutputMappings MapperContext="OutputFromService" MappingDirection="OUT">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="LavorazioneRichiesta.areaDiCantiere">
                        <xpdl2:Actual ScriptGrammar="JavaScript">output.areaDiCantiere</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
