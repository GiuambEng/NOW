            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_bFPdoUqJEeeLb_9qS8dGSQ" Width="96.0">
              <xpdl2:Coordinates XCoordinate="231.0" YCoordinate="194.0"/>
            </xpdl2:NodeGraphicsInfo>
