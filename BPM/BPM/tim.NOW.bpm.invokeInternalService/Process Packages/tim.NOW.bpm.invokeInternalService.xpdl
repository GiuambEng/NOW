                <xpdExt:PortTypeOperation PortTypeName="CodiceOrdineTIPortType" OperationName="GenerazioneCodiceOrdineTI">
                  <xpdExt:ExternalReference location="GenerazioneCodiceOrdineTI_concrete_v.1.2.wsdl"/>
