    <xpdl2:WorkflowProcess Id="_IByycPK3EeqLdswaMl47yQ" xpdExt:XpdModelType="ServiceProcess" xpdExt:DisplayName="DeterminaServiziOpzionaliAutogenerati_C01M02F35" Name="DeterminaServiziOpzionaliAutogenerati_C01M02F35">
      <xpdl2:ProcessHeader/>
      <xpdl2:DataFields>
        <xpdl2:DataField Id="_UwgEQPK4EeqLdswaMl47yQ" xpdExt:DisplayName="EseguiControllo" Name="EseguiControllo" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:BasicType Type="BOOLEAN"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
        </xpdl2:DataField>
        <xpdl2:DataField Id="_S5LqcF7REe-9MI2q9akHXw" xpdExt:DisplayName="DeterminaServiziOpzionaliAutogeneratiRequest" Name="DeterminaServiziOpzionaliAutogeneratiRequest" ReadOnly="false">
          <xpdl2:DataType>
            <xpdl2:ExternalReference location="com.tim.NOW.xsd.ControlliFormali.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.ControlliFormaliDeterminaServiziOpzionaliAutogenerati_RequestType"/>
          </xpdl2:DataType>
          <xpdl2:InitialValue/>
