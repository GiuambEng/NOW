          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">RicalcolaProfiloTecnicoRequest = com_tim_NOW_xsd_GenericEnrichment_Factory.createRicalcolaProfiloTecnicoLinea_RequestType();&#xD;
&#xD;
RicalcolaProfiloTecnicoRequest.caratteristica = localRequest.caratteristica;&#xD;
RicalcolaProfiloTecnicoRequest.consistenzaDati = ConsistenzaDati;&#xD;
RicalcolaProfiloTecnicoRequest.idRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
RicalcolaProfiloTecnicoRequest.lavorazione = String(localRequest.lavorazione);&#xD;
RicalcolaProfiloTecnicoRequest.offerta = String(localRequest.offerta);&#xD;
&#xD;
var i = 0;&#xD;
while(RicalcolaProfiloTecnicoRequest.profiloTecnicoLinea == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(RicalcolaProfiloTecnicoRequest.profiloTecnicoLinea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROFILOTECNICOLINEA)&#xD;
			{&#xD;
				RicalcolaProfiloTecnicoRequest.profiloTecnicoLinea = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
