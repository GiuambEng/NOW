          <xpdl2:Performers>
            <xpdl2:Performer>_GmyyBJCFEeaEm-ktY1iisg</xpdl2:Performer>
          </xpdl2:Performers>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="81.0" LaneId="_C2RtyZCFEeaEm-ktY1iisg" Width="109.0">
              <xpdl2:Coordinates XCoordinate="330.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">StateMachineValidationRequest = com_tim_NOW_xsd_StateMachine_Factory.createStateMachineValidationRequestType();&#xD;
if (ManageNotificationDTU.EVENTO_NOTIFICA!=null)&#xD;
{&#xD;
	StateMachineValidationRequest.EVENTO_NOTIFICA = ScriptUtil.copy(ManageNotificationDTU.EVENTO_NOTIFICA);&#xD;
}&#xD;
StateMachineValidationRequest.codProcsoNoFile = ManageNotificationDTU.codProcsoNoFile;&#xD;
StateMachineValidationRequest.idEsecProcsoNoFile = ManageNotificationDTU.idEsecProcsoNoFile;&#xD;
StateMachineValidationRequest.idRichiesta = ManageNotificationDTU.ID_RICHIESTA;&#xD;
StateMachineValidationRequest.idEventoOrdnNowWhls = ManageNotificationDTU.idEventoOrdnNowWhls;&#xD;
StateMachineValidationRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
StateMachineValidationRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
StateMachineValidationRequest.statoRichiestaNow = it_telecomitalia_it_NOW_casedata_v1_StatoNOWEnumeration.get(String(localRequest.statoRichiestaNOW));&#xD;
StateMachineValidationRequest.statoRichiestaOlo = it_telecomitalia_it_NOW_casedata_v1_StatoOLOEnumeration.get(String(localRequest.statoRichiestaOLO));&#xD;
StateMachineValidationRequest.statoRichiestaPrecNow = it_telecomitalia_it_NOW_casedata_v1_StatoNOWEnumeration.get(String(localRequest.statoRichiestaPrecedNOW));&#xD;
&#xD;
if(localRequest.flagOpereSpeciali != null)&#xD;
{&#xD;
	StateMachineValidationRequest.flagOpereSpeciali = com_tim_NOW_xsd_StateMachine_FlagOpereSpecialiType.get(localRequest.flagOpereSpeciali);&#xD;
}&#xD;
&#xD;
if(localRequest.tipologiaScenario != null)&#xD;
{&#xD;
	StateMachineValidationRequest.scenario = it_telecomitalia_it_NOW_casedata_v1_TipologiaScenarioEnumeration.get(String(localRequest.tipologiaScenario));&#xD;
}&#xD;
&#xD;
if(AnnullametoAutomatico!= null){&#xD;
	StateMachineValidationRequest.annullamentoAutomatico = AnnullametoAutomatico;&#xD;
}&#xD;
&#xD;
if(localRequest.IDPreventivo!= null &amp;&amp; localRequest.IDPreventivo!=&quot;&quot;){&#xD;
	StateMachineValidationRequest.IDPreventivo = localRequest.IDPreventivo;&#xD;
}&#xD;
&#xD;
var DataTrovata = false;&#xD;
var OffertaTrovata = false;&#xD;
var i = 0;&#xD;
&#xD;
// VALORIZZAZIONE INPUT DALL'ORDINE&#xD;
while((!DataTrovata || !OffertaTrovata) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var comp = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSOSPENSIONEOPERESPECIALI)&#xD;
	{&#xD;
		var j=0;&#xD;
		&#xD;
		while(!DataTrovata &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATASOSPENSIONE)&#xD;
			{&#xD;
				StateMachineValidationRequest.dataSospensione = attr.valoreAttributo;&#xD;
				DataTrovata = true;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	//SM_8475 INVIO OFFERTA DONATING PER MIGRAZIONI ALLA MACCHINA A STATI&#xD;
	else if(comp.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
		 &amp;&amp; String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		&#xD;
		while(!OffertaTrovata &amp;&amp; j&lt;comp.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attr = comp.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
			{&#xD;
				StateMachineValidationRequest.offertaDonating = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(attr.valoreAttributo));&#xD;
				OffertaTrovata = true;&#xD;
			}&#xD;
			&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//SM_9292&#xD;
if(localRequest.disaggregato == 'S' || localRequest.disaggregato == 'Y')&#xD;
{&#xD;
	StateMachineValidationRequest.flagDisaggregazione = 'Y';&#xD;
}&#xD;
&#xD;
//RU_1393&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
   &amp;&amp; localRequest.gestioneAutonoma != null &amp;&amp; localRequest.gestioneAutonoma != &quot;&quot;)&#xD;
{&#xD;
	//SM_11149 in caso di exGestioneAutonoma, GestioneAutonoma N &#xD;
	if(localRequest.exGestioneAutonoma != null &amp;&amp; localRequest.exGestioneAutonoma != '')&#xD;
	{&#xD;
		StateMachineValidationRequest.gestioneAutonoma = 'N';&#xD;
	}&#xD;
	else &#xD;
	{&#xD;
		StateMachineValidationRequest.gestioneAutonoma = localRequest.gestioneAutonoma;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">&#xD;
	&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA = ScriptUtil.copy(StateMachineValidationResponse.EVENTO_NOTIFICA);&#xD;
&#xD;
&#xD;
&#xD;
ManageNotificationDTU.ARRICCHIMENTI.clear();&#xD;
&#xD;
for(var i = 0; i &lt; StateMachineValidationResponse.ARRICCHIMENTI.size(); i++)&#xD;
{&#xD;
	var ARRICCHIMENTItemp = ScriptUtil.copy(StateMachineValidationResponse.ARRICCHIMENTI.get(i));&#xD;
	var ARRICCHIMENTINew = com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_Factory.createArricchimentoType();&#xD;
	&#xD;
	if(ARRICCHIMENTItemp.dettaglioAssetElement != null)&#xD;
	{&#xD;
		ARRICCHIMENTINew.dettaglioAssetElement = ARRICCHIMENTItemp.dettaglioAssetElement;&#xD;
	}&#xD;
	if(ARRICCHIMENTItemp.dettaglioOrdineElement.size() > 0)&#xD;
	{&#xD;
		ARRICCHIMENTINew.dettaglioOrdineElement.addAll(ARRICCHIMENTItemp.dettaglioOrdineElement);&#xD;
	}&#xD;
	if(ARRICCHIMENTItemp.referenteElement != null)&#xD;
	{&#xD;
		ARRICCHIMENTINew.referenteElement = ARRICCHIMENTItemp.referenteElement;&#xD;
	}&#xD;
	if(ARRICCHIMENTItemp.sedeElement != null)&#xD;
	{&#xD;
		ARRICCHIMENTINew.sedeElement = ARRICCHIMENTItemp.sedeElement;&#xD;
	}&#xD;
	var Arricchimento = com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_Factory.createArricchimenti_Type();&#xD;
	Arricchimento.arricchimento = ARRICCHIMENTINew;&#xD;
	Arricchimento.operation = com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.CREATE;&#xD;
	ManageNotificationDTU.ARRICCHIMENTI.add(ScriptUtil.copy(Arricchimento));&#xD;
}&#xD;
ManageNotificationDTU.STATO_SUCCESSIVO = StateMachineValidationResponse.STATO_SUCCESSIVO;&#xD;
&#xD;
&#xD;
if(StateMachineValidationResponse.ESITO_VALIDAZIONE == com_tim_NOW_xsd_StateMachine_EsitoValidazioneType.KO){&#xD;
	Process.auditLog(&quot;notifica scartata per esito validazione KO, idAnagrafica causale:&quot;+ManageNotificationDTU.ID_ANAGRAFICA_CAUSALE);&#xD;
}&#xD;
&#xD;
EsitoValidazioneStateMachine = String(StateMachineValidationResponse.ESITO_VALIDAZIONE);&#xD;
&#xD;
if(StateMachineValidationResponse.IDConsuntivo != null &amp;&amp; StateMachineValidationResponse.IDConsuntivo != &quot;&quot;){&#xD;
	IDConsuntivo = StateMachineValidationResponse.IDConsuntivo;&#xD;
	//localRequest.IDConsuntivo = StateMachineValidationResponse.IDConsuntivo;&#xD;
}&#xD;
&#xD;
if(StateMachineValidationResponse.IDPreventivo != null &amp;&amp; StateMachineValidationResponse.IDPreventivo != &quot;&quot;){&#xD;
	IDPreventivo = StateMachineValidationResponse.IDPreventivo;&#xD;
	//localRequest.IDPreventivo = StateMachineValidationResponse.IDPreventivo;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
      </xpdl2:Activities>
      <xpdl2:Transitions>
        <xpdl2:Transition Id="_DqYEMJCFEeaEm-ktY1iisg" xpdExt:DisplayName="" Name="" From="_FmzUoJCFEeaEm-ktY1iisg" To="_C2Rty5CFEeaEm-ktY1iisg">
          <xpdl2:ConnectorGraphicsInfos>
            <xpdl2:ConnectorGraphicsInfo BorderColor="0,0,128" ToolId="XPD.ConnectionInfo"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.LabelAnchorPosition"/>
            <xpdl2:ConnectorGraphicsInfo ToolId="XPD.StartAnchorPosition"/>
          </xpdl2:ConnectorGraphicsInfos>
