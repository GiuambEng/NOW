            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">IDRisorsaRequest = com_tim_NOW_xsd_GenerateIDResource_Factory.createIDRisorsaInputType();&#xD;
IDRisorsaRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
IDRisorsaRequest.lavorazione = String(localRequest.lavorazione);&#xD;
IDRisorsaRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);&#xD;
IDRisorsaRequest.codiceOLO = localRequest.codificaOLONOW; // RU_1058&#xD;
IDRisorsaRequest.prefissoDistrettuale = localRequest.ordine.distretto; //Viene sovrascritto in alcune casistiche (vedi continuo del codice)&#xD;
&#xD;
var foundCLLICENTRALE = false;  //RU_1180&#xD;
var foundNOMEMACROAREA = false; //RU_1180&#xD;
var foundCODICECLLI = false;  &#xD;
var i=0;&#xD;
&#xD;
//RU_1058 - valorizzazione CODICECLLI&#xD;
if(String(localRequest.offerta).slice(0,4) == &quot;VLAN&quot;&#xD;
   ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP)&#xD;
{&#xD;
	while(!foundCODICECLLI &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{		&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(String(dettaglio.nomeComponente).slice(0,8) == &quot;RACCOLTA&quot;)&#xD;
		{&#xD;
			var j=0;&#xD;
			while(!foundCODICECLLI &amp;&amp; j&lt;dettaglio.attributiDettaglioOrdine.size())&#xD;
			{	&#xD;
				if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI){&#xD;
					IDRisorsaRequest.codiceCLLI = dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato CodiceCLLI: &quot;+IDRisorsaRequest.codiceCLLI);&#xD;
					foundCODICECLLI = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
//RU_1180&#xD;
else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT&#xD;
	 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
     || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{		&#xD;
		var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(dettaglio.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			var j=0;&#xD;
			while((!foundCLLICENTRALE || !foundNOMEMACROAREA) &amp;&amp; j&lt;dettaglio.attributiDettaglioOrdine.size())&#xD;
			{	&#xD;
				if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE&#xD;
				&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT&#xD;
				 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE))&#xD;
				{&#xD;
					IDRisorsaRequest.codiceCLLI = dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato CLLICENTRALE: &quot;+IDRisorsaRequest.codiceCLLI);&#xD;
					foundCLLICENTRALE = true;&#xD;
				}&#xD;
				else if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER&#xD;
					 &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
					 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMOFEEDER)&#xD;
				{&#xD;
					IDRisorsaRequest.codiceCLLI = dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato CLLIPRIMOFEEDER, da passare in CLLICENTRALE: &quot;+IDRisorsaRequest.codiceCLLI);&#xD;
					foundCLLICENTRALE = true;&#xD;
				}&#xD;
				else if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO&#xD;
					 &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
					 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.FEEDERSUCCESSIVO)&#xD;
				{&#xD;
					IDRisorsaRequest.codiceCLLI = dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato CLLIFEEDERSUCCESSIVO, da passare in CLLICENTRALE: &quot;+IDRisorsaRequest.codiceCLLI);&#xD;
					foundCLLICENTRALE = true;&#xD;
				}&#xD;
				else if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA&#xD;
				     &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
					 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMOFEEDER)&#xD;
				{&#xD;
					IDRisorsaRequest.nomeMacroArea = dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo;&#xD;
					foundNOMEMACROAREA = true;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		//RU_1205&#xD;
		else if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FEEDERSUCCESSIVO&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.FEEDERSUCCESSIVO)&#xD;
		{&#xD;
			var FeederSuccessivo = com_tim_NOW_xsd_GenerateIDResource_Factory.createFeederSuccessivoIn();&#xD;
			FeederSuccessivo.IDDettaglioOrdine = dettaglio.IDDettaglioOrdine;&#xD;
			&#xD;
			for(var j=0; j&lt;dettaglio.attributiDettaglioOrdine.size(); j++)&#xD;
			{	&#xD;
				var attributo = dettaglio.attributiDettaglioOrdine.get(j);&#xD;
		&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIFEEDERSUCCESSIVO)&#xD;
				{&#xD;
					FeederSuccessivo.clliFeederSuccessivo = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato CLLICENTRALE: &quot; + FeederSuccessivo.clliFeederSuccessivo + &quot;su componente CLLIFEEDERSUCCESSIVO con IDDettaglioOrdine: &quot; +dettaglio.IDDettaglioOrdine);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			IDRisorsaRequest.feederSuccessivoInput.add(ScriptUtil.copy(FeederSuccessivo));&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS)&#xD;
{&#xD;
	IDRisorsaRequest.numerazioneCondivisa = localRequest.numeroTelefonico;&#xD;
}&#xD;
&#xD;
//recuperiamo il distretto da asset&#xD;
//cerco id risorsa&#xD;
var idAsset =0;&#xD;
idAsset = null;&#xD;
var i=0;&#xD;
	&#xD;
while(idAsset == null &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{		&#xD;
	var dettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if(dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
	||	dettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var j=0;&#xD;
		while(idAsset== null &amp;&amp; j&lt;dettaglio.attributiDettaglioOrdine.size())&#xD;
		{	&#xD;
			if(dettaglio.attributiDettaglioOrdine.get(j).nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET){&#xD;
				idAsset = parseInt(dettaglio.attributiDettaglioOrdine.get(j).valoreAttributo,10);&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
if(idAsset!=null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(idAsset);&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
&#xD;
if(Asset != null&#xD;
&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA)&#xD;
{&#xD;
	//SM_8961: valorizzazione solo per CAMBIOTECNOLOGIA + BITSTREAM o VULA o EASYIPNGAFTTCAB&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB)&#xD;
	{&#xD;
		IDRisorsaRequest.numerazioneCondivisa = Asset.numeroTelefonico;&#xD;
	}&#xD;
	//SM_9893: distretto da utilizzare per CAMBIOTECNOLOGIA FTTH è quello della consistenza&#xD;
	else if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH              //RU_1164&#xD;
         || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
         || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
		 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)   //KIT C06 2025&#xD;
	{&#xD;
		IDRisorsaRequest.prefissoDistrettuale = Asset.distretto;&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
if(Asset != null &amp;&amp; String(Asset.offerta).slice(0, 3) == &quot;SHA&quot;)&#xD;
{&#xD;
	if((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
		|| String(localRequest.offerta).slice(0, 9) == &quot;BITSTREAM&quot;) &amp;&amp; &#xD;
	(localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.ISDN&#xD;
		|| localRequest.ordine.tipologiaLinea == it_telecomitalia_it_NOW_casedata_TipologiaLineaEnumeration.POTS))&#xD;
	{&#xD;
		IDRisorsaRequest.numerazioneCondivisa = Asset.numeroTelefonico;&#xD;
	}&#xD;
}&#xD;
&#xD;
/*if(localRequest.ordine != null &amp;&amp; localRequest.ordine.dettaglioordine != null)&#xD;
{&#xD;
	var i = 0;&#xD;
	while(IDRisorsaRequest.prefissoDistrettuale == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUINDIRIZZOCERT)&#xD;
		{&#xD;
			var j = 0;&#xD;
			while(IDRisorsaRequest.prefissoDistrettuale == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DISTRETTO)&#xD;
				{&#xD;
					IDRisorsaRequest.prefissoDistrettuale = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}*/&#xD;
&#xD;
if(localRequest.offerta != null)&#xD;
{&#xD;
	IDRisorsaRequest.servizio = String(localRequest.offerta);&#xD;
}&#xD;
&#xD;
// RU_918 - serve solo idRisorsaDati, ma è stato aggiunto anche Fonia (ce lo ritroviamo)&#xD;
var idRisorsaDati = &quot;&quot;;&#xD;
idRisorsaDati = null;&#xD;
var idRisorsaFonia = &quot;&quot;;&#xD;
idRisorsaFonia = null;&#xD;
&#xD;
var p = 0;&#xD;
&#xD;
while((idRisorsaFonia == null || idRisorsaDati == null) &amp;&amp; p &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(p);&#xD;
	if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var q = 0;	&#xD;
		while(idRisorsaFonia == null &amp;&amp; q &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(q);	&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				IDRisorsaRequest.idRisorsaFonia = attributo.valoreAttributo;&#xD;
			}	&#xD;
			q++;&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
	{&#xD;
		var q = 0;&#xD;
		while(idRisorsaDati == null &amp;&amp; q &lt; componente.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(q);	&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
			{&#xD;
				IDRisorsaRequest.idRisorsaDati = attributo.valoreAttributo;&#xD;
			}&#xD;
			q++;&#xD;
		}&#xD;
	}&#xD;
	p++;&#xD;
}&#xD;
&#xD;
IDRisorsaRequest.strutturaRichiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//RU_914: aggiunta attributo IDRISORSALNA.&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; localRequest.ordine.tipologiaSottolav== it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.DECREMENTONP &#xD;
	&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULL &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVA &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEAATTIVANP &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATI &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVA &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEAATTIVANP&#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLU &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVA &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEAATTIVANP &#xD;
	  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
{			&#xD;
	var data = DateTimeUtil.createDatetime();&#xD;
	var listaValoreOrdine = DataUtil.createList();&#xD;
	var newAttr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var compOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(compOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot; &amp;&amp; compOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.A)&#xD;
		{&#xD;
			Process.auditLog(&quot;Valorizzazione IDRISORSALNA.&quot;);&#xD;
			newAttr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			newAttr.created = data;&#xD;
			newAttr.lastUpdate = data;&#xD;
			newAttr.operatore = localRequest.operatore;&#xD;
			newAttr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			newAttr.IDDettaglioOrdine = compOrdine.IDDettaglioOrdine;&#xD;
			&#xD;
			newAttr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSALNA;&#xD;
			newAttr.valoreAttributo = localRequest.IDRisorsa;&#xD;
			compOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(newAttr));&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//RU_1058: arricchimento IDRISORSA per ATTIVAZIONE e offerte VLANNGA, VLANGBE e VLANVULA&#xD;
if(localRequest != null &amp;&amp; localRequest.ordine != null&#xD;
    &amp;&amp; ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
       &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLAN&#xD;
            ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANNGA&#xD;
            ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VLANVULA&#xD;
		    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VP&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON       //RU_1150: aggiunte offerte GPON&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR    //RU_1581&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR    //RU_1581&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT          //RU_1180&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM		//RU_1450&#xD;
			||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FWAITALIA1GIGASARDEGNA   //RU_1475&#xD;
			||(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CREAZIONECANALEFEEDER)))&#xD;
		//RIENTRI DEL82		&#xD;
		|| (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
			&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM &#xD;
			&amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;))&#xD;
		   &#xD;
	)&#xD;
{&#xD;
	var foundIDRISORSA = false;&#xD;
	var foundIDRISORSARaccoltaVLANMulticast = false; //RU_1180&#xD;
	var foundIDRISORSAFeeder = false;                //Task #34913 (RU_1180)&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANNGA&#xD;
           ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANGBE&#xD;
           ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANVULA&#xD;
		   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP&#xD;
		   ||String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)        //RU_1150: aggiunto ACCESSO per GPON&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
				{&#xD;
					foundIDRISORSA = true;&#xD;
					attributo.valoreAttributo = localRequest.IDRisorsa;   //in uscita da GenerateIDResource&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo IDRISORSA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
&#xD;
			if(!foundIDRISORSA)&#xD;
			{&#xD;
				var ora = DateTimeUtil.createDatetime();&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				&#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
				attributo.created = ora;&#xD;
				attributo.lastUpdate = ora;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attributo.operatore = componente.operatore;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.valoreAttributo = localRequest.IDRisorsa;   //in uscita da GenerateIDResource&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato attributo IDRISORSA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
		//RU_1180: IDRISORSA di RACCOLTAVLANMULTICAST&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVLANMULTICAST&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMOFEEDER)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA&#xD;
				   &amp;&amp; IDRisorsaVLANMulticast != null)&#xD;
				{&#xD;
					foundIDRISORSARaccoltaVLANMulticast = true;&#xD;
					attributo.valoreAttributo = IDRisorsaVLANMulticast;&#xD;
					Process.auditLog(&quot;Trovato attributo IDRISORSA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				//Task #34913 (RU_1180)&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER)&#xD;
				{&#xD;
					foundIDRISORSAFeeder = true;&#xD;
					attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
					Process.auditLog(&quot;Trovato attributo IDRISORSAFEEDER &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			var ora = DateTimeUtil.createDatetime();&#xD;
			var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
			attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
			attributo.created = ora;&#xD;
			attributo.lastUpdate = ora;&#xD;
			attributo.operatore = componente.operatore;&#xD;
			attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
&#xD;
			if(!foundIDRISORSARaccoltaVLANMulticast &amp;&amp; IDRisorsaVLANMulticast != null)&#xD;
			{	&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
				attributo.valoreAttributo = IDRisorsaVLANMulticast;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDRISORSA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
			&#xD;
			//Task #34913 (RU_1180)&#xD;
			if(!foundIDRISORSAFeeder)&#xD;
			{&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSAFEEDER;&#xD;
				attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				Process.auditLog(&quot;Creato attributo IDRISORSAFEEDER&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
		//RU_1205: IDRISORSA per le componenti FEEDERSUCCESSIVO&#xD;
		else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.FEEDERSUCCESSIVO&#xD;
		        &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
				&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.FEEDERSUCCESSIVO)&#xD;
		{&#xD;
			var foundIDRISORSAFEEDERSUCC = false;&#xD;
			var IDRISORSAFEEDERSUCC = &quot;&quot;;&#xD;
			IDRISORSAFEEDERSUCC = null;&#xD;
			&#xD;
			//Ciclo su array restituito dal servizio per trovare la componente corrispondente di FEEDERSUCCESSIVO&#xD;
			for(var k=0; k&lt;FeederSuccessivoOutput.size(); k++)&#xD;
			{&#xD;
				var currentFeederSuccessivo = FeederSuccessivoOutput.get(k);&#xD;
				&#xD;
				if(currentFeederSuccessivo.IDDettaglioOrdine == componente.IDDettaglioOrdine)&#xD;
				{&#xD;
					for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA)&#xD;
						{&#xD;
							foundIDRISORSAFEEDERSUCC = true;&#xD;
							attributo.valoreAttributo = currentFeederSuccessivo.IDRisorsaFeeder;&#xD;
							&#xD;
							Process.auditLog(&quot;Trovato attributo IDRISORSA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
						}&#xD;
					}&#xD;
					&#xD;
					if(!foundIDRISORSAFEEDERSUCC &amp;&amp; currentFeederSuccessivo.IDRisorsaFeeder != null)&#xD;
					{	&#xD;
						var ora = DateTimeUtil.createDatetime();&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
						attributo.created = ora;&#xD;
						attributo.lastUpdate = ora;&#xD;
						attributo.operatore = componente.operatore;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSA;&#xD;
						attributo.valoreAttributo = currentFeederSuccessivo.IDRisorsaFeeder;&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
						&#xD;
						Process.auditLog(&quot;Creato attributo IDRISORSA&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
