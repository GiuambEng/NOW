            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">CalcoloRemoteIDRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createCalcoloRemoteID_RequestType();&#xD;
&#xD;
CalcoloRemoteIDRequest.idRichiesta = localRequest.IDRichiestaOLO;&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.ordine.tipologiaLinea != null)&#xD;
{&#xD;
	CalcoloRemoteIDRequest.tipoLinea = String(localRequest.ordine.tipologiaLinea);&#xD;
}&#xD;
else&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{	&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var h=0; h&lt;componente.attributiDettaglioOrdine.size(); h++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
					&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
				{&#xD;
					CalcoloRemoteIDRequest.tipoLinea = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
CalcoloRemoteIDRequest.codiceOlo = localRequest.codificaOLONOW;&#xD;
&#xD;
//Autoindotti&#xD;
if((localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot; || localRequest.codiceTrasformazione == &quot;TNAKED_COND&quot;)&#xD;
	&amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
	&amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH                  //RU_1164: aggiunte SEMI***&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
	   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH))&#xD;
{&#xD;
	CalcoloRemoteIDRequest.numeroTelefonico = localRequest.IDRisorsa;&#xD;
}&#xD;
&#xD;
//in tutti gli altri casi&#xD;
else&#xD;
{&#xD;
	if((CalcoloRemoteIDRequest.tipoLinea).toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
	{&#xD;
		CalcoloRemoteIDRequest.numeroTelefonico = localRequest.ordine.numeroFittizio;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		CalcoloRemoteIDRequest.numeroTelefonico = localRequest.ordine.numeroTelefonico;&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
