	if(Asset.CLLI != null &amp;&amp; Asset.CLLI != &quot;&quot;)&#xD;
	{&#xD;
		DeterminaCLLIJiveInput.CLLIConsFonia = Asset.CLLI;&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
