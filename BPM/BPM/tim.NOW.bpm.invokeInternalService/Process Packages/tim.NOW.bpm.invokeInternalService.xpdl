        <xpdl2:Activity Id="_ySy2IShjEfGZGdu9XnBqbQ" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_e6pVsChjEfGZGdu9XnBqbQ" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="47.0" LaneId="_780lEShbEfGZGdu9XnBqbQ" Width="58.0">
              <xpdl2:Coordinates XCoordinate="46.0" YCoordinate="155.0"/>
