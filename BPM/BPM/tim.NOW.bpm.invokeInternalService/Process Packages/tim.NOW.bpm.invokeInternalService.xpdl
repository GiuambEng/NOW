            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="168,186,200" Height="64.0" LaneId="_YW-x8qA7EfCibcZH9ajx6Q" Width="96.0">
              <xpdl2:Coordinates XCoordinate="416.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
