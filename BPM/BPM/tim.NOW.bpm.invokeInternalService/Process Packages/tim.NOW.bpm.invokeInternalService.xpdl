                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="true" Direction="OUT" Formal="parameters.IDRisorsaVLANMulticast">
                      <xpdl2:Actual ScriptGrammar="JavaScript">IDRisorsaVLANMulticast</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping xpdExt:TargetPrimitiveProperty="false" Direction="OUT" Formal="parameters.feederSuccessivoOutput">
                      <xpdl2:Actual ScriptGrammar="JavaScript">FeederSuccessivoOutput</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xpdExt:Alias="_ci6vEDZdEeeA_McHtDbYBA" OperationName="GenerateIDResource">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="IDRisorsaPortTypeSOAP" ServiceName="IDRisorsaPortType">
