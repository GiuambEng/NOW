            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaModelloDiServizioRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaModelloDiServizioPerValidazione_RequestType();&#xD;
&#xD;
DeterminaModelloDiServizioRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
DeterminaModelloDiServizioRequest.codOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
DeterminaModelloDiServizioRequest.offerta = String(localRequest.offerta);&#xD;
//SM_11806&#xD;
DeterminaModelloDiServizioRequest.lavorazione = String(localRequest.lavorazione);&#xD;
&#xD;
//SM_11864&#xD;
var foundEncapsulation = false;&#xD;
var foundUservlantagging = false;&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION)&#xD;
			{&#xD;
				DeterminaModelloDiServizioRequest.encapsulation = attributo.valoreAttributo;&#xD;
				foundEncapsulation = true;&#xD;
			}&#xD;
			&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING)&#xD;
			{&#xD;
				DeterminaModelloDiServizioRequest.uservlanTagging = attributo.valoreAttributo;&#xD;
				foundUservlantagging = true;&#xD;
			}&#xD;
		}&#xD;
    }	&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) //SM_11787&#xD;
	{&#xD;
		var arrUservlan = com_tim_NOW_xsd_ControlliFormali_Factory.createUserVlanType();		&#xD;
	&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
		 &#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGMULTICAST)&#xD;
			{&#xD;
				arrUservlan.flagMulticast = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID)&#xD;
			{&#xD;
				arrUservlan.uservlanID  = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		if(EsistenzaVLANMigDel82Response != null &#xD;
	       &amp;&amp; EsistenzaVLANMigDel82Response.vlan != null &amp;&amp; EsistenzaVLANMigDel82Response.vlan.size()>0)&#xD;
		{&#xD;
			for(var k=0; k&lt;EsistenzaVLANMigDel82Response.vlan.size(); k++)&#xD;
			{&#xD;
				var currentEsistenza = EsistenzaVLANMigDel82Response.vlan.get(k);&#xD;
				&#xD;
				if(currentEsistenza.IDDettaglioOrdine == componente.IDDettaglioOrdine)&#xD;
				{&#xD;
					if(currentEsistenza.TIPO_BANDA != null)&#xD;
					{&#xD;
						arrUservlan.tipoBanda = currentEsistenza.TIPO_BANDA;&#xD;
					}&#xD;
					if(currentEsistenza.TIPO_COS != null)&#xD;
					{&#xD;
						arrUservlan.tipoCos = currentEsistenza.TIPO_COS;&#xD;
					}				&#xD;
					if(currentEsistenza.BMC_LIGHT != null)&#xD;
					{&#xD;
						arrUservlan.bmcLight = currentEsistenza.BMC_LIGHT;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(EsistenzaVLANOutput != null &amp;&amp; EsistenzaVLANOutput.size()>0)&#xD;
		{&#xD;
			for(var k=0; k&lt;EsistenzaVLANOutput.size(); k++)&#xD;
			{&#xD;
				var currentEsistenza = EsistenzaVLANOutput.get(k);&#xD;
				&#xD;
				if(currentEsistenza.IDDettaglioOrdine == componente.IDDettaglioOrdine)&#xD;
				{&#xD;
					if(currentEsistenza.TIPO_BANDA != null)&#xD;
					{&#xD;
						arrUservlan.tipoBanda = currentEsistenza.TIPO_BANDA;&#xD;
					}&#xD;
					if(currentEsistenza.TIPO_COS != null)&#xD;
					{&#xD;
						arrUservlan.tipoCos = currentEsistenza.TIPO_COS;&#xD;
					}&#xD;
					if(currentEsistenza.BMC_LIGHT != null)&#xD;
					{&#xD;
						arrUservlan.bmcLight = currentEsistenza.BMC_LIGHT;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		DeterminaModelloDiServizioRequest.userVlan.add(arrUservlan);&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_11806&#xD;
if (ConsistenzaDati != null)&#xD;
{&#xD;
	DeterminaModelloDiServizioRequest.idAsset = ConsistenzaDati.IDAsset;&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
	&#xD;
		var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
		&#xD;
		if(String(componenteAsset.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION&#xD;
				&amp;&amp; !foundEncapsulation)																										//SM_11864&#xD;
				{&#xD;
					DeterminaModelloDiServizioRequest.encapsulation = attributoAsset.valoreAttributo;&#xD;
				}&#xD;
				&#xD;
				else if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLAN1TAGGING&#xD;
				&amp;&amp; !foundUservlantagging)																									//SM_11864&#xD;
				{&#xD;
					DeterminaModelloDiServizioRequest.uservlanTagging = attributoAsset.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
