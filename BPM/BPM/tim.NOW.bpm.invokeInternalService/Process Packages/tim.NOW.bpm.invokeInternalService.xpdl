        <xpdl2:Activity Id="_C_2VgEqKEeeLb_9qS8dGSQ" Name="Setinput" xpdExt:Visibility="Private" xpdExt:DisplayName="Set input">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">input = com_tim_NOW_xsd_BPMEnrichment_Factory.createCodFatturazione_RequestType();&#xD;
&#xD;
input.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
input.partitaIVA = localRequest.ordine.PIVA;&#xD;
input.codiceFiscale = localRequest.ordine.CF;&#xD;
&#xD;
var i=0;&#xD;
var accessoTrovato = false;&#xD;
var consistenzaFoniaTrovata = false; //SM_8917&#xD;
var offertaConsistenza = ''; 		 //SM_8917&#xD;
var bandaServizioConsistenza = '';   //SM_8917&#xD;
var canaliTotali = '';				 //SM_8917&#xD;
var canaliBidirezionali = '';		 //SM_8917&#xD;
var canaliEntranti = '';			 //SM_8917&#xD;
while((!accessoTrovato || !consistenzaFoniaTrovata) &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		accessoTrovato = true;&#xD;
		&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA){&#xD;
				input.strutturaLinea = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA){&#xD;
				input.tipoLinea = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ACCESSONUMERICO){&#xD;
				input.accessoNumerico = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
				input.direzionalita = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI){&#xD;
				input.numAggiuntivi  = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.QUANTITACANALI){&#xD;
				input.quantitaCanali = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SELEZIONEPASSANTE){&#xD;
				input.selezionePassante = attributo.valoreAttributo;&#xD;
			}&#xD;
			//RU_874&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
			{&#xD;
				input.bandaServizio = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		//SM_8475 e SM_8489&#xD;
		if((input.strutturaLinea == 'GNR' || input.strutturaLinea == 'PBX') &amp;&amp; input.quantitaCanali == null)&#xD;
		{&#xD;
			input.quantitaCanali = input.numAggiuntivi;&#xD;
		}&#xD;
	}&#xD;
	//SM_8917&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		consistenzaFoniaTrovata = true;&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
			{&#xD;
				offertaConsistenza = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDASERVIZIO)&#xD;
			{&#xD;
				bandaServizioConsistenza = attributo.valoreAttributo;&#xD;
			}&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIBIDIREZIONALI)&#xD;
			{&#xD;
				canaliBidirezionali = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIENTRANTI)&#xD;
			{&#xD;
				canaliEntranti = attributo.valoreAttributo;&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALITOTALI)&#xD;
			{&#xD;
				canaliTotali = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//SM_8917&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE &amp;&amp; &#xD;
	String(offertaConsistenza).slice(0,3) == &quot;WLR&quot; &amp;&amp; bandaServizioConsistenza == &quot;ISDN PRA&quot;)&#xD;
{&#xD;
	input.canaliEntranti = canaliEntranti;&#xD;
	input.canaliBidirezionali = canaliBidirezionali;&#xD;
	input.canaliTotali = canaliTotali;&#xD;
}&#xD;
else &#xD;
{&#xD;
	//RU_874 DTUFONIA per canalibidirezionali, canalientranti, canali totali&#xD;
	var i=0;&#xD;
	var dtuFoniaTrovato = false;&#xD;
	while(!dtuFoniaTrovato &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);	&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUFONIA)&#xD;
		{&#xD;
			dtuFoniaTrovato = true;&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIBIDIREZIONALI){&#xD;
					input.canaliBidirezionali = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIENTRANTI){&#xD;
					input.canaliEntranti = attributo.valoreAttributo;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALITOTALI){&#xD;
					input.canaliTotali = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Input CodFatturazione: IDRichiestaOLO=&quot;+input.idRichiestaOlo+&quot;,partitaIVA=&quot;+input.partitaIVA+&quot;,codiceFiscale=&quot;+input.codiceFiscale+&quot;,strutturaLinea=&quot;+input.strutturaLinea+&quot;,tipoLinea=&quot;+input.tipoLinea+&quot;,accessoNumerico=&quot;+input.accessoNumerico+&quot;,direzionalita=&quot;+input.direzionalita+&quot;,numAggiuntivi=&quot;+input.numAggiuntivi+&quot;,quantitaCanali=&quot;+input.quantitaCanali+&quot;,selezionePassante=&quot;+input.selezionePassante+&quot;,bandaservizio=&quot;+input.bandaServizio+&quot;,canaliBidirezionali=&quot;+input.canaliBidirezionali+&quot;,canaliEntranti=&quot;+input.canaliEntranti+&quot;,canalitotali=&quot;+input.canaliTotali);</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
