        <xpdl2:Activity Id="_n75AYJCDEeaEm-ktY1iisg" Name="Configurazioneattributiperofferta" xpdExt:Visibility="Private" xpdExt:DisplayName="Configurazione attributi per offerta">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
||&#xD;
	localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE){&#xD;
	listaComponenti.add(&quot;ATMVC&quot;);&#xD;
	listaComponenti.add(&quot;ATMVC&quot;);&#xD;
	listaComponenti.add(&quot;ATMVC&quot;);&#xD;
	listaComponenti.add(&quot;ATMVC&quot;);&#xD;
	listaComponenti.add(&quot;ATMVC&quot;);&#xD;
&#xD;
	listaAttributi.add(&quot;MCRDOWN&quot;);&#xD;
	listaAttributi.add(&quot;MCRUP&quot;);&#xD;
	listaAttributi.add(&quot;PCRDOWN&quot;);&#xD;
	listaAttributi.add(&quot;PCRUP&quot;);&#xD;
	listaAttributi.add(&quot;IDPROFILOVC&quot;);&#xD;
}&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOFLAT&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMATMSIMMETRICOHL&#xD;
	|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBESIMMETRICOFLAT)&#xD;
{&#xD;
	listaComponenti.add(&quot;MODEM&quot;);&#xD;
	listaComponenti.add(&quot;MODEM&quot;);&#xD;
	&#xD;
	listaAttributi.add(&quot;CODICEPRODOTTOMODEM&quot;);&#xD;
	listaAttributi.add(&quot;DESCRIZIONE&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_GMWjoZCDEeaEm-ktY1iisg" Width="96.0">
              <xpdl2:Coordinates XCoordinate="497.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_rUhwIJCDEeaEm-ktY1iisg" Name="CreazioneAttributi" xpdExt:Visibility="Private" xpdExt:DisplayName="Creazione Attributi">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest.ordine!= null){&#xD;
	Process.auditLog(&quot;Recuperati &quot;+  GenericEnrichmentResponse.genericEnrichmentResponse.size()+&quot; attributi&quot;);&#xD;
	var listaFlagDiControllo = DataUtil.createList();&#xD;
	for(var i=0; i&lt;listaAttributi.size();i++){&#xD;
		listaFlagDiControllo.add(false);&#xD;
	}&#xD;
&#xD;
	for(var k=0; k&lt;GenericEnrichmentResponse.genericEnrichmentResponse.size();k++){&#xD;
		var attributeTemp = GenericEnrichmentResponse.genericEnrichmentResponse.get(k);&#xD;
		if(attributeTemp.key== null){&#xD;
			Process.auditLog(&quot;Attributo &quot;+k+&quot; key null&quot;);&#xD;
		}&#xD;
		for(var i=0; i&lt;listaAttributi.size();i++){&#xD;
			var attributoConf = listaAttributi.get(i);&#xD;
			if( String(attributeTemp.key) == attributoConf){&#xD;
				//aggiorna ordine&#xD;
				if(listaFlagDiControllo.get(i) == true){&#xD;
					Process.auditLog(&quot;Recuperata valore multiplo per: &quot;+attributoConf+ &quot;Le ripetizioni non saranno inserite, valore: &quot;+attributeTemp.value);&#xD;
				}&#xD;
				else{&#xD;
					listaFlagDiControllo.set(i,true);&#xD;
					var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					nuovoAttributo.IDDettaglioOrdine = 1;&#xD;
					nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					nuovoAttributo.created = localRequest.created;&#xD;
					nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
					nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.get(String(attributeTemp.key));&#xD;
					nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					nuovoAttributo.valoreAttributo = attributeTemp.value;&#xD;
					nuovoAttributo.operatore = localRequest.operatore;&#xD;
					&#xD;
					var aggiornato = true;&#xD;
					for(var j=0; j&lt;localRequest.ordine.dettaglioordine.size(); j++){&#xD;
						var componente = localRequest.ordine.dettaglioordine.get(j);&#xD;
						if(String(componente.nomeComponente) == listaComponenti.get(i)){&#xD;
							if(aggiornato){&#xD;
								Process.auditLog(&quot;Riscontrato piu di un componente dell'ordine candidato all'arricchimento dell'attributo &quot;+String(attributeTemp.key));&#xD;
							}&#xD;
								nuovoAttributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
								componente.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
								aggiornato = true;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
else{&#xD;
	Process.auditLog(&quot;Richiesta priva di ordine, nessun attributo puo essere aggiunto al dettaglio dell'ordine&quot;);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
