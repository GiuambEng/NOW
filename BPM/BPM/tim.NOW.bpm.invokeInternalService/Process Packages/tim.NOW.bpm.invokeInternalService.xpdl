        <xpdl2:Activity Id="_SHwbQV-KEeq9DrMHh8xhhw" Name="StartEvent" xpdExt:DisplayName="Start Event" xpdExt:Implements="_IO4RoF-KEeq9DrMHh8xhhw" xpdExt:Visibility="Public">
          <xpdl2:Event>
            <xpdl2:StartEvent Trigger="None"/>
          </xpdl2:Event>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,128,128" Height="82.0" LaneId="_3f9dQl-JEeq9DrMHh8xhhw" Width="45.0">
              <xpdl2:Coordinates XCoordinate="58.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_XWUQYl_CEeqRPPNVmQCYAw" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">eseguiControllo = false;&#xD;
&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
   || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
   || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB&#xD;
   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT)) //RU_982 - aggiunto GBE&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL&#xD;
				   &amp;&amp; attributo.valoreAttributo == &quot;SI&quot;)&#xD;
				{&#xD;
					eseguiControllo = true;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &#xD;
    &amp;&amp; ConsistenzaDati != null&#xD;
    &amp;&amp; ConsistenzaDati.intermediateAgentFull== &quot;SI&quot;)&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
}&#xD;
&#xD;
//RU_1066: aggiunte nuove casistiche in cui eseguire il controllo&#xD;
else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
             ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
		&amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
		     ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE)&#xD;
		&amp;&amp; OneStep == &quot;Y&quot;)&#xD;
{&#xD;
	var TipologiaLinea = &quot;&quot;;&#xD;
	TipologiaLinea = null;&#xD;
&#xD;
	if(localRequest.ordine != null &amp;&amp; localRequest.ordine.tipologiaLinea != null)&#xD;
	{&#xD;
		TipologiaLinea = String(localRequest.ordine.tipologiaLinea);&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLINEA)&#xD;
					{&#xD;
						TipologiaLinea = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato attributo TIPOLINEA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
					}&#xD;
				}&#xD;
			}	&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(TipologiaLinea != null &amp;&amp; TipologiaLinea.toUpperCase() == &quot;LINEANONFONIA&quot;)&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
//_BUG_40161 esteso controllo per EasyIPUBBFTTCAB , EasyIPUBBFTTH per il calcolo delle credenziali per il Servizio Opzionale A001, a prescindere dal codice ONESTEP&#xD;
else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
             ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
		&amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
			 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB))&#xD;
{&#xD;
	var findA001 = false;&#xD;
&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI)&#xD;
		{		&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
                    &amp;&amp; attributo.valoreAttributo  == 'A001')&#xD;
				{&#xD;
					eseguiControllo = true;&#xD;
				}&#xD;
			}&#xD;
	    }&#xD;
    }&#xD;
}&#xD;
&#xD;
else if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
             ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
        &amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
             ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB))&#xD;
{&#xD;
    if(ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null)&#xD;
    {&#xD;
        AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaDati.IDAsset, 10));&#xD;
        Asset = AssetRef.readAsset();&#xD;
&#xD;
        if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
        {&#xD;
            for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
            {&#xD;
                var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
&#xD;
                if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI&#xD;
                   &amp;&amp; componenteAsset.statoDettaglioAsset == 'ATTIVO')&#xD;
                {&#xD;
                    for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
                    {&#xD;
                        var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
&#xD;
                        if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
                           &amp;&amp; attributoAsset.valoreAttributo == 'A001')&#xD;
                        {&#xD;
                            eseguiControllo = true;&#xD;
                        }&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
}&#xD;
&#xD;
</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_3f9dQl-JEeq9DrMHh8xhhw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="202.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_bjaGcl_DEeqRPPNVmQCYAw">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_zRzhoIVjEeq7xpr857OaVw"/>
                  <xpdl2:TransitionRef Id="_-M_2wcvUEfGeo5HC_7cLFQ"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="43.0" LaneId="_3f9dQl-JEeq9DrMHh8xhhw" Width="41.0">
              <xpdl2:Coordinates XCoordinate="336.0" YCoordinate="132.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_Wj4l0IMMEeqkO5QTv_1sSA" Name="LogicheDiArricchimentoRemoteID" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Logiche Di Arricchimento RemoteID">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if (LavorazioneRichiesta == null) {&#xD;
    LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}&#xD;
&#xD;
//SM_9253&#xD;
if (ConsistenzaDati != null &amp;&amp; ConsistenzaDati.IDAsset != null) {&#xD;
    Process.auditLog(&quot;Arricchimento per Consistenza dati, asset: &quot; + ConsistenzaDati.IDAsset);&#xD;
    Process.auditLog(&quot;Offerta: &quot; + String(localRequest.offerta) + &quot; , tipologiaSottolav: &quot; + localRequest.ordine.tipologiaSottolav);&#xD;
    AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(ConsistenzaDati.IDAsset));&#xD;
    Asset = AssetRef.readAsset();&#xD;
}&#xD;
&#xD;
if ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE ||&#xD;
        localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) //SM_9328&#xD;
    &amp;&amp;&#xD;
    (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS //RU_1543&#xD;
        ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA) &amp;&amp;&#xD;
    LavorazioneRichiesta != null &amp;&amp;&#xD;
    LavorazioneRichiesta.remoteId != null) {&#xD;
&#xD;
    //Verifico INTERMEDIATEAGENTFULL dell'ACCESSO = SI&#xD;
    if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA) //RU_1543&#xD;
    {&#xD;
        var IntermediateAgentRichiesta = false;&#xD;
        var i = 0;&#xD;
&#xD;
        while (!IntermediateAgentRichiesta &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size()) {&#xD;
            var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
            if (String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;) {&#xD;
                for (var h = 0; h &lt; componente.attributiDettaglioOrdine.size(); h++) {&#xD;
                    var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
&#xD;
                    if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL &amp;&amp;&#xD;
                        String(attributo.valoreAttributo) == &quot;SI&quot;) {&#xD;
                        IntermediateAgentRichiesta = true;&#xD;
                        Process.auditLog(&quot;Trovato INTERMEDIATEAGENTFULL nell'ordine: &quot; + attributo.valoreAttributo);&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
            i++;&#xD;
        }&#xD;
    }&#xD;
&#xD;
    //ATTIVAZIONE NGA&#xD;
    //Arricchimento REMOTEID per VULAFTTH, VULAFTTCAB, BITSTREAMNGAFTTH, BITSTREAMNGAFTTCAB&#xD;
    if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS //RU_1543&#xD;
        ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA) {&#xD;
        for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++) {&#xD;
            var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
            if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) {&#xD;
                var IntermediateAgentVLAN = false;&#xD;
                var foundRemoteId = false;&#xD;
&#xD;
                // Recupero condizioni per gli arricchimenti&#xD;
                for (var k = 0; k &lt; EsistenzaVLANOutputArricchimento.size(); k++) {&#xD;
                    var currentEsistenzaVLAN = EsistenzaVLANOutputArricchimento.get(k);&#xD;
&#xD;
                    if (currentEsistenzaVLAN.IDDettaglioOrdine == componente.IDDettaglioOrdine &amp;&amp;&#xD;
                        (String(currentEsistenzaVLAN.INTERMEDIATE_AGENT) == &quot;SI&quot; || String(currentEsistenzaVLAN.INTERMEDIATE_AGENT) == &quot;Y&quot;) &amp;&amp;&#xD;
                        (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS //RU_1543&#xD;
                            ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB)) // RU_966 - REMOTEID SOLO per VULAH&#xD;
                    {&#xD;
                        IntermediateAgentVLAN = true;&#xD;
                        Process.auditLog(&quot;Trovato IntermediateAgentVLAN in currentEsistenzaVLAN&quot;);&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //Arricchimenti&#xD;
                if ((IntermediateAgentRichiesta || IntermediateAgentVLAN) &amp;&amp; LavorazioneRichiesta.remoteId != null) {&#xD;
                    for (var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++) {&#xD;
                        var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID) {&#xD;
                            attributo.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
                            foundRemoteId = true;&#xD;
                            Process.auditLog(&quot;Aggiornato attributo REMOTEID &quot; + attributo.valoreAttributo + &quot; su UserVlan con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    // RU_966 - SE REMOTEID NON ESISTE&#xD;
                    if (!foundRemoteId) {&#xD;
                        var attributoArr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
&#xD;
                        attributoArr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
                        attributoArr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
                        attributoArr.created = DateTimeUtil.createDatetime();&#xD;
                        attributoArr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
                        attributoArr.operatore = &quot;BPM&quot;;&#xD;
                        attributoArr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
                        attributoArr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID;&#xD;
                        attributoArr.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
&#xD;
                        componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoArr));&#xD;
                        Process.auditLog(&quot;Creato attributo REMOTEID &quot; + LavorazioneRichiesta.remoteId + &quot; su UserVlan con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
&#xD;
    //ATTIVAZIONE XDSL&#xD;
    //ARRICCHIMENTO REMOTE ID PER BITSTREAMGBEASIMMETRICOFLAT&#xD;
    //INTERMEDIATEAGENTFULL attestata su SI&#xD;
    if (IntermediateAgentRichiesta &amp;&amp;&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT) {&#xD;
        for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++) {&#xD;
            var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
            if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) {&#xD;
                var foundCvlanid = false;&#xD;
                var foundProtocolloPila = false;&#xD;
                var foundRemoteId = false;&#xD;
&#xD;
                //Verifico condizioni&#xD;
                for (var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++) {&#xD;
                    var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
                    if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA &amp;&amp;&#xD;
                        (attributo.valoreAttributo == &quot;IPoE&quot; || attributo.valoreAttributo == &quot;PPP&quot;)) {&#xD;
                        foundProtocolloPila = true;&#xD;
                        Process.auditLog(&quot;Trovato attributo PROTOCOLLOPILA &quot; + attributo.valoreAttributo + &quot; su GBEVC con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                    } else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID) {&#xD;
                        foundCvlanid = true;&#xD;
                        Process.auditLog(&quot;Trovato attributo CVLANID &quot; + attributo.valoreAttributo + &quot; su GBEVC con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                    }&#xD;
&#xD;
                }&#xD;
&#xD;
                //PROTOCOLLOPILA attestata su IPoE oppure PPP e CVLANID non trovata&#xD;
                //Arricchimento REMOTEID&#xD;
                if (foundProtocolloPila &amp;&amp; !foundCvlanid) {&#xD;
                    for (var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++) {&#xD;
                        var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID) {&#xD;
                            foundRemoteId = true;&#xD;
                            attributo.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
                            Process.auditLog(&quot;Trovato attributo REMOTEID &quot; + attributo.valoreAttributo + &quot; su GBEVC con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    //SE REMOTEID NON ESISTE&#xD;
                    if (!foundRemoteId) {&#xD;
                        var attributoArr = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
&#xD;
                        attributoArr.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
                        attributoArr.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
                        attributoArr.created = DateTimeUtil.createDatetime();&#xD;
                        attributoArr.lastUpdate = DateTimeUtil.createDatetime();&#xD;
                        attributoArr.operatore = &quot;BPM&quot;;&#xD;
                        attributoArr.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
                        attributoArr.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID;&#xD;
                        attributoArr.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
&#xD;
                        componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoArr));&#xD;
                        Process.auditLog(&quot;Creato attributo REMOTEID &quot; + LavorazioneRichiesta.remoteId + &quot; su UserVlan con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
}&#xD;
&#xD;
&#xD;
//VARIAZIONE DATI&#xD;
else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE) {&#xD;
    //RU_966: ARRICCHIMENTO REMOTEID PER VULAFTTH, VULAFTTCAB, BITSTREAMNGAFTTCAB, BITSTREAMNGAFTTH&#xD;
    //RU_982: ARRICCHIMENTO REMOTEID PER BITSTREAMGBEASIMMETRICOFLAT&#xD;
&#xD;
    //verifico che c'è un decremento&#xD;
    var decr = false;&#xD;
    for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++) {&#xD;
        var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
        if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN &amp;&amp; componente.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D) {&#xD;
            decr = true;&#xD;
            Process.auditLog(&quot;Decremento Uservlan = true&quot;);&#xD;
        }&#xD;
    }&#xD;
&#xD;
    if (localRequest != null &amp;&amp; localRequest.ordine != null &amp;&amp;&#xD;
        ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH //RU_966&#xD;
                ||&#xD;
                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB ||&#xD;
                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH) ||&#xD;
            (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT //RU_982&#xD;
                &amp;&amp;&#xD;
                (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC ||&#xD;
                    localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN)))) {&#xD;
&#xD;
        var foundIntermediateagentfull = false;&#xD;
        var foundIntermediateagentfullConsistenza = false;&#xD;
        var foundEncapsulation = false;&#xD;
        var foundEncapsulationConsistenza = false;&#xD;
&#xD;
        var valoreIntermediateagentfull = &quot;&quot;;&#xD;
        var valoreEncapsulation = &quot;&quot;;&#xD;
        var valoreOldEncapsulation = &quot;&quot;;&#xD;
&#xD;
        valoreIntermediateagentfull = null;&#xD;
        valoreEncapsulation = null;&#xD;
        valoreOldEncapsulation = null;&#xD;
&#xD;
&#xD;
        //ATTRIBUTI DELLA COMPONENTE ACCESSO NELL'ORDINE&#xD;
        for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++) {&#xD;
            var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
            if (String(componente.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;) {&#xD;
                for (var h = 0; h &lt; componente.attributiDettaglioOrdine.size(); h++) {&#xD;
                    var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
&#xD;
                    if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.INTERMEDIATEAGENTFULL) {&#xD;
                        foundIntermediateagentfull = true;&#xD;
                        valoreIntermediateagentfull = attributo.valoreAttributo;&#xD;
&#xD;
                        Process.auditLog(&quot;Trovato INTERMEDIATEAGENTFULL nell'ordine: &quot; + attributo.valoreAttributo);&#xD;
                    } else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ENCAPSULATION) {&#xD;
                        foundEncapsulation = true;&#xD;
                        valoreEncapsulation = attributo.valoreAttributo;&#xD;
                        valoreOldEncapsulation = attributo.valoreAttributoOLD;&#xD;
&#xD;
                        Process.auditLog(&quot;Trovato ENCAPSULATION nell'ordine con valore: &quot; + attributo.valoreAttributo + &quot; e valore OLD&quot; + attributo.valoreAttributoOLD);&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
&#xD;
&#xD;
        //ARRICCHIMENTO REMOTEID DI USERVLAN/GBEVC&#xD;
        for (var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++) {&#xD;
            var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
&#xD;
            if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN ||&#xD;
                componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) {&#xD;
                var IntermediateAgentVLAN = false;&#xD;
&#xD;
                var foundRemoteId = false;&#xD;
                var foundSvlancode = false;&#xD;
                var foundCodeVlanSingleTag = false;&#xD;
                var foundCvlanid = false;&#xD;
                var foundProtocolloPila = false;&#xD;
&#xD;
                var AggiungiRemoteidDaC01M02F27 = false;&#xD;
                var AggiungiRemoteidDaConsistenza = false;&#xD;
                var EliminaRemoteidDellaComponente = false;&#xD;
&#xD;
                var valoreRemoteidDaAsset = &quot;&quot;;&#xD;
                var uservlanidOrdine = &quot;&quot;;&#xD;
                var uservlanidAsset = &quot;&quot;;&#xD;
&#xD;
                valoreRemoteidDaAsset = null;&#xD;
                uservlanidOrdine = null;&#xD;
                uservlanidAsset = null;&#xD;
&#xD;
&#xD;
                //ATTRIBUTI DELLA COMPONENTE USERVLAN/GBEVC NELL'ORDINE&#xD;
                for (var h = 0; h &lt; componente.attributiDettaglioOrdine.size(); h++) {&#xD;
                    var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
&#xD;
                    //USERVLAN&#xD;
                    if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN) {&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SVLANCODE) {&#xD;
                            foundSvlancode = true;&#xD;
&#xD;
                            Process.auditLog(&quot;Trovato SVLANCODE nell'ordine&quot; + attributo.valoreAttributo);&#xD;
                        } else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODEVLANSINGLETAG) {&#xD;
                            foundCodeVlanSingleTag = true;&#xD;
&#xD;
                            Process.auditLog(&quot;Trovato CODEVLANSINGLETAG nell'ordine&quot; + attributo.valoreAttributo);&#xD;
                        } else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID) {&#xD;
                            uservlanidOrdine = attributo.valoreAttributo;&#xD;
&#xD;
                            Process.auditLog(&quot;uservlanidAsset: &quot; + uservlanidOrdine);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    //GBEVC&#xD;
                    else if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) {&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID) {&#xD;
                            foundCvlanid = true;&#xD;
                            Process.auditLog(&quot;Trovato CVLANID nell'ordine&quot; + attributo.valoreAttributo);&#xD;
                        } else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROTOCOLLOPILA &amp;&amp;&#xD;
                            (attributo.valoreAttributo == &quot;IPoE&quot; || attributo.valoreAttributo == &quot;PPP&quot;)) {&#xD;
                            foundProtocolloPila = true;&#xD;
                            Process.auditLog(&quot;Trovato PROTOCOLLOPILA nell'ordine&quot; + attributo.valoreAttributo);&#xD;
                        }&#xD;
                    }&#xD;
                }&#xD;
&#xD;
&#xD;
                //CICLO SULL'ASSET&#xD;
                //RECUPERO VALORI DA CONSISTENZA/ASSET PER ARRICCHIMENTO DI REMOTEID &#xD;
                var m = 0;&#xD;
&#xD;
                if (Asset != null) {&#xD;
                    while (valoreRemoteidDaAsset == null &amp;&amp; m &lt; Asset.dettaglioasset.size()) {&#xD;
                        var compAsset = Asset.dettaglioasset.get(m);&#xD;
&#xD;
                        if (compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.USERVLAN ||&#xD;
                            compAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.GBEVC) {&#xD;
                            var appoggioRemoteID = &quot;&quot;;&#xD;
                            appoggioRemoteID = null;&#xD;
&#xD;
                            for (var n = 0; n &lt; compAsset.attributidettaglioasset.size(); n++) {&#xD;
                                var attributoAsset = compAsset.attributidettaglioasset.get(n);&#xD;
&#xD;
                                if (attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID) {&#xD;
                                    appoggioRemoteID = attributoAsset.valoreAttributo;&#xD;
&#xD;
                                    Process.auditLog(&quot;Recuperato dall'Asset valore di REMOTEID: &quot; + attributoAsset.valoreAttributo);&#xD;
                                } else if (attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.USERVLANID ||&#xD;
                                    attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CVLANID) {&#xD;
                                    uservlanidAsset = attributoAsset.valoreAttributo;&#xD;
&#xD;
                                    Process.auditLog(&quot;uservlanidAsset: &quot; + uservlanidAsset);&#xD;
                                }&#xD;
                            }&#xD;
&#xD;
                            if (uservlanidOrdine == uservlanidAsset) {&#xD;
                                valoreRemoteidDaAsset = appoggioRemoteID;&#xD;
&#xD;
                                Process.auditLog(&quot;valoreRemoteidDaAsset: &quot; + valoreRemoteidDaAsset);&#xD;
                            }&#xD;
                        }&#xD;
&#xD;
                        m++;&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //ATTRIBUTI IN CONSISTENZADATI&#xD;
                if (ConsistenzaDati != null) {&#xD;
                    if (ConsistenzaDati.intermediateAgentFull != null) {&#xD;
                        foundIntermediateagentfullConsistenza = true;&#xD;
&#xD;
                        Process.auditLog(&quot;Trovato intermediateAgentFull in consistenza:&quot; + ConsistenzaDati.intermediateAgentFull);&#xD;
                    }&#xD;
&#xD;
                    if (ConsistenzaDati.encapsulation != null) {&#xD;
                        foundEncapsulationConsistenza = true;&#xD;
&#xD;
                        Process.auditLog(&quot;Trovato encapsulation in consistenza:&quot; + ConsistenzaDati.encapsulation);&#xD;
                    }&#xD;
                }&#xD;
&#xD;
&#xD;
                //OFFERTE VULAFTTH e VULAFTTCAB&#xD;
                if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB) {&#xD;
                    //SOTTOLAVOLAZIONE INCREMENTOVC&#xD;
                    if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
                        decr == false) {&#xD;
                        AggiungiRemoteidDaC01M02F27 = true;&#xD;
                        Process.auditLog(&quot;AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27);&#xD;
                    }&#xD;
&#xD;
                    //SOTTOLAVORAZIONE RICONFIGURAZIONEVC E CAMBIOTIPOVLAN (RincofigurazioneAccesso)&#xD;
                    else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC ||&#xD;
                        localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN) {&#xD;
                        //caso 1, caso 2, caso 6&#xD;
                        if (foundSvlancode &amp;&amp; (valoreIntermediateagentfull == &quot;SI&quot; ||&#xD;
                                (!foundIntermediateagentfull &amp;&amp; ConsistenzaDati.intermediateAgentFull == &quot;SI&quot;) ||&#xD;
                                (valoreIntermediateagentfull == &quot;SI&quot; &amp;&amp; ConsistenzaDati.intermediateAgentFull == &quot;NO&quot;))) {&#xD;
                            AggiungiRemoteidDaC01M02F27 = true;&#xD;
                            Process.auditLog(&quot;Caso 1/2/6 AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27);&#xD;
                        }&#xD;
&#xD;
                        //caso 4&#xD;
                        else if (!foundIntermediateagentfull &amp;&amp; !foundIntermediateagentfullConsistenza) {&#xD;
                            AggiungiRemoteidDaConsistenza = true;&#xD;
                            Process.auditLog(&quot;Caso 4 AggiungiRemoteidDaConsistenza: &quot; + AggiungiRemoteidDaConsistenza);&#xD;
                        }&#xD;
&#xD;
                        //caso 5&#xD;
                        else if (valoreIntermediateagentfull == &quot;NO&quot; &amp;&amp; ConsistenzaDati.intermediateAgentFull == &quot;SI&quot;) {&#xD;
                            EliminaRemoteidDellaComponente = true;&#xD;
                            Process.auditLog(&quot;Caso 4 EliminaRemoteidDellaComponente: &quot; + EliminaRemoteidDellaComponente);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    //ALTRE SOTTOLAVORAZIONI&#xD;
                    else {&#xD;
                        AggiungiRemoteidDaConsistenza = true;&#xD;
                        Process.auditLog(&quot;ALTRO AggiungiRemoteidDaConsistenza: &quot; + AggiungiRemoteidDaConsistenza);&#xD;
                    }&#xD;
&#xD;
                    //Vlan attestata su INTERMEDIATEAGENT = SI o Y&#xD;
                    for (var k = 0; k &lt; EsistenzaVLANOutputArricchimento.size(); k++) {&#xD;
                        var currentEsistenzaVLAN = EsistenzaVLANOutputArricchimento.get(k);&#xD;
&#xD;
                        if (currentEsistenzaVLAN.IDDettaglioOrdine == componente.IDDettaglioOrdine &amp;&amp;&#xD;
                            (String(currentEsistenzaVLAN.INTERMEDIATE_AGENT) == &quot;SI&quot; || String(currentEsistenzaVLAN.INTERMEDIATE_AGENT) == &quot;Y&quot;)) {&#xD;
                            IntermediateAgentVLAN = true;&#xD;
                            Process.auditLog(&quot;IntermediateAgentVLAN: &quot; + IntermediateAgentVLAN + &quot;, Vlan attestata su INTERMEDIATEAGENT = SI o Y&quot;);&#xD;
                        }&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //OFFERTE BITSTREAMNGAFTTCAB e BITSTREAMNGAFTTH&#xD;
                else if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH) {&#xD;
                    // SOTTOLAVORAZIONE RICONFIGURAZIONEVC&#xD;
                    if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RICONFIGURAZIONEVC) {&#xD;
                        if (foundCodeVlanSingleTag &amp;&amp; valoreIntermediateagentfull == &quot;SI&quot;) {&#xD;
                            AggiungiRemoteidDaC01M02F27 = true;&#xD;
                            Process.auditLog(&quot;AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27);&#xD;
                        } else {&#xD;
                            AggiungiRemoteidDaConsistenza = true;&#xD;
                            Process.auditLog(&quot;AggiungiRemoteidDaConsistenza: &quot; + AggiungiRemoteidDaConsistenza);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    //SOTTOLAVORAZIONE CAMBIOTIPOVLAN&#xD;
                    else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTIPOVLAN) {&#xD;
                        if (valoreEncapsulation == &quot;SINGLETAG&quot; &amp;&amp; ConsistenzaDati.encapsulation == &quot;DOUBLETAG&quot; &amp;&amp;&#xD;
                            (valoreIntermediateagentfull == &quot;SI&quot; || ConsistenzaDati.intermediateAgentFull == &quot;SI&quot;)) {&#xD;
                            AggiungiRemoteidDaC01M02F27 = true;&#xD;
                            Process.auditLog(&quot;AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27 + &quot;, valoreEncapsulation: &quot; + valoreEncapsulation + &quot;, ConsistenzaDati.encapsulation: &quot; + ConsistenzaDati.encapsulation + &quot;, valoreIntermediateagentfull: &quot; + valoreIntermediateagentfull + &quot;, ConsistenzaDati.intermediateAgentFull: &quot; + ConsistenzaDati.intermediateAgentFull);&#xD;
                        } else if (valoreEncapsulation == &quot;DOUBLETAG&quot; &amp;&amp; ConsistenzaDati.encapsulation == &quot;SINGLETAG&quot;) {&#xD;
                            EliminaRemoteidDellaComponente = true;&#xD;
                            Process.auditLog(&quot;EliminaRemoteidDellaComponente: &quot; + EliminaRemoteidDellaComponente + &quot;, valoreEncapsulation: &quot; + valoreEncapsulation + &quot;, ConsistenzaDati.encapsulation: &quot; + ConsistenzaDati.encapsulation);&#xD;
                        } else if (valoreEncapsulation == ConsistenzaDati.encapsulation) {&#xD;
                            AggiungiRemoteidDaConsistenza = true;&#xD;
                            Process.auditLog(&quot;AggiungiRemoteidDaConsistenza: &quot; + AggiungiRemoteidDaConsistenza + &quot;, valoreEncapsulation: &quot; + valoreEncapsulation + &quot;, ConsistenzaDati.encapsulation: &quot; + ConsistenzaDati.encapsulation);&#xD;
                        }&#xD;
&#xD;
                    }&#xD;
&#xD;
                    //SOTTOLAVORAZIONE INCREMENTOVC&#xD;
                    else if (localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC &amp;&amp;&#xD;
                        decr == false) {&#xD;
                        if (foundCodeVlanSingleTag &amp;&amp; (valoreIntermediateagentfull == &quot;SI&quot; || ConsistenzaDati.intermediateAgentFull == &quot;SI&quot;)) {&#xD;
                            AggiungiRemoteidDaC01M02F27 = true;&#xD;
                            Process.auditLog(&quot;AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27 + &quot;, foundCodeVlanSingleTag: &quot; + foundCodeVlanSingleTag + &quot;, valoreIntermediateagentfull: &quot; + valoreIntermediateagentfull + &quot;, ConsistenzaDati.intermediateAgentFull: &quot; + ConsistenzaDati.intermediateAgentFull);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    //ALTRE SOTTOLAVORAZIONI&#xD;
                    else {&#xD;
                        AggiungiRemoteidDaConsistenza = true;&#xD;
                        Process.auditLog(&quot;ALTRE SOTTOLAVORAZIONI AGGIUNGI REMOTEID DA CONSISTENZA&quot;);&#xD;
                    }&#xD;
&#xD;
                }&#xD;
&#xD;
                //RU_982: OFFERTA BITSTREAMGBEASIMMETRICOFLAT&#xD;
                else if (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT) {&#xD;
                    if (valoreIntermediateagentfull == &quot;SI&quot; &amp;&amp; !foundCvlanid &amp;&amp; foundProtocolloPila) {&#xD;
                        AggiungiRemoteidDaC01M02F27 = true;&#xD;
                        Process.auditLog(&quot;AggiungiRemoteidDaC01M02F27: &quot; + AggiungiRemoteidDaC01M02F27 + &quot;, valoreIntermediateagentfull: &quot; + valoreIntermediateagentfull + &quot;, foundCvlanid: &quot; + foundCvlanid + &quot;, foundProtocolloPila: &quot; + foundProtocolloPila);&#xD;
                    } else {&#xD;
                        AggiungiRemoteidDaConsistenza = true;&#xD;
                        Process.auditLog(&quot;AggiungiRemoteidDaConsistenza: &quot; + AggiungiRemoteidDaConsistenza);&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //controllo su valore null&#xD;
                if (valoreRemoteidDaAsset == null) {&#xD;
                    AggiungiRemoteidDaConsistenza = false;&#xD;
                    Process.auditLog(&quot;Sbiancato AggiungiRemoteidDaConsistenza per valoreRemoteidDaAsset NULL&quot;);&#xD;
                }&#xD;
&#xD;
                //VALORIZZA REMOTEID CON IL VALORE IN USCITA DAL CONTROLLO CALCOLAREMOTEID C01M02F27 (se AggiungiRemoteidDaC01M02F27 == true)&#xD;
                //OPPURE VALORIZZA REMOTEID DALLA COMPONENTE USERVLAN IN CONSISTENZA/ASSET (se AggiungiRemoteidDaConsistenza == true)&#xD;
&#xD;
                if (((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH //1&#xD;
                            ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB) &amp;&amp;&#xD;
                        (IntermediateAgentVLAN == true &amp;&amp; AggiungiRemoteidDaC01M02F27 == true) || (AggiungiRemoteidDaConsistenza == true)) ||&#xD;
                    ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB //2&#xD;
                            ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
                            localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMGBEASIMMETRICOFLAT) &amp;&amp;&#xD;
                        (AggiungiRemoteidDaC01M02F27 == true || AggiungiRemoteidDaConsistenza == true)))&#xD;
&#xD;
                {&#xD;
                    //SE REMOTEID ESISTE&#xD;
                    var j = 0;&#xD;
&#xD;
                    while (foundRemoteId == false &amp;&amp; j &lt; componente.attributiDettaglioOrdine.size()) {&#xD;
                        var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID) {&#xD;
                            //valorizza con l'uscita del controllo CalcolaRemoteId&#xD;
                            if (AggiungiRemoteidDaC01M02F27 == true &amp;&amp; LavorazioneRichiesta.remoteId != null) {&#xD;
                                attributo.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
                                Process.auditLog(&quot;Valorizzato REMOTEID con valore in uscita dal controllo C01M02F27: &quot; + LavorazioneRichiesta.remoteId);&#xD;
                            }&#xD;
&#xD;
                            //altrimenti prendi il valore dalla Consistenza/Asset&#xD;
                            else if (AggiungiRemoteidDaConsistenza == true) {&#xD;
                                attributo.valoreAttributo = valoreRemoteidDaAsset;&#xD;
                                Process.auditLog(&quot;Valorizzato REMOTEID con valore in Consistenza: &quot; + valoreRemoteidDaAsset);&#xD;
                            }&#xD;
&#xD;
                            //Deve essere valorizzato anche OLD di REMOTEID in questi casi:&#xD;
                            if ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
                                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
                                    localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH) &amp;&amp;&#xD;
                                localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC) {&#xD;
                                attributo.valoreAttributoOLD = valoreRemoteidDaAsset;&#xD;
                                Process.auditLog(&quot;Valorizzato OLD di REMOTEID con valore in Consistenza: &quot; + valoreRemoteidDaAsset);&#xD;
                            }&#xD;
&#xD;
                            foundRemoteId = true;&#xD;
                        }&#xD;
                        j++;&#xD;
                    }&#xD;
&#xD;
                    //SE REMOTEID NON ESISTE&#xD;
                    if (!foundRemoteId) {&#xD;
                        var AttributoRemoteId = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
&#xD;
                        AttributoRemoteId.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
                        AttributoRemoteId.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
                        AttributoRemoteId.created = DateTimeUtil.createDatetime();&#xD;
                        AttributoRemoteId.lastUpdate = DateTimeUtil.createDatetime();&#xD;
                        AttributoRemoteId.operatore = &quot;BPM&quot;;&#xD;
                        AttributoRemoteId.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
                        AttributoRemoteId.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID;&#xD;
&#xD;
                        //valorizza con l'uscita del controllo CalcolaRemoteId&#xD;
                        if (AggiungiRemoteidDaC01M02F27 == true &amp;&amp; LavorazioneRichiesta.remoteId != null) {&#xD;
                            AttributoRemoteId.valoreAttributo = LavorazioneRichiesta.remoteId;&#xD;
                            Process.auditLog(&quot;Valorizzato REMOTEID con valore in uscita dal controllo C01M02F27: &quot; + LavorazioneRichiesta.remoteId);&#xD;
                        }&#xD;
&#xD;
                        //altrimenti prendi il valore dalla Consistenza/Asset&#xD;
                        else if (AggiungiRemoteidDaConsistenza == true) {&#xD;
                            AttributoRemoteId.valoreAttributo = valoreRemoteidDaAsset;&#xD;
                            Process.auditLog(&quot;Valorizzato REMOTEID con valore in Consistenza: &quot; + valoreRemoteidDaAsset);&#xD;
                        }&#xD;
&#xD;
                        //Deve essere valorizzato anche OLD di REMOTEID in questi casi:&#xD;
                        if ((localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB ||&#xD;
                                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
                                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH) &amp;&amp;&#xD;
                            localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.INCREMENTODECREMENTOVC) {&#xD;
                            AttributoRemoteId.valoreAttributoOLD = valoreRemoteidDaAsset;&#xD;
&#xD;
                            Process.auditLog(&quot;Valorizzato OLD di REMOTEID con valore in Consistenza: &quot; + valoreRemoteidDaAsset);&#xD;
                        }&#xD;
&#xD;
                        componente.attributiDettaglioOrdine.add(ScriptUtil.copy(AttributoRemoteId));&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //ELIMINA REMOTEID DALLA COMPONENTE USERVLAN&#xD;
                if (EliminaRemoteidDellaComponente) {&#xD;
                    for (var h = 0; h &lt; componente.attributiDettaglioOrdine.size(); h++) {&#xD;
                        var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
&#xD;
                        if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID) {&#xD;
                            componente.attributiDettaglioOrdine.remove(h);&#xD;
&#xD;
                            Process.auditLog(&quot;Eliminato attributo REMOTEID&quot;);&#xD;
                        }&#xD;
                    }&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
}&#xD;
&#xD;
//Task #31984 (ex SM_9562): aggiunto arricchimento di DATITECNICI della componente SERVIZIOPZIONALI autogenerati (controllo C01M02F35)&#xD;
//RU_1081: modificata logica di arricchimento per DATITECNICI di SERVIZIOPZIONALI autogenerati: aggiunto controllo dell'operatore&#xD;
else if ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE ||&#xD;
        localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) &amp;&amp;&#xD;
    (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSFLAT ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPBASEPLUSLITE ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILEFLAT ||&#xD;
        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPSPECIALPROFILELITE) &amp;&amp;&#xD;
    LavorazioneRichiesta != null &amp;&amp;&#xD;
    LavorazioneRichiesta.remoteId != null) {&#xD;
&#xD;
    for (var m = 0; m &lt; localRequest.ordine.dettaglioordine.size(); m++) {&#xD;
        var componente = localRequest.ordine.dettaglioordine.get(m);&#xD;
&#xD;
        if (componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI) {&#xD;
            var CodiceServizio = &quot;&quot;;&#xD;
            CodiceServizio = null;&#xD;
            var OperatoreBPM = false;&#xD;
&#xD;
            var REALM = &quot;&quot;; //RU_1088&#xD;
            REALM = null;&#xD;
&#xD;
            //Controllo i SERVIZIOPZIONALI autogenerati: verifico operatore e CodiceServizio&#xD;
            if (componente.operatore == &quot;BPM&quot;) {&#xD;
                OperatoreBPM = true;&#xD;
            }&#xD;
&#xD;
            for (var k = 0; k &lt; componente.attributiDettaglioOrdine.size(); k++) {&#xD;
                var attributo = componente.attributiDettaglioOrdine.get(k);&#xD;
&#xD;
                if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO) {&#xD;
                    CodiceServizio = attributo.valoreAttributo;&#xD;
                    Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot; + attributo.valoreAttributo + &quot; su componente con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                }&#xD;
            }&#xD;
&#xD;
            //ARRICCHIMENTO da fare solo per SERVIZIOPZIONALI autogenerati (con operatore = BPM), se CODICESERVIZIO = A001&#xD;
            if (CodiceServizio == &quot;A001&quot; &amp;&amp; OperatoreBPM) {&#xD;
                var foundDATITECNICI = false; //commentato con RU_1088; DECOMMENTATO CON RU_1632&#xD;
&#xD;
                //RU_1614: DOBBIAMO DIFFERENZIARE IL CASO ONESTEP SI DAL CASO ONESTEP NO				&#xD;
                for (var j = 0; j &lt; componente.attributiDettaglioOrdine.size(); j++) {&#xD;
                    var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
&#xD;
                    if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI) {&#xD;
                        foundDATITECNICI = true; //commentato con RU_1088; DECOMMENTATO CON RU_1632&#xD;
&#xD;
                        //RU_1614: DOBBIAMO DIFFERENZIARE IL CASO ONESTEP SI DAL CASO ONESTEP NO&#xD;
                        if ((OneStep == &quot;NO&quot; || OneStep == &quot;N&quot;) &amp;&amp;&#xD;
                            (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE ||&#xD;
                                localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE) &amp;&amp;&#xD;
                            (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
                                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||&#xD;
                                localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB) &amp;&amp;&#xD;
                            RealmC01M02F54 != null) //INSERITA CONDIZIONE CON RU_1633: serve per oscurare la RU_1614&#xD;
                        {&#xD;
                            attributo.valoreAttributo = &quot;USERNAMEMODEM: &quot; + LavorazioneRichiesta.remoteId + &quot;@&quot; + RealmC01M02F54 + &quot;, PWDMODEM: &quot; + LavorazioneRichiesta.remoteId;&#xD;
                            Process.auditLog(&quot;Trovato attributo DATITECNICI&quot; + attributo.valoreAttributo + &quot; su componente con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                        }&#xD;
                        //SOLITO&#xD;
                        //RU_1088: modificato arricchimento di DATITECNICI&#xD;
                        //Il valore REALM viene messo nell'attributo DATITECNICI (da controllo C01M02F35 e poi completiamo qui l'arricchimento)&#xD;
                        //Se CODICESERVIZIO = A001 allora in DATITECNICI viene messo il REALM (solo per EASYIP) usato poi nel complete script del CalcoloRemoteID, altrimenti viene messo il valore definitivo	&#xD;
                        else {&#xD;
                            REALM = attributo.valoreAttributo;&#xD;
                            attributo.valoreAttributo = &quot;USERNAMEMODEM: &quot; + LavorazioneRichiesta.remoteId + &quot;@&quot; + REALM + &quot;, PWDMODEM: &quot; + LavorazioneRichiesta.remoteId;&#xD;
                            Process.auditLog(&quot;Trovato attributo DATITECNICI&quot; + attributo.valoreAttributo + &quot; su componente con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                        }&#xD;
                    }&#xD;
                }&#xD;
&#xD;
                //Commentato con RU_1088: se non trova DATITECNICI per CODICESERVIZIO = A001, vuol dire che il controllo C01M02F35 non ha restituito il REALM&#xD;
                //DECOMMENTATO CON RU_1632: quando non c'è nessun CODICESERVIZIO A001 ne dobbiamo creare uno sul BPM e arricchire DATITECNICI come nel caso di ONESTEP NO&#xD;
                if (!foundDATITECNICI &amp;&amp;&#xD;
                    (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
                        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH ||&#xD;
                        localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB) &amp;&amp;&#xD;
                    RealmC01M02F54 != null) //INSERITA CONDIZIONE CON RU_1633: serve per oscurare la RU_1614)&#xD;
                {&#xD;
                    var ora = DateTimeUtil.createDatetime();&#xD;
                    var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
&#xD;
                    attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
                    attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
                    attributo.created = ora;&#xD;
                    attributo.lastUpdate = ora;&#xD;
                    attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI;&#xD;
                    attributo.operatore = componente.operatore;&#xD;
                    attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
                    attributo.valoreAttributo = &quot;USERNAMEMODEM: &quot; + LavorazioneRichiesta.remoteId + &quot;@&quot; + RealmC01M02F54 + &quot;, PWDMODEM: &quot; + LavorazioneRichiesta.remoteId;&#xD;
&#xD;
                    componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
                    Process.auditLog(&quot;Creato attributo DATITECNICI&quot; + attributo.valoreAttributo + &quot; su componente con IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
&#xD;
                    foundDATITECNICI = true;&#xD;
                }&#xD;
&#xD;
                // BUG_52195: se non è stato trovato DATI TECNICI proveniente dal controllo C01M02F35 e se il RealmC01M02F54 proveniente da controllo C01M02F54 non sono popolati&#xD;
                // cancello l'aggregato SERVIZI OPZIONALI con CODICE A001 in quanto non può essere inviato a DTU senza REALM valorizzato&#xD;
                if (!foundDATITECNICI) {&#xD;
                    localRequest.ordine.dettaglioordine.remove(m);&#xD;
                    Process.auditLog(&quot;Eliminato aggregato SERVIZIOPZIONALI A001 - REALM non valorizzato, IDDett &quot; + componente.IDDettaglioOrdine);&#xD;
                    m--; // fondamentale: la lista si compatta, senza decrementare si salterebbe l'elemento successivo&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
}&#xD;
&#xD;
//FEA-62679: per VARIAZIONE/CESSAZIONE, il Servizio Opzionale A001 non e' valorizzato in input:&#xD;
//va recuperato dalla Consistenza Dati (Asset) e aggiunto all'ordine prima dell'invio a DTU&#xD;
if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
    || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE)&#xD;
   &amp;&amp; Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
{&#xD;
    for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
    {&#xD;
        var componenteAsset = Asset.dettaglioasset.get(i);&#xD;
&#xD;
        if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI&#xD;
           &amp;&amp; componenteAsset.statoDettaglioAsset == 'ATTIVO')&#xD;
        {&#xD;
            for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
            {&#xD;
                var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
&#xD;
                if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
                   &amp;&amp; attributoAsset.valoreAttributo == 'A001')&#xD;
                {&#xD;
                    //Trovato A001 attivo in Asset: creo e aggiungo subito la componente SERVIZIOPZIONALI nell'ordine (azione = N, nessuna variazione)&#xD;
                    var data = DateTimeUtil.createDatetime();&#xD;
                    var componenteServiziOpzionaliA001 = it_telecomitalia_it_NOW_casedata_Factory.createDettaglioOrdine();&#xD;
                    componenteServiziOpzionaliA001.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
                    componenteServiziOpzionaliA001.IDDettaglioOrdine = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
                    componenteServiziOpzionaliA001.IDDettaglioOrdineParent = 1;&#xD;
                    componenteServiziOpzionaliA001.IDDettaglioOrdineRoot = 1;&#xD;
                    componenteServiziOpzionaliA001.IDRisorsa = localRequest.IDRisorsa;&#xD;
                    componenteServiziOpzionaliA001.IDRisorsaNOW = localRequest.ordine.IDRisorsaNOW;&#xD;
                    componenteServiziOpzionaliA001.operatore = &quot;BPM&quot;;&#xD;
                    componenteServiziOpzionaliA001.progressivo = localRequest.ordine.dettaglioordine.size() + 1;&#xD;
                    componenteServiziOpzionaliA001.created = data;&#xD;
                    componenteServiziOpzionaliA001.integrationID = localRequest.IDRichiestaOLO + localRequest.ordine.dettaglioordine.size() + 1;&#xD;
                    componenteServiziOpzionaliA001.lastUpdate = data;&#xD;
                    componenteServiziOpzionaliA001.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.N;&#xD;
                    componenteServiziOpzionaliA001.nomeComponente = it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI;&#xD;
&#xD;
                    for(var k=0; k&lt;componenteAsset.attributidettaglioasset.size(); k++)&#xD;
                    {&#xD;
                        var attributoDaCopiare = componenteAsset.attributidettaglioasset.get(k);&#xD;
&#xD;
                        if(attributoDaCopiare.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
                           || attributoDaCopiare.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONESERVIZIO&#xD;
                           || attributoDaCopiare.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATITECNICI&#xD;
                           || attributoDaCopiare.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VINCOLANTEPERESPLETAMENTO)&#xD;
                        {&#xD;
                            var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
                            nuovoAttributo.IDDettaglioOrdine = componenteServiziOpzionaliA001.IDDettaglioOrdine;&#xD;
                            nuovoAttributo.IDRichiestaOLO = componenteServiziOpzionaliA001.IDRichiestaOLO;&#xD;
                            nuovoAttributo.created = data;&#xD;
                            nuovoAttributo.lastUpdate = data;&#xD;
                            nuovoAttributo.operatore = componenteServiziOpzionaliA001.operatore;&#xD;
                            nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
                            nuovoAttributo.nomeAttributo = attributoDaCopiare.nomeAttributo;&#xD;
                            nuovoAttributo.valoreAttributo = attributoDaCopiare.valoreAttributo;&#xD;
&#xD;
                            componenteServiziOpzionaliA001.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));&#xD;
                            Process.auditLog(&quot;copiato da Asset attributo &quot;+attributoDaCopiare.nomeAttributo+&quot; = &quot;+attributoDaCopiare.valoreAttributo);&#xD;
                        }&#xD;
                    }&#xD;
&#xD;
                    localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(componenteServiziOpzionaliA001));&#xD;
                    Process.auditLog(&quot;aggiunta componente SERVIZIOPZIONALI A001 da Asset per lavorazione &quot;+localRequest.lavorazione);&#xD;
                }&#xD;
            }&#xD;
        }&#xD;
    }&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
