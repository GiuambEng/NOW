                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_WC5xANfBEeqh2KUpLPmtBw" OperationName="Determina_Identificativo_Anagrafica_Kit_Adr_Car">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="BPM_CheckServiceVlanPortTypeSOAP" ServiceName="BPM_CheckServiceVlanPortType">
