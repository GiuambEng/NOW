              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaServiziOpzionaliAlternativiRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaServiziOpzionaliAlternativi_RequestType();&#xD;
&#xD;
DeterminaServiziOpzionaliAlternativiRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
DeterminaServiziOpzionaliAlternativiRequest.codOloAgcom = localRequest.codificaOLOAGCOM;&#xD;
DeterminaServiziOpzionaliAlternativiRequest.DRO = localRequest.DRO;&#xD;
DeterminaServiziOpzionaliAlternativiRequest.codiceProgetto = localRequest.codiceProgetto;&#xD;
&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
