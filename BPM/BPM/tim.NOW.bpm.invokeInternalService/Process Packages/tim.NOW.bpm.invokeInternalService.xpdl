        <xpdl2:Activity Id="_FmzUoJCFEeaEm-ktY1iisg" Name="ValidateNotification" xpdExt:Visibility="Private" xpdExt:DisplayName="ValidateNotification">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskService xpdExt:ImplementationType="WebService" Implementation="WebService">
                <xpdl2:MessageIn Id="_GmyyApCFEeaEm-ktY1iisg">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping xpdExt:SourcePrimitiveProperty="false" Direction="IN" Formal="parameters">
                      <xpdl2:Actual ScriptGrammar="JavaScript">StateMachineValidationRequest</xpdl2:Actual>
