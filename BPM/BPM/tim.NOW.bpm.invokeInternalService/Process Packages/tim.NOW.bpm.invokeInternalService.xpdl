			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO)&#xD;
			{&#xD;
				DeterminaServiziOpzionaliAlternativiRequest.codiceServizio.add(attributo.valoreAttributo);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
