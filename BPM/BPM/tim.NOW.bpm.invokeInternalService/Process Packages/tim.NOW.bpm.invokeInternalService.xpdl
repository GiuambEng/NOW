                  <xpdExt:OutputMappings MapperContext="OutputFromService" MappingDirection="OUT">
                    <xpdExt:DataMappings>
                      <xpdExt:DataMapping xpdExt:SourceContributorId="OutputFromService.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="CodiceOrdineTI">
                        <xpdl2:Actual ScriptGrammar="JavaScript">parameters.codice_Ordine_TI</xpdl2:Actual>
                      </xpdExt:DataMapping>
                    </xpdExt:DataMappings>
                  </xpdExt:OutputMappings>
                </xpdl2:MessageOut>
                <xpdl2:WebServiceOperation xpdExt:SecurityProfile="" xpdExt:Transport="http://schemas.xmlsoap.org/soap/http" xpdExt:Alias="_dSGApoF3Eea1BcUITTCQOA" OperationName="GenerazioneCodiceOrdineTI">
                  <xpdl2:Service xpdExt:IsRemote="true" PortName="CodiceOrdineTIPortTypeSOAP" ServiceName="CodiceOrdineTIPortType">
