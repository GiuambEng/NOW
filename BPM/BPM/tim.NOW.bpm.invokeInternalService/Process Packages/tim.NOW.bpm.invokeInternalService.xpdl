        </xpdl2:Activity>
        <xpdl2:Activity Id="_EExC8ihkEfGZGdu9XnBqbQ" Name="DeterminaCaratterizzazionePnrrDrgOpzioneZeroC01M02F55" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Determina Caratterizzazione Pnrr Drg Opzione Zero C01M02F55">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var CARATTERIZZAZIONEGEO = '';&#xD;
CARATTERIZZAZIONEGEO = null;&#xD;
&#xD;
var IDAsset = '';&#xD;
IDAsset = null;&#xD;
&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO)&#xD;
				{&#xD;
					CARATTERIZZAZIONEGEO = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo CARATTERIZZAZIONEGEO con valore: &quot; +CARATTERIZZAZIONEGEO);	&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
else 	//Recupero IDAsset da COMPONENTE COSISTENZADATI&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					IDAsset = attributo.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(IDAsset != null)&#xD;
{&#xD;
	AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(IDAsset, 10));&#xD;
	Asset = AssetRef.readAsset();&#xD;
}&#xD;
	&#xD;
if(Asset != null)&#xD;
{&#xD;
	for(var i=0; i&lt;Asset.dettaglioasset.size(); i++)&#xD;
	{&#xD;
		var currentDettAsset = Asset.dettaglioasset.get(i);&#xD;
&#xD;
		if(String(currentDettAsset.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettAsset.attributidettaglioasset.size(); j++)&#xD;
			{&#xD;
				var currentAttributoDettAsset = currentDettAsset.attributidettaglioasset.get(j);&#xD;
				&#xD;
				if(currentAttributoDettAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO)&#xD;
				{&#xD;
					CARATTERIZZAZIONEGEO = currentAttributoDettAsset.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo CARATTERIZZAZIONEGEO con valore: &quot; +CARATTERIZZAZIONEGEO);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(localRequest.ordine !=null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	var foundFLAGPNRRDRGZERO = false;&#xD;
&#xD;
	if(localRequest.ordine.caratterizzazioneAccesso == 'DRG OPZIONE ZERO' &#xD;
	&amp;&amp; (CARATTERIZZAZIONEGEO == 'B1G22L1' || CARATTERIZZAZIONEGEO == 'B1G22L3' || CARATTERIZZAZIONEGEO == 'B1G22L4' || &#xD;
		CARATTERIZZAZIONEGEO == 'B1G22L5' || CARATTERIZZAZIONEGEO == 'B1G22L11' || CARATTERIZZAZIONEGEO == 'B1G22L14' || CARATTERIZZAZIONEGEO == 'B1G22LU'))&#xD;
	{&#xD;
		for(var k=0; k&lt;localRequest.ordine.dettaglioordine.size(); k++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(k);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				for(var z=0; z&lt;currentDettOrdine.attributiDettaglioOrdine.size(); z++)&#xD;
				{&#xD;
					var currentAttributoDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
					&#xD;
					if(currentAttributoDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPNRRDRGZERO)&#xD;
					{&#xD;
						currentAttributoDettOrdine.valoreAttributo = 'Y';&#xD;
						Process.auditLog(&quot;Sovrascritto attributo FLAGPNRRDRGZERO con Y sulla componente con IDDettaglioOrdine: &quot; +currentDettOrdine.IDDettaglioOrdine);	&#xD;
						foundFLAGPNRRDRGZERO = true;&#xD;
					}				&#xD;
				}&#xD;
				&#xD;
				if(!foundFLAGPNRRDRGZERO)&#xD;
				{&#xD;
					var nuovoAttributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					nuovoAttributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
					nuovoAttributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					nuovoAttributo.created = DateTimeUtil.createDatetime();&#xD;
					nuovoAttributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
					nuovoAttributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGPNRRDRGZERO;&#xD;
					nuovoAttributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					nuovoAttributo.valoreAttributo = 'Y';&#xD;
					nuovoAttributo.operatore = localRequest.operatore;&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(nuovoAttributo));									&#xD;
					Process.auditLog(&quot;Aggiungo attributo FLAGPNRRDRGZERO con Y sulla componente con IDDettaglioOrdine: &quot; +currentDettOrdine.IDDettaglioOrdine);&#xD;
				}&#xD;
				&#xD;
				//SM_12017: stiamo aggiungendo un attributo, quindi modifichiamo azione della componente di ACCESSO da N a M&#xD;
				if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
				{&#xD;
					currentDettOrdine.azione = it_telecomitalia_it_NOW_casedata_AzioneEnumeration.M;&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
