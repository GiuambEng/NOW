            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaInterventoUnicoRequest = com_tim_NOW_xsd_ControlliFormali_Factory.createDeterminaInterventoUnico_RequestType();&#xD;
&#xD;
DeterminaInterventoUnicoRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
DeterminaInterventoUnicoRequest.offerta = String(localRequest.offerta);&#xD;
DeterminaInterventoUnicoRequest.caratterizzazioneArea = localRequest.caratterizzazioneArea;&#xD;
DeterminaInterventoUnicoRequest.codiceComune = localRequest.ISTATComune;&#xD;
DeterminaInterventoUnicoRequest.lavorazione = String(localRequest.lavorazione);  //RIENTRI DEL82&#xD;
DeterminaInterventoUnicoRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);   //RIENTRI DEL82&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	var servizioAggiuntivo = com_tim_NOW_xsd_ControlliFormali_Factory.createServizioAggiuntivoType();&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{	&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PROMOZIONE)&#xD;
			{&#xD;
				DeterminaInterventoUnicoRequest.promozione = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOAGGIUNTIVO)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMESERVIZIO)&#xD;
			{&#xD;
				servizioAggiuntivo.nomeServizio = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
		DeterminaInterventoUnicoRequest.servizioAggiuntivo.add(servizioAggiuntivo);&#xD;
	}&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
