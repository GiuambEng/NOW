          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">CodiceOrdineRequest=NOW_com_tim_xsd_GenerazioneCodiceOrdineTI_Factory.createCodiceOrdineTIinputType();

CodiceOrdineRequest.IDRichiestaOLO = localRequest.IDRichiestaOLO;

//SM_11652
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE 
	&amp;&amp; localRequest.flagMigDel82 == 'SI')
{
	CodiceOrdineRequest.codice_numerico_OLO = &quot;FOP&quot;;
}
else 
{
	CodiceOrdineRequest.codice_numerico_OLO = localRequest.codificaOLONOW;
}

CodiceOrdineRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));
CodiceOrdineRequest.struttura_Richiesta = it_telecomitalia_it_NOW_casedata_v1_TipoStrutturaRichiestaEnumeration.get(String(localRequest.strutturaRichiesta));
CodiceOrdineRequest.DRO = localRequest.DRO;

if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE
	&amp;&amp; localRequest.flagMigDel82 != null &amp;&amp; localRequest.flagMigDel82 != &quot;&quot;)
{
	CodiceOrdineRequest.flagMigDel82 = localRequest.flagMigDel82; //RU_1546
}
else
{
	CodiceOrdineRequest.flagMigDel82 = &quot;NO&quot;; //SM_11633
}

//RU_RIENTRI DEL82
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE
	&amp;&amp; localRequest.flagRientriDel82 != null &amp;&amp; localRequest.flagRientriDel82 != &quot;&quot;)
{
	CodiceOrdineRequest.flagRientriDel82 = localRequest.flagRientriDel82; 
}
else
{
	CodiceOrdineRequest.flagRientriDel82 = &quot;NO&quot;; 
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">//SM_9347 - sostituito al mapping standard di output from service, lo script&#xD;
&#xD;
localRequest.codiceOrdineTI = CodiceOrdineTI;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.codiceOrdineTI = CodiceOrdineTI;&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
