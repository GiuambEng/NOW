        <xpdl2:DataField Id="_SgRmsNNXEeuYw_BPzgcQ6g" xpdExt:DisplayName="IDRisorsaVLANMulticast" Name="IDRisorsaVLANMulticast" ReadOnly="false">
          <xpdl2:DataType>
