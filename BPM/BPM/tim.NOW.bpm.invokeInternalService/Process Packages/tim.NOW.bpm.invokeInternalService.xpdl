          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="114.0" LaneId="_5gL7gbPkEeegdcKeFiA4RA" Width="134.0">
              <xpdl2:Coordinates XCoordinate="326.0" YCoordinate="155.0"/>
            </xpdl2:NodeGraphicsInfo>
