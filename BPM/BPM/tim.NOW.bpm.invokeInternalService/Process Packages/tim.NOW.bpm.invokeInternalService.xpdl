              <xpdExt:Information ScriptGrammar="JavaScript">DeterminaAreaDiRaccoltaRequest = com_tim_NOW_xsd_ControlliVlan_Factory.createDetermina_Area_Raccolta_Macroarea_RequestType();&#xD;
&#xD;
DeterminaAreaDiRaccoltaRequest.lavorazione = it_telecomitalia_it_NOW_casedata_v1_LavorazioneEnumeration.get(String(localRequest.lavorazione));&#xD;
DeterminaAreaDiRaccoltaRequest.offerta = it_telecomitalia_it_NOW_casedata_v1_OffertaEnumeration.get(String(localRequest.offerta));&#xD;
DeterminaAreaDiRaccoltaRequest.idRichiestaOlo = localRequest.IDRichiestaOLO;&#xD;
DeterminaAreaDiRaccoltaRequest.sottoLavorazione = String(localRequest.tipologiaSottolav);    //RU_1099&#xD;
&#xD;
&#xD;
if(ConsistenzaRaccolta != null)&#xD;
{&#xD;
	if(ConsistenzaRaccolta.codiceClli != null)&#xD;
	{&#xD;
		DeterminaAreaDiRaccoltaRequest.clliConsistenza = ConsistenzaRaccolta.codiceClli;&#xD;
	}&#xD;
	&#xD;
	//RU_1099&#xD;
	if(ConsistenzaRaccolta.famigliaVlan != null)&#xD;
	{&#xD;
		DeterminaAreaDiRaccoltaRequest.famigliaVlanConsistenza = ConsistenzaRaccolta.famigliaVlan;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(componente.nomeComponente).slice(0,12) == &quot;RACCOLTAVLAN&quot;&#xD;
	   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.RACCOLTAVP)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICECLLI)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.clli = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICECLLI &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			//RU_1099&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FAMIGLIAVLAN)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.famigliaVlan = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo FAMIGLIAVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOLOGIACLUSTERVLAN)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.CC_LIB = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo TIPOLOGIACLUSTERVLAN &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICETDKIT)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.codiceTdKit = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CODICETDKIT &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUPERMACROAREA)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.superMacroArea = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo SUPERMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	//RU_1180&#xD;
	else if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOMEMACROAREA)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.nomeMacroarea = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo NOMEMACROAREA &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			//SM_10199&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLICENTRALE&#xD;
			        &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEDEOLT&#xD;
				        ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CANALE))&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.clli = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CLLICENTRALE &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
			}&#xD;
			//SM_10199&#xD;
			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CLLIPRIMOFEEDER&#xD;
					 &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FEEDER&#xD;
					 &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.PRIMOFEEDER)&#xD;
			{&#xD;
				DeterminaAreaDiRaccoltaRequest.clli = attributo.valoreAttributo;&#xD;
				&#xD;
				Process.auditLog(&quot;Trovato attributo CLLIPRIMOFEEDER &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
if(DeterminaAreaDiRaccoltaRequest != null &amp;&amp; DeterminaAreaDiRaccoltaRequest.famigliaVlan == &quot;1&quot;)&#xD;
{&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
		{&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
				{&#xD;
					DeterminaAreaDiRaccoltaRequest.idCos = attributo.valoreAttributo;&#xD;
					&#xD;
					Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS &quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
&#xD;
if(DeterminaAreaDiRaccoltaRequest != null &amp;&amp; DeterminaAreaDiRaccoltaRequest.famigliaVlanConsistenza == &quot;1&quot;)&#xD;
{&#xD;
	if(ConsistenzaRaccolta != null)&#xD;
	{&#xD;
		AssetRef = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(parseInt(ConsistenzaRaccolta.IDAsset, 10));&#xD;
		Asset = AssetRef.readAsset();&#xD;
	}&#xD;
&#xD;
	if(Asset != null &amp;&amp; Asset.dettaglioasset != null)&#xD;
	{&#xD;
		for(var i = 0; i &lt; Asset.dettaglioasset.size(); i++)&#xD;
		{&#xD;
			var componenteAsset = Asset.dettaglioasset.get(i); &#xD;
			&#xD;
			if(componenteAsset.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.TIPOCOS)&#xD;
			{&#xD;
				for(var j=0; j&lt;componenteAsset.attributidettaglioasset.size(); j++)&#xD;
				{&#xD;
					var attributoAsset = componenteAsset.attributidettaglioasset.get(j);&#xD;
					&#xD;
					if(attributoAsset.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOCOS)&#xD;
					{&#xD;
						DeterminaAreaDiRaccoltaRequest.idCosConsistenza = attributoAsset.valoreAttributo;&#xD;
						&#xD;
						Process.auditLog(&quot;Trovato attributo IDENTIFICATIVOCOS&quot;+ attributoAsset.valoreAttributo +&quot; su componente con IDDett &quot;+componenteAsset.IDDettaglioAsset);&#xD;
						&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//Creo LavorazioneRichiesta se è null&#xD;
if(LavorazioneRichiesta == null)&#xD;
{&#xD;
	LavorazioneRichiesta = com_tim_NOW_xsd_StoricoDatiVerificaControlli_Factory.createLavorazioneRichiestaType();&#xD;
}&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
