			else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO)&#xD;
			{&#xD;
				DeterminaAreaDiCantiereRequest.IDSLUCO = attributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
for(var i=0; i&lt;localRequest.ordine.sede.size(); i++)&#xD;
{&#xD;
	var currentSede = localRequest.ordine.sede.get(i);&#xD;
	&#xD;
	if(currentSede.tipologiaSede == it_telecomitalia_it_NOW_casedata_TipologiaSedeEnumeration.SEDECLIENTE&#xD;
	   &amp;&amp; currentSede.codiceToponomastica != null)&#xD;
	{&#xD;
