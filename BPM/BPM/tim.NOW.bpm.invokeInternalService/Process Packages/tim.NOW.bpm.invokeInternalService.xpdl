        <xpdl2:Activity Id="_a_7p0Cj2EfGZGdu9XnBqbQ" Name="Precondizione" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Precondizione" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">if(localRequest != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	if((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	  ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	  ||localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE)&#xD;
	 &amp;&amp;(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH))				//RU_1581 NEWGPON&#xD;
	{&#xD;
		eseguiControllo = true;&#xD;
	}&#xD;
}&#xD;
if(!eseguiControllo)&#xD;
{&#xD;
	Process.auditLog(&quot;Precondizione Fallita per C01M02F55&quot;);									&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
