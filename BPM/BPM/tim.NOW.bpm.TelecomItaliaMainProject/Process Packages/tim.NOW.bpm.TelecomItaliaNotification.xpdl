															    ||((NOMESERVIZIOOF == &quot;TLC1&quot; || (NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)) &amp;&amp; (ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;))&#xD;
															    ||(NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null))&#xD;
														{&#xD;
															attributoRic1.valoreAttributo = &quot;0&quot;;&#xD;
														}&#xD;
														Process.auditLog(&quot;Aggiornato attributo CAUSALEESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
													}*/&#xD;
													//IDAPPARATO&#xD;
													else if(attributoRic1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDAPPARATO&#xD;
													        &amp;&amp; (NOMESERVIZIO == &quot;TLC1&quot; || (NOMESERVIZIO == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)) &amp;&amp; IDAPPARATOCONSEGNATO != null &#xD;
															&amp;&amp; (ESITOCONSEGNAAPPARATO == &quot;1&quot; || ESITOCONSEGNAAPPARATO == &quot;2&quot;)&#xD;
															&amp;&amp; ((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
															    ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)))    //MIG RIENTRI DEL82&#xD;
													{&#xD;
														foundIDAPPARATO = true;&#xD;
														attributoRic1.valoreAttributo = IDAPPARATOCONSEGNATO;&#xD;
														Process.auditLog(&quot;Aggiornato attributo IDAPPARATO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
													}&#xD;
													//CAUSALEESITO&#xD;
