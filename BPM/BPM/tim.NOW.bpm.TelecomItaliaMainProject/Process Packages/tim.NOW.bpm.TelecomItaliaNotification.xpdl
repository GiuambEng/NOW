        <xpdl2:ActivitySet Id="_9aGQcJSLEeaoz6QqwJkuNg">
          <xpdl2:Activities>
            <xpdl2:Activity Id="_jVYFCwOpEeaIdPdRimpTnw" Name="AppendNotification" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Append Notification">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_v3JtkIFrEeaG-Y7D3-yA8Q" PackageRef="tim.NOW.bpm.invokeExternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="TipologiaNotifica">
                      <xpdExt:ScriptInformation Id="_Dhz6UIFsEeaG-Y7D3-yA8Q" Name="TipologiaNotifica">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">TipologiaNotifica.get(Process.getActivityLoopIndex());</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequest</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="tipologiaOLODestinatario">
                      <xpdExt:ScriptInformation Id="_JFQ3EI05Eea-bLhcpSAI2w" Name="TargetNotifica"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">TargetNotifica.get(Process.getActivityLoopIndex());</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDEventoOrdineNOW">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ManageNotificationDTU.idEventoOrdnNowWhls</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="CodiceEsito">
                      <xpdl2:Actual ScriptGrammar="JavaScript">CodiceEsitoNotifica</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDAssetConsistenza">
                      <xpdExt:ScriptInformation Id="_tqaMkH0LEeeHKZ_OMUyMqA" Name="Script1">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(TargetNotifica.get(Process.getActivityLoopIndex()) == &quot;DONATING&quot;)&#xD;
{&#xD;
	if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZAFONIA&quot;)&#xD;
	{&#xD;
		IDAssetConsistenzaFonia;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZADATI&quot;)&#xD;
	{&#xD;
		IDAssetConsistenzaDati;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZACPS&quot;) // SM_9151&#xD;
	{&#xD;
		IDAssetConsistenzaCPS.get(Process.getActivityLoopIndex()); //SM_9676 - IDAssetConsistenzaCPS è multiplo&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZARACCOLTA&quot;) 		//RU_1058&#xD;
	{&#xD;
		IDAssetConsistenzaRaccolta;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZACANALE&quot;) 			//RU_1180&#xD;
	{&#xD;
		IDAssetConsistenzaCanale;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZAFEEDER&quot;) 			//RU_1180&#xD;
	{&#xD;
		IDAssetConsistenzaFeeder;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZASEDEOLT&quot;) 		//RU_1180&#xD;
	{&#xD;
		IDAssetConsistenzaSedeOLT;&#xD;
	}&#xD;
	else if(ComponenteDonating.get(Process.getActivityLoopIndex()) == &quot;CONSISTENZAVLANMULTICAST&quot;)   //RU_1180&#xD;
	{&#xD;
		IDAssetConsistenzaVlanMulticast;&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		&quot;NULL&quot;;&#xD;
	}&#xD;
}&#xD;
else&#xD;
{&#xD;
	&quot;NULL&quot;;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="localRequest">
                      <xpdl2:Actual ScriptGrammar="JavaScript">localRequestTEMP</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="CodificaOLOAGCOM">
                      <xpdExt:ScriptInformation Id="_2flO0MiuEemr1ZXYCiZGdw" Name="CodiceOperatoreDonatingNP"/>
                      <xpdl2:Actual ScriptGrammar="JavaScript">//SM_8716&#xD;
var codiceOperatoreDonating = &quot;&quot;;&#xD;
codiceOperatoreDonating = null;&#xD;
&#xD;
//SM_10766&#xD;
var OloRetailer = &quot;&quot;;&#xD;
OloRetailer = null;&#xD;
&#xD;
&#xD;
if((localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNP&#xD;
    ||localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLNP      //SM_10766&#xD;
	||localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUULLDNP&#xD;
	||localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUSLUNP)&#xD;
&amp;&amp; TargetNotifica.get(Process.getActivityLoopIndex()) == &quot;DONATING&quot;)&#xD;
{&#xD;
	&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY)&#xD;
		{&#xD;
			for(var j = 0; j &lt; currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
			{&#xD;
				var attributo = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONATING)&#xD;
				{&#xD;
					codiceOperatoreDonating = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NP (SP) con CodiceOperatoreDonating: &quot;+codiceOperatoreDonating);&#xD;
				}&#xD;
				//SM_10766&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OLORETAILER)&#xD;
				{&#xD;
					OloRetailer = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovata NP (SP) con OloRetailer: &quot;+OloRetailer);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//RU_1346: per la DEL 103 le notifiche vanno inviate al RETURNING che coincide o meno con l'OLORETAILER della consistenza&#xD;
if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
   &amp;&amp; localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG&#xD;
   &amp;&amp; localRequest.flagDelibera103 == &quot;Y&quot; &#xD;
   &amp;&amp; localRequest.codiceOperatoreReturning != null &amp;&amp; localRequest.codiceOperatoreReturning != &quot;&quot;)&#xD;
{&#xD;
	localRequest.codiceOperatoreReturning;&#xD;
}&#xD;
//SM_10766&#xD;
else if(OloRetailer != null)&#xD;
{&#xD;
	OloRetailer;&#xD;
}&#xD;
else //solito&#xD;
{&#xD;
	codiceOperatoreDonating;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:TransitionRestrictions>
                <xpdl2:TransitionRestriction>
                  <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
                </xpdl2:TransitionRestriction>
              </xpdl2:TransitionRestrictions>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="75.0" Width="112.0">
                  <xpdl2:Coordinates XCoordinate="389.0" YCoordinate="191.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Initiated">
                  <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier=&quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.OLO.xpdl.TINOWNotificaOLO&quot;;&#xD;
localRequest.IDAnagraficaCausale = IDAnagraficaCausale.get(Process.getActivityLoopIndex());</xpdExt:Information>
                </xpdExt:AuditEvent>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">Process.auditLog(&quot;CodiceEsitoNotifica: &quot; + CodiceEsitoNotifica);&#xD;
&#xD;
// Gestione Concorrenza Flash Fiber&#xD;
localRequest.IDAnagraficaCausaleGUI = localRequestTEMP.IDAnagraficaCausaleGUI;&#xD;
localRequest.IDNotificaDonating = localRequestTEMP.IDNotificaDonating;&#xD;
localRequest.IDNotificaDonor = localRequestTEMP.IDNotificaDonor;&#xD;
localRequest.IDNotifica = localRequestTEMP.IDNotifica;</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_-gfQwJSLEeaoz6QqwJkuNg" Name="StartEvent3" xpdExt:Visibility="Private" xpdExt:DisplayName="Start Event (3)">
              <xpdl2:Event>
                <xpdl2:StartEvent Trigger="None"/>
              </xpdl2:Event>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="82.0" Width="70.0">
                  <xpdl2:Coordinates XCoordinate="47.0" YCoordinate="191.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">//Valorizzazione della RDAC per NIFINEACCODAMENTO&#xD;
/*&#xD;
&#xD;
Commentato a seguito della fix della SM_10763: script spostato in &quot;RecuperoAsseteTipoNotifica&quot;&#xD;
&#xD;
if(Process.getActivityLoopIndex() == 1&#xD;
&amp;&amp; localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINEACCODAMENTO &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.RDAC != null)&#xD;
{&#xD;
	localRequest.ordine.DACRimodulata = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.RDAC);&#xD;
}&#xD;
*/&#xD;
Process.auditLog(&quot;Invio Notifica di TIPO: &quot; + TipologiaNotifica.get(Process.getActivityLoopIndex()) + &quot; al destinatario: &quot; + TargetNotifica.get(Process.getActivityLoopIndex()));&#xD;
</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_-gf30ZSLEeaoz6QqwJkuNg" Name="EndEvent3" xpdExt:Visibility="Private" xpdExt:DisplayName="End Event (3)">
              <xpdl2:Event>
                <xpdl2:EndEvent Result="None"/>
              </xpdl2:Event>
