												//CAUSALEESITO&#xD;
												if((((NOMESERVIZIOOF == &quot;TLC1&quot; || (NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)) &amp;&amp; (ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;))&#xD;
												     ||(NOMESERVIZIOOF == &quot;TLC3&quot; &amp;&amp; ESITOSERVIZIO == &quot;1&quot;)&#xD;
													 ||(NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null &amp;&amp; ESITOCONSEGNAAPPARATO == &quot;1&quot;)) &amp;&amp; !foundCAUSALEESITO&#xD;
												 &amp;&amp; ((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
												      ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)))    //MIG RIENTRI DEL82&#xD;
												{&#xD;
												    attributoDaAggiungere1.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO;&#xD;
												    attributoDaAggiungere1.valoreAttributo = CODICEMOTIVAZIONECONSEGNA;&#xD;
													currentDettRICH.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere1));&#xD;
													Process.auditLog(&quot;Creato attributo CAUSALEESITO&quot;+ attributoDaAggiungere1.valoreAttributo +&quot; su componente con IDDett &quot;+currentDettRICH.IDDettaglioOrdine);&#xD;
													foundCAUSALEESITO = true;&#xD;
												}&#xD;
												//DECRIZIONEESITO&#xD;
												if((((NOMESERVIZIOOF == &quot;TLC1&quot; || (NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)) &amp;&amp; (ESITOCONSEGNAAPPARATO == &quot;0&quot; || ESITOCONSEGNAAPPARATO == &quot;5&quot;))&#xD;
												     ||(NOMESERVIZIOOF == &quot;TLC3&quot; &amp;&amp; ESITOSERVIZIO == &quot;1&quot;)&#xD;
													 ||(NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null &amp;&amp; ESITOCONSEGNAAPPARATO == &quot;1&quot;)) &amp;&amp; !foundDESCRIZIONEESITO&#xD;
												 &amp;&amp; ((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
												      ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)))    //MIG RIENTRI DEL82&#xD;
												{&#xD;
												    attributoDaAggiungere1.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITO;&#xD;
												    attributoDaAggiungere1.valoreAttributo = MOTIVAZIONECONSEGNA;&#xD;
													currentDettRICH.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere1));&#xD;
													Process.auditLog(&quot;Creato attributo DECRIZIONEESITO&quot;+ attributoDaAggiungere1.valoreAttributo +&quot; su componente con IDDett &quot;+currentDettRICH.IDDettaglioOrdine);&#xD;
													foundDESCRIZIONEESITO = true;&#xD;
												}&#xD;
											}&#xD;
										}&#xD;
									}					&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}		&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
