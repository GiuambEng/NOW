															     ||(NOMESERVIZIOOF == &quot;TLC3&quot; &amp;&amp; ESITOSERVIZIO == &quot;1&quot;)&#xD;
																 ||(NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null &amp;&amp; ESITOCONSEGNAAPPARATO == &quot;1&quot;))&#xD;
															&amp;&amp; CODICEMOTIVAZIONECONSEGNA != null&#xD;
															&amp;&amp; ((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
															     ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)))   //MIG RIENTRI DEL82&#xD;
													{&#xD;
