            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,0" Height="92.0" LaneId="_Rt2LccTQEe6uaO1lKvj96Q" Width="150.0">
              <xpdl2:Coordinates XCoordinate="1931.0" YCoordinate="256.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//NOTA PER SM_11316&#xD;
//Ogni volta che si aggiorna questo script va aggiornato anche il BW per aggiornamento dello stato sulla EVENTI_OF_TO_BPM_SEMAFORO&#xD;
&#xD;
if(TipoEmissione == &quot;EMISSIONEOF&quot;)&#xD;
{	&#xD;
	localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.RICHIESTAOFINVIATA;&#xD;
}&#xD;
else if(TipoEmissione == &quot;ANNULLAMENTO_AUTO_OF&quot;)&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.INRICHIESTAANNULLAMENTOAUTO;&#xD;
}&#xD;
else if(TipoEmissione == &quot;ANNULLAMENTO_OF&quot;)  //RU_1451&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
	localRequest.statoRichiestaOF = it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.INRICHIESTAANNULLAMENTO;&#xD;
}&#xD;
else if(TipoEmissione == &quot;DESOSPENSIONE_OF&quot;)  //RU_1451&#xD;
{	&#xD;
	localRequest.statoRichiestaOF = localRequest.statoRichiestaPrecedOF;&#xD;
	&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;	&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERY;&#xD;
	localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
}&#xD;
else if(TipoEmissione == &quot;CESSAZIONE_OF&quot;)&#xD;
{	&#xD;
	localRequest.statoRichiestaPrecedOF = localRequest.statoRichiestaOF;&#xD;
