        <xpdl2:Activity Id="_dgJA0ecoEeyiyIPnh5gNRA" Name="TeminatingMgmtGateway" xpdExt:DisplayName="TeminatingMgmtGateway">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_BaAAEOcpEeyiyIPnh5gNRA"/>
                  <xpdl2:TransitionRef Id="_r4iNQOcpEeyiyIPnh5gNRA"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="71.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="204.0">
              <xpdl2:Coordinates XCoordinate="2918.0" YCoordinate="1015.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_6xCvEucoEeyiyIPnh5gNRA" Name="TerminatingManagement" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Terminating Management">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var found = false;&#xD;
var i = 0;&#xD;
while (!found &amp;&amp;  i &lt; localRequest.ordine.dettaglioordine.size()){&#xD;
	var currentDettOrd = localRequest.ordine.dettaglioordine.get(i);&#xD;
	if (currentDettOrd.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIACCESSO){&#xD;
		for (var j = 0; j &lt; currentDettOrd.attributiDettaglioOrdine.size(); j ++) &#xD;
		{&#xD;
			var currentAttrDettOrd = currentDettOrd.attributiDettaglioOrdine.get(j);&#xD;
			if ( currentAttrDettOrd.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDODR){&#xD;
				if(currentAttrDettOrd.valoreAttributo != &quot;&quot;){&#xD;
					localRequest.IDRisorsa = currentAttrDettOrd.valoreAttributo;&#xD;
					localRequest.ordine.IDRisorsa = currentAttrDettOrd.valoreAttributo;&#xD;
					found = true;&#xD;
				}&#xD;
				else{&#xD;
					Process.auditLog(&quot;E' presente un attributo ID_ODR con valore vuoto: '&quot;+currentAttrDettOrd.valoreAttributo +&quot;'&quot;);&#xD;
				}&#xD;
			}	&#xD;
			else {&#xD;
				Process.auditLog(&quot;Non è presente nessun attributo ID_ODR&quot;);&#xD;
			}			&#xD;
		}&#xD;
		&#xD;
	}&#xD;
	else {&#xD;
		   Process.auditLog(&quot;Non è presente nessuna componente DTU DATI ACCESSO&quot;);&#xD;
		 }&#xD;
	i++;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="128,0,255" Height="63.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="172.0">
              <xpdl2:Coordinates XCoordinate="3108.0" YCoordinate="1015.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_D0gYIGwGEe2uGOU4BUCx3g" Name="InvioaFFFC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Invio a FF/FC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT DI INVIO A FF/FC - trasformato in script con la SM_10812&#xD;
inviaFF_FC = false;&#xD;
&#xD;
var generated = false;&#xD;
&#xD;
//RU_1150 - per GPON va chiamato nel for each notifica e non qui&#xD;
//RU_1543 - per FULLGPON non vanno inviati eventi a FC&#xD;
if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS&#xD;
    || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA)&#xD;
{&#xD;
	inviaFF_FC = false;&#xD;
}&#xD;
else&#xD;
{&#xD;
	// LOGICA DI INVIO PRE-R1F-20-0321&#xD;
	if(((ManageNotificationDTU.EVENTO_NOTIFICA != null //Annullamento&#xD;
	&amp;&amp; &#xD;
	ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO&#xD;
	&amp;&amp;&#xD;
	ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == '025')&#xD;
	&amp;&amp;&#xD;
	(localRequest.operatoreRete == 'FF' || localRequest.operatoreRete == 'FC')&#xD;
	&amp;&amp; &#xD;
	(!FFChiuso))&#xD;
	|| //Tutti gli altri casi&#xD;
	(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp; (localRequest.operatoreRete == 'FF' || localRequest.operatoreRete == 'FC') &amp;&amp;&#xD;
	((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TRANSACTION_ID.slice(0,8)!='INTERNAL' &amp;&amp; (!flagCausaleN28 || !inviataAttFF_FC)) || //Bug #32964 aggiunto !inviataAttFF_FC: se è arrivato espletamento con causale N28 ma NON è stata inviata Attivazione FF, inviare lo stesso configurazione logica -> Attivazione FF&#xD;
	  (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRESAAPPUNTAMENTO) ||&#xD;
	  (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINEACCODAMENTO) ||&#xD;
	  (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO &amp;&amp;&#xD;
									((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
										&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;N28&quot;&#xD;
										&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;054&quot;&#xD;
										&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;055&quot;) || //SM_8218 - Invio solo se Espletamento OK o Espletamento KO Definitivo&#xD;
									 (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE &#xD;
										&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015))) ||&#xD;
	  ((StateMachineValidationResponse_new != null &amp;&amp; StateMachineValidationResponse_new.FLAG_ALTRO_OPERATORE == 'Y') &amp;&amp; // Condizioni con FLAG ALTRO OPERATORE Y&#xD;
		((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE) ||&#xD;
		 (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NITENTATIVOCONTATTO) ||&#xD;
		 (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINETENTATIVOCONTATTO) ||&#xD;
		 (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO) ||&#xD;
		 (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIASSEGNAZIONESUPPORTO&#xD;
		   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;033&quot;)))))) // RU_1063: aggiunta NIASSEGNAZIONESUPPORTO con causale 033&#xD;
	{&#xD;
		inviaFF_FC = true;&#xD;
	}&#xD;
&#xD;
	// LOGICHE DI INVIO AGGIUNTE CON R1F-20-0321 per FIBERCOP&#xD;
	else if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp; localRequest.operatoreRete == 'FC'&#xD;
	&amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO&#xD;
	 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRENOTAZIONENUMERO&#xD;
	 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE&#xD;
	 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA)) //SM_9994: aggiunta VTT&#xD;
	{&#xD;
		inviaFF_FC = true;&#xD;
	}&#xD;
&#xD;
	// LOGICHE DI INVIO AGGIUNTE CON R1F-20-0321 per FIBERCOP dedicate all'espletamento di asset FC (19 Casi su C05M02)&#xD;
	// SM_11087 - LOGICHE DI INVIO PER CASO 15 E CASO 16 BIS IN CUI CONTROLLIAMO OPERATORERETE IN CHIARO (RU_1386)&#xD;
	else if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
	&amp;&amp; (OperatoreReteCONSDATI == &quot;FC&quot; || OperatoreReteCONSFONIA == &quot;FC&quot;&#xD;
	    || ((localRequest.codiceTrasformazione == &quot;TSHA_ULLD&quot; || localRequest.codiceTrasformazione == &quot;TCOND_NAKED&quot;)&#xD;
	        &amp;&amp; localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.INTERNAL&#xD;
	        &amp;&amp; localRequest.operatoreRete == &quot;FC&quot;))&#xD;
			)&#xD;
	{&#xD;
		inviaFF_FC = true;&#xD;
		generated = true;&#xD;
	}&#xD;
&#xD;
&#xD;
	// ============ LOGICHE DI INIBIZIONE INVIO VERSO FF_FC ============&#xD;
&#xD;
	// SM_9820: se non è un'attivazione/cessazione, e non si tratta di uno dei 17 casi da inviare per generazione da asset FC, allora non inviare a FF/FC.&#xD;
	if(localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE &#xD;
	   &amp;&amp; localRequest.lavorazione != it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.CESSAZIONE&#xD;
	   &amp;&amp; inviaFF_FC)&#xD;
	{&#xD;
		//ECCEZIONI in cui chiamare a prescindere - Se è una PDR/VTT o è un caso da generare da asset FC per Espletamento&#xD;
		if((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA &amp;&amp;&#xD;
			ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE)&#xD;
		&amp;&amp; !generated)&#xD;
		{&#xD;
			inviaFF_FC = false;&#xD;
		}&#xD;
	}&#xD;
	//SM_10891: Se è un CAMBIO TECNOLOGIA - ATTIVAZIONE - EVENTO ESPLETAMENTO KO, se non è stato inviata un'attivazione non inviare nulla&#xD;
	//Task #41331: aggiunta NIACCODAMENTO -> non deve inviare l'evento di ATTIVAZIONE, ma solo SOSPENSIONE (post ATTIVAZIONE della NICNFIGURAZIONELOGICA) &#xD;
	//Bug #41556: aggiunta NFCONFERMAANNULLAMENTO&#xD;
	else if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
			&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &#xD;
			&amp;&amp; ((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
			         &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015)&#xD;
			    ||ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO&#xD;
				||ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO)   &#xD;
			&amp;&amp; !inviataAttFF_FC)&#xD;
	{&#xD;
		inviaFF_FC = false;&#xD;
	}&#xD;
	&#xD;
	&#xD;
	//SM_10812: per NIACCODAMENTO, bisogna inviare la SOSPENSIONE a FC solo se è stato inviato evento di ATTIVAZIONE&#xD;
	/*else if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &#xD;
			&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO&#xD;
			&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA&#xD;
			&amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
			    ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)&#xD;
			&amp;&amp; !inviataAttFF_FC)&#xD;
	{&#xD;
		var OffertaConsistenzaDati = &quot;&quot;;&#xD;
		OffertaConsistenzaDati = null;&#xD;
&#xD;
		for(var i= 0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
			{&#xD;
				for(var j=0; j&lt;currentDettOrdine.attributiDettaglioOrdine.size(); j++)&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OFFERTA)&#xD;
					{&#xD;
						OffertaConsistenzaDati = currentAttDettOrdine.valoreAttributo;						&#xD;
						Process.auditLog(&quot;Offerta della CONSISTENZADATI: &quot;+OffertaConsistenzaDati);&#xD;
					}&#xD;
				}&#xD;
			}		&#xD;
		}&#xD;
		&#xD;
		if(OffertaConsistenzaDati == &quot;VULAFTTH&quot;&#xD;
		  ||OffertaConsistenzaDati == &quot;SEMIVULAFTTH&quot;&#xD;
		  ||OffertaConsistenzaDati == &quot;BITSTREAMNGAFTTH&quot;&#xD;
		  ||OffertaConsistenzaDati == &quot;SEMIBITSTREAMNGAFTTH&quot;&#xD;
		  ||OffertaConsistenzaDati == &quot;EASYIPNGAFTTH&quot;&#xD;
		  ||OffertaConsistenzaDati == &quot;SEMIEASYIPNGAFTTH&quot;)&#xD;
		{&#xD;
			inviaFF_FC = false;&#xD;
		}&#xD;
	}*/&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="68.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="103.0">
              <xpdl2:Coordinates XCoordinate="3108.0" YCoordinate="1303.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_0x-XoGwGEe2uGOU4BUCx3g">
          <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                <xpdl2:TransitionRefs>
                  <xpdl2:TransitionRef Id="_1E3ecGwGEe2uGOU4BUCx3g"/>
                  <xpdl2:TransitionRef Id="_QvNekGwHEe2uGOU4BUCx3g"/>
                </xpdl2:TransitionRefs>
              </xpdl2:Split>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="45.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="43.0">
              <xpdl2:Coordinates XCoordinate="3108.0" YCoordinate="1382.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
        </xpdl2:Activity>
        <xpdl2:Activity Id="_b2dJgCCVEe6JLcNJfzFUeA" Name="2_RecuperoAsseteTipoNotifica2" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="2_Recupero Asset e TipoNotifica 2">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT DIVISO IN DUE CON LA RU_1393 DI C09 2023&#xD;
&#xD;
//Cerca strutturaLinea per logiche successive&#xD;
var trovataStruttura = false;&#xD;
var STRUTTURALINEA = &quot;&quot;;&#xD;
STRUTTURALINEA = null;&#xD;
		&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while(!trovataStruttura &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STRUTTURALINEA)&#xD;
			{&#xD;
				trovataStruttura = true;&#xD;
				STRUTTURALINEA = currentAttDettOrdine.valoreAttributo;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//SM_10051&#xD;
OLpreMarchiatoFC = false;&#xD;
OLnewMarchiatoFC = false;&#xD;
&#xD;
//LOGICA DEDICATA ALLA RISALITA DI DTUDATIOPERATORERETE -> FIBERCOP. In teoria non dovrebbe sovrapporsi alla logica &#xD;
//di Flash Fiber fatta su NICONFIGURAZIONELOGICA solo per FTTH (questo perché non risalgono insieme attributi FF e FC)&#xD;
//R1F-20-0321&#xD;
if(localRequest.operatoreRete != 'INFR' &amp;&amp;         //RU_1198&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA&#xD;
|| (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRENOTAZIONENUMERO&#xD;
		&amp;&amp; String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
		&amp;&amp; (STRUTTURALINEA == 'PBX'|| STRUTTURALINEA == 'GNR'))&#xD;
|| (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO)&#xD;
|| (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA //SM_9994&#xD;
		&amp;&amp; (String(localRequest.tipologiaSottolav).slice(0,8) ==&quot;TRASLOCO&quot;&#xD;
				&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
				 || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;)&#xD;
				&amp;&amp; (STRUTTURALINEA == &quot;PBX&quot; || STRUTTURALINEA == &quot;GNR&quot;)))&#xD;
|| (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE&#xD;
		&amp;&amp; (String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;&#xD;
		 || String(localRequest.offerta).slice(0,4) == &quot;VULL&quot;&#xD;
		 || String(localRequest.offerta).slice(0,3) == &quot;ULL&quot;&#xD;
		 || String(localRequest.offerta).slice(0,3) == &quot;SLU&quot;))))&#xD;
{&#xD;
	Process.auditLog('Tipologia Notifica: '+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+', Offerta: '+localRequest.offerta+', Arricchimenti: '+ManageNotificationDTU.ARRICCHIMENTI.size());&#xD;
&#xD;
	var foundDATIOPERATORERETE = false;&#xD;
	var i = 0;&#xD;
	var j = 0;&#xD;
	var k = 0;&#xD;
	&#xD;
	// Cerca Arricchimento dettaglio ordine&#xD;
	while(!foundDATIOPERATORERETE &amp;&amp; i &lt; ManageNotificationDTU.ARRICCHIMENTI.size())&#xD;
	{&#xD;
		var ARRICCHIMENTItemp = ScriptUtil.copy(ManageNotificationDTU.ARRICCHIMENTI.get(i));&#xD;
		&#xD;
		Process.auditLog('Ciclo Arricchimenti: '+i);&#xD;
		&#xD;
		if(ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size() > 0)&#xD;
		{&#xD;
			j = 0;&#xD;
			// Cerca Dettaglio ordine DTUCONFIGURAZIONE&#xD;
			while(!foundDATIOPERATORERETE &amp;&amp; j &lt; ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size())&#xD;
			{&#xD;
				Process.auditLog('Ciclo Dettaglio Ordine: '+j);&#xD;
				var currentDettOrdine = ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.get(j);&#xD;
				&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_v1_DizionarioComponentiEnumeration.DTUDATIOPERATORERETE)&#xD;
				{&#xD;
					Process.auditLog('Trovata componente: '+currentDettOrdine.nomeComponente);&#xD;
					foundDATIOPERATORERETE = true;&#xD;
				}&#xD;
				j++;&#xD;
			}	&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(foundDATIOPERATORERETE)&#xD;
	{&#xD;
		// ------- ORDINE NON CARATTERIZZATO -------&#xD;
		if(localRequest.operatoreRete != 'FC')&#xD;
		{&#xD;
			//Per tutti gli OL la prima caratterizzazione può arrivare sulla Configurazione Logica&#xD;
			if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA&#xD;
			//Per alcuni OL la prima caratterizzazione può arrivare anche sulla PDR (WLR/VULL/ULL/SLU) o sulla PRENOTAZIONE_NUMERO (WLR e PBX/GNR) - condizioni sulle offerte presente nell'IF esterno&#xD;
			|| ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE&#xD;
		    || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRENOTAZIONENUMERO&#xD;
			//Per gli OL DATI non-FTTH la prima caratterizzazione può arrivare anche sulla NIACCODAMENTO&#xD;
			||(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO &#xD;
				&amp;&amp;(localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NGA&#xD;
				|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.XDSL&#xD;
				|| localRequest.strutturaRichiesta == it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.FWA)&#xD;
				&amp;&amp;(localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
				&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH&#xD;
				&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH&#xD;
				&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
				&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
				&amp;&amp; localRequest.offerta != it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)))&#xD;
			{	&#xD;
				localRequest.ordine.operatoreRete = 'FC';		&#xD;
				localRequest.operatoreRete = 'FC';&#xD;
				OLnewMarchiatoFC = true;&#xD;
				Process.auditLog(&quot;OL caratterizzato FC per risalita della: &quot;+String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA)+&quot;, offerta: &quot;+String(localRequest.offerta));&#xD;
			}&#xD;
			//Per le altre notifiche DATIOPERATORERETE deve essere ignorato e non viene fatta caratterizzazione&#xD;
			else&#xD;
			{&#xD;
				Process.auditLog(&quot;OL NON caratterizzato FC DATIOPERATORERETE ignorato risalita della: &quot;+String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA)+&quot;, offerta: &quot;+String(localRequest.offerta));&#xD;
			}&#xD;
		}&#xD;
		// ------- ORDINE GIA' CARATTERIZZATO -------&#xD;
		else&#xD;
		{&#xD;
			localRequest.ordine.operatoreRete = 'FC';		&#xD;
			localRequest.operatoreRete = 'FC';&#xD;
			OLpreMarchiatoFC = true;&#xD;
			Process.auditLog(&quot;OL pre-caratterizzato FC&quot;);&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//C02M15F04 -> id fonia (numero prenotato) in id correlato&#xD;
if(localRequest.ordine != null &amp;&amp; localRequest.lavorazione != null &amp;&amp; &#xD;
		(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || &#xD;
		  (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE &amp;&amp; //SM_8635: aggiunto VARIAZIONE (CAMBIONUMERO3/CAMBIONUMERO4)&#xD;
			(localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO3 &#xD;
		  || localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIONUMERO4)))&#xD;
	&amp;&amp; localRequest.offerta != null &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA &#xD;
									 || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA) &amp;&amp;&#xD;
	ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRENOTAZIONE_NUMERO != null)&#xD;
{&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	&#xD;
	if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.WLRLINEANONATTIVA&#xD;
		|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULLLINEANONATTIVA)&#xD;
	{&#xD;
		localRequest.IDRisorsa = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRENOTAZIONE_NUMERO.NUMPRENOTATO;&#xD;
		localRequest.ordine.IDRisorsa = localRequest.IDRisorsa;&#xD;
		localRequest.ordine.IDRisorsaNOW = localRequest.IDRisorsa;&#xD;
		localRequest.ordine.numeroTelefonico = localRequest.IDRisorsa;&#xD;
		localRequest.numeroTelefonico = localRequest.IDRisorsa;&#xD;
		&#xD;
		var trovatoNumTel = false;&#xD;
		&#xD;
		for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(String(currentDettOrdine.nomeComponente).slice(0, 7) == &quot;ACCESSO&quot;)&#xD;
			{&#xD;
				var j = 0;&#xD;
				while(!trovatoNumTel &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
				{&#xD;
					var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO)&#xD;
					{&#xD;
						trovatoNumTel = true;&#xD;
						currentAttDettOrdine.valoreAttributo = localRequest.IDRisorsa;&#xD;
					}&#xD;
					j++;&#xD;
				}&#xD;
				&#xD;
				if(!trovatoNumTel)&#xD;
				{&#xD;
					var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					&#xD;
					attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributo.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
					attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributo.created = date;&#xD;
					attributo.lastUpdate = date;&#xD;
					attributo.operatore = &quot;BPM&quot;;&#xD;
					attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICO;&#xD;
					attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
					currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		&#xD;
		// RU_832 - Ricalcolo del distretto con NI_PRENOTAZIONE_NUMERO&#xD;
		if(localRequest.numeroTelefonico != null)&#xD;
		{&#xD;
			var tel = localRequest.numeroTelefonico;&#xD;
			&#xD;
			if(tel.charAt(1) == &quot;2&quot;&#xD;
				|| tel.charAt(1) == &quot;6&quot;)&#xD;
			{&#xD;
				localRequest.ordine.distretto = &quot;0&quot; + tel.slice(0,2);&#xD;
			}&#xD;
			else if(tel.charAt(2) == &quot;0&quot;&#xD;
					|| tel.charAt(2) == &quot;1&quot;&#xD;
					|| tel.charAt(2) == &quot;5&quot;&#xD;
					|| tel.charAt(2) == &quot;9&quot;)&#xD;
			{&#xD;
				localRequest.ordine.distretto = tel.slice(0,3);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.ordine.distretto = tel.slice(1,4);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size();i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI){&#xD;
			var trovato = false;&#xD;
			var j=0;&#xD;
			while(j&lt;componente.attributiDettaglioOrdine.size() &amp;&amp; !trovato){&#xD;
				&#xD;
				var attribIdCorrelato = componente.attributiDettaglioOrdine.get(j);&#xD;
				if(attribIdCorrelato.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.IDRISORSACORRELATO){&#xD;
					trovato=true;&#xD;
					attribIdCorrelato.valoreAttributo = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRENOTAZIONE_NUMERO.NUMPRENOTATO;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(!trovato){&#xD;
						&#xD;
			attribIdCorrelato.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
			attribIdCorrelato.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
			attribIdCorrelato.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
			attribIdCorrelato.created = date;&#xD;
			attribIdCorrelato.lastUpdate = date;&#xD;
			attribIdCorrelato.operatore = &quot;BPM&quot;;&#xD;
			attribIdCorrelato.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDRISORSACORRELATO;&#xD;
			attribIdCorrelato.valoreAttributo = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRENOTAZIONE_NUMERO.NUMPRENOTATO;&#xD;
			componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attribIdCorrelato));&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
if(StateMachineValidationResponse_new!=null)&#xD;
{&#xD;
	var invioNotifica = true;&#xD;
	&#xD;
	// *** RU_778 - non creare notifica per OLO Donating TLC, Richiesta Migrazione e Struttura Linea PBX o GNR ***&#xD;
	if((ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO ||&#xD;
	    ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO) &amp;&amp;&#xD;
	   localRequest.codificaOLOAGCOMDonating == 'TLC' &amp;&amp;&#xD;
	   localRequest.lavorazione ==  it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
	{&#xD;
		if(STRUTTURALINEA == 'PBX'|| STRUTTURALINEA == 'GNR')&#xD;
		{&#xD;
			invioNotifica = false;&#xD;
			Process.auditLog(String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA)+&quot;: Trovata struttura linea &quot;+currentAttDettOrdine.valoreAttributo+&quot;, lavorazione &quot;+localRequest.lavorazione+&quot;, Donating &quot;+localRequest.codificaOLOAGCOMDonating+&quot;. Notifica non creata&quot;);&#xD;
		}&#xD;
	}&#xD;
	// ********************************************************************************************************&#xD;
	&#xD;
	var idAnagraficaCausaleAggiornata = false;&#xD;
	var causaleScolpita = &quot;&quot;;&#xD;
	causaleScolpita = null;&#xD;
	&#xD;
	for(var i=0; i&lt;StateMachineValidationResponse_new.NOTIFICA.size();i++)&#xD;
	{&#xD;
		var notifica = StateMachineValidationResponse_new.NOTIFICA.get(i);&#xD;
		if(notifica.ID_ANAGRAFICA_CAUSALE!= null &amp;&amp; notifica.ID_ANAGRAFICA_CAUSALE!=&quot;&quot; &amp;&amp; invioNotifica)&#xD;
		{&#xD;
&#xD;
			if(!idAnagraficaCausaleAggiornata)&#xD;
			{&#xD;
				localRequest.IDAnagraficaCausale = notifica.ID_ANAGRAFICA_CAUSALE;&#xD;
				idAnagraficaCausaleAggiornata=true;&#xD;
			}&#xD;
&#xD;
			var quantitaNotificheAggiunte = 0;&#xD;
			&#xD;
			if(notifica.ID_NOTIFICA_DONATING!= null &amp;&amp; notifica.ID_NOTIFICA_DONATING!=&quot;&quot; &#xD;
			&amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
			&amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA)&#xD;
			{&#xD;
				Process.auditLog(&quot;IDNotifica: &quot; + notifica.ID_NOTIFICA_DONATING + &quot; per DONATING NON AGGIUNTO per sottolav: &quot;+localRequest.tipologiaSottolav);&#xD;
			}&#xD;
			else if(notifica.ID_NOTIFICA_DONATING!= null &amp;&amp; notifica.ID_NOTIFICA_DONATING!=&quot;&quot; &amp;&amp; notifica.COMPONENTE_DONATING != &quot;CONSISTENZACPS&quot;){ //SM_9676: le componenti_donating CONSISTENZACPS vengono gestite a parte (vedi dopo)&#xD;
				Process.auditLog(&quot;Aggiungo IDNotifica: &quot; + notifica.ID_NOTIFICA_DONATING + &quot; per DONATING con COMPONENTE&quot; + notifica.COMPONENTE_DONATING);&#xD;
				TipologiaNotifica.add(notifica.ID_NOTIFICA_DONATING);&#xD;
				TargetNotifica.add(&quot;DONATING&quot;);&#xD;
				ComponenteDonating.add(notifica.COMPONENTE_DONATING);&#xD;
				IDAssetConsistenzaCPS.add(&quot;NULL&quot;); //SM_9676&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			if(notifica.ID_NOTIFICA_DONOR!=null &amp;&amp; notifica.ID_NOTIFICA_DONOR!=&quot;&quot;){&#xD;
				Process.auditLog(&quot;Aggiungo IDNotifica: &quot; + notifica.ID_NOTIFICA_DONOR + &quot; per DONOR&quot;);&#xD;
				TipologiaNotifica.add(notifica.ID_NOTIFICA_DONOR);&#xD;
				TargetNotifica.add(&quot;DONOR&quot;);&#xD;
				ComponenteDonating.add(&quot;NULL&quot;);&#xD;
				IDAssetConsistenzaCPS.add(&quot;NULL&quot;); //SM_9676&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			if(notifica.ID_NOTIFICA_RECIPIENT!= null &amp;&amp; notifica.ID_NOTIFICA_RECIPIENT!= &quot;&quot;){&#xD;
				Process.auditLog(&quot;Aggiungo IDNotifica: &quot; + notifica.ID_NOTIFICA_RECIPIENT + &quot; per RECIPIENT&quot;);&#xD;
				TipologiaNotifica.add(notifica.ID_NOTIFICA_RECIPIENT);&#xD;
				TargetNotifica.add(&quot;RECIPIENT&quot;);&#xD;
				ComponenteDonating.add(&quot;NULL&quot;);&#xD;
				IDAssetConsistenzaCPS.add(&quot;NULL&quot;); //SM_9676&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			&#xD;
			for(var j=0; j&lt;quantitaNotificheAggiunte; j++)&#xD;
			{&#xD;
				//RU_975----&#xD;
				if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
				   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;015&quot;&#xD;
				   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == &quot;015&quot;&#xD;
				   &amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.CPS&#xD;
				   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
				   &amp;&amp; localRequest.ordine.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.RIENTROCPS)&#xD;
				{&#xD;
					IDAnagraficaCausale.add(628);&#xD;
					CodiceCausale.add(&quot;CPS_22&quot;);&#xD;
				}&#xD;
				//----------&#xD;
				&#xD;
				//negli altri casi&#xD;
				else &#xD;
				{&#xD;
					IDAnagraficaCausale.add(notifica.ID_ANAGRAFICA_CAUSALE);&#xD;
					CodiceCausale.add(notifica.CODICE_CAUSALE_NOW);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			// SM_8075 - Per SOSPENSIONE_FF non arrivano altre notifiche (anche per SM_9126 - per SOSPENSIONE post causale W12), ma bisogna valorizzare comunque la causale&#xD;
			if((notifica.CODICE_CAUSALE_NOW == 'SOSPENSIONE_FF' || notifica.CODICE_CAUSALE_NOW == 'W12') &amp;&amp; quantitaNotificheAggiunte == 0)&#xD;
			{&#xD;
			    causaleScolpita = notifica.CODICE_CAUSALE_NOW;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
&#xD;
	Process.auditLog(&quot;ManageNotificationDTU.STATO_SUCCESSIVO:&quot;+ManageNotificationDTU.STATO_SUCCESSIVO);&#xD;
	if(ManageNotificationDTU != null &amp;&amp; ManageNotificationDTU.STATO_SUCCESSIVO!= null &amp;&amp; (ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESO&quot; || ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESOAPPUNTAMENTO&quot; || ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESOOPERESPECIALI&quot; || ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESOATTESAPERMESSI&quot; || ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESOD82&quot; || ManageNotificationDTU.STATO_SUCCESSIVO == &quot;SOSPESOACD82&quot;) //SM_9163: aggiunto SOSPESO ATTESA PERMESSI - SM_11709: aggiunto SOSPESOD82 - SM_11749: aggiunto SOSPESOACD82&#xD;
		&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO)&#xD;
	{&#xD;
		var i=0;&#xD;
		var trovato = false;&#xD;
		var CodiceCausaleTC = &quot;&quot;;&#xD;
		var trovataIDAnagraficaCausaleTC = false;&#xD;
		var CodiceCausaleAltre = &quot;&quot;;&#xD;
		while(TipologiaNotifica != null &amp;&amp; !trovato &amp;&amp; i&lt;TipologiaNotifica.size())&#xD;
		{&#xD;
			CodiceCausaleAltre = CodiceCausale.get(i);&#xD;
			if(TipologiaNotifica.get(i).toUpperCase() == &quot;SC&quot;)&#xD;
			{&#xD;
				localRequest.codiceCausaleInterno = CodiceCausaleAltre;&#xD;
				trovato = true;&#xD;
			}&#xD;
			if(TipologiaNotifica.get(i).toUpperCase() == &quot;TC&quot;)&#xD;
			{&#xD;
				trovataIDAnagraficaCausaleTC = true;&#xD;
				CodiceCausaleTC = CodiceCausaleAltre;&#xD;
			}&#xD;
&#xD;
			i++;&#xD;
		}&#xD;
		if(!trovato)&#xD;
		{&#xD;
			Process.auditLog(&quot;Stato SOSPESO senza TipologiaNotifica SC&quot;);&#xD;
			if(trovataIDAnagraficaCausaleTC)&#xD;
			{&#xD;
				localRequest.codiceCausaleInterno = CodiceCausaleTC;&#xD;
				Process.auditLog(&quot;Trovata TipologiaNotifica TC: &quot; + localRequest.codiceCausaleInterno);&#xD;
			}&#xD;
			else if(causaleScolpita != null) // SM_8075&#xD;
			{&#xD;
				localRequest.codiceCausaleInterno = causaleScolpita;&#xD;
				&#xD;
				if(causaleScolpita == 'W12') //SM_9126&#xD;
				{&#xD;
					localRequest.IDAnagraficaCausaleGUI = localRequest.IDAnagraficaCausale;&#xD;
					Process.auditLog(&quot;Nuovo IDAnagraficaCausaleGUI: &quot;+localRequest.IDAnagraficaCausaleGUI);&#xD;
				}&#xD;
				&#xD;
				causaleScolpita = null;&#xD;
				&#xD;
				Process.auditLog(&quot;Stato SOSPESO senza TipologiaNotifica SC ne TC, causale scolpita: &quot; + localRequest.codiceCausaleInterno);&#xD;
			}&#xD;
			else&#xD;
			{&#xD;
				localRequest.codiceCausaleInterno = CodiceCausaleAltre;&#xD;
				Process.auditLog(&quot;Stato SOSPESO senza TipologiaNotifica SC ne TC: &quot; + localRequest.codiceCausaleInterno);&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	else if(ManageNotificationDTU != null&#xD;
			&amp;&amp; ManageNotificationDTU.STATO_SUCCESSIVO!= null&#xD;
			&amp;&amp; ManageNotificationDTU.STATO_SUCCESSIVO == &quot;INATTESACONFERMAANNULLAMENTO&quot;&#xD;
			&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO)&#xD;
	{&#xD;
		//In caso di NFESPLETAMENTO e stato INATTESACONFERMAANNULLAMENTO utilizza la prima causale di notifica per gestire il timer di annullamento&#xD;
		localRequest.codiceCausaleInterno = CodiceCausale.get(0);&#xD;
&#xD;
		//Temporaneamente viene schiantato a codice Z98 poiché a causa di una CR in corso le notifiche sono state temporaneamente disabilitate per questa casistica&#xD;
		//localRequest.codiceCausaleInterno = &quot;Z98&quot;;&#xD;
	}&#xD;
}&#xD;
&#xD;
for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE			//RU_1180&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER 			//RU_1180&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT			//RU_1180&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST //RU_1180&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZARACCOLTA) //RU_1058&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((IDAssetConsistenzaDati == null || IDAssetConsistenzaFonia == null || IDAssetConsistenzaRaccolta == null || IDAssetConsistenzaCanale == null || IDAssetConsistenzaFeeder == null || IDAssetConsistenzaSedeOLT == null || IDAssetConsistenzaVlanMulticast == null&#xD;
		|| OperatoreReteCONSFONIA == null || OperatoreReteCONSDATI == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{&#xD;
					IDAssetConsistenzaFonia = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACANALE)&#xD;
				{&#xD;
					IDAssetConsistenzaCanale = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFEEDER)&#xD;
				{&#xD;
					IDAssetConsistenzaFeeder = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZASEDEOLT)&#xD;
				{&#xD;
					IDAssetConsistenzaSedeOLT = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAVLANMULTICAST)&#xD;
				{&#xD;
					IDAssetConsistenzaVlanMulticast = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else // RU_1058&#xD;
				{&#xD;
					IDAssetConsistenzaRaccolta = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OPERATORERETE)&#xD;
			{&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
				{&#xD;
					OperatoreReteCONSFONIA = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					OperatoreReteCONSDATI = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	//SM_9676 - configurazione manuale, si ignora la macchina a stati.&#xD;
	else if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZACPS&#xD;
	&amp;&amp; currentDettOrdine.azione == it_telecomitalia_it_NOW_casedata_AzioneEnumeration.D&#xD;
	&amp;&amp; ManageNotificationDTU !=null &#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
	&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CODICE_ESITO == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_CodiceEsitoType._015) //ESPLETAMENTO OK&#xD;
	{&#xD;
		Process.auditLog(&quot;Aggiungo IDNotifica: NC per DONATING CPS&quot;);&#xD;
		&#xD;
		var j = 0;&#xD;
		while(j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				Process.auditLog(&quot;Aggiungo IDAssetConsistenzaCPS: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
				TipologiaNotifica.add(&quot;NC&quot;);&#xD;
				TargetNotifica.add(&quot;DONATING&quot;);&#xD;
				ComponenteDonating.add(&quot;CONSISTENZACPS&quot;);&#xD;
				IDAnagraficaCausale.add(631);&#xD;
				CodiceCausale.add(&quot;CPS_33&quot;);&#xD;
				IDAssetConsistenzaCPS.add(currentAttDettOrdine.valoreAttributo);&#xD;
				quantitaNotificheAggiunte++;&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
