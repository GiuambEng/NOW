          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">//Aggiorno campi con i valori ricevuti nella richiesta di RimodulazioneDAD&#xD;
if(DADRimodulata != null)&#xD;
{&#xD;
	localRequest.ordine.DADRimodulata = DADRimodulata;&#xD;
}&#xD;
&#xD;
if(IDFasciaOraria != null)&#xD;
{&#xD;
	localRequest.IDFasciaOraria = IDFasciaOraria;&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Aggiornati DADRimodulata: &quot; +String(DADRimodulata) + &quot; e IDFasciaOraria: &quot; +String(IDFasciaOraria));</xpdExt:Information>
