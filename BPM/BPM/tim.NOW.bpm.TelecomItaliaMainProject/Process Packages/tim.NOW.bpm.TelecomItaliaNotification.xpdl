            <xpdl2:Activity Id="_sUgkDMmREe6tB5HEgGPwCw" Name="ArricchimentoChooser" xpdExt:DisplayName="Arricchimento Chooser">
              <xpdl2:Route GatewayType="Exclusive" MarkerVisible="true" ExclusiveType="Data"/>
              <xpdl2:TransitionRestrictions>
                <xpdl2:TransitionRestriction>
                  <xpdl2:Split Type="Exclusive" ExclusiveType="Data">
                    <xpdl2:TransitionRefs>
                      <xpdl2:TransitionRef Id="_sUgkFsmREe6tB5HEgGPwCw"/>
                      <xpdl2:TransitionRef Id="_qDBdoNCkEe6KCbNLW9pKMQ"/>
                    </xpdl2:TransitionRefs>
                  </xpdl2:Split>
                </xpdl2:TransitionRestriction>
              </xpdl2:TransitionRestrictions>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="96.0" Width="112.0">
