																 ||(NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO != null &amp;&amp; ESITOCONSEGNAAPPARATO == &quot;1&quot;))&#xD;
															&amp;&amp; MOTIVAZIONECONSEGNA != null&#xD;
															&amp;&amp; ((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;0&quot;)&#xD;
															    ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;0&quot;)))    //MIG RIENTRI DEL82&#xD;
													{&#xD;
														foundDESCRIZIONEESITO = true;&#xD;
														attributoRic1.valoreAttributo = MOTIVAZIONECONSEGNA;&#xD;
														Process.auditLog(&quot;Aggiornato attributo DESCRIZIONEESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
													}&#xD;
												}&#xD;
												&#xD;
												var attributoDaAggiungere1 = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
												var data = DateTimeUtil.createDatetime();&#xD;
												attributoDaAggiungere1.IDDettaglioOrdine = currentDettRICH.IDDettaglioOrdine;&#xD;
												attributoDaAggiungere1.IDRichiestaOLO = currentDettRICH.IDRichiestaOLO;&#xD;
