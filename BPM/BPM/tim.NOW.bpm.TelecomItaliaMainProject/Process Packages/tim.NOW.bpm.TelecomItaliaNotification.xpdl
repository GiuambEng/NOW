													attributoDaAggiungere1.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO;								&#xD;
													//Espletamento negativo&#xD;
													if((StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request != null &amp;&amp; StateMachineValidationResponseOF.OF_CompletionOrder_OpenStream_Request.STATO_ORDINE == &quot;1&quot;)&#xD;
													   ||(StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request != null &amp;&amp; StateMachineValidationResponseOF.WHS_CompletionOrderMig_Request.STATO_ORDINE == &quot;1&quot;))   //MIG RIENTRI DEL82&#xD;
													{&#xD;
														attributoDaAggiungere1.valoreAttributo = &quot;KO&quot;;&#xD;
