        <xpdl2:Activity Id="_L-uf4HKpEeegkrpbGjs20Q" Name="CalcoloDestinatariDONOReALTRO" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Calcolo Destinatari DONOR e ALTRO">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">&#xD;
&#xD;
if(localRequest.strutturaRichiesta != it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.NPG)&#xD;
{&#xD;
	for(var i = 0; i &lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.NUMBERPORTABILITY&#xD;
		|| String(currentDettOrdine.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;) //SM_10242: aggiunto accesso&#xD;
		{&#xD;
			var OLO = &quot;&quot;;&#xD;
			OLO = null;&#xD;
			var j = 0;&#xD;
			&#xD;
			while(OLO == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if((currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONOR&#xD;
					|| currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEOPERATOREDONOR)&#xD;
					&amp;&amp; currentAttDettOrdine.valoreAttributo != &quot;TLC&quot;)&#xD;
				{&#xD;
					OLO = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			&#xD;
			if(OLO != null)&#xD;
			{&#xD;
				if(destinatariDONOR == null || !destinatariDONOR.contains(OLO))&#xD;
				{&#xD;
					destinatariDONOR.add(OLO);&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
var i = 0;&#xD;
&#xD;
while((IDAssetConsistenzaDati == null || IDAssetConsistenzaFonia == null || CodificaOLOAGCOMConsistenzaDati == null || CodificaOLOAGCOMConsistenzaFonia == null) &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI&#xD;
		|| currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZAFONIA)&#xD;
	{&#xD;
		var j = 0;&#xD;
		while((IDAssetConsistenzaDati == null || IDAssetConsistenzaFonia == null || CodificaOLOAGCOMConsistenzaDati == null || CodificaOLOAGCOMConsistenzaFonia == null) &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
		{&#xD;
			var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
			{&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					IDAssetConsistenzaDati = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					IDAssetConsistenzaFonia = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODIFICAOLOAGCOMDONATING)&#xD;
			{&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.CONSISTENZADATI)&#xD;
				{&#xD;
					CodificaOLOAGCOMConsistenzaDati = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				else&#xD;
				{&#xD;
					CodificaOLOAGCOMConsistenzaFonia = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
			}&#xD;
			j++;&#xD;
		}&#xD;
	}&#xD;
	i++;&#xD;
}&#xD;
&#xD;
//FF - Check sulla richiesta per valorizzare FFChiuso&#xD;
i = 0;&#xD;
FFChiuso = false;&#xD;
&#xD;
while(!FFChiuso &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
{&#xD;
	var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	Process.auditLog('Ciclo check FFChiuso: '+i+' trovata componente '+currentDettOrdine.nomeComponente);&#xD;
	&#xD;
	if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_v1_DizionarioComponentiEnumeration.FFCHIUSO)&#xD;
	{&#xD;
		FFChiuso = true;&#xD;
	}&#xD;
		&#xD;
	i++;&#xD;
}&#xD;
&#xD;
&#xD;
&#xD;
&#xD;
// CR467 - RECUPERO LISTA ARCHI DATI RECUPERABILI DALLA NOW CONFIGURATION&#xD;
var criteria = cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key=:inputKey&quot;);&#xD;
criteria.setQueryParameter(&quot;inputKey&quot;,&quot;Lista_ArchiDatiRecuperabili&quot;);&#xD;
var configurations = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(criteria);&#xD;
var Lista = &quot;&quot;;&#xD;
&#xD;
if(configurations != null &amp;&amp; configurations.size() > 0)&#xD;
{&#xD;
	var configuration = configurations.get(0).readConfiguration();	&#xD;
	Process.auditLog(&quot;Recuperata lista Archi: &quot; + configuration.value);&#xD;
	Lista = configuration.value;&#xD;
}&#xD;
&#xD;
var arcoSingolo = &quot;&quot;;&#xD;
var k = 0;&#xD;
&#xD;
while(k&lt;Lista.length)&#xD;
{&#xD;
	var charAt = Lista.charAt(k);&#xD;
	&#xD;
	if(charAt == &quot;|&quot; &amp;&amp; arcoSingolo != null &amp;&amp; arcoSingolo != &quot;&quot;){&#xD;
		archi.add(arcoSingolo);&#xD;
		Process.auditLog(&quot;Inserito Arco nell'array: &quot; + arcoSingolo);&#xD;
		arcoSingolo = &quot;&quot;;&#xD;
	}&#xD;
	else{&#xD;
		arcoSingolo = arcoSingolo+charAt;&#xD;
	}&#xD;
	&#xD;
	k++;&#xD;
}&#xD;
&#xD;
if(arcoSingolo != &quot;&quot;){&#xD;
archi.add(arcoSingolo);&#xD;
Process.auditLog(&quot;Inserito Arco nell'array: &quot; + arcoSingolo);&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="79.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="123.0">
              <xpdl2:Coordinates XCoordinate="212.0" YCoordinate="1035.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:ActivityResourcePatterns>
            <xpdExt:AllocationStrategy xpdExt:Strategy="SYSTEM_DETERMINED"/>
          </xpdExt:ActivityResourcePatterns>
        </xpdl2:Activity>
