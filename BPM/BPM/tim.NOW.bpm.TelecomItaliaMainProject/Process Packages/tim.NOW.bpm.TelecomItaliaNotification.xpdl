                  <xpdl2:Actual ScriptGrammar="JavaScript">localRequestTEMP</xpdl2:Actual>
                </xpdl2:DataMapping>
              </xpdl2:DataMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="0,255,64" Height="84.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="116.0">
              <xpdl2:Coordinates XCoordinate="3831.0" YCoordinate="824.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">if(ManageNotificationDTU.STATO_SUCCESSIVO != null)&#xD;
{&#xD;
	localRequest.statoRichiestaPrecedNOW = localRequest.statoRichiestaNOW;&#xD;
	localRequest.statoRichiestaNOW = it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.get(String(ManageNotificationDTU.STATO_SUCCESSIVO));&#xD;
&#xD;
	if(localRequest.statoRichiestaNOW != it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.VERIFICHEINRETE)&#xD;
	{&#xD;
		localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
		&#xD;
		//SM_11727&#xD;
		if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOKOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACCETTATOKO;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOKOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETATOKO;&#xD;
		}&#xD;
		//RU_1554&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ANNULLATOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ANNULLATO;&#xD;
		}&#xD;
		//RU_1550&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACQUISITOD82&#xD;
		   || localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INDELIVERYD82&#xD;
		   || localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CODICESESSIONEKOD82   //SM_11680 - SM_11702&#xD;
		   || localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.CODICESESSIONEOKD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITO;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ACCETTATOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACCETTATO;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOD82)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETATO;&#xD;
		}&#xD;
		//RU_1450&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOINGAGGIOOF)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOAPPUNTAMENTO&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INACCETTAZIONEPREVENTIVO&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INRICHIESTAPREVENTIVO&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOATTESAPERMESSI&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONFERMAANNULLAMENTO&#xD;
			//RU_1550&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOD82&#xD;
			|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOACD82)&#xD;
		{	&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.SOSPESO;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETATOOKCONSUNTIVO&#xD;
				|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESAESPLETAMENTOFONIA&#xD;
				|| localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.INATTESACONSUNTIVO)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETAMENTOTECNICO;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOSTATIVO)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.INDELIVERY;&#xD;
		}&#xD;
		else if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOB2B)&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ESPLETATOOK; //SM_9549: da ESPLETAMENTOTECNICO a ESPLETATOOK&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.get(String(ManageNotificationDTU.STATO_SUCCESSIVO));&#xD;
		}&#xD;
	}&#xD;
	else&#xD;
	{&#xD;
		localRequest.statoRichiestaPrecedOLO = localRequest.statoRichiestaOLO;&#xD;
		localRequest.statoRichiestaOLO = it_telecomitalia_it_NOW_casedata_StatoOLOEnumeration.ACQUISITO;&#xD;
	}&#xD;
}&#xD;
if(localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.SOSPESOOPERESPECIALI){&#xD;
	localRequest.flagOpereSpeciali = &quot;S&quot;;&#xD;
}&#xD;
&#xD;
&#xD;
//RU_646&#xD;
CodiceCausaleSospensione=localRequest.codiceCausaleInterno;&#xD;
Process.auditLog(&quot;CodiceCausaleSospensione&quot;+CodiceCausaleSospensione);&#xD;
&#xD;
if(ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
&amp;&amp; (ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA==com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE&#xD;
 || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA==com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINETENTATIVOCONTATTO)&#xD;
&amp;&amp; CodiceCausaleSospensione != null &#xD;
&amp;&amp; CodiceCausaleSospensione != &quot;&quot; &#xD;
&amp;&amp; CodiceCausaleSospensione != &quot;Z98&quot; &#xD;
&amp;&amp; CodiceCausaleSospensione != &quot;Z99&quot; &#xD;
&amp;&amp; CodiceCausaleSospensione.slice(0,3) != &quot;W55&quot; &#xD;
&amp;&amp; CodiceCausaleSospensione.slice(0,3) != &quot;W15&quot; &#xD;
&amp;&amp; CodiceCausaleSospensione.slice(0,2) != &quot;AP&quot;)&#xD;
{&#xD;
	var causaleEsito = &quot;AnnullamentoPerTimeOut_&quot;+String(CodiceCausaleSospensione);&#xD;
	Process.auditLog(causaleEsito);&#xD;
	var c= cac_it_telecomitalia_it_NOW_Configuration.createCriteria(&quot;key =: causale&quot;);&#xD;
	c.setQueryParameter(&quot;causale&quot;,causaleEsito);&#xD;
	var result = cac_it_telecomitalia_it_NOW_Configuration.findByCriteria(c);&#xD;
	if(result != null &amp;&amp; result.size() > 0)&#xD;
	{&#xD;
		localRequest.flagAttesaDesospOLO='SI';&#xD;
		Process.auditLog(&quot;Aggiornato flagAttesaDesospOLO a SI&quot;);&#xD;
	}&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
localRequest.lastUpdate = date;&#xD;
&#xD;
if(localRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.lastUpdate = date;&#xD;
}&#xD;
&#xD;
if(localRequestTEMP.ordine != null &amp;&amp; localRequest.ordine != null)&#xD;
{&#xD;
	localRequest.ordine.DACRimodulata = localRequestTEMP.ordine.DACRimodulata;&#xD;
}&#xD;
&#xD;
// RU_859: quando siamo in espletamento tecnico KO e B2B Ricarica, impostiamo l'idAnagCausale a mano (Corrisponde a R016)&#xD;
if(localRequest.canaleRichiesta == it_telecomitalia_it_NOW_casedata_CanaleRichiestaEnumeration.B2B &amp;&amp;&#xD;
   localRequest.tipoRichiesta == it_telecomitalia_it_NOW_casedata_TipoRichiestaEnumeration.RICARICA &amp;&amp;&#xD;
   localRequest.statoRichiestaNOW == it_telecomitalia_it_NOW_casedata_StatoNOWEnumeration.ESPLETAMENTOTECNICOKO)&#xD;
{&#xD;
	localRequest.IDAnagraficaCausale = 598;&#xD;
	Process.auditLog(&quot;Espletamento Tecnico KO di una Ricarica da B2B, nuovo Id Anag Caus: &quot;+localRequest.IDAnagraficaCausale);&#xD;
}</xpdExt:Information>
