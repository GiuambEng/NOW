        <xpdl2:Activity Id="_sUhLIcmREe6tB5HEgGPwCw" Name="ThrowGlobalAnnullamentoAutomatico" xpdExt:Visibility="Private" xpdExt:DisplayName="Throw Global: AnnullamentoAutomatico">
          <xpdl2:Event>
            <xpdl2:IntermediateEvent Trigger="Signal">
              <xpdl2:TriggerResultSignal xpdExt:SignalType="Global" CatchThrow="THROW" Name="tim.now.bpm.signals/timNOWbpmsignals.gsd#AnnullamentoAutomatico">
                <xpdExt:SignalData>
