              <xpdl2:DataType>
                <xpdl2:ExternalReference location="com.tim.NOW.xsd.BPM_DTUNotificationManagement_v1.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.BPM_DTUNotificationManagement_v1Arricchimenti_Type"/>
