        <xpdl2:Activity Id="_kmt1Ro7LEea8h4sm26qWZQ" Name="1_RecuperoAsseteTipoNotifica" xpdExt:Visibility="Private" xpdExt:DisplayName="1_Recupero Asset e TipoNotifica">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">//SCRIPT DIVISO IN DUE CON LA RU_1393 DI C09 2023&#xD;
AssetRef = Requestref.assetRef;&#xD;
&#xD;
if(AssetRef != null){&#xD;
	localAsset = AssetRef.readAsset();&#xD;
}&#xD;
else{&#xD;
	Process.auditLog('Nessun Asset Recuperato');&#xD;
}&#xD;
&#xD;
//LOGICHE DI ARRICCHIMENTO GENERICHE&#xD;
if(&#xD;
localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.FONIA!= null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.FONIA.DES != &quot;&quot; &amp;&amp; &#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.FONIA.ORA_DES !=&quot;&quot;){&#xD;
localRequest.ordine.DES = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.FONIA.DES);&#xD;
localRequest.ordine.ORA_DES = DateTimeUtil.createTime(ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.FONIA.ORA_DES+&quot;:00&quot;);&#xD;
localRequest.ordine.DEC = localRequest.ordine.DES;&#xD;
}&#xD;
&#xD;
//NPSUNPDEL82 - Non arrivano espletamenti ma solo NI_REALIZZAZIONE_NP, la DES va presa da LI&#xD;
if(&#xD;
localRequest.ordine != null &amp;&amp;&#xD;
(localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPSUNPDEL82 ||&#xD;
localRequest.tipologiaScenario == it_telecomitalia_it_NOW_casedata_TipologiaScenarioEnumeration.NPDEL82) &amp;&amp; 	//SM_11359&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.FONIA!= null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.FONIA.DES != &quot;&quot; &amp;&amp; &#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.FONIA.ORA_DES !=&quot;&quot;){&#xD;
localRequest.ordine.DES = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.FONIA.DES);&#xD;
localRequest.ordine.ORA_DES = DateTimeUtil.createTime(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.FONIA.ORA_DES+&quot;:00&quot;);&#xD;
localRequest.ordine.DEC = localRequest.ordine.DES;&#xD;
}&#xD;
&#xD;
if(&#xD;
localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE!=null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI!= null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI.DATI_ACCESSO.size()>0 &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI.DATI_ACCESSO.get(0).DES!=&quot;&quot; &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI.DATI_ACCESSO.get(0).ORA_DES!=&quot;&quot;){&#xD;
localRequest.ordine.DES = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI.DATI_ACCESSO.get(0).DES);&#xD;
localRequest.ordine.ORA_DES = DateTimeUtil.createTime(ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.DATI.DATI_ACCESSO.get(0).ORA_DES+&quot;:00&quot;);&#xD;
localRequest.ordine.DEC = localRequest.ordine.DES;&#xD;
}&#xD;
&#xD;
if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.DISTRETTO != null)&#xD;
{&#xD;
	localRequest.ordine.distretto = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.DISTRETTO;&#xD;
}&#xD;
&#xD;
// RU_970 - Aggiorno STAOTOKENAPPUNTAMENTO se è arrivata una notifica intermedia&#xD;
if(localRequest.ordine != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null &#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_TOKEN_APPUNTAMENTO != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Notifica Intermedia con STATO_TOKEN_APPUNTAMENTO da aggiornare&quot;);	&#xD;
	var foundStatoTokenAppuntamento = false;	&#xD;
	var i = 0;&#xD;
	&#xD;
	while(!foundStatoTokenAppuntamento &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
	{	&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;)&#xD;
		{&#xD;
			for(var h=0; h&lt;componente.attributiDettaglioOrdine.size(); h++)&#xD;
			{&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(h);&#xD;
					&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOTOKENAPPUNTAMENTO){&#xD;
					attributo.valoreAttributo = String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_TOKEN_APPUNTAMENTO);&#xD;
					foundStatoTokenAppuntamento = true;&#xD;
					Process.auditLog(&quot;Aggiornato STATOTOKENAPPUNTAMENTO con &quot;+attributo.valoreAttributo);&#xD;
				}&#xD;
			}&#xD;
			&#xD;
			if(!foundStatoTokenAppuntamento){&#xD;
				var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();						 &#xD;
				attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributo.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributo.created = DateTimeUtil.createDatetime();&#xD;
				attributo.lastUpdate = DateTimeUtil.createDatetime();&#xD;
				attributo.operatore = &quot;BPM&quot;;&#xD;
				attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOTOKENAPPUNTAMENTO;&#xD;
				attributo.valoreAttributo = String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_TOKEN_APPUNTAMENTO);	&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
				&#xD;
				Process.auditLog(&quot;Creato STATOTOKENAPPUNTAMENTO con valore &quot;+attributo.valoreAttributo);&#xD;
				foundStatoTokenAppuntamento = true;&#xD;
			}&#xD;
		}		&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//RU_1198&#xD;
if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
   ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
   ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.OPERATORE_RETE == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_OPERATORE_RETEType.INFRATEL)&#xD;
{&#xD;
	localRequest.ordine.operatoreRete = 'INFR';		&#xD;
	localRequest.operatoreRete = 'INFR';	&#xD;
	Process.auditLog(&quot;OperatoreRete nella testata della notifica: &quot; + ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.OPERATORE_RETE);&#xD;
}&#xD;
&#xD;
//RU_1275: valorizzazione di EXOPERATORERETE&#xD;
if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
   ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
   ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
   ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA)&#xD;
{&#xD;
	var foundROEFFIB = false;&#xD;
	var i=0;&#xD;
	&#xD;
	while(!foundROEFFIB &amp;&amp; i&lt;ManageNotificationDTU.ARRICCHIMENTI.size())&#xD;
	{&#xD;
		var ARRICCHIMENTItemp = ScriptUtil.copy(ManageNotificationDTU.ARRICCHIMENTI.get(i));		&#xD;
		&#xD;
		if(ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size()>0)&#xD;
		{&#xD;
			var j=0;&#xD;
&#xD;
			while(!foundROEFFIB &amp;&amp; j&lt;ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size())&#xD;
			{	&#xD;
				var currentDettOrdine = ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.get(j);&#xD;
				&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_v1_DizionarioComponentiEnumeration.DTUDATIOPERATORERETE)&#xD;
				{&#xD;
					Process.auditLog('Trovata componente: '+currentDettOrdine.nomeComponente);&#xD;
					var k=0;&#xD;
&#xD;
					while(!foundROEFFIB &amp;&amp; k&lt;currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.ROEFFIB&#xD;
						   &amp;&amp; currentAttDettOrdine.valoreAttributo == &quot;1&quot;)&#xD;
						{&#xD;
							localRequest.exOperatoreRete = 'FF';&#xD;
							localRequest.ordine.exOperatoreRete = 'FF';&#xD;
							&#xD;
							foundROEFFIB = true;  &#xD;
							Process.auditLog('Trovato Attributo '+currentAttDettOrdine.nomeAttributo+' con valore: '+currentAttDettOrdine.valoreAttributo+ '. Valorizzato exOperatoreRete: ' +localRequest.exOperatoreRete); &#xD;
						}&#xD;
						k++;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}	&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
}&#xD;
&#xD;
//LOGICHE DI ARRICCHIMENTO BASATE SULLA TIPOLOGIA NOTIFICA&#xD;
//NICONFIGURAZIONELOGICA - RU_690 - Flash Fiber &#xD;
if(localRequest.operatoreRete != 'INFR' &amp;&amp;         //RU_1198&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NICONFIGURAZIONELOGICA &amp;&amp;&#xD;
(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH ||             //RU_1164: aggiunte SEMI***&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH ||&#xD;
localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH)){&#xD;
&#xD;
	Process.auditLog('Tipologia Notifica: '+ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA+', Offerta: '+localRequest.offerta+', Arricchimenti: '+ManageNotificationDTU.ARRICCHIMENTI.size());&#xD;
	&#xD;
	var foundDATIFF = false;&#xD;
	var i = 0;&#xD;
	var j = 0;&#xD;
	var k = 0;&#xD;
	&#xD;
	// Cerca Arricchimento dettaglio ordine&#xD;
	while(!foundDATIFF &amp;&amp; i &lt; ManageNotificationDTU.ARRICCHIMENTI.size())&#xD;
	{&#xD;
		var ARRICCHIMENTItemp = ScriptUtil.copy(ManageNotificationDTU.ARRICCHIMENTI.get(i));&#xD;
		&#xD;
		Process.auditLog('Ciclo Arricchimenti: '+i);&#xD;
		&#xD;
		if(ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size() > 0)&#xD;
		{&#xD;
			j = 0;&#xD;
			// Cerca Dettaglio ordine DTUCONFIGURAZIONE&#xD;
			while(!foundDATIFF &amp;&amp; j &lt; ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.size())&#xD;
			{&#xD;
				Process.auditLog('Ciclo Dettaglio Ordine: '+j);&#xD;
				var currentDettOrdine = ARRICCHIMENTItemp.arricchimento.dettaglioOrdineElement.get(j);&#xD;
				&#xD;
				if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_v1_DizionarioComponentiEnumeration.DTUCONFIGURAZIONE)&#xD;
				{&#xD;
					Process.auditLog('Trovata componente: '+currentDettOrdine.nomeComponente);&#xD;
					k = 0;&#xD;
					// Controlla se uno degli Attributi Dettaglio ordine di DTUCONFIGURAZIONE appartiene alla sezione &quot;DATI FF&quot;&#xD;
					while(!foundDATIFF &amp;&amp; k &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						Process.auditLog('Ciclo Attributi: '+k);&#xD;
						var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(k);&#xD;
									&#xD;
						// Attributi &quot;DATI FF&quot;&#xD;
						if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.IDGPON ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.IDEGON ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.CODICESPLITTERPRIMARIO ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.CODICESPLITTERSECONDARIO ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.ROE ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.POSIZIONESPLITTER ||&#xD;
						   currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_v1_DizionarioAttributiEnumeration.POSIZIONEMORSETTIERAROE)&#xD;
						{&#xD;
							// IDENTIFICATIVO OPERATORE RETE FF&#xD;
							localRequest.idProgressivoNotificheFF = 1;&#xD;
							localRequest.ordine.operatoreRete = 'FF';&#xD;
							localRequest.operatoreRete = 'FF';&#xD;
							foundDATIFF = true;  &#xD;
							Process.auditLog('Trovato Attributo '+currentAttDettOrdine.nomeAttributo+' operatoreRete: '+localRequest.operatoreRete); &#xD;
						}&#xD;
						k++;&#xD;
					}&#xD;
				}&#xD;
				j++;&#xD;
			}	&#xD;
		}&#xD;
		i++;&#xD;
	}&#xD;
	&#xD;
	if(foundDATIFF){&#xD;
		localRequest.idProgressivoNotificheFF = 1;&#xD;
		localRequest.ordine.operatoreRete = 'FF';&#xD;
		localRequest.operatoreRete = 'FF';&#xD;
	}&#xD;
}&#xD;
&#xD;
//NFCONFERMAANNULLAMENTO&#xD;
else if(&#xD;
localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFCONFERMAANNULLAMENTO &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;025&quot;){&#xD;
localRequest.ordine.DES = DateTimeUtil.createDate();&#xD;
localRequest.ordine.ORA_DES = DateTimeUtil.createTime();&#xD;
localRequest.ordine.DEC = localRequest.ordine.DES;&#xD;
}&#xD;
&#xD;
//NIRIMODULAZIONEDAC&#xD;
//SM_10763: Aggiunto OR in caso di notifica di NIFINEACCODAMENTO&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIRIMODULAZIONEDAC&#xD;
|| ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIFINEACCODAMENTO) &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.RDAC != null)&#xD;
{&#xD;
	localRequest.ordine.DACRimodulata = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.RDAC);&#xD;
}&#xD;
&#xD;
//NIPRESAAPPUNTAMENTO&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRESAAPPUNTAMENTO &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO != null)&#xD;
{	&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.DATA_APPUNTAMENTO != null)&#xD;
	{&#xD;
		localRequest.ordine.DUA = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.DATA_APPUNTAMENTO);&#xD;
		&#xD;
		//RU_1550&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEDEL82)&#xD;
		{&#xD;
			localRequest.ordine.DACRimodulata = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.DATA_APPUNTAMENTO);&#xD;
		}&#xD;
	}&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA!=null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA!=&quot;&quot;)&#xD;
	{&#xD;
		if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
		   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEDEL82)&#xD;
		{&#xD;
			if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA == &quot;01&quot;){&#xD;
				localRequest.ordine.fasciaOraUltimoApptD82 = &quot;08:30:00&quot;;&#xD;
			}&#xD;
			else if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA == &quot;02&quot;){&#xD;
				localRequest.ordine.fasciaOraUltimoApptD82 = &quot;10:30:00&quot;;&#xD;
			}&#xD;
			else if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA == &quot;03&quot;){&#xD;
				localRequest.ordine.fasciaOraUltimoApptD82 = &quot;13:00:00&quot;;&#xD;
			}&#xD;
			else if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA == &quot;04&quot;){&#xD;
				localRequest.ordine.fasciaOraUltimoApptD82 = &quot;15:00:00&quot;;&#xD;
			}&#xD;
		}&#xD;
		else{  //solito&#xD;
			localRequest.ordine.IDFasciaOrariaUA = parseInt(String(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.PRESA_APPUNTAMENTO.FASCIA_ORARIA));&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
&#xD;
//SM_9273: NIDISPACCIATOAMOIMOS e NIPRESAINCARICO&#xD;
else if(localRequest!= null &amp;&amp; localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIDISPACCIATOAMOIMOS&#xD;
  || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRESAINCARICO))&#xD;
{&#xD;
	&#xD;
	//Bug #29918: AGGIUNTO FLAG_ARRICCHIMENTO PER LA GESTIONE DELLE LAVORAZIONI IN VOLO&#xD;
	//Quando created &lt; GV (settata con la data di installazione in produzione), l'arricchimento di TIPOASSEGNAZIONE non viene effettuato	&#xD;
	Process.auditLog(&quot;Valore di FLAG_ARRICCHIMENTO &quot;+ FLAG_ARRICCHIMENTO);&#xD;
	&#xD;
	if((FLAG_ARRICCHIMENTO &amp;&amp; localRequest.disaggregato == &quot;S&quot;&#xD;
	   &amp;&amp; localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE&#xD;
	   &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLLINEANONATTIVA&#xD;
	       || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.ULLDATILINEANONATTIVA&#xD;
		   || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA))&#xD;
	 || (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON              //RU_1393	        &#xD;
		  &amp;&amp; localRequest.gestioneAutonoma != null))&#xD;
	{&#xD;
		var TIPOASSEGNAZIONE = &quot;&quot;;&#xD;
		TIPOASSEGNAZIONE = null;&#xD;
		&#xD;
		//RICERCA DI OWNERPRESAAPPUNTAMENTO (NEL CASO DI NIDISPACCIATOAMOIMOS)&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIDISPACCIATOAMOIMOS)&#xD;
		{&#xD;
			for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
			{&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTODISAGGREGAZIONE&#xD;
				   ||componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.APPUNTAMENTOGESTIONEAUTONOMA) //RU_1393&#xD;
				{				&#xD;
					for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.OWNERPRESAAPPUNTAMENTO)&#xD;
						{	&#xD;
							if(localRequest.gestioneAutonoma != null){ //RU_1393&#xD;
							&#xD;
								if(attributo.valoreAttributo == &quot;SU&quot;){&#xD;
									TIPOASSEGNAZIONE = &quot;Appuntamento a cura Impresa&quot;;&#xD;
								}&#xD;
								else if(attributo.valoreAttributo == &quot;TI&quot; &amp;&amp; localRequest.gestioneAutonoma == &quot;IS&quot;){&#xD;
									TIPOASSEGNAZIONE = &quot;Appuntamento effettuata da TIM&quot;;&#xD;
								}&#xD;
								else if(attributo.valoreAttributo == &quot;OP&quot;){&#xD;
									TIPOASSEGNAZIONE = &quot;Appuntamento a cura Operatore&quot;;&#xD;
								}							&#xD;
							}&#xD;
							//solita gestione&#xD;
							else if(attributo.valoreAttributo == &quot;SU&quot;){&#xD;
								TIPOASSEGNAZIONE = &quot;ASSEGNAZIONE PER PRESA APPUNTAMENTO&quot;;&#xD;
								Process.auditLog(&quot;Valore di OWNERPRESAAPPUNTAMENTO &quot;+ attributo.valoreAttributo +&quot; della componente APPUNTAMENTODISAGGREGAZIONE&quot;);&#xD;
							}&#xD;
							else{&#xD;
								TIPOASSEGNAZIONE = &quot;ASSEGNAZIONE PER REALIZZAZIONE ON FIELD&quot;;&#xD;
								Process.auditLog(&quot;Valore di OWNERPRESAAPPUNTAMENTO &quot;+ attributo.valoreAttributo +&quot; della componente APPUNTAMENTODISAGGREGAZIONE&quot;);&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPRESAINCARICO)&#xD;
		{&#xD;
			if(localRequest.gestioneAutonoma != null){ //RU_1393&#xD;
				TIPOASSEGNAZIONE = &quot;Inizio Attività&quot;;&#xD;
			}&#xD;
			else{ //solito&#xD;
				TIPOASSEGNAZIONE = &quot;INIZIO ATTIVITA&quot;;&#xD;
			}&#xD;
		}&#xD;
				&#xD;
		//ARRICCHIMENTO DI TIPOASSEGNAZIONE&#xD;
		var i=0;&#xD;
		var trovatoTipoAssegnazione = false;&#xD;
		&#xD;
		if(TIPOASSEGNAZIONE != null)&#xD;
		{&#xD;
			while(!trovatoTipoAssegnazione &amp;&amp; i&lt;localRequest.ordine.dettaglioordine.size())&#xD;
			{&#xD;
				var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
				&#xD;
				if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE&#xD;
				   ||String(componente.nomeComponente).slice(0,16) == &quot;GESTIONEAUTONOMA&quot;)&#xD;
				{&#xD;
					var j=0;&#xD;
					&#xD;
					while(!trovatoTipoAssegnazione &amp;&amp; j&lt;componente.attributiDettaglioOrdine.size())&#xD;
					{&#xD;
						var attr = componente.attributiDettaglioOrdine.get(j);&#xD;
						&#xD;
						if(attr.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOASSEGNAZIONE){&#xD;
							trovatoTipoAssegnazione = true;							&#xD;
							attr.valoreAttributo = TIPOASSEGNAZIONE;&#xD;
							Process.auditLog(&quot;Aggiornato attributo TIPOASSEGNAZIONE&quot; + attr.valoreAttributo);&#xD;
						}						&#xD;
						j++;&#xD;
					}&#xD;
					&#xD;
					if(!trovatoTipoAssegnazione){&#xD;
						var ora = DateTimeUtil.createDatetime();&#xD;
						var attributo = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
						attributo.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
						attributo.IDRichiestaOLO = componente.IDRichiestaOLO;&#xD;
						attributo.created = ora;&#xD;
						attributo.lastUpdate = ora;&#xD;
						attributo.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOASSEGNAZIONE;&#xD;
						attributo.operatore = componente.operatore;&#xD;
						attributo.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
						attributo.valoreAttributo = TIPOASSEGNAZIONE;&#xD;
						Process.auditLog(&quot;Creato attributo TIPOASSEGNAZIONE&quot;);&#xD;
						componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributo));&#xD;
					}&#xD;
				}				&#xD;
				i++;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
//fine SM_9273&#xD;
&#xD;
//NIACCODAMENTO&#xD;
//RU_1393 - Cambiata la logica per nuovo arricchimento&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIACCODAMENTO)&#xD;
{&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
		ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC != null &amp;&amp;&#xD;
		ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.DPS != null)&#xD;
	{&#xD;
		localRequest.ordine.DPS = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.DPS);&#xD;
	}&#xD;
	&#xD;
	//RU_1393&#xD;
	var TIPODISAGGREGAZIONE = &quot;&quot;; TIPODISAGGREGAZIONE = null;&#xD;
	var TIPOGESTIONEAUTONOMA = &quot;&quot;; TIPOGESTIONEAUTONOMA = null;&#xD;
&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE != null)&#xD;
	{&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE == &quot;EX-DISAGGREGATO&quot;)&#xD;
		{&#xD;
			localRequest.exDisaggregato = &quot;S&quot;;&#xD;
			TIPODISAGGREGAZIONE = &quot;OL richiesto come disaggregato ma lavorato da TIM&quot;;&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE == &quot;EX-GESTIONE_AUTONOMA&quot;)&#xD;
		{  &#xD;
			localRequest.exGestioneAutonoma = &quot;S&quot;;&#xD;
			&#xD;
			if(localRequest.gestioneAutonoma != null){&#xD;
				TIPOGESTIONEAUTONOMA = &quot;OL ex-Gestione Autonoma&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.GA_IN_LAVORAZIONE_TIM != null)&#xD;
	{&#xD;
		localRequest.gaInLavorazioneTim = &quot;S&quot;;&#xD;
		&#xD;
		if(localRequest.gestioneAutonoma != null &amp;&amp; localRequest.gestioneAutonoma == &quot;OS&quot;){	&#xD;
			TIPOGESTIONEAUTONOMA = &quot;OL in Lavorazione TIM&quot;;&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	if(TIPODISAGGREGAZIONE != null || TIPOGESTIONEAUTONOMA != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
		{&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE&#xD;
			   &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
			{				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE){	&#xD;
						attributo.valoreAttributo = TIPODISAGGREGAZIONE;						&#xD;
						Process.auditLog(&quot;Valore aggiornato di TIPODISAGGREGAZIONE &quot;+ attributo.valoreAttributo +&quot; della componente DISAGGREGAZIONE&quot;);				&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(String(componente.nomeComponente).slice(0,16) == &quot;GESTIONEAUTONOMA&quot;&#xD;
			         &amp;&amp; TIPOGESTIONEAUTONOMA != null)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOGESTIONEAUTONOMA){	&#xD;
						attributo.valoreAttributo = TIPOGESTIONEAUTONOMA;						&#xD;
						Process.auditLog(&quot;Valore aggiornato di TIPOGESTIONEAUTONOMA &quot;+ attributo.valoreAttributo +&quot; della componente DISAGGREGAZIONE&quot;);				&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
//NISOSPENSIONE&#xD;
//RU_1393 - Cambiata la logica per nuovo arricchimento&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE &amp;&amp;&#xD;
(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;W55&quot; &#xD;
  || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;CG&quot;  //SM_9501: aggiunto CG&#xD;
  || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;K33&quot;  //RU_1393: aggiunta K33 &#xD;
  || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;C43&quot;  //SM_11164: aggiunte C43 e K31&#xD;
  || ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;K31&quot;)) &#xD;
{	&#xD;
	var TIPODISAGGREGAZIONE = &quot;&quot;; TIPODISAGGREGAZIONE = null;&#xD;
	var TIPOGESTIONEAUTONOMA = &quot;&quot;; TIPOGESTIONEAUTONOMA = null;&#xD;
&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE != null)&#xD;
	{&#xD;
		if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE == &quot;EX-DISAGGREGATO&quot;&#xD;
		   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;K33&quot;&#xD;
		   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;C43&quot;&#xD;
		   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;K31&quot;)&#xD;
		{&#xD;
			localRequest.exDisaggregato = &quot;S&quot;;&#xD;
			TIPODISAGGREGAZIONE = &quot;OL richiesto come disaggregato ma lavorato da TIM&quot;;&#xD;
		}&#xD;
		else if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.STATO_DISAGGREGAZIONE == &quot;EX-GESTIONE_AUTONOMA&quot;&#xD;
		        &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;CG&quot;)&#xD;
		{  &#xD;
			localRequest.exGestioneAutonoma = &quot;S&quot;;&#xD;
			&#xD;
			if(localRequest.gestioneAutonoma != null){&#xD;
				TIPOGESTIONEAUTONOMA = &quot;OL ex-Gestione Autonoma&quot;;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.GA_IN_LAVORAZIONE_TIM != null&#xD;
	   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO != &quot;CG&quot;)&#xD;
	{&#xD;
		localRequest.gaInLavorazioneTim = &quot;S&quot;;&#xD;
		&#xD;
		if(localRequest.gestioneAutonoma != null &amp;&amp; localRequest.gestioneAutonoma == &quot;OS&quot;){	&#xD;
			TIPOGESTIONEAUTONOMA = &quot;OL in Lavorazione TIM&quot;;&#xD;
		}&#xD;
	}&#xD;
		&#xD;
	if(TIPODISAGGREGAZIONE != null || TIPOGESTIONEAUTONOMA != null)&#xD;
	{&#xD;
		for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
			var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DISAGGREGAZIONE&#xD;
			   &amp;&amp; TIPODISAGGREGAZIONE != null)&#xD;
			{				&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPODISAGGREGAZIONE){	&#xD;
						attributo.valoreAttributo = TIPODISAGGREGAZIONE;						&#xD;
						Process.auditLog(&quot;Valore aggiornato di TIPODISAGGREGAZIONE &quot;+ attributo.valoreAttributo +&quot; della componente DISAGGREGAZIONE&quot;);				&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(String(componente.nomeComponente).slice(0,16) == &quot;GESTIONEAUTONOMA&quot;&#xD;
			         &amp;&amp; TIPOGESTIONEAUTONOMA != null)&#xD;
			{&#xD;
				for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
					&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPOGESTIONEAUTONOMA){	&#xD;
						attributo.valoreAttributo = TIPOGESTIONEAUTONOMA;						&#xD;
						Process.auditLog(&quot;Valore aggiornato di TIPOGESTIONEAUTONOMA &quot;+ attributo.valoreAttributo +&quot; della componente DISAGGREGAZIONE&quot;);				&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
		}&#xD;
	}	&#xD;
}&#xD;
&#xD;
//RU_1550 - NISOSPENSIONE con causale = MDL&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NISOSPENSIONE &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;MDL&quot;)&#xD;
{&#xD;
	localRequest.ordine.sbloccoDTU = &quot;SI&quot;;&#xD;
}&#xD;
&#xD;
//NIRIMODULAZIONEDPR&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIRIMODULAZIONEDPR &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.DPNR != null)&#xD;
{&#xD;
	localRequest.ordine.DPS = DateTimeUtil.createDate(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INFO_CU_RDAC.DPNR);&#xD;
}&#xD;
&#xD;
//NIVERIFICATECNICAETOPONOMASTICA&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIVERIFICATECNICAETOPONOMASTICA &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE != &quot;&quot;)  //SM_11244&#xD;
{&#xD;
	localRequest.ordine.CLLI = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE;&#xD;
}&#xD;
&#xD;
//NIPROGETTAZIONEPERCORSODIRETE&#xD;
//RU_888 - Valorizzazione CLLI per EASYIPNGAFTTCAB e EASYIPNGAFTTH&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIPROGETTAZIONEPERCORSODIRETE &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT != null &amp;&amp;&#xD;
localRequest.offerta != null &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB &#xD;
							  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH&#xD;
							  || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH))   //RU_1164&#xD;
{&#xD;
	Process.auditLog(&quot;Notifica NIPROGETTAZIONEPERCORSODIRETE&quot;);&#xD;
	if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE;&#xD;
		Process.auditLog(&quot;CCLI_CENTRALE:&quot; + ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_CENTRALE);&#xD;
	}&#xD;
	else if(ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_ONU != null)&#xD;
	{&#xD;
		localRequest.ordine.CLLI = ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_ONU;&#xD;
		Process.auditLog(&quot;CCLI_ONU:&quot; + ManageNotificationDTU.EVENTO_NOTIFICA.INTERMEDIA.INDIRIZZO_CERT.CCLI_ONU);&#xD;
	}&#xD;
}&#xD;
&#xD;
//NFESPLETAMENTO&#xD;
else if(localRequest.ordine != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO &amp;&amp;&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.CAUSALE_ESITO == &quot;N28&quot;)&#xD;
{&#xD;
	localRequest.ordine.DES = null;&#xD;
	localRequest.ordine.ORA_DES = null;&#xD;
	localRequest.ordine.DEC = null;&#xD;
	flagCausaleN28 = true; //SM_8218&#xD;
	&#xD;
	//RU_1550&#xD;
	if(localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE&#xD;
	   &amp;&amp; localRequest.tipologiaSottolav == it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.MIGRAZIONEDEL82&#xD;
	   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.FINALE != null&#xD;
	   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.INDIRIZZO_CERT != null&#xD;
	   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.INDIRIZZO_CERT.INDIRIZZO_CLIENTE != null&#xD;
	   &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.INDIRIZZO_CERT.INDIRIZZO_CLIENTE.CODICE_INDIRIZZO != null)&#xD;
	{&#xD;
		localRequest.ordine.codAddressSedeCliente = ManageNotificationDTU.EVENTO_NOTIFICA.FINALE.INDIRIZZO_CERT.INDIRIZZO_CLIENTE.CODICE_INDIRIZZO;&#xD;
	}&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
