        <xpdl2:Activity Id="_eX9ZkHPJEeiNoc-cG11Fww" Name="NotificationOutcomeDTUtoBPM" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:RequireNewTransaction="false" xpdExt:DisplayName="Notification Outcome DTU to BPM">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_avSnoFLgEeeWiLBnLczUxg" PackageRef="tim.NOW.bpm.exposedService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
