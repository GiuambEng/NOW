          <xpdl2:Condition Type="CONDITION">
<xpdl2:Expression ScriptGrammar="JavaScript">var lavorazione = '';&#xD;
&#xD;
if(AltreLavorazioni != null)&#xD;
{&#xD;
	lavorazione = AltreLavorazioni;&#xD;
