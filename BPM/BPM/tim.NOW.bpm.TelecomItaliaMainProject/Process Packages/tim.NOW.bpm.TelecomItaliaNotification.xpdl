														   &amp;&amp; ESITOApparato != null)&#xD;
														{&#xD;
															foundESITOApparato = true;&#xD;
															attributoRic1.valoreAttributo = ESITOApparato;&#xD;
															Process.auditLog(&quot;Aggiornato attributo ESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
														}&#xD;
														if(attributoRic1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO&#xD;
														   &amp;&amp; CAUSALEESITOApparato != null)&#xD;
														{&#xD;
															foundCAUSALEESITOApparato = true;&#xD;
															attributoRic1.valoreAttributo = CAUSALEESITOApparato;&#xD;
															Process.auditLog(&quot;Aggiornato attributo CAUSALEESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
														}&#xD;
														if(attributoRic1.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOOAO&#xD;
														   &amp;&amp; DESCRIZIONEESITOApparato != null)&#xD;
														{&#xD;
															foundDESCRIZIONEESITOApparato = true;&#xD;
															attributoRic1.valoreAttributo = DESCRIZIONEESITOApparato;&#xD;
															Process.auditLog(&quot;Aggiornato attributo DESCRIZIONEESITO&quot;+ attributoRic1.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
														}&#xD;
													}&#xD;
													&#xD;
													var attributoDaAggiungere1 = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
													var data = DateTimeUtil.createDatetime();&#xD;
													attributoDaAggiungere1.IDDettaglioOrdine = currentDettRICH.IDDettaglioOrdine;&#xD;
													attributoDaAggiungere1.IDRichiestaOLO = currentDettRICH.IDRichiestaOLO;&#xD;
													attributoDaAggiungere1.created = data;&#xD;
													attributoDaAggiungere1.lastUpdate = data;&#xD;
													attributoDaAggiungere1.operatore = currentDettRICH.operatore;&#xD;
													attributoDaAggiungere1.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
													&#xD;
													if(ESITOApparato != null &amp;&amp; !foundESITOApparato)&#xD;
													{&#xD;
														attributoDaAggiungere1.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITO;&#xD;
														attributoDaAggiungere1.valoreAttributo = ESITOApparato;&#xD;
														currentDettRICH.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere1));&#xD;
														Process.auditLog(&quot;Creato attributo ESITO&quot;+ attributoDaAggiungere1.valoreAttributo +&quot; su componente con IDDett &quot;+currentDettRICH.IDDettaglioOrdine);&#xD;
													}&#xD;
													if(CAUSALEESITOApparato != null &amp;&amp; !foundCAUSALEESITOApparato)&#xD;
													{&#xD;
														attributoDaAggiungere1.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CAUSALEESITO;&#xD;
														attributoDaAggiungere1.valoreAttributo = CAUSALEESITOApparato;&#xD;
														currentDettRICH.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere1));&#xD;
