            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="84.0" LaneId="_GL3B8XPJEeiNoc-cG11Fww" Width="131.0">
              <xpdl2:Coordinates XCoordinate="300.0" YCoordinate="91.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.exposedService/Process Packages/tim.NOW.bpm.exposedService.xpdl.TINOWRicezioneNotifichedaDTU&quot;;&#xD;
&#xD;
&#xD;
&#xD;
if(localRequest.progressivoNotificaDTU == null)&#xD;
{&#xD;
       localRequest.progressivoNotificaDTU = 1;&#xD;
}&#xD;
if(FlagAnnullamentoAutomatico==null){&#xD;
       FlagAnnullamentoAutomatico = false;&#xD;
}&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">ManageNotificationDTU = com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_Factory.createmanageNotificationRequestType();&#xD;
&#xD;
ManageNotificationDTU.ACK_COMUNICAZIONE = ScriptUtil.copy(ManageNotificationDTUSenzaArricchimenti.ACK_COMUNICAZIONE);&#xD;
ManageNotificationDTU.EVENTO_NOTIFICA = ScriptUtil.copy(ManageNotificationDTUSenzaArricchimenti.EVENTO_NOTIFICA);&#xD;
ManageNotificationDTU.ID_ANAGRAFICA_CAUSALE = ManageNotificationDTUSenzaArricchimenti.ID_ANAGRAFICA_CAUSALE;&#xD;
ManageNotificationDTU.ID_NOTIFICA_DONATING.addAll(ManageNotificationDTUSenzaArricchimenti.ID_NOTIFICA_DONATING);&#xD;
ManageNotificationDTU.ID_NOTIFICA_DONOR.addAll(ManageNotificationDTUSenzaArricchimenti.ID_NOTIFICA_DONOR);&#xD;
ManageNotificationDTU.ID_NOTIFICA_RECIPIENT.addAll(ManageNotificationDTUSenzaArricchimenti.ID_NOTIFICA_RECIPIENT);&#xD;
ManageNotificationDTU.ID_RICHIESTA = ManageNotificationDTUSenzaArricchimenti.ID_RICHIESTA;&#xD;
ManageNotificationDTU.STATO_SUCCESSIVO = ManageNotificationDTUSenzaArricchimenti.STATO_SUCCESSIVO;&#xD;
ManageNotificationDTU.codProcsoNoFile = ManageNotificationDTUSenzaArricchimenti.codProcsoNoFile;&#xD;
ManageNotificationDTU.idEsecProcsoNoFile = ManageNotificationDTUSenzaArricchimenti.idEsecProcsoNoFile;&#xD;
ManageNotificationDTU.idEventoOrdnNowWhls = ManageNotificationDTUSenzaArricchimenti.idEventoOrdnNowWhls;&#xD;
ManageNotificationDTU.progressivoNotificaDTU = ManageNotificationDTUSenzaArricchimenti.progressivoNotificaDTU;&#xD;
&#xD;
if(ManageNotificationDTU.ACK_COMUNICAZIONE != null)&#xD;
{&#xD;
	Process.auditLog(&quot;Ricevuta ACK DTU con ID: &quot; + ManageNotificationDTU.idEventoOrdnNowWhls + &quot; e tipo: &quot; + ManageNotificationDTU.ACK_COMUNICAZIONE.TIPO_MESSAGGIO);&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.auditLog(&quot;Ricevuta Notifica DTU con ID: &quot; + ManageNotificationDTU.idEventoOrdnNowWhls + &quot; e tipo: &quot; + ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA);&#xD;
}&#xD;
&#xD;
//per permettere il caricamento di dati da DB se modificati.n&#xD;
//localRequest = Requestref.readRichiesta();&#xD;
if(localRequest.progressivoNotificaDTU == null)&#xD;
{&#xD;
	progressivoNotificaDTU = 1;&#xD;
	//localRequest.progressivoNotificaDTU = 1;&#xD;
}&#xD;
&#xD;
//Gestione Priorita&#xD;
if(DateTimeUtil.createDate(localRequest.created) == DateTimeUtil.createDate())&#xD;
{&#xD;
	Process.priority = 200;&#xD;
}&#xD;
else if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; String(ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA).slice(0, 2) == &quot;NF&quot;)&#xD;
{&#xD;
	Process.priority = 270;&#xD;
}&#xD;
else if(ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NIRIMODULAZIONEDAC)&#xD;
{&#xD;
	Process.priority = 250;&#xD;
}&#xD;
else&#xD;
{&#xD;
	Process.priority = 230;&#xD;
}&#xD;
&#xD;
progressivoNotificaDTU = localRequest.progressivoNotificaDTU;&#xD;
progressivoNotificaDTU++;&#xD;
//localRequest.progressivoNotificaDTU++;&#xD;
//Mantenuto per retrocompatibilità pratiche in volo&#xD;
StateMachineValidationResponse = null;&#xD;
&#xD;
&#xD;
StateMachineValidationResponse_new = null;&#xD;
&#xD;
localRequest.codiceCausaleInterno = null;&#xD;
&#xD;
dataRicezioneNotificaDTU = DateTimeUtil.createDate();&#xD;
&#xD;
TipologiaNotifica.clear();&#xD;
TargetNotifica.clear();&#xD;
IDAnagraficaCausale.clear();&#xD;
CodiceCausale.clear();&#xD;
ComponenteDonating.clear();&#xD;
IDAssetConsistenzaCPS.clear(); //SM_9709</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
          <xpdExt:AssociatedParameters DisableImplicitAssociation="false"/>
        </xpdl2:Activity>
