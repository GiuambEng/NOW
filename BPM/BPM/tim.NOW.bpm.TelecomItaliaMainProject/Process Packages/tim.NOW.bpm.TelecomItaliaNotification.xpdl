	}&#xD;
}&#xD;
&#xD;
//LOGICHE GENERICHE - ARRICCHIMENTO ATTRIBUTI SULLA BASE DI CIò CHE ARRIVA DA DTU&#xD;
var date = DateTimeUtil.createDatetime();&#xD;
&#xD;
var CARATTERIZZAZIONEGEO = &quot;&quot;; CARATTERIZZAZIONEGEO = null;&#xD;
var AREA = &quot;&quot;; AREA = null;&#xD;
var BANDOPUBBLICO = &quot;&quot;; BANDOPUBBLICO = null;&#xD;
var DIRETTOINFRATEL = &quot;&quot;; DIRETTOINFRATEL = null;&#xD;
var SPECIALPRICE = &quot;&quot;; SPECIALPRICE = null;&#xD;
var COPERTOFTTH = &quot;&quot;; COPERTOFTTH = null;&#xD;
var SISTEMADICREATION = &quot;&quot;; SISTEMADICREATION = null;&#xD;
&#xD;
for(var i=0; i&lt; ARR_dettaglioOrdine.size(); i++){&#xD;
	var currentARRdettOrdineOF = ARR_dettaglioOrdine.get(i);&#xD;
		  &#xD;
	for(var j=0; j&lt;currentARRdettOrdineOF.attributiDettaglioOrdine.size(); j++){&#xD;
		 var attributo = currentARRdettOrdineOF.attributiDettaglioOrdine.get(j);            &#xD;
&#xD;
		 if(currentARRdettOrdineOF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIACCESSO)&#xD;
		 {&#xD;
			if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO&#xD;
			   &amp;&amp; ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE  //Bug #42889: arricchire CARATTERIZZAZIONEGEO solo in caso di ATTIVAZIONE&#xD;
			         &amp;&amp; localRequest.tipologiaSottolav != it_telecomitalia_it_NOW_casedata_TipologiaSottolavorazioneEnumeration.CAMBIOTECNOLOGIA) //SM_11028&#xD;
				  || (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE   //SM_12023&#xD;
				      &amp;&amp; localRequest.flagMigDel82 == &quot;SI&quot;)))  &#xD;
			 {&#xD;
				CARATTERIZZAZIONEGEO = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo CARATTERIZZAZIONEGEO: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREA) //RU_1543&#xD;
			 {&#xD;
				AREA = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo AREA: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDOPUBBLICO) //RU_1610&#xD;
			 {&#xD;
				BANDOPUBBLICO = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo BANDOPUBBLICO: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIRETTOINFRATEL) //RU_1610&#xD;
			 {&#xD;
				DIRETTOINFRATEL = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo DIRETTOINFRATEL: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SPECIALPRICE) //RU_1610&#xD;
			 {&#xD;
				SPECIALPRICE = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo SPECIALPRICE: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if (attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COPERTOFTTH) //FEA_32918&#xD;
			 {&#xD;
				COPERTOFTTH = attributo.valoreAttributo;      &#xD;
				Process.auditLog(&quot;Recuperato attributo COPERTOFTTH: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
		 }&#xD;
		 //RU_1558&#xD;
		 else if(currentARRdettOrdineOF.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUONTOPERATORE&#xD;
		         &amp;&amp; localRequest.ordine != null)&#xD;
		 {&#xD;
			 if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.FLAGONTOPERATORE)&#xD;
			 {&#xD;
				localRequest.ordine.ontOperatore = attributo.valoreAttributo;&#xD;
				Process.auditLog(&quot;Recuperato attributo FLAGONTOPERATORE: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
			 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.MODELLOSERVIZIOPERVALIDAZIONI) &#xD;
			 {&#xD;
				localRequest.ordine.modelServPerValidazioni = attributo.valoreAttributo;    &#xD;
				Process.auditLog(&quot;Recuperato attributo MODELLOSERVIZIOPERVALIDAZIONI: &quot;+attributo.valoreAttributo);&#xD;
			 }&#xD;
		 }&#xD;
	}&#xD;
}&#xD;
//FEA 36452_T1PRJ0135825 &#xD;
if (ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null&#xD;
&amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.ID_FOGLIA != null){&#xD;
	SISTEMADICREATION = ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.ID_FOGLIA;&#xD;
	Process.auditLog(&quot;Recuperato ID_FOGLIA - SISTEMADICREATION: &quot;+ ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.ID_FOGLIA);&#xD;
}&#xD;
//RU_1630 - In caso di lavorazione ATTIVAZIONE o MIGRAZIONE, se l'offerta è SEMIVULAFTTH ed il campo AREA è null o &quot;&quot; si setta il campo AREA con il valore di default NERO&#xD;
if ((localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH&#xD;
	&amp;&amp; (AREA == null || AREA ==&quot;&quot;))&#xD;
	{&#xD;
		AREA = &quot;NERO&quot;;&#xD;
		Process.auditLog(&quot;Aggiornato attributo AREA con valore di default: &quot;+ AREA);&#xD;
	}&#xD;
else if (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.VARIAZIONE&#xD;
	&amp;&amp; localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH)&#xD;
	{	&#xD;
//BUG_41449 Recupero l'asset per recuperare l'attributo AREA	&#xD;
		var idassetCalcArea = &quot;&quot;;&#xD;
		idassetCalcArea = null;&#xD;
&#xD;
		var i = 0;&#xD;
		while(idassetCalcArea == null &amp;&amp; i &lt; localRequest.ordine.dettaglioordine.size())&#xD;
		{&#xD;
			var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i);&#xD;
			&#xD;
			var j = 0;&#xD;
			while(idassetCalcArea == null &amp;&amp; j &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSET)&#xD;
				{&#xD;
					idassetCalcArea = currentAttDettOrdine.valoreAttributo;&#xD;
				}&#xD;
				j++;&#xD;
			}&#xD;
			i++;&#xD;
		}&#xD;
&#xD;
		if(idassetCalcArea != null)&#xD;
		{&#xD;
			Process.auditLog(&quot;Asset Trovato con idassetCalcArea: &quot; + idassetCalcArea);&#xD;
			var AssetRefCalcArea = cac_it_telecomitalia_it_NOW_casedata_Asset.findByIDAsset(ScriptUtil.createBigInteger(idassetCalcArea));&#xD;
			&#xD;
			AssetCalcArea = AssetRefCalcArea.readAsset();&#xD;
			&#xD;
		}&#xD;
		else&#xD;
		{&#xD;
			Process.auditLog(&quot;Nessun Asset Per Il Calcolo AREA Trovato&quot;);&#xD;
		}&#xD;
	if(AssetCalcArea!= null)&#xD;
		{&#xD;
			for(var i=0; i&lt;AssetCalcArea.dettaglioasset.size(); i++)&#xD;
			{&#xD;
				var componente = AssetCalcArea.dettaglioasset.get(i);&#xD;
				if(String(componente.nomeComponente)==it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOVULAFTTH)&#xD;
				{&#xD;
					for(var j=0; j&lt;componente.attributidettaglioasset.size(); j++)&#xD;
					{&#xD;
						var attributo = componente.attributidettaglioasset.get(j);&#xD;
						if(String(attributo.nomeAttributo) == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREA)&#xD;
						{&#xD;
							AREA = attributo.valoreAttributo;&#xD;
						}&#xD;
					}	&#xD;
				}&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
&#xD;
//ARRICCHIMENTO GENERICO DI ATTRIBUTI NELL'ACCESSO&#xD;
if(CARATTERIZZAZIONEGEO != null || AREA != null || BANDOPUBBLICO != null || DIRETTOINFRATEL != null || SPECIALPRICE != null || COPERTOFTTH != null &amp;&amp; SISTEMADICREATION != null) &#xD;
{&#xD;
	var trovataCARATTERIZZAZIONEGEO = false;&#xD;
	var trovataAREA = false;  //RU_1543&#xD;
	var trovataBANDOPUBBLICO = false;  //RU_1610&#xD;
	var trovataDIRETTOINFRATEL = false;  //RU_1610&#xD;
	var trovataSPECIALPRICE = false;  //RU_1610&#xD;
	var trovataCOPERTOFTTH = false; //FEA_32918&#xD;
	var trovataSISTEMADICREATION = false; //FEA 36452&#xD;
			&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);&#xD;
				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO&#xD;
				    &amp;&amp; CARATTERIZZAZIONEGEO != null){&#xD;
					attributo.valoreAttributo = CARATTERIZZAZIONEGEO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo CARATTERIZZAZIONEGEO: &quot;+ CARATTERIZZAZIONEGEO +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataCARATTERIZZAZIONEGEO = true;//Bug #42889&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREA&#xD;
				         &amp;&amp; AREA != null){&#xD;
					attributo.valoreAttributo = AREA;&#xD;
					Process.auditLog(&quot;Aggiornato attributo AREA: &quot;+ AREA +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataAREA = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDOPUBBLICO&#xD;
				         &amp;&amp; BANDOPUBBLICO != null){&#xD;
					attributo.valoreAttributo = BANDOPUBBLICO;&#xD;
					Process.auditLog(&quot;Aggiornato attributo BANDOPUBBLICO: &quot;+ BANDOPUBBLICO +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataBANDOPUBBLICO = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIRETTOINFRATEL&#xD;
				         &amp;&amp; DIRETTOINFRATEL != null){&#xD;
					attributo.valoreAttributo = DIRETTOINFRATEL;&#xD;
					Process.auditLog(&quot;Aggiornato attributo DIRETTOINFRATEL: &quot;+ DIRETTOINFRATEL +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataDIRETTOINFRATEL = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SPECIALPRICE&#xD;
				         &amp;&amp; SPECIALPRICE != null){&#xD;
					attributo.valoreAttributo = SPECIALPRICE;&#xD;
					Process.auditLog(&quot;Aggiornato attributo SPECIALPRICE: &quot;+ SPECIALPRICE +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataSPECIALPRICE = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COPERTOFTTH&#xD;
				         &amp;&amp; COPERTOFTTH != null){&#xD;
					attributo.valoreAttributo = COPERTOFTTH;&#xD;
					Process.auditLog(&quot;Aggiornato attributo COPERTOFTTH: &quot;+ COPERTOFTTH +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataCOPERTOFTTH = true;&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SISTEMADICREATION&#xD;
				         &amp;&amp; SISTEMADICREATION != null){&#xD;
					attributo.valoreAttributo = SISTEMADICREATION;&#xD;
					Process.auditLog(&quot;Aggiornato attributo SISTEMADICREATION: &quot;+ SISTEMADICREATION +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);&#xD;
					trovataSISTEMADICREATION = true;&#xD;
				}&#xD;
				&#xD;
			}&#xD;
			&#xD;
			if(!trovataCARATTERIZZAZIONEGEO &amp;&amp; CARATTERIZZAZIONEGEO != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CARATTERIZZAZIONEGEO;&#xD;
				attributoACC.valoreAttributo = CARATTERIZZAZIONEGEO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto CARATTERIZZAZIONEGEO in &quot;+componente.nomeComponente+&quot; con valore: &quot;+CARATTERIZZAZIONEGEO);&#xD;
			}&#xD;
			if(!trovataAREA &amp;&amp; AREA != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.AREA;&#xD;
				attributoACC.valoreAttributo = AREA;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto AREA in &quot;+componente.nomeComponente+&quot; con valore: &quot;+AREA);&#xD;
			}&#xD;
			if(!trovataBANDOPUBBLICO &amp;&amp; BANDOPUBBLICO != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.BANDOPUBBLICO;&#xD;
				attributoACC.valoreAttributo = BANDOPUBBLICO;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto BANDOPUBBLICO in &quot;+componente.nomeComponente+&quot; con valore: &quot;+BANDOPUBBLICO);&#xD;
			}&#xD;
			if(!trovataDIRETTOINFRATEL &amp;&amp; DIRETTOINFRATEL != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIRETTOINFRATEL;&#xD;
				attributoACC.valoreAttributo = DIRETTOINFRATEL;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto DIRETTOINFRATEL in &quot;+componente.nomeComponente+&quot; con valore: &quot;+DIRETTOINFRATEL);&#xD;
			}&#xD;
			if(!trovataSPECIALPRICE &amp;&amp; SPECIALPRICE != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SPECIALPRICE;&#xD;
				attributoACC.valoreAttributo = SPECIALPRICE;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto SPECIALPRICE in &quot;+componente.nomeComponente+&quot; con valore: &quot;+SPECIALPRICE);&#xD;
			}&#xD;
			if(!trovataCOPERTOFTTH &amp;&amp; COPERTOFTTH != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.COPERTOFTTH;&#xD;
				attributoACC.valoreAttributo = COPERTOFTTH;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto COPERTOFTTH in &quot;+componente.nomeComponente+&quot; con valore: &quot;+COPERTOFTTH);&#xD;
			}&#xD;
			if(!trovataSISTEMADICREATION &amp;&amp; SISTEMADICREATION != null){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SISTEMADICREATION;&#xD;
				attributoACC.valoreAttributo = SISTEMADICREATION;&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));					&#xD;
				Process.auditLog(&quot;Aggiunto SISTEMADICREATION in &quot;+componente.nomeComponente+&quot; con valore: &quot;+SISTEMADICREATION);&#xD;
			}				&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
</xpdl2:Script>
