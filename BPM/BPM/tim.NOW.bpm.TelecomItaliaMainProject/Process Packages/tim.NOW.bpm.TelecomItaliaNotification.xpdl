                  </xpdExt:ScriptInformation>
                  <xpdl2:Actual ScriptGrammar="JavaScript">var TN = &quot;SP&quot;;&#xD;
&#xD;
if(localRequest.strutturaRichiesta ==  it_telecomitalia_it_NOW_casedata_TipoStrutturaRichiestaEnumeration.REGOLATORIO&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON //SM_10829 - Aggiunta gestione ad-hoc per GPON&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR  //RU_1581&#xD;
|| localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR){&#xD;
	TN = &quot;OS&quot;;&#xD;
}&#xD;
&#xD;
TN;</xpdl2:Actual>
