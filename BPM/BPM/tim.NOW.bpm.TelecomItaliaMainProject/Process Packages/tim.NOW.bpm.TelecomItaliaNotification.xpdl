        <xpdl2:Activity Id="_2npqIsdUEe63LPJdqcE9-A" Name="CheckDAC" IsATransaction="false" xpdExt:Visibility="Private" xpdExt:DisplayName="Check DAC" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:Task>
              <xpdl2:TaskScript>
                <xpdl2:Script ScriptGrammar="JavaScript">var DACDaConsiderare = DateTimeUtil.createDate();&#xD;
&#xD;
if(localRequest.ordine!= null &amp;&amp; localRequest.ordine.DACRimodulata != null)&#xD;
{&#xD;
	DACDaConsiderare = DateTimeUtil.createDate(localRequest.ordine.DACRimodulata);&#xD;
}&#xD;
else if(localRequest.DAC != null)&#xD;
{&#xD;
	DACDaConsiderare = DateTimeUtil.createDate(localRequest.DAC);&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;DAC da considerare: &quot; + String(DACDaConsiderare));&#xD;
RimodulaDAC = false;&#xD;
&#xD;
//CHECK sulla DACRIMODULATA o sulla DAC &#xD;
if(DACDaConsiderare != null &amp;&amp; OutputDate != null &amp;&amp; DACDaConsiderare &lt; OutputDate)&#xD;
{	&#xD;
	RimodulaDAC = true;&#xD;
}</xpdl2:Script>
              </xpdl2:TaskScript>
            </xpdl2:Task>
          </xpdl2:Implementation>
