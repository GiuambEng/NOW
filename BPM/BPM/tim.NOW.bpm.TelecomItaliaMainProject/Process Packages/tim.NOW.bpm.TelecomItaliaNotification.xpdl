                      <xpdl2:Actual ScriptGrammar="JavaScript">ManageNotificationDTU.idEventoOrdnNowWhls</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDNotifica">
                      <xpdExt:ScriptInformation Id="_clz3cPN0Eea0IIfSNuNvZQ" Name="Script1">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(TargetNotifica.get(Process.getActivityLoopIndex()) == &quot;RECIPIENT&quot;)&#xD;
{&#xD;
	localRequest.IDNotifica;&#xD;
}&#xD;
else&#xD;
{&#xD;
	0;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDNotificaDonating">
                      <xpdExt:ScriptInformation Id="_dY0owPN0Eea0IIfSNuNvZQ" Name="Script2">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(TargetNotifica.get(Process.getActivityLoopIndex()) == &quot;DONATING&quot;)&#xD;
{&#xD;
	localRequest.IDNotificaDonating;&#xD;
}&#xD;
else&#xD;
{&#xD;
	0;&#xD;
}</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="IN" Formal="IDNotificaDonor">
                      <xpdExt:ScriptInformation Id="_d-orkPN0Eea0IIfSNuNvZQ" Name="Script3">
                        <xpdExt:Expression ScriptGrammar="JavaScript"/>
                      </xpdExt:ScriptInformation>
                      <xpdl2:Actual ScriptGrammar="JavaScript">if(TargetNotifica.get(Process.getActivityLoopIndex()) == &quot;DONOR&quot;)&#xD;
{&#xD;
	localRequest.IDNotificaDonor;&#xD;
}&#xD;
else&#xD;
{&#xD;
	0;&#xD;
}</xpdl2:Actual>
