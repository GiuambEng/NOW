        <xpdl2:Activity Id="_CtepYCExEeiT7Naqtp1dKg" Name="StartTimerSospesoAppuntamento" FinishMode="Automatic" IsATransaction="false" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="Start Timer Sospeso Appuntamento" xpdExt:RequireNewTransaction="false">
          <xpdl2:Implementation>
            <xpdl2:SubFlow Id="_fNLPECEvEeiT7Naqtp1dKg" PackageRef="tim.NOW.bpm.invokeInternalService.Interface" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true" xpdExt:AllowUnqualifiedSubProcessIdentification="false" xpdExt:ProcessIdentifierField="ProcessIdentifier">
              <xpdExt:InputMappings MapperContext="ProcessToSubProcess" MappingDirection="IN">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="Scadenza">
                    <xpdExt:ScriptInformation Id="_CtepYSExEeiT7Naqtp1dKg" Name="Script1">
                      <xpdExt:Expression ScriptGrammar="JavaScript">var Scadenza = DateTimeUtil.createDatetime();&#xD;
Scadenza=null;&#xD;
var tempo = DateTimeUtil.createTime(0,0,0,0);&#xD;
&#xD;
var one_day= DateTimeUtil.createDuration(true,0,0,1,0,0,0);&#xD;
&#xD;
if(localRequest.ordine.DUA!=null)&#xD;
{&#xD;
	Scadenza=DateTimeUtil.createDatetime(localRequest.ordine.DUA,tempo);&#xD;
	Scadenza.add(one_day);&#xD;
}&#xD;
else if(localRequest.ordine.dettaglioordine!=null &amp;&amp; localRequest.ordine.dettaglioordine.size()>0)&#xD;
{&#xD;
	var DATA_APPUNTAMENTO = DateTimeUtil.createDate();&#xD;
	DATA_APPUNTAMENTO=null;&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++)&#xD;
	{&#xD;
		var currentDettaglio = localRequest.ordine.dettaglioordine.get(i);&#xD;
		if(currentDettaglio.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPUNTAMENTO &#xD;
			&amp;&amp; currentDettaglio.attributiDettaglioOrdine!=null&#xD;
			&amp;&amp; currentDettaglio.attributiDettaglioOrdine.size()>0)&#xD;
		{&#xD;
			for(var j=0; j&lt;currentDettaglio.attributiDettaglioOrdine.size()>0; j++)&#xD;
			{&#xD;
				var currentAttributo=currentDettaglio.attributiDettaglioOrdine.get(j);&#xD;
				if(currentAttributo.nomeAttributo==it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DATAAPPUNTAMENTO)&#xD;
				{&#xD;
					if(DATA_APPUNTAMENTO==null &amp;&amp; currentAttributo.valoreAttributo!=null &amp;&amp; currentAttributo.valoreAttributo!=&quot;&quot;)&#xD;
					{&#xD;
						DATA_APPUNTAMENTO=DateTimeUtil.createDate(currentAttributo.valoreAttributo);&#xD;
					}&#xD;
					else if(DATA_APPUNTAMENTO!=null &amp;&amp; currentAttributo.valoreAttributo!=null &amp;&amp; currentAttributo.valoreAttributo!=&quot;&quot;)&#xD;
					{&#xD;
						var dataTemp = DateTimeUtil.createDate(currentAttributo.valoreAttributo);&#xD;
						if(dataTemp>DATA_APPUNTAMENTO)&#xD;
						{&#xD;
							DATA_APPUNTAMENTO=dataTemp;&#xD;
						}&#xD;
					}&#xD;
				}&#xD;
				&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
	if(DATA_APPUNTAMENTO!=null)&#xD;
	{&#xD;
		Scadenza=DateTimeUtil.createDatetime(DATA_APPUNTAMENTO,tempo);&#xD;
		Scadenza.add(one_day);&#xD;
	}&#xD;
	&#xD;
}&#xD;
&#xD;
if(Scadenza==null &amp;&amp; localRequest.ordine.DADRimodulata!=null)&#xD;
{&#xD;
	Scadenza=DateTimeUtil.createDatetime(localRequest.ordine.DADRimodulata,tempo);&#xD;
	Scadenza.add(one_day);&#xD;
}&#xD;
else if(Scadenza==null &amp;&amp; localRequest.ordine.DAD!=null)&#xD;
{&#xD;
	Scadenza=DateTimeUtil.createDatetime(localRequest.ordine.DAD,tempo);&#xD;
	Scadenza.add(one_day);&#xD;
}&#xD;
&#xD;
return Scadenza;</xpdExt:Expression>
                    </xpdExt:ScriptInformation>
                    <xpdl2:Actual ScriptGrammar="JavaScript">__SCRIPT__</xpdl2:Actual>
