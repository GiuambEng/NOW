                  </xpdExt:DataMapping>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="ActivityInterface.DataMapperContent" xpdExt:TargetContributorId="ProcessToSubProcess.DataMapperContent" Direction="IN" Formal="RetryFFNotifiche_Request">
                    <xpdl2:Actual ScriptGrammar="JavaScript">RetryFFNotifiche_Request</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:InputMappings>
              <xpdExt:OutputMappings MapperContext="SubProcessToProcess" MappingDirection="OUT">
                <xpdExt:DataMappings>
                  <xpdExt:DataMapping xpdExt:SourceContributorId="SubProcessToProcess.DataMapperContent" xpdExt:TargetContributorId="ActivityInterface.DataMapperContent" Direction="IN" Formal="RetryFFNotifiche_Response">
                    <xpdl2:Actual ScriptGrammar="JavaScript">RetryFFNotifiche_Response</xpdl2:Actual>
                  </xpdExt:DataMapping>
                </xpdExt:DataMappings>
              </xpdExt:OutputMappings>
            </xpdl2:SubFlow>
          </xpdl2:Implementation>
          <xpdl2:TransitionRestrictions>
            <xpdl2:TransitionRestriction>
              <xpdl2:Join Type="Exclusive" ExclusiveType="Data"/>
            </xpdl2:TransitionRestriction>
          </xpdl2:TransitionRestrictions>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="64.0" LaneId="_jVYsLAOpEeaIdPdRimpTnw" Width="96.0">
              <xpdl2:Coordinates XCoordinate="713.0" YCoordinate="1827.0"/>
            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.FF.xpdl.TINOWRetryNotificheFF&quot;;&#xD;
RetryFFNotifiche_Request = com_tim_NOW_xsd_RetryFF_Factory.createRetryRequestType();&#xD;
&#xD;
RetryFFNotifiche_Request.idRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
RetryFFNotifiche_Request.numTentativo = localRequest.idProgressivoNotificheFF;&#xD;
&#xD;
if (GetFromStaging) {&#xD;
	RetryFFNotifiche_Request.azione = com_tim_NOW_xsd_RetryFF_AzioneType.GET;&#xD;
	RetryFFNotifiche_Request.numTentativo = localRequest.idProgressivoNotificheFF;&#xD;
	}&#xD;
&#xD;
else {&#xD;
	RetryFFNotifiche_Request.azione = com_tim_NOW_xsd_RetryFF_AzioneType.RETRY;&#xD;
	&#xD;
	//numero tentativo viene incrementato di 1 rispetto all'output della prima chiamata&#xD;
	RetryFFNotifiche_Request.numTentativo = RetryFFNotifiche_Response.numTentativo+1;&#xD;
	&#xD;
	&#xD;
	RetryFFNotifiche_Request.codiceEgon = RetryFFNotifiche_Response.codiceEgon;&#xD;
	RetryFFNotifiche_Request.codiceSplitterPrimario = RetryFFNotifiche_Response.codiceSplitterPrimario;&#xD;
	RetryFFNotifiche_Request.codiceSplitterSecondario = RetryFFNotifiche_Response.codiceSplitterSecondario;&#xD;
	//RetryFFNotifiche_Request.errorMessage&#xD;
	RetryFFNotifiche_Request.idGpon = RetryFFNotifiche_Response.idGpon;&#xD;
	RetryFFNotifiche_Request.posizioneMorsettiera = RetryFFNotifiche_Response.posizioneMorsettiera;&#xD;
	RetryFFNotifiche_Request.posizioneMorsettieraRoe = RetryFFNotifiche_Response.posizioneMorsettieraRoe;&#xD;
	RetryFFNotifiche_Request.progettazione = RetryFFNotifiche_Response.progettazione;&#xD;
	}&#xD;
&#xD;
Process.auditLog('CallRetryFF azione :'+RetryFFNotifiche_Request.azione+' numeroTentativo:'+RetryFFNotifiche_Request.numTentativo);&#xD;
&#xD;
</xpdExt:Information>
            </xpdExt:AuditEvent>
            <xpdExt:AuditEvent Type="Completed">
              <xpdExt:Information ScriptGrammar="JavaScript">GetFromStaging = false;&#xD;
&#xD;
if (RetryFFNotifiche_Request.azione == com_tim_NOW_xsd_RetryFF_AzioneType.RETRY &amp;&amp; RetryFFNotifiche_Response.azione == com_tim_NOW_xsd_RetryFF_AzioneType.OK) {&#xD;
&#xD;
localRequest.idProgressivoNotificheFF = RetryFFNotifiche_Response.numTentativo;&#xD;
&#xD;
}</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
