          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//Caso 3) Richiesta di Annullamento - la target non va modificata in caso di KO&#xD;
//Cluster RA - scartiamo la richiesta di annullamento&#xD;
//Cluster BO - mettiamo flagAbilitazioneManualeGUI = SI nella richiesta di annullamento&#xD;
(EsitoEmissione == &quot;KO&quot; &amp;&amp; TipoEmissione == &quot;ANNULLAMENTO_OF&quot;)&#xD;
&#xD;
//Caso 2) Richiesta di RimodulazioneDAD - caso KO&#xD;
//Cluster RA - scartiamo la richiesta di rimodulazioneDAD&#xD;
//Cluster BO - mettiamo flagAbilitazioneManualeGUI = SI nella richiesta di rimodulazioneDAD&#xD;
|| (EsitoEmissione == &quot;KO&quot; &amp;&amp; TipoEmissione == &quot;RDAD_OF&quot;)&#xD;
&#xD;
//Caso 2) Richiesta di InterruzioneSospensione - caso KO&#xD;
//Cluster BO - mettiamo flagAbilitazioneManualeGUI = SI nella richiesta di rimodulazioneDAD&#xD;
|| (EsitoEmissione == &quot;KO&quot; &amp;&amp; TipoEmissione == &quot;DESOSPENSIONE_OF&quot;)&#xD;
&#xD;
//RIENTRI DEL82 - C01 2026&#xD;
|| (TipoEmissione == &quot;RDAC_OF_OLO&quot; &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;);</xpdl2:Expression></xpdl2:Condition>
