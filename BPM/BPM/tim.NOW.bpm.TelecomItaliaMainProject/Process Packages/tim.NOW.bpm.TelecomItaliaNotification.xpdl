												//ESITOCONSEGNAAPPARATO - SM_11967 - solo per RIENTRI MIG DEL82&#xD;
												if(ESITOCONSEGNAAPPARATO != null &amp;&amp; !foundESITOCONSEGNAApparato&#xD;
