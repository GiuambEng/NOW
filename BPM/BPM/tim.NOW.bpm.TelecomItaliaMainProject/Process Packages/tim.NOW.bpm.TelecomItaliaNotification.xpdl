            <xpdl2:Activity Id="_T_80cSXxEea6a4eCDXx0DA" Name="TIMNOWConvertitore_DettaglioAsset" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="TIMNOW-Convertitore_DettaglioAsset">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_pI0ohiXtEea6a4eCDXx0DA" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="DettaglioAssetXSD">
                      <xpdl2:Actual ScriptGrammar="JavaScript">currentArricchimento.arricchimento.dettaglioAssetElement</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="DettaglioAssetBOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ARR_dettaglioAsset</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="265.0" YCoordinate="46.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">if (ARR_dettaglioAsset!= null)&#xD;
{&#xD;
 	var date = DateTimeUtil.createDatetime();&#xD;
 	&#xD;
 	ARR_dettaglioAsset.created = date;&#xD;
 	ARR_dettaglioAsset.lastUpdate = date;&#xD;
 	&#xD;
 	if (ARR_dettaglioAsset.attributidettaglioasset!= null)&#xD;
 	{&#xD;
 		for (var i=0; i&lt; ARR_dettaglioAsset.attributidettaglioasset.size(); i++)&#xD;
 		{&#xD;
 			var currentARRdettAsset = ARR_dettaglioAsset.attributidettaglioasset.get(i);&#xD;
 			&#xD;
 			currentARRdettAsset.created = date;&#xD;
 			currentARRdettAsset.lastUpdate = date;&#xD;
 		&#xD;
 		}&#xD;
 	&#xD;
 	}&#xD;
&#xD;
}&#xD;
&#xD;
&#xD;
if(ARR_dettaglioAsset != null &amp;&amp; currentArricchimento.operation == com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.CREATE)&#xD;
{&#xD;
	localAsset.dettaglioasset.add(ScriptUtil.copy(ARR_dettaglioAsset));&#xD;
}&#xD;
else if(ARR_dettaglioAsset != null &amp;&amp; currentArricchimento.operation == com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.UPDATE)&#xD;
{&#xD;
	//TO DO&#xD;
}&#xD;
</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
            </xpdl2:Activity>
            <xpdl2:Activity Id="_T_80ciXxEea6a4eCDXx0DA" Name="TIMNOWConvertitore_DettaglioOrdine" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="TIMNOW-Convertitore_DettaglioOrdine">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_pI0ojiXtEea6a4eCDXx0DA" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="DettaglioOrdineXSD">
                      <xpdl2:Actual ScriptGrammar="JavaScript">currentArricchimento.arricchimento.dettaglioOrdineElement</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="DettaglioOrdineBOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ARR_dettaglioOrdine</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="263.0" YCoordinate="134.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">//QUESTO SCRIPT HA RAGGIUNTO IL LIMITE DI LUNGHEZZA SUL BPM - NON VA AGGIUNTO ALTRO&#xD;
var listaIDRimossi = DataUtil.createList(); var listaComponentiRimosse = DataUtil.createList();&#xD;
var STRUTTURALINEA = &quot;&quot;; STRUTTURALINEA = null; var CAPOSTIPITE = &quot;&quot;; CAPOSTIPITE = null;&#xD;
var RADICALE = &quot;&quot;; RADICALE = null; var IDSLUCOdtu = &quot;&quot;; IDSLUCOdtu = null;&#xD;
var POSIZIONEARLTI1dtu = &quot;&quot;; POSIZIONEARLTI1dtu = null; var POSIZIONEARLTI2dtu = &quot;&quot;; POSIZIONEARLTI2dtu = null;&#xD;
var CANALITOTALI = &quot;&quot;; CANALITOTALI = null; var CANALIBIDIREZIONALI = &quot;&quot;; CANALIBIDIREZIONALI = null;&#xD;
var CANALIENTRANTI = &quot;&quot;; CANALIENTRANTI = null; var RITIROPRODOTTI = &quot;&quot;; RITIROPRODOTTI = null;&#xD;
var TIPORETEric = &quot;&quot;; TIPORETEric = null; var IPADDRESSNET = &quot;&quot;; IPADDRESSNET = null;    //SM_11358: IPADDRESSNET e SUBNETMASKNET&#xD;
var SUBNETMASKNET = &quot;&quot;; SUBNETMASKNET = null; var REMOTEID = &quot;&quot;; REMOTEID = null;   //SM_11416: REMOTEID&#xD;
&#xD;
//rimuovi componente per sostituzione&#xD;
for(var j = 0; j &lt; ARR_dettaglioOrdine.size(); j++){&#xD;
   var currentARRdettOrdine = ARR_dettaglioOrdine.get(j);&#xD;
   if(localRequest.ordine != null){&#xD;
	 var k = 0;&#xD;
	 while(k &lt; localRequest.ordine.dettaglioordine.size()){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(k);		&#xD;
		if(componente.nomeComponente == currentARRdettOrdine.nomeComponente)&#xD;
		{&#xD;
			//ECCEZIONE TIPO_RETE FIBERCOP (Bug #33225) - salvo TIPORETE prima della sostituzione per metterlo nella componente che risale dal BW&#xD;
			if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIOPERATORERETE){&#xD;
				for(var z = 0; z&lt;componente.attributiDettaglioOrdine.size(); z++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(z);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.TIPORETE){&#xD;
						TIPORETEric = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIACCESSO){   //SM_11358&#xD;
				for(var indx = 0; indx&lt;componente.attributiDettaglioOrdine.size(); indx++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(indx);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPADDRESSNET){&#xD;
						IPADDRESSNET = attributo.valoreAttributo;&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUBNETMASKNET){&#xD;
						SUBNETMASKNET = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}&#xD;
			else if(componente.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIVC){    //SM_11416&#xD;
				for(var indx2 = 0; indx2&lt;componente.attributiDettaglioOrdine.size(); indx2++){&#xD;
					var attributo = componente.attributiDettaglioOrdine.get(indx2);&#xD;
				&#xD;
					if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID){&#xD;
						REMOTEID = attributo.valoreAttributo;&#xD;
					}&#xD;
				}&#xD;
			}			&#xD;
			Process.auditLog(&quot;E' stata rimossa per sostituzione la componente &quot;+currentARRdettOrdine.nomeComponente);&#xD;
			listaIDRimossi.add(componente.IDDettaglioOrdine);&#xD;
			listaComponentiRimosse.add(componente.nomeComponente);&#xD;
			localRequest.ordine.dettaglioordine.remove(k);&#xD;
			k--;&#xD;
		}&#xD;
		k++;&#xD;
	 }&#xD;
   }&#xD;
}&#xD;
var date = DateTimeUtil.createDatetime(); var NumDirEntrante = 0;&#xD;
&#xD;
for(var j = 0; j &lt; ARR_dettaglioOrdine.size(); j++){	   &#xD;
       var currentARRdettOrdine = ARR_dettaglioOrdine.get(j);	   &#xD;
	   //RU_1450 - Per DTUSERVIZIOAGGIUNTIVO/DTUAPPARATO serve gestire il legame delle componenti di livello L3 (script successivo)&#xD;
	   if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FIBERSTREAM&#xD;
	      &amp;&amp;(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSERVIZIOAGGIUNTIVO&#xD;
	         || currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAPPARATO)){&#xD;
			ARR_dettaglioOrdineOF_L3.add(ScriptUtil.copy(currentARRdettOrdine)); //me le salvo tutte in questo array per poi manipolarle nello script successivo&#xD;
			Process.auditLog(&quot;Aggiunta nell'arrayOF la componente: &quot; + String(currentARRdettOrdine.nomeComponente)+ &quot; con IDDettaglioOrdine: &quot; + String(currentARRdettOrdine.IDDettaglioOrdine));&#xD;
	   }&#xD;
	   else{&#xD;
		   currentARRdettOrdine.integrationID = localRequest.IDRichiestaOLO + (localRequest.ordine.dettaglioordine.size() + 1);		   		   &#xD;
		   var idDettOrd = localRequest.ordine.dettaglioordine.size() + 1 + listaIDRimossi.size(); //SM_8678: aggiunto listaIDRimossi.size() per evitare ID duplicati&#xD;
		   &#xD;
		   if(listaComponentiRimosse.contains(currentARRdettOrdine.nomeComponente)){&#xD;
				 var trovato = false; var z = 0;				 &#xD;
				 while(!trovato &amp;&amp; z &lt; listaComponentiRimosse.size()){&#xD;
						if(listaComponentiRimosse.get(z) == currentARRdettOrdine.nomeComponente){&#xD;
							   idDettOrd = listaIDRimossi.get(z);&#xD;
							   listaComponentiRimosse.remove(z);&#xD;
							   listaIDRimossi.remove(z);&#xD;
							   trovato = true;&#xD;
						}&#xD;
						z++;&#xD;
				 }&#xD;
		   }				 &#xD;
		   currentARRdettOrdine.IDDettaglioOrdine = idDettOrd;&#xD;
		   currentARRdettOrdine.IDDettaglioOrdineParent = 1;&#xD;
		   currentARRdettOrdine.IDDettaglioOrdineRoot = 1;&#xD;
		   currentARRdettOrdine.created = date;&#xD;
		   currentARRdettOrdine.lastUpdate = date;&#xD;
				  &#xD;
		   var NOTEPEROLO =&quot;&quot;; var CCLICENTRALE =&quot;&quot;; var CCLIARMADIO =&quot;&quot;;&#xD;
		   var trovatoNUMEROTELEFONICOPRINCIPALE = false;	   &#xD;
		   var DirezionalitaDPA = &quot;&quot;; DirezionalitaDPA = null; var StatoDPA = &quot;&quot;; StatoDPA = null;&#xD;
		   &#xD;
		   for(var i = 0; i &lt; currentARRdettOrdine.attributiDettaglioOrdine.size(); i++){&#xD;
				 var attributo = currentARRdettOrdine.attributiDettaglioOrdine.get(i);				 &#xD;
				 attributo.IDDettaglioOrdine = idDettOrd;&#xD;
				 attributo.created = date;&#xD;
				 attributo.lastUpdate = date;&#xD;
&#xD;
				 // ECCEZIONE TIPO_RETE FIBERCOP (Bug #33225) - ho salvato TIPORETE prima della sostituzione per metterlo nella componente che risale dal BW&#xD;
