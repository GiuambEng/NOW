        <xpdl2:Activity Id="_sUgkB8mREe6tB5HEgGPwCw" Name="ForeachARRICCHIMENTO" xpdExt:DisplayName="For each ARRICCHIMENTO">
          <xpdl2:BlockActivity xpdExt:IsEventSubProcess="false" ActivitySetId="_sUgkCcmREe6tB5HEgGPwCw" View="EXPANDED"/>
          <xpdl2:DataFields>
            <xpdl2:DataField Id="_sUgkCMmREe6tB5HEgGPwCw" xpdExt:DisplayName="currentArricchimento" Name="currentArricchimento" ReadOnly="false">
              <xpdl2:DataType>
                <xpdl2:ExternalReference location="com.tim.NOW.xsd.StateMachineOF.bom" namespace="http://www.eclipse.org/uml2/3.0.0/UML" xref="com.tim.NOW.xsd.StateMachineOFArricchimentoType"/>
              </xpdl2:DataType>
              <xpdl2:InitialValue/>
            </xpdl2:DataField>
          </xpdl2:DataFields>
          <xpdl2:Loop LoopType="MultiInstance">
            <xpdl2:LoopMultiInstance MI_FlowCondition="All" MI_Ordering="Sequential">
              <xpdl2:MI_Condition ScriptGrammar="JavaScript">StateMachineValidationResponseOF.ARRICCHIMENTI.size();</xpdl2:MI_Condition>
              <xpdExt:MultiInstanceScripts/>
            </xpdl2:LoopMultiInstance>
          </xpdl2:Loop>
          <xpdl2:NodeGraphicsInfos>
            <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,230,138" Height="425.0" LaneId="_KTFC0cmNEe6tB5HEgGPwCw" Width="648.0">
