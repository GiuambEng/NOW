          <xpdl2:Condition Type="CONDITION"><xpdl2:Expression ScriptGrammar="JavaScript">//Caso 3 della richiesta di Annullamento FBS&#xD;
//Caso 2 della richiesta di RimodulazioneDAD FBS&#xD;
((TipoEmissione == &quot;ANNULLAMENTO_OF&quot;&#xD;
    || TipoEmissione == &quot;RDAD_OF&quot;)&#xD;
&amp;&amp; (localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ACCETTATOOK&#xD;
   || localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.ACQUISITOOK&#xD;
   || localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.SOSPESOOF))&#xD;
&#xD;
||&#xD;
&#xD;
//Caso 2 della richiesta di Desospensione FBS&#xD;
(TipoEmissione == &quot;DESOSPENSIONE_OF&quot;&#xD;
 &amp;&amp; localRequest.statoRichiestaOF == it_telecomitalia_it_NOW_casedata_StatoOFEnumeration.SOSPESOOF)  &#xD;
 &#xD;
||&#xD;
&#xD;
//RIENTRI DEL82 - C01 2026&#xD;
(TipoEmissione == &quot;RDAC_OF_OLO&quot;&#xD;
  &amp;&amp; localRequest.flagRientriDel82 == &quot;SI&quot;);</xpdl2:Expression></xpdl2:Condition>
