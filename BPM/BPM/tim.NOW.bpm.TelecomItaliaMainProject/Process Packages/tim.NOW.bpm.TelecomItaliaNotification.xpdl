									var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);&#xD;
									&#xD;
									if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI){&#xD;
										trovatoNUMAGGIUNTIVI = true;&#xD;
										currentAttDettOrdine.valoreAttributo = attributo.valoreAttributo;&#xD;
										Process.auditLog(&quot;Aggiornato NUMAGGIUNTIVI in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+currentAttDettOrdine.valoreAttributo);&#xD;
									}&#xD;
									z++;&#xD;
								}								&#xD;
								if(!trovatoNUMAGGIUNTIVI){&#xD;
									var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();									&#xD;
									attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
									attributoACC.IDDettaglioOrdine = currentDettOrdine.IDDettaglioOrdine;&#xD;
									attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
									attributoACC.created = date;&#xD;
									attributoACC.lastUpdate = date;&#xD;
									attributoACC.operatore = &quot;BPM&quot;;&#xD;
									attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMAGGIUNTIVI;&#xD;
									attributoACC.valoreAttributo = attributo.valoreAttributo;&#xD;
									currentDettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
									Process.auditLog(&quot;Aggiunto NUMAGGIUNTIVI in &quot;+currentDettOrdine.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
								}&#xD;
							}&#xD;
						}	&#xD;
					}&#xD;
				 }&#xD;
				 else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO)&#xD;
				 {&#xD;
					if(localRequest.IDRisorsa != null &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
						attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
						trovatoNUMEROTELEFONICOPRINCIPALE = true;&#xD;
						Process.auditLog(&quot;Arricchito NUMEROTELEFONICOPRINCIPALE con valore: &quot;+attributo.valoreAttributo+&quot;, in &quot;+currentARRdettOrdine.nomeComponente);&#xD;
					}				 &#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA){&#xD;
						DirezionalitaDPA = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovata Direzionalita &quot;+DirezionalitaDPA);&#xD;
					}&#xD;
					else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.STATOAGGIUNTIVO){&#xD;
						StatoDPA = attributo.valoreAttributo;&#xD;
						Process.auditLog(&quot;Trovato Stato DPA &quot;+StatoDPA);&#xD;
					}&#xD;
				 }&#xD;
				 else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO){&#xD;
					if(localRequest.IDRisorsa != null&#xD;
						&amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE){&#xD;
						attributo.valoreAttributo = localRequest.IDRisorsa;&#xD;
						trovatoNUMEROTELEFONICOPRINCIPALE = true;&#xD;
					} &#xD;
				 }&#xD;
				 // RU_895: In caso di NF ESPLETAMENTO e SLU LNA potrebbe essere avvenuta una RIPROGETTAZIONE -> swap sui parametri di emissione &amp;&amp; SM_9061&#xD;
				 else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUFONIA&#xD;
					  &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null&#xD;
					  &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &#xD;
					  &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &#xD;
					  &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO)&#xD;
				 {&#xD;
					 //RECUPERO PARAMETRI PER SWAP RU_895&#xD;
					 if(localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SLULINEANONATTIVA){&#xD;
						 if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO){&#xD;
							 IDSLUCOdtu = attributo.valoreAttributo;&#xD;
						 }&#xD;
						 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI1){&#xD;
							POSIZIONEARLTI1dtu = attributo.valoreAttributo;&#xD;
						 }&#xD;
						 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI2){&#xD;
							POSIZIONEARLTI2dtu = attributo.valoreAttributo;&#xD;
						 }&#xD;
					 }&#xD;
					 else if(String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;){&#xD;
						 if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALITOTALI){&#xD;
							CANALITOTALI = attributo.valoreAttributo;&#xD;
						 }&#xD;
						 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIBIDIREZIONALI){&#xD;
							CANALIBIDIREZIONALI = attributo.valoreAttributo;&#xD;
						 }&#xD;
						 else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CANALIENTRANTI){&#xD;
							CANALIENTRANTI = attributo.valoreAttributo;&#xD;
						 }&#xD;
					 }&#xD;
				 }&#xD;
				 //RU_1128: AGGIUNTO ARRICCHIMENTO DEGLI ATTRIBUTI DI SERVIZIOPZIONALI DALLA COMPONENTE DTUSERVIZIOPZIONALI&#xD;
				 else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUSERVIZIOPZIONALI&#xD;
						 &amp;&amp; attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO&#xD;
						 &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA != null &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA != null &#xD;
						 &amp;&amp; ManageNotificationDTU.EVENTO_NOTIFICA.TESTATA.TIPOLOGIA_NOTIFICA == com_tim_NOW_xsd_Richiesta_Notifica_NOW_DTU_TipoNotificaType.NFESPLETAMENTO&#xD;
						 &amp;&amp; (localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.ATTIVAZIONE || localRequest.lavorazione == it_telecomitalia_it_NOW_casedata_LavorazioneEnumeration.MIGRAZIONE)&#xD;
						 &amp;&amp; (localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTH || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIVULAFTTH &#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTH || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIBITSTREAMNGAFTTH&#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTH || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIEASYIPNGAFTTH&#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.VULAFTTCAB || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.BITSTREAMNGAFTTCAB || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.EASYIPNGAFTTCAB&#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBSEMIGPON || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.UBBFULLGPON&#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUS || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPONPLUSNGA&#xD;
							 ||localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.SEMIGPON1BPNRR || localRequest.offerta == it_telecomitalia_it_NOW_casedata_OffertaEnumeration.FULLGPON1BPNRR   //RU_1581&#xD;
							 ||String(localRequest.offerta).slice(0,3) == 'SLU' || String(localRequest.offerta).slice(0,3) == 'ULL'))&#xD;
				 {&#xD;
					var CODICESERVIZIODTU = &quot;&quot;; CODICESERVIZIODTU = attributo.valoreAttributo;&#xD;
					Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributo.valoreAttributo +&quot; su componente DTUSERVIZIOPZIONALI con IDDett &quot;+currentARRdettOrdine.IDDettaglioOrdine);	&#xD;
					&#xD;
					for(var m=0; m&lt;localRequest.ordine.dettaglioordine.size(); m++){&#xD;
						var componenteRic = localRequest.ordine.dettaglioordine.get(m);&#xD;
						&#xD;
						if(componenteRic.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.SERVIZIOPZIONALI){&#xD;
							var CODICESERVIZIORICHIESTA = &quot;&quot;; CODICESERVIZIORICHIESTA = null;							&#xD;
							for(var q=0; q&lt;componenteRic.attributiDettaglioOrdine.size(); q++){&#xD;
								var attributoRic = componenteRic.attributiDettaglioOrdine.get(q);&#xD;
								&#xD;
								if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICESERVIZIO){&#xD;
									CODICESERVIZIORICHIESTA = attributoRic.valoreAttributo;&#xD;
									Process.auditLog(&quot;Trovato attributo CODICESERVIZIO&quot;+ attributoRic.valoreAttributo +&quot; su componente SERVIZIOPZIONALI con IDDett &quot;+componenteRic.IDDettaglioOrdine);			&#xD;
								}&#xD;
							}							&#xD;
							//DEVO ARRICCHIRE LA COMPONENTE SERVIZIOPZIONALI CHE HA LO STESSO CODICESERVIZIO DI QUELLO DELLA COMPONENTE DTUSERVIZIOPZIONALI&#xD;
							if(CODICESERVIZIORICHIESTA == CODICESERVIZIODTU)&#xD;
							{&#xD;
								var CODICEESITO = &quot;&quot;; CODICEESITO = null; var DESCESITO = &quot;&quot;; DESCESITO = null;&#xD;
								var ESITOOAO = &quot;&quot;; ESITOOAO = null; var CODICEESITOOAO = &quot;&quot;; CODICEESITOOAO = null;&#xD;
								var DESCRIZIONEESITOOAO = &quot;&quot;; DESCRIZIONEESITOOAO = null; var NOTEPEROAO = &quot;&quot;; NOTEPEROAO = null;	&#xD;
								var PARAMETRONONCONFORME = &quot;&quot;; PARAMETRONONCONFORME = null; var VALOREPARAMETRONONCONFORME = &quot;&quot;; VALOREPARAMETRONONCONFORME = null; //RU_1558&#xD;
								var foundCODICEESITO = false; var foundDESCESITO = false; var foundESITOOAO = false;&#xD;
								var foundCODICEESITOOAO = false; var foundDESCRIZIONEESITOOAO = false; var foundNOTEPEROAO = false;&#xD;
								var foundPARAMETRONONCONFORME = false; var foundVALOREPARAMETRONONCONFORME = false; //RU_1558&#xD;
								&#xD;
								//RECUPERO GLI ATTRIBUTI DALLA COMPONENTE DTUSERVIZIOPZIONALI&#xD;
								for(var z=0; z&lt;currentARRdettOrdine.attributiDettaglioOrdine.size(); z++){&#xD;
									var attributoARRdettOrdine = currentARRdettOrdine.attributiDettaglioOrdine.get(z);								&#xD;
									if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITO){&#xD;
										CODICEESITO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCESITO){&#xD;
										DESCESITO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOOAO){&#xD;
										ESITOOAO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITOOAO){&#xD;
										CODICEESITOOAO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITOOAO){&#xD;
										DESCRIZIONEESITOOAO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOTEPEROAO){&#xD;
										NOTEPEROAO = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PARAMETRONONCONFORME){ //RU_1558&#xD;
										PARAMETRONONCONFORME = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
									else if(attributoARRdettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VALOREPARAMETRONONCONFORME){ //RU_1558&#xD;
										VALOREPARAMETRONONCONFORME = attributoARRdettOrdine.valoreAttributo;&#xD;
									}&#xD;
								}									&#xD;
								//ARRICCHISCO LA COMPONENTE SERVIZIOPZIONALI CON I VALORI RECUPERATI DA DTUSERVIZIOPZIONALI&#xD;
								for(var k=0; k&lt;componenteRic.attributiDettaglioOrdine.size(); k++){&#xD;
									var attributoRic = componenteRic.attributiDettaglioOrdine.get(k);&#xD;
									&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITO &amp;&amp; CODICEESITO != null){&#xD;
										foundCODICEESITO = true;&#xD;
										attributoRic.valoreAttributo = CODICEESITO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo CODICEESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCESITO &amp;&amp; DESCESITO != null){&#xD;
										foundDESCESITO = true;&#xD;
										attributoRic.valoreAttributo = DESCESITO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo DESCESITO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOOAO &amp;&amp; ESITOOAO != null){&#xD;
										foundESITOOAO = true;&#xD;
										attributoRic.valoreAttributo = ESITOOAO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo ESITOOAO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITOOAO &amp;&amp; CODICEESITOOAO != null){&#xD;
										foundCODICEESITOOAO = true;&#xD;
										attributoRic.valoreAttributo = CODICEESITOOAO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo CODICEESITOOAO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITOOAO &amp;&amp; DESCRIZIONEESITOOAO != null){&#xD;
										foundDESCRIZIONEESITOOAO = true;&#xD;
										attributoRic.valoreAttributo = DESCRIZIONEESITOOAO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo DESCRIZIONEESITOOAO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOTEPEROAO &amp;&amp; NOTEPEROAO != null){&#xD;
										foundCODICEESITO = true;&#xD;
										attributoRic.valoreAttributo = NOTEPEROAO;&#xD;
										Process.auditLog(&quot;Aggiornato attributo NOTEPEROAO&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PARAMETRONONCONFORME &amp;&amp; PARAMETRONONCONFORME != null){ //RU_1558&#xD;
										foundPARAMETRONONCONFORME = true;&#xD;
										attributoRic.valoreAttributo = PARAMETRONONCONFORME;&#xD;
										Process.auditLog(&quot;Aggiornato attributo PARAMETRONONCONFORME&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
									if(attributoRic.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VALOREPARAMETRONONCONFORME &amp;&amp; VALOREPARAMETRONONCONFORME != null){ //RU_1558&#xD;
										foundVALOREPARAMETRONONCONFORME= true;&#xD;
										attributoRic.valoreAttributo = VALOREPARAMETRONONCONFORME;&#xD;
										Process.auditLog(&quot;Aggiornato attributo VALOREPARAMETRONONCONFORME&quot;+ attributoRic.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
									}&#xD;
								}								&#xD;
								var attributoDaAggiungere = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
								var data = DateTimeUtil.createDatetime();&#xD;
								attributoDaAggiungere.IDDettaglioOrdine = componenteRic.IDDettaglioOrdine;&#xD;
								attributoDaAggiungere.IDRichiestaOLO = componenteRic.IDRichiestaOLO;&#xD;
								attributoDaAggiungere.created = data;&#xD;
								attributoDaAggiungere.lastUpdate = data;&#xD;
								attributoDaAggiungere.operatore = componenteRic.operatore;&#xD;
								attributoDaAggiungere.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;								&#xD;
								if(CODICEESITO != null &amp;&amp; !foundCODICEESITO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = CODICEESITO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo CODICEESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(DESCESITO != null &amp;&amp; !foundDESCESITO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCESITO;&#xD;
									attributoDaAggiungere.valoreAttributo = DESCESITO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo DESCESITO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(ESITOOAO != null &amp;&amp; !foundESITOOAO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.ESITOOAO;&#xD;
									attributoDaAggiungere.valoreAttributo = ESITOOAO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo ESITOOAO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(CODICEESITOOAO != null &amp;&amp; !foundCODICEESITOOAO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.CODICEESITOOAO;&#xD;
									attributoDaAggiungere.valoreAttributo = CODICEESITOOAO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo CODICEESITOOAO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(DESCRIZIONEESITOOAO != null &amp;&amp; !foundDESCRIZIONEESITOOAO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DESCRIZIONEESITOOAO;&#xD;
									attributoDaAggiungere.valoreAttributo = DESCRIZIONEESITOOAO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo DESCRIZIONEESITOOAO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(NOTEPEROAO != null &amp;&amp; !foundNOTEPEROAO){&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NOTEPEROAO;&#xD;
									attributoDaAggiungere.valoreAttributo = NOTEPEROAO;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo NOTEPEROAO&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(PARAMETRONONCONFORME != null &amp;&amp; !foundPARAMETRONONCONFORME){ //RU_1558&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.PARAMETRONONCONFORME;&#xD;
									attributoDaAggiungere.valoreAttributo = PARAMETRONONCONFORME;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo PARAMETRONONCONFORME&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
								if(VALOREPARAMETRONONCONFORME != null &amp;&amp; !foundVALOREPARAMETRONONCONFORME){ //RU_1558&#xD;
									attributoDaAggiungere.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.VALOREPARAMETRONONCONFORME;&#xD;
									attributoDaAggiungere.valoreAttributo = VALOREPARAMETRONONCONFORME;&#xD;
									componenteRic.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoDaAggiungere));&#xD;
									Process.auditLog(&quot;Creato attributo VALOREPARAMETRONONCONFORME&quot;+ attributoDaAggiungere.valoreAttributo +&quot; su componente con IDDett &quot;+componenteRic.IDDettaglioOrdine);&#xD;
								}&#xD;
							}&#xD;
						}&#xD;
					}&#xD;
				 }&#xD;
		   }		   &#xD;
		   if(DirezionalitaDPA == &quot;ENTRANTE&quot; &amp;&amp; StatoDPA == &quot;ATTIVO&quot;){&#xD;
			   NumDirEntrante++;	//Incremento il contatore di Direzionalità entranti che arricchirà DIREZIONALITA di ACCESSOWLR&#xD;
		   }	   &#xD;
		   // Aggiunta NUMEROTELEFONICOPRINCIPALE in DTUAGGIUNTIVO o DTUPRENOTAZIONEAGGIUNTIVO&#xD;
		   if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUAGGIUNTIVO &#xD;
		   || currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUPRENOTAZIONEAGGIUNTIVO){&#xD;
			   if(!trovatoNUMEROTELEFONICOPRINCIPALE &amp;&amp; localRequest.IDRisorsa != null){&#xD;
					var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
					attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
					attributoACC.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
					attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
					attributoACC.created = date;&#xD;
					attributoACC.lastUpdate = date;&#xD;
					attributoACC.operatore = &quot;BPM&quot;;&#xD;
					attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.NUMEROTELEFONICOPRINCIPALE;&#xD;
					attributoACC.valoreAttributo = localRequest.IDRisorsa;&#xD;
					currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
					Process.auditLog(&quot;Aggiunto NUMEROTELEFONICOPRINCIPALE con valore: &quot;+attributoACC.valoreAttributo+&quot;, in &quot;+currentARRdettOrdine.nomeComponente);&#xD;
			   }&#xD;
		   }&#xD;
		   else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUNOTIFICHEOLO){&#xD;
				 localRequest.ordine.notedaSistema=&quot;&quot;;&#xD;
				 if(NOTEPEROLO!=&quot;&quot;){&#xD;
						localRequest.ordine.notedaSistema = NOTEPEROLO;       &#xD;
				 }&#xD;
		   }&#xD;
		   //SM_11358: aggiungo IPADDRESSNET e SUBNETMASKNET (salvati in precedenza dalla DTUDATIACCESSO eliminata per sostituzione) per non perderli&#xD;
		   else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIACCESSO){&#xD;
				var attributoAccesso = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributoAccesso.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoAccesso.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
				attributoAccesso.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoAccesso.created = date;&#xD;
				attributoAccesso.lastUpdate = date;&#xD;
				attributoAccesso.operatore = &quot;BPM&quot;;				&#xD;
				if(IPADDRESSNET != null){&#xD;
					var attrTemp = ScriptUtil.copy(attributoAccesso);&#xD;
					attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IPADDRESSNET;&#xD;
					attrTemp.valoreAttributo = IPADDRESSNET;&#xD;
					currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
					Process.auditLog(&quot;Aggiunto IPADDRESSNET con valore: &quot;+IPADDRESSNET+&quot;, in &quot;+currentARRdettOrdine.nomeComponente);&#xD;
				}				&#xD;
				if(SUBNETMASKNET != null){&#xD;
					var attrTemp = ScriptUtil.copy(attributoAccesso);&#xD;
					attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.SUBNETMASKNET;&#xD;
					attrTemp.valoreAttributo = SUBNETMASKNET;&#xD;
					currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
					Process.auditLog(&quot;Aggiunto SUBNETMASKNET con valore: &quot;+SUBNETMASKNET+&quot;, in &quot;+currentARRdettOrdine.nomeComponente);&#xD;
				}&#xD;
		   }&#xD;
		   //SM_11416: aggiungo REMOTEID (salvato in precedenza dalla DTUDATIVC eliminata per sostituzione) per non perderlo (arriva solo per FWAEOLO)&#xD;
		   else if(currentARRdettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DTUDATIVC){&#xD;
				var attributoAccesso = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();&#xD;
				attributoAccesso.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoAccesso.IDDettaglioOrdine = currentARRdettOrdine.IDDettaglioOrdine;&#xD;
				attributoAccesso.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoAccesso.created = date;&#xD;
				attributoAccesso.lastUpdate = date;&#xD;
				attributoAccesso.operatore = &quot;BPM&quot;;				&#xD;
				if(REMOTEID != null){&#xD;
					var attrTemp = ScriptUtil.copy(attributoAccesso);&#xD;
					attrTemp.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.REMOTEID;&#xD;
					attrTemp.valoreAttributo = REMOTEID;&#xD;
					currentARRdettOrdine.attributiDettaglioOrdine.add(ScriptUtil.copy(attrTemp));&#xD;
					Process.auditLog(&quot;Aggiunto REMOTEID con valore: &quot;+REMOTEID+&quot;, in &quot;+currentARRdettOrdine.nomeComponente);&#xD;
				}&#xD;
		   }		   &#xD;
		   localRequest.ordine.dettaglioordine.add(ScriptUtil.copy(currentARRdettOrdine));   // ARRICCHIMENTO&#xD;
	   }&#xD;
}&#xD;
//ARRICCHIMENTO GENERICO DI ATTRIBUTI NELL'ACCESSO, DA ATTRIBUTI RISALITI DA COMPONENTI DTU:&#xD;
if(RITIROPRODOTTI != null || String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;){&#xD;
	var trovatoDIREZIONALITA = false;	&#xD;
	for(var i=0; i&lt;localRequest.ordine.dettaglioordine.size(); i++){&#xD;
		var componente = localRequest.ordine.dettaglioordine.get(i);&#xD;
		&#xD;
		if(String(componente.nomeComponente).slice(0,7) == &quot;ACCESSO&quot;){&#xD;
			for(var j=0; j&lt;componente.attributiDettaglioOrdine.size(); j++){&#xD;
				var attributo = componente.attributiDettaglioOrdine.get(j);				&#xD;
				if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.RITIROPRODOTTI &amp;&amp; RITIROPRODOTTI != null){&#xD;
					attributo.valoreAttributo = RITIROPRODOTTI;&#xD;
					Process.auditLog(&quot;Aggiornato attributo RITIROPRODOTTI&quot;+ attributo.valoreAttributo +&quot; su componente con IDDett &quot;+componente.IDDettaglioOrdine);			&#xD;
				}&#xD;
				else if(attributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA &amp;&amp; String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;){&#xD;
					trovatoDIREZIONALITA = true;&#xD;
					attributo.valoreAttributo = String(NumDirEntrante);&#xD;
					Process.auditLog(&quot;Aggiornato DIREZIONALITA in &quot;+componente.nomeComponente+&quot; con valore: &quot;+attributo.valoreAttributo);&#xD;
				}&#xD;
			}			&#xD;
			if(!trovatoDIREZIONALITA &amp;&amp; String(localRequest.offerta).slice(0,3) == &quot;WLR&quot;){&#xD;
				var attributoACC = it_telecomitalia_it_NOW_casedata_Factory.createAttributiDettaglioOrdine();				&#xD;
				attributoACC.IDRichiestaOLO = localRequest.IDRichiestaOLO;&#xD;
				attributoACC.IDDettaglioOrdine = componente.IDDettaglioOrdine;&#xD;
				attributoACC.tipologiaDato = it_telecomitalia_it_NOW_casedata_TipologiaDatoEnumeration.VARCHAR2;&#xD;
				attributoACC.created = date;&#xD;
				attributoACC.lastUpdate = date;&#xD;
				attributoACC.operatore = &quot;BPM&quot;;&#xD;
				attributoACC.nomeAttributo = it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.DIREZIONALITA;&#xD;
				attributoACC.valoreAttributo = String(NumDirEntrante);&#xD;
				componente.attributiDettaglioOrdine.add(ScriptUtil.copy(attributoACC));&#xD;
				Process.auditLog(&quot;Aggiunto DIREZIONALITA in &quot;+componente.nomeComponente+&quot; con valore: &quot;+attributoACC.valoreAttributo);&#xD;
			}&#xD;
		}	&#xD;
	}&#xD;
}&#xD;
if(IDSLUCOdtu != null || POSIZIONEARLTI1dtu != null || POSIZIONEARLTI2dtu != null || CANALITOTALI != null || CANALIBIDIREZIONALI != null || CANALIENTRANTI != null){&#xD;
	var trovatoIDSLUCO = false; var trovatoPOSIZIONEARLTI1 = false; var trovatoPOSIZIONEARLTI2 = false;	&#xD;
	var IDSLUCOold = &quot;&quot;; IDSLUCOold = null;&#xD;
	var POSIZIONEARLTI1old = &quot;&quot;; POSIZIONEARLTI1old = null;&#xD;
	var POSIZIONEARLTI2old = &quot;&quot;; POSIZIONEARLTI2old = null;&#xD;
&#xD;
	for(var i2 = 0; i2 &lt; localRequest.ordine.dettaglioordine.size(); i2++){&#xD;
		var currentDettOrdine = localRequest.ordine.dettaglioordine.get(i2);		&#xD;
		if(currentDettOrdine.nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.ACCESSOSLU){&#xD;
			var z = 0;&#xD;
			while((!trovatoIDSLUCO || !trovatoPOSIZIONEARLTI1 || !trovatoPOSIZIONEARLTI2) &amp;&amp; z &lt; currentDettOrdine.attributiDettaglioOrdine.size())&#xD;
			{&#xD;
				var currentAttDettOrdine = currentDettOrdine.attributiDettaglioOrdine.get(z);				&#xD;
				if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDSLUCO &amp;&amp; IDSLUCOdtu != null){&#xD;
					trovatoIDSLUCO = true;&#xD;
					IDSLUCOold = currentAttDettOrdine.valoreAttributo;&#xD;
					currentAttDettOrdine.valoreAttributo = IDSLUCOdtu;&#xD;
					Process.auditLog(&quot;Aggiornato IDSLUCO da &quot;+IDSLUCOold+&quot; con valore: &quot;+IDSLUCOdtu);&#xD;
				}&#xD;
				else if(currentAttDettOrdine.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.POSIZIONEARLTI1 &amp;&amp; POSIZIONEARLTI1dtu != null){&#xD;
					trovatoPOSIZIONEARLTI1 = true;&#xD;
					POSIZIONEARLTI1old = currentAttDettOrdine.valoreAttributo;&#xD;
					currentAttDettOrdine.valoreAttributo = POSIZIONEARLTI1dtu;&#xD;
