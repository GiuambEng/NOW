														}&#xD;
														else if(((NOMESERVIZIOOF == &quot;TLC1&quot; || (NOMESERVIZIOOF == &quot;TLC4&quot; &amp;&amp; NMUFITTIZIO == null)) &amp;&amp; (ESITOCONSEGNAAPPARATO == &quot;1&quot; || ESITOCONSEGNAAPPARATO == &quot;2&quot;)))&#xD;
														{&#xD;
															attributoRic1.valoreAttributo = &quot;1&quot;;&#xD;
