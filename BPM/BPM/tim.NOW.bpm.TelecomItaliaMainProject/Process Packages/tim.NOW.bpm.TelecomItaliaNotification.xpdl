            </xpdl2:NodeGraphicsInfo>
          </xpdl2:NodeGraphicsInfos>
          <xpdl2:Extensions/>
          <xpdExt:Audit>
            <xpdExt:AuditEvent Type="Initiated">
              <xpdExt:Information ScriptGrammar="JavaScript">ProcessIdentifier = &quot;/tim.NOW.bpm.invokeExternalService/Process Packages/tim.NOW.bpm.invokeExternalService.B2B.xpdl.TINOWB2BRicariche&quot;;&#xD;
&#xD;
for (var i=0; i&lt; localRequest.ordine.dettaglioordine.size(); i++)&#xD;
{&#xD;
	var currentComponente = localRequest.ordine.dettaglioordine.get(i);&#xD;
	&#xD;
	if (currentComponente. nomeComponente == it_telecomitalia_it_NOW_casedata_DizionarioComponentiEnumeration.DATIRICARICA)&#xD;
	{&#xD;
		for (var j=0; j&lt; currentComponente.attributiDettaglioOrdine.size(); j++)&#xD;
		{&#xD;
			var currentAttributo = currentComponente.attributiDettaglioOrdine.get(j);&#xD;
			&#xD;
			if (currentAttributo.nomeAttributo == it_telecomitalia_it_NOW_casedata_DizionarioAttributiEnumeration.IDENTIFICATIVOASSETRICARICA)&#xD;
			{&#xD;
				IDAssetRicarica = currentAttributo.valoreAttributo;&#xD;
			}&#xD;
		}&#xD;
	}&#xD;
}&#xD;
&#xD;
Process.auditLog(&quot;Chiamata a B2B, Stato: &quot;+localRequest.statoRichiestaNOW+&quot;. IDAssetRicarica: &quot;+IDAssetRicarica);</xpdExt:Information>
            </xpdExt:AuditEvent>
          </xpdExt:Audit>
        </xpdl2:Activity>
