            <xpdl2:Activity Id="_T_80cyXxEea6a4eCDXx0DA" Name="TIMNOWConvertitore_Referente" FinishMode="Automatic" StartMode="Automatic" xpdExt:Visibility="Private" xpdExt:DisplayName="TIMNOW-Convertitore_Referente">
              <xpdl2:Implementation>
                <xpdl2:SubFlow Id="_pI0ofiXtEea6a4eCDXx0DA" PackageRef="tim.NOW.bpm.TelecomItaliaSupporting" xpdExt:StartStrategy="StartImmediately" xpdExt:SuspendResumeWithParent="true">
                  <xpdl2:DataMappings>
                    <xpdl2:DataMapping Direction="IN" Formal="DettaglioOrdineXSD">
                      <xpdl2:Actual ScriptGrammar="JavaScript">currentArricchimento.arricchimento.referenteElement</xpdl2:Actual>
                    </xpdl2:DataMapping>
                    <xpdl2:DataMapping Direction="OUT" Formal="ReferenteBOM">
                      <xpdl2:Actual ScriptGrammar="JavaScript">ARR_referente</xpdl2:Actual>
                    </xpdl2:DataMapping>
                  </xpdl2:DataMappings>
                </xpdl2:SubFlow>
              </xpdl2:Implementation>
              <xpdl2:NodeGraphicsInfos>
                <xpdl2:NodeGraphicsInfo BorderColor="0,0,128" FillColor="255,219,74" Height="80.0" Width="128.0">
                  <xpdl2:Coordinates XCoordinate="265.0" YCoordinate="234.0"/>
                </xpdl2:NodeGraphicsInfo>
              </xpdl2:NodeGraphicsInfos>
              <xpdl2:Extensions/>
              <xpdExt:Audit>
                <xpdExt:AuditEvent Type="Completed">
                  <xpdExt:Information ScriptGrammar="JavaScript">if (ARR_referente != null)&#xD;
{&#xD;
	var date = DateTimeUtil.createDatetime();&#xD;
	ARR_referente.created = date;&#xD;
	ARR_referente.lastUpdate = date;&#xD;
	&#xD;
&#xD;
}&#xD;
&#xD;
if(ARR_referente != null &amp;&amp; currentArricchimento.operation == com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.CREATE)&#xD;
{&#xD;
	localRequest.ordine.referente.add(ARR_referente);&#xD;
}&#xD;
else if(ARR_referente != null &amp;&amp; currentArricchimento.operation == com_tim_NOW_xsd_BPM_DTUNotificationManagement_v1_OperationType.UPDATE)&#xD;
{&#xD;
	//TO DO&#xD;
}&#xD;
</xpdExt:Information>
                </xpdExt:AuditEvent>
              </xpdExt:Audit>
